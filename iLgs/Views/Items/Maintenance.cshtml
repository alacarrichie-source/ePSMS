                .Resizable(r => r.Columns(true))
                .Scrollable(s => s.Height(280))
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .Sortable()
                .ClientDetailTemplateId("StocksDetailTemplate")
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(20)
                    .Events(events => events.Error("GridError")
                       .RequestEnd("onRequestEndGridStocks")
                    )
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                    })
                    .Read(read => read.Action("StockRead", "Items").Data("DataGridStocks"))
                    .Create(create => create.Action("StockCreate", "Items"))
                    .Update(update => update.Action("StockUpdate", "Items"))
                    .Destroy(destroy => destroy.Action("StockDestroy", "Items"))
                )
                .Events(events => events
                    .Change("onChangeGridStocks")
                    .Edit("onEditGridStocks")
                    .DataBound("onDataBoundGridStocks")
                //.Save("onSaveGridStocks")
                    //.Save("onSaveGridStocks2")
                )
        )
    </div>    
</div>


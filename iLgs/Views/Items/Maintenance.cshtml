<script id="StocksDetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("stock_details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("RECEIPT")
                .Selected(true)
                .Content(@<text>
                    @RenderStockDetails()
                </text>);
            items.Add()
                .Text("STOCK DETAILS")
                .Content(@<text>
                    <div class='client-details'>
                        <ul>
                            <li><label>Stock No:</label>#= StockNo ?? "" #</li>
                            <li><label>Description:</label>#= Description ?? "" #</li>
                            <li><label>Type:</label>#= Type ?? "" #</li>
                            <li><label>Id No:</label>#= IdNo ?? "" #</li>
                            <li><label>TCT No:</label>#= TctNo ?? "" #</li>
                            <li><label>Brand Name:</label>#= BrandName ?? "" #</li>
                            <li><label>Department:</label>#= Department ?? "" #</li>
                            <li><label>Other Specs:</label>#= OtherSpecs ?? "" #</li>
                            <li><label>Serial No:</label>#= SerialNo ?? "" #</li>
                            <li><label>Color:</label>#= Color ?? "" #</li>
                            <li><label>Engine No:</label>#= EngineNo ?? "" #</li>
                            <li><label>Chassis No:</label>#= ChassisNo ?? "" #</li>
                            <li><label>PAR No:</label>#= ParNo ?? "" #</li>
                            <li><label>Accountable Officer:</label>#= AccountableOfficer ?? "" #</li>
                            <li><label>Completion Date:</label>#= CompletionDate ?? "" #</li>
                            <li><label>Estimated Life:</label>#= EstimatedLife ?? "" #</li>
                        </ul>
                    </div>
                </text>);
        })
       .ToClientTemplate()
    )
</script>

@helper RenderStockDetails()
{
    @(Html.Kendo().Grid<iLgs.Models.PsItemVM>()
        .Name("gridStockDetails_#=Id#")
        .ToolBar(t =>
        {
            //t.Create().Text("Add Items");
            t.Template(@<text>                
                @(Html.Kendo().Button().Icon("k-icon k-i-checkbox-checked").Name("btnSelectionAdd").Content("Add from orders").Events(e => e.Click("onClickBtnSelection")).ToClientTemplate())                                
            </text>);
        })
        .Columns(columns =>
        {
            columns.Bound(f => f.RefNo).EditorTemplateName("_RefNoTemplate")
                .Width(70);
            columns.Bound(f => f.RefDate).EditorTemplateName("_RefDateTemplate")
                .Width(70);
            columns.Group(group => group.Title("Quantity")
                .Columns(info =>
             {
                 info.Bound(f => f.Qty).EditorTemplateName("_QtyTemplate")
                   .Width(70).Title("Receipt")
                   .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                   .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                   .HeaderHtmlAttributes(new { style = "text-align:right;" });
                 info.Bound(f => f.QtyIss)
                     .Width(70).Title("Issue")
                     .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                     .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                     .HeaderHtmlAttributes(new { style = "text-align:right;" });
                 info.Bound(f => f.QtyBal)
                     .Width(70).Title("Balance")
                     .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                     .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                     .HeaderHtmlAttributes(new { style = "text-align:right;" });   
             }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
         );
            
            columns.Bound(f => f.Days).EditorTemplateName("_DaysTemplate")
                .Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")                
                .HeaderHtmlAttributes(new { style = "text-align:right;" });            
            columns.Command(commands =>
            {
                commands.Edit();
                commands.Destroy();
            }).Width(100);
        })
        //.Events(e =>
        //{
        //    e.DataBound("onOrderDetailsDataBound");
        //    e.DetailInit("onDetailInit");
        //    e.Edit("onOrderDetailsEdit");
        //})
        .Selectable()
        //.Pageable(pageable => pageable.Refresh(true))
        .Navigatable()
        .NoRecords()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.RefNo).Editable(false);
                model.Field(p => p.RefDate).Editable(false);
                model.Field(p => p.QtyIss).Editable(false);
                model.Field(p => p.QtyBal).Editable(false);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyIss).Sum();
                a.Add(p => p.QtyBal).Sum();
            })
            .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridStockItems"))
            .Read("StockItemRead", "Items", new { stockId = "#=Id#" })
            .Create("StockItemCreate", "Items")
            .Update("StockItemUpdate", "Items")
            .Destroy("StockItemDestroy", "Items")
        ).Events(e => e.Edit("onEditGridStockItems").Change("onChangeGridStockItems").DataBound("onDataBoundGridStockItems"))
        .ToClientTemplate()
    )
}


<div id="item-list" class="col col-xs-3">
    <h3>ITEMS</h3>
    @(Html.Kendo().Grid<iLgs.Models.PsCodeVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PsNo).Width(50);
        col.Bound(c => c.ItemName).Width(150);
    })
            //.ClientRowTemplate("itemTemplate")
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemName, "contains");
        //s.Field(o => o.ItemDescription, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(380))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("ItemMainRead", "Items"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )


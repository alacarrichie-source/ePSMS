        e.preventDefault();
        selectedGrid = e.sender;        
        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);
        e.model.set("PsStockId", parentModel.Id);        
    }

    function onChangeGridStockItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;        
    }

    function onDataBoundGridStockItems(e) {        
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }        
    }

    // Order Selection
    function onClickBtnSelection(e)
    {
        window.kendo.ui.progress($(document.body), true);        
        var myUrl = '@Url.Action("_QueryOrderItems", "Items")';
        var myTitle = "Purchase Order Items";
        var width = "80%";
        var height = "80%";

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    activate: function () {
                        window.kendo.ui.progress($(document.body), false);
                    },
                    deactivate: function () {
                        this.destroy();
                        onLoad = 1;
                        $("#gridStockDetails_" + selectedStockId).data("kendoGrid").dataSource.read();                        
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: myUrl,
            data: {
                psId: selectedId,
                stockId: selectedStockId
            }
        });
        mywindow.center().open();
    }
    
    function onChangeGridSelection(e) {
        var selectedRows = this.select();
        var totalSelectedRow = this.selectedKeyNames().length;
        if (totalSelectedRow == 0) {
            $("#btnAddSelected").html("Add Selected Records");
        } else {
            $("#btnAddSelected").html("Add " + totalSelectedRow + " Selected Record(s)");
        }
        $("#btnAddSelected").data('kendoButton').enable(totalSelectedRow != 0);
        $("#btnClear").data('kendoButton').enable(totalSelectedRow != 0);
    }

    function onDataBoundGridSelection(e) {
        var grid = this;
        var selectedRows = this.select();
        var totalSelectedRow = this.selectedKeyNames().length;
        if (totalSelectedRow == 0) {
            $("#btnAddSelected").html("Add Selected Records");
        } else {
            $("#btnAddSelected").html("Add " + totalSelectedRow + " Selected Record(s)");
        }
        $("#btnAddSelected").data('kendoButton').enable(totalSelectedRow != 0);
        $("#btnClear").data('kendoButton').enable(totalSelectedRow != 0);
    }

    // End Order Selection

</script>



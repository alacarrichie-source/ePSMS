<script type="text/x-kendo-tmpl" id="itemTemplate">
    <div class="item">
        <div class="item-wrapper">
            @*<img src="@(Url.Content("~/content/items/"))#:itemID#-t.png" class="img-responsive item-list-image" />*@
            <dl class="item-list-details">
                <dt class="name">#:ItemName# #:ItemDescription??""#</dt>
                <dd class="title">#:PsNo#</dd>
            </dl>
        </div>

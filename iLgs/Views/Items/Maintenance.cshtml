<div id="item-list" class="col col-xs-3">
    <h3>ITEMS</h3>    
    @(Html.Kendo().Grid<iLgs.Models.PsCode>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PsNo).Width(50);
        col.Bound(c => c.ItemName).Width(150);      
    })    
    //.ClientRowTemplate("itemTemplate")
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemName, "contains");
        //s.Field(o => o.ItemDescription, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(450))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()    
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("ItemRead", "Items"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )

    @*@(Html.Kendo().ListView<iLgs.Models.PsCode>()
        .Name("itemsList")
        .TagName("div")
        .Events(e => e.DataBound("onListDataBound").Change("onCriteriaChange"))
        .ClientTemplateId("itemTemplate")
        .DataSource(dataSource =>
        {
            dataSource.Read(read => read.Action("ItemRead", "Items"));
            dataSource.PageSize(9);
        })
        .Selectable(s => s.Mode(ListViewSelectionMode.Single))
    )*@
</div>


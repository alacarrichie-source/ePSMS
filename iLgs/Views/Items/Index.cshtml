@{
    ViewBag.Title = "Property and Supplies";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PsCodeVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.PsType).Width(70).EditorTemplateName("_PsTypeTemplate");
        col.Bound(c => c.PsNo).Width(70);
        col.Bound(c => c.ItemName).Width(100);
        col.Bound(c => c.ItemDescription).Width(100);
        col.Bound(c => c.UnitMeas).Width(100).EditorTemplateName("_UnitMeasTemplate");
        col.Bound(c => c.ReorderPoint).Width(100).EditorTemplateName("_ReorderTemplate");
        col.Bound(c => c.DaysToConsume).Width(100).EditorTemplateName("_DaysToConsumeTemplate");        
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Item");
        t.Search();
    })
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CodeMastTemplate").Window(w => w.Width(800).Title("Codes")))
    .Editable(editable => editable.Mode(GridEditMode.InLine))
    .Search(s =>
    {
        s.Field(o => o.PsType, "contains");
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemName, "contains");
        s.Field(o => o.ItemDescription, "contains");
        s.Field(o => o.UnitMeas, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("ItemRead", "Items"))
        .Create(create => create.Action("ItemCreate", "Items"))
        .Update(update => update.Action("ItemUpdate", "Items"))
        .Destroy(destroy => destroy.Action("ItemDestroy", "Items"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)


<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    .container {
        max-width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selecteItemId = null;
    var codeHdg = null;
    var hdg1 = null;
    var hdg2 = null;
    var hdg3 = null;
    var hdg4 = null;
    var hdg5 = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedItemId = null;
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }

    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

</script>



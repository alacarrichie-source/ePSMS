@{
    ViewBag.Title = "Item Codes";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />

<div class="row k-mb-2">
    <div class="col-md-3">
        <div class="col-md-3">
            @Html.Label("ARTICLES")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().DropDownList()
                .Name("article")
                .BindTo(new[] {
                    new { Text = "ALL", Value = "" },
                    new { Text = "YES", Value = "Y" },
                    new { Text = "NO", Value = "N" },
                    new { Text = "ARCHIVE", Value = "A" }
                })
                .DataTextField("Text")
                .DataValueField("Value")
                .HtmlAttributes(new { style = "width:100%; max-width:100%; text-transform: uppercase;", oninput = "this.value = this.value.toUpperCase()" })
                .Events(e => e.Change("onSelectArticle"))
                )
        </div>
    </div>
</div><br />

@(Html.Kendo().Grid<iLgs.Models.ItemTypeVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.Category).Width(50).EditorTemplateName("_CategoryTemplate");
        col.Bound(c => c.Code).Width(50);
        col.Bound(c => c.Description).Width(100); //.ClientTemplate("#= kendo.htmlEncode(Description) #");
        col.Bound(c => c.GroupCode).Width(70);
        col.Bound(c => c.RequiredFields).Width(100).EditorTemplateName("_PartialPageTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Record");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrint_").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom()
            .Text("Show Archive")
            .Name("btnArchiveToggle")
            .HtmlAttributes(new
            {
                id = "btnArchiveToggle",
                //href = "javascript:void(0);",
                //@class = "k-button"
                @class = "archive-toggle k-button",
                data_showarchive = "0"
            });
        t.Search();
    })
    //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PARTemplate").Window(w => w.Width(800).Title("Property Acknowledgment Receipt")))
    .Editable(editable => editable.Mode(GridEditMode.InLine))
    .Search(s =>
    {
        s.Field(o => o.Code, "contains");
        s.Field(o => o.Description, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.GroupCode))
        .Read(read => read.Action("ItemRead", "Items"))
        .Create(create => create.Action("ItemCreate", "Items"))
        .Update(update => update.Action("ItemUpdate", "Items"))
        .Destroy(destroy => destroy.Action("ItemDestroy", "Items"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Items(items =>
    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_ItemCodes", "Items", new { itemTypeId = "#=Id#" });
        //items.Add().Text("Fields")            
        //    .LoadContentFrom("_ItemFields", "Items", new { itemTypeId = "#=Id#" });
    }).ToClientTemplate())
</script>



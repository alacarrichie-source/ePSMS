    $(document).on("click", ".archive-toggle", function (e) {
        e.preventDefault();

        //var itemTypeId = $(this).data("itemtype");
        //var grid = $("#gridItems_" + itemTypeId).data("kendoGrid");

        //console.log(itemTypeId);

        var itemTypeId = selectedId;
        var grid = $("#gridItems_" + itemTypeId).data("kendoGrid");

        var $btn = $(this);

        if ($btn.text().trim() === "Show Archive") {
            $btn.text("Hide Archive");
            $btn.data("showarchive", 1);
            $btn.attr("data-showarchive", "1");   // Keep the HTML attribute in sync
        } else {
            $btn.text("Show Archive");
            $btn.data("showarchive", 0);
            $btn.attr("data-showarchive", "0");   // Keep the HTML attribute in sync
        }

        if (grid) {
            grid.dataSource.read();
        }
    });

    function onSelectArticle(e) {
        var itemTypeId = selectedId;
        var grid = $("#gridItems_" + itemTypeId).data("kendoGrid");
        if (grid) {
            grid.dataSource.read();
        }
    }

    function DataGridItem(e) {
        var grid = $("#gridItems_" + selectedId).data("kendoGrid");;
        var $btn = $("#btnArchiveToggle");

        return {
            itemTypeId: selectedId,
            showArchive: $btn.data("showarchive"),
            article: $("#article").val()
        };
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
                trackingId = selectedId;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var trackingId = null;
    var selecteItemId = null;
    var selecteItemFieldId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        trackingId = selectedId;
        selectedItemId = null;
        selectedItemFieldId = null;
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
        }

        this.bind("detailExpand", function (e) {
            // Select the expanded master row
            this.select(e.masterRow);
        });

        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrint_", grid).hide();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
        trackingId = selectedId;
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    function DataCategoryId() {
        var text = $("#CategoryId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#CategoryId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }


@{
    ViewBag.Title = "Property & Supply Codes";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PsCodeVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        //col.Bound(c => c.PsType).Width(50);
        col.Bound(c => c.PsTypeDesc).Width(100);
        col.Bound(c => c.ItemCodeDesc).Width(100);
        col.Bound(c => c.PsNo).Width(100);        
        col.Bound(c => c.ItemName).Width(200);
        //col.Bound(c => c.ItemDescription).Width(100);
        //col.Bound(c => c.UnitMeas).Width(100);
        //col.Bound(c => c.ReorderPoint).Width(100);
        //col.Bound(c => c.DaysToConsume).Width(100);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Item");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PsCodeTemplate").Window(w => w.Width(800).Title("Property & Supply")))
    //.Editable(editable => editable.Mode(GridEditMode.InLine))
    .Search(s =>
    {
        s.Field(o => o.PsType, "contains");
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemName, "contains");
        s.Field(o => o.ItemDescription, "contains");
        s.Field(o => o.UnitMeas, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("PsCodeRead", "Items"))
        .Create(create => create.Action("PsCodeCreate", "Items"))
        .Update(update => update.Action("PsCodeUpdate", "Items"))
        .Destroy(destroy => destroy.Action("PsCodeDestroy", "Items"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)


<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    .container {
        max-width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selecteItemId = null;
    var codeHdg = null;
    var hdg1 = null;
    var hdg2 = null;
    var hdg3 = null;
    var hdg4 = null;
    var hdg5 = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedItemId = null;
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }

    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    function onSelectItemCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#ItemCodeId").val(dataItem.Id).trigger("change");
        $("#ItemCode").val(dataItem.Code).trigger("change");
        $("#PsType").val(dataItem.Type).trigger("change");
        //$("#PsTypeCode").val(dataItem.Type).trigger("change");
        //$("#ItemCodeDesc").val(dataItem.Type).trigger("change");
        //$("#ItemType").val(dataItem.Description).trigger("change");

        var itemName = $("#ItemName").val();
        if (itemName) {
            var itemCode = dataItem.Code;
            getPsNo(itemCode, itemName);
        }
    }

    function onChangeItemName(e) {
        var itemName = this.value();
        var itemCode = $("#ItemCode").val();
        getPsNo(itemCode, itemName);
    }

    function getPsNo(itemCode, itemName) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetPsNo", "Items")',
            data: {
                itemCode: itemCode,
                itemName: itemName
            },
            beforeSend: function () {
                window.kendo.ui.progress($(document.body), true);
            },
            success: function (result) {
                window.kendo.ui.progress($(document.body), false);
                if (result.Errors != "") {
                    alert(result.Errors);
                } else {
                    $("#PsNo").val(result.PsNo).trigger("change");
                }
            },
            error: function (req, status, errorObj) {
                window.kendo.ui.progress($(document.body), false);
                alert(req.responseText);
            }
        });
    }

</script>



@model iLgs.Models.PsStockVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsId)

<fieldset>
    <div class="row">
        @Html.LabelFor(model => model.StockNo, htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(model => model.StockNo).Placeholder("(AUTO)").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(model => model.StockNo)
        </div>
    </div>

    <div class="row">
        @Html.LabelFor(model => model.StockName, htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(model => model.StockName).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(model => model.StockName)
        </div>
    </div>
    
    <div class="row">
        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(model => model.Description).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(model => model.Description)
        </div>
    </div>

    
</fieldset>
}





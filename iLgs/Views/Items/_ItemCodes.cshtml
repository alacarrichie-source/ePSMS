@(Html.Kendo().Grid<iLgs.Models.ItemCodeVM>()
        .Name("gridItems_" + @ViewData["itemTypeId"])
        .Columns(col =>
        {
            col.Bound(c => c.ItemNoIndex).Hidden();
            col.Bound(c => c.ItemNo).Width(50);
            col.Bound(c => c.Description).Width(150);
            col.Bound(c => c.Code).Width(70);
            col.Bound(c => c.ItemSw).Width(70);
            col.Bound(c => c.IsConsumable).Width(70);
            col.Bound(c => c.IsIncorporated).Width(70);
            col.Bound(c => c.ForDistribution).Width(90);
            //col.Bound(c => c.ItemSwUI).Width(50).EditorTemplateName("_ItemSwTemplate")
            //    .ClientTemplate("<input type='checkbox' #= ItemSwUI ? 'YES' : '' # class='k-switch' />")
            //    .HtmlAttributes(new { @class = "text-center" });
            //col.Bound(c => c.AccountCode).Width(50);
            col.Command(command =>
            {
                //command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditItem");
                command.Edit();
                command.Destroy();
            }).Width(100);
        })
        .ToolBar(toolbar =>
        {
        toolbar.Create();
            @*toolbar.Template(@<text>
        @(Html.Kendo().Button().Name("btnAddItem_" + ViewData["risId"]).Content("Add Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddRisItem")))
            </text>);*@
        })
        //.Pageable(pager => pager
        //    .Input(false)
        //    .Numeric(true)
        //    .Info(true)
        //    .PreviousNext(true)
        //    .Refresh(true)
        //    .PageSizes(true)
        //    .ButtonCount(5)
        //)
        .Scrollable()
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridItemError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.ItemNoIndex).Editable(false);
                model.Field(p => p.ItemTypeId).DefaultValue(@ViewData["itemTypeId"]).Editable(true);
                model.Field(p => p.Code).Editable(false);
            })
            .Sort(s =>
            {
                s.Add(a => a.ItemNoIndex);
            })
            .Read(read => read.Action("ItemCodeRead", "Items", new { itemTypeId = @ViewData["itemTypeId"] }))
            .Create(create => create.Action("ItemCodeCreate", "Items"))
            .Update(update => update.Action("ItemCodeUpdate", "Items"))
            .Destroy(destroy => destroy.Action("ItemCodeDestroy", "Items"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
            .Remove("onRemoveGridItems")
        )
        .AutoBind(true)
)


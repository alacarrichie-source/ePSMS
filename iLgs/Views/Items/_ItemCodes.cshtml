@{
    var functionName = "DataGridItem_" + ViewData["itemTypeId"].ToString().Replace("-", "_");
}

@(Html.Kendo().Grid<iLgs.Models.ItemCodeVM>()
        .Name("gridItems_" + @ViewData["itemTypeId"])
        .Columns(col =>
        {
            col.Bound(c => c.ItemNoIndex).Hidden();
            col.Bound(c => c.ItemNo).Width(60).Title("Item No");
            col.Bound(c => c.Description).Width(180).Title("Description")
                .ClientTemplate("#= renderItemCodeDescription(data) #");
            col.Bound(c => c.Code).Width(85).Title("Item Code");
            col.Bound(c => c.ItemSw).Width(95).Title("Article")
                .ClientTemplate("#= renderItemCodeSw(data) #");
            col.Bound(c => c.IsConsumable).Width(80).Title("Consumable");
            col.Bound(c => c.IsIncorporated).Width(85).Title("Incorp.");
            col.Bound(c => c.ForDistribution).Width(85).Title("Distr.");
            col.Bound(c => c.RequiredFields).Width(95).Title("Required Fields").EditorTemplateName("_PartialPageTemplate");
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(100);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text("Add Item Code");
        })
        .Scrollable()
        .Filterable()
        .NoRecords(n => n.Template("<div class='item-empty-state'><span class='k-icon k-i-search'></span><p>No Item Codes found</p><span class='item-empty-sub'>Click 'Add Item Code' to create an item code under this item type.</span></div>"))
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridItemError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.ItemNoIndex).Editable(false);
                model.Field(p => p.ItemTypeId).DefaultValue(@ViewData["itemTypeId"]).Editable(true);
                model.Field(p => p.Code).Editable(false);
            })
            .Sort(s =>
            {
                s.Add(a => a.ItemNoIndex);
            })
            .Read(read => read.Action("ItemCodeRead", "Items").Data("DataGridItem"))
            .Create(create => create.Action("ItemCodeCreate", "Items"))
            .Update(update => update.Action("ItemCodeUpdate", "Items"))
            .Destroy(destroy => destroy.Action("ItemCodeDestroy", "Items"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
            .Remove("onRemoveGridItems")
        )
        .AutoBind(true)
)

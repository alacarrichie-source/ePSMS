@model iLgs.Models.ItemCodePrintVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.HiddenFor(m => m.SavePrints)    
    <br />
    <div class="row k-mb-2">
        <div class="col-md-2">
            @Html.Label("Category")
        </div>
        <div class="col-md-10">
            @(Html.Kendo().MultiColumnComboBoxFor(m => m.CategoryId)
            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
            .Placeholder("Select Category")
            .DataTextField("Description")
            .DataValueField("Id")
            .ValuePrimitive(true)
            .Filter(FilterType.Contains)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetItemType", "Getters").Data("DataCategoryId");
                })
                .ServerFiltering(false);
            })
            .Columns(c =>
            {
                c.Add().Field("Description").Title("Category").Width("100%");
            })
            //.Events(e => e.Select("onSelectCategory"))
            .Suggest(true)
            )
        </div>
    </div>    

    <hr />

    <div class="row k-mb-2">
        <div id="span_submit">
            @(Html.Kendo().Button().Content("Submit").Name("btnPrintSubmit"))
            @(Html.Kendo().Button().Name("btnSaveSubmit").Content("Save to Excel File"))
        </div>
    </div>
}

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    #span_submit {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: 16em;
    }
</style>

<script type="text/javascript">

    //$("#divRange").addClass("hidden");

    $("#btnPrintSubmit").click(function (e) {
        $("#SavePrints").val(false).trigger('change');
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            Print();
        }
    })

    $("#btnSaveSubmit").click(function (e) {
        $("#SavePrints").val(true).trigger('change');
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            Export();
        }
    })

    function Print() {
        var data = $("#form").serialize();
        var url = '@Url.Action("ItemCodeRpt", "Items")' + '?' + data;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    function Export() {
        var data = $("#form").serialize();
        var url = '@Url.Action("ItemCodeRpt", "Items")' + '?' + data;

        // Redirect to the export URL to trigger download
        window.location.href = url;
        window.kendo.ui.progress($(document.body), false);
    }

</script>









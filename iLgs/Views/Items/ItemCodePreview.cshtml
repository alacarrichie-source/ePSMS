@{
    ViewBag.Title = "Item Codes Preview";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.ItemCodePreviewVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.Code).Width(50);
        col.Bound(c => c.Account).Width(100);
        col.Bound(c => c.SubAccount1).Width(100);
        col.Bound(c => c.SubAccount2).Width(100);
        col.Bound(c => c.SubAccount3).Width(100);
        col.Bound(c => c.SubAccount4).Width(100);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Code, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.SubAccount1, "contains");
        s.Field(o => o.SubAccount2, "contains");
        s.Field(o => o.SubAccount3, "contains");
        s.Field(o => o.SubAccount4, "contains");
    })
    //.Pageable(pager => pager
    //    .Input(false)
    //    .Numeric(true)
    //    .Info(true)
    //    .PreviousNext(true)
    //    .Refresh(true)
    //    .PageSizes(true)
    //    .ButtonCount(5)
    //)
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        //.PageSize(20)
        //.Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("ItemCodePreviewRead", "Items"))
    )
//.Events(events => events
//    .Change("onChangeGrid")
//    .Edit("onEditGrid")
//    .DataBound("onDataBoundGrid")
//    )
)

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }
</style>

<script type="text/javascript"> </script>

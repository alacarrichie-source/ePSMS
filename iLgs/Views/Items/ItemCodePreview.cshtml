@{
    ViewBag.Title = "Item Codes Preview";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />
<div class="row">
    <div class="col-md-1">
        @Html.Label("Category")
    </div>
    <div class="col-md-3">
        @(Html.Kendo().MultiColumnComboBox()
            .Name("category")
            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
            .Placeholder("Select Category")
            .DataTextField("Description")
            .DataValueField("Code")
            .ValuePrimitive(true)
            .Filter(FilterType.Contains)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetCategoryPreview", "Getters");
                })
                .ServerFiltering(false);
            })
            .Columns(c =>
            {
                c.Add().Field("Description").Title("Category").Width("100%");
            })
            .Events(e => e.Select("onSelectCategory")
                //.DataBound("onDataBoundCategory")
                )
            .Suggest(true)
        )        
    </div>
</div>
@(Html.Kendo().Grid<iLgs.Models.ItemCodePreviewVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.GroupCode).Width(50);
        //col.Bound(c => c.ItemNoIndex).Width(50);
        col.Bound(c => c.Code).Width(50);
        col.Bound(c => c.Account).Width(100);
        col.Bound(c => c.SubAccount1).Width(100);
        col.Bound(c => c.SubAccount2).Width(100);
        col.Bound(c => c.SubAccount3).Width(100);
        col.Bound(c => c.SubAccount4).Width(100);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.GroupCode, "contains");
        //s.Field(o => o.ItemNoIndex, "contains");
        s.Field(o => o.Code, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.SubAccount1, "contains");
        s.Field(o => o.SubAccount2, "contains");
        s.Field(o => o.SubAccount3, "contains");
        s.Field(o => o.SubAccount4, "contains");
    })
    //.Pageable(pager => pager
    //    .Input(false)
    //    .Numeric(true)
    //    .Info(true)
    //    .PreviousNext(true)
    //    .Refresh(true)
    //    .PageSizes(true)
    //    .ButtonCount(5)
    //)
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    //.Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        //.PageSize(20)
        //.Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("ItemCodePreviewRead", "Items").Data("DataGrid"))
    )
.Events(events => events
    //.Change("onChangeGrid")
    //.Edit("onEditGrid")
    .DataBound("onDataBoundGrid")
    ).AutoBind(false)
)

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }
</style>

<script type="text/javascript"> 
    function onSelectCategory(e) {
        var dataItem = this.dataItem(e.item.index());
        var category = dataItem.Code;
        var grid = $("#grid").data("kendoGrid");
        
        grid.dataSource.read({category: category});        
    }

    function onDataBoundCategory(e) {
        // Retrieve the first item from the dataSource (e.g., auto-select the first category)
        var data = this.dataSource.data();
        
        if (data.length > 0) {
            var firstDataItem = data[0]; // Get the first item
            var categoryCode = firstDataItem.Code; // Get the category code of the first item
            var grid = $("#grid").data("kendoGrid");

            // Refresh the grid based on the first category when data is initially bound
            grid.dataSource.read({ category: categoryCode });
        }
    }

    function DataGrid() {
        var text = $("#category").data("kendoMultiColumnComboBox").value();        
        return {
            category: text
        };
    }

    function onDataBoundGrid(e) {
        var grid = this; // Kendo Grid instance
        var rows = grid.tbody.find("tr");

        // Make sure the grid has rows before proceeding
        if (rows.length === 0) return;

        // Get the index of the target column ("SomeField")
        var columnAccountIndex = grid.element.find("th[data-field='Account']").index();
        var columnSubAccount1Index = grid.element.find("th[data-field='SubAccount1']").index();
        var columnSubAccount2Index = grid.element.find("th[data-field='SubAccount2']").index();
        var columnSubAccount3Index = grid.element.find("th[data-field='SubAccount3']").index();
        var columnSubAccount4Index = grid.element.find("th[data-field='SubAccount4']").index();

        rows.each(function (index, row) {
            // Get current and previous rows
            var currentRow = $(row);
            var previousRow = rows.eq(index - 1);

            // Check if the previous row exists
            if (previousRow.length) {
                // Get data from current and previous rows
                var currentDataItem = grid.dataItem(currentRow);
                var previousDataItem = grid.dataItem(previousRow);

                // Compare the values of the specific column (e.g., "SomeField")
                if (currentDataItem.Account === previousDataItem.Account) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnAccountIndex);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }

                if (currentDataItem.Account === previousDataItem.Account && currentDataItem.SubAccount1 === previousDataItem.SubAccount1) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnSubAccount1Index);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }

                if (currentDataItem.Account === previousDataItem.Account && currentDataItem.SubAccount1 === previousDataItem.SubAccount1
                    && currentDataItem.SubAccount2 === previousDataItem.SubAccount2) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnSubAccount2Index);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }

                if (currentDataItem.Account === previousDataItem.Account && currentDataItem.SubAccount1 === previousDataItem.SubAccount1
                    && currentDataItem.SubAccount2 === previousDataItem.SubAccount2
                    && currentDataItem.SubAccount3 === previousDataItem.SubAccount3) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnSubAccount3Index);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }

                //if (currentDataItem.Account === previousDataItem.Account && currentDataItem.SubAccount1 === previousDataItem.SubAccount1
                //    && currentDataItem.SubAccount2 === previousDataItem.SubAccount2
                //    && currentDataItem.SubAccount3 === previousDataItem.SubAccount3
                //    && currentDataItem.SubAccount4 === previousDataItem.SubAccount4) {
                //    // Find the specific column cell in the current row
                //    var currentCell = currentRow.find("td").eq(columnSubAccount4Index);

                //    // Apply opacity to the cell if the value matches the previous row
                //    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                //}
            }
        });
    }    
</script>

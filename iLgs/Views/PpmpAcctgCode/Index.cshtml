                <span class="ppmp-metric-label">Completion</span>
                <span class="ppmp-metric-dot dot-completion"></span>
            </div>
            <div class="ppmp-metric-value-row">
                <span class="ppmp-metric-number" id="metricCompletion">0%</span>
                <span class="ppmp-metric-subtext">Coverage</span>
            </div>
        </div>
    </div>

    <!-- MAIN WORKSPACE CARD -->
    <div class="ppmp-card">
        <div class="ppmp-card-header">
            <h3 class="ppmp-card-title">
                <span class="k-icon k-i-grid"></span> PPMP Accounting Code Mappings
            </h3>
        </div>

        <!-- Toolbar: Search & Status Filter -->
        <div class="ppmp-toolbar">
            <div class="ppmp-search-container">
                <span class="k-icon k-i-search ppmp-search-icon"></span>
                <input type="text" id="txtPpmpSearch" class="ppmp-search-input"
                       placeholder="Search PPMP code, description, GSO code, accounting code, remarks..." />
            </div>

            <div class="ppmp-filter-group">
                <div class="ppmp-status-segmented">
                    <button type="button" class="ppmp-segment-btn active" data-status="all">All</button>
                    <button type="button" class="ppmp-segment-btn" data-status="assigned">Assigned</button>
                    <button type="button" class="ppmp-segment-btn" data-status="unassigned">Unassigned</button>
                </div>
            </div>
        </div>

        <!-- Kendo Grid Workspace -->
        <div class="ppmp-card-body">
            @(Html.Kendo().Grid<iLgs.Models.PpmpAcctgCodeVM>()
                .Name("gridPpmpAcctgCode")
                .HtmlAttributes(new { style = "height: calc(68vh);" })
                .Columns(columns =>
                {
                    columns.Bound(c => c.Code).Title("PPMP Code").Width(140)
                        .ClientTemplate("#= renderPpmpCode(data) #");

                    columns.Bound(c => c.Description).Title("Group / Description").Width(280)
                        .ClientTemplate("#= renderPpmpDescription(data) #");

                    columns.Bound(c => c.AcctgCode).Title("Accounting Code").Width(180)
                        .ClientTemplate("#= renderPpmpAcctgCode(data) #");

                    columns.Bound(c => c.GSOCodeDescription).Title("GSO Code").Width(220)
                        .ClientTemplate("#= renderPpmpGSOCode(data) #");

                    columns.Bound(c => c.Status).Title("Status").Width(130)
                        .ClientTemplate("#= renderPpmpMappingStatus(data) #");

                    columns.Bound(c => c.Remarks).Title("Remarks").Width(180)
                        .ClientTemplate("#= renderPpmpRemarks(data) #");

                    columns.Bound(c => c.Code).Title("Actions").Width(180).Filterable(false).Sortable(false)
                        .ClientTemplate("#= renderPpmpAcctgActions(data) #");
                })
                .Pageable(pager => pager
                    .Input(false)
                    .Numeric(true)
                    .Info(true)
                    .PreviousNext(true)
                    .Refresh(true)
                    .PageSizes(new int[] { 10, 20, 50, 100 })
                    .ButtonCount(5)
                )
                .Sortable()
                .Filterable()
                .Resizable(resize => resize.Columns(true))
                .Scrollable()
                .NoRecords(n => n.Template(
                    "<div class='ppmp-empty-state'>" +
                        "<span class='k-icon k-i-search'></span>" +
                        "<p>No PPMP groups found</p>" +
                        "<span class='item-empty-sub'>Adjust your search or filter parameters to locate item groups.</span>" +
                    "</div>"
                ))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .ServerOperation(false)
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Code).Editable(false);
                        model.Field(p => p.Description).Editable(false);
                        model.Field(p => p.GSOCodeId).Editable(false);
                        model.Field(p => p.GSOCodeDescription).Editable(false);
                        model.Field(p => p.HasMapping).Editable(false);
                        model.Field(p => p.Status).Editable(false);
                    })
                    .Read(read => read.Action("Read", "PpmpAcctgCode"))
                    .Events(e => e.Error("onGridError"))
                )
                .Events(e => e.DataBound("onGridDataBound"))
            )
        </div>
    </div>
</div>


<script type="text/javascript">
    /* ==========================================================================
       GLOBAL STATE & KENDO CLIENT TEMPLATE RENDERERS
       (Defined prior to Grid initialization for complete template execution safety)
       ========================================================================== */
    var isEditMode = false;
    var currentStatusFilter = "all";

    function renderPpmpCode(data) {
        if (!data || !data.Code) return "";
        return '<span class="ppmp-code-pill">' + kendo.htmlEncode(data.Code) + '</span>';
    }

    function renderPpmpDescription(data) {
        if (!data || !data.Description) return '<span class="ppmp-remarks-empty">&mdash;</span>';
        return '<span class="ppmp-desc-text">' + kendo.htmlEncode(data.Description) + '</span>';
    }

    function renderPpmpGSOCode(data) {
        var description = "";
        if (typeof data === "string") {
            description = data;
        } else if (data && data.GSOCodeDescription) {
            description = data.GSOCodeDescription;
        }
        if (!description) {
            return '<span class="ppmp-unassigned-hint">&mdash;</span>';
        }
        return '<span class="ppmp-gso-text">' + kendo.htmlEncode(description) + '</span>';
    }

    function renderPpmpAcctgCode(data) {
        if (!data) return "";
        if (data.HasMapping && data.AcctgCode) {
            return '<span class="ppmp-acctg-assigned">' + kendo.htmlEncode(data.AcctgCode) + '</span>';
        }
        return '<span class="ppmp-acctg-unassigned">&mdash; <span class="ppmp-unassigned-hint">Not assigned</span></span>';
    }

    function renderPpmpMappingStatus(data) {
        if (!data) return "";
        if (data.HasMapping) {
            return '<span class="ppmp-status-pill status-pill-assigned"><span class="ppmp-status-indicator indicator-assigned"></span>Assigned</span>';
        }
        return '<span class="ppmp-status-pill status-pill-unassigned"><span class="ppmp-status-indicator indicator-unassigned"></span>Unassigned</span>';
    }

    function renderPpmpRemarks(data) {
        if (!data || !data.Remarks) return '<span class="ppmp-remarks-empty">&mdash;</span>';
        var remarksText = kendo.htmlEncode(data.Remarks);
        return '<span class="ppmp-remarks-text" title="' + remarksText + '">' + remarksText + '</span>';
    }

    function renderPpmpAcctgActions(data) {
        if (!data) return "";
        if (!data.HasMapping) {
            return '<button type="button" class="btn-primary-action ppmp-btn-action js-ppmp-acctg-assign">' +
                   '<span class="k-icon k-i-plus"></span> Assign</button>';
        }
        return '<button type="button" class="btn-secondary-action ppmp-btn-action ppmp-btn-edit js-ppmp-acctg-edit">' +
               '<span class="k-icon k-i-edit"></span> Edit</button>' +
               '<button type="button" class="btn-secondary-action ppmp-btn-action ppmp-btn-delete js-ppmp-acctg-delete" title="Remove Mapping">' +
               '<span class="k-icon k-i-trash"></span> Remove</button>';
    }

    function getPpmpAcctgGrid() {
        return $("#gridPpmpAcctgCode").data("kendoGrid");
    }

    function refreshGrid() {
        var grid = getPpmpAcctgGrid();
        if (grid && grid.dataSource) {
            grid.dataSource.read();
        }
    }

    function onGridError(e) {
        if (e && e.errors) {
            var message = extractKendoErrors(e.errors);
            alert("Error: " + message);
        }
    }

    function extractKendoErrors(errors) {
        var messages = [];
        if (errors) {
            $.each(errors, function (key, value) {
                if (value && value.errors) {
                    $.each(value.errors, function () {
                        messages.push(this);
                    });
                } else if (typeof value === "string") {
                    messages.push(value);
                }
            });
        }
        return messages.join("; ");
    }
</script>

<div class="ppmp-workspace">

    <!-- PAGE HEADER -->
    <div class="ppmp-header">
        <div class="ppmp-title-group">
            <h2>
                <span class="ppmp-title-icon"><span class="k-icon k-i-file-data"></span></span>

<script type="text/javascript">
    /* ==========================================================================
       EVENT HANDLERS, FILTERING & AJAX MUTATIONS
       ========================================================================== */

    // Grid DataBound & Summary Metrics
    function onGridDataBound(e) {
        var grid = e.sender;
        var fullData = grid.dataSource.data();

        // Calculate summary metrics across all items
        updateSummaryMetrics(fullData);

        // Subtle row highlighting for unassigned items
        grid.tbody.find("tr").each(function () {
            var row = $(this);
            var item = grid.dataItem(row);
            if (item) {
                if (item.HasMapping) {
                    row.removeClass("ppmp-row-unassigned").addClass("ppmp-row-assigned");
                } else {
                    row.removeClass("ppmp-row-assigned").addClass("ppmp-row-unassigned");
                }
            }
        });
    }

    function updateSummaryMetrics(items) {
        var total = items ? items.length : 0;
        var assigned = 0;
        var unassigned = 0;

        if (items && total > 0) {
            for (var i = 0; i < total; i++) {
                if (items[i].HasMapping) {
                    assigned++;
                } else {
                    unassigned++;
                }
            }
        }

        var completion = total > 0 ? Math.round((assigned / total) * 100) : 0;

        $("#metricTotal").text(total);
        $("#metricAssigned").text(assigned);
        $("#metricUnassigned").text(unassigned);
        $("#metricCompletion").text(completion + "%");
    }

    // Search & Filtering
    function applyStatusFilter(status) {
        currentStatusFilter = status;
        var grid = getPpmpAcctgGrid();
        if (!grid) return;

        // Update segmented buttons
        $(".ppmp-segment-btn").removeClass("active");
        $(".ppmp-segment-btn[data-status='" + status + "']").addClass("active");

        // Update card highlights
        $(".ppmp-metric-card").removeClass("active");
        if (status === "all") $("#cardMetricTotal").addClass("active");
        else if (status === "assigned") $("#cardMetricAssigned").addClass("active");
        else if (status === "unassigned") $("#cardMetricUnassigned").addClass("active");

        executeCombinedFilter();
    }

    function executeCombinedFilter() {
        var grid = getPpmpAcctgGrid();
        if (!grid) return;

        var searchText = $.trim($("#txtPpmpSearch").val());
        var combinedFilters = [];

        // Status Filter
        if (currentStatusFilter === "assigned") {
            combinedFilters.push({ field: "HasMapping", operator: "eq", value: true });
        } else if (currentStatusFilter === "unassigned") {
            combinedFilters.push({ field: "HasMapping", operator: "eq", value: false });
        }

        // Quick Search Filter (Includes Code, Description, GSOCodeDescription, AcctgCode, Remarks)
        if (searchText) {
            combinedFilters.push({
                logic: "or",
                filters: [
                    { field: "Code", operator: "contains", value: searchText },
                    { field: "Description", operator: "contains", value: searchText },
                    { field: "GSOCodeDescription", operator: "contains", value: searchText },
                    { field: "AcctgCode", operator: "contains", value: searchText },
                    { field: "Remarks", operator: "contains", value: searchText }
                ]
            });
        }

        if (combinedFilters.length > 0) {
            grid.dataSource.filter({ logic: "and", filters: combinedFilters });
        } else {
            grid.dataSource.filter({});
        }
    }

    // Modal Handling (Assign / Edit)
    function hideModalAlert() {
        $("#modalAlertBox").hide();
        $("#modalAlertMessage").text("");
    }

    function showModalAlert(msg) {
        $("#modalAlertMessage").text(msg);
        $("#modalAlertBox").fadeIn(150);
    }

    function openAssignModal(dataItem) {
        if (!dataItem) return;

        isEditMode = false;
        hideModalAlert();

        var wnd = $("#wndAssignAcctgCode").data("kendoWindow");
        wnd.title("Assign Accounting Code");

        $("#modalMappingId").val("");
        $("#modalPpmpCode").val(dataItem.Code || "");
        $("#modalPpmpCodeDisplay").text(dataItem.Code || "-");
        $("#modalPpmpDescDisplay").text(dataItem.Description || "-");
        $("#modalRemarks").val("");

        $("#btnSaveText").text("Assign");
        $("#btnSaveIcon").attr("class", "k-icon k-i-plus");

        var gsoCombo = $("#modalGSOCodeCombo").data("kendoComboBox");
        if (gsoCombo) {
            gsoCombo.value("");
            gsoCombo.text("");
        }

        var acctgCombo = $("#modalAcctgCodeCombo").data("kendoComboBox");
        if (acctgCombo) {
            acctgCombo.value("");
            acctgCombo.text("");
            acctgCombo.dataSource.read();
        }

        wnd.center().open();
    }

    function openEditModal(dataItem) {
        if (!dataItem) return;

        isEditMode = true;
        hideModalAlert();

        var wnd = $("#wndAssignAcctgCode").data("kendoWindow");
        wnd.title("Edit Accounting Code");

        $("#modalMappingId").val(dataItem.Id || "");
        $("#modalPpmpCode").val(dataItem.Code || "");
        $("#modalPpmpCodeDisplay").text(dataItem.Code || "-");
        $("#modalPpmpDescDisplay").text(dataItem.Description || "-");
        $("#modalRemarks").val(dataItem.Remarks || "");

        $("#btnSaveText").text("Save Changes");
        $("#btnSaveIcon").attr("class", "k-icon k-i-save");

        var gsoCombo = $("#modalGSOCodeCombo").data("kendoComboBox");
        if (gsoCombo) {
            var selectedGsoId = dataItem.GSOCodeId ? String(dataItem.GSOCodeId) : "";
            var selectedGsoDesc = dataItem.GSOCodeDescription || "";
            if (selectedGsoId) {
                gsoCombo.value(selectedGsoId);
                if (!gsoCombo.text() && selectedGsoDesc) {
                    gsoCombo.text(selectedGsoDesc);
                }
            } else {
                gsoCombo.value("");
                gsoCombo.text("");
            }
            gsoCombo.dataSource.read();
        }

        var acctgCombo = $("#modalAcctgCodeCombo").data("kendoComboBox");
        if (acctgCombo) {
            acctgCombo.value(dataItem.AcctgCode || "");
            acctgCombo.text(dataItem.AcctgCode || "");
            acctgCombo.dataSource.read();
        }

        wnd.center().open();
    }

    function closeModal() {
        var wnd = $("#wndAssignAcctgCode").data("kendoWindow");
        if (wnd) {
            wnd.close();
        }
        hideModalAlert();
    }

    function submitModal() {
        hideModalAlert();

        var code = $("#modalPpmpCode").val();

        var gsoCombo = $("#modalGSOCodeCombo").data("kendoComboBox");
        var gsoCodeId = gsoCombo ? $.trim(gsoCombo.value() || "") : "";

        var acctgCombo = $("#modalAcctgCodeCombo").data("kendoComboBox");
        var acctgCode = acctgCombo ? acctgCombo.value() : "";
        if (!acctgCode && acctgCombo) {
            acctgCode = acctgCombo.text();
        }

        var remarks = $("#modalRemarks").val();
        var id = $("#modalMappingId").val();

        // Client-side validations
        if (!gsoCodeId || gsoCodeId === "") {
            showModalAlert("Please select a GSO Code.");
            if (gsoCombo) { gsoCombo.focus(); }
            return;
        }

        if (!acctgCode || $.trim(acctgCode) === "") {
            showModalAlert("Please select or enter an Accounting Code.");
            if (acctgCombo) { acctgCombo.focus(); }
            return;
        }

        var postUrl = isEditMode
            ? '@Url.Action("Update", "PpmpAcctgCode")'
            : '@Url.Action("Create", "PpmpAcctgCode")';

        var token = $("#frmAssignAcctgCode input[name='__RequestVerificationToken']").val();

        var postData = {
            Id: id ? id : null,
            Code: $.trim(code),
            GSOCodeId: gsoCodeId,
            AcctgCode: $.trim(acctgCode),
            Remarks: $.trim(remarks),
            __RequestVerificationToken: token
        };

        var btn = $("#btnSaveMapping");
        var originalBtnText = $("#btnSaveText").text();
        btn.prop("disabled", true);
        $("#btnSaveText").text("Saving...");
        $("#btnSaveIcon").attr("class", "k-icon k-i-loading");

        $.ajax({
            url: postUrl,
            type: "POST",
            data: postData,
            success: function (res) {
                btn.prop("disabled", false);
                $("#btnSaveText").text(originalBtnText);
                $("#btnSaveIcon").attr("class", isEditMode ? "k-icon k-i-save" : "k-icon k-i-plus");

                if (res && res.Errors) {
                    var errorMsg = extractKendoErrors(res.Errors);
                    showModalAlert(errorMsg || "Validation failed.");
                } else {
                    closeModal();
                    refreshGrid();
                }
            },
            error: function (xhr) {
                btn.prop("disabled", false);
                $("#btnSaveText").text(originalBtnText);
                $("#btnSaveIcon").attr("class", isEditMode ? "k-icon k-i-save" : "k-icon k-i-plus");

                var err = "An unexpected error occurred while saving the assignment.";
                try {
                    var json = JSON.parse(xhr.responseText);
                    if (json && json.message) { err = json.message; }
                } catch (e) { }
                showModalAlert(err);
            }
        });
    }

    // Remove Mapping / Delete Action
    function confirmDeleteMapping(dataItem) {
        if (!dataItem) return;

        var code = dataItem.Code || "";
        var confirmed = confirm(
            "Remove Accounting Code Mapping?\n\n" +
            "The accounting-code assignment for PPMP Code '" + code + "' will be removed.\n\n" +
            "The PPMP group itself will remain available and will return to Unassigned status."
        );

        if (!confirmed) return;

        var token = $("#frmAssignAcctgCode input[name='__RequestVerificationToken']").val();

        $.ajax({
            url: '@Url.Action("Destroy", "PpmpAcctgCode")',
            type: "POST",
            data: {
                Id: dataItem.Id,
                Code: code,
                __RequestVerificationToken: token
            },
            success: function (res) {
                if (res && res.Errors) {
                    var errorMsg = extractKendoErrors(res.Errors);
                    alert("Remove Mapping Failed: " + (errorMsg || "Validation failed."));
                } else {
                    refreshGrid();
                }
            },
            error: function () {
                alert("An error occurred while removing the accounting code mapping.");
            }
        });
    }

    // DOM Ready Event Bindings
    $(document).ready(function () {
        // Refresh Button
        $("#btnRefreshPpmpAcctg").off("click.ppmpAcctg").on("click.ppmpAcctg", function (e) {
            e.preventDefault();
            refreshGrid();
        });

        // Quick Search Input (Filters Code, Description, GSOCodeDescription, AcctgCode, Remarks)
        $("#txtPpmpSearch").off("input.ppmpAcctg").on("input.ppmpAcctg", function () {
            executeCombinedFilter();
        });

        // Segmented Status Filter Buttons
        $(".ppmp-segment-btn").off("click.ppmpAcctg").on("click.ppmpAcctg", function (e) {
            e.preventDefault();
            var status = $(this).data("status") || "all";
            applyStatusFilter(status);
        });

        // Interactive KPI Cards
        $("#cardMetricTotal").off("click.ppmpAcctg").on("click.ppmpAcctg", function () {
            applyStatusFilter("all");
        });

        $("#cardMetricAssigned").off("click.ppmpAcctg").on("click.ppmpAcctg", function () {
            applyStatusFilter("assigned");
        });

        $("#cardMetricUnassigned").off("click.ppmpAcctg").on("click.ppmpAcctg", function () {
            applyStatusFilter("unassigned");
        });

        // Modal Cancel Button
        $("#btnCancelMapping").off("click.ppmpAcctg").on("click.ppmpAcctg", function (e) {
            e.preventDefault();
            closeModal();
        });

        // Modal Save Button
        $("#btnSaveMapping").off("click.ppmpAcctg").on("click.ppmpAcctg", function (e) {
            e.preventDefault();
            submitModal();
        });

        // Form Submit handler
        $("#frmAssignAcctgCode").off("submit.ppmpAcctg").on("submit.ppmpAcctg", function (e) {
            e.preventDefault();
            submitModal();
            return false;
        });

        // Grid Action Buttons (Delegated Events for Kendo row recreation safety)
        $("#gridPpmpAcctgCode").off("click.ppmpAcctgAssign", ".js-ppmp-acctg-assign")
            .on("click.ppmpAcctgAssign", ".js-ppmp-acctg-assign", function (e) {
                e.preventDefault();
                var grid = getPpmpAcctgGrid();
                if (!grid) return;
                var dataItem = grid.dataItem($(this).closest("tr"));
                if (dataItem) {
                    openAssignModal(dataItem);
                }
            });

        $("#gridPpmpAcctgCode").off("click.ppmpAcctgEdit", ".js-ppmp-acctg-edit")
            .on("click.ppmpAcctgEdit", ".js-ppmp-acctg-edit", function (e) {
                e.preventDefault();
                var grid = getPpmpAcctgGrid();
                if (!grid) return;
                var dataItem = grid.dataItem($(this).closest("tr"));
                if (dataItem) {
                    openEditModal(dataItem);
                }
            });

        $("#gridPpmpAcctgCode").off("click.ppmpAcctgDelete", ".js-ppmp-acctg-delete")
            .on("click.ppmpAcctgDelete", ".js-ppmp-acctg-delete", function (e) {
                e.preventDefault();
                var grid = getPpmpAcctgGrid();
                if (!grid) return;
                var dataItem = grid.dataItem($(this).closest("tr"));
                if (dataItem) {
                    confirmDeleteMapping(dataItem);
                }
            });
    });
</script>

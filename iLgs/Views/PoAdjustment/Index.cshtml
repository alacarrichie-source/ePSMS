@{
    ViewBag.Title = "PO Adjustment";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("For Year", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().NumericTextBox()
                    .Name("forYear")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )            
        </div>
    </div>
</div>

@(Html.Kendo().Grid<iLgs.Models.PoAdjustmentVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.Remarks).Width(100);
        col.Bound(c => c.IsOkay).Width(50);        
        col.Bound(c => c.InsertedBy).Width(70);
        col.Bound(c => c.InsertedDt).Width(70);
        col.Bound(c => c.UpdatedBy).Width(70);
        col.Bound(c => c.UpdatedDt).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().IconClass("k-icon k-i-add").Text("Add New Record");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PoAdjustmentTemplate").Window(w => w.Width("50%").Title("PO Adjsutment Item")))
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.Remarks, "contains");        
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(30)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("Read", "PoAdjustment"))
        .Create(create => create.Action("Create", "PoAdjustment"))
        .Update(update => update.Action("Update", "PoAdjustment"))
        .Destroy(destroy => destroy.Action("Destroy", "PoAdjustment"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        ).AutoBind(true)
)


<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    .custom-max-grid .k-grid-content {
        overflow-x: auto;
        height: calc(100vh - 250px) !important;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">
    function onChangeForYear(e) {
        e.preventDefault();
        var forYear = $("#forYear").data("kendoDropDownList");
        $("#grid").data("kendoGrid").dataSource.read();        
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
            e.model.set("ForYear", $("#forYear").val());
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }

    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

</script>



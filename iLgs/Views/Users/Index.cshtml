@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.AspNetUsers_View>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.UserName).Width(70);
        col.Bound(c => c.Email).Width(100);
        col.Bound(c => c.NameFull).Width(150);
        col.Bound(c => c.Department).Width(70);
        col.Bound(c => c.Section).Width(70);
        col.Bound(c => c.Active).ClientTemplate("#= Active ? 'Y' : 'N' #").Width(50);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Access").Click("ShowAccess");
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Template(@<text>
            @(Html.Kendo().Button().Name("registerButton")
                .HtmlAttributes(new { type = "button", @class = "k-primary" })                        
                .Content("Register New User"))     
            <span class="k-searchbox k-input k-input-md k-rounded-md k-input-solid k-grid-search">
                <span class="k-input-icon k-icon k-i-search"></span>
                <input autocomplete="off" class="k-input-inner" placeholder="Search..." title="Search..." type="text">
            </span>
            @*<div class="input-group">
                <span class="input-group-addon"><span class="glyphicon glyphicon-search" aria-hidden="true"></span></span>
                <input type="text" class="form-control" id='FieldFilter' placeholder="Search for...">                        
            </div>*@
        </text>);
        //t.Search();
    })            
    .Search(s =>
    {
        s.Field(o => o.UserName, "contains");
        s.Field(o => o.Email, "contains");
        s.Field(o => o.NameFull, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.Section, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Resizable(r => r.Columns(true))   
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_UserProfileTemplate").Window(w => w.Width(800).Title("Profile")))    
    .Sortable(sortable => sortable.AllowUnsort(true).SortMode(GridSortMode.MultipleColumn))
    .Scrollable(s => s.Height(400))    
    .Filterable()
    .ClientDetailTemplateId("UserProfile")
    //.HtmlAttributes(new { style = "height:500px;" })
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("error_handler"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).Editable(false);
        })
        .Sort(s => s.Add(a => a.NameFull))
        .Read(read => read.Action("UserProfilesRead", "Users"))
        //.Create(create => create.Action("UserProfilesCreate", "Users"))
        .Update(update => update.Action("UserProfilesUpdate", "Users"))
        .Destroy(destroy => destroy.Action("UserProfilesDestroy", "Users"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e.Edit("onEditGridUser").Change("onChangeGridUser").DataBound("onDataBoundGridUser"))

)


<script id="UserProfile" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            .SelectedIndex(0)
            .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
            .Items(items =>
            {
                items.Add().Text("User Profile").Content(
                    "<div class='row'>" +
                        "<div class = 'col-md-2'>" +
                            "Image Here" +
                        "</div>" +
                        "<div class = 'col-md-6'>" +
                            "<div class='row'>" +
                                "<ul>" +
                                    "<li><label>Address:</label>#= AddressStreet #</li>" +
                                    "<li><label>City:</label>#= AddressCity #</li>" +
                                    "<li><label>Province:</label>#= AddressProvince #</li>" +
                                    "<li><label>Zip Code:</label>#= AddressZipCode #</li>" +
                                "</ul>" +
                            "</div>" +
                            "<div class='row'>" +
                                "<ul>" +
                                    "<li><label>Land Line:</label>#= TelNo #</li>" +
                                    "<li><label>Mobile No:</label>#= MobileNo #</li>" +
                                "</ul>" +
                            "</div>" +
                        "</div>" +
                    "</div>"
                );
            })
            .ToClientTemplate())
</script>



@(Html.Kendo().Window().Name("windowContainer")
        .Title("User Access")
        .Visible(false)
        .Modal(true)
        .Draggable(true)
        .Width(900)
        .Height(500)
        //.LoadContentFrom("_History", "Markets", new { stallId = "#=StallId#" })
        //.LoadContentFrom("_History", "Markets")
)



<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

</style>




<script type="text/javascript">
    var selectedGrid;
    var selectedItem;

    function onEditGridUser(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        } else {
            selectedItem = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedItem);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onChangeGridUser(e) {
        var selectedData = this.dataItem(this.select());
        selectedItem = selectedData.Id;
    }

    function onDataBoundGridUser(e) {
        if (selectedItem) {
            var dataItem = this.dataSource.get(selectedItem);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    //var selectedGrd;
    //function onEditGrid(e) {
    //    e.preventDefault();
    //    selectedGrid = e.sender;

    //    if (!e.model.isNew()) {
    //        var rowitem = selectedGrid.dataSource.get(e.model.get("Id"));
    //        var row = selectedGrid.tbody.find("tr[data-uid='" + rowitem.uid + "']");
    //        selectedGrid.select(row);
    //    }

    //}

    function onSelectUser(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#NameFull").val(dataItem.Description).trigger("change");
    }

    function ShowAccess(e) {
        e.preventDefault();
        var myTitle = "";
        var width = 1000;
        var heght = 300;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var userId = dataItem.Id;
        var userEmail = dataItem.Email;
        var userName = dataItem.UserName;

        //window.location = "_Access/?userId=" + userId + "&userEmail=" + userEmail + "&userName=" + userName;
        window.location = '@Url.Action("_Access", "Users", new { userId= "userId", userEmail = "userEmail", userName= "userName"})'

        //var dataToSend = "01";
        //var url = "Users/_Access/?userId=" + userId + "&userEmail=" + userEmail + "&userName=" + userName;
        //var actionName = ActionName();
        //var controllerName = ControllerName();
        //url.replace("actionName", actionName);
        //url.replace("controllerName", controllerName);
        //window.location = url;

    }

    $('#registerButton').click(function () {
        window.location = '@Url.Action("Register", "Account")';
    });

    function onChangeNames(e) {
        var lName = $("#NameLast").val();
        var fName = $("#NameFirst").val();
        var mName = $("#NameMid").val();

        var nameFull = lName + ((fName > '') ? ', ' + fName : '') + (mName > '' ? ' ' + mName : '');

        $("#NameFull").val(nameFull).trigger("change");
    }

    $("#FieldFilter").keyup(function () {

        //var value = $("#FieldFilter").val();
        //grid = $("#grid").data("kendoGrid");

        //if (value) {
        //    grid.dataSource.filter({ field: "Description", operator: "contains", value: value });
        //} else {
        //    grid.dataSource.filter({});
        //}
        var selecteditem = $('#FieldFilter').val();
        var kgrid = $("#grid").data("kendoGrid");
        selecteditem = selecteditem.toUpperCase();
        var selectedArray = selecteditem.split(" ");
        if (selecteditem) {
            var orfilter = { logic: "or", filters: [] };
            var andfilter = { logic: "and", filters: [] };
            $.each(selectedArray, function (i, v) {
                if (v.trim() == "") {
                }
                else {
                    $.each(selectedArray, function (i, v1) {
                        if (v1.trim() == "") {
                        }
                        else {
                            orfilter.filters.push({ field: "UserName", operator: "contains", value: v1 });
                            orfilter.filters.push({ field: "Email", operator: "contains", value: v1 });
                            orfilter.filters.push({ field: "NameFull", operator: "contains", value: v1 });
                            orfilter.filters.push({ field: "Department", operator: "contains", value: v1 });
                            andfilter.filters.push(orfilter);
                            orfilter = { logic: "or", filters: [] };
                        }
                    });
                }
            });
            kgrid.dataSource.filter(andfilter);
        }
        else {
            kgrid.dataSource.filter({});
        }
    });

</script>



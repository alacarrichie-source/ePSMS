@*@ViewData["userId"]*@
@*@using (Html.BeginForm())
    {*@
<div style="margin-left:-150px;margin-right:-150px;">
    <h2 style="color:silver">Menu Access</h2>

    <br />

    <div class="row">
        <div class="col-md-2 text-right">
            @Html.Label("User Id", new { style = "color:silver" })
        </div>
        <div class="col-md-2" style="color:silver">
            @ViewData["userName"]
        </div>
    </div>
    <div class="row">
        <div class="col-md-2 text-right">
            @Html.Label("Name", new { style = "color:silver" })
        </div>
        <div class="col-md-2" style="color:silver">
            @ViewData["nameFull"]
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2 text-right">
            @Html.Label("Application", new { style = "color:silver" })
        </div>
        <div class="col-md-2">
            @(Html.Kendo().ComboBox()
                .Name("sysCode")
                    //.HtmlAttributes(new { style = "width:300px" })
                .Placeholder("Select System")
                .DataTextField("Code")
                .DataValueField("Code")
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetSysCodes", "SysCodes");
                    })
                    .ServerFiltering(true);
                })
            )
        </div>
    </div>
    <div class="row">
        <div class="col-md-2 text-right">
            @Html.Label("Menu Level", new { style = "color:silver" })
        </div>
        <div class="col-md-2">
            @(Html.Kendo().ComboBox()
                .Name("parentId")
                    //.HtmlAttributes(new { style = "width:300px" })
                .Placeholder("Select Level")
                .Filter(FilterType.Contains)
                    //.BindTo(ViewData["MenuLevel"] as SelectList)
                .DataTextField("Description")
                .DataValueField("Code")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        //read.Action("GetMenulevels", "Menu", new { sysCode = @ViewData["sysCode"] });
                        read.Action("GetMenulevels", "Menu").Data("DataMenuLevel");
                    })
                    .ServerFiltering(true);
                })
                .CascadeFrom("sysCode")
            )
        </div>
        <div class="col-md-5">
            <input type="submit" value="Submit" id="cmdSubmit" />
            @(Html.Kendo().Button().Name("btnCopy").Content("Copy Access").Enable(false))
        </div>
    </div>
    <br />
    @*}*@

    <div class="row">
        <div class="col-md-7">
            @(Html.Kendo().Grid<iLgs.Models.MenubaseVM>()
            .Name("grid")
            .Columns(col =>
            {
                col.Bound(c => c.ChildId).Hidden();
                col.Bound(c => c.Description).Width(200).Filterable(true);
                col.Bound(c => c.Result).Width(50).Filterable(true);
                col.Command(command =>
                {
                    command.Custom("Select").Text("Select").Click("onCommand");
                    command.Custom("Include").Click("onInclude");
                }).Width(75);
            })
                    //.Pageable()
            .NoRecords()
            .Sortable()
            .Scrollable(s => s.Height(350))
                    //.HtmlAttributes(new { style = "height:300px;" })
            .DataSource(dataSource => dataSource
                .Ajax()
                //.PageSize(20)
                .Events(events => events.Error("error_handler"))
                .Model(model =>
                {
                    model.Id(p => p.ChildId);
                    model.Field(p => p.ChildId).Editable(false);
                })
                .Read(read => read.Action("MenuAccessRead", "Roles").Data("MenuData"))
            )
            .Selectable(s => s.Mode(GridSelectionMode.Single))
            .Events(events => events.Change("onChange").DataBound("onDataBound"))
            .AutoBind(false)                    
            )
        </div>
        <div class="col-lg-5">

            @(Html.Kendo().Grid<iLgs.Models.MenuActionSw>()
                .Name("gridExtn")
                .Columns(columns =>
                {
                    columns.Bound(o => o.Code).Width(100);
                    columns.Command(command =>
                    {
                        command.Custom("Include").Click("onIncludeAction");
                    }).Width(75);
                })
                .NoRecords()
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .HtmlAttributes(new { style = "height:100px;" })
                .DataSource(dataSource => dataSource
                    .Ajax()                
                    .Model(model =>
                        {
                            model.Id(p => p.Code);                        
                        })
                    .Read(read => read.Action("MenuAccessActionRead", "MenuAccessAction").Data("GridExtnData"))                
                )
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .Events(events => events.Change("onChangeExtn").DataBound("onDataBoundExtn"))
                .AutoBind(false)                
            )

        </div>
    </div>
</div>

<div id="windowcontainer"></div>

<style>
    .WithAccess {
        background: LightYellow;
    }

    .NoAccess {
        background: Pink;
    }
</style>



<script type="text/javascript">
    function sync_handler(e) {
        this.read();
    }

    function DataMenuLevel() {
        return {
            sysCode: $("#sysCode").val()
        };
    }

    $("#cmdSubmit").click(function (e) {
        e.preventDefault();
        $("#grid").data("kendoGrid").dataSource.read();
    })

    var accessId = null;
    var childId = null;
    function onChange() {
        var selectedData = this.dataItem(this.select());
        childId = selectedData.ChildId;
        accessId = selectedData.AccessId;
        $("#gridExtn").data("kendoGrid").dataSource.read();
    }

    function onDataBound(e) {

        var grid = this;
        //var row = e.sender.tbody.find("tr:first");
        //grid.select(row);

        //var data = grid.dataSource.data();

        grid.tbody.find(">tr").each(function () {
            var dataItem = grid.dataItem(this);
            if (!dataItem.IsAllowed) {
                $(this).css("font-style", "italic");
                $(this).css("font-weight", "normal");
                $(this).find('.k-grid-Include').text('Include');
            } else {
                $(this).css("font-weight", "bold");
                $(this).find('.k-grid-Include').text('Exclude');
            }
        });

        if (childId) {
            var dataItem = this.dataSource.get(childId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }


        var count = grid.dataSource.total();
        $("#btnCopy").data('kendoButton').enable(count != 0);
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }


    function MenuData() {
        return {
            sysCode: $("#sysCode").val(),
            parentId: $("#parentId").val(),
            userId: '@ViewData["userId"]',
            superAdmin: '@ViewData["superAdmin"]',
            department: '@ViewData["department"]'
        };
    }

    //function onCommand(e) {
    //    var tr = $(e.target).closest("tr"); // get the current table row (tr)
    //    // get the data bound to the current table row
    //    var data = this.dataItem(tr);
    //    var childId = data.ChildId;

    //    $("#parentId").val(childId);
    //    $("#cmdSubmit").click();
    //}

    function onCommand(e) {
        var tr = $(e.target).closest("tr"); // get the current table row (tr)
        // get the data bound to the current table row
        var data = this.dataItem(tr);
        childId = data.ChildId;

        var cb = $('#parentId').data('kendoComboBox');
        cb.dataSource.read({ sysCode: '@ViewData["sysCode"]' })
        cb.value(childId);
        $("#grid").data("kendoGrid").dataSource.read();
        setTimeout(childId = null, 300);
    }


    function onInclude(e) {
        var grid = $("#grid").data("kendoGrid");

        var tr = $(e.target).closest("tr"); // get the current table row (tr)
        var data = this.dataItem(tr);
        childId = data.ChildId;
        $.ajax({
            type: "POST",
            url: '@Url.Action("MenuAccessSet", "Users")',
            data: {
                'userId': '@ViewData["userId"]', 'childId': childId, 'sysCode': $("#sysCode").val()
            }
        }).done(function (result) {
            $("#gridExtn").data("kendoGrid").dataSource.read();
        }).always(function () {
            grid.dataSource.read();
        });
    }

    function onIncludeAction(e) {
        var grid = $("#gridExtn").data("kendoGrid");
        var tr = $(e.target).closest("tr"); // get the current table row (tr)
        var data = this.dataItem(tr);

        actionId = data.ActionId;
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("AccessActionSet", "Users")',
            data: {
                'userId': '@ViewData["userId"]', 'accessId': accessId, 'actionId': actionId
            }
        }).done(function (result) {
            $("#gridExtn").data("kendoGrid").dataSource.read();
        }).always(function () {
            grid.dataSource.read();
        });
    }

    function GridExtnData() {
        return {
            userId: '@ViewData["userId"]',
            childId: childId,
            sysCode: $("#sysCode").val()
        };
    }

    $("#btnCopy").click(function (e) {
        e.preventDefault();
        var userId = '@ViewData["userId"]';
        var userName = '@ViewData["userName"]';
        var sysCode = $("#sysCode").data("kendoComboBox").value();


        var myUrl = '@Url.Action("_CopyAccess", "Users")';
        var myTitle = "Menu - Copy Access";
        var width = 1000;
        var height = 550;
        $("#windowcontainer").append("<div id='windowCopy'></div>");
        var mywindow = $("#windowCopy")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: myUrl,
            data: {
                userId: userId,
                userName: userName,
                sysCode: sysCode
            }
        });
        mywindow.center();
        mywindow.open();
    })

    var actionId = null;
    function onChangeExtn() {
        var selectedData = this.dataItem(this.select());
        actionId = selectedData.ActionId;
        //$("#gridExtn").data("kendoGrid").dataSource.read();
    }

    function onDataBoundExtn(e) {

        var grid = this;
        
        grid.tbody.find(">tr").each(function () {
            var dataItem = grid.dataItem(this);
            if (!dataItem.IsAllowed) {
                $(this).css("font-style", "italic");
                $(this).css("font-weight", "normal");
                $(this).find('.k-grid-Include').text('Include');
            } else {
                $(this).css("font-weight", "bold");
                $(this).find('.k-grid-Include').text('Exclude');
            }
        });

        if (actionId) {
            var dataItem = this.dataSource.get(actionId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }        
    }

    //function CopyAccess(e) {
    //    e.preventDefault();
    //    alert('x');
    //    return;

    //    var myTitle = "";
    //    var width = 1000;
    //    var heght = 300;
    //    var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
    //    var userId = dataItem.UserId;
    //    var nameFull = dataItem.NameFull;
    //    var userName = dataItem.UserName;
    //    var userName = dataItem.SysCode;

    //    var rowitem = this.dataSource.get(dataItem.Id);
    //    var row = this.tbody.find("tr[data-uid='" + rowitem.uid + "']");
    //    this.select(row);
    //}


    function onSelectTargetUser(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#TargetNameFull").val(dataItem.NameFull).trigger("change");
        $("#TargetUserName").val(dataItem.UserName).trigger("change");
    }
</script>

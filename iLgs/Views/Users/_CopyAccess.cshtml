
@model  iLgs.Models.CopyAccessVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "formCopyAccess", id = "formCopyAccess" }))
{
    @Html.AntiForgeryToken()


    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.HiddenFor(model => model.SourceUserId)
    @Html.HiddenFor(model => model.TargetNameFull)

    <div class="form-group" style="padding:30px;">
        <div class="row">
            @Html.LabelFor(model => model.SysCode, new { @class = "col-md-11" })
            <div class="col-md-11">
                @(Html.Kendo().TextBoxFor(model => model.SysCode).HtmlAttributes(new { style = "width:100%; max-width:100%" }).Enable(false))
            </div>
        </div>
        <br />
        <h4>Copy From</h4>        
        <div class="row">
            @Html.LabelFor(model => model.SourceUserName, new { @class = "col-md-11" })
            <div class="col-md-11">
                @(Html.Kendo().TextBoxFor(model => model.SourceUserName).HtmlAttributes(new { style = "width:100%; max-width:100%" }).Enable(false))
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(model => model.SourceNameFull, new { @class = "col-md-11" })
            <div class="col-md-11">
                @(Html.Kendo().TextBoxFor(model => model.SourceNameFull).HtmlAttributes(new { style = "width:100%; max-width:100%" }).Enable(false))
            </div>
        </div>
        <br />            
        <h4>Copy To</h4>    
        <div class="row">
            @Html.LabelFor(model => model.TargetUserId, "Full Name", new { @class = "col-md-11" })
            <div class="col-md-11">
                @(Html.Kendo().ComboBoxFor(Model => Model.TargetUserId)
                .HtmlAttributes(new { style = "width:100%; max-width:100%"  })
                .Placeholder("Select user")
                .DataTextField("NameFull")
                .DataValueField("OwnerId")
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetRoleUsers", "Users");
                    })
                    .ServerFiltering(true);
                })
                .AutoBind(true)
                .Events(e => { e.Select("onSelectTargetUser"); })
                )
                @Html.ValidationMessageFor(model => model.TargetUserId)
            </div>
        </div>
        <div class="row">
            @Html.LabelFor(model => model.TargetUserName, new { @class = "col-md-11" })
            <div class="col-md-11">
                @(Html.Kendo().TextBoxFor(model => model.TargetUserName).HtmlAttributes(new { style = "width:100%; max-width:100%" }).Enable(false))
            </div>
        </div>

        <br />
        <div class="row">
            <div class="k-edit-buttons k-state-default col-md-offset-5">
                <a class="k-button k-button-icontext k-primary k-grid-update" id="btnSave"><span class="k-icon k-update"></span>Ok</a>
                <a class="k-button k-button-icontext k-grid-cancel" id="btnCancel"><span class="k-icon k-cancel"></span>Cancel</a>
            </div>
        </div>
    </div>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        var validator = $("#formCopyAccess").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#formCopyAccess").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("CopyAccessSave", "Users")',
                data: $("#formCopyAccess").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#formCopyAccess"), true);
                }
            }).done(function (result) {
                window.kendo.ui.progress($("#formCopyAccess"), false);
                if (result.Errors == "") {
                    $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                } else {
                    alert(result.Errors);                    
                }
            }).fail(function (req, status, errorObj) {
                alert(req.responseText);
                window.kendo.ui.progress($("#formCopyAccess"), false);
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
    });
</script>
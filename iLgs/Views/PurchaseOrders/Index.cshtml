@*Index.cshtml*@
@using Kendo.Mvc.UI
@using iLgs.Ai.Models

@{
    ViewBag.Title = "Purchase Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var printUrl = Url.Action("PrintPO", "PurchaseOrders");
    var pdfUrl = Url.Action("DownloadPdf", "PurchaseOrders");
    var resumeDraftUrl = Url.Action("Wizard", "PurchaseOrders");
}

<div class="epsms-procurement po-wizard">
    @Html.AntiForgeryToken()
    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a> &gt;
        <a href="@Url.Action("Index", "Procurement")">Procurement</a> &gt;
        <span>Purchase Orders</span>
    </div>

    <!-- Header Bar -->
    <div class="header-bar">
        <div>
            <h1>Purchase Orders</h1>
            <p class="subtitle">Local Government Unit procurement obligations, PO status tracking, and GAM Form 101-A generation.</p>
        </div>
        <div class="action-toolbar">
            <a href="@Url.Action("Wizard", "PurchaseOrders")" class="k-button k-button-solid-primary k-rounded-md">
                <span class="k-icon k-i-plus"></span> Generate New PO
            </a>
        </div>
    </div>

    <section class="wizard-drafts-card" aria-labelledby="wizardDraftsHeading">
        <div class="wizard-drafts-header">
            <div>
                <h2 id="wizardDraftsHeading">My Drafts</h2>
                <p>Continue an unfinished Purchase Order wizard from where you stopped.</p>
            </div>
            <span class="k-icon k-i-save wizard-drafts-icon" aria-hidden="true"></span>
        </div>

        @(Html.Kendo().Grid<POWizardDraftListItemViewModel>()
            .Name("MyWizardDraftsGrid")
            .Columns(columns =>
            {
                columns.Bound(d => d.DraftName).Title("Draft").Width(190);
                columns.Bound(d => d.SelectedPRCount).Title("Selected PRs").Width(110)
                    .HtmlAttributes(new { @class = "text-center" });
                columns.Bound(d => d.CurrentStep).Title("Progress").Width(190)
                    .ClientTemplate(
                        "<span class='wizard-draft-step'>Step #=CurrentStep# of 4</span>" +
                        "<span class='wizard-draft-step-name'>#=wizardDraftStepName(CurrentStep)#</span>");
                columns.Bound(d => d.LastUpdatedAt).Title("Last Saved")
                    .Format("{0:MMM dd, yyyy h:mm tt}").Width(190);
                columns.Bound(d => d.Id).Title("Actions").Width(180)
                    .Sortable(false).Filterable(false)
                    .ClientTemplate(
                        "<div class='wizard-draft-actions'>" +
                            "<a class='btn-procurement-primary' href='" + resumeDraftUrl + "?draftId=#=Id#'>" +
                                "<span class='k-icon k-i-arrow-right'></span> Resume" +
                            "</a>" +
                            "<button type='button' class='btn-procurement-secondary' onclick=\"discardWizardDraft('#=Id#')\">Discard</button>" +
                        "</div>");
            })
            .NoRecords()
            .Sortable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("MyWizardDrafts_Read", "PurchaseOrders"))
                .Sort(sort => sort.Add(d => d.LastUpdatedAt).Descending())
            )
        )
    </section>

    <!-- Filter Panel -->
    <div class="filter-panel">
        <div class="filter-row">
            <div class="search">
                <label for="searchPO">Search Purchase Orders</label>
                <input id="searchPO" type="text" class="form-control-custom" placeholder="Search by PO Number, Supplier name, PR reference..." onkeyup="onSearchFilter(this.value)" />
            </div>
            <div>
                <label for="statusFilter">Status Filter</label>
                <select id="statusFilter" class="form-control-custom" onchange="onStatusFilter(this.value)">
                    <option value="">All Statuses</option>
                    <option value="Posted">Posted</option>
                    <option value="Draft">Draft</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Data Card: Kendo Grid -->
    <div class="data-card">
        @(Html.Kendo().Grid<PurchaseOrderGridViewModel>()
            .Name("PurchaseOrdersGrid")
            .Columns(columns =>
            {
                columns.Bound(p => p.PONumber).Title("PO No.").Width(150).ClientTemplate(
                    "<a href='javascript:void(0);' class='fw-bold text-primary' onclick='openPODetails(#=Id#)'>#=PONumber#</a>"
                );
                columns.Bound(p => p.PODate).Title("PO Date").Format("{0:MMM dd, yyyy}").Width(130);
                columns.Bound(p => p.SupplierName).Title("Supplier").Width(220);
                columns.Bound(p => p.SourcePRs).Title("Source PR(s)").Width(160);
                columns.Bound(p => p.ItemCount).Title("Items").Width(90).HtmlAttributes(new { @class = "text-center" });
                columns.Bound(p => p.TotalAmount).Title("Total Amount").Format("{0:n2}").Width(160)
                    .HtmlAttributes(new { style = "text-align:right;", @class = "text-right font-weight-bold" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                columns.Bound(p => p.Status).Title("Status").Width(130).ClientTemplate(
                    "# if (Status == 'Posted') { #" +
                        "<span class='status-badge status-posted'>Posted</span>" +
                    "# } else if (Status == 'Draft') { #" +
                        "<span class='status-badge status-draft'>Draft</span>" +
                    "# } else if (Status == 'Cancelled') { #" +
                        "<span class='status-badge status-cancelled'>Cancelled</span>" +
                    "# } else { #" +
                        "<span class='status-badge'>#=Status#</span>" +
                    "# } #"
                );
                // ACTIONS
                columns.Bound(p => p.Id)
                    .Title("Actions")
                    .Width(140)
                    .Sortable(false)
                    .Filterable(false)
                    .ClientTemplate(
                        "<div class='d-flex gap-1 justify-content-end'>" +

                            // View
                            "<button type='button' " +
                                "class='k-button k-button-sm k-button-flat-primary' " +
                                "title='View Details' " +
                                "onclick='openPODetails(#=Id#)'>" +
                                "<span class='k-icon k-i-eye'></span>" +
                            "</button>" +

                            // Print
                            "<a href='" + printUrl + "?id=#=Id#' " +
                                "target='_blank' " +
                                "class='k-button k-button-sm k-button-flat-secondary' " +
                                "title='Print Form 101-A'>" +
                                "<span class='k-icon k-i-print'></span>" +
                            "</a>" +

                            // PDF
                            "<a href='" + pdfUrl + "/#=Id#' " +
                                "class='k-button k-button-sm k-button-flat-secondary' " +
                                "title='Download PDF'>" +
                                "<span class='k-icon k-i-pdf'></span>" +
                            "</a>" +

                        "</div>"
                    );
            })
            .Pageable(pager => pager.PageSizes(new[] { 10, 20, 50, 100 }).Refresh(true))
            .Sortable()
            .Filterable()
            .Groupable()
            .Resizable(r => r.Columns(true))
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(20)
                .Read(read => read.Action("PurchaseOrders_Read", "PurchaseOrders"))
                .Sort(s => s.Add(p => p.PODate).Descending())
            )
        )
    </div>
</div>



<!-- PO Details Modal Window -->
<div id="poDetailsWindow"></div>

<script>
    function wizardDraftStepName(step) {
        return {
            1: "Select PRs",
            2: "Assign Groups",
            3: "PO Details",
            4: "Review & Post"
        }[step] || "In progress";
    }

    function discardWizardDraft(draftId) {
        if (!window.confirm("Discard this wizard draft? It will no longer appear in My Wizard Drafts.")) return;
        $.ajax({
            url: "@Url.Action("DiscardWizardDraft", "PurchaseOrders")",
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                id: draftId
            }
        }).done(function (response) {
            if (!response.success) {
                if (window.kendo && kendo.alert) kendo.alert(response.message || "The draft could not be discarded.");
                return;
            }
            var grid = $("#MyWizardDraftsGrid").data("kendoGrid");
            if (grid) grid.dataSource.read();
        }).fail(function () {
            if (window.kendo && kendo.alert) kendo.alert("The draft could not be discarded.");
        });
    }

    function openPODetails(poId) {
        var wnd = $("#poDetailsWindow").data("kendoWindow");
        if (!wnd) {
            $("#poDetailsWindow").kendoWindow({
                width: "920px",
                title: "Purchase Order Details (GAM 101-A)",
                visible: false,
                modal: true,
                actions: ["Maximize", "Close"]
            });
            wnd = $("#poDetailsWindow").data("kendoWindow");
        }
        wnd.refresh({
            url: "@Url.Action("GetPODetailsModal", "PurchaseOrders")",
            data: { id: poId }
        });
        wnd.center().open();
    }

    function onSearchFilter(query) {
        var grid = $("#PurchaseOrdersGrid").data("kendoGrid");
        if (query) {
            grid.dataSource.filter({
                logic: "or",
                filters: [
                    { field: "PONumber", operator: "contains", value: query },
                    { field: "SupplierName", operator: "contains", value: query },
                    { field: "SourcePRs", operator: "contains", value: query }
                ]
            });
        } else {
            grid.dataSource.filter({});
        }
    }

    function onStatusFilter(status) {
        var grid = $("#PurchaseOrdersGrid").data("kendoGrid");
        if (status) {
            grid.dataSource.filter({ field: "Status", operator: "eq", value: status });
        } else {
            grid.dataSource.filter({});
        }
    }
</script>

@using Kendo.Mvc.UI

<div class="wizard-card step4-review-container">
    <div class="step4-header">
        <div>
            <div class="step4-title-row">
                <h2>Step 4: Review, Document Attachments &amp; Obligate</h2>
                <span class="k-badge k-badge-solid k-badge-primary k-rounded-md">Draft Mode</span>
            </div>
            <p class="subtitle">Review each PO group, attach the signed PO and supporting documents, then save or post.</p>
        </div>
        <div class="step4-metrics" aria-live="polite">
            <div id="step4ReadinessBadge" class="step4-readiness is-pending">
                <span class="k-icon k-i-warning"></span>
                <div><strong>Needs attention</strong><span id="step4ValidationSummary">Review required fields</span></div>
            </div>
            <div class="step4-total">
                <span>Grand obligation total</span>
                <strong id="step4GrandTotalAmount">PHP 0.00</strong>
            </div>
        </div>
    </div>

    <div id="step4ReviewGroupsContainer" class="step4-groups"></div>

    <div class="step4-certification">
        <label for="chkStep4Certification">
            <input type="checkbox" id="chkStep4Certification" onchange="refreshStep4Readiness()" />
            <span><strong>Procurement compliance certification:</strong> I confirm that the submitted items, quantities, supplier awards, and procurement terms have been checked against the approved procurement records and applicable rules.</span>
        </label>
    </div>

    <div class="wizard-summary-bar wizard-final-actions">
        <button type="button" class="btn-procurement-secondary" onclick="goToWizardStep(3)">
            <span class="k-icon k-i-arrow-left"></span> Back to PO Item Details
        </button>
        <div class="wizard-action-group">
            <button type="button" id="btnStep4SaveDraft" class="btn-procurement-secondary" onclick="submitPOs(true)">Save as Draft</button>
            <button type="button" id="btnPostPurchaseOrders" class="btn-procurement-primary btn-post-po" onclick="submitPOs(false)" disabled="disabled">
                <span class="k-icon k-i-check"></span> Obligate &amp; Post Purchase Orders
            </button>
        </div>
    </div>
</div>

@(Html.Kendo().Window()
    .Name("step4PreviewWindow")
    .Title("Purchase Order Draft Preview")
    .Width(880)
    .Height(650)
    .Modal(true)
    .Visible(false)
    .Actions(actions => actions.Maximize().Close())
    .Content(@<text><div id="step4PreviewContent" class="step4-preview"></div></text>)
)

<script type="text/javascript">
    var expandedReviewGroupIndex = 0;

    function formatStep4Currency(amount) {
        return "PHP " + Number(amount || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatStep4GridAmount(amount) {
        return Number(amount || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function applyPoGroupDepartmentDefault(group) {
        if (!group) return;
        if (group.deptId) return;

        var sourcePRs = group.sourcePRs || [];
        var distinctDeptIds = [];
        var deptIdMap = {};

        $.each(sourcePRs, function (_, spr) {
            var did = spr.DepartmentId || spr.DeptId || spr.departmentId || spr.deptId;
            if (did) {
                var key = String(did).toLowerCase();
                if (distinctDeptIds.indexOf(key) === -1) {
                    distinctDeptIds.push(key);
                    deptIdMap[key] = {
                        id: did,
                        name: spr.DepartmentName || spr.Department || spr.departmentName || spr.department || ""
                    };
                }
            }
        });

        if (distinctDeptIds.length === 1) {
            var defaultDept = deptIdMap[distinctDeptIds[0]];
            group.deptId = defaultDept.id;
            group.department = defaultDept.name;
        } else {
            group.deptId = null;
            group.department = "";
        }
    }

    function buildStep4SourcePrsPanel(group) {
        var sourcePRs = group.sourcePRs || [];
        var section = $('<section class="step3-card group-card step4-detail-section" style="margin-bottom:16px"></section>');
        section.append($('<div class="group-title text-navy"><span class="k-icon k-i-file-txt" style="color:#115cb9"></span> Source Purchase Requests</div>'));

        if (!sourcePRs.length) {
            section.append($('<div class="text-muted" style="font-size:12px; padding:8px 12px;">No source Purchase Requests recorded.</div>'));
            return section;
        }

        var tableWrapper = $('<div class="step4-table-wrapper" style="overflow-x:auto;"></div>');
        var table = $('<table class="step4-items-table" style="width:100%; border-collapse:collapse;"></table>');
        var thead = $('<thead><tr><th style="text-align:left; padding:8px 12px; width:40%;">PR No.</th><th style="text-align:left; padding:8px 12px; width:60%;">Requesting Department</th></tr></thead>');
        var tbody = $('<tbody></tbody>');

        $.each(sourcePRs, function (_, spr) {
            var prNo = spr.PRNumber || spr.prNumber || spr.PrNo || spr.prNo || "";
            var dept = spr.DepartmentName || spr.departmentName || spr.Department || spr.department || spr.RequestingDepartment || "&mdash;";
            var row = $('<tr></tr>');
            row.append($('<td style="padding:6px 12px; font-family:monospace; font-weight:600; color:#1e40af;"></td>').text(prNo || "-"));
            row.append($('<td style="padding:6px 12px; color:#334155;"></td>').html(dept || "&mdash;"));
            tbody.append(row);
        });

        table.append(thead).append(tbody);
        tableWrapper.append(table);
        section.append(tableWrapper);
        return section;
    }

    function renderStep4Review() {
        var container = $("#step4ReviewGroupsContainer");
        kendo.destroy(container);
        container.empty();
        var grandTotal = 0;
        if (typeof syncPOGroupSourcePRs === "function") syncPOGroupSourcePRs();

        if (!poGroups || poGroups.length === 0) {
            container.html('<div class="wizard-empty-state">No PO groups configured. Return to Step 2.</div>');
            refreshStep4Readiness();
            return;
        }

        $.each(poGroups, function (index, group) {
            applyPoGroupDepartmentDefault(group);
            var groupTotal = 0;
            $.each(group.items || [], function (_, item) { groupTotal += Number(item.qty || 0) * Number(item.unitCost || 0); });
            grandTotal += groupTotal;

            var card = $('<section class="step4-group-card"></section>');
            var header = $('<button type="button" class="step4-group-header"></button>')
                .attr("aria-expanded", expandedReviewGroupIndex === index ? "true" : "false")
                .on("click", function () {
                    expandedReviewGroupIndex = expandedReviewGroupIndex === index ? -1 : index;
                    renderStep4Review();
                });
            $("<span class='step4-group-number'></span>").text(index + 1).appendTo(header);
            var heading = $("<span class='step4-group-heading'></span>").appendTo(header);
            $("<strong></strong>").text(group.groupName || ("PO Group " + (index + 1))).appendTo(heading);
            $("<small></small>").text((group.supplierName || "Supplier not selected") + " • " + (group.items || []).length + " item(s)").appendTo(heading);
            $("<span class='step4-group-amount'></span>").text(formatStep4Currency(groupTotal)).appendTo(header);
            $("<span class='k-icon'></span>").addClass(expandedReviewGroupIndex === index ? "k-i-arrow-chevron-up" : "k-i-arrow-chevron-down").appendTo(header);
            card.append(header);

            if (expandedReviewGroupIndex === index) {
                var body = $('<div class="step4-group-body"></div>');
                body.append(buildStep4SourcePrsPanel(group));
                body.append(buildStep4PoDetailsPanel(group, index));
                body.append(buildStep4ItemsTable(group));
                body.append(buildStep4DocumentPanel(group, index));
                card.append(body);
            }
            container.append(card);
            if (expandedReviewGroupIndex === index) {
                initializeStep4PoDetails(group, index);
                initializeStep4DocumentUploads(group, index);
            }
        });

        $("#step4GrandTotalAmount").text(formatStep4Currency(grandTotal));
        refreshStep4Readiness();
    }

    function step4FieldId(name, groupIndex) {
        return "Step4" + name + "_" + groupIndex;
    }

    function buildStep4Field(label, control, fullWidth) {
        return $('<div class="form-field' + (fullWidth ? ' step3-field-full' : '') + '"></div>')
            .append($('<label></label>').html(label))
            .append(control);
    }

    function buildStep4PoDetailsPanel(group, groupIndex) {
        var wrapper = $('<div class="step4-po-details"></div>');
        var headerFields = $('<div class="step3-fields-grid"></div>');
        headerFields.append(buildStep4Field('PO No. <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('PoNo', groupIndex)), false));
        headerFields.append(buildStep4Field('PO Date <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('PoDate', groupIndex)), false));
        headerFields.append(buildStep4Field('Department <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('DeptId', groupIndex)), false));
        headerFields.append($('<input type="hidden" />').attr('id', step4FieldId('Department', groupIndex)).val(group.department || ""));
        headerFields.append(buildStep4Field('Mode of Procurement <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('ProcurementMode', groupIndex)), false));
        headerFields.append(buildStep4Field('Supplier <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('Supplier', groupIndex)), true));
        headerFields.append(buildStep4Field('Address', $('<input />').attr('id', step4FieldId('SupAddress', groupIndex)), true));
        headerFields.append(buildStep4Field('TIN', $('<input />').attr('id', step4FieldId('SupTIN', groupIndex)), false));
        wrapper.append(buildStep4Section('k-i-user', 'Header Details', headerFields));

        var termsFields = $('<div class="step3-fields-grid"></div>');
        termsFields.append(buildStep4Field('Place of Delivery <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('PlaceOfDelivery', groupIndex)), true));
        termsFields.append(buildStep4Field('Date of Delivery', $('<input />').attr('id', step4FieldId('DeliveryDate', groupIndex)), false));
        termsFields.append(buildStep4Field('Delivery Term <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('DeliveryTerm', groupIndex)), false));
        termsFields.append(buildStep4Field('Payment Term <span class="required-marker">*</span>', $('<input />').attr('id', step4FieldId('PaymentTerms', groupIndex)), true));
        wrapper.append(buildStep4Section('k-i-cart', 'Delivery &amp; Payment Terms', termsFields));

        var signatoryFields = $('<div class="step3-fields-grid"></div>');
        signatoryFields.append(buildStep4Field('Supplier Signatory', $('<input />').attr('id', step4FieldId('SignedBySuppName', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Date Signed', $('<input />').attr('id', step4FieldId('SignedBySuppDate', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Authorized Official', $('<input />').attr('id', step4FieldId('SignedByAuthName', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Designation', $('<input />').attr('id', step4FieldId('SignedByAuthDesignation', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Resolution No.', $('<input />').attr('id', step4FieldId('ResoNo', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Certified Correct By', $('<input />').attr('id', step4FieldId('CertifiedCorrectBy', groupIndex)), false));
        signatoryFields.append(buildStep4Field('Date Certified', $('<input />').attr('id', step4FieldId('CertifiedCorrectDate', groupIndex)), false));
        wrapper.append(buildStep4Section('k-i-check-circle', 'Signatories &amp; Certification', signatoryFields));
        return wrapper;
    }

    function buildStep4Section(iconClass, title, fields) {
        return $('<section class="step3-card group-card step4-detail-section" style="margin-bottom:16px"></section>')
            .append($('<div class="group-title text-navy"><span class="k-icon ' + iconClass + '" style="color:#115cb9"></span> ' + title + '</div>'))
            .append(fields);
    }

    function initializeStep4PoDetails(group, groupIndex) {
        var poNumberElement = $('#' + step4FieldId('PoNo', groupIndex)).attr('style', 'width: 100%; max-width: 100%;');
        poNumberElement.kendoMaskedTextBox({ mask: '0000-00-0000', promptChar: ' ', value: group.poNumber || '',
            change: function () { setStep4GroupField(groupIndex, 'poNumber', this.value()); },
            enable: !(typeof existingOrderId !== 'undefined' && existingOrderId)
        });
        var poNumberWidget = poNumberElement.data('kendoMaskedTextBox');
        poNumberWidget.enable(true);
        fitStep4KendoWidget(poNumberWidget);

        var deptElement = $('#' + step4FieldId('DeptId', groupIndex)).attr('style', 'width: 100%; max-width: 100%;');
        var resolvingInitialDept = !!group.deptId;
        deptElement.kendoMultiColumnComboBox({
            placeholder: "Select Department",
            dataTextField: "Description",
            dataValueField: "Id",
            valuePrimitive: true,
            filter: "contains",
            minLength: 1,
            autoBind: true,
            columns: [
                { field: "Code", title: "Code", width: 120 },
                { field: "Description", title: "Description", width: 280 }
            ],
            dataSource: step4RemoteDataSource('@Url.Action("GetUserDepartmentsAsync", "Getters")', function () {
                var widget = deptElement.data("kendoMultiColumnComboBox");
                return { text: widget ? (widget.text() || "") : "" };
            }),
            dataBound: function () {
                if (!group.deptId) return;
                var targetId = String(group.deptId).toLowerCase();
                var match = null;
                $.each(this.dataSource.view(), function (_, dept) {
                    if (String(dept.Id).toLowerCase() === targetId) { match = dept; return false; }
                });
                if (match) {
                    this.value(match.Id);
                    this.text(match.Description || group.department || "");
                    if (this.input) this.input.val(match.Description || group.department || "");
                    setStep4Department(groupIndex, match);
                } else if (group.department) {
                    this.value(group.deptId);
                    this.text(group.department);
                    if (this.input) this.input.val(group.department);
                }
                resolvingInitialDept = false;
            },
            select: function (e) {
                setStep4Department(groupIndex, e.dataItem);
            },
            change: function () {
                if (!this.value()) {
                    setStep4Department(groupIndex, null);
                } else {
                    var item = this.dataItem();
                    setStep4Department(groupIndex, item || { Id: this.value(), Description: this.text() });
                }
            }
        });
        var deptCombo = deptElement.data("kendoMultiColumnComboBox");
        fitStep4KendoWidget(deptCombo);
        if (group.deptId) {
            deptCombo.value(group.deptId);
            if (group.department) {
                deptCombo.text(group.department);
                if (deptCombo.input) deptCombo.input.val(group.department);
            }
        }

        var procurementElement = $('#' + step4FieldId('ProcurementMode', groupIndex)).attr('style', 'width: 100%; max-width: 100%;');
        procurementElement.kendoMultiColumnComboBox({
            placeholder: 'Select Procurement Mode', dataTextField: 'Description', dataValueField: 'Description', valuePrimitive: true,
            filter: 'contains', columns: [{ field: 'Description', title: 'Procurement Mode', width: 300 }],
            dataSource: step4RemoteDataSource('@Url.Action("GetCodeList", "Getters")', step4CodeLookupData(procurementElement, 'PROC-MODE')),
            value: group.modeOfProcurement || '', change: function () { setStep4GroupField(groupIndex, 'modeOfProcurement', this.value()); }
        });
        fitStep4KendoWidget(procurementElement.data('kendoMultiColumnComboBox'));

        var supplierElement = $('#' + step4FieldId('Supplier', groupIndex)).attr('style', 'width: 100%; max-width: 100%;');
        var resolvingInitialSupplier = !!group.supplierId;
        supplierElement.kendoMultiColumnComboBox({
            placeholder: 'Select Supplier', dataTextField: 'Name', dataValueField: 'Id', valuePrimitive: true,
            filter: 'contains', minLength: 1, autoBind: true,
            columns: [{ field: 'Name', title: 'Name', width: 210 }, { field: 'BusinessName', title: 'Business Name', width: 210 }, { field: 'Address', title: 'Address', width: 330 }, { field: 'TIN', title: 'TIN', width: 130 }],
            dataSource: step4RemoteDataSource('@Url.Action("GetSupplier", "Getters")', function () {
                var widget = supplierElement.data('kendoMultiColumnComboBox');
                return { text: resolvingInitialSupplier ? String(group.supplierId) : (widget ? (widget.text() || '') : '') };
            }),
            dataBound: function () {
                if (!group.supplierId) return;
                var supplierId = String(group.supplierId).toLowerCase();
                var match = null;
                $.each(this.dataSource.view(), function (_, supplier) {
                    if (String(supplier.Id).toLowerCase() === supplierId) { match = supplier; return false; }
                });
                if (match) {
                    this.value(match.Id);
                    this.text(match.Name || group.supplierName || '');
                    this.input.val(match.Name || group.supplierName || '');
                } else if (group.supplierName) {
                    this.text(group.supplierName);
                    this.input.val(group.supplierName);
                }
                resolvingInitialSupplier = false;
            },
            select: function (e) { setStep4Supplier(groupIndex, e.dataItem); },
            change: function () { if (!this.value()) setStep4Supplier(groupIndex, null); }
        });
        var supplierCombo = supplierElement.data('kendoMultiColumnComboBox');
        fitStep4KendoWidget(supplierCombo);
        supplierCombo.value(group.supplierId || '');
        if (group.supplierName) { supplierCombo.text(group.supplierName); supplierCombo.input.val(group.supplierName); }

        initializeStep4DatePicker('PoDate', groupIndex, group.poDate || new Date(), 'poDate');
        initializeStep4TextBox('SupAddress', groupIndex, group.supAddress, 'supAddress');
        initializeStep4TextBox('SupTIN', groupIndex, group.supTIN, 'supTIN');
        initializeStep4TextBox('PlaceOfDelivery', groupIndex, group.placeOfDelivery, 'placeOfDelivery');
        initializeStep4TextBox('DeliveryDate', groupIndex, group.deliveryDate || group.deliveryPeriodDays, 'deliveryDate');
        initializeStep4CodeCombo('DeliveryTerm', groupIndex, 'DELI-TERM', 'Select Delivery Term', group.termDelivery, 'termDelivery');
        initializeStep4CodeCombo('PaymentTerms', groupIndex, 'PAY-TERM', 'Select Payment Term', group.paymentTerms, 'paymentTerms');
        initializeStep4TextBox('SignedBySuppName', groupIndex, group.signedBySuppName, 'signedBySuppName');
        initializeStep4DatePicker('SignedBySuppDate', groupIndex, group.signedBySuppDate, 'signedBySuppDate');
        initializeStep4TextBox('SignedByAuthName', groupIndex, group.signedByAuthName, 'signedByAuthName');
        initializeStep4TextBox('SignedByAuthDesignation', groupIndex, group.signedByAuthDesignation, 'signedByAuthDesignation');
        initializeStep4TextBox('ResoNo', groupIndex, group.resoNo, 'resoNo');
        initializeStep4TextBox('CertifiedCorrectBy', groupIndex, group.certifiedCorrectBy, 'certifiedCorrectBy');
        initializeStep4DatePicker('CertifiedCorrectDate', groupIndex, group.certifiedCorrectDate, 'certifiedCorrectDate');
    }

    function initializeStep4TextBox(name, groupIndex, value, field) {
        var element = $('#' + step4FieldId(name, groupIndex));
        element.kendoTextBox({ value: value || '', change: function () { setStep4GroupField(groupIndex, field, this.value()); } });
        var widget = element.data('kendoTextBox');
        fitStep4KendoWidget(widget);
    }

    function fitStep4KendoWidget(widget) {
        if (!widget || !widget.wrapper || !widget.wrapper.length) return;
        var wrapper = widget.wrapper;
        wrapper.closest('.form-field').css({ minWidth: 0, maxWidth: '100%', overflow: 'hidden' });
        wrapper[0].style.setProperty('display', 'flex', 'important');
        wrapper[0].style.setProperty('width', '100%', 'important');
        wrapper[0].style.setProperty('max-width', '100%', 'important');
        wrapper[0].style.setProperty('min-width', '0', 'important');
        wrapper[0].style.setProperty('box-sizing', 'border-box', 'important');
        wrapper.find('.k-dropdown-wrap, .k-picker-wrap, .k-input-wrap').each(function () {
            this.style.setProperty('display', 'flex', 'important');
            this.style.setProperty('width', '100%', 'important');
            this.style.setProperty('max-width', '100%', 'important');
            this.style.setProperty('min-width', '0', 'important');
            this.style.setProperty('box-sizing', 'border-box', 'important');
        });
        wrapper.find('input.k-input, .k-input-inner').each(function () {
            this.style.setProperty('flex', '1 1 0', 'important');
            this.style.setProperty('width', '0', 'important');
            this.style.setProperty('min-width', '0', 'important');
            this.style.setProperty('max-width', '100%', 'important');
            this.style.setProperty('box-sizing', 'border-box', 'important');
        });
        wrapper.find('.k-select, .k-input-button').each(function () {
            this.style.setProperty('flex', '0 0 auto', 'important');
        });
    }

    function step4RemoteDataSource(url, requestData) {
        return {
            serverFiltering: true,
            transport: { read: { url: url, dataType: 'json', data: requestData } }
        };
    }

    function step4CodeLookupData(element, mastCode) {
        return function () {
            var widget = element.data('kendoMultiColumnComboBox');
            return {
                mastCode: mastCode,
                addAll: false,
                text: widget ? (widget.text() || '') : ''
            };
        };
    }

    function initializeStep4CodeCombo(name, groupIndex, mastCode, placeholder, value, field) {
        var element = $('#' + step4FieldId(name, groupIndex));
        element.kendoMultiColumnComboBox({
            placeholder: placeholder, dataTextField: 'Description', dataValueField: 'Description', valuePrimitive: true, filter: 'contains',
            columns: [{ field: 'Description', title: placeholder.replace('Select ', ''), width: 300 }],
            dataSource: step4RemoteDataSource('@Url.Action("GetCodeList", "Getters")', step4CodeLookupData(element, mastCode)),
            value: value || '', change: function () { setStep4GroupField(groupIndex, field, this.value()); }
        });
        fitStep4KendoWidget(element.data('kendoMultiColumnComboBox'));
    }

    function initializeStep4DatePicker(name, groupIndex, value, field) {
        $('#' + step4FieldId(name, groupIndex)).kendoDatePicker({ format: 'MM/dd/yyyy', value: value ? new Date(value) : null,
            change: function () { setStep4GroupField(groupIndex, field, this.value()); }
        });
        fitStep4KendoWidget($('#' + step4FieldId(name, groupIndex)).data('kendoDatePicker'));
    }

    function setStep4GroupField(groupIndex, field, value) {
        if (!poGroups[groupIndex]) return;
        poGroups[groupIndex][field] = value;
        scheduleWizardAutoSave();
        refreshStep4Readiness();
    }

    function setStep4Department(groupIndex, dept) {
        var group = poGroups[groupIndex];
        if (!group) return;
        group.deptId = dept && dept.Id ? dept.Id : null;
        group.department = dept && dept.Description ? dept.Description : (dept && dept.name ? dept.name : "");
        var hiddenDept = $('#' + step4FieldId('Department', groupIndex));
        if (hiddenDept.length) hiddenDept.val(group.department);
        refreshStep4Readiness();
        if (typeof scheduleWizardAutoSave === "function") scheduleWizardAutoSave();
    }

    function setStep4Supplier(groupIndex, supplier) {
        var group = poGroups[groupIndex];
        if (!group) return;
        group.supplierId = supplier ? supplier.Id : null;
        group.supplierName = supplier ? (supplier.Name || '') : '';
        group.supBusiness = supplier ? (supplier.BusinessName || '') : '';
        group.supAddress = supplier ? (supplier.Address || '') : '';
        group.supTIN = supplier ? (supplier.TIN || '') : '';
        group.supZipCode = supplier ? (supplier.ZipCode || '') : '';
        group.supEmail = supplier ? (supplier.Email || '') : '';
        group.supContactNo = supplier ? (supplier.ContactNos || '') : '';
        scheduleWizardAutoSave();
        renderStep4Review();
    }

    function buildStep4ItemsTable(group) {
        var wrapper = $('<div class="step4-table-wrap"></div>');
        var table = $('<table class="items-table"><thead><tr><th>#</th><th>Description</th><th>Article</th><th>Unit</th><th>Qty</th><th>Unit Cost</th><th>Total</th></tr></thead><tbody></tbody></table>');
        var tbody = table.find("tbody");
        $.each(group.items || [], function (index, item) {
            var row = $("<tr></tr>");
            $("<td></td>").text(index + 1).appendTo(row);
            var description = $("<td></td>");
            $("<strong></strong>").text(item.description || "").appendTo(description);
            if (item.technicalDescription) $("<small></small>").text(item.technicalDescription).appendTo(description);
            row.append(description);
            $("<td></td>").text(item.article || item.gsoCategory || "").appendTo(row);
            $("<td></td>").text(item.unit || "").appendTo(row);
            $("<td class='text-end'></td>").text(item.qty || 0).appendTo(row);
            $("<td class='text-end'></td>").text(formatStep4GridAmount(item.unitCost)).appendTo(row);
            $("<td class='text-end'></td>").text(formatStep4GridAmount(Number(item.qty || 0) * Number(item.unitCost || 0))).appendTo(row);
            tbody.append(row);
            var subItems = item.setLotItems || item.SetLotItems || [];
            if (subItems.length) {
                var subItemRow = $('<tr class="step4-subitems-row"></tr>');
                var subItemCell = $('<td colspan="7"></td>');
                var subItemTable = $('<table class="step4-subitems-table"><thead><tr><th>Sub-item No.</th><th>Description</th><th>Unit</th><th>Qty</th><th>Unit Cost</th><th>Total</th></tr></thead><tbody></tbody></table>');
                var subItemBody = subItemTable.find('tbody');
                $.each(subItems, function (subIndex, subItem) {
                    var itemNo = subItem.itemNo || subItem.ItemNo || (subIndex + 1);
                    var description = subItem.description || subItem.Description || subItem.itemName || subItem.ItemName || '';
                    var unit = subItem.unit || subItem.Unit || '';
                    var quantity = Number(subItem.qty != null ? subItem.qty : (subItem.Qty || 0));
                    var unitCost = Number(subItem.unitCost != null ? subItem.unitCost : (subItem.UnitCost != null ? subItem.UnitCost : (subItem.estimatedCost != null ? subItem.estimatedCost : (subItem.EstimatedCost || 0))));
                    var subRow = $('<tr></tr>');
                    $('<td></td>').text(itemNo).appendTo(subRow);
                    $('<td></td>').text(description).appendTo(subRow);
                    $('<td></td>').text(unit).appendTo(subRow);
                    $('<td class="text-end"></td>').text(quantity).appendTo(subRow);
                    $('<td class="text-end"></td>').text(formatStep4GridAmount(unitCost)).appendTo(subRow);
                    $('<td class="text-end"></td>').text(formatStep4GridAmount(quantity * unitCost)).appendTo(subRow);
                    subItemBody.append(subRow);
                });
                subItemCell.append($('<div class="step4-subitems-title"></div>').text('Sub-items for item ' + (item.itemNo || (index + 1))), subItemTable);
                subItemRow.append(subItemCell);
                tbody.append(subItemRow);
            }
        });
        wrapper.append(table);
        return wrapper;
    }

    function buildStep4DocumentPanel(group, groupIndex) {
        var panel = $('<div class="step4-documents"></div>');
        var poCopy = $('<div class="step4-document-card"></div>').append("<h3>Signed PO Copy <span>Required to post</span></h3>");
        poCopy.append(buildStep4DocumentList(group.poCopyDoc ? [group.poCopyDoc] : [], "No signed PO copy uploaded."));
        poCopy.append($('<input type="file" />').attr('id', step4FieldId('POCopyUpload', groupIndex)));

        var supporting = $('<div class="step4-document-card"></div>').append("<h3>Supporting Documents <span>Optional</span></h3>");
        supporting.append(buildStep4DocumentList(group.additionalDocs || [], "No supporting documents uploaded."));
        supporting.append($('<input type="file" multiple="multiple" />').attr('id', step4FieldId('SupportingUpload', groupIndex)));

        var preview = $('<div class="step4-document-card"></div>').append("<h3>Draft Preview <span>Crystal PDF</span></h3>");
        preview.append($('<button type="button" class="btn-procurement-secondary"><span class="k-icon k-i-print"></span> Preview / Print Purchase Order</button>').on("click", function () { printWizardPO(group.groupId); }));
        panel.append(poCopy, supporting, preview);
        return panel;
    }

    function buildStep4DocumentList(documents, emptyText) {
        var list = $('<div class="step4-uploaded-documents"></div>');
        if (!documents.length) return list.append($('<p></p>').text(emptyText));
        $.each(documents, function (_, doc) {
            var row = $('<div class="step4-uploaded-document" style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px"></div>');
            $('<span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>').text(doc.FileName || 'Uploaded document').appendTo(row);
            $('<button type="button">Preview</button>').kendoButton({ icon: 'eye' }).on('click', function () { openStep4DocumentPreview(doc); }).appendTo(row);
            list.append(row);
        });
        return list;
    }

    function initializeStep4DocumentUploads(group, groupIndex) {
        initializeStep4Upload('POCopyUpload', group, groupIndex, true,
            ['.pdf', '.jpg', '.jpeg', '.png'], '@Url.Action("UploadPOCopy", "PurchaseOrders")');
        initializeStep4Upload('SupportingUpload', group, groupIndex, false,
            ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.jpg', '.jpeg', '.png'], '@Url.Action("UploadAdditionalDoc", "PurchaseOrders")');
    }

    function initializeStep4Upload(name, group, groupIndex, isPOCopy, extensions, saveUrl) {
        $('#' + step4FieldId(name, groupIndex)).kendoUpload({
            multiple: !isPOCopy,
            showFileList: true,
            validation: { allowedExtensions: extensions },
            async: { saveUrl: saveUrl, saveField: 'file', autoUpload: true, batch: false },
            upload: function (e) {
                e.data = { __RequestVerificationToken: getAntiForgeryToken(), groupId: group.groupId, orderId: typeof existingOrderId !== "undefined" ? existingOrderId : null };
            },
            success: function (e) {
                if (e.operation !== 'upload') return;
                var response = e.response || {};
                if (!response.success || !response.document) {
                    showWizardMessage(response.message || 'Upload failed.');
                    return;
                }
                if (isPOCopy) group.poCopyDoc = response.document;
                else {
                    group.additionalDocs = group.additionalDocs || [];
                    group.additionalDocs.push(response.document);
                }
                scheduleWizardAutoSave();
                setTimeout(renderStep4Review, 0);
            },
            error: function () { showWizardMessage('The document could not be uploaded.'); }
        });
    }

    function openStep4DocumentPreview(doc) {
        if (!doc || (!doc.FilePath && !doc.PreviewUrl)) return;
        var fileName = doc.FileName || 'Document';
        var extension = fileName.split('.').pop().toLowerCase();
        var previewUrl = doc.PreviewUrl || '@Url.Action("PreviewDocument", "PurchaseOrders")' + '?path=' + encodeURIComponent(doc.FilePath);
        var downloadUrl = doc.PreviewUrl || '@Url.Action("DownloadDocument", "PurchaseOrders")' + '?path=' + encodeURIComponent(doc.FilePath) + '&name=' + encodeURIComponent(fileName);
        var content = $('#step4PreviewContent').empty();
        if (extension === 'pdf') {
            $('<iframe title="Document preview" style="width:100%;height:560px;border:0"></iframe>').attr('src', previewUrl).appendTo(content);
        } else if (extension === 'jpg' || extension === 'jpeg' || extension === 'png') {
            $('<img alt="Document preview" style="display:block;max-width:100%;max-height:560px;margin:auto" />').attr('src', previewUrl).appendTo(content);
        } else {
            content.append($('<div class="wizard-empty-state"></div>').text('This file type cannot be previewed in the browser. Download it to review the document.'));
        }
        $('<a class="btn-procurement-secondary" style="display:inline-block;margin-top:12px">Download</a>').attr('href', downloadUrl).appendTo(content);
        var windowWidget = $('#step4PreviewWindow').data('kendoWindow');
        if (windowWidget) windowWidget.title(fileName).center().open();
    }

    function refreshStep4Readiness() {
        var groupsValid = validateStep3Groups() && validateStep4PoDetails();
        var docsValid = poGroups && poGroups.every(function (group) { return !!group.poCopyDoc; });
        var certified = $("#chkStep4Certification").is(":checked");
        var ready = groupsValid && docsValid && certified;
        $("#btnPostPurchaseOrders").prop("disabled", !ready);
        $("#step4ReadinessBadge").toggleClass("is-ready", ready).toggleClass("is-pending", !ready);
        $("#step4ValidationSummary").text(ready ? "All groups validated" : (!groupsValid ? "PO details incomplete" : (!docsValid ? "Signed PO copy required" : "Certification required")));
    }

    function validateStep4PoDetails() {
        return poGroups && poGroups.length > 0 && poGroups.every(function (group) {
            return $.trim(group.poNumber || "") !== "" && !!group.supplierId && !!group.deptId &&
                !!group.poDate &&
                $.trim(group.placeOfDelivery || "") !== "" &&
                $.trim(group.termDelivery || "") !== "" &&
                $.trim(group.paymentTerms || "") !== "" &&
                $.trim(group.modeOfProcurement || "") !== "";
        });
    }

    function openStep4Preview(groupIndex) {
        var group = poGroups[groupIndex];
        if (!group) return;
        var content = $("#step4PreviewContent").empty();
        $("<h2>Purchase Order Draft</h2>").appendTo(content);
        $("<p></p>").text((group.groupName || "") + " — " + (group.supplierName || "Supplier not selected")).appendTo(content);
        content.append(buildStep4ItemsTable(group));
        var windowWidget = $("#step4PreviewWindow").data("kendoWindow");
        if (windowWidget) windowWidget.center().open();
    }

    function printWizardPO(groupId) {
        var payload = buildPOPayload();
        if (groupId) {
            payload = payload.filter(function (group) { return group.GroupId === groupId; });
        }
        if (!payload || payload.length === 0) {
            showWizardMessage("There is no Purchase Order data to print.");
            return;
        }

        var printWindow = window.open("", "_blank");
        if (printWindow) {
            printWindow.document.title = "Generating Purchase Order";
            printWindow.document.body.innerHTML =
                "<p style='font-family:Arial,sans-serif;padding:24px'>Generating Purchase Order preview...</p>";
        }

        var request = new XMLHttpRequest();
        request.open("POST", '@Url.Action("PrintWizardPO", "PurchaseOrders")', true);
        request.responseType = "blob";
        request.timeout = 120000;
        request.setRequestHeader("Content-Type", "application/json; charset=utf-8");

        request.onload = function () {
            var contentType = request.getResponseHeader("Content-Type") || "";
            if (request.status < 200 || request.status >= 300) {
                showPrintError("Unable to generate the Purchase Order (HTTP " + request.status + ").");
                return;
            }
            if (contentType.toLowerCase().indexOf("application/pdf") < 0) {
                showPrintError("The server did not return a PDF preview.");
                return;
            }

            var pdfBlob = request.response instanceof Blob
                ? request.response
                : new Blob([request.response], { type: "application/pdf" });
            var pdfUrl = window.URL.createObjectURL(pdfBlob);
            if (printWindow && !printWindow.closed) printWindow.location.replace(pdfUrl);
            else window.open(pdfUrl, "_blank");
            window.setTimeout(function () { window.URL.revokeObjectURL(pdfUrl); }, 60000);
        };

        request.onerror = function () {
            showPrintError("A network error occurred while generating the Purchase Order.");
        };
        request.ontimeout = function () {
            showPrintError("Generating the Purchase Order timed out.");
        };
        request.onabort = function () {
            showPrintError("Generating the Purchase Order was cancelled.");
        };

        function showPrintError(message) {
            console.error("Wizard PO print failed:", message);
            if (printWindow && !printWindow.closed) {
                printWindow.document.body.innerHTML =
                    "<p style='font-family:Arial,sans-serif;padding:24px;color:#b91c1c'>" +
                    $("<div>").text(message).html() + "</p>";
            }
            showWizardMessage(message);
        }

        try {
            request.send(JSON.stringify({ poGroups: payload }));
        } catch (error) {
            showPrintError(error && error.message
                ? error.message
                : "Unable to start the Purchase Order preview request.");
        }
    }

    function buildPOPayload() {
        if (typeof syncPOGroupSourcePRs === "function") syncPOGroupSourcePRs();
        return poGroups.map(function (group) {
            var sourcePRs = group.sourcePRs || [];
            return {
                ExistingOrderId: typeof existingOrderId !== "undefined" ? existingOrderId : null,
                GroupId: group.groupId,
                GroupName: group.groupName,
                PONumber: group.poNumber,
                PRNumber: group.PRNumber || "",
                DeptId: group.deptId || null,
                Department: group.department || "",
                DepartmentName: group.department || group.DepartmentName || "",
                SourcePRs: sourcePRs.map(function (source) {
                    return { PRId: source.PRId, PRNumber: source.PRNumber, DepartmentId: source.DepartmentId || null, DepartmentName: source.DepartmentName || "" };
                }),
                SupplierId: group.supplierId || null,
                SupplierName: group.supplierName,
                CtrlNo: group.ctrlNo,
                SupBusiness: group.supBusiness,
                SupAddress: group.supAddress,
                SupTIN: group.supTIN,
                SupEmail: group.supEmail,
                SupZipCode: group.supZipCode,
                SupContactNo: group.supContactNo,
                PODate: group.poDate || new Date(),
                DeliveryPeriodDays: String(group.deliveryPeriodDays || ""),
                DeliveryDate: group.deliveryDate,
                PlaceOfDelivery: group.placeOfDelivery,
                TermDelivery: group.termDelivery,
                PaymentTerms: group.paymentTerms,
                ModeOfProcurement: group.modeOfProcurement,
                SignedBySuppName: group.signedBySuppName,
                SignedBySuppDate: group.signedBySuppDate,
                SignedByAuthName: group.signedByAuthName,
                SignedByAuthDesignation: group.signedByAuthDesignation,
                ResoNo: group.resoNo,
                CertifiedCorrectBy: group.certifiedCorrectBy,
                CertifiedCorrectDate: group.certifiedCorrectDate,
                Items: (group.items || []).map(function (item, index) {
                    return {
                        Id: item.id,
                        ItemNo: String(item.itemNo || (index + 1)),
                        ItemCode: item.PPMPCode || item.itemCode,
                        StockNo: item.stockNo,
                        Description: item.description,
                        ItemCodeId: item.itemCodeId || null,
                        Quantity: Number(item.qty || 0),
                        PpmpCode: item.PPMPCode || item.ppmpCode,
                        Category: item.category,
                        Account: item.account,
                        SubAccount: item.subAccount,
                        Unit: item.unit,
                        UnitCost: Number(item.unitCost || 0),
                        GSOCategory: item.gsoCategory,
                        TechnicalDescription: item.technicalDescription,
                        AdditionalSpecs: item.additionalSpecs || {},
                        AllFields: item.allFields || item.additionalSpecs || {},
                        SetLotItems: item.setLotItems || [],
                        Allocations: (item.sourcePRs || []).map(function (source) {
                            return { PRId: source.prId || null, RequestItemId: source.requestItemId, PRNumber: source.prNo, Quantity: Number(source.allocatedQty || 0) };
                        })
                    };
                }),
                POCopyDoc: group.poCopyDoc,
                AdditionalDocs: group.additionalDocs || []
            };
        });
    }

    function submitPOs(isDraft) {
        if(typeof existingOrderId !== "undefined" && existingOrderId){saveExistingPurchaseOrder(!isDraft);return;}        
        if (isDraft) { saveWizardDraft(true); return; }
        if (!isDraft && !$("#chkStep4Certification").is(":checked")) { showWizardMessage("Confirm the compliance certification before posting."); return; }
        if (!isDraft && $("#btnPostPurchaseOrders").prop("disabled")) { showWizardMessage("Complete all required PO details and signed PO uploads before posting."); return; }
        var buttons = $("#btnStep4SaveDraft, #btnPostPurchaseOrders").prop("disabled", true);
        kendo.ui.progress($(".step4-review-container"), true);
        $.ajax({
            url: "@Url.Action("PostPOs", "PurchaseOrders")",
            type: "POST",
            data: { __RequestVerificationToken: getAntiForgeryToken(), draftId: wizardDraftId, poGroupsJson: JSON.stringify(buildPOPayload()) }
        }).done(function (response) {
            if (response.success) {
                wizardDraftDirty = false;
                window.location.href = response.redirectUrl || "@Url.Action("Index", "PurchaseOrders")";
            }
            else showWizardMessage(response.message || "Unable to process the Purchase Orders.");
        }).fail(function (xhr) {
            var response = xhr.responseJSON || {};
            showWizardMessage(response.message || "The server could not process the Purchase Orders.");
        })
          .always(function () { kendo.ui.progress($(".step4-review-container"), false); buttons.prop("disabled", false); refreshStep4Readiness(); });
    }
</script>

@*Wizard.cshtml*@
@model iLgs.Ai.Models.POWizardViewModel

@{
    ViewBag.Title = "Create Purchase Order";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="epsms-procurement po-wizard">

    <!-- ================================================================
         BREADCRUMBS
         ================================================================ -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@Url.Action("Index", "PurchaseOrders")">Purchase Orders</a>
        <span class="breadcrumb-separator">&gt;</span>
        <span>Create Purchase Order</span>
    </div>


    <!-- ================================================================
         PAGE HEADER
         ================================================================ -->
    <div class="wizard-header">
        <div class="wizard-header-content">
            <h1 class="page-title">Create Purchase Order</h1>

            <p class="page-subtitle">
                Create and consolidate Purchase Orders from approved Purchase Requests.
            </p>
        </div>

        <div class="wizard-header-actions">
            <span class="wizard-draft-status" aria-live="polite">
                <span class="wizard-draft-icon">
                    <span class="k-icon k-i-save"></span>
                </span>
                <span id="wizardDraftStatusText">Not yet saved</span>
            </span>

            <a href="@Url.Action("Index", "PurchaseOrders")"
               class="btn-procurement-secondary">
                <span class="k-icon k-i-close"></span>
                Cancel &amp; Exit
            </a>
        </div>
    </div>


    <!-- ================================================================
         STEPPER
         ================================================================ -->
    <div class="wizard-stepper-card">
        <div id="poStepper"></div>
    </div>


    <!-- ================================================================
         WIZARD CONTENT
         ================================================================ -->
    <div class="wizard-content">

        @using (Html.BeginForm(
                "Create",
                "PurchaseOrders",
                FormMethod.Post,
                new { id = "poWizardForm" }))
        {
            @Html.AntiForgeryToken()

            <div id="wizardValidationSummary"
                 class="validation-summary-errors"
                 style="display:none;">
            </div>

            <!-- ========================================================
                 STEP 1
                 ======================================================== -->
            <div id="wizardStepPane1"
                 class="wizard-pane">

                @Html.Partial("_Step1_SelectPRs")

            </div>


            <!-- ========================================================
                 STEP 2
                 ======================================================== -->
            <div id="wizardStepPane2"
                 class="wizard-pane"
                 style="display:none;">

                @Html.Partial("_Step2_AssignGroups")

            </div>


            <!-- ========================================================
                 STEP 3
                 ======================================================== -->
            <div id="wizardStepPane3"
                 class="wizard-pane"
                 style="display:none;">

                @Html.Partial("_Step3_PODetails")

            </div>


            <!-- ========================================================
                 STEP 4
                 ======================================================== -->
            <div id="wizardStepPane4"
                 class="wizard-pane"
                 style="display:none;">

                @Html.Partial("_Step4_ReviewPost")

            </div>
        }
    </div>

</div>


<!-- ================================================================
     PO DETAILS MODAL
     ================================================================ -->

<div id="poDetailsModal"
     class="modal fade"
     tabindex="-1"
     role="dialog"
     aria-hidden="true">
</div>


@section scripts {

    <script type="text/javascript">

        var currentWizardStep = @Convert.ToInt32(ViewBag.CurrentStep ?? 1);
        var wizardDraftId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DraftId));
        var initialWizardStateJson = @Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewBag.WizardStateJson), true));
        var wizardAutoSaveTimer = null;
        var wizardDraftReady = false;
        var wizardDraftDirty = false;
        var wizardDraftVersion = 0;
        var wizardDraftSaveRequest = null;
        var wizardDraftSaveQueued = false;

        /*
         * These objects are shared by all wizard partials.
         */
        var selectedPRIds = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SelectedPrIds ?? new List<Guid>()));
        var allocatedItems = [];
        var poGroups = [
            {
                groupId: "grp-1",
                groupName: "PO Group 1",
                poNumber: "",
                supplierId: "",
                supplierName: "",
                ctrlNo: "",
                supBusiness: "",
                supAddress: "",
                supTIN: "",
                supEmail: "",
                supZipCode: "",
                supContactNo: "",
                poDate: new Date(),
                deliveryPeriodDays: 30,
                deliveryDate: "",
                placeOfDelivery: "General Services Office (GSO) Warehouse",
                termDelivery: "",
                paymentTerms: "30 Calendar Days upon full acceptance",
                modeOfProcurement: "Public Bidding",
                signedBySuppName: "",
                signedBySuppDate: null,
                signedByAuthName: "",
                signedByAuthDesignation: "",
                resoNo: "",
                certifiedCorrectBy: "",
                certifiedCorrectDate: null,
                items: [],
                poCopyDoc: null,
                additionalDocs: []
            }
        ];


        /* ============================================================
           WIZARD INITIALIZATION
           ============================================================ */

        $(document).ready(function () {
            restoreWizardDraft();

            $("#poStepper").kendoStepper({
                linear: true,

                steps: [
                    {
                        label: "Select PRs",
                        icon: "check"
                    },
                    {
                        label: "Assign Groups",
                        icon: "group"
                    },
                    {
                        label: "PO Details",
                        icon: "file-txt"
                    },
                    {
                        label: "Review & Post",
                        icon: "check-circle"
                    }
                ]
            });

            if (allocatedItems.length && typeof renderStep2Allocations === "function") renderStep2Allocations();
            goToWizardStep(currentWizardStep);
            wizardDraftReady = true;
            $("#poWizardForm").on("input change", "input, select, textarea", function () {
                scheduleWizardAutoSave();
            });
        });


        /* ============================================================
           WIZARD NAVIGATION
           ============================================================ */

        function goToWizardStep(step) {

            if (step < 1 || step > 4) {
                return;
            }

            /*
             * Step 1 validation.
             */
            if (step > 1 && selectedPRIds.length === 0) {

                showWizardMessage(
                    "Please select at least one approved Purchase Request before continuing."
                );

                return;
            }

            if (step > 2 && !validateStep2Allocations()) {
                showWizardMessage("Allocate the full requested quantity of every PR item before continuing.");
                step = 2;
            }

            if (step > 3) {
                if (!validateStep3Groups()) {
                    showWizardMessage("Complete all required line-item information for every PO group before continuing.");
                    step = 3;
                }
            }


            currentWizardStep = step;
            if (wizardDraftReady) scheduleWizardAutoSave();


            /*
             * Hide all panes.
             */
            $(".wizard-pane").hide();


            /*
             * Show requested pane.
             */
            $("#wizardStepPane" + step)
                .fadeIn(150);


            /*
             * Update Kendo Stepper.
             */
            var stepper = $("#poStepper").data("kendoStepper");

            if (stepper) {
                stepper.select(step - 1);
            }


            /*
             * Update page state.
             */
            updateWizardState(step);
            if (step === 2) window.setTimeout(activateStep2FromWizardState, 160);
            if (step === 3 && typeof prepareStep3Data === "function") prepareStep3Data();
            if (step === 4 && typeof renderStep4Review === "function") renderStep4Review();
        }

        function activateStep2FromWizardState() {
            if (allocatedItems && allocatedItems.length > 0) {
                renderAndResizeStep2();
                return;
            }

            if (!selectedPRIds || selectedPRIds.length === 0) {
                renderAndResizeStep2();
                return;
            }

            $.ajax({
                url: "@Url.Action("GetSelectedPRLineItems", "PurchaseOrders")",
                type: "POST",
                traditional: true,
                data: {
                    __RequestVerificationToken: getAntiForgeryToken(),
                    prIds: selectedPRIds
                }
            }).done(function (response) {
                if (!response || !response.success) {
                    showWizardMessage(response && response.message ? response.message : "PR line items could not be restored.");
                    return;
                }

                allocatedItems = response.items || [];
                restoreStep2AssignmentsFromGroups();
                renderAndResizeStep2();
                scheduleWizardAutoSave();
            }).fail(function () {
                showWizardMessage("PR line items could not be restored.");
            });
        }

        function restoreStep2AssignmentsFromGroups() {
            var assignmentByItemId = {};
            $.each(poGroups || [], function (_, group) {
                $.each(group.items || [], function (_, item) {
                    $.each(item.sourcePRs || [], function (_, source) {
                        if (!source.requestItemId) return;
                        assignmentByItemId[String(source.requestItemId).toLowerCase()] = {
                            groupId: group.groupId,
                            assignedQty: Number(source.allocatedQty || 0)
                        };
                    });
                });
            });

            $.each(allocatedItems || [], function (_, item) {
                var assignment = assignmentByItemId[String(item.Id || "").toLowerCase()];
                if (!assignment) return;
                item.TargetGroupId = assignment.groupId;
                item.AssignedQty = assignment.assignedQty;
                item.RemainingQty = Math.max(0, Number(item.RequestedQty || 0) - assignment.assignedQty);
            });
        }

        function renderAndResizeStep2() {
            if (typeof renderStep2Allocations === "function") renderStep2Allocations();
            var grid = $("#Step2AllocationsGrid").data("kendoGrid");
            if (grid) {
                grid.dataSource.data(allocatedItems || []);
                grid.refresh();
                grid.resize();
            }
        }

        function validateStep2Allocations() {
            return allocatedItems && allocatedItems.length > 0 && allocatedItems.every(function (item) {
                return item.TargetGroupId && Number(item.AssignedQty) > 0 && Number(item.RemainingQty) === 0;
            });
        }

        function validateStep3Groups() {
            return poGroups && poGroups.length > 0 && poGroups.every(function (group) {
                return group.items && group.items.length > 0 &&
                    group.items.every(function (item) {
                        return typeof isStep3ItemComplete === "function"
                            ? isStep3ItemComplete(item)
                            : !!item;
                    });
            });
        }


        function updateWizardState(step) {

            var titles = {
                1: "Select approved Purchase Requests.",
                2: "Assign PR items to Purchase Order Groups.",
                3: "Complete the Purchase Order line-item details.",
                4: "Complete PO details, review documents, and post Purchase Orders."
            };

            $("#wizardStepDescription").text(
                titles[step] || ""
            );
        }


        function wizardNext() {

            if (currentWizardStep < 4) {
                goToWizardStep(currentWizardStep + 1);
            }
        }


        function wizardBack() {

            if (currentWizardStep > 1) {
                goToWizardStep(currentWizardStep - 1);
            }
        }


        function showWizardMessage(message) {

            $("#wizardValidationSummary").text(message).show().attr("role", "alert");
            if (window.kendo && kendo.alert) kendo.alert(message);
        }

        function getAntiForgeryToken() {
            return $("#poWizardForm input[name='__RequestVerificationToken']").val();
        }

        function restoreWizardDraft() {
            if (!initialWizardStateJson) return;
            try {
                var state = JSON.parse(initialWizardStateJson);
                selectedPRIds = (state.selectedPRIds || []).map(String);
                allocatedItems = state.allocatedItems || [];
                poGroups = state.poGroups && state.poGroups.length ? state.poGroups : poGroups;
                currentWizardStep = Math.max(1, Math.min(4, Number(state.currentStep || currentWizardStep || 1)));
                $("#wizardDraftStatusText").text("Draft restored");
            } catch (e) {
                currentWizardStep = 1;
                $("#wizardDraftStatusText").text("Draft could not be restored");
            }
        }

        function buildWizardDraftState() {
            return {
                version: 1,
                currentStep: currentWizardStep,
                selectedPRIds: selectedPRIds.map(String),
                allocatedItems: allocatedItems || [],
                poGroups: poGroups || []
            };
        }

        function scheduleWizardAutoSave() {
            if (!wizardDraftReady || !selectedPRIds || selectedPRIds.length === 0) return;
            wizardDraftDirty = true;
            wizardDraftVersion++;
            $("#wizardDraftStatusText").text("Unsaved changes");
            window.clearTimeout(wizardAutoSaveTimer);
            wizardAutoSaveTimer = window.setTimeout(function () { saveWizardDraft(false); }, 1200);
        }

        function saveWizardDraft(showConfirmation) {
            if (!selectedPRIds || selectedPRIds.length === 0) {
                if (showConfirmation) showWizardMessage("Select at least one Purchase Request before saving.");
                return $.Deferred().reject().promise();
            }
            if (wizardDraftSaveRequest) {
                wizardDraftSaveQueued = true;
                return wizardDraftSaveRequest;
            }
            window.clearTimeout(wizardAutoSaveTimer);
            $("#wizardDraftStatusText").text("Saving...");
            var savedVersion = wizardDraftVersion;
            var stateJson = JSON.stringify(buildWizardDraftState());
            wizardDraftSaveRequest = $.ajax({
                url: "@Url.Action("SavePODraft", "PurchaseOrders")",
                type: "POST",
                traditional: true,
                data: {
                    __RequestVerificationToken: getAntiForgeryToken(),
                    draftId: wizardDraftId,
                    wizardStateJson: stateJson,
                    prIds: selectedPRIds,
                    currentStep: currentWizardStep
                }
            }).done(function (response) {
                if (!response.success) {
                    $("#wizardDraftStatusText").text("Save failed");
                    if (showConfirmation) showWizardMessage(response.message || "The draft could not be saved.");
                    return;
                }
                wizardDraftId = response.draftId;
                wizardDraftDirty = wizardDraftVersion !== savedVersion;
                $("#wizardDraftStatusText").text("Saved at " + new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));
                if (window.history && history.replaceState && wizardDraftId) {
                    history.replaceState(null, document.title, "@Url.Action("Wizard", "PurchaseOrders")?draftId=" + encodeURIComponent(wizardDraftId));
                }
                if (showConfirmation && window.showNotification) showNotification("Wizard draft saved.", "success");
            }).fail(function () {
                $("#wizardDraftStatusText").text("Save failed — retry available");
                if (showConfirmation) showWizardMessage("The wizard draft could not be saved.");
            }).always(function () {
                wizardDraftSaveRequest = null;
                if (wizardDraftSaveQueued) {
                    wizardDraftSaveQueued = false;
                    saveWizardDraft(false);
                }
            });
            return wizardDraftSaveRequest;
        }

        $(window).on("beforeunload", function () {
            if (wizardDraftDirty) return "This wizard has unsaved changes.";
        });

        function escapeWizardHtml(value) {
            return $("<div/>").text(value == null ? "" : String(value)).html();
        }


        /*
         * Prevent accidental form submission from Enter.
         */
        $("#poWizardForm").on("keydown", function (e) {

            if (e.keyCode === 13 &&
                e.target.tagName.toLowerCase() !== "textarea") {

                e.preventDefault();
            }
        });

    </script>
}

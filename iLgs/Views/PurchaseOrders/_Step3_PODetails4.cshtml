@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="wizard-card">
    <!-- Step Header -->
    <div class="header-bar" style="margin-bottom: 16px;">
        <div>
            <h2 style="font-size: 18px; font-weight: 700; color: #002046; margin: 0 0 4px 0;">Step 3: Purchase Order Details</h2>
            <p class="subtitle" style="font-size: 12px; color: #64748B; margin: 0;">Review consolidated items and finalize PO header details per supplier group.</p>
        </div>
    </div>

    <!-- PO Group Tabs Navigation -->
    <div class="step3-group-tabs" id="step3GroupTabsNav">
        <!-- Dynamically rendered tabs with status badges -->
    </div>

    <!-- Main Split Form Layout (Reversed Layout: Left Column = 340px, Right Column = Flex 1) -->
    <div class="step3-split-layout form-grid" id="step3SplitLayoutContainer" style="display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 16px; align-items: start; width: 100%;">
        <!-- Left Column: Header Details & Delivery Terms Cards -->
        <div class="step3-left-col">
            <!-- Header Details Card -->
            <div class="step3-card group-card">
                <div class="group-title text-navy">
                    <span class="k-icon k-i-user" style="color: #115cb9;"></span>
                    Header Details
                </div>

                <div class="form-field-wide" style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                    <div class="form-field">
                        <label>PO No.</label>
                        <input type="text" disabled value="(Auto-generated on posting)" class="form-control-custom" style="background: #f1f5f9; font-family: monospace; color: #64748b;" />
                    </div>

                    <div class="form-field">
                        <label>
                            PO Date <span class="required-marker">*</span>
                        </label>
                        @(Html.Kendo().DatePicker()
                                .Name("Step3PODate")
                                .Value(DateTime.Now)
                                .Format("yyyy-MM-dd")
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3PODateChange(this.value)" })
                        )
                    </div>

                    <div class="form-field">
                        <label>
                            Supplier <span class="required-marker">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                                .Name("Step3SupplierDropdown")
                                .DataTextField("Name")
                                .DataValueField("Id")
                                .OptionLabel("-- Select PhilGEPS Supplier --")
                                .DataSource(source => source
                                    .Read(read => read.Action("GetSuppliersDropdown", "PurchaseOrders"))
                                )
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3SupplierChange(this.value)" })
                        )
                    </div>

                    <div class="form-field">
                        <label>Mode of Procurement</label>
                        @(Html.Kendo().DropDownList()
                                .Name("Step3ProcurementMode")
                                .BindTo(new[] { "Public Bidding", "Shopping (Sec 52.1b)", "Direct Contracting", "Small Value Procurement (Sec 53.9)" })
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3ProcurementModeChange(this.value)" })
                        )
                    </div>
                </div>
            </div>

            <!-- Delivery & Payment Terms Card -->
            <div class="step3-card group-card" style="margin-top: 16px;">
                <div class="group-title text-navy">
                    <span class="k-icon k-i-cart" style="color: #115cb9;"></span>
                    Delivery &amp; Payment Terms
                </div>

                <div class="form-field-wide" style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                    <div class="form-field">
                        <label>
                            Delivery Period (Calendar Days) <span class="required-marker">*</span>
                        </label>
                        @(Html.Kendo().NumericTextBox<int>()
                                .Name("Step3DeliveryPeriod")
                                .Min(1)
                                .Max(365)
                                .Format("n0")
                                .Decimals(0)
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3DeliveryPeriodChange(this.value)" })
                        )
                    </div>

                    <div class="form-field">
                        <label>
                            Place of Delivery <span class="required-marker">*</span>
                        </label>
                        <input type="text" id="txtStep3PlaceOfDelivery" class="form-control-custom" placeholder="e.g. Main Warehouse, Building A" onchange="onStep3PlaceOfDeliveryChange(this.value)" onkeyup="onStep3PlaceOfDeliveryChange(this.value)" />
                    </div>

                    <div class="form-field">
                        <label>
                            Payment Terms <span class="required-marker">*</span>
                        </label>
                        @(Html.Kendo().DropDownList()
                                .Name("Step3PaymentTerms")
                                .BindTo(new[] { "30 Days", "15 Days", "Cash on Delivery", "Progress Billing" })
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3PaymentTermsChange(this.value)" })
                        )
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Metric Banner & Consolidated Line Items Accordion -->
        <div class="step3-right-col">
            <!-- Metric Banner -->
            <div class="step3-metric-banner" style="display: flex; justify-content: space-between; align-items: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 20px;">
                    <div>
                        <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Assigned Supplier</span>
                        <span id="lblActiveGroupSupplierName" style="font-weight: 700; font-size: 12px; color: #002046;">Mega Office Supplies Inc.</span>
                    </div>
                    <div style="height: 32px; width: 1px; background-color: #cbd5e1;"></div>
                    <div>
                        <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Consolidated Items</span>
                        <span id="lblActiveGroupItemsCount" style="font-weight: 700; font-size: 12px; color: #002046;">0 Items</span>
                    </div>
                </div>

                <div style="text-align: right;">
                    <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Total Group Amount</span>
                    <span id="lblActiveGroupTotalAmount" style="font-family: monospace; font-weight: 700; font-size: 15px; color: #166534;">PHP 0.00</span>
                </div>
            </div>

            <!-- Consolidated Line Items Accordion Container -->
            <div id="step3ItemsAccordionContainer">
                <!-- Dynamically rendered line items -->
            </div>
        </div>
    </div>

    <!-- Source PR Allocation & Warehouse Mapping Modal Window -->
    @(Html.Kendo().Window()
        .Name("step3AllocationModalWindow")
        .Title("Source PR Allocation & Warehouse Mapping")
        .Width(660)
        .Modal(true)
        .Visible(false)
        .Actions(actions => actions.Close())
        .Content(@<text>
            <div style="padding: 16px; font-size: 12px;">
                <!-- Header Banner -->
                <div style="background: #002046; color: #fff; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="k-icon k-i-inherited" style="color: #659dfe; font-size: 18px;"></span>
                        <div>
                            <div style="font-weight: 700; font-size: 13px;">Source PR Allocation &amp; Warehouse Mapping</div>
                            <span id="modalAllocStockNo" style="font-family: monospace; font-size: 11px; color: #87A0CD;">STK-GEN-001</span>
                        </div>
                    </div>
                </div>

                <!-- Item Description Box -->
                <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; margin-bottom: 16px;">
                    <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Item Name</span>
                    <p id="modalAllocItemDesc" style="font-weight: 700; color: #002046; font-size: 13px; margin: 0;">Multipurpose Paper A4</p>
                </div>

                <!-- PR Source Breakdown Table -->
                <h4 style="font-size: 12px; font-weight: 700; color: #002046; margin: 0 0 8px 0;">PR Source Breakdown</h4>
                <table class="alloc-table" style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                    <thead>
                        <tr style="background-color: #f1f5f9; text-align: left; font-size: 11px; color: #475569;">
                            <th style="padding: 8px;">PR Number</th>
                            <th style="padding: 8px;">Requesting Department</th>
                            <th style="padding: 8px; text-align: right;">Allocated Qty</th>
                            <th style="padding: 8px; text-align: right;">Unit Price</th>
                            <th style="padding: 8px;">Target Stock Bin</th>
                        </tr>
                    </thead>
                    <tbody id="modalAllocTableBody">
                        <tr>
                            <td style="padding: 8px; font-family: monospace; color: #115cb9; font-weight: 600;">PR-2026-001</td>
                            <td style="padding: 8px;">IT Department (Workstation rollout)</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace; font-weight: 700;">15 Reams</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace;">PHP 250.00</td>
                            <td style="padding: 8px; font-family: monospace; color: #64748b;">BIN-GSO-A12</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; font-family: monospace; color: #115cb9; font-weight: 600;">PR-2026-005</td>
                            <td style="padding: 8px;">General Admin Services</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace; font-weight: 700;">10 Reams</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace;">PHP 250.00</td>
                            <td style="padding: 8px; font-family: monospace; color: #64748b;">BIN-GSO-A14</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="font-weight: bold; border-top: 1px solid #cbd5e1;">
                            <td colspan="2" style="padding: 8px; text-align: right; text-transform: uppercase; color: #475569;">Total Consolidated:</td>
                            <td id="modalAllocTotalQty" style="padding: 8px; text-align: right; font-family: monospace; color: #166534;">25 Reams</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Action Footer with Step 1 Themed Secondary Button -->
                <div style="display: flex; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                    @(Html.Kendo().Button()
                        .Name("btnCloseAllocModal")
                        .ThemeColor(ThemeColor.Secondary)
                        .Content("Done")
                        .HtmlAttributes(new { onclick = "closeStep3AllocationModal()", @class = "btn-secondary" })
                    )
                </div>
            </div>
        </text>)
    )

    <!-- Navigation Action Bar with Step 1 Themed Navy and Secondary Buttons -->
    <div class="wizard-summary-bar">
        <div class="wizard-action-group" style="width: 100%; justify-content: space-between;">
            @(Html.Kendo().Button()
                    .Name("btnStep3Back")
                    .FillMode(ButtonFillMode.Outline)
                    .Content("&larr; Back to Assign Items")
                    .HtmlAttributes(new { onclick = "goToWizardStep(2)", @class = "btn-procurement-secondary" })
            )
            @(Html.Kendo().Button()
                    .Name("btnStep3Next")
                    .ThemeColor(ThemeColor.Primary)
                    .Content("Next: Review & Post &rarr;")
                    .HtmlAttributes(new { onclick = "goToWizardStep(4)", @class = "btn-procurement-primary" })
            )
        </div>
    </div>
</div>

<script>
    var activeStep3GroupIndex = 0;
    var expandedStep3ItemId = null;

    var GSO_CATEGORIES_LIST = [
        'Office Supplies',
        'IT Equipment',
        'Janitorial Supplies',
        'Furniture & Fixtures',
        'Electrical Supplies',
        'Hardware & Construction',
        'Drugs / Medicine',
        'Vehicle Parts & Maintenance',
        'Food Supplies',
        'General Merchandise'
    ];

    // Format currency in PHP
    function formatStep3Currency(amount) {
        return "PHP " + Number(amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Called when stepping into Step 3
    function prepareStep3Data() {
        if (!poGroups) poGroups = [];

        poGroups.forEach(function (grp) {
            var groupItems = allocatedItems.filter(function (it) {
                return (it.TargetGroupId || "grp-1") === grp.groupId && (it.AssignedQty > 0);
            });

            grp.items = groupItems.map(function (it, idx) {
                return {
                    id: it.Id || ("li-" + (idx + 1)),
                    itemNo: idx + 1,
                    description: it.Description,
                    stockNo: it.StockNo || ("STK-00" + (idx + 1)),
                    itemCode: "ITM-00" + (idx + 1),
                    qty: it.AssignedQty || it.RequestedQty,
                    unit: it.Unit || "pc",
                    unitCost: it.UnitCost || 0,
                    totalCost: (it.AssignedQty || it.RequestedQty) * (it.UnitCost || 0),
                    gsoCategory: it.GSOCategory || "Office Supplies",
                    technicalDescription: it.TechnicalDescription || "Government standard specification compliant.",
                    attributes: it.Attributes || { Brand: "Generic", Origin: "Local" },
                    setLotItems: it.SetLotItems ? JSON.parse(JSON.stringify(it.SetLotItems)) : []
                };
            });
        });

        if (activeStep3GroupIndex >= poGroups.length) {
            activeStep3GroupIndex = 0;
        }

        renderStep3GroupTabs();
        loadActiveGroupForm();
    }

    // Render group tabs with real-time Complete vs Needs Info badges
    function renderStep3GroupTabs() {
        var tabsContainer = $("#step3GroupTabsNav");
        tabsContainer.empty();

        poGroups.forEach(function (grp, index) {
            var isActive = index === activeStep3GroupIndex;
            var isComplete = grp.placeOfDelivery && grp.placeOfDelivery.trim().length > 0 && grp.deliveryPeriodDays > 0;

            var badgeHtml = isComplete
                ? '<span class="tab-badge-complete" style="background: #dcfce7; color: #166534; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Complete</span>'
                : '<span class="tab-badge-incomplete" style="background: #fef3c7; color: #92400e; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Needs Info</span>';

            var activeClass = isActive ? ' active' : '';

            var tabBtn = $('<button type="button" class="step3-tab-btn' + activeClass + '" onclick="selectStep3Group(' + index + ')" style="padding: 8px 12px; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 6px 6px 0 0; cursor: pointer; margin-right: 4px;">' +
                '<span>' + grp.groupName + '</span> ' + badgeHtml +
                '</button>');

            tabsContainer.append(tabBtn);
        });
    }

    // Switch active group
    function selectStep3Group(index) {
        activeStep3GroupIndex = index;
        renderStep3GroupTabs();
        loadActiveGroupForm();
    }

    // Load active group into form inputs and render items
    function loadActiveGroupForm() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        if (!activeGroup) return;

        // Set DatePicker
        var dp = $("#Step3PODate").data("kendoDatePicker");
        if (dp) {
            dp.value(activeGroup.poDate ? new Date(activeGroup.poDate) : new Date());
        }

        // Set Supplier DropDownList
        var supplierDdl = $("#Step3SupplierDropdown").data("kendoDropDownList");
        if (supplierDdl) {
            supplierDdl.value(activeGroup.supplierId || 1);
        }

        // Set Procurement Mode DropDownList
        var procDdl = $("#Step3ProcurementMode").data("kendoDropDownList");
        if (procDdl) {
            procDdl.value(activeGroup.modeOfProcurement || "Public Bidding");
        }

        // Set Delivery Period NumericTextBox
        var ntb = $("#Step3DeliveryPeriod").data("kendoNumericTextBox");
        if (ntb) {
            ntb.value(activeGroup.deliveryPeriodDays || 30);
        }

        // Set Place of Delivery input
        $("#txtStep3PlaceOfDelivery").val(activeGroup.placeOfDelivery || "Main Warehouse, Building A");

        // Set Payment Terms DropDownList
        var ptDdl = $("#Step3PaymentTerms").data("kendoDropDownList");
        if (ptDdl) {
            ptDdl.value(activeGroup.paymentTerms || "30 Days");
        }

        // Update Metric Banner
        $("#lblActiveGroupSupplierName").text(activeGroup.supplierName || "Mega Office Supplies Inc.");
        $("#lblActiveGroupItemsCount").text((activeGroup.items ? activeGroup.items.length : 0) + " Items");

        var total = 0;
        if (activeGroup.items) {
            activeGroup.items.forEach(function (it) {
                total += (it.qty * it.unitCost);
            });
        }
        $("#lblActiveGroupTotalAmount").text(formatStep3Currency(total));

        // Render accordion items
        renderStep3AccordionItems();
    }

    // Header Details change handlers
    function onStep3PODateChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.poDate = val;
    }

    function onStep3SupplierChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp) return;
        var ddl = $("#Step3SupplierDropdown").data("kendoDropDownList");
        if (ddl) {
            grp.supplierId = val;
            grp.supplierName = ddl.text();
            $("#lblActiveGroupSupplierName").text(grp.supplierName);
        }
    }

    function onStep3ProcurementModeChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.modeOfProcurement = val;
    }

    function onStep3DeliveryPeriodChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) {
            grp.deliveryPeriodDays = parseInt(val, 10) || 30;
            renderStep3GroupTabs();
        }
    }

    function onStep3PlaceOfDeliveryChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) {
            grp.placeOfDelivery = val;
            renderStep3GroupTabs();
        }
    }

    function onStep3PaymentTermsChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.paymentTerms = val;
    }

    // Accordion interaction functions
    function toggleAccordionItem(itemId) {
        expandedStep3ItemId = (expandedStep3ItemId === itemId) ? null : itemId;
        renderStep3AccordionItems();
    }

    function openStep3AllocationModal(stockNo, description) {
        $("#modalAllocStockNo").text(stockNo);
        $("#modalAllocItemDesc").text(decodeURIComponent(description));
        var win = $("#step3AllocationModalWindow").data("kendoWindow");
        if (win) win.center().open();
    }

    function closeStep3AllocationModal() {
        var win = $("#step3AllocationModalWindow").data("kendoWindow");
        if (win) win.close();
    }

    function onItemGSOCategoryChange(itemId, newCategory) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            item.gsoCategory = newCategory;
            renderStep3AccordionItems();
        }
    }

    function onItemTechDescChange(itemId, newDesc) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) item.technicalDescription = newDesc;
    }

    function onItemAttributeChange(itemId, key, value) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            if (!item.attributes) item.attributes = {};
            item.attributes[key] = value;
        }
    }

    function onAddSubItem(itemId) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            if (!item.setLotItems) item.setLotItems = [];
            item.setLotItems.push({ description: "New Component Sub-Item", qty: 1, unit: "pc" });
            renderStep3AccordionItems();
        }
    }

    // Render Line Items Accordion
    function renderStep3AccordionItems() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        var container = $("#step3ItemsAccordionContainer");
        container.empty();

        if (!activeGroup || !activeGroup.items || activeGroup.items.length === 0) {
            container.html('<div style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 24px; text-align: center; color: #64748b; font-size: 12px;">No line items assigned to this PO group yet. Return to Step 2 to assign items.</div>');
            return;
        }

        activeGroup.items.forEach(function (item, index) {
            var isExpanded = (expandedStep3ItemId === item.id) || (expandedStep3ItemId === null);
            var subtotal = item.qty * item.unitCost;
            var chevronIcon = isExpanded ? 'k-i-arrow-chevron-up' : 'k-i-arrow-chevron-down';

            var itemCard = $('<div class="step3-accordion-item" id="accordionItem_' + item.id + '" style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; margin-bottom: 12px; overflow: hidden;"></div>');

            // Accordion Header
            var headerHtml = '<div class="step3-accordion-header" onclick="toggleAccordionItem(\'' + item.id + '\')" style="padding: 12px 16px; background: #f8fafc; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-bottom: ' + (isExpanded ? '1px solid #cbd5e1' : 'none') + ';">' +
                '<div style="display: flex; align-items: center; gap: 12px;">' +
                '<span style="width: 24px; height: 24px; border-radius: 50%; background: #002046; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0;">' + (index + 1) + '</span>' +
                '<div>' +
                '<div style="font-weight: 700; font-size: 12px; color: #002046;">' + item.description + '</div>' +
                '<span style="font-family: monospace; font-size: 11px; color: #64748b;">' + (item.stockNo || item.itemCode) + '</span>' +
                '</div>' +
                '</div>' +
                '<div style="display: flex; align-items: center; gap: 20px; font-size: 12px;">' +
                '<div style="text-align: right;">' +
                '<span style="font-size: 10px; color: #64748b; display: block;">Qty</span>' +
                '<strong style="font-family: monospace;">' + item.qty + ' ' + item.unit + '</strong>' +
                '</div>' +
                '<div style="text-align: right;">' +
                '<span style="font-size: 10px; color: #64748b; display: block;">Unit Cost</span>' +
                '<span style="font-family: monospace; color: #475569;">' + formatStep3Currency(item.unitCost) + '</span>' +
                '</div>' +
                '<div style="text-align: right;">' +
                '<span style="font-size: 10px; color: #64748b; display: block;">Total</span>' +
                '<strong style="font-family: monospace; color: #166534;">' + formatStep3Currency(subtotal) + '</strong>' +
                '</div>' +
                '<span class="k-icon ' + chevronIcon + '" style="color: #64748b;"></span>' +
                '</div>' +
                '</div>';

            itemCard.append(headerHtml);

            // Accordion Body
            if (isExpanded) {
                var body = $('<div class="step3-accordion-body" style="padding: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; background: #ffffff;"></div>');

                // Left Sub-Panel
                var catOptionsHtml = '';
                GSO_CATEGORIES_LIST.forEach(function (cat) {
                    var isSelected = (item.gsoCategory === cat) ? ' selected="selected"' : '';
                    catOptionsHtml += '<option value="' + cat + '"' + isSelected + '>' + cat + '</option>';
                });

                var leftSubPanel = $('<div style="display: flex; flex-direction: column; gap: 12px;">' +
                    '<div>' +
                    '<label style="display: block; font-weight: 600; color: #475569; margin-bottom: 4px;">GSO Category <span style="color: #ef4444;">*</span></label>' +
                    '<select class="form-control-custom" style="width: 100%; padding: 6px;" onchange="onItemGSOCategoryChange(\'' + item.id + '\', this.value)">' +
                    catOptionsHtml +
                    '</select>' +
                    '</div>' +
                    '<div>' +
                    '<label style="display: block; font-weight: 600; color: #475569; margin-bottom: 4px;">Technical Description</label>' +
                    '<textarea rows="3" class="form-control-custom" style="width: 100%; resize: none;" placeholder="Detailed government specifications..." onchange="onItemTechDescChange(\'' + item.id + '\', this.value)">' + (item.technicalDescription || '') + '</textarea>' +
                    '</div>' +
                    '<div style="display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid #e2e8f0;">' +
                    '<div>' +
                    '<span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Stock Number</span>' +
                    '<strong style="font-family: monospace; font-size: 12px; color: #002046; display: flex; align-items: center; gap: 4px;">' +
                    '<span class="k-icon k-i-check-circle" style="color: #16a34a;"></span> ' + (item.stockNo || 'STK-GEN-001') +
                    '</strong>' +
                    '</div>' +
                    '<button type="button" class="k-button k-button-outline" style="font-size: 11px; padding: 4px 10px; border-color: rgba(17,92,185,0.3); color: #115cb9;" onclick="openStep3AllocationModal(\'' + (item.stockNo || 'STK-GEN-001') + '\', \'' + encodeURIComponent(item.description) + '\')">' +
                    '<span class="k-icon k-i-inherited"></span> View Allocation' +
                    '</button>' +
                    '</div>' +
                    '</div>');

                // Right Sub-Panel
                var rightSubPanel = $('<div class="step3-subitem-box" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px;"></div>');
                rightSubPanel.append('<h4 style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #002046; margin: 0 0 10px 0;">Additional Specs: ' + item.gsoCategory + '</h4>');

                var attrs = item.attributes || {};
                var attrsGrid = $('<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;"></div>');

                if (item.gsoCategory === 'Office Supplies') {
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Brand</label><input type="text" value="' + (attrs.Brand || 'Double A') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Paper Size</label><input type="text" value="' + (attrs.PaperSize || 'A4') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'PaperSize\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">GSM</label><input type="text" value="' + (attrs.GSM || '80') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'GSM\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Color</label><input type="text" value="' + (attrs.Color || 'White') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Color\', this.value)" /></div>');
                } else if (item.gsoCategory === 'IT Equipment') {
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Brand</label><input type="text" value="' + (attrs.Brand || 'Dell Latitude') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Processor</label><input type="text" value="' + (attrs.Processor || 'Intel Core i7') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Processor\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">RAM</label><input type="text" value="' + (attrs.RAM || '16GB DDR5') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'RAM\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">OS</label><input type="text" value="' + (attrs.OS || 'Windows 11 Pro') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'OS\', this.value)" /></div>');
                } else if (item.gsoCategory === 'Drugs / Medicine') {
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Expiry Date</label><input type="date" value="' + (attrs.ExpiryDate || '2026-12-31') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'ExpiryDate\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">FDA Reg. No.</label><input type="text" value="' + (attrs.FDARegNo || 'DR-XY12345') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'FDARegNo\', this.value)" /></div>');
                } else {
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Brand / Manufacturer</label><input type="text" value="' + (attrs.Brand || 'Standard Government Grade') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label style="font-size: 10px; color: #64748b; display: block;">Warranty / Terms</label><input type="text" value="' + (attrs.Warranty || '1 Year Standard') + '" class="form-control-custom" style="width: 100%; padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Warranty\', this.value)" /></div>');
                }
                rightSubPanel.append(attrsGrid);

                // Set / Lot Sub-Items Section
                var subItemsWrapper = $('<div style="padding-top: 10px; border-top: 1px solid #cbd5e1;"></div>');
                var subItemsCount = (item.setLotItems ? item.setLotItems.length : 0);
                var autoBadgeHtml = subItemsCount > 0
                    ? '<span class="step3-subitem-auto-badge" style="font-size: 10px; color: #15803d; background: #dcfce7; padding: 2px 6px; border-radius: 4px;"><span class="k-icon k-i-hyperlink"></span> Auto-retrieved (' + subItemsCount + ' sub-items)</span>'
                    : '';

                var subItemsHeader = $('<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">' +
                    '<div style="display: flex; align-items: center; gap: 6px;">' +
                    '<span style="font-size: 10px; font-weight: 700; color: #475569; text-transform: uppercase;">Set / Lot Sub-Items Composition</span>' +
                    autoBadgeHtml +
                    '</div>' +
                    '<button type="button" class="k-button k-button-flat-primary" style="font-size: 11px; padding: 2px 6px;" onclick="onAddSubItem(\'' + item.id + '\')">' +
                    '<span class="k-icon k-i-plus"></span> Add Sub-Item' +
                    '</button>' +
                    '</div>');
                subItemsWrapper.append(subItemsHeader);

                if (subItemsCount > 0) {
                    var subTable = $('<table style="width: 100%; border-collapse: collapse; font-size: 11px; background: #fff; border: 1px solid #e2e8f0;">' +
                        '<thead><tr style="background: #f1f5f9; text-align: left;"><th style="padding: 4px 6px;">Description</th><th style="padding: 4px 6px; text-align: right;">Qty</th><th style="padding: 4px 6px;">Unit</th></tr></thead>' +
                        '<tbody></tbody>' +
                        '</table>');
                    var subTbody = subTable.find('tbody');

                    item.setLotItems.forEach(function (sub) {
                        subTbody.append('<tr>' +
                            '<td style="padding: 4px 6px; border-top: 1px solid #e2e8f0;">' + sub.description + '</td>' +
                            '<td style="padding: 4px 6px; border-top: 1px solid #e2e8f0; text-align: right; font-family: monospace;">' + sub.qty + '</td>' +
                            '<td style="padding: 4px 6px; border-top: 1px solid #e2e8f0;">' + sub.unit + '</td>' +
                            '</tr>');
                    });
                    subItemsWrapper.append(subTable);
                } else {
                    subItemsWrapper.append('<div style="font-size: 11px; color: #94a3b8; font-style: italic;">No set/lot sub-items configured for this item.</div>');
                }

                rightSubPanel.append(subItemsWrapper);

                body.append(leftSubPanel);
                body.append(rightSubPanel);
                itemCard.append(body);
            }

            container.append(itemCard);
        });
    }
</script>
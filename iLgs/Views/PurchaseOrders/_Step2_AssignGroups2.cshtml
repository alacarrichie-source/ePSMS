@using iLgs.Ai.Models

<div class="wizard-card">

    <!-- ================================================================
         STEP HEADER
         ================================================================ -->
    <div class="wizard-card-header">
        <div>
            <h2>Step 2: Assign PR Items to Purchase Orders</h2>
            <p class="subtitle">
                Distribute line items from selected PRs across PO Groups.
                Default allocation is PO Group 1.
            </p>
        </div>

        <div class="wizard-card-actions">
            <button type="button"
                    class="btn-procurement-primary"
                    onclick="handleQuickAddGroup()">
                <span class="k-icon k-i-plus"></span>
                Create PO Group
            </button>
        </div>
    </div>


    <!-- ================================================================
         MAIN SPLIT LAYOUT
         ================================================================ -->
    <div class="step2-split-layout">

        <!-- ============================================================
             LEFT: PR LINE ITEMS
             ============================================================ -->
        <div class="step2-items-card">

            <div class="step2-table-header">
                <span class="fw-bold">
                    PR Line Items
                    (<span id="step2TotalItemsCount">0</span>)
                </span>

                <span>
                    Default Target:
                    <strong>PO Group 1</strong>
                </span>
            </div>

            <div class="table-responsive">

                <table class="step2-table">

                    <thead>
                        <tr>
                            <th style="min-width:240px;">
                                Description &amp; Source
                            </th>

                            <th class="text-center" style="width:70px;">
                                Unit
                            </th>

                            <th class="text-end" style="width:90px;">
                                Req. Qty
                            </th>

                            <th class="text-end" style="width:120px;">
                                Unit Cost
                            </th>

                            <th class="text-center" style="width:110px;">
                                Assign Qty
                            </th>

                            <th class="text-center" style="width:90px;">
                                Remaining
                            </th>

                            <th style="width:180px;">
                                Target PO Group
                            </th>
                        </tr>
                    </thead>

                    <tbody id="step2AllocationsTableBody">
                        <!-- Populated by JavaScript -->
                    </tbody>

                </table>

            </div>
        </div>


        <!-- ============================================================
             RIGHT: PO GROUPS
             ============================================================ -->
        <div class="step2-groups-column">

            <div class="section-heading"
                 style="display:flex; justify-content:space-between; align-items:center;">

                <h3>
                    Target PO Groups
                    (<span id="step2GroupsCount">1</span>)
                </h3>

            </div>

            <div id="step2GroupsListContainer">
                <!-- Dynamically rendered group cards -->
            </div>

        </div>

    </div>


    <!-- ================================================================
         NAVIGATION
         ================================================================ -->
    <div class="wizard-summary-bar">

        <div class="wizard-summary-info">
            <span class="wizard-summary-label">
                Items will be organized into the selected PO Groups.
            </span>
        </div>

        <div class="wizard-summary-actions">

            <button type="button"
                    class="btn-procurement-secondary"
                    onclick="goToStep1()">
                &larr; Back to PRs
            </button>

            <button type="button"
                    id="btnStep2Next"
                    class="btn-procurement-primary"
                    onclick="goToStep3()">
                Next: PO Details
                (<span id="btnNextGroupSummary">1 Group</span>)
                &rarr;
            </button>

        </div>

    </div>

</div>


<script>

    /* ================================================================
       STEP 2 - GROUP HELPERS
       ================================================================ */

    function getNextGroupNumber() {

        var maxNum = 0;

        if (poGroups && poGroups.length > 0) {

            poGroups.forEach(function (group) {

                var match = group.groupName
                    ? group.groupName.match(/\d+/)
                    : null;

                if (match) {

                    var num = parseInt(match[0], 10);

                    if (num > maxNum) {
                        maxNum = num;
                    }
                }
            });
        }

        return maxNum > 0
            ? maxNum + 1
            : (poGroups ? poGroups.length + 1 : 1);
    }


    /* ================================================================
       CURRENCY
       ================================================================ */

    function formatStep2Currency(amount) {

        return "PHP " +
            Number(amount || 0).toLocaleString(
                "en-US",
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            );
    }


    /* ================================================================
       GROUP METRICS
       ================================================================ */

    function getGroupMetrics(groupId) {

        if (!allocatedItems || allocatedItems.length === 0) {

            return {
                count: 0,
                total: 0,
                items: []
            };
        }

        var groupItems = allocatedItems.filter(function (item) {

            var targetGroupId =
                item.TargetGroupId ||
                (poGroups[0]
                    ? poGroups[0].groupId
                    : "");

            return targetGroupId === groupId &&
                item.AssignedQty > 0;
        });


        var total = groupItems.reduce(function (sum, item) {

            return sum +
                ((Number(item.AssignedQty) || 0) *
                    (Number(item.UnitCost) || 0));

        }, 0);


        return {
            count: groupItems.length,
            total: total,
            items: groupItems
        };
    }


    /* ================================================================
       ADD PO GROUP
       ================================================================ */

    function handleQuickAddGroup() {

        var nextGroupNum = getNextGroupNumber();

        var newGroupId =
            "grp-" +
            nextGroupNum +
            "-" +
            Date.now();


        var newGroup = {

            groupId: newGroupId,

            groupName:
            "PO Group " +
            nextGroupNum,

            supplierId: 0,

            poDate: new Date(),

            deliveryPeriodDays: 30,

            placeOfDelivery:
            "General Services Office (GSO) Warehouse",

            paymentTerms:
            "30 Calendar Days upon full acceptance",

            modeOfProcurement:
            "Public Bidding",

            items: [],

            poCopyDoc: null,

            additionalDocs: []
        };


        poGroups.push(newGroup);

        renderStep2Allocations();
    }


    /* ================================================================
       DELETE PO GROUP
       ================================================================ */

    function handleDeleteGroup(groupId) {

        if (!poGroups || poGroups.length <= 1) {
            return;
        }


        poGroups = poGroups.filter(function (group) {

            return group.groupId !== groupId;
        });


        var fallbackGroupId =
            poGroups[0]
                ? poGroups[0].groupId
                : "";


        /*
         * Reassign items that belonged to the deleted group
         * back to PO Group 1.
         */
        if (allocatedItems) {

            allocatedItems.forEach(function (item) {

                if (item.TargetGroupId === groupId) {

                    item.TargetGroupId =
                        fallbackGroupId;

                    item.AssignedQty =
                        fallbackGroupId
                            ? Number(item.RequestedQty) || 0
                            : 0;

                    item.RemainingQty =
                        fallbackGroupId
                            ? 0
                            : Number(item.RequestedQty) || 0;
                }

            });
        }


        renderStep2Allocations();
    }


    /* ================================================================
       ASSIGN QUANTITY
       ================================================================ */

    function handleAssignQtyChange(itemIndex, inputElement) {

        var item =
            allocatedItems[itemIndex];

        if (!item) {
            return;
        }


        var rawValue =
            parseInt(inputElement.value, 10);


        if (isNaN(rawValue)) {
            rawValue = 0;
        }


        var requestedQty =
            Number(item.RequestedQty) || 0;


        var validQty =
            Math.max(
                0,
                Math.min(
                    requestedQty,
                    rawValue
                )
            );


        inputElement.value =
            validQty;


        item.AssignedQty =
            validQty;


        item.RemainingQty =
            requestedQty -
            validQty;


        updateRemainingQuantity(
            itemIndex,
            item.RemainingQty
        );


        updateGroupMetricsCards();
    }


    /* ================================================================
       UPDATE REMAINING QUANTITY
       ================================================================ */

    function updateRemainingQuantity(
        itemIndex,
        remainingQty
    ) {

        var element =
            document.getElementById(
                "itemRemaining_" +
                itemIndex
            );


        if (!element) {
            return;
        }


        if (remainingQty === 0) {

            element.innerHTML =
                '<span class="step2-remaining-complete">0</span>';

        }
        else {

            element.innerHTML =
                '<span class="step2-remaining-pending">' +
                remainingQty +
                '</span>';
        }
    }


    /* ================================================================
       GROUP SELECTION
       ================================================================ */

    function handleGroupSelect(
        itemIndex,
        targetGroupId
    ) {

        var item =
            allocatedItems[itemIndex];

        if (!item) {
            return;
        }


        item.TargetGroupId =
            targetGroupId;


        if (targetGroupId) {

            /*
             * When moving an unassigned item to a group,
             * automatically assign the requested quantity.
             */
            item.AssignedQty =
                Number(item.AssignedQty) > 0
                    ? Number(item.AssignedQty)
                    : Number(item.RequestedQty) || 0;


            item.RemainingQty =
                (Number(item.RequestedQty) || 0) -
                (Number(item.AssignedQty) || 0);
        }
        else {

            item.AssignedQty = 0;

            item.RemainingQty =
                Number(item.RequestedQty) || 0;
        }


        var quantityInput =
            document.getElementById(
                "itemAssignQty_" +
                itemIndex
            );


        if (quantityInput) {

            quantityInput.value =
                item.AssignedQty;
        }


        updateRemainingQuantity(
            itemIndex,
            item.RemainingQty
        );


        updateGroupMetricsCards();
    }


    /* ================================================================
       RENDER GROUP SUMMARY CARDS
       ================================================================ */

    function updateGroupMetricsCards() {

        var container =
            $("#step2GroupsListContainer");


        container.empty();


        var groupCount =
            poGroups
                ? poGroups.length
                : 0;


        $("#step2GroupsCount")
            .text(groupCount);


        var groupLabel =
            groupCount +
            " Group" +
            (groupCount !== 1
                ? "s"
                : "");


        $("#btnNextGroupSummary")
            .text(groupLabel);


        if (!poGroups ||
            poGroups.length === 0) {

            return;
        }


        poGroups.forEach(function (
            group,
            index
        ) {

            var metrics =
                getGroupMetrics(
                    group.groupId
                );


            var isPrimary =
                index === 0;


            var subTitle =
                isPrimary
                    ? "Primary Default Group"
                    : "Consolidated Group " +
                    (index + 1);


            var deleteButtonHtml =
                "";


            if (poGroups.length > 1) {

                deleteButtonHtml =
                    '<button type="button" ' +
                    'class="btn-delete-group" ' +
                    'onclick="handleDeleteGroup(\'' +
                    group.groupId +
                    '\')" ' +
                    'title="Delete Group">' +

                    '<span class="k-icon k-i-trash"></span>' +

                    '</button>';
            }


            var cardHtml =

                '<div class="step2-group-card-item">' +

                '<div class="step2-group-card-header">' +

                '<div class="step2-group-title">' +

                '<span class="step2-group-avatar">' +
                (index + 1) +
                '</span>' +

                '<div>' +

                '<h4>' +
                group.groupName +
                '</h4>' +

                '<span class="step2-group-subtitle">' +
                subTitle +
                '</span>' +

                '</div>' +

                '</div>' +

                deleteButtonHtml +

                '</div>' +


                '<div class="step2-group-metrics">' +

                '<div>' +

                '<span class="step2-metric-label">' +
                'Assigned Items' +
                '</span>' +

                '<strong>' +
                metrics.count +
                ' item' +
                (metrics.count !== 1
                    ? 's'
                    : '') +
                '</strong>' +

                '</div>' +


                '<div class="step2-metric-total">' +

                '<span class="step2-metric-label">' +
                'Estimated Total' +
                '</span>' +

                '<strong>' +
                formatStep2Currency(
                    metrics.total
                ) +
                '</strong>' +

                '</div>' +

                '</div>' +

                '</div>';


            container.append(
                cardHtml
            );
        });
    }


    /* ================================================================
       RENDER STEP 2
       ================================================================ */

    function renderStep2Allocations() {

        if (!allocatedItems) {
            allocatedItems = [];
        }


        /*
         * Make sure there is always a PO Group 1.
         */
        if (!poGroups ||
            poGroups.length === 0) {

            poGroups = [{
                groupId: "grp-1",

                groupName:
                "PO Group 1",

                supplierId: 0,

                poDate: new Date(),

                deliveryPeriodDays: 30,

                placeOfDelivery:
                "General Services Office (GSO) Warehouse",

                paymentTerms:
                "30 Calendar Days upon full acceptance",

                modeOfProcurement:
                "Public Bidding",

                items: [],

                poCopyDoc: null,

                additionalDocs: []
            }];
        }


        var defaultGroupId =
            poGroups[0].groupId;


        /*
         * Initialize allocation values.
         */
        allocatedItems.forEach(function (item) {

            if (
                item.TargetGroupId === undefined ||
                item.TargetGroupId === null ||
                item.TargetGroupId === ""
            ) {

                item.TargetGroupId =
                    defaultGroupId;
            }


            if (
                item.AssignedQty === undefined ||
                item.AssignedQty === null
            ) {

                item.AssignedQty =
                    Number(item.RequestedQty) || 0;
            }


            if (
                item.RemainingQty === undefined ||
                item.RemainingQty === null
            ) {

                item.RemainingQty =
                    (Number(item.RequestedQty) || 0) -
                    (Number(item.AssignedQty) || 0);
            }

        });


        /*
         * Item count.
         */
        $("#step2TotalItemsCount")
            .text(allocatedItems.length);


        var tbody =
            $("#step2AllocationsTableBody");


        tbody.empty();


        /* ============================================================
           EMPTY STATE
           ============================================================ */

        if (allocatedItems.length === 0) {

            tbody.append(

                '<tr>' +

                '<td colspan="7" ' +
                'class="text-center step2-empty-state">' +

                'No line items found for selected ' +
                'Purchase Requests.' +

                '</td>' +

                '</tr>'
            );

        }


        /* ============================================================
           ITEM ROWS
           ============================================================ */

        else {

            allocatedItems.forEach(
                function (item, index) {

                    var subItemsBadge =
                        "";


                    if (
                        item.SetLotItems &&
                        item.SetLotItems.length > 0
                    ) {

                        subItemsBadge =
                            '<span class="step2-subitem-badge">' +
                            item.SetLotItems.length +
                            ' Sub-Items' +
                            '</span>';
                    }


                    var remainingHtml =
                        item.RemainingQty === 0

                            ? '<span class="step2-remaining-complete">0</span>'

                            : '<span class="step2-remaining-pending">' +
                            item.RemainingQty +
                            '</span>';


                    var optionsHtml =
                        '<option value="">-- Unassigned --</option>';


                    poGroups.forEach(
                        function (group) {

                            var selected =
                                item.TargetGroupId ===
                                    group.groupId

                                    ? ' selected="selected"'
                                    : '';


                            optionsHtml +=
                                '<option value="' +
                                group.groupId +
                                '"' +
                                selected +
                                '>' +
                                group.groupName +
                                '</option>';
                        }
                    );


                    var rowHtml =

                        '<tr>' +


                        /* DESCRIPTION */

                        '<td>' +

                        '<div class="step2-item-description">' +
                        (item.Description || "") +
                        '</div>' +

                        '<div class="step2-item-meta">' +

                        '<span class="step2-pr-badge">' +
                        (item.PRNumber || "") +
                        '</span>' +

                        subItemsBadge +

                        '</div>' +

                        '</td>' +


                        /* UNIT */

                        '<td class="text-center step2-unit-cell">' +
                        (item.Unit || "") +
                        '</td>' +


                        /* REQUESTED QTY */

                        '<td class="text-end step2-quantity-cell">' +
                        (item.RequestedQty || 0) +
                        '</td>' +


                        /* UNIT COST */

                        '<td class="text-end step2-cost-cell">' +
                        formatStep2Currency(
                            item.UnitCost
                        ) +
                        '</td>' +


                        /* ASSIGN QTY */

                        '<td class="text-center">' +

                        '<input ' +
                        'type="number" ' +
                        'min="0" ' +
                        'max="' +
                        (item.RequestedQty || 0) +
                        '" ' +
                        'value="' +
                        (item.AssignedQty || 0) +
                        '" ' +
                        'id="itemAssignQty_' +
                        index +
                        '" ' +
                        'class="step2-assign-input" ' +
                        'onchange="handleAssignQtyChange(' +
                        index +
                        ', this)" ' +
                        'onkeyup="handleAssignQtyChange(' +
                        index +
                        ', this)" ' +
                        '/>' +

                        '</td>' +


                        /* REMAINING */

                        '<td ' +
                        'class="text-center" ' +
                        'id="itemRemaining_' +
                        index +
                        '">' +

                        remainingHtml +

                        '</td>' +


                        /* TARGET GROUP */

                        '<td>' +

                        '<select ' +
                        'class="step2-group-select" ' +
                        'onchange="handleGroupSelect(' +
                        index +
                        ', this.value)">' +

                        optionsHtml +

                        '</select>' +

                        '</td>' +


                        '</tr>';


                    tbody.append(
                        rowHtml
                    );
                }
            );
        }


        updateGroupMetricsCards();
    }


    /* ================================================================
       STEP NAVIGATION
       ================================================================ */

    function goToStep1() {

        var stepper =
            $("#poStepper")
                .data("kendoStepper");


        if (stepper) {

            stepper.previous();

        }
        else {

            navigateToStep(0);
        }
    }


    function goToStep3() {

        /*
         * Prepare the PO Group data before
         * moving to PO Details.
         */
        prepareStep3Data();


        var stepper =
            $("#poStepper")
                .data("kendoStepper");


        if (stepper) {

            stepper.next();

        }
        else {

            navigateToStep(2);
        }
    }


    /* ================================================================
       INITIALIZE STEP 2
       ================================================================ */

    $(document).ready(function () {

        renderStep2Allocations();

    });

</script>
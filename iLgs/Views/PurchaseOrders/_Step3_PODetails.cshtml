                '<div>' +
                '<div class="step3-item-heading" style="font-weight: 700; font-size: 12px; color: #002046;">' + escapeStep3Html(item.description) + '</div>' +
                '<span class="step3-item-stock-number" style="font-family: monospace; font-size: 11px; color: #64748b;">' + escapeStep3Html(item.stockNo || item.itemCode || "") + '</span>' +
                '</div>' +

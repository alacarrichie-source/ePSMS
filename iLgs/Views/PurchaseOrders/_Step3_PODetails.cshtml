            var headerHtml = '<div class="step3-accordion-header" onclick="toggleAccordionItem(\'' + item.id + '\')" style="padding: 12px 16px; background: #f8fafc; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-bottom: ' + (isExpanded ? '1px solid #cbd5e1' : 'none') + ';">' +

@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<style>
    .step3-missing-field-focus {
        outline: 3px solid rgba(245, 158, 11, 0.45) !important;
        outline-offset: 2px;
        transition: outline-color 0.2s ease;
    }
</style>

<div class="wizard-card">
    <!-- Step Header -->
    <div class="header-bar" style="margin-bottom: 16px;">
        <div>
            <h2 style="font-size: 18px; font-weight: 700; color: #002046; margin: 0 0 4px 0;">Step 3: Purchase Order Details</h2>
            <p class="subtitle" style="font-size: 12px; color: #64748B; margin: 0;">Review and complete the consolidated line items for each PO group.</p>
        </div>
    </div>

    <!-- PO Group Tabs Navigation -->
    <div class="step3-group-tabs" id="step3GroupTabsNav">
        <!-- Dynamically rendered tabs with status badges -->
    </div>

    <div class="step3-split-layout form-grid" id="step3SplitLayoutContainer" style="display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; align-items: start; width: 100%;">
        <!-- Consolidated Line Items. PO-level details are completed in Step 4. -->
        <div class="step3-right-col">
            <!-- Metric Banner -->
            <div class="step3-metric-banner" style="display: flex; justify-content: space-between; align-items: center; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 20px;">
                    <div>
                        <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Consolidated Items</span>
                        <span id="lblActiveGroupItemsCount" style="font-weight: 700; font-size: 12px; color: #002046;">0 Items</span>
                    </div>
                </div>

                <div style="text-align: right;">
                    <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Total Group Amount</span>
                    <span id="lblActiveGroupTotalAmount" style="font-family: monospace; font-weight: 700; font-size: 15px; color: #166534;">PHP 0.00</span>
                </div>
            </div>

            <!-- Consolidated Line Items Accordion Container -->
            <div id="step3ItemsAccordionContainer">
                <!-- Dynamically rendered line items -->
            </div>
        </div>
    </div>

    <!-- Source PR Allocation & Warehouse Mapping Modal Window -->
    @(Html.Kendo().Window()
        .Name("step3AllocationModalWindow")
        .Title("Source PR Allocation & Warehouse Mapping")
        .Width(660)
        .Modal(true)
        .Visible(false)
        .Actions(actions => actions.Close())
        .Content(@<text>
            <div style="padding: 16px; font-size: 12px;">
                <!-- Header Banner -->
                <div style="background: #002046; color: #fff; padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="k-icon k-i-inherited" style="color: #659dfe; font-size: 18px;"></span>
                        <div>
                            <div style="font-weight: 700; font-size: 13px;">Source PR Allocation &amp; Warehouse Mapping</div>
                            <span id="modalAllocStockNo" style="font-family: monospace; font-size: 11px; color: #87A0CD;">STK-GEN-001</span>
                        </div>
                    </div>
                </div>

                <!-- Item Description Box -->
                <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; margin-bottom: 16px;">
                    <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block; margin-bottom: 2px;">Item Name</span>
                    <p id="modalAllocItemDesc" style="font-weight: 700; color: #002046; font-size: 13px; margin: 0;">Multipurpose Paper A4</p>
                </div>

                <!-- PR Source Breakdown Table -->
                <h4 style="font-size: 12px; font-weight: 700; color: #002046; margin: 0 0 8px 0;">PR Source Breakdown</h4>
                <table class="alloc-table" style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                    <thead>
                        <tr style="background-color: #f1f5f9; text-align: left; font-size: 11px; color: #475569;">
                            <th style="padding: 8px;">PR Number</th>
                            <th style="padding: 8px;">Requesting Department</th>
                            <th style="padding: 8px; text-align: right;">Allocated Qty</th>
                            <th style="padding: 8px; text-align: right;">Unit Price</th>
                            <th style="padding: 8px;">Target Stock Bin</th>
                        </tr>
                    </thead>
                    <tbody id="modalAllocTableBody">
                        <tr>
                            <td style="padding: 8px; font-family: monospace; color: #115cb9; font-weight: 600;">PR-2026-001</td>
                            <td style="padding: 8px;">IT Department (Workstation rollout)</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace; font-weight: 700;">15 Reams</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace;">PHP 250.00</td>
                            <td style="padding: 8px; font-family: monospace; color: #64748b;">BIN-GSO-A12</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; font-family: monospace; color: #115cb9; font-weight: 600;">PR-2026-005</td>
                            <td style="padding: 8px;">General Admin Services</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace; font-weight: 700;">10 Reams</td>
                            <td style="padding: 8px; text-align: right; font-family: monospace;">PHP 250.00</td>
                            <td style="padding: 8px; font-family: monospace; color: #64748b;">BIN-GSO-A14</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="font-weight: bold; border-top: 1px solid #cbd5e1;">
                            <td colspan="2" style="padding: 8px; text-align: right; text-transform: uppercase; color: #475569;">Total Consolidated:</td>
                            <td id="modalAllocTotalQty" style="padding: 8px; text-align: right; font-family: monospace; color: #166534;">25 Reams</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>

                <!-- Action Footer with Step 1 Themed Secondary Button -->
                <div style="display: flex; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                    @(Html.Kendo().Button()
                        .Name("btnCloseAllocModal")
                        .ThemeColor(ThemeColor.Secondary)
                        .Content("Done")
                        .HtmlAttributes(new { onclick = "closeStep3AllocationModal()", @class = "btn-secondary" })
                    )
                </div>
            </div>
        </text>)
    )

    <!-- Navigation Action Bar -->
    <div class="wizard-summary-bar wizard-final-actions">
        @(Html.Kendo().Button()
                .Name("btnStep3Back")
                .FillMode(ButtonFillMode.Outline)
                .Content("<span class='k-icon k-i-arrow-left'></span> Back to Assign Items")
                .HtmlAttributes(new { onclick = "goToWizardStep(2)", @class = "btn-procurement-secondary" })
        )
        <div class="wizard-action-group">
            @(Html.Kendo().Button()
                    .Name("btnStep3Next")
                    .ThemeColor(ThemeColor.Primary)
                    .Content("Next: Review & Post <span class='k-icon k-i-arrow-right'></span>")
                    .HtmlAttributes(new { onclick = "goToWizardStep(4)", @class = "btn-procurement-primary" })
            )
        </div>
    </div>
</div>

<script>
    var activeStep3GroupIndex = 0;
    var expandedStep3ItemId = null;
    var step3StockNumberTimers = {};

    var GSO_CATEGORIES_LIST = [
        'Office Supplies',
        'IT Equipment',
        'Janitorial Supplies',
        'Furniture & Fixtures',
        'Electrical Supplies',
        'Hardware & Construction',
        'Drugs / Medicine',
        'Vehicle Parts & Maintenance',
        'Food Supplies',
        'General Merchandise'
    ];

    // Format currency in PHP
    function formatStep3Currency(amount) {
        return "PHP " + Number(amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Called when stepping into Step 3
    function prepareStep3Data() {
        if (!poGroups) poGroups = [];
        if (!allocatedItems) allocatedItems = [];
        
        poGroups.forEach(function (grp) {
            var existingItems = grp.items || [];

            /*
             * Get all Step 2 items assigned to this PO Group.
             */
            var groupItems = allocatedItems.filter(function (it) {
                return (it.TargetGroupId || "grp-1") === grp.groupId
                    && Number(it.AssignedQty || 0) > 0;
            });

            /*
             * ============================================================
             * CONSOLIDATE ITEMS
             * ============================================================
             *
             * Same item = same PPMPCode + Description
             *
             * Example:
             *
             * PR-001 | PPMP-001 | A4 Paper | 15
             * PR-005 | PPMP-001 | A4 Paper | 10
             *
             * becomes:
             *
             * PPMP-001 | A4 Paper | 25
             *
             * The individual PR allocations are retained in sourcePRs[]
             * for the "View Allocation" modal.
             */
            var consolidated = {};

            groupItems.forEach(function (it) {

                var ppmpCode = (it.PPMPCode || "").toString().trim();
                var description = (it.Description || "").toString().trim();

                /*
                 * Case-insensitive normalized key.
                 */
                var consolidationKey =
                    ppmpCode.toUpperCase() +
                    "|" +
                    description.toUpperCase();

                /*
                 * First occurrence of this item.
                 */
                if (!consolidated[consolidationKey]) {

                    consolidated[consolidationKey] = {
                        id: it.Id || ("li-" + (Object.keys(consolidated).length + 1)),

                        itemNo: Object.keys(consolidated).length + 1,

                        PPMPCode: ppmpCode,

                        description: description,

                        stockNo: it.StockNo || "",

                        itemCodeId: it.ItemCodeId || null,

                        itemCode: it.ItemCode || "",

                        psType: it.PsType || "",

                        category: it.Category || "",

                        account: it.Account || it.PsTypeDesc || "",

                        subAccount: it.SubAccount || "",

                        unit: it.Unit || "pc",

                        unitCost: Number(it.UnitCost || 0),

                        /*
                         * This will contain the SUM of AssignedQty
                         * from all PRs belonging to this item.
                         */
                        qty: 0,

                        totalCost: 0,

                        article: it.Article || it.GSOCategory || description,

                        gsoCategory: it.Article || it.GSOCategory || description,

                        technicalDescription: it.OtherDescription || it.TechnicalDescription || "",

                        attributes: it.Attributes
                            ? JSON.parse(JSON.stringify(it.Attributes))
                            : {
                                Brand: "Generic",
                                Origin: "Local"
                            },

                        additionalSpecs: it.AdditionalSpecs
                            ? $.extend({}, it.AdditionalSpecs)
                            : {},

                        setLotItems: it.SetLotItems
                            ? JSON.parse(JSON.stringify(it.SetLotItems))
                            : [],

                        /*
                         * Preserve the individual PR allocations.
                         */
                        sourcePRs: []
                    };
                }

                var consolidatedItem = consolidated[consolidationKey];

                /*
                 * ========================================================
                 * ADD ASSIGNED QUANTITY
                 * ========================================================
                 */
                var assignedQty = Number(it.AssignedQty || 0);

                consolidatedItem.qty += assignedQty;

                /*
                 * ========================================================
                 * RETAIN SOURCE PR
                 * ========================================================
                 *
                 * This allows Step 3 to still show:
                 *
                 * PR-001 = 15
                 * PR-005 = 10
                 *
                 * even though the PO line is consolidated to 25.
                 */
                consolidatedItem.sourcePRs.push({
                    requestItemId: it.Id,

                    prId: it.PrId || it.PRId || it.PRID || null,

                    prNo: it.PrNo ||
                          it.PRNo ||
                          it.PRNumber ||
                          it.PurchaseRequestNo ||
                          "",

                    requestingDepartment:
                        it.RequestingDepartment ||
                        it.DepartmentName ||
                        it.Department ||
                        "",

                    allocatedQty: assignedQty,

                    unit: it.Unit || consolidatedItem.unit,

                    unitCost: Number(it.UnitCost || 0),

                    stockBin:
                        it.TargetStockBin ||
                        it.StockBin ||
                        it.WarehouseBin ||
                        ""
                });

                /*
                 * ========================================================
                 * RETAIN EXISTING ITEM INFORMATION
                 * ========================================================
                 *
                 * We keep the same fields your original Step 3 uses.
                 */

                if (!consolidatedItem.stockNo && it.StockNo) {
                    consolidatedItem.stockNo = it.StockNo;
                }

                if (!consolidatedItem.itemCode && it.ItemCode) {
                    consolidatedItem.itemCode = it.ItemCode;
                }

                if (!consolidatedItem.technicalDescription &&
                    it.TechnicalDescription) {

                    consolidatedItem.technicalDescription =
                        it.TechnicalDescription;
                }

                if ((!consolidatedItem.setLotItems ||
                    consolidatedItem.setLotItems.length === 0) &&
                    it.SetLotItems &&
                    it.SetLotItems.length > 0) {

                    consolidatedItem.setLotItems =
                        JSON.parse(JSON.stringify(it.SetLotItems));
                }
            });

            /*
             * ============================================================
             * CONVERT MAP TO ARRAY
             * ============================================================
             */
            grp.items = Object.keys(consolidated).map(function (key, index) {

                var item = consolidated[key];
                var savedItem = existingItems.find(function (existing) {
                    return existing.id === item.id || ((existing.PPMPCode || existing.ppmpCode || "").toUpperCase() + "|" +
                        (existing.description || "").toUpperCase()) === key;
                });

                if (savedItem) {
                    ["itemNo", "itemCodeId", "itemCode", "psType", "article", "gsoCategory", "category", "account",
                        "subAccount", "stockNo", "description", "technicalDescription", "unit", "unitCost",
                        "attributes", "additionalSpecs", "setLotItems"].forEach(function (fieldName) {
                            if (savedItem[fieldName] !== undefined && savedItem[fieldName] !== null) {
                                item[fieldName] = savedItem[fieldName];
                            }
                        });
                }

                item.itemNo = item.itemNo || (index + 1);

                /*
                 * Consolidated PO quantity × unit cost.
                 */
                item.totalCost =
                    item.qty * item.unitCost;

                return item;
            });

            var sourceSummary = getStep3GroupSourceSummary(grp);
            var currentPlaceOfDelivery = $.trim(grp.placeOfDelivery || "");
            if (sourceSummary.departments &&
                (!currentPlaceOfDelivery || currentPlaceOfDelivery === "General Services Office (GSO) Warehouse")) {
                grp.placeOfDelivery = sourceSummary.departments;
            }
        });

        /*
         * ================================================================
         * CONTINUE USING YOUR ORIGINAL STEP 3 DESIGN
         * ================================================================
         */
        if (activeStep3GroupIndex >= poGroups.length) {
            activeStep3GroupIndex = 0;
        }

        renderStep3GroupTabs();
        loadActiveGroupForm();
    }


    function getStep3GroupSourceSummary(group) {
        var sourcesByPrNumber = {};

        $.each((group && group.items) || [], function (_, item) {
            $.each(item.sourcePRs || [], function (_, source) {
                var prNumber = $.trim(source.prNo || source.PRNumber || "");
                var department = $.trim(source.requestingDepartment || source.DepartmentName || source.Department || "");
                if (!prNumber) return;

                if (!sourcesByPrNumber[prNumber]) {
                    sourcesByPrNumber[prNumber] = {
                        prNumber: prNumber,
                        department: department
                    };
                } else if (!sourcesByPrNumber[prNumber].department && department) {
                    sourcesByPrNumber[prNumber].department = department;
                }
            });
        });

        var sources = Object.keys(sourcesByPrNumber).map(function (key) {
            return sourcesByPrNumber[key];
        }).sort(function (left, right) {
            return left.prNumber.localeCompare(right.prNumber, undefined, {
                numeric: true,
                sensitivity: "base"
            });
        });

        return {
            prNumbers: sources.map(function (source) { return source.prNumber; }).join(", "),
            departments: sources.map(function (source) { return source.department || "Department not specified"; }).join(" / ")
        };
    }


    function getStep3ItemMissingFields(item) {
        if (!item) return [{ field: "item", itemId: null }];
        var itemCodeId = item.itemCodeId || item.ItemCodeId;
        var ppmpCode = item.PPMPCode || item.ppmpCode || item.PpmpCode;
        var description = item.description || item.Description;
        var stockNo = item.stockNo || item.StockNo;
        var unit = item.unit || item.Unit;
        var quantity = item.qty != null ? item.qty : item.Quantity;
        var unitCost = item.unitCost != null ? item.unitCost : item.UnitCost;

        var missing = [];
        if (!itemCodeId) missing.push({ field: "article", itemId: item.id });
        if (!$.trim(ppmpCode || "")) missing.push({ field: "PPMPCode", itemId: item.id });
        if (!$.trim(description || "")) missing.push({ field: "description", itemId: item.id });
        if (!$.trim(stockNo || "")) missing.push({ field: "stockNo", itemId: item.id });
        if (!$.trim(unit || "")) missing.push({ field: "unit", itemId: item.id });
        if (!(Number(quantity) > 0)) missing.push({ field: "quantity", itemId: item.id });
        if (!(Number(unitCost) >= 0)) missing.push({ field: "unitCost", itemId: item.id });
        return missing;
    }

    function getStep3GroupMissingFields(group) {
        var missing = [];
        if (!group) return missing;
        if (!group.items || !group.items.length) {
            missing.push({ field: "items", selector: "#step3ItemsAccordionContainer" });
        }
        $.each(group.items || [], function (_, item) {
            missing = missing.concat(getStep3ItemMissingFields(item));
        });
        return missing;
    }

    function isStep3ItemComplete(item) {
        return getStep3ItemMissingFields(item).length === 0;
    }

    function focusStep3Control(selector) {
        var element = $(selector);
        if (!element.length) return false;
        var widget = element.data("kendoMultiColumnComboBox") || element.data("kendoComboBox") || element.data("kendoDropDownList");
        var focusTarget = widget && widget.input ? widget.input : element;
        focusTarget.focus();
        var wrapper = widget && widget.wrapper ? widget.wrapper : element;
        wrapper.addClass("step3-missing-field-focus");
        setTimeout(function () { wrapper.removeClass("step3-missing-field-focus"); }, 1800);
        return true;
    }

    function focusFirstStep3MissingField(groupIndex, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        var group = poGroups[groupIndex];
        var missing = getStep3GroupMissingFields(group);
        if (!missing.length) return;

        activeStep3GroupIndex = groupIndex;
        var first = missing[0];
        renderStep3GroupTabs();
        loadActiveGroupForm();

        setTimeout(function () {
            if (first.selector && focusStep3Control(first.selector)) return;
            if (first.field === "article" && focusStep3Control("#step3Article_" + first.itemId)) return;
            if (focusStep3Control("#accordionItem_" + first.itemId + " [data-step3-item-field='" + first.field + "']")) return;
            var card = $("#accordionItem_" + first.itemId);
            if (card.length) {
                card.attr("tabindex", "-1").focus().addClass("step3-missing-field-focus");
                setTimeout(function () { card.removeClass("step3-missing-field-focus"); }, 1800);
            }
        }, 150);
    }

    // Render group tabs with real-time Complete vs Needs Info badges
    function renderStep3GroupTabs() {
        var tabsContainer = $("#step3GroupTabsNav");
        tabsContainer.empty();

        poGroups.forEach(function (grp, index) {
            var isActive = index === activeStep3GroupIndex;
            var sourceSummary = getStep3GroupSourceSummary(grp);
            var missingFields = getStep3GroupMissingFields(grp);
            var isComplete = grp.items && grp.items.length > 0 && missingFields.length === 0;

            var badgeHtml = isComplete
                ? '<span class="tab-badge-complete" style="background: #dcfce7; color: #166534; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">Complete</span>'
                : '<span class="tab-badge-incomplete" role="button" tabindex="0" title="Go to the first field that needs information" onclick="focusFirstStep3MissingField(' + index + ', event)" onkeydown="if(event.key === \'Enter\' || event.key === \' \') focusFirstStep3MissingField(' + index + ', event)" style="background: #fef3c7; color: #92400e; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-left: 6px; cursor: pointer; white-space: nowrap;">Needs Info (' + missingFields.length + ')</span>';

            var activeClass = isActive ? ' active' : '';

            var tabBtn = $('<button type="button" class="step3-tab-btn' + activeClass + '" onclick="selectStep3Group(' + index + ')" style="padding: 8px 12px; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 6px 6px 0 0; cursor: pointer; margin-right: 4px; display: inline-flex; align-items: flex-start; gap: 6px;">' +
                '<span class="step3-tab-copy" style="display: inline-flex; flex-direction: column; align-items: flex-start; gap: 1px; text-align: left;">' +
                '<strong>' + escapeStep3Html(grp.groupName) + '</strong>' +
                '<small><span>PR Number:</span> ' + escapeStep3Html(sourceSummary.prNumbers || "Not available") + '</small>' +
                '<small><span>Department:</span> ' + escapeStep3Html(sourceSummary.departments || "Not available") + '</small>' +
                '</span>' + badgeHtml +
                '</button>');

            tabsContainer.append(tabBtn);
        });
    }

    // Switch active group
    function selectStep3Group(index) {
        activeStep3GroupIndex = index;
        renderStep3GroupTabs();
        loadActiveGroupForm();
    }

    // Load active group into form inputs and render items
    function loadActiveGroupForm() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        if (!activeGroup) return;

        var supplierCombo = $("#Step3SupplierDropdown").data("kendoMultiColumnComboBox");
        if (supplierCombo) {
            supplierCombo.value(activeGroup.supplierId || "");
            if (activeGroup.supplierId && activeGroup.supplierName) {
                supplierCombo.text(activeGroup.supplierName);
                supplierCombo.input.val(activeGroup.supplierName);
            }
        }

        var procCombo = $("#Step3ProcurementMode").data("kendoMultiColumnComboBox");
        if (procCombo) {
            procCombo.value(activeGroup.modeOfProcurement || "");
        }

        $("#txtStep3SupBusiness").val(activeGroup.supBusiness || "");
        $("#txtStep3SupTIN").val(activeGroup.supTIN || "");
        $("#txtStep3SupAddress").val(activeGroup.supAddress || "");
        $("#txtStep3SupEmail").val(activeGroup.supEmail || "");
        $("#txtStep3SupContactNo").val(activeGroup.supContactNo || "");
        $("#txtStep3SupZipCode").val(activeGroup.supZipCode || "");
        $("#txtStep3PlaceOfDelivery").val(activeGroup.placeOfDelivery || "");
        $("#txtStep3DeliveryDate").val(activeGroup.deliveryDate || activeGroup.deliveryPeriodDays || "");
        $("#txtStep3SignedBySuppName").val(activeGroup.signedBySuppName || "");
        $("#txtStep3SignedByAuthName").val(activeGroup.signedByAuthName || "");
        $("#txtStep3SignedByAuthDesignation").val(activeGroup.signedByAuthDesignation || "");
        $("#txtStep3ResoNo").val(activeGroup.resoNo || "");
        $("#txtStep3CertifiedCorrectBy").val(activeGroup.certifiedCorrectBy || "");

        var deliveryCombo = $("#Step3DeliveryTerm").data("kendoMultiColumnComboBox");
        if (deliveryCombo) deliveryCombo.value(activeGroup.termDelivery || "");
        var paymentCombo = $("#Step3PaymentTerms").data("kendoMultiColumnComboBox");
        if (paymentCombo) paymentCombo.value(activeGroup.paymentTerms || "");
        var suppDate = $("#Step3SignedBySuppDate").data("kendoDatePicker");
        if (suppDate) suppDate.value(activeGroup.signedBySuppDate ? new Date(activeGroup.signedBySuppDate) : null);
        var certifiedDate = $("#Step3CertifiedCorrectDate").data("kendoDatePicker");
        if (certifiedDate) certifiedDate.value(activeGroup.certifiedCorrectDate ? new Date(activeGroup.certifiedCorrectDate) : null);

        // Update Metric Banner
        $("#lblActiveGroupSupplierName").text(activeGroup.supplierName || "Supplier not selected");
        $("#lblActiveGroupItemsCount").text((activeGroup.items ? activeGroup.items.length : 0) + " Items");

        var total = 0;
        if (activeGroup.items) {
            activeGroup.items.forEach(function (it) {
                total += (it.qty * it.unitCost);
            });
        }
        $("#lblActiveGroupTotalAmount").text(formatStep3Currency(total));

        // Render accordion items
        renderStep3AccordionItems();
    }

    function setStep3GroupField(field, value) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp) return;
        grp[field] = value;
        renderStep3GroupTabs();
        scheduleWizardAutoSave();
    }

    function getStep3SupplierFilter() {
        var combo = $("#Step3SupplierDropdown").data("kendoMultiColumnComboBox");
        return { text: combo ? (combo.text() || combo.value() || "") : "" };
    }

    function onStep3SupplierSelect(e) {
        var grp = poGroups[activeStep3GroupIndex];
        var supplier = e.dataItem;
        if (!grp || !supplier) return;
        grp.supplierId = supplier.Id;
        grp.supplierName = supplier.Name || "";
        grp.supBusiness = supplier.BusinessName || "";
        grp.supAddress = supplier.Address || "";
        grp.supTIN = supplier.TIN || "";
        grp.supZipCode = supplier.ZipCode || "";
        grp.supEmail = supplier.Email || "";
        grp.supContactNo = supplier.ContactNos || "";
        $("#txtStep3SupBusiness").val(grp.supBusiness);
        $("#txtStep3SupAddress").val(grp.supAddress);
        $("#txtStep3SupTIN").val(grp.supTIN);
        $("#txtStep3SupZipCode").val(grp.supZipCode);
        $("#txtStep3SupEmail").val(grp.supEmail);
        $("#txtStep3SupContactNo").val(grp.supContactNo);
        $("#lblActiveGroupSupplierName").text(grp.supplierName || "Supplier not selected");

        setStep3GroupField("modeOfProcurement", e.sender.value());
    }

    function onStep3DeliveryTermWidgetChange(e) {
        setStep3GroupField("termDelivery", e.sender.value());
    }

    function onStep3PaymentTermsWidgetChange(e) {
        setStep3GroupField("paymentTerms", e.sender.value());
    }

    function onStep3SignedBySuppDateChange(e) {
        setStep3GroupField("signedBySuppDate", e.sender.value());
    }

    function onStep3CertifiedCorrectDateChange(e) {
        setStep3GroupField("certifiedCorrectDate", e.sender.value());

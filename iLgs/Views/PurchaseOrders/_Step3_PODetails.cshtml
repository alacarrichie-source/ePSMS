    // Accordion interaction functions
    function toggleAccordionItem(itemId) {
        expandedStep3ItemId = (expandedStep3ItemId === itemId) ? null : itemId;
        renderStep3AccordionItems();
    }

    function openStep3AllocationModal(stockNo, description) {
        $("#modalAllocStockNo").text(stockNo);
        $("#modalAllocItemDesc").text(decodeURIComponent(description));
        var win = $("#step3AllocationModalWindow").data("kendoWindow");
        if (win) win.center().open();
    }

    function closeStep3AllocationModal() {
        var win = $("#step3AllocationModalWindow").data("kendoWindow");
        if (win) win.close();
    }

    function onItemGSOCategoryChange(itemId, newCategory) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            item.gsoCategory = newCategory;
            renderStep3AccordionItems();
        }
    }

    function onItemTechDescChange(itemId, newDesc) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) item.technicalDescription = newDesc;
    }

    function escapeStep3Html(value) {
        return $("<div/>").text(value == null ? "" : value).html();
    }

    function escapeStep3Attribute(value) {
        return escapeStep3Html(value).replace(/"/g, "&quot;");
    }

    function findStep3Item(itemId) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return null;
        return grp.items.find(function (item) { return item.id === itemId; });
    }

    function onStep3ItemFieldChange(itemId, field, value) {
        var item = findStep3Item(itemId);
        if (!item) return;
        item[field] = value;
        if (field === "description") {
            $("#accordionItem_" + itemId + " .step3-item-heading").text(value);
        }
        renderStep3GroupTabs();
        scheduleWizardAutoSave();
    }

    function onStep3ItemNumberChange(itemId, field, value) {
        var item = findStep3Item(itemId);
        if (!item) return;
        item[field] = Number(value || 0);
        item.totalCost = Number(item.qty || 0) * Number(item.unitCost || 0);
        renderStep3AccordionItems();
        renderStep3GroupTabs();
        scheduleWizardAutoSave();
    }

    function getStep3ItemLookupData(item) {
        return function () {
            var combo = $("#step3Article_" + item.id).data("kendoMultiColumnComboBox");
            return {
                text: combo ? (combo.text() || combo.value() || "") : "",
                ppmpCode: item.PPMPCode || "",
                refDate: kendo.toString(kendo.parseDate(poGroups[activeStep3GroupIndex].poDate || new Date()), "MM/dd/yyyy")
            };
        };
    }

    function initializeStep3ItemWidgets(item) {
        var articleElement = $("#step3Article_" + item.id);
        articleElement.kendoMultiColumnComboBox({
            dataTextField: "Article",
            dataValueField: "Id",
            valuePrimitive: true,
            filter: "contains",
            placeholder: "Select Article",
            columns: [
                { field: "Category", title: "Category", width: 120 },
                { field: "Code", title: "Code", width: 110 },
                { field: "TypeDesc", title: "Account", width: 180 },
                { field: "SubAccount1", title: "Sub-Account1", width: 160 },
                { field: "SubAccount2", title: "Sub-Account2", width: 160 },
                { field: "SubAccount3", title: "Sub-Account3", width: 140 },
                { field: "SubAccount4", title: "Sub-Account4", width: 140 },
                { field: "Article", title: "Article", width: 200 }
            ],
            dataSource: {
                serverFiltering: true,
                transport: { read: { url: "@Url.Action("GetPpmpItemAccounts", "ItemHelper")", dataType: "json", data: getStep3ItemLookupData(item) } }
            },
            select: function (e) {
                var selected = this.dataItem(e.item);
                if (!selected) return;
                item.itemCodeId = selected.Id;
                item.itemCode = selected.Code || "";
                item.psType = selected.Type || "";
                item.article = selected.Article || "";
                item.gsoCategory = item.article;
                item.category = selected.Category || "";
                item.account = selected.TypeDesc || "";
                item.subAccount = selected.MainDesc || "";
                setTimeout(renderStep3AccordionItems, 0);
                renderStep3GroupTabs();
                scheduleWizardAutoSave();
            },
            change: function () {
                if (!this.value()) {
                    item.itemCodeId = null;
                    item.article = "";
                    item.gsoCategory = "";
                    renderStep3GroupTabs();
                    scheduleWizardAutoSave();
                }
            }
        });
        var articleCombo = articleElement.data("kendoMultiColumnComboBox");
        articleCombo.value(item.itemCodeId || "");
        if (item.article) articleCombo.text(item.article);

        var unitElement = $("#step3Unit_" + item.id);
        if (unitElement.length) {
            unitElement.kendoMultiColumnComboBox({
            dataTextField: "Code",
            dataValueField: "Code",
            valuePrimitive: true,
            filter: "contains",
            placeholder: "Select unit",
            columns: [
                { field: "Code", title: "Code", width: 90 },
                { field: "Description", title: "Description", width: 180 },
                { field: "Desc2", title: "Category", width: 160 }
            ],
            dataSource: { serverFiltering: true, transport: { read: { url: "@Url.Action("GetUnitInd", "Getters")", dataType: "json" } } },
            change: function () {
                item.unit = this.value() || "";
                renderStep3GroupTabs();
                scheduleWizardAutoSave();
            }
            });
            unitElement.data("kendoMultiColumnComboBox").value(item.unit || "");
        }
        loadStep3AdditionalSpecs(item);
    }

    function getStep3SpecPrefix(itemId) {
        return "WizardSpecs_" + String(itemId || "").replace(/[^A-Za-z0-9_]/g, "_");
    }

    function captureStep3AdditionalSpecs(itemId) {
        var item = findStep3Item(itemId);
        var container = $("#step3AdditionalSpecs_" + itemId);
        if (!item || !container.length) return;
        item.additionalSpecs = item.additionalSpecs || {};
        container.find(":input[name]").each(function () {
            var name = this.name || "";
            var marker = ".AllField.";
            var markerIndex = name.indexOf(marker);
            if (markerIndex < 0) return;
            var fieldName = name.substring(markerIndex + marker.length);
            var value = $(this).is(":checkbox") ? $(this).is(":checked") : $(this).val();
            item.additionalSpecs[fieldName] = value == null ? "" : String(value);
        });
        scheduleWizardAutoSave();
    }

    function restoreStep3AdditionalSpecs(item) {
        var container = $("#step3AdditionalSpecs_" + item.id);
        var specs = item.additionalSpecs || {};
        Object.keys(specs).forEach(function (fieldName) {
            var control = container.find("[name$='.AllField." + fieldName + "']");
            if (!control.length) return;
            if (control.is(":checkbox")) control.prop("checked", specs[fieldName] === true || specs[fieldName] === "true");
            else control.val(specs[fieldName]);
            var widget = kendo.widgetInstance(control);
            if (widget && widget.value) widget.value(specs[fieldName]);
        });
    }

    function loadStep3AdditionalSpecs(item) {
        var container = $("#step3AdditionalSpecs_" + item.id);
        if (!container.length) return;
        if (!item.itemCodeId) {
            container.html('<div class="wizard-empty-state">Select an Article to load its additional specification fields.</div>');
            return;
        }

        kendo.ui.progress(container, true);
        $.ajax({
            url: "@Url.Action("LoadFields", "Orders")",
            type: "POST",
            data: {
                Id: item.id,
                ItemCodeId: item.itemCodeId,
                fieldPrefix: getStep3SpecPrefix(item.id)
            }
        }).done(function (html) {
            if (!$.trim(html || "")) {
                container.html('<div class="wizard-empty-state">No additional specification fields are configured for this Article.</div>');
                return;
            }
            container.html(html);
            restoreStep3AdditionalSpecs(item);
            container.off("change.step3Specs").on("change.step3Specs", ":input", function () {
                captureStep3AdditionalSpecs(item.id);
                refreshStep3StockNumber(item.id);
            });
            refreshStep3StockNumber(item.id);
        }).fail(function () {
            container.html('<div class="wizard-error-state">Additional specification fields could not be loaded.</div>');
        }).always(function () {
            kendo.ui.progress(container, false);
        });
    }

    function UpdateDescription(e) {
        var element = e && e.sender && e.sender.element ? e.sender.element : $(e && e.target);
        var container = element.closest(".step3-dynamic-specs");
        if (!container.length) return;
        var itemId = container.data("item-id");
        captureStep3AdditionalSpecs(itemId);
        refreshStep3StockNumber(itemId);
    }

    function refreshStep3StockNumber(itemId) {
        var item = findStep3Item(itemId);
        if (!item || !item.itemCodeId || !item.itemCode) return;

        clearTimeout(step3StockNumberTimers[itemId]);
        step3StockNumberTimers[itemId] = setTimeout(function () {
            var requestData = {
                Id: item.id,
                ItemCodeId: item.itemCodeId,
                ItemCode: item.itemCode,
                PsType: item.psType || "",
                PpmpCode: item.PPMPCode || "",
                Description: item.description || "",
                Unit: item.unit || "",
                Qty: Number(item.qty || 0),
                UnitCost: Number(item.unitCost || 0)
            };
            $.each(item.additionalSpecs || {}, function (fieldName, value) {
                requestData["AllField." + fieldName] = value;
            });

            var container = $("#step3AdditionalSpecs_" + itemId);
            kendo.ui.progress(container, true);
            $.ajax({
                url: "@Url.Action("GetDescription", "Orders")",
                type: "POST",
                data: requestData
            }).done(function (result) {
                if (!result || result.StockNo == null) return;
                item.stockNo = result.StockNo;
                $("#accordionItem_" + itemId)
                    .find("[data-step3-item-field='stockNo']")
                    .val(item.stockNo);
                $("#accordionItem_" + itemId)
                    .find(".step3-item-stock-number")
                    .text(item.stockNo || item.itemCode || "");
                renderStep3GroupTabs();
                scheduleWizardAutoSave();
            }).fail(function () {
                showWizardMessage("The Stock/Property No. could not be refreshed.");
            }).always(function () {
                kendo.ui.progress(container, false);
            });
        }, 250);
    }

    function onItemAttributeChange(itemId, key, value) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            if (!item.attributes) item.attributes = {};
            item.attributes[key] = value;
        }
    }

    function onAddSubItem(itemId) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp || !grp.items) return;
        var item = grp.items.find(function (i) { return i.id === itemId; });
        if (item) {
            if (!item.setLotItems) item.setLotItems = [];
            item.setLotItems.push({ description: "New Component Sub-Item", qty: 1, unit: "pc" });
            renderStep3AccordionItems();
        }
    }

    // Render Line Items Accordion
    function renderStep3AccordionItems() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        var container = $("#step3ItemsAccordionContainer");
        container.empty();

        if (!activeGroup || !activeGroup.items || activeGroup.items.length === 0) {
            container.html('<div style="background: #fff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 24px; text-align: center; color: #64748b; font-size: 12px;">No line items assigned to this PO group yet. Return to Step 2 to assign items.</div>');
            return;
        }

        activeGroup.items.forEach(function (item, index) {
            var isExpanded = (expandedStep3ItemId === item.id) || (expandedStep3ItemId === null);
            var subtotal = item.qty * item.unitCost;

@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="epsms-procurement po-wizard">
    <div class="wizard-card">
        <!-- Step Header -->
        <div class="wizard-card-header">
            <div class="wizard-header-content">
                <h2 class="page-title text-navy">Step 3: Purchase Order Details</h2>
                <p class="page-subtitle">Review consolidated items and finalize PO header details per supplier group.</p>
            </div>
        </div>

        <!-- PO Group Tabs Navigation -->
        <div class="step3-group-tabs" id="step3GroupTabsNav">
            <!-- Dynamically rendered tabs -->
        </div>

        <!-- Main Split Form Layout -->
        @*<div class="step3-split-layout form-grid" id="step3SplitLayoutContainer">*@
        <div class="step3-split-layout form-grid" id="step3SplitLayoutContainer" style="display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 16px; align-items: start; width: 100%;">
            <!-- Left Column: Header Details & Delivery Terms Cards -->
            <div class="step3-left-col">
                <!-- Header Details Card -->
                <div class="step3-card group-card">
                    <div class="group-title text-navy">
                        <span class="k-icon k-i-user" style="color: #115cb9;"></span>
                        Header Details
                    </div>

                    <div class="form-field-wide" style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                        <div class="form-field">
                            <label>PO No.</label>
                            <input type="text" disabled value="(Auto-generated on posting)" class="form-control-custom" style="background: #f1f5f9; font-family: monospace; color: #64748b;" />
                        </div>

                        <div class="form-field">
                            <label>
                                PO Date <span class="required-marker">*</span>
                            </label>
                            @(Html.Kendo().DatePicker()
                                .Name("Step3PODate")
                                .Value(DateTime.Now)
                                .Format("yyyy-MM-dd")
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3PODateChange(this.value)" })
                            )
                        </div>

                        <div class="form-field">
                            <label>
                                Supplier <span class="required-marker">*</span>
                            </label>
                            @(Html.Kendo().DropDownList()
                                .Name("Step3SupplierDropdown")
                                .DataTextField("Name")
                                .DataValueField("Id")
                                .OptionLabel("-- Select PhilGEPS Supplier --")
                                .DataSource(source => source
                                    .Read(read => read.Action("GetSuppliersDropdown", "PurchaseOrders"))
                                )
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3SupplierChange(this.value)" })
                            )
                        </div>

                        <div class="form-field">
                            <label>Mode of Procurement</label>
                            @(Html.Kendo().DropDownList()
                                .Name("Step3ProcurementMode")
                                .BindTo(new[] { "Public Bidding", "Shopping (Sec 52.1b)", "Direct Contracting", "Small Value Procurement (Sec 53.9)" })
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3ProcurementModeChange(this.value)" })
                            )
                        </div>
                    </div>
                </div>

                <!-- Delivery & Payment Terms Card -->
                <div class="step3-card group-card" style="margin-top: 16px;">
                    <div class="group-title text-navy">
                        <span class="k-icon k-i-cart" style="color: #115cb9;"></span>
                        Delivery &amp; Payment Terms
                    </div>

                    <div class="form-field-wide" style="display: flex; flex-direction: column; gap: 12px; margin-top: 12px;">
                        <div class="form-field">
                            <label>
                                Delivery Period (Calendar Days) <span class="required-marker">*</span>
                            </label>
                            @(Html.Kendo().NumericTextBox<int>()
                                .Name("Step3DeliveryPeriod")
                                .Min(1)
                                .Max(365)
                                .Format("n0")
                                .Decimals(0)
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3DeliveryPeriodChange(this.value)" })
                            )
                        </div>

                        <div class="form-field">
                            <label>
                                Place of Delivery <span class="required-marker">*</span>
                            </label>
                            <input type="text" id="txtStep3PlaceOfDelivery" class="form-control-custom" placeholder="e.g. Main Warehouse, Building A" onchange="onStep3PlaceOfDeliveryChange(this.value)" onkeyup="onStep3PlaceOfDeliveryChange(this.value)" />
                        </div>

                        <div class="form-field">
                            <label>
                                Payment Terms <span class="required-marker">*</span>
                            </label>
                            @(Html.Kendo().DropDownList()
                                .Name("Step3PaymentTerms")
                                .BindTo(new[] { "30 Days", "15 Days", "Cash on Delivery", "Progress Billing" })
                                .HtmlAttributes(new { style = "width: 100%;", onchange = "onStep3PaymentTermsChange(this.value)" })
                            )
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Metric Banner & Consolidated Line Items Accordion -->
            <div class="step3-right-col">
                <!-- Metric Banner -->
                <div class="step3-metric-banner group-card" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div style="display: flex; align-items: center; gap: 20px;">
                        <div>
                            <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Assigned Supplier</span>
                            <span id="lblActiveGroupSupplierName" class="text-navy" style="font-weight: 700; font-size: 12px;">Mega Office Supplies Inc.</span>
                        </div>
                        <div style="height: 32px; width: 1px; background-color: #cbd5e1;"></div>
                        <div>
                            <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Consolidated Items</span>
                            <span id="lblActiveGroupItemsCount" class="text-navy" style="font-weight: 700; font-size: 12px;">0 Items</span>
                        </div>
                    </div>

                    <div style="text-align: right;">
                        <span style="font-size: 10px; text-transform: uppercase; font-weight: 700; color: #64748b; display: block;">Total Group Amount</span>
                        <span id="lblActiveGroupTotalAmount" class="total-amount text-success-bold" style="font-size: 15px;">PHP 0.00</span>
                    </div>
                </div>

                <!-- Consolidated Line Items Accordion Container -->
                <div id="step3ItemsAccordionContainer">
                    <!-- Dynamically rendered line items -->
                </div>
            </div>
        </div>

        <!-- Stock Allocation Breakdown Modal Window -->
        @(Html.Kendo().Window()
            .Name("step3AllocationModalWindow")
            .Title("Stock Allocation Breakdown")
            .Width(620)
            .Modal(true)
            .Visible(false)
            .Actions(actions => actions.Close())
            .Content(@<text>
                <div class="po-details-modal">
                    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 12px; margin-bottom: 16px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                            <span class="text-slate" style="font-weight: 600;">Stock No:</span>
                            <strong id="modalAllocStockNo" class="text-navy" style="font-family: monospace;">STK-GEN-001</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span class="text-slate" style="font-weight: 600;">Item:</span>
                            <strong id="modalAllocItemDesc" class="text-navy">Multipurpose Paper A4</strong>
                        </div>
                    </div>

                    <h4 class="text-navy" style="font-size: 12px; font-weight: 700; margin-bottom: 8px;">Department / Cost Center Allocation</h4>
                    <div class="wizard-table-container">
                        <table class="items-table" style="width: 100%; margin-bottom: 16px;">
                            <thead>
                                <tr>
                                    <th>Department / Office</th>
                                    <th>Cost Center</th>
                                    <th style="text-align: center;">Allocated Qty</th>
                                    <th>Delivery Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Mayor's Office - Executive</strong></td>
                                    <td class="text-slate" style="font-family: monospace;">CC-1011</td>
                                    <td class="text-navy" style="text-align: center; font-family: monospace; font-weight: bold;">40%</td>
                                    <td>City Hall, Executive Wing</td>
                                </tr>
                                <tr>
                                    <td><strong>Accounting Office</strong></td>
                                    <td class="text-slate" style="font-family: monospace;">CC-1020</td>
                                    <td class="text-navy" style="text-align: center; font-family: monospace; font-weight: bold;">30%</td>
                                    <td>Finance Bldg, 2nd Flr</td>
                                </tr>
                                <tr>
                                    <td><strong>General Services Office (GSO)</strong></td>
                                    <td class="text-slate" style="font-family: monospace;">CC-1035</td>
                                    <td class="text-navy" style="text-align: center; font-family: monospace; font-weight: bold;">30%</td>
                                    <td>Main Supply Depot</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div style="display: flex; justify-content: flex-end; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                        @(Html.Kendo().Button()
                            .Name("btnCloseAllocModal")
                            .ThemeColor(ThemeColor.Primary)
                            .Content("Close Breakdown")
                            .HtmlAttributes(new { onclick = "closeStep3AllocationModal()", @class = "btn-procurement-primary" })
                        )
                    </div>
                </div>
            </text>)
        )

        <!-- Navigation Action Bar -->
        <div class="wizard-summary-bar">
            <div class="wizard-action-group" style="width: 100%; justify-content: space-between;">
                @(Html.Kendo().Button()
                    .Name("btnStep3Back")
                    .FillMode(ButtonFillMode.Outline)
                    .Content("&larr; Back to Assign Items")
                    .HtmlAttributes(new { onclick = "goToWizardStep(2)", @class = "btn-procurement-secondary" })
                )
                @(Html.Kendo().Button()
                    .Name("btnStep3Next")
                    .ThemeColor(ThemeColor.Primary)
                    .Content("Next: Review & Post &rarr;")
                    .HtmlAttributes(new { onclick = "goToWizardStep(4)", @class = "btn-procurement-primary" })
                )
            </div>
        </div>
    </div>
</div>

<script>
    var activeStep3GroupIndex = 0;
    var expandedStep3ItemId = null;

    var GSO_CATEGORIES_LIST = [
        'Office Supplies',
        'IT Equipment',
        'Janitorial Supplies',
        'Furniture & Fixtures',
        'Electrical Supplies',
        'Hardware & Construction',
        'Drugs / Medicine',
        'Vehicle Parts & Maintenance',
        'Food Supplies',
        'General Merchandise'
    ];

    // Format currency in PHP
    function formatStep3Currency(amount) {
        return "PHP " + Number(amount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Called when stepping into Step 3
    function prepareStep3Data() {
        if (!poGroups) poGroups = [];

        poGroups.forEach(function (grp) {
            var groupItems = allocatedItems.filter(function (it) {
                return (it.TargetGroupId || "grp-1") === grp.groupId && (it.AssignedQty > 0);
            });

            grp.items = groupItems.map(function (it, idx) {
                return {
                    id: it.Id || ("li-" + (idx + 1)),
                    itemNo: idx + 1,
                    description: it.Description,
                    stockNo: it.StockNo || ("STK-00" + (idx + 1)),
                    itemCode: "ITM-00" + (idx + 1),
                    qty: it.AssignedQty || it.RequestedQty,
                    unit: it.Unit || "pc",
                    unitCost: it.UnitCost || 0,
                    totalCost: (it.AssignedQty || it.RequestedQty) * (it.UnitCost || 0),
                    gsoCategory: it.GSOCategory || "Office Supplies",
                    technicalDescription: it.TechnicalDescription || "Government standard specification compliant.",
                    attributes: it.Attributes || { Brand: "Generic", Origin: "Local" },
                    setLotItems: it.SetLotItems ? JSON.parse(JSON.stringify(it.SetLotItems)) : []
                };
            });
        });

        if (activeStep3GroupIndex >= poGroups.length) {
            activeStep3GroupIndex = 0;
        }

        renderStep3GroupTabs();
        loadActiveGroupForm();
    }

    // Render group tabs
    function renderStep3GroupTabs() {
        var tabsContainer = $("#step3GroupTabsNav");
        tabsContainer.empty();

        poGroups.forEach(function (grp, index) {
            var isActive = index === activeStep3GroupIndex;
            var isComplete = grp.placeOfDelivery && grp.placeOfDelivery.trim().length > 0 && grp.deliveryPeriodDays > 0;

            var badgeHtml = isComplete
                ? '<span class="status-badge text-success-bold">Complete</span>'
                : '<span class="status-badge text-warning-bold">Needs Info</span>';

            var activeClass = isActive ? ' active' : '';

            var tabBtn = $('<button type="button" class="step3-tab-btn' + activeClass + '" onclick="selectStep3Group(' + index + ')">' +
                '<span>' + grp.groupName + '</span> ' + badgeHtml +
                '</button>');

            tabsContainer.append(tabBtn);
        });
    }

    // Switch active group
    function selectStep3Group(index) {
        activeStep3GroupIndex = index;
        renderStep3GroupTabs();
        loadActiveGroupForm();
    }

    // Load active group into form inputs and render items
    function loadActiveGroupForm() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        if (!activeGroup) return;

        // Set DatePicker
        var dp = $("#Step3PODate").data("kendoDatePicker");
        if (dp) {
            dp.value(activeGroup.poDate ? new Date(activeGroup.poDate) : new Date());
        }

        // Set Supplier DropDownList
        var supplierDdl = $("#Step3SupplierDropdown").data("kendoDropDownList");
        if (supplierDdl) {
            supplierDdl.value(activeGroup.supplierId || 1);
        }

        // Set Procurement Mode DropDownList
        var procDdl = $("#Step3ProcurementMode").data("kendoDropDownList");
        if (procDdl) {
            procDdl.value(activeGroup.modeOfProcurement || "Public Bidding");
        }

        // Set Delivery Period NumericTextBox
        var ntb = $("#Step3DeliveryPeriod").data("kendoNumericTextBox");
        if (ntb) {
            ntb.value(activeGroup.deliveryPeriodDays || 30);
        }

        // Set Place of Delivery input
        $("#txtStep3PlaceOfDelivery").val(activeGroup.placeOfDelivery || "Main Warehouse, Building A");

        // Set Payment Terms DropDownList
        var ptDdl = $("#Step3PaymentTerms").data("kendoDropDownList");
        if (ptDdl) {
            ptDdl.value(activeGroup.paymentTerms || "30 Days");
        }

        // Update Metric Banner
        $("#lblActiveGroupSupplierName").text(activeGroup.supplierName || "Mega Office Supplies Inc.");
        $("#lblActiveGroupItemsCount").text((activeGroup.items ? activeGroup.items.length : 0) + " Items");

        var total = 0;
        if (activeGroup.items) {
            activeGroup.items.forEach(function (it) {
                total += (it.qty * it.unitCost);
            });
        }
        $("#lblActiveGroupTotalAmount").text(formatStep3Currency(total));

        // Render accordion items
        renderStep3AccordionItems();
    }

    // Header Details change handlers
    function onStep3PODateChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.poDate = val;
    }

    function onStep3SupplierChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (!grp) return;
        var ddl = $("#Step3SupplierDropdown").data("kendoDropDownList");
        if (ddl) {
            grp.supplierId = val;
            grp.supplierName = ddl.text();
            $("#lblActiveGroupSupplierName").text(grp.supplierName);
        }
    }

    function onStep3ProcurementModeChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.modeOfProcurement = val;
    }

    function onStep3DeliveryPeriodChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) {
            grp.deliveryPeriodDays = parseInt(val, 10) || 30;
            renderStep3GroupTabs();
        }
    }

    function onStep3PlaceOfDeliveryChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) {
            grp.placeOfDelivery = val;
            renderStep3GroupTabs();
        }
    }

    function onStep3PaymentTermsChange(val) {
        var grp = poGroups[activeStep3GroupIndex];
        if (grp) grp.paymentTerms = val;
    }

    // Render Line Items Accordion
    function renderStep3AccordionItems() {
        var activeGroup = poGroups[activeStep3GroupIndex];
        var container = $("#step3ItemsAccordionContainer");
        container.empty();

        if (!activeGroup || !activeGroup.items || activeGroup.items.length === 0) {
            container.html('<div class="group-card text-center text-slate" style="padding: 24px;">No line items assigned to this PO group yet. Return to Step 2 to assign items.</div>');
            return;
        }

        activeGroup.items.forEach(function (item, index) {
            var isExpanded = (expandedStep3ItemId === item.id) || (expandedStep3ItemId === null);
            var subtotal = item.qty * item.unitCost;

            var chevronIcon = isExpanded ? 'k-i-arrow-chevron-up' : 'k-i-arrow-chevron-down';

            var itemCard = $('<div class="step3-accordion-item group-card" style="margin-bottom: 12px;" id="accordionItem_' + item.id + '"></div>');

            // Header
            var headerHtml = '<div class="step3-accordion-header" style="cursor: pointer;" onclick="toggleAccordionItem(\'' + item.id + '\')">' +
                '<div style="display: flex; align-items: center; justify-content: space-between;">' +
                '<div style="display: flex; align-items: center; gap: 12px;">' +
                '<span style="width: 24px; height: 24px; border-radius: 50%; background: #002046; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0;">' + (index + 1) + '</span>' +
                '<div>' +
                '<div class="item-description text-navy">' + item.description + '</div>' +
                '<span class="text-slate" style="font-family: monospace; font-size: 11px;">' + (item.stockNo || item.itemCode) + '</span>' +
                '</div>' +
                '</div>' +
                '<div style="display: flex; align-items: center; gap: 20px; font-size: 12px;">' +
                '<div style="text-align: right;">' +
                '<span class="text-slate" style="font-size: 10px; display: block;">Qty</span>' +
                '<strong style="font-family: monospace;">' + item.qty + ' ' + item.unit + '</strong>' +
                '</div>' +
                '<div style="text-align: right;">' +
                '<span class="text-slate" style="font-size: 10px; display: block;">Unit Cost</span>' +
                '<span class="text-slate" style="font-family: monospace;">' + formatStep3Currency(item.unitCost) + '</span>' +
                '</div>' +
                '<div style="text-align: right;">' +
                '<span class="text-slate" style="font-size: 10px; display: block;">Total</span>' +
                '<strong class="text-success-bold" style="font-family: monospace;">' + formatStep3Currency(subtotal) + '</strong>' +
                '</div>' +
                '<span class="k-icon ' + chevronIcon + ' text-slate"></span>' +
                '</div>' +
                '</div>' +
                '</div>';

            itemCard.append(headerHtml);

            // Body (if expanded)
            if (isExpanded) {
                var body = $('<div class="step3-accordion-body" style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e2e8f0;"></div>');

                // Left Sub-Panel: Category, Tech Specs, Stock No. & Allocation
                var catOptionsHtml = '';
                GSO_CATEGORIES_LIST.forEach(function (cat) {
                    var isSelected = (item.gsoCategory === cat) ? ' selected="selected"' : '';
                    catOptionsHtml += '<option value="' + cat + '"' + isSelected + '>' + cat + '</option>';
                });

                var leftSubPanel = $('<div style="display: flex; flex-direction: column; gap: 12px;">' +
                    '<div class="form-field">' +
                    '<label>GSO Category <span class="required-marker">*</span></label>' +
                    '<select class="form-control-custom" style="padding: 6px;" onchange="onItemGSOCategoryChange(\'' + item.id + '\', this.value)">' +
                    catOptionsHtml +
                    '</select>' +
                    '</div>' +
                    '<div class="form-field">' +
                    '<label>Technical Description</label>' +
                    '<textarea rows="3" class="form-control-custom" style="resize: none;" placeholder="Detailed government specifications..." onchange="onItemTechDescChange(\'' + item.id + '\', this.value)">' + (item.technicalDescription || '') + '</textarea>' +
                    '</div>' +
                    '<div style="display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid #e2e8f0;">' +
                    '<div>' +
                    '<span class="text-slate" style="font-size: 10px; text-transform: uppercase; font-weight: 700; display: block;">Stock Number</span>' +
                    '<strong class="text-navy" style="font-family: monospace; font-size: 12px; display: flex; align-items: center; gap: 4px;">' +
                    '<span class="k-icon k-i-check-circle text-success-bold"></span> ' + (item.stockNo || 'STK-GEN-001') +
                    '</strong>' +
                    '</div>' +
                    '<button type="button" class="btn-procurement-secondary" style="font-size: 11px; padding: 4px 10px;" onclick="openStep3AllocationModal(\'' + (item.stockNo || 'STK-GEN-001') + '\', \'' + encodeURIComponent(item.description) + '\')">' +
                    '<span class="k-icon k-i-inherited"></span> View Allocation' +
                    '</button>' +
                    '</div>' +
                    '</div>');

                // Right Sub-Panel: Dynamic Category Specs & Set/Lot Sub-Items
                var rightSubPanel = $('<div class="sub-items-box"></div>');

                // Dynamic Category Specs Header
                rightSubPanel.append('<h4 class="sub-items-title text-navy">Additional Specs: ' + item.gsoCategory + '</h4>');

                // Category Attributes Inputs
                var attrs = item.attributes || {};
                var attrsGrid = $('<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;"></div>');

                if (item.gsoCategory === 'Office Supplies') {
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Brand</label><input type="text" value="' + (attrs.Brand || 'Double A') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Paper Size</label><input type="text" value="' + (attrs.PaperSize || 'A4') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'PaperSize\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">GSM</label><input type="text" value="' + (attrs.GSM || '80') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'GSM\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Color</label><input type="text" value="' + (attrs.Color || 'White') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Color\', this.value)" /></div>');
                } else if (item.gsoCategory === 'IT Equipment') {
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Brand</label><input type="text" value="' + (attrs.Brand || 'Dell Latitude') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Processor</label><input type="text" value="' + (attrs.Processor || 'Intel Core i7') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Processor\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">RAM</label><input type="text" value="' + (attrs.RAM || '16GB DDR5') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'RAM\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">OS</label><input type="text" value="' + (attrs.OS || 'Windows 11 Pro') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'OS\', this.value)" /></div>');
                } else if (item.gsoCategory === 'Drugs / Medicine') {
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Expiry Date</label><input type="date" value="' + (attrs.ExpiryDate || '2026-12-31') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'ExpiryDate\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">FDA Reg. No.</label><input type="text" value="' + (attrs.FDARegNo || 'DR-XY12345') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'FDARegNo\', this.value)" /></div>');
                } else {
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Brand / Manufacturer</label><input type="text" value="' + (attrs.Brand || 'Standard Government Grade') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Brand\', this.value)" /></div>');
                    attrsGrid.append('<div><label class="text-slate" style="font-size: 10px; display: block;">Warranty / Terms</label><input type="text" value="' + (attrs.Warranty || '1 Year Standard') + '" class="form-control-custom" style="padding: 4px;" onchange="onItemAttributeChange(\'' + item.id + '\', \'Warranty\', this.value)" /></div>');
                }
                rightSubPanel.append(attrsGrid);

                // Set / Lot Sub-Items Section
                var subItemsWrapper = $('<div style="padding-top: 10px; border-top: 1px solid #cbd5e1;"></div>');

                var subItemsCount = (item.setLotItems ? item.setLotItems.length : 0);
                var autoBadgeHtml = subItemsCount > 0
                    ? '<span class="group-badge"><span class="k-icon k-i-hyperlink"></span> Auto-retrieved (' + subItemsCount + ' sub-items)</span>'
                    : '';

                var subItemsHeader = $('<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">' +
                    '<div style="display: flex; align-items: center; gap: 6px;">' +
                    '<span class="sub-items-title">Set / Lot Sub-Items Composition</span>' +
                    autoBadgeHtml +
                    '</div>' +
                    '<button type="button" class="btn-procurement-secondary" style="font-size: 11px; padding: 2px 6px;" onclick="onAddSubItem(\'' + item.id + '\')">' +
                    '<span class="k-icon k-i-plus"></span> Add Sub-Item' +
                    '</button>' +
                    '</div>');
                subItemsWrapper.append(subItemsHeader);

                if (item.setLotItems && item.setLotItems.length > 0) {
                    var subList = $('<div style="max-height: 180px; overflow-y: auto;"></div>');
                    item.setLotItems.forEach(function (sub, sIdx) {
                        var subRow = $('<div class="step3-subitem-row" style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">' +
                            '<div style="display: flex; align-items: center; gap: 6px; flex: 1; min-width: 0;">' +
                            '<span style="font-family: monospace; font-weight: 700; color: #115cb9; font-size: 11px; background: #fff; padding: 2px 6px; border: 1px solid #cbd5e1; border-radius: 4px;">' + (sub.ItemNo || (item.itemNo + '.' + (sIdx + 1))) + '</span>' +
                            '<input type="text" value="' + (sub.ItemName || '') + '" class="form-control-custom" style="flex: 1; padding: 2px 6px; font-size: 11px;" placeholder="Sub-component Name" onchange="onSubItemFieldChange(\'' + item.id + '\', \'' + sub.Id + '\', \'ItemName\', this.value)" />' +
                            '</div>' +
                            '</div>');
                        subList.append(subRow);
                    });
                    subItemsWrapper.append(subList);
                }

                rightSubPanel.append(subItemsWrapper);

                body.append(leftSubPanel);
                body.append(rightSubPanel);
                itemCard.append(body);
            }

            container.append(itemCard);
        });
    }

    function toggleAccordionItem(itemId) {
        if (expandedStep3ItemId === itemId) {
            expandedStep3ItemId = null;
        } else {
            expandedStep3ItemId = itemId;
        }
        renderStep3AccordionItems();
    }
</script>
@using iLgs.Ai.Models

<div class="wizard-card">

    <div class="wizard-card-header">

        <div>
            <h2>Step 2: Assign Items to PO Groups</h2>

            <p class="subtitle">
                Organize PR line items into separate PO Groups without
                prematurely binding suppliers.
            </p>
        </div>

        <div class="wizard-card-actions">

            <button type="button"
                    class="btn-procurement-primary"
                    onclick="addNewPOGroup()">

                <span class="k-icon k-i-plus"></span>
                Add New PO Group

            </button>

        </div>

    </div>


    <!-- ============================================================
         ALLOCATION TABLE
         ============================================================ -->

    <div class="wizard-table-container"
         id="allocationItemsTableContainer">
    </div>


    <!-- ============================================================
         NAVIGATION
         ============================================================ -->

    <div class="wizard-summary-bar">

        <button type="button"
                class="btn-procurement-secondary"
                onclick="goToStep1()">

            <span class="k-icon k-i-arrow-left"></span>
            Back to Step 1

        </button>


        <button type="button"
                class="btn-procurement-primary"
                onclick="goToStep3()">

            Proceed to PO Details
            <span class="k-icon k-i-arrow-right"></span>

        </button>

    </div>

</div>


<script type="text/javascript">

    function addNewPOGroup() {

        var newIndex = poGroups.length + 1;

        var newGroupId = "grp-" + newIndex;


        poGroups.push({

            groupId: newGroupId,

            groupName: "PO Group " + newIndex,

            supplierId: 0,

            poDate: new Date(),

            deliveryPeriodDays: 30,

            placeOfDelivery:
            "General Services Office (GSO) Warehouse",

            paymentTerms:
            "30 Calendar Days upon full acceptance",

            modeOfProcurement:
            "Public Bidding",

            items: [],

            poCopyDoc: null,

            additionalDocs: []

        });


        renderStep2Allocations();
    }


    function renderStep2Allocations() {

        var html =
            '<div class="table-responsive">' +

            '<table class="items-table">' +

            '<thead>' +
            '<tr>' +

            '<th class="col-pr">PR No.</th>' +

            '<th>Description &amp; Specifications</th>' +

            '<th class="col-qty text-center">Req. Qty</th>' +

            '<th class="col-cost text-end">Est. Unit Cost</th>' +

            '<th class="col-group">Assign To PO Group</th>' +

            '</tr>' +

            '</thead>' +

            '<tbody>';


        allocatedItems.forEach(function (item, index) {

            html +=

                '<tr>' +

                '<td>' +
                '<span class="group-badge">' +
                item.PRNumber +
                '</span>' +
                '</td>' +

                '<td>' +

                '<div class="item-description">' +
                escapeWizardHtml(item.Description) +
                '</div>' +

                (
                    item.TechnicalDescription
                        ?
                        '<div class="item-technical-description">' +
                        escapeWizardHtml(
                            item.TechnicalDescription
                        ) +
                        '</div>'
                        :
                        ''
                ) +

                '</td>' +

                '<td class="text-center">' +
                item.RequestedQty +
                ' ' +
                escapeWizardHtml(item.Unit) +
                '</td>' +

                '<td class="text-end">' +
                'PHP ' +
                Number(item.UnitCost).toFixed(2) +
                '</td>' +

                '<td>' +

                '<select class="form-control-custom po-group-select"' +
                ' onchange="onItemGroupChange(' +
                index +
                ', this.value)">';


            poGroups.forEach(function (grp) {

                var selected =
                    item.TargetGroupId === grp.groupId
                        ? " selected"
                        : "";

                html +=
                    '<option value="' +
                    grp.groupId +
                    '"' +
                    selected +
                    '>' +
                    escapeWizardHtml(grp.groupName) +
                    '</option>';
            });


            html +=
                '</select>' +
                '</td>' +

                '</tr>';
        });


        html +=
            '</tbody>' +
            '</table>' +
            '</div>';


        $("#allocationItemsTableContainer")
            .html(html);
    }


    function onItemGroupChange(
        itemIndex,
        targetGroupId
    ) {

        allocatedItems[itemIndex].TargetGroupId =
            targetGroupId;
    }


    function goToStep1() {

        goToWizardStep(1);
    }


    function goToStep3() {

        if (!allocatedItems.length) {

            alert(
                "There are no PR items available for assignment."
            );

            return;
        }


        prepareStep3Data();

        goToWizardStep(3);
    }


    function escapeWizardHtml(value) {

        if (value === null || value === undefined) {
            return "";
        }

        return $("<div>")
            .text(value)
            .html();
    }

</script>
    // ISSUED ITEM TEMPLATE

    function DataOrderItemId() {
        var text = $("#OrderItemId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OrderItemId").data("kendoMultiColumnComboBox").value();
        }
        return {
            orderId: selectedId,
            text: text
        };
    }

    function onSelectOrderItem(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Item").val(dataItem.Name).trigger("change");
        $("#Unit").val(dataItem.Unit).trigger("change");
        $("#Qty").data("kendoNumericTextBox").value(dataItem.Qty);
        $("#UnitCost").data("kendoNumericTextBox").value(dataItem.UnitCost);
        $("#Qty").data("kendoNumericTextBox").trigger("change");
        $("#UnitCost").data("kendoNumericTextBox").trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems").data("kendoGrid").dataSource.read();
            }
        }
    }

    function reloadTab(idx) {
        var ts = $("#tabStrip").data("kendoTabStrip");
        if (idx == 0) {
            ts.contentHolder(idx).load("../Issueds/_OrderItem");
        } else if (idx == 1) {
            ts.contentHolder(idx).load("../Issueds/_IssuedOrder");
            //$("#gridItems").data("kendoGrid").dataSource.read();
        }
        //else if (idx == 2) {
        //    ts.contentHolder(idx).load("../Ledger/_PaymentHistoryMigrated?faasMastId=" + selectedItem + "&zeroAmount=false");
        //} else if (idx == 3) {
        //    ts.contentHolder(idx).load("../Ledger/_HistoryPanel?faasMastId=" + selectedItem + "&posted=true");
        //} else {
        //    ts.contentHolder(idx).load("../Ledger/_BillStartYear?faasMastId=" + selectedItem);
        //}
    }


    function onActivateTab(e) {

        // only default tab is applied
        //var tab = $("#TabStrip").data("kendoTabStrip");
        //var index = $("#TabStrip").data("kendoTabStrip").select().index();
        //var value = $("#TabStrip").data("kendoTabStrip").value();

        var ts = this;
        var index = ts.select().index();

        if (index == 1) {
            $("#gridIssuedOrder").data("kendoGrid").dataSource.read();
        } else if (index == 2) {
            $("#gridOrderItems").data("kendoGrid").dataSource.read();
        }
    }


    function onSelectTab(e) {
        var ts = this;
        for (var idx = 0; ; ++idx) {
            var tab = ts.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
                tsIndex = idx;
                reloadTab(idx);
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    // ISSUED ORDER

    function DataGridIssuedOrder() {
        return {
            orderId: selectedId
        };
    }

    function onChangeGridIssuedOrder(e) {
        var selectedData = this.dataItem(this.select());
        selectedIssuedId = selectedData.Id;
        $("#gridIssuedOrderItems").data("kendoGrid").dataSource.read();
    }

    function onDataBoundGridIssuedOrder(e) {
        if (selectedIssuedId) {
            var dataItem = this.dataSource.get(selectedIssuedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridIssuedOrder(e) {
        e.preventDefault();

        selectedGrid = e.sender;

        var validator = $("#formIssuedOrder").kendoValidator().data("kendoValidator");

        if (!validator.validate()) {
            alert(validator.errors().length);
            alert(validator.errors());

            selectedGrid.cancelRow();
        }
        else {
            SaveGridItems(e, false);
        }
    }


    // ISSUED ORDER ITEMS

    function DataGridIssuedOrderItem() {
        return {
            issuedId: selectedIssuedId
        };
    }
    
    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItem = selectedData.Id;
    }
    
    function onDataBoundGridItems(e) {
        if (selectedItem) {
            var dataItem = this.dataSource.get(selectedItem);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();

        selectedGrid = e.sender;

        var validator = $("#formOrder").kendoValidator().data("kendoValidator");

        if (!validator.validate()) {
            selectedGrid.cancelRow();
        }
        else {
            SaveGridItems(e, false);
        }
    }

    function SaveGridItems(e, closeWindow) {
        var disabled = $("#formOrder").find(':input:disabled').removeAttr('disabled');
        $.ajax({
            type: "POST",
            url: '@Url.Action("_IssuedOrderSave", "Issueds")',
            data: $("#formOrder").serialize(),
            beforeSend: function () {
                window.kendo.ui.progress($("#formOrder"), true);
            },
            success: function (result) {
                window.kendo.ui.progress($("#formOrder"), false);
                if (result.Errors == "") {
                    $("#formOrder input[name=Id]").val(result.Model.Id).trigger("change");
                    if (closeWindow) {
                        $("#btnCancelSelection").closest(".k-window-content").data("kendoWindow").close();
                    } else {
                        if (e.model.isNew()) {
                            selectedIssuedItemId = result.Model.Id;

                            e.model.set("IssuedId", selectedIssuedItemId);

                            var row = e.sender.tbody.find("tr:first");
                            if (row) {
                                selectedGrid.select(row);
                            }
                        } else {
                            selectedIssuedItemId = e.model.get("Id");
                            var rowitem = selectedGrid.dataSource.get(selectedIssuedItemId);
                            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
                        }
                    }
                    disabled.attr('disabled', 'disabled')
                } else {
                    alert(result.Errors);
                }
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
            }
        }).always(function () {
            window.kendo.ui.progress($("#formOrder"), false);
        });
    }
</script>



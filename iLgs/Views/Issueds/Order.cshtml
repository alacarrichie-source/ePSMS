@{
    ViewBag.Title = "Order Issuance - ePSMS";
}

<h3 class="text-info">Order Issuance</h3>
<br />

@(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.PoDate).Width(50);
        col.Bound(c => c.SupplierName).Width(150);
        col.Bound(c => c.SupplierAddress).Width(150);
        col.Group(group => group
             .Title("Quantity")
             .Columns(info =>
             {
                 info.Bound(c => c.QtyTotal).Width(50).Title("Total")
                    .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                    .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
                 info.Bound(c => c.QtyIssued).Width(50).Title("Issued")
                    .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                    .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
                 info.Bound(c => c.QtyRemaining).Width(50).Title("Remaining")
                    .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                    .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
             }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
         );
        col.Bound(c => c.TotalAmount).Width(70).Title("Total Amount")
                    .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                    .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
        
    })
        .ToolBar(t =>
        {
            t.Search();
        })
        .Search(s =>
        {
            s.Field(o => o.SupplierName, "contains");
            s.Field(o => o.PoNo, "contains");        
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(100))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
                {
                    a.Add(p => p.QtyTotal).Sum();
                    a.Add(p => p.QtyIssued).Sum();
                    a.Add(p => p.QtyRemaining).Sum();
                    a.Add(p => p.TotalAmount).Sum();
                })
            .Read(read => read.Action("OrderRead", "Issueds"))        
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
            )
)

<br />

@(Html.Kendo().TabStrip()
     .Name("tabStrip")
    //.Events(e => e.Select("onSelectTab"))
    .Events(e => e.Activate("onActivateTab"))
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Items(items =>
    {
        items.Add().Text("Issued")
            .Selected(true)
            .Content(@<text>
                  @RenderIssuedOrder();
            </text>
            );
            items.Add().Text("Order Items").LoadContentFrom("_OrderItem", "Issueds");        
    }))

@helper  RenderIssuedOrder() { 
    @(Html.Kendo().Grid<iLgs.Models.IssuedVM>()
            .Name("gridIssuedOrder")
            .Columns(col =>
            {
                col.Bound(c => c.SerialNo).Width(50);
                col.Bound(c => c.Date).Width(50);
                col.Bound(c => c.Fund).Width(50);
                col.Bound(c => c.CertifiedBy).Width(50);
                col.Bound(c => c.CertifiedDt).Width(50);
                col.Bound(c => c.PostedBy).Width(50);
                col.Bound(c => c.PostedDt).Width(50);
                col.Command(command =>
                {
                    command.Custom("Edit").IconClass("k-icon k-i-edit").Click("onGridEditClick").SendDataKeys(true);
                    command.Destroy();
                    //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
                }).Width(100);
            })
            .ToolBar(toolbar =>
            {
                toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd").Icon("k-icon k-i-add").Content("Issue Order")
                        .Events(e => e.Click("onClickBtnAdd"))
                )
                </text>);
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Scrollable(s => s.Height(70))
            .Selectable(s => s.Mode(GridSelectionMode.Single))
            .Sortable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Read(read => read.Action("_IssuedOrderRead", "Issueds").Data("DataGridIssuedOrder"))
                .Destroy(destroy => destroy.Action("_IssuedOrderDestroy", "Issueds"))
            )
            .Events(events => events
                .Change("onChangeGridIssuedOrder")
                .Edit("onEditGridIssuedOrder")
                .DataBound("onDataBoundGridIssuedOrder")
            )
            .AutoBind(true)
    )

    <br />

    @(Html.Kendo().Grid<iLgs.Models.IssuedItemVM>()
            .Name("gridIssuedOrderItems")
            .Columns(col =>
            {
                col.Bound(c => c.RISNo).Width(50);
                col.Bound(c => c.RCCode).Width(50);
                col.Bound(c => c.StockNo).Width(50);
                col.Bound(c => c.Item).Width(50);
                col.Bound(c => c.Unit).Width(50);
                col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Scrollable(s => s.Height(120))
            .Selectable(s => s.Mode(GridSelectionMode.Single))
            .Sortable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Aggregates(a =>
                {
                    a.Add(p => p.Qty).Sum();
                    a.Add(p => p.Amount).Sum();
                })
                .Sort(s =>
                {
                    s.Add(a => a.InsertedDt);
                })
                .Read(read => read.Action("_IssuedOrderItemRead", "Issueds").Data("DataGridIssuedOrderItem"))
            )
            //.Events(events => events
            //    .Change("onChangeGridItems")
            //    .Edit("onEditGridItems")
            //    .DataBound("onDataBoundGridItems")
            //)
            .AutoBind(true)
    )

}


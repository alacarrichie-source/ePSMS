<script type="text/javascript">
    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedIssuedId = null;
    var selectedIssuedItemId = null;
    
    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedIssuedId = null;
        selectedIssuedItemId = null;

        var ts = $("#tabStrip").data("kendoTabStrip");
        var index = ts.select().index();
        
        if (index == 0) {
            $("#gridIssuedOrder").data("kendoGrid").dataSource.read();
            $("#gridIssuedOrderItems").data("kendoGrid").dataSource.read();            
        } else if (index == 1) {
            $("#gridOrderItems").data("kendoGrid").dataSource.read();
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    function onClickBtnAdd(e) {
        e.preventDefault();
        var serialNo
        selectedIssuedId = null;
        selectedIssuedItemId = null;
        Entry("A", serialNo);
    }

    function Entry(mode, serialNo) {
        var myTitle = (mode == "A") ? "Purchase Order Issuance - ADD" : "Purchase Order Issuance - EDIT";
        var width = "90%";
        var height = "65%";
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#grid").data("kendoGrid").dataSource.read();
                        $("#gridIssuedOrder").data("kendoGrid").dataSource.read();
                        $("#gridIssuedOrderItems").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });

        mywindow.refresh({
            url: '@Url.Action("_IssuedOrderAdd", "Issueds")',
            data: {
                orderId: selectedId,
                serialNo: serialNo
            }
        });
        mywindow.center().open();
    }



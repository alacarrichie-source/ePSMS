@(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
        .Name("gridOrderItems")
        .Columns(col =>
        {
            col.Bound(c => c.PsNo).Width(50);
            col.Bound(c => c.PsUnit).Width(50);
            col.Bound(c => c.PsItem).Width(50);
            col.Bound(c => c.Description).Width(50);
            col.Group(group => group
                 .Title("Quantity")
                 .Columns(info =>
                 {
                     info.Bound(c => c.Qty).Width(50).Title("Total")
                        .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                        .FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                        .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
                     info.Bound(c => c.QtyIssued).Width(50).Title("Issued")
                        .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                        .FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                        .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
                     info.Bound(c => c.QtyRemaining).Width(50).Title("Remaining")
                        .Format("{0:n2}").HtmlAttributes(new { Style = "text-align:right;" })
                        .FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#")
                        .ClientGroupFooterTemplate("#=kendo.format('{0:n2}', sum)#");
                 }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
            col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyIssued).Sum();
                a.Add(p => p.QtyRemaining).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_OrderItemRead", "Issueds").Data("DataGridOrderItem"))
        )
        //.Events(events => events
        //    .Change("onChangeGridItems")
        //    .Edit("onEditGridItems")
        //    .DataBound("onDataBoundGridItems")
        //)
        .AutoBind(true)
)


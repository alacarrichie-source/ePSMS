                            .Placeholder("Select PR No.")
                            .DataTextField("PrNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPrNoWithRemainingItems", "Getters").Data("DataPrId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PrNo").Title("PR No.").Width("30%");
                                c.Add().Template("#= kendo.toString(kendo.parseDate(PrDate), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectPrId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.PrId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.PrDate, "LabelDate")
                <div class="col-md-12">

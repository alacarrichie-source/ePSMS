@model iLgs.Models.OrderVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PrNo)
    @Html.HiddenFor(model => model.PrDate)
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>        
        <div class="row">            
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.PoNo).Placeholder("(AUTO)").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PoNo)
                </div>
            </div>        
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PoDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PoDate)
                </div>
            </div>
            @*<div class="col-md-6">
                @Html.LabelFor(model => model.Section, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Section).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.Section)
                </div>
            </div>*@
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.PrId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.PrId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("PrNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPrNoWithRemainingItems", "Getters").Data("DataPrId");                                    
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PrNo").Title("P.R. No.").Width("30%");
                                c.Add().Template("#= kendo.toString(new Date(parseInt(PrDate.substr(6))), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectPrId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.PrId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoMode, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.PoMode)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Procurement Mode")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "PROC-MODE", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.PoMode)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.SupplierId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.SupplierId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Supplier")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetSupplier", "Getters").Data("DataSupplierId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("40%")
                                    .Template("<span class=\"k-textarea k-readonly \" ><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.Name #</textarea></span>");
                                c.Add().Field("Address").Title("Address").Width("45%")
                                    .Template("<span class=\"k-textarea k-readonly \"><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.Address #</textarea></span>");
                                c.Add().Field("TIN").Title("TIN").Width("15%")
                                    .Template("<span class=\"k-state-default\">#: data.TIN #</span>");
                            })
                            .MinLength(3)
                            .Suggest(true)
                            .Events(e => { e.Select("onSelectSupplier"); })
                    )
                    @Html.ValidationMessageFor(m => m.SupplierId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.SupplierAddress, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.SupplierAddress).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.SupplierTin, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.SupplierTin).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.DeliveryPlace, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.DeliveryPlace).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.DeliveryPlace)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.DeliveryDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.DeliveryDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.DeliveryDate)
                </div>
            </div>            
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.TermDelivery, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.TermDelivery)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Delivery Term")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "DELI-TERM", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.TermDelivery)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.TermPayment, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.TermPayment)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Payment Term")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "PAY-TERM", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                </div>
            </div>
        </div>

        <div class="row">                        
            <div class="col-md-4">
                @Html.LabelFor(model => model.SignedByAuthName, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.SignedByAuthName).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.SignedByAuthName)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.SignedByAuthDesignation, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.SignedByAuthDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.SignedByAuthDesignation)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.SignedBySuppDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.SignedBySuppDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.SignedBySuppDate)
                </div>
            </div>        
        </div>

        <div class="row">            
            <div class="col-md-4">
                @Html.LabelFor(model => model.ResoNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ResoNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ResoNo)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.CertifiedCorrectBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.CertifiedCorrectBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.CertifiedCorrectBy)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.CertifiedCorrectDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.CertifiedCorrectDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.CertifiedCorrectDate)
                </div>
            </div>
        </div>
    </fieldset>
}




@model iLgs.Models.OrderItemVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.OrderId)
    @Html.HiddenFor(model => model.PsNo)
    

    <fieldset>

        <div class="row">
            @Html.LabelFor(m => m.PsCodeId, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.PsCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;"})
                        .Placeholder("Select stock/property Code")
                        .DataTextField("Code")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetPsCode", "Getters").Data("DataPsCodeId");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("20%");
                            c.Add().Field("Name").Title("Item Name").Width("50%");
                            c.Add().Field("Unit").Title("Unit").Width("15%");
                            c.Add().Field("Type").Title("Type").Width("15%");

                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectPsCode"); })
                )
                @Html.ValidationMessageFor(m => m.PsCodeId)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(m => m.PsDescription, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsDescription).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(m => m.PsUnit, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsUnit).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.Qty, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.Qty)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.UnitCost, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.UnitCost).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.UnitCost)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.Amount).Enable(false).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                        
                @Html.ValidationMessageFor(model => model.Amount)
            </div>
        </div>

    </fieldset>
}
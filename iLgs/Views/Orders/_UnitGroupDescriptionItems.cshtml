@(Html.Kendo().Grid<iLgs.Models.OrderItemUnitGroupDescriptionItemVM>()
    .Name("gridItemUnitGroupDescriptionItems")
    .HtmlAttributes(new { style = "height: calc(60vh);" })
    .Columns(col =>
    {
        col.Bound(c => c.ItemNo).Width(50);
        col.Bound(c => c.Category).Width(50);
        col.Bound(c => c.PsNo).Width(70);
        col.Bound(c => c.ItemName).Width(100);
        col.Bound(c => c.Description).Width(100);
        col.Bound(c => c.Unit).Width(50).Title("Unit of<br>Measurement");
        col.Bound(c => c.GroupQty).Width(50).Title("Qty of<br>Sets/Lots")
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                //.ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.QtyRequest).Width(50).Title("Qty per<br>Set/Lot")
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.PriceRate).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}\\%")
                .ClientFooterTemplate("#=kendo.format('{0:n2}%', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_PriceRateTemplate");
        col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                //.ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_UnitCostTemplate");
        col.Bound(c => c.TotalCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_TotalCostTemplate");
        col.Command(command =>
        {
            command.Edit();
            //command.Destroy();
        }).Width(100);
    })
    @*.ToolBar(toolbar =>
    {
        toolbar.Template(@<text>
            @(Html.Kendo().Button().Name("btnAddUnitGroupItem").Content("Add Group Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddGroupItem")))
        </text>);
    })*@
    .Sortable()
    .Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onGridItemUnitGroupDescriptionItemsRequestEnd")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.ItemNo).Editable(false);
            model.Field(p => p.PsNo).Editable(false);
            model.Field(p => p.ItemName).Editable(false);
            model.Field(p => p.Description).Editable(false);
            model.Field(p => p.Unit).Editable(false);
            model.Field(p => p.QtyRequest).Editable(false);
            model.Field(p => p.TotalCost).Editable(false);
            model.Field(p => p.GroupQty).Editable(false);
            model.Field(p => p.Category).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.QtyRequest).Sum();
            a.Add(p => p.PriceRate).Sum();
            //a.Add(p => p.UnitCost).Sum();
            a.Add(p => p.TotalCost).Sum();
        })
        .Sort(s => { s.Add(a => a.ItemNoIndex); })
        .Read(read => read.Action("_UnitGroupDescriptionItemRead", "Orders", new { unitGroupDescriptionId = ViewData["unitGroupDescriptionId"] }))
        .Update(update => update.Action("_UnitGroupDescriptionItemUpdate", "Orders"))
        //.Destroy(destroy => destroy.Action("_UnitGroupDescriptionItemDestroy", "Orders"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e
        .Change("onChangeGridItemUnitGroupDescriptionItems")
        .Edit("onEditGridItemUnitGroupDescriptionItems")
        .DataBound("onDataBoundGridItemUnitGroupDescriptionItems")
    )
)

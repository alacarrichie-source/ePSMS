@{
    ViewBag.Title = "Purchase Order - ePSMS";
}

<h3 class="text-info">Purchase Order</h3>
<br />

    @(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .Columns(col =>
    {        
        col.Bound(c => c.PoNo).Width(100);
        col.Bound(c => c.PoDate).Width(100);
        col.Bound(c => c.PoModeDesc).Width(100);
        col.Bound(c => c.PrNos).Width(100);
        col.Bound(c => c.SupplierName).Width(100);
        col.Bound(c => c.SupplierAddress).Width(100);
        col.Bound(c => c.SupplierTin).Width(50);
        col.Command(command =>
        {
            command.Custom("Edit").IconClass("k-icon k-i-edit").Click("onGridEditClick").SendDataKeys(true);
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);            
        }).Width(120);
    })
    //.ToolBar(t =>
    //{
    //    t.Create().Text("Add Order");
    //    t.Search();
    //})
    .ToolBar(toolbar =>
    {
        toolbar.Template(@<text>
            @(Html.Kendo().Button().Name("btnAdd").Icon("k-icon k-i-add").Content("Add Order")
                .Events(e => e.Click("onClickBtnAdd"))
            )
        </text>);
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderTemplate").Window(w => w.Width("80%").Title("Purchase Order")))
            //.Editable(editable => editable.Mode(GridEditMode.InLine))
    .Search(s =>
    {
        s.Field(o => o.SupplierName, "contains");
        s.Field(o => o.SupplierAddress, "contains");
        s.Field(o => o.SupplierTin, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.PoModeDesc, "contains");
        s.Field(o => o.PrNos, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(200))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("OrderRead", "Orders"))
        //.Create(create => create.Action("OrderCreate", "Orders"))
        //.Update(update => update.Action("OrderUpdate", "Orders"))
        .Destroy(destroy => destroy.Action("OrderDestroy", "Orders"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )

<br />


    @(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
        .Name("gridOrderItems")
        .Columns(col =>
        {
            col.Bound(c => c.PsNo).Width(50);
            col.Bound(c => c.PsUnit).Width(50);
            col.Bound(c => c.PsDescription).Width(50);
            col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        })        
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_OrderItemRead", "Orders").Data("DataGridItem"))
        )
        //.Events(events => events
        //    .Change("onChangeGridItems")
        //    .Edit("onEditGridItems")
        //    .DataBound("onDataBoundGridItems")
        //)
        .AutoBind(false)
    )

<div id="windowcontainer"></div>

<style>
    .k-tabstrip-content.k-state-active, .k-tabstrip > .k-content.k-state-active {
        overflow-x: hidden;
    }


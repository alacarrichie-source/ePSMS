@{
    ViewBag.Title = "Purchase Order";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}


@(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(70);
        col.Bound(c => c.PoDate).Width(70);
        col.Bound(c => c.PoModeDesc).Width(70);
        col.Bound(c => c.PrNo).Width(70);
        col.Bound(c => c.SupplierName).Width(100);
        col.Bound(c => c.SupplierAddress).Width(100);
        col.Bound(c => c.SupplierTin).Width(70);
        col.Bound(c => c.PostedBy).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            //command.Custom("Post").IconClass("k-icon k-i-lock").Click("onGridPostClick").SendDataKeys(true);
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Order");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderTemplate").Window(w => w.Width(800).Title("Purchase Order")))
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.PoModeDesc, "contains");
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.SupplierName, "contains");
        s.Field(o => o.SupplierAddress, "contains");
        s.Field(o => o.SupplierTin, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("OrderRead", "Orders"))
        .Create(create => create.Action("OrderCreate", "Orders"))
        .Update(update => update.Action("OrderUpdate", "Orders"))
        .Destroy(destroy => destroy.Action("OrderDestroy", "Orders"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
@(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    .HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Items(items =>
    {
        items.Add()
            .Selected(true)
            .LoadContentFrom("_OrderItem", "Orders", new { orderId = "#=Id#" });
    }).ToClientTemplate())    
</script>

@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    #span_ {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: fit-content;
    }

    .no-text-tabstrip .k-item .k-link {
        padding: 0; /* Remove padding */
        text-indent: -9999px; /* Move the text outside the visible area */
        overflow: hidden; /* Hide any overflow */
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                //$("#grid").data("kendoGrid").dataSource.read();
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedId_PrId = null;
    var selecteItemId = null;
    var postedBy = null;
    var selectedPoNo = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedId_PrId = selectedData.PrId;
        selectedItemId = null;
        postedBy = selectedData.PostedBy;
        selectedPoNo = selectedData.PoNo;

        //if (postedBy) {
        //    //$(".k-grid-btnPostPO", grid).text("Post PO");
        //    //$(".k-grid-btnPostPO", grid).addClass("k-state-disabled");
        //    $(".k-grid-btnPostPO", grid).hide();
        //} else {
        //    //$(".k-grid-btnPostPO", grid).text("Post PO No. " + selectedPoNo);
        //    //$(".k-grid-btnPostPO", grid).removeClass("k-state-disabled")
        //    $(".k-grid-btnPostPO", grid).show();
        //}

        if (postedBy) {
            if (selectedData.IsLocked) {
                $(".k-grid-btnUnpostPO", grid).hide();
            } else {
                $(".k-grid-btnUnpostPO", grid).show();
            }
            $(".k-grid-btnPostPO", grid).hide();
        } else {
            $(".k-grid-btnUnpostPO", grid).hide();
            $(".k-grid-btnPostPO", grid).show();
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrintPO", grid).hide();
            $(".k-grid-btnPostPO", grid).hide();
            $(".k-grid-btnUnpostPO", grid).hide();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function onGridItemDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = selectedGrid.dataItem(tr);
        const rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow($(e.currentTarget).closest("tr"));
    }

    // Grid Item
    function onClickBtnAddOrderItem(e) {
        e.preventDefault();
        OrderItem("A", null);
    }

    function onClickBtnEditOrderItem(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        OrderItem("E", dataItem.Id);
    }

    function OrderItem(mode, recId) {
        var myTitle = (mode == "A") ? "Order Item - ADD" : "Order Item - EDIT";
        var width = 800;
        var height = 550;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_OrderItemAddEdit", "Orders")',
            data: {
                orderId: selectedId,
                orderItemId: recId
            }
        });
        mywindow.center();
        mywindow.open();
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }

        //var parentRow = this.wrapper.closest("tr").prev();
        //var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        //var grid = this.wrapper.closest("[data-role=grid]");

        //if (parentModel.PostedBy) {
        //    $(".k-grid-add", grid).hide();
        //}
        //var trs = this.tbody.find('tr').each(function () {
        //    if (parentModel.PostedBy) {
        //        $(this).find('.k-grid-Edit,.k-grid-Delete,.k-grid-edit,.k-grid-delete').hide();
        //    }
        //});
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;
            e.model.set("OrderId", selectedId);
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function DataRequestItemId() {
        var text = $("#RequestItemId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#RequestItemId").data("kendoMultiColumnComboBox").value();
        }
        return {
            prId: selectedId_PrId,
            text: text
        };
    }

    function onSelectRequestItemId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PsItem").val(dataItem.Name).trigger("change");
        $("#PsUnit").val(dataItem.Unit).trigger("change");
        $("#PsCodeId").val(dataItem.PsCodeId).trigger("change");
        $("#PsCode").val(dataItem.Code).trigger("change");
        $("#Description").val(dataItem.Description).trigger("change");

        $("#Qty").data("kendoNumericTextBox").value(dataItem.Qty);
        $("#UnitCost").data("kendoNumericTextBox").value(dataItem.UnitCost);

        $("#Qty").data("kendoNumericTextBox").trigger("change");
        $("#UnitCost").data("kendoNumericTextBox").trigger("change");

        RefreshGridItemExtn();
    }

    function onDataBoundRequestItemId(e) {
        RefreshGridItemExtn();
    }

    function RefreshGridItemExtn() {
        $("#gridItemExtn").data("kendoGrid").dataSource.read();
    }

    function DataSupplierId() {
        var text = $("#SupplierId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#SupplierId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onSelectPrId(e) {
        var dataItem = this.dataItem(e.item.index());
        var prDate = kendo.toString(new Date(parseInt(dataItem.PrDate.substr(6))), 'MM/dd/yyyy');

        $("#PrDate").val(prDate).trigger("change");
        $("#DeliveryPlace").val(dataItem.Department).trigger("change");
    }

    function onSelectSupplier(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#SupplierName").val(dataItem.Name).trigger("change");
        $("#SupplierAddress").val(dataItem.Address).trigger("change");
        $("#SupplierTin").val(dataItem.TIN).trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
            }
        }
    }

    $(".k-grid-btnPostPO").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Order already posted by " + postedBy);
        }
        else {
            var msg = "Post PO Number " + selectedPoNo + "?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostOrders", "Orders")',
                    data: { orderId: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Orders Posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    $(".k-grid-btnUnpostPO").click(function (e) {
        e.preventDefault();
        var msg = "Unpost PO Number " + selectedPoNo + "?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UnpostOrders", "Orders")',
                data: { orderId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrintPO").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("PurchaseOrderRpt", "Orders")?poNo=' + selectedPoNo;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });

    // ------------ GRID ITEM EXTN ------------
    function onSaveGridItemExtn(e) {
        var grid = e.sender;
        var model = $("#gridItemExtn").data().kendoGrid.editable.options.model;

        for (var key in e.values) {
            if (e.values.hasOwnProperty(key)) {
                model.set('ItemValue', e.values[key]);
            }
        }

        // Create an array to store the row values
        var rowValues = [];
        var gridData = e.sender.dataSource.data();
        for (var i = 0; i < gridData.length; i++) {
            var rowData = gridData[i];

            for (var key in e.values) {
                if (e.values.hasOwnProperty(key)) {
                    if (rowData[key]) {
                        rowValues.push(rowData[key]);
                    }
                }
            }
        }

        var description = rowValues.join(" ");
        $("#Description").val(description).trigger('change');
    }

    function DataOrderItemExtnGrid() {
        return {
            orderItemId: $("#Id").val(),
            psCodeId: $("#PsCodeId").val()
        };
    }
    // ------------ END GRID ITEMEXTN



</script>



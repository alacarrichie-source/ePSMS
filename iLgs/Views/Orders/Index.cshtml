        overflow-x: hidden;
    }

    .k-prompt-container, .k-window-content {
        overflow-x: hidden;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }
</style>



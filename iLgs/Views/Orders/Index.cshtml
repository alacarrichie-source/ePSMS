    function GridItemError(args) {
        if (args.errors) {
            var selectedGrid = $("#gridItems").data("kendoGrid");
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "GridError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        //alert(this.errors);
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function DataGridItem() {
        return {
            orderId: selectedId
        };
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItem = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selectedItem) {
            var dataItem = this.dataSource.get(selectedItem);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();

        selectedGrid = e.sender;

        var validator = $("#formOrder").kendoValidator().data("kendoValidator");

        if (!validator.validate()) {
            alert(validator.errors().length);
            alert(validator.errors());

            selectedGrid.cancelRow();
        }
        else {
            SaveGridItems(e, false);
        }
    }

    var gridItemMode = null;
    function SaveGridItems(e, closeWindow) {
        var disabled = $("#formOrder").find(':input:disabled').removeAttr('disabled');
        $.ajax({
            type: "POST",
            url: '@Url.Action("_OrderSave", "Orders")',
            data: $("#formOrder").serialize(),
            beforeSend: function () {
                window.kendo.ui.progress($("#formOrder"), true);
            },
            success: function (result) {
                window.kendo.ui.progress($("#formOrder"), false);
                if (result.Errors == "") {
                    $("#formOrder input[name=Id]").val(result.Model.Id).trigger("change");
                    if (closeWindow) {
                        $("#btnCancelSelection").closest(".k-window-content").data("kendoWindow").close();
                    } else {
                        if (e.model.isNew()) {
                            gridItemMode = "ADD";
                            selectedItem = result.Model.Id;

                            //$("#formItem input[name=TtaxId]").val(result.Model.Id).trigger("change");

                            e.model.set("OrderId", selectedItem);

                            var row = e.sender.tbody.find("tr:first");
                            if (row) {
                                selectedGrid.select(row);
                            }
                        } else {
                            gridItemMode = "EDIT";
                            //$("#PIN").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#Description").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#UnitNo").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#Building").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#Subdivision").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#Location").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#Barangay").prop("disabled", false).removeClass("k-state-disabled");
                            //$("#NoTdn").prop("disabled", true);
                            //$("#Area").data("kendoNumericTextBox").enable(true);
                            //$("#Kind").data("kendoMaskedTextBox").enable(true);
                            //$("#ARPN").data("kendoMaskedTextBox").enable(false);
                            //$("#FMV").data("kendoNumericTextBox").enable(true);
                            //$("#ZonalValue").data("kendoNumericTextBox").enable(true);

                            selectedItem = e.model.get("Id");
                            var rowitem = selectedGrid.dataSource.get(selectedItem);
                            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
                        }
                    }
                    disabled.attr('disabled', 'disabled')
                } else {
                    alert(result.Errors);
                }
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
            }
        }).always(function () {
            window.kendo.ui.progress($("#formOrder"), false);
        });
    }

    function DataPsCodeId() {
        var text = $("#PsCodeId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#PsCodeId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onSelectPsCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PsDescription").val(dataItem.Name).trigger("change");
        $("#PsUnit").val(dataItem.Unit).trigger("change");
        $("#PsNo").val(dataItem.Code).trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems").data("kendoGrid").dataSource.read();                
            }
        }
    }

</script>



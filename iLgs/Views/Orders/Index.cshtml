@{
    ViewBag.Title = "Purchase Order";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(100);
        col.Bound(c => c.PoDate).Width(100);
        col.Bound(c => c.PoModeDesc).Width(100);
        col.Bound(c => c.PrNo).Width(100);
        col.Bound(c => c.SupplierName).Width(100);
        col.Bound(c => c.SupplierAddress).Width(100);
        col.Bound(c => c.SupplierTin).Width(50);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Request");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderTemplate").Window(w => w.Width(800).Title("Purchase Order")))
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.PoModeDesc, "contains");
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.SupplierName, "contains");
        s.Field(o => o.SupplierAddress, "contains");
        s.Field(o => o.SupplierTin, "contains");        
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(200))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("OrderRead", "Orders"))
        .Create(create => create.Action("OrderCreate", "Orders"))
        .Update(update => update.Action("OrderUpdate", "Orders"))
        .Destroy(destroy => destroy.Action("OrderDestroy", "Orders"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )
</div>

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
        .Name("gridItems")
        .Columns(col =>
        {
            col.Bound(c => c.PsNo).Width(70);
            col.Bound(c => c.PsUnit).Width(50);
            col.Bound(c => c.PsItem).Width(150);
            col.Bound(c => c.Description).Width(150);
            col.Bound(c => c.Qty).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.UnitCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Amount).Width(100).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add Order Item");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderItemTemplate").Window(w => w.Width(500).Title("Order Item")))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_OrderItemRead", "Orders").Data("ItemData"))
            .Create(create => create.Action("_OrderItemCreate", "Orders"))
            .Update(update => update.Action("_OrderItemUpdate", "Orders"))
            .Destroy(destroy => destroy.Action("_OrderItemDestroy", "Orders"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
        .AutoBind(true)
    )
</div>

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedId_PrId = null;
    var selecteItemId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedId_PrId = selectedData.PrId;
        selectedItemId = null;
        $("#gridItems").data("kendoGrid").dataSource.read();
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // Grid Item

    function ItemData() {
        return {
            orderId: selectedId
        };
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;
            e.model.set("OrderId", selectedId);
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function DataRequestItemId() {
        var text = $("#RequestItemId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#RequestItemId").data("kendoMultiColumnComboBox").value();
        }
        return {
            prId: selectedId_PrId,
            text: text
        };
    }

    function onSelectRequestItemId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PsItem").val(dataItem.Name).trigger("change");
        $("#PsUnit").val(dataItem.Unit).trigger("change");
        $("#PsCode").val(dataItem.Code).trigger("change");

        $("#Qty").data("kendoNumericTextBox").value(dataItem.Qty);
        $("#UnitCost").data("kendoNumericTextBox").value(dataItem.UnitCost);

        $("#Qty").data("kendoNumericTextBox").trigger("change");
        $("#UnitCost").data("kendoNumericTextBox").trigger("change");
    }

    function DataSupplierId() {
        var text = $("#SupplierId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#SupplierId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onSelectPrId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#DeliveryPlace").val(dataItem.Department).trigger("change");        
    }

    function onSelectSupplier(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#SupplierName").val(dataItem.Name).trigger("change");
        $("#SupplierAddress").val(dataItem.Address).trigger("change");
        $("#SupplierTin").val(dataItem.TIN).trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems").data("kendoGrid").dataSource.read();
            }
        }
    }
</script>



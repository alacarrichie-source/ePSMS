    function onGridEditClick(e) {
        selectedGrid = this;
        var dataItem = selectedGrid.dataItem($(e.currentTarget).closest("tr"));
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        var row = selectedGrid.tbody.find("tr[data-uid='" + rowitem.uid + "']");
        selectedGrid.select(row);
        selectedId = selectedGrid.dataItem(selectedGrid.select()).Id;
        var poNo = selectedGrid.dataItem(selectedGrid.select()).PoNo;
        Entry("E", poNo);
    }

    function DataSupplierId() {
        var text = $("#SupplierId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#SupplierId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onChangePoDate(e) {
        if (DateIsValid($("#PoDate").val())) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetPoYyyyMm", "Orders")',
                data: { PoDate: $("#PoDate").val() },
                success: function (result) {
                    $("#PoYear").val(result.PoYear).trigger("change");
                    $("#PoMonth").val(result.PoMonth).trigger("change");
                }
            });
        }
    }

    function DateIsValid(kendoDate) {
        var date = kendo.parseDate(kendoDate);
        if (!date) {
            alert("Invalid Date!");
            return false;
        }
        return true;
    }

    function onSelectSupplier(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#SupplierName").val(dataItem.Name).trigger("change");
        $("#SupplierAddress").val(dataItem.Address).trigger("change");
        $("#SupplierTin").val(dataItem.TIN).trigger("change");
    }


@{
    ViewBag.Title = "Purchase Order";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="dashboard-container">
    <main class="dashboard-main">
        <div class="content-wrapper">
            @(Html.Kendo().TabStrip()
                .Name("tabstripMaster")
                .HtmlAttributes(new { @class = "dashboard-tabstrip", style = "height: calc(40vh);" })
                .Animation(false)
                .Items(items =>
                {
                    items.Add()
                        .Text("<i class='k-icon k-i-track-changes-accept'></i> Orders")
                        .Encoded(false)
                        .Selected(true)
                        .Content(@<text>@RenderMaster()</text>);
                })
            )
        </div>
        <div class="content-wrapper">
            @(Html.Kendo().TabStrip()
                .Name("tabstripDetail")
                .HtmlAttributes(new { @class = "dashboard-tabstrip", style = "height: calc(45vh);" })
                .Events(e => e.Activate("onActivateTabstripDetail"))
                .Animation(false)
                .Items(items =>
                {
                items.Add()
                        .Text("<i class='k-icon k-i-file-txt'></i> Items")
                        .Encoded(false)
                        .Selected(true)
                        .Content(@<text>@RenderItem()</text>);
                    items.Add()
                        .Text("<i class='k-icon k-i-add-outline'></i> Groups")
                        .Encoded(false)
                        .Content(@<text>@RenderUnitGroup()</text>);
                })
)
        </div>
    </main>
</div>

@helper RenderMaster()
{
    @(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .HtmlAttributes(new { style = "height: 100%" })
    .Columns(col =>
    {
        col.Bound(c => c.CtrlNo).Width(50);
        col.Bound(c => c.Fund).Width(50);
        col.Bound(c => c.PoNo).Width(70);
        col.Bound(c => c.PoDate).Width(70);
        col.Bound(c => c.PrNo).Width(70);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.SupName).Width(100);        
        col.Bound(c => c.PostedBy).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true).Visible("IsNotPosted");
            //command.Custom("Post").IconClass("k-icon k-i-lock").Click("onGridPostClick").SendDataKeys(true);
            command.Custom("PO").IconClass("k-icon k-i-upload").Click("onClickUploads").SendDataKeys(true);
            command.Custom("CAFOA").IconClass("k-icon k-i-upload").Click("onClickUploadsCafoa").SendDataKeys(true);
        }).Width(170);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Order");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderTemplate").Window(w => w.Width("70%").Title("Purchase Order")))
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.PoModeDesc, "contains");
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.SupName, "contains");
        s.Field(o => o.SupBusiness, "contains");
        s.Field(o => o.SupAddress, "contains");
        s.Field(o => o.SupTIN, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("OrderRead", "Orders"))
        .Create(create => create.Action("OrderCreate", "Orders"))
        .Update(update => update.Action("OrderUpdate", "Orders"))
        .Destroy(destroy => destroy.Action("OrderDestroy", "Orders"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )
}


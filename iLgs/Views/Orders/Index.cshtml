<script type="text/javascript">
    function onActivateTabstripDetail(e) {
        refreshTabstrip();
    }

    function refreshTabstrip(e) {
        var tab = $("#tabstripDetail").data("kendoTabStrip");
        var index = tab.select().index();
        var value = tab.value();

        if (index == 0) {
            $("#gridItems").data("kendoGrid").dataSource.read();
        } else if (index == 1) {
            $("#gridItemUnitGroups").data("kendoGrid").dataSource.read();
        }
    }

    function DataGridItem() {
        var grid = $("#grid").data("kendoGrid");
        var orderId;
        grid.select().each(function () {
            var dataItems = grid.dataItem($(this));
            orderId = dataItems.Id;
        });
        return {
            orderId: orderId
        };
    }


    function onSelectTabStrip(e) {
        var tabStrip = this;
        for (var idx = 0; ; ++idx) {
            var tab = tabStrip.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function IsPosted(dataItem) {
        return dataItem.PostedDt != null;
    }

    function IsNotPosted(dataItem) {
        return !IsPosted(dataItem);
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function onSelectTab(e) {
        var ts = this;
        for (var idx = 0; ; ++idx) {
            var tab = ts.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
                //tsIndex = idx;
                if (idx == 0) {
                    ts.contentHolder(idx).load("../Orders/_OrderItem?orderId=" + selectedId);
                } else {
                    ts.contentHolder(idx).load("../Orders/_UnitGroup?orderId=" + selectedId);
                }
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                //$("#grid").data("kendoGrid").dataSource.read();
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedId_PrId = null;
    var selecteItemId = null;
    var postedBy = null;
    var selectedPoNo = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedId_PrId = selectedData.PrId;
        selectedItemId = null;
        postedBy = selectedData.PostedBy;
        selectedPoNo = selectedData.PoNo;

        if (postedBy) {
            if (selectedData.IsLocked) {
                $(".k-grid-btnUnpostPO", grid).hide();
            } else {
                $(".k-grid-btnUnpostPO", grid).show();
            }
            $(".k-grid-btnPostPO", grid).hide();
        } else {
            $(".k-grid-btnUnpostPO", grid).hide();
            $(".k-grid-btnPostPO", grid).show();
        }

        refreshTabstrip();
    }


    function onDataChange(e) {
        var selectedData = this.dataItem(this.select());

        selectedMainItem = selectedData.RecId;

        $('#SalaryGrade').val(selectedData.SalaryGrade).trigger("change");


        var tab = $("#TabStrip").data("kendoTabStrip");
        var index = $("#TabStrip").data("kendoTabStrip").select().index();
        var value = $("#TabStrip").data("kendoTabStrip").value();

        Var_MainRecId = selectedMainItem;
        if (index == 0) {
            $("#gridEmpExtn").data("kendoGrid").dataSource.read();
        }
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        var grid = $("#grid");
        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrintPO", grid).hide();
            $(".k-grid-btnPostPO", grid).hide();
            $(".k-grid-btnUnpostPO", grid).hide();
        }
        else {
            $(".k-grid-btnPrintPO", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;

            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetCurrentDate", "Getters")',
                success: function (result) {
                    var date = kendo.toString(kendo.parseDate(result.Date), 'MM/dd/yyyy');
                    var datePicker = $("#PoDate").data("kendoDatePicker");
                    datePicker.value(date);
                    datePicker.trigger("change");
                    disabled.attr('disabled', 'disabled')
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });

        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");

            // Refresh PR Nos
            //$("#PrId").data("kendoMultiColumnComboBox").dataSource.read(DataPrId());
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function onGridItemDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = selectedGrid.dataItem(tr);
        const rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow($(e.currentTarget).closest("tr"));
    }

    // Grid Item
    function GridItemError(args) {
        if (args.errors) {
            var validationError = true;
            var selectedGrid = $("#gridItems").data("kendoGrid");
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onSelectOffice(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#DeptId").val(dataItem.Id).trigger("change");
        $("#Department").val(dataItem.Description).trigger("change");
        $("#DeliveryPlace").val(dataItem.Description).trigger("change");

        var model = $("#grid").data().kendoGrid.editable.options.model;
        model.set('DeptId', $('#DeptId').val());
        model.set('Department', $('#Department').val());
        model.set('DeliveryPlace', $('#Department').val());

        setTimeout(function () {
            var fppComboBox = $("#FPP").data("kendoMultiColumnComboBox");
            if (fppComboBox) {
                fppComboBox.dataSource.read();
            }
        }, 500);
    }

    function onChangeDeptDisplay(e) {

        var deliveryWidget = $("#DeliveryPlace").data("kendoTextBox");
        var deptValue = $("#Department").data("kendoMaskedTextBox").value();

        deliveryWidget.value(deptValue);
        deliveryWidget.trigger("change");
    }



    function onChangeOffice(e) {
        var fppComboBox = $("#FPP").data("kendoMultiColumnComboBox");
        if (fppComboBox) {
            fppComboBox.dataSource.read();
        }
    }

    function onSelectFpp(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Fund").val(dataItem.Fund).trigger("change");

        var model = $("#grid").data().kendoGrid.editable.options.model;
        model.set('Fund', $('#Fund').val());
    }

    function DataFpp() {
        var text = $("#FPP").data("kendoMultiColumnComboBox").text();
        return {
            department: $("#DeptId").data("kendoMultiColumnComboBox").text(),
            text: text
        };
    }

    function onClickBtnAddOrderItem(e) {
        e.preventDefault();

        //// the master row for this detail

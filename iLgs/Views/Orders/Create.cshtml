@using Kendo.Mvc.UI
@using iLgs.Models
@model iLgs.Models.OrderVM

@{
    ViewBag.Title = "Consolidated Purchase Order Items";
}

<div class="kendo-grid-container p-4 bg-white rounded-lg shadow-sm border border-slate-200">
    <div class="flex justify-between items-center mb-4">
        <div>
            <h3 class="text-lg font-bold text-[#002442]">Purchase Order Items</h3>
            <p class="text-xs text-slate-500">PO Reference: @Model.PoNo | Supplier: @Model.SupName</p>
        </div>
        <div class="text-xs font-mono bg-blue-50 text-blue-800 px-3 py-1 rounded border border-blue-200">
            Client-Side Sorting: @("ACTIVE (ServerOperation: false)")
        </div>
    </div>

    @(Html.Kendo().Grid<OrderItemVM>()
        .Name("ConsolidatedItemsGrid")
        .Columns(columns =>
        {
            columns.Bound(p => p.ItemNo)
                .Title("No.")
                .Width(65)
                .HtmlAttributes(new { @class = "text-center font-mono text-slate-500" })
                .HeaderHtmlAttributes(new { @class = "text-center" });

            columns.Bound(p => p.Category)
                .Title("Catalog Code")
                .Width(130)
                .HtmlAttributes(new { @class = "font-mono font-medium text-[#1a3a5a]" });

            columns.Bound(p => p.Description)
                .Title("Item Description")
                .Width(280);

            columns.Bound(p => p.Unit)
                .Title("Unit")
                .Width(90)
                .HtmlAttributes(new { @class = "text-center" })
                .HeaderHtmlAttributes(new { @class = "text-center" });

            columns.Bound(p => p.Qty)
                .Title("Qty")
                .Width(95)
                .Format("{0:n0}")
                .HtmlAttributes(new { @class = "text-right font-semibold text-[#002442]" })
                .HeaderHtmlAttributes(new { @class = "text-right" })
                .ClientFooterTemplate("<span class='text-xs font-mono font-bold text-slate-700'>Total: #=sum#</span>");

            columns.Bound(p => p.UnitCost)
                .Title("Unit Price (PHP)")
                .Width(135)
                .Format("{0:c2}")
                .HtmlAttributes(new { @class = "text-right font-mono" })
                .HeaderHtmlAttributes(new { @class = "text-right" });

            columns.Bound(p => p.Amount)
                .Title("Total (PHP)")
                .Width(145)
                .Format("{0:c2}")
                .HtmlAttributes(new { @class = "text-right font-mono font-semibold text-[#002442]" })
                .HeaderHtmlAttributes(new { @class = "text-right" })
                .ClientFooterTemplate("<span class='text-xs font-mono font-bold text-[#002442]'>₱#=kendo.toString(sum, 'n2')#</span>");

            columns.Bound(p => p.SourcePrs)
                .Title("Source PRs")
                .Width(140)
                .ClientTemplate("<span class='bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded text-xs'>#=SourcePrs#</span>")
                .Sortable(true);

            columns.Command(command =>
            {
                command.Edit().Text("Edit").UpdateText("Save").CancelText("Cancel");
                command.Destroy().Text("Delete");
            }).Title("Actions").Width(175).HtmlAttributes(new { @class = "text-center" });
        })
        .ToolBar(toolbar =>
        {
            toolbar.Create().Text("Add Consolidated Item");
        })
        .Editable(editable => editable
            .Mode(GridEditMode.InLine)
            .DisplayDeleteConfirmation("Are you sure you want to delete this PO Item?")
        )
        .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn)
    )
        .Filterable(filterable => filterable
            .Extra(false)
            .Operators(operators => operators
                .ForString(str => str.Clear()
                    .Contains("Contains")
                    .StartsWith("Starts with")
                    .IsEqualTo("Is equal to")
                )
            )
        )
        .Pageable(pageable => pageable
            .Refresh(true)
            .PageSizes(new int[] { 5, 10, 20, 50 })
            .ButtonCount(5)
        )
        .DataSource(dataSource => dataSource
            .Ajax()
            // CRITICAL: ServerOperation(false) enables Client-Side Sorting, Paging, and Filtering
            .ServerOperation(false)

            .Aggregates(aggregates =>
            {
                aggregates.Add(p => p.Qty).Sum();
                aggregates.Add(p => p.Amount).Sum();
            })
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.ItemNo).Editable(false);
                model.Field(p => p.Category).DefaultValue("CAT-001");
                model.Field(p => p.Unit).DefaultValue("Unit");
                model.Field(p => p.Qty).DefaultValue(1);
                model.Field(p => p.UnitCost).DefaultValue(0.00m);
                model.Field(p => p.Amount).Editable(false);
                model.Field(p => p.SourcePrs).DefaultValue("PR-2026-001");
            })
            .Read(read => read.Action("GetConsolidatedItems", "Orders", new { poId = Model.Id }))
            .Create(create => create.Action("CreateConsolidatedItem", "Orders", new { poId = Model.Id }))
            .Update(update => update.Action("UpdateConsolidatedItem", "Orders"))
            .Destroy(destroy => destroy.Action("DeleteConsolidatedItem", "Orders"))
            .Events(events => events
                .Error("onGridError")
                .RequestEnd("onGridRequestEnd")
            )
        )
    )
</div>

<script type="text/javascript">
    function onGridError(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function onGridRequestEnd(e) {
        if (e.type === "update" || e.type === "create") {
            // Auto recalculate client side line totals
            var grid = $("#ConsolidatedItemsGrid").data("kendoGrid");
            if (grid) {
                grid.dataSource.read();
            }
        }
    }
</script>

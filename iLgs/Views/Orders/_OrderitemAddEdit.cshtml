@model iLgs.Models.OrderItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.OrderId)
    @Html.HiddenFor(model => model.RisItemId)
    @Html.HiddenFor(model => model.PsNo)
    @Html.HiddenFor(model => model.PsType)
    @Html.HiddenFor(model => model.GridOrderItemExtns)
    @Html.HiddenFor(model => model.Mode)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RequestItemId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.RequestItemId).Enable(Model.Mode == "A")
            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
            .Placeholder("Select stock/property Code")
            .DataTextField("PsNo")
            .DataValueField("Id")
            .ValuePrimitive(true)
            .Filter(FilterType.Contains)
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetPrItemsWithNoPo", "Getters").Data("DataRequestItemId");
                })
                .ServerFiltering(true);
            })
            .Columns(c =>
            {
                c.Add().Field("ItemCode").Title("Item Code").Width("10%");
                c.Add().Field("PsNo").Title("P/S No.").Width("20%");
                c.Add().Field("ItemName").Title("Item Name").Width("20%");
                c.Add().Field("Description").Title("Description").Width("30%");
                c.Add().Field("Unit").Title("Unit").Width("10%");
                c.Add().Field("Qty").Title("Qty").Width("10%");

            })
            .Suggest(true)
            .Events(e =>
            {
                e.Select("onSelectRequestItemId");
                //.DataBound("onDataBoundRequestItemId");
            })
                    )
                    @Html.ValidationMessageFor(m => m.RequestItemId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemCode, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemCode).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemType).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemName, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemName).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextAreaFor(m => m.Description).Rows(2).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Brand, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().ComboBoxFor(m => m.Brand)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .DataTextField("Description")
                        .DataValueField("Description")
                        .Filter("contains")
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetCodes", "Getters", new { mastCode = "BRANDS", text = "" });
                            })
                            .ServerFiltering(false);
                        })
                    )


                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().Grid<iLgs.Models.RisItemExtnVM>()
                    .Name("gridItemExtn")
                    .Columns(col =>
                    {
                        col.Bound(c => c.ItemNo).Width(50);
                        col.Bound(c => c.ItemKey).Width(70);
                        col.Bound(c => c.ItemValue).Width(120);
                        col.Bound(c => c.Sequence).Width(50);
                    })
                    .Sortable()
                    .NoRecords()
                    .Navigatable()
                    .Scrollable(s => s.Height(130))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Batch(true)
                        .Sort(s => s.Add(a => a.ItemNo))
                        .ServerOperation(true)
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Read(read => read.Action("_RISItemExtnBatchRead", "RIS").Data("DataRisItemExtnGrid"))
                    )
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                    .AutoBind(true)
                )
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(m => m.Unit, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Unit).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Qty, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Decimals(2).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Events(e => e.Change("changeAmount"))
                    )
                    @Html.ValidationMessageFor(model => model.Qty)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.UnitCost, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.UnitCost).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Events(e => e.Change("changeAmount"))
                    )
                    @Html.ValidationMessageFor(model => model.UnitCost)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.Amount).Enable(false).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Amount)
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>

    </fieldset>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        //var grid = $("#gridItemExtn").data("kendoGrid");

        //// Get all data items (rows) in the Grid
        //var dataItems = grid.dataItems();

        //// Create an array to store the row values
        //var rowValues = [];

        //// Iterate over each data item (row) and extract the values
        //for (var i = 0; i < dataItems.length; i++) {
        //    var row = dataItems[i];
        //    rowValues.push(row);
        //}

        //$("#GridOrderItemExtns").val(JSON.stringify(rowValues)).trigger("change");

        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("_OrderItemSave", "Orders")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>


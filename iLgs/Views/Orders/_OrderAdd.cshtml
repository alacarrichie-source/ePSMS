@model iLgs.Models.OrderVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()


    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.SupplierName)

    <div class="row">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.PoDate, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-3">
                        @(Html.Kendo().DatePickerFor(m => m.PoDate)
        //.Events(e => e.Change("onChangeDate"))
                        )
                        @Html.ValidationMessageFor(m => m.PoDate)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.PoMode, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.PoMode)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Procurement Mode")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "PROC_MODE", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(m => m.PoMode)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.PrNos, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.PrNos).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(m => m.PrNos)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SupplierId, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.SupplierId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Supplier")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetSupplier", "Getters").Data("DataSupplierId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("40%")
                                    .Template("<span class=\"k-textarea k-readonly \" ><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.Name #</textarea></span>");
                                c.Add().Field("Address").Title("Address").Width("45%")
                                    .Template("<span class=\"k-textarea k-readonly \"><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.Address #</textarea></span>");
                                c.Add().Field("TIN").Title("TIN").Width("15%")
                                    .Template("<span class=\"k-state-default\">#: data.TIN #</span>");
                            })
                            .MinLength(3)
                            .Suggest(true)
                            .Events(e => { e.Select("onSelectSupplier"); })
                        )
                        @Html.ValidationMessageFor(m => m.SupplierId)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SupplierAddress, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.SupplierAddress).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SupplierTin, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.SupplierTin).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.DeliveryPlace, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().MaskedTextBoxFor(m => m.DeliveryPlace).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.DeliveryPlace)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.DeliveryDate, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-3">
                        @(Html.Kendo().DatePickerFor(m => m.DeliveryDate))
                        @Html.ValidationMessageFor(m => m.DeliveryDate)
                    </div>
                </div>
            </div>
        </div>    

        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.TermDelivery, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.TermDelivery)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Delivery Term")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "DELI_TERM", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(m => m.TermDelivery)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.TermPayment, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.TermPayment)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Payment Term")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "PAY_TERM", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(m => m.TermPayment)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SignedBySuppDate, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-3">
                        @(Html.Kendo().DatePickerFor(m => m.SignedBySuppDate))
                        @Html.ValidationMessageFor(m => m.SignedBySuppDate)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SignedByAuthName, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.SignedByAuthName).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.SignedByAuthName)
                    </div>
                </div>
            </div>

            <div class="row">                
                <div class="col-md-12">
                    @Html.LabelFor(m => m.SignedByAuthDesignation, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.SignedByAuthDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.SignedByAuthDesignation)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.CertifiedCorrectBy, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-10">
                        @(Html.Kendo().TextBoxFor(m => m.CertifiedCorrectBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.CertifiedCorrectBy)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.CertifiedCorrectDate, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-3">
                        @(Html.Kendo().DatePickerFor(m => m.CertifiedCorrectDate))
                        @Html.ValidationMessageFor(m => m.CertifiedCorrectDate)
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <span id="span_">
                        @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSaveSelection"))
                        @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancelSelection"))
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @RenderTabstrip()
        </div>        
    </div>
}

@helper RenderTabstrip()
{
    @(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Order Items")
                         .Selected(true)
                         .Content(@<text> @RenderGridItems() </text>);        
            })
    )
}

@helper RenderGridItems()
{
    @(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
                .Name("gridItems")
                .Columns(col =>
                {

                    col.Bound(c => c.Id).Hidden();
                    col.Bound(c => c.PsNo).Width(50);
                    col.Bound(c => c.PsUnit).Width(50);
                    col.Bound(c => c.PsDescription).Width(50);
                    col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Bound(c => c.UnitCost).Width(50);
                    col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Command(command =>
                    {
                        command.Edit();
                        command.Destroy();
                    }).Width(50);
                })
                .ToolBar(toolbar => toolbar.Create())
                //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_OrderItemTemplate").Window(w => w.Width(600).Title("Purchase Order Item")))
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Resizable(r => r.Columns(true))
                .Filterable()
                .Pageable()
                .Sortable()
                .NoRecords()
                .Scrollable(s => s.Height(200))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(10000)
                    .Events(events => events.Error("GridItemError")
                    //.RequestEnd("onGridItemsRequestEnd")
                        )
                    .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Aggregates(a =>
                        {
                            a.Add(p => p.Qty).Sum();
                            a.Add(p => p.Amount).Sum();
                        })
                        .Sort(s =>
                        {
                            s.Add(a => a.InsertedDt);
                        })
                        .Read(read => read.Action("_OrderItemRead", "Orders").Data("DataGridItem"))
                        .Create(create => create.Action("_OrderItemCreate", "Orders"))
                        .Update(update => update.Action("_OrderItemUpdate", "Orders"))
                        .Destroy(destroy => destroy.Action("_OrderItemDestroy", "Orders"))
                )
            //.AutoBind(false)
                .Events(e => e.Edit("onEditGridItems")
                    .Change("onChangeGridItems")
            //.Save("onSaveGridItems")
            //.DataBound("onDataBoundGridItems")
                    )
    )
}

<style>
    #span_ {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: fit-content;
    }
</style>

<script type="text/javascript">
    
    $("#btnSaveSelection").click(function (e) {
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            //window.kendo.ui.progress($("#form"), true);
            //var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            // Get reference to Grid object
            var grid = $("#gridItems").data("kendoGrid");

            if (grid.dataSource.total() == 0) {
                if (!confirm("Save with empty items?")) {
                    return;
                }
            }
            SaveGridItems(e, true);
            //disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancelSelection").click(function (e) {
        e.preventDefault();
        $("#btnCancelSelection").closest(".k-window-content").data("kendoWindow").close();
    });


</script>








@helper RenderTabstrip()
{
    @(Html.Kendo().TabStrip()
    .Name("tabstrip")
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
.SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Order Items")
                         .Selected(true)
                         .Content(@<text> @RenderGridItems() </text>);
                @*items.Add().Text("Other Transferror")
                         .Content(@<text> @RenderGridSellers() </text>);
                items.Add().Text("Other Transferee")
                         .Content(@<text> @RenderGridBuyers() </text>);*@

    })
    )
}

@helper RenderGridItems()
{
    @(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
                .Name("gridItems")
                .Columns(col =>
                {

                    col.Bound(c => c.Id).Hidden();
                    col.Bound(c => c.PsNo).Width(50);
                    col.Bound(c => c.PsUnit).Width(50);
                    col.Bound(c => c.PsDescription).Width(50);
                    col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Command(command =>
                    {
                        command.Edit();
                        command.Destroy();
                    }).Width(50);
                })
                .ToolBar(toolbar => toolbar.Create())
                //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_TtaxItemTemplate").Window(w => w.Width(600).Title("Transfer Tax Item")))
                .Editable(editable => editable.Mode(GridEditMode.InLine))
                .Resizable(r => r.Columns(true))
                .Filterable()
                .Pageable()
                .Sortable()
                .NoRecords()
                .Scrollable(s => s.Height(200))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(10000)
                    .Events(events => events.Error("GridItemError")
                        //.RequestEnd("onGridItemsRequestEnd")
                        )
                    .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);                            
                        })
                        .Aggregates(a =>
                        {
                            a.Add(p => p.Qty).Sum();
                            a.Add(p => p.Amount).Sum();                            
                        })
                        .Sort(s =>
                        {
                            s.Add(a => a.InsertedDt);
                        })
                        .Read(read => read.Action("_OrderItemRead", "Orders").Data("DataGridItem"))
                        .Create(create => create.Action("_OrderItemCreate", "Orders"))
                        .Update(update => update.Action("_OrderItemUpdate", "Orders"))
                        .Destroy(destroy => destroy.Action("_OrderItemDestroy", "Orders"))
                )
            //.AutoBind(false)
                .Events(e => e.Edit("onEditGridItems")
                    .Change("onChangeGridItems")
            //.Save("onSaveGridItems")
            //.DataBound("onDataBoundGridItems")
                    )
    )
}

<script type="text/javascript">
    var ctrlNo = $("#CertNo").val();
    if (ctrlNo != "") {
        $("#OwnerId").prop('disabled', true);
    }

    $("#btnSaveSelection").click(function (e) {
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            //window.kendo.ui.progress($("#form"), true);
            //var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            // Get reference to Grid object
            var grid = $("#gridItems").data("kendoGrid");

            if (grid.dataSource.total() == 0) {
                if (!confirm("Save with empty items?")) {
                    return;
                }
            }
            SaveGridItems(e, true);
            //disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancelSelection").click(function (e) {
        e.preventDefault();
        $("#btnCancelSelection").closest(".k-window-content").data("kendoWindow").close();
    });


    $("#SellerAddress").change(function (e) {
        SaveTtax();
    });

    $("#BusinessLine").change(function (e) {
        SaveTtax();
    });

    $("#NotaryDate").change(function (e) {
        SaveTtax();
    });

    $("#PercentWaived").change(function (e) {
        SaveTtax();
    });

    $("#TtaxDate").change(function (e) {
        SaveTtax();
    });

    //$("#PercentWaived #TtaxDate").change(function (e) {
    //    SaveTtax();
    //});

    $("#SellengPrice").change(function (e) {
        $("#Override").val(false);
        SaveTtax();
    });

    $("#MvSp").change(function (e) {
        $("#Override").val(true);
        SaveTtax();
    });

    function onChangeNoTdn() {
        var isChecked = $('#NoTdn').is(':checked');
        if (isChecked) {
            $("#ARPN").data("kendoMaskedTextBox").value("NO TDN YET");
            $("#PIN").prop("disabled", false).removeClass("k-state-disabled");
            $("#LotNo").prop("disabled", false).removeClass("k-state-disabled");
            $("#BlkNo").prop("disabled", false).removeClass("k-state-disabled");
            $("#Location").prop("disabled", false).removeClass("k-state-disabled");
            $("#Barangay").prop("disabled", false).removeClass("k-state-disabled");
            $("#UnitNo").prop("disabled", false).removeClass("k-state-disabled");
            $("#Building").prop("disabled", false).removeClass("k-state-disabled");
            $("#Subdivision").prop("disabled", false).removeClass("k-state-disabled");
            $("#Area").data("kendoNumericTextBox").enable(true);
            $("#Kind").data("kendoMaskedTextBox").enable(true);
            $("#ARPN").data("kendoMaskedTextBox").enable(false);
        } else {
            $("#ARPN").data("kendoMaskedTextBox").value("");
            $("#PIN").prop("disabled", true).addClass("k-state-disabled");
            $("#LotNo").prop("disabled", true).addClass("k-state-disabled");
            $("#BlkNo").prop("disabled", true).addClass("k-state-disabled");
            $("#Location").prop("disabled", true).addClass("k-state-disabled");
            $("#Barangay").prop("disabled", true).addClass("k-state-disabled");
            $("#UnitNo").prop("disabled", true).removeClass("k-state-disabled");
            $("#Building").prop("disabled", true).removeClass("k-state-disabled");
            $("#Subdivision").prop("disabled", true).removeClass("k-state-disabled");
            $("#Area").data("kendoNumericTextBox").enable(false);
            $("#Kind").data("kendoMaskedTextBox").enable(false);
            $("#ARPN").data("kendoMaskedTextBox").enable(true);
        }
        $("#ARPN").data("kendoMaskedTextBox").trigger("change");
    };

</script>








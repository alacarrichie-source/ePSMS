@model iLgs.Models.OrderItemVM
@Html.HiddenFor(model => model.AllField.Id)

<div class="row k-mb-2">
    <div class="col-md-12">
        <div class="col-md-2">
            @Html.DisplayFor(m => m.AllField.Area, "LabelDecimal")
        </div>
        <div class="col-md-10">
            @(Html.Kendo().TextBoxFor(m => m.AllField.Area).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.AllField.Area)
        </div>
    </div>
</div>
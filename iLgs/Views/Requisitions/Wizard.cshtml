@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Create RIS";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<link rel="stylesheet" href="@Url.Content("~/Content/requisitions.css")" />

<div class="epsms-workflow epsms-requisitions epsms-procurement po-wizard" id="risWizard"
     data-departments="@Url.Action("EligibleDepartments", "Requisitions")"
     data-load="@Url.Action("WizardData", "Requisitions")"
     data-submit="@Url.Action("SubmitWizard", "Requisitions")"
     data-index="@Url.Action("Index", "Requisitions")">
    @Html.AntiForgeryToken()
    <input type="hidden" id="risSubmissionKey" value="@ViewBag.SubmissionKey" />

    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@Url.Action("Index", "Procurement")">Procurement</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@Url.Action("Index", "Requisitions")">Requisitions</a>
        <span class="breadcrumb-separator">&gt;</span>
        <span>Create RIS</span>
    </div>

    <!-- Wizard Header -->
    <div class="wizard-header">
        <div class="wizard-header-content">
            <h1 class="page-title">Create Requisition and Issue Slips</h1>
            <p class="page-subtitle">Select an approved Purchase Order, enter requested and issued supply quantities by PR, and review before official posting.</p>
        </div>
        <div class="wizard-header-actions">
            <a class="btn-procurement-secondary" href="@Url.Action("Index", "Requisitions")">
                <span class="k-icon k-i-close"></span> Cancel &amp; Exit
            </a>
        </div>
    </div>

    <!-- Stepper (AIR Style) -->
    <div class="data-card wizard-stepper-card">
        <div class="wizard-stepper">
            <!-- Step 1 Tab -->
            <div class="wizard-step-item is-active" id="stepIndicator1" onclick="window.risGoToStep && window.risGoToStep(1)">
                <div class="step-circle" id="circle1">1</div>
                <span class="step-label" id="label1">Select Department &amp; PO</span>
            </div>
            <div class="step-line is-pending" id="line1"></div>

            <!-- Step 2 Tab -->
            <div class="wizard-step-item is-pending" id="stepIndicator2" onclick="window.risGoToStep && window.risGoToStep(2)">
                <div class="step-circle" id="circle2">2</div>
                <span class="step-label" id="label2">Requisition Entry</span>
            </div>
            <div class="step-line is-pending" id="line2"></div>

            <!-- Step 3 Tab -->
            <div class="wizard-step-item is-pending" id="stepIndicator3" onclick="window.risGoToStep && window.risGoToStep(3)">
                <div class="step-circle" id="circle3">3</div>
                <span class="step-label" id="label3">Review &amp; Post</span>
            </div>
        </div>
    </div>

    <!-- Wizard Error Alert Banner -->
    <div id="wizardError" class="alert alert-danger" role="alert" style="display:none; margin-bottom: 20px;"></div>

    <!-- ================================================================
         STEP 1: SELECT PURCHASE ORDER
         ================================================================ -->
    <section id="risStep1" class="wizard-card">
        <div class="wizard-card-header">
            <div>
                <h2>Step 1: Select Purchase Order</h2>
                <p class="subtitle">Select a department to display candidate Purchase Orders with available supply quantities. A partially issued PO remains available until fully issued.</p>
            </div>
        </div>

        <!-- Department Filter -->
        <div class="p-3 bg-light rounded border mb-3 d-flex align-items-center gap-3 flex-wrap">
            <label for="wizardDepartment" class="fw-bold small text-secondary mb-0">Department / Office:</label>
            <input id="wizardDepartment" style="width: 380px; max-width: 100%;" />
            <span class="small text-muted">Select an office to load eligible candidate POs</span>
        </div>

        <script>
            function risCandidateFilters() {
                return { department: $("#wizardDepartment").val() };
            }
        </script>

        <!-- Candidate POs Grid -->
        <div class="wizard-grid-container mb-3">
            @(Html.Kendo().Grid<iLgs.Models.RisCandidateVM>()
                .Name("risCandidates")
                .AutoBind(false)
                .Columns(c =>
                {
                    c.Template(@<text></text>)
                        .ClientTemplate("<input type='radio' name='selectedCandidatePo' value='#=Id#' onchange='window.onSelectCandidateRow && window.onSelectCandidateRow(\"#=Id#\")' />")
                        .Width(50)
                        .HeaderHtmlAttributes(new { @class = "text-center" })
                        .HtmlAttributes(new { @class = "text-center" });
                    c.Bound(x => x.PoNo).Title("PO No.").Width(140).HtmlAttributes(new { @class = "font-monospace fw-bold text-primary" });
                    c.Bound(x => x.PoDate).Title("PO Date").Format("{0:MMM dd, yyyy}").Width(120);
                    c.Bound(x => x.Supplier).Title("Supplier").Width(190);
                    c.Bound(x => x.PrNo).Title("PR Reference(s)").Width(140).HtmlAttributes(new { @class = "font-monospace" });
                    c.Bound(x => x.Department).Title("Department").Width(180);
                    c.Bound(x => x.ItemCount).Title("Supply Allocations").Width(110)
                        .HtmlAttributes(new { @class = "text-end font-monospace" })
                        .HeaderHtmlAttributes(new { @class = "text-end" });
                    c.Bound(x => x.PreviousQty).Title("Posted Qty").Format("{0:n2}").Width(110)
                        .HtmlAttributes(new { @class = "text-end font-monospace text-muted" })
                        .HeaderHtmlAttributes(new { @class = "text-end" });
                    c.Bound(x => x.RemainingQty).Title("Remaining Qty").Format("{0:n2}").Width(120)
                        .HtmlAttributes(new { @class = "text-end font-monospace fw-bold text-primary" })
                        .HeaderHtmlAttributes(new { @class = "text-end" });
                    c.Bound(x => x.Status).Title("Status").Width(110).ClientTemplate(
                        "# if (Status == 'Available') { #" +
                            "<span class='status-badge status-available'><span class='k-icon k-i-check-circle'></span> Available</span>" +
                        "# } else { #" +
                            "<span class='status-badge status-partial'><span class='k-icon k-i-clock'></span> Partial</span>" +
                        "# } #"
                    );
                })
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .Sortable()
                .Filterable()
                .Scrollable()
                .NoRecords(n => n.Template("<div class='p-4 text-center text-muted'>Select a department to view candidate Purchase Orders with remaining supplies.</div>"))
                .Pageable(p => p.Refresh(true).PageSizes(new[] { 5, 10, 20 }).ButtonCount(5))
                .DataSource(d => d.Ajax().PageSize(10).Read(r => r.Action("Candidates", "Requisitions").Data("risCandidateFilters")))
            )
        </div>

        <!-- Selected PO Summary Bar (AIR Style) -->
        <div id="step1PoSummaryBar" class="p-3 bg-light rounded border d-flex justify-content-between align-items-center flex-wrap gap-3 mb-2" style="display:none;">
            <div>
                <span class="text-muted small">Selected Purchase Order:</span>
                <div class="fw-bold fs-6 text-primary font-monospace" id="lblSelectedPoNo">--</div>
                <div class="text-muted small" id="lblSelectedPoDetails">--</div>
            </div>
            <div class="text-end">
                <span class="text-muted small">Available Supply Quantity:</span>
                <div class="fw-bold fs-6 text-success font-monospace" id="lblSelectedPoRemaining">0.00</div>
            </div>
        </div>

        <!-- Step 1 Bottom Action Toolbar -->
        <div class="wizard-summary-bar mt-4">
            <div>
                <span class="text-muted small">Selection status: </span>
                <span id="step1SelectionStatusBadge" class="status-badge status-draft">No PO Selected</span>
            </div>
            <button type="button" id="risNext1" class="btn-procurement-primary" disabled="disabled">
                Proceed to Requisition Entry <span class="k-icon k-i-arrow-right"></span>
            </button>
        </div>
    </section>

    <!-- ================================================================
         STEP 2: REQUISITION ENTRY
         ================================================================ -->
    <section id="risStep2" class="wizard-card" style="display:none;">
        <div class="wizard-card-header">
            <div>
                <h2>Step 2: Requisition Entry &mdash; <span class="ris-po-badge ris-po"></span></h2>
                <p class="subtitle">Enter requested and issued quantities per Purchase Request. Issued quantity cannot exceed requested quantity or current remaining availability.</p>
            </div>
        </div>

        <!-- Dynamic PR Entry Groups Container -->
        <div id="risEntryGroups"></div>

        <!-- Step 2 Bottom Action Toolbar -->
        <div class="wizard-summary-bar mt-4">
            <button type="button" id="risBack2" class="btn-procurement-secondary">
                <span class="k-icon k-i-arrow-left"></span> Back to PO Selection
            </button>
            <button type="button" id="risNext2" class="btn-procurement-primary">
                Proceed to Review &amp; Post <span class="k-icon k-i-arrow-right"></span>
            </button>
        </div>
    </section>

    <!-- ================================================================
         STEP 3: REVIEW & POST
         ================================================================ -->
    <section id="risStep3" class="wizard-card" style="display:none;">
        <div class="wizard-card-header">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="mb-0">Step 3: Review &amp; Post &mdash; <span class="ris-po-badge ris-po"></span></h2>
                    <span class="status-badge status-submitted"><span class="k-icon k-i-check"></span> Ready for Posting</span>
                </div>
                <p class="subtitle">Each participating PR will generate its own formal RIS record. Review entered signatory and allocation details before final confirmation.</p>
            </div>
        </div>

        <!-- Summary Metrics Cards Grid -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border text-center">
                    <span class="text-muted small d-block mb-1">Participating PRs</span>
                    <strong class="fs-5 text-primary" id="revPrCount">0</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border text-center">
                    <span class="text-muted small d-block mb-1">Total Allocated Qty</span>
                    <strong class="fs-5 text-secondary" id="revAllocatedQty">0.00</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border text-center">
                    <span class="text-muted small d-block mb-1">Total Requested Qty</span>
                    <strong class="fs-5 text-dark" id="revRequestedQty">0.00</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-primary bg-opacity-10 rounded border border-primary text-center">
                    <span class="text-primary small fw-bold d-block mb-1">Total Issued Qty</span>
                    <strong class="fs-5 text-primary" id="revIssuedQty">0.00</strong>
                </div>
            </div>
        </div>

        <!-- Dynamic PR Review Groups Container -->
        <div id="risReviewGroups"></div>

        <!-- Step 3 Bottom Action Toolbar -->
        <div class="wizard-summary-bar mt-4">
            <button type="button" id="risBack3" class="btn-procurement-secondary">
                <span class="k-icon k-i-arrow-left"></span> Back to Requisition Entry
            </button>
            <button type="button" id="risPostAll" class="btn-procurement-primary">
                <span class="k-icon k-i-check"></span> Post RIS
            </button>
        </div>
    </section>

    <!-- Post Confirmation Modal (AIR Style) -->
    @(Html.Kendo().Window()
        .Name("risPostConfirm")
        .Title("CONFIRM RIS POSTING")
        .Width(480)
        .Modal(true)
        .Visible(false)
        .Actions(actions => actions.Close())
        .Content(@<text>
            <div class="p-3">
                <div class="alert alert-info mb-3" style="background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; border-radius:6px; padding:12px;">
                    <strong style="display:block; margin-bottom:4px;"><span class="k-icon k-i-check-outline text-primary"></span> Ready to Post Requisition &amp; Issue Slips</strong>
                    <span style="font-size:12px; line-height:1.4; display:block;">
                        This will generate official sequential RIS numbers and obligate the specified issued quantities from inventory.
                    </span>
                </div>
                <p id="risPostModalSummary" class="small text-secondary mb-3"></p>
                <div class="d-flex justify-content-end gap-2 mt-4" style="display:flex; justify-content:flex-end; gap:8px;">
                    <button type="button" class="btn-procurement-secondary" id="risCancelPost">Cancel</button>
                    <button type="button" class="btn-procurement-primary" id="risConfirmPost">
                        <span class="k-icon k-i-check"></span> Confirm &amp; Post
                    </button>
                </div>
            </div>
        </text>)
    )
</div>

<script src="@Url.Content("~/Scripts/requisitions-wizard.js")"></script>

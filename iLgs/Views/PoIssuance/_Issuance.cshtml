@(Html.Kendo().Grid<iLgs.Models.PsCardItemTransferIssuanceVM>()
    .Name("gridIssuedItems_" + @ViewData["TransferId"])
    .Columns(col =>
    {
        col.Bound(c => c.IssuedDate).Width(40);
        col.Bound(c => c.IssuedToDescription).Width(50);
        //col.Bound(c => c.Location).Width(150);
        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.InsertedDt).Width(40);
        col.Bound(c => c.InsertedBy).Width(40);        

        if ((bool)@ViewData["IsViewOnly"] != true)
        { 
            col.Command(command =>
            {
                if ((bool)@ViewData["IsWithItemExtn"] != true)
                {
                    command.Edit();
                }
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridItems").SendDataKeys(true);
            }).Width(100);
        }
    })
    .ToolBar(t =>
    {
        if ((bool)@ViewData["IsViewOnly"] != true)
        {
            t.Create().Text("Issue Item/s");
        }
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_IssuanceTemplate").Window(w => w.Width(1000)))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItems"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.PsCardItemTransferId).DefaultValue(@ViewData["TransferId"]);
            model.Field(p => p.DeptId).DefaultValue(@ViewData["DeptId"]);
            //model.Field(p => p.LocationId).DefaultValue(@ViewBag.DefaultLocation);
            model.Field(p => p.UnitCost).DefaultValue(@ViewData["UnitCost"]);
            model.Field(p => p.IssuedToSw).DefaultValue(1);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Sort(s => s.Add(a => a.IssuedDate))
        //.Group(g => g.Add(a => a.RefType))
        .Read(read => read.Action("_IssuanceRead", "PoIssuance", new { transferId = @ViewData["TransferId"] }))
        .Create(create => create.Action("_IssuanceCreate", "PoIssuance"))
        .Update(update => update.Action("_IssuanceUpdate", "PoIssuance"))
        .Destroy(destroy => destroy.Action("_IssuanceDestroy", "PoIssuance"))
    )
.Selectable(s => s.Mode(GridSelectionMode.Single))
.Events(e => e
    .Edit("onEditGridItems")
    .Change("onChangeGridItems")
    .DataBound("onDataBoundGridItems")
    )
)
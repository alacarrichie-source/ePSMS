@{
    ViewBag.Title = "PO Issuance - Summary";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
    .Name("grid")
    //.HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Group(group =>
        {
            group.Title("Receipt Quantity").HeaderHtmlAttributes(new { Style = "text-align:center;" })
            .Columns(col =>
            {
                col.Group(g =>
                {
                    g.Title("Originating Department").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.Department).Width(150).Title("PO Owner");
                        info.Bound(f => f.Qty)
                          .Width(50).Title("In")
                          .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                          .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                          .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
                col.Group(g =>
                {
                    g.Title("Intermediary").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.LocCode).Width(50).Title("Code");
                        info.Bound(f => f.Location).Width(100).Title("Location");
                        info.Bound(f => f.TransferIn)
                            .Width(50).Title("Transfer<br>In")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
            });
        });
        columns.Group(group => group.Title("Released Quantity")
            .Columns(info =>
            {
                info.Bound(f => f.TransferOut)
                    .Width(50).Title("Transfer<br>Out")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.QtyIss)
                    .Width(50).Title("Issued")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.QtyBal).Width(50).Title("Balance<br>Quantity")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });        
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Department, "contains");
        s.Field(o => o.LocCode, "contains");
        s.Field(o => o.Location, "contains");    
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.TransferIn).Sum();
            a.Add(p => p.TransferOut).Sum();
            a.Add(p => p.QtyBal).Sum();
        })
        .Sort(s =>
        {
            s.Add(a => a.Department);
            s.Add(a => a.InsertedDt);
        })
        .Read(read => read.Action("SummaryRead", "PoIssuance"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            //.HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Issuances")
                    .Selected(true)
                    .LoadContentFrom("_Issuance", "PoIssuance", new { cardItemId = "#=Id#", unitCost = "#=UnitCost#", deptId = "#=DeptId#" });
                items.Add().Text("Items")
                    .LoadContentFrom("_getItemExtn", "PoIssuance", new { cardItemId = "#=Id#" });
                //items.Add().Text("PARs")
                //    .LoadContentFrom("_Pars", "PoIssuance", new { cardItemId = "#=Id#", UnitCost = "#=UnitCost#" });
                //items.Add().Text("ICS")
                //    .LoadContentFrom("_Ics", "PoIssuance", new { cardItemId = "#=Id#", UnitCost = "#=UnitCost#" });
            }).ToClientTemplate())
</script>


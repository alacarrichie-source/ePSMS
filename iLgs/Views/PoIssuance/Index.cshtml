@{
    ViewBag.Title = "PO Issuance";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
    .Name("grid")
    //.HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(f => f.Fund).Width(40);
        columns.Bound(f => f.Account).Width(70);
        columns.Bound(f => f.Article).Width(100).Title("Sub-Accounts/Articles");
        columns.Bound(f => f.StockNo).Width(70);
        columns.Bound(f => f.Description).Width(70).Title("Item<br>Description");
        columns.Group(group => group.Title("Reference")
            .Columns(info =>
            {
                info.Bound(f => f.PoNo).Width(50);
                info.Bound(f => f.PoDate).Width(50);
                //info.Bound(f => f.AirNo).Width(50);
                //info.Bound(f => f.AirDate).Width(50);
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.UnitCost).Width(50).Title("PO<br>Unit Cost")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //columns.Bound(f => f.Unit).Width(50).Title("Unit<br>of<br>Measurement");
        columns.Bound(f => f.Unit).Width(50).Title("Unit");
        columns.Group(group =>
        {
            group.Title("Receipt Quantity").HeaderHtmlAttributes(new { Style = "text-align:center;" })
            .Columns(col =>
            {
                col.Group(g =>
                {
                    g.Title("Originating Department").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.DeptCode).Width(50).Title("Code");
                        info.Bound(f => f.Department).Width(70).Title("PO Owner");
                        info.Bound(f => f.Qty)
                          .Width(50).Title("In")
                          .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                          .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                          .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
                col.Group(g =>
                {
                    g.Title("Intermediary").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.LocCode).Width(50).Title("Code");
                        info.Bound(f => f.Location).Width(50).Title("Location");
                        info.Bound(f => f.TransferIn)
                            .Width(50).Title("Transit<br>In")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
            });
        });
        columns.Group(group => group.Title("Released Quantity")
            .Columns(info =>
            {
                info.Bound(f => f.TransferOut)
                    .Width(50).Title("Transit<br>Out")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.QtyIss)
                    .Width(50).Title("Issued")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.QtyBal).Width(50).Title("Balance<br>Quantity")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        columns.Bound(f => f.InvDistDesc).Width(50).Title("Inventory / <br>For Distribution");
    })
    .ToolBar(t =>
    {
        t.Custom().Text("Transit Selected Record").IconClass("k-icon k-i-add").Name("btnTransfer").HtmlAttributes(new { @class = "k-button", href = "" });        
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.StockNo, "contains");
        s.Field(o => o.DeptCode, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.LocCode, "contains");
        s.Field(o => o.Location, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.AirNo, "contains");
        s.Field(o => o.Article, "contains");
        s.Field(o => o.Description, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.TransferIn).Sum();
            a.Add(p => p.TransferOut).Sum();
            a.Add(p => p.QtyBal).Sum();
        })
        .Sort(s =>
        {
            s.Add(a => a.PoNo);
            s.Add(a => a.StockNo);
            s.Add(a => a.InsertedDt);
        })
        .Read(read => read.Action("IssuanceRead", "PoIssuance"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)


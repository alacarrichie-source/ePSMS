        var selectedRows = grid.select();

        // Gather the IDs of the selected items
        var selectedIds = selectedRows.map(function () {
            var dataItem = grid.dataItem(this);
            return dataItem.Id;
        }).get();

        var countSelectedIds = selectedIds.length;
        $("#Qty").data("kendoNumericTextBox").value(countSelectedIds);
        $("#Qty").data("kendoNumericTextBox").trigger("change");

        // Update the hidden field with the selected IDs
        $("#SelectedIds").val(selectedIds.join(",")).trigger("change");
    }

    function onDataBoundGridSelection(e) {
        var grid = this;
        var psCardItemExtnId = selectedItemId;

        // Iterate over each data item and check the checkbox if Id is in the pre-selected list
        grid.items().each(function () {
            var dataItem = grid.dataItem(this);

            $.ajax({
                type: "POST",
                url: '@Url.Action("IsSelected", "PoIssuance")',
                data: { psCardItemExtnId: psCardItemExtnId, refId: dataItem.Id },
                async: true,
                success: function (result) {
                    if (result.Errors == "" && result.IsSelected == true) {
                        grid.select(this); // Select the row if Id is in the pre-selected list
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        });
    }

@{
    ViewBag.Title = "PO Issuance";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PoIssuanceVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.PoDate).Width(50);
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.PrNo).Width(50);
        col.Bound(c => c.RisNo).Width(50);
        col.Bound(c => c.AirNo).Width(50);
        col.Bound(c => c.StockNo).Width(100);
        //col.Bound(c => c.StockName).Width(150);
        col.Bound(c => c.ItemName).Width(100);
        col.Bound(c => c.Description).Width(100);
        //col.Bound(c => c.Brand).Width(70);
        col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.QtyIss).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Balance).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .ToolBar(t =>
    {
        t.Custom().Text("Generate PARs").IconClass("k-icon k-i-add").Name("btnAddPars").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Generate ICS").IconClass("k-icon k-i-add").Name("btnAddIcs").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Department, "contains");
        s.Field(o => o.PoDate, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.RisNo, "contains");
        s.Field(o => o.AirNo, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.Balance).Sum();
        })
        .Read(read => read.Action("IssuanceRead", "PoIssuance"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            //.HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Issued Items")
                    .Selected(true)
                    .LoadContentFrom("_RISIssued", "PoIssuance", new { OrderItemId = "#=OrderItemId#", RisItemId = "#=RisItemId#", UnitCost = "#=UnitCost#" });
            }).ToClientTemplate())
</script>


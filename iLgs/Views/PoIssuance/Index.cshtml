<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
            //var subGridName = $(e.sender).closest(".k-grid").attr("id");
            //$("#" + subGridName).data("kendoGrid").dataSource.read();
        }
    }
    //$(window).on("resize", function () {
    //    var gridElement = $("#grid"),
    //        dataArea = gridElement.find(".k-grid-content"),
    //        gridHeight = gridElement.innerHeight(),
    //        otherElements = gridElement.children().not(".k-grid-content"),
    //        otherElementsHeight = 0;
    //        otherElements.each(function () {
    //            otherElementsHeight += $(this).outerHeight();
    //        });
    //    dataArea.height(gridHeight - otherElementsHeight);
    //});

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');

                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");

                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null; // airItemId
    var selectedOrderItemId = null;
    var selectedRisItemId = null;
    var selectedItemId = null;
    var selectedUnitCost = null;
    var selectedDepartment = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedOrderItemId = selectedData.OrderItemId;
        selectedRisItemId = selectedData.RisItemId;
        selectedUnitCost = selectedData.UnitCost;
        selectedItemId = null;
        selectedDepartment = selectedData.Department;
        postedBy = null;
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }
    }

    function onRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
        }
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "800",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

    $(".k-grid-btnAddPars").click(function (e) {
        e.preventDefault();
        GeneratePar("PAR");
    });

    $(".k-grid-btnAddIcs").click(function (e) {
        e.preventDefault();
        GeneratePar("ICS");
    });

    function GeneratePar(refType) {
        var myTitle = refType == "PAR" ? "Generate PAR" : "Generate ICS";
        var width = 500;

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#gridIssuedItems_" + selectedOrderItemId).data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_GeneratePAR", "PoIssuance")',
            data: {
                airItemId: selectedId,
                orderItemId: selectedOrderItemId,
                refType: refType
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    function onSelectLocationId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationCode").val(dataItem.Code).trigger("change");
    }

    // Grid Item

    function onGridItemClickAdd(e) {
        e.preventDefault();
        var orderItemId = $(e.sender.element).data("orderitemid");

        selectedGrid = $("#gridIssuedItems_" + orderItemId).data("kendoGrid");
        if (selectedGrid) {
            selectedGrid.addRow();
        }
    }

    function onGridItemClickPost(e) {
        e.preventDefault();
        var orderItemId = $(e.sender.element).data("orderitemid");

        selectedGrid = $("#gridIssuedItems_" + orderItemId).data("kendoGrid");        
        var selectedRow = selectedGrid.select();
        var dataItem = selectedGrid.dataItem(selectedRow);
        var postedBy = dataItem.PostedBy;        
        
        if (postedBy) {
            alert("Record is already posted by " + postedBy);
        }
        else {
            var msg = "";
            if (dataItem.RefType) {
                msg = "Post " + dataItem.RefType + " No. " + dataItem.RefNo + "?";
            } else {
                msg = "Post selected record?";
            }

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostIssuance", "PoIssuance")',
                    data: { risIssuedId: dataItem.Id },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record Posted...", "info");
                            //$("#grid").data("kendoGrid").dataSource.read();
                            selectedGrid.dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    }

    function onGridItemClickUnPost(e) {
        e.preventDefault();
        var orderItemId = $(e.sender.element).data("orderitemid");

        selectedGrid = $("#gridIssuedItems_" + orderItemId).data("kendoGrid");
        var selectedRow = selectedGrid.select();
        var dataItem = selectedGrid.dataItem(selectedRow);        
        var msg = "";

        if (dataItem.RefType) {
            msg = "Unpost " + dataItem.RefType + " No. " + dataItem.RefNo + "?";
        } else {
            msg = "Unpost selected record?";
        }

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UnpostIssuance", "PoIssuance")',
                data: { risIssuedId: selectedItemId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        //$("#grid").data("kendoGrid").dataSource.read();
                        selectedGrid.dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    }

    var postedBy = null;
    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        var orderItemId = selectedData.OrderItemId;

        // the master row for this detail
        //var parentRow = this.wrapper.closest("tr").prev();
        //var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        //var orderItemId = parentModel.OrderItemId;

        selectedItemId = selectedData.Id;
        postedBy = selectedData.PostedBy
        if (postedBy) {
            $("#btnUnpost_" + orderItemId).show();
            $("#btnPost_" + orderItemId).hide();
        } else {
            $("#btnUnpost_" + orderItemId).hide();
            $("#btnPost_" + orderItemId).show();
        }                
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);
        var orderItemId = parentModel.OrderItemId;
        
        if (parentModel.IsProperty)  {
            $("#btnAddItem_" + orderItemId).show();
        } else {
            $("#btnAddItem_" + orderItemId).hide();
        }
        
        var grid = $("#gridIssuedItems_" + orderItemId);
        if (this.dataSource.data().length == 0) {
            $("#btnUnpost_" + orderItemId).hide();
            $("#btnPost_" + orderItemId).hide();
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);
        var IsProperty = parentModel.IsProperty;

        parentGrid.select(parentRow);
        selectedGrid = e.sender;

        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedItemId = null;
            e.model.set("RisItemId", selectedRisItemId);
            $("#div_reference").hide();
        } else {
            if (!e.model.get("RefNo")) {
                $("#div_reference").hide();
            }
            selectedItemId = e.model.get("Id");
            e.model.set("UnitCost", selectedUnitCost);
            var rowitem = selectedGrid.dataSource.get(selectedItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onClickDeleteGridItem(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function onRequestEndGridtems(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                //$("#gridIssuedItems_" + selectedId).data("kendoGrid").dataSource.read();
                var grid = $("#grid").data("kendoGrid");

                //$("#grid").data("kendoGrid").dataSource.read();

                // Trigger a read operation on the data source.
                grid.dataSource.read().then(function () {
                    // Additional actions to be performed after the read operation.

                    // Find the row with the specified Id.
                    var dataItem = grid.dataSource.get(selectedOrderItemId);

                    // If the row is found, expand it.
                    if (dataItem) {
                        var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                        grid.expandRow(row);
                    }
                });
            }
        }
    }

    function onChangeQty(e) {
        e.preventDefault();
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").val();
        $("#Amount").data("kendoNumericTextBox").value(qty * unitCost);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function DataAccountableOfficer() {
        var text = $("#Officer").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#Officer").data("kendoMultiColumnComboBox").value();
        }
        return {
            department: selectedDepartment,
            text: text
        };
    }

    function DataOfficerId() {
        var text = $("#OfficerId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OfficerId").data("kendoMultiColumnComboBox").value();
        }
        return {
            deptId: $("#LocationId").val(),
            text: text
        };
    }

</script>




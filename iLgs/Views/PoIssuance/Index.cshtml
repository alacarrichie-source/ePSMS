    function onSelectIssuedTo(e) {
        var dataItem = this.dataItem(e.item.index());
        var issuedTo = dataItem.Description;

        if (issuedTo.includes("Department"))
        {
            $("#DIV_DEPARTMENT").removeClass("hidden");
            $("#DIV_LOCATION").addClass("hidden");
        }
        else if (issuedTo == "Location" || issuedTo == "Disposal") {
            $("#DIV_LOCATION").removeClass("hidden");
            $("#DIV_DEPARTMENT").addClass("hidden");
        }
        else {
            $("#DIV_LOCATION").addClass("hidden");
            $("#DIV_DEPARTMENT").addClass("hidden");
        }
    }

    function onDataBoundIssuedTo(e) {
        // Use 'this' to get the ComboBox instance
        var comboBox = this;

        // Get the default value of the ComboBox
        var defaultValue = comboBox.value();

        // Check the default value and adjust the visibility of DIV_DEPARTMENT
        if (defaultValue.includes("Department")) {
            $("#DIV_DEPARTMENT").removeClass("hidden");
            $("#DIV_LOCATION").addClass("hidden");
        } else if (defaultValue == "Location" || defaultValue == "Disposal") {
            $("#DIV_LOCATION").removeClass("hidden");
            $("#DIV_DEPARTMENT").addClass("hidden");
        } else {
            $("#DIV_LOCATION").addClass("hidden");

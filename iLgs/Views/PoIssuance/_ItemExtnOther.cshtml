@(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnOther>()
    .Name("gridItemExtn_" + @ViewData["CardItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.SerialNo).Width(100);
    })
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Read(read => read.Action("_ItemExtnOtherRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"] }))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
)

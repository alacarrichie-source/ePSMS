@(Html.Kendo().Grid<iLgs.Models.RisIssuedVM>()
    .Name("gridIssuedItems_" + @ViewData["OrderItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.IssuedDate).Width(70);
        col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });        
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.ReceivedBy).Width(70);
        col.Command(command =>
        {
            command.Edit();
            //command.Destroy();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridItem").SendDataKeys(true);
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RISIssuedTemplate").Window(w => w.Width(550)))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridtems")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.RisItemId).DefaultValue(@ViewData["RisItemId"]);
            model.Field(p => p.UnitCost).DefaultValue(@ViewData["UnitCost"]);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("_RISIssuedRead", "PoIssuance", new { risItemId = @ViewData["RisItemId"]}))
        .Create(create => create.Action("_RISIssuedCreate", "PoIssuance"))
        .Update(update => update.Action("_RISIssuedUpdate", "PoIssuance"))
        .Destroy(destroy => destroy.Action("_RISIssuedDestroy", "PoIssuance"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e.Edit("onEditGridItems").Change("onChangeGridItems").DataBound("onDataBoundGridItems"))
)

@(Html.Kendo().Grid<iLgs.Models.RisIssuedVM>()
    .Name("gridIssuedItems_" + @ViewData["OrderItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.Location).Width(70);
        //col.Bound(c => c.Officer).Width(70);
        col.Bound(c => c.IssuedTo).Width(50);
        col.Bound(c => c.IssuedDate).Width(40);
        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //col.Group(group => group.Title("For PAR/ICS")
        //    .Columns(info =>
        //    {
        //        info.Bound(c => c.RefType).Width(40);
        //        info.Bound(c => c.RefDate).Width(50);
        //        info.Bound(c => c.RefNo).Width(50);
        //        info.Bound(c => c.PropNo).Width(120);
        //    }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        //);
        col.Bound(c => c.PostedBy).Width(50);
        col.Command(command =>
        {
            command.Edit();
            //command.Destroy();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridItem").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Template(@<text>
        @(Html.Kendo().Button().Name("btnAddItem_" + @ViewData["OrderItemId"]).Content("Add Order Item").Icon("k-icon k-i-add")
            .HtmlAttributes(new { data_orderItemId = @ViewData["OrderItemId"] }).Events(events => events.Click("onGridItemClickAdd")))
        @(Html.Kendo().Button().Name("btnPost_" + @ViewData["OrderItemId"]).Content("Post").Icon("k-icon k-i-lock")
            .HtmlAttributes(new {data_orderItemId = @ViewData["OrderItemId"] }).Events(events => events.Click("onGridItemClickPost")))
        @(Html.Kendo().Button().Name("btnUnpost_" + @ViewData["OrderItemId"]).Content("Unpost").Icon("k-icon k-i-unlock")
            .HtmlAttributes(new { data_orderItemId = @ViewData["OrderItemId"] }).Events(events => events.Click("onGridItemClickUnPost")))
        </text>);
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RISIssuedTemplate").Window(w => w.Width(550)))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridtems")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.OrderItemId).DefaultValue(@ViewData["OrderItemId"]);
            model.Field(p => p.RisItemId).DefaultValue(@ViewData["RisItemId"]);
            model.Field(p => p.UnitCost).DefaultValue(@ViewData["UnitCost"]);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Sort(s => s.Add(a => a.RefNo))
        //.Group(g => g.Add(a => a.RefType))
        .Read(read => read.Action("_RISIssuedRead", "PoIssuance", new { risItemId = @ViewData["RisItemId"] }))
        .Create(create => create.Action("_RISIssuedCreate", "PoIssuance"))
        .Update(update => update.Action("_RISIssuedUpdate", "PoIssuance"))
        .Destroy(destroy => destroy.Action("_RISIssuedDestroy", "PoIssuance"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e.Edit("onEditGridItems").Change("onChangeGridItems").DataBound("onDataBoundGridItems"))
)

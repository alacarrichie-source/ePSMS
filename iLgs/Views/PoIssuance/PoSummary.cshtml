        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Total).Sum();
            a.Add(p => p.IssQtyCur).Sum();
            a.Add(p => p.IssQtyPrev1).Sum();
            a.Add(p => p.IssQtyPrev2).Sum();
            a.Add(p => p.IssQtyPrev3).Sum();
            a.Add(p => p.IssQtyTotal).Sum();
            a.Add(p => p.IssQtyBalance).Sum();
            a.Add(p => p.IssAmtCur).Sum();
            a.Add(p => p.IssAmtPrev1).Sum();
            a.Add(p => p.IssAmtPrev2).Sum();
            a.Add(p => p.IssAmtPrev3).Sum();
            a.Add(p => p.IssAmtTotal).Sum();
            a.Add(p => p.IssAmtBalance).Sum();
        })

        {
            x.Add(y => y.Department);
            x.Add(y => y.PoNo);
            //x.Add(y => y.PoDate);
            //x.Add(y => y.Account);
        })
        .Sort(s =>
        {
            s.Add(a => a.PoNo);
            s.Add(a => a.PoDate);
            s.Add(a => a.Account);
        })

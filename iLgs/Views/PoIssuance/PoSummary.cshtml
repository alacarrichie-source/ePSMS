@{
    ViewBag.Title = "PO Issuance - Summary by PO";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Issuance Year", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-6">
            @(Html.Kendo().DropDownList()
                .Name("forYear")
                .DataTextField("Description")
                .DataValueField("Description")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GePoYear", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Events(e => e.Change("blankGrid"))
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-6">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("deptId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Department")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserDepartmentsWithAllAsync", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                //.Events(e => e.Select("onSelectDeptId").Change("onChangeDeptId"))
                .Events(e => e.Change("blankGrid"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        <div class="col-md-2">
            &nbsp;
        </div>
        <div class="col-md-3">
            @(Html.Kendo().Button().Name("btnSubmit").Content("Submit").ThemeColor(ThemeColor.Primary)
            .Events(e => e.Click("refreshGrid")))
        </div>
    </div>
</div>



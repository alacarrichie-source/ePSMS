@model iLgs.Models.PsCardItemTransferIssuanceVM
@{
    ViewBag.Mode = Model.Id == Guid.Empty ? "ADD" : "EDIT";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.PsCardItemTransferId)
    @Html.HiddenFor(m => m.UnitCost)
    @Html.HiddenFor(m => m.IssuedToCode)
    @Html.HiddenFor(m => m.IssuedToDescription)
    @Html.HiddenFor(m => m.SelectedIds)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.IssuedDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedDate)
                </div>
            </div>
        </div>
        
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.LocationId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetLocationSp", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("10%");
                                c.Add().Field("Desc3").Title("Main-Location").Width("50%").Template("#= columnTemplate(data.Desc3) #");
                                c.Add().Field("Desc2").Title("Location").Width("40%").Template("#= columnTemplate(data.Desc2) #");
                            })
                            .Events(e => e.Select("onSelectLocationIdIssuance").DataBound("onDataBoundLocationIdIssuance"))
                            .Suggest(false)
                    )
                    @Html.ValidationMessageFor(m => m.LocationId)
                </div>
            </div>
        </div>

        <br />

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Qty, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.Qty).Decimals(0).Format("{0:n0}").Spinners(false)
                        .Events(e => e.Change("changeAmount"))
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Enable((bool)@ViewData["IsWithItemExtn"] != true)
                        )
                    @Html.ValidationMessageFor(m => m.Qty)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Amount, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.Amount).Decimals(0).Format("{0:n2}").Enable(false).Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Amount)
                </div>
            </div>
        </div>

        @*<br />
        <div id="DIV_SELECTION">
            <div class="row" style="padding-left:20px;padding-right:20px;">
                <h4>Available Items:</h4>
                @RenderGridSelections();
            </div>
        </div>*@

        @if ((bool)@ViewData["IsWithItemExtn"] == true)
        {
            @(Html.Kendo().TabStrip()
                .Name("tabStrip_Item")
                //.HtmlAttributes(new { @class = "no-text-tabstrip" })
                .TabPosition(TabStripTabPosition.Top)
                .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                .SelectedIndex(0)
                .Items(items =>
                {
                items.Add().Text("Items").Selected(true)
                    .Content(@<text>@RenderGridSelections();</text>);
                }))
}

    </fieldset>
}

@helper RenderGridSelections()
{
if ((string)@ViewData["ItemExtnName"] == "ItemExtnOther")
{
        @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnOther>()
                .Name("gridSelections")
                .Columns(col =>
                {
                    col.Select().Width(30);
                    col.Bound(c => c.SetLotNo).Width(50).Title("Group No.");
                    col.Bound(c => c.SetLotQtyNo).Width(50).Title("Set/Lot No.");
                    col.Bound(c => c.ContentNo).Width(50).Title("Item Qty No.");
                    col.Bound(c => c.SerialNo).Width(150);                    
                })
                .Filterable()
                .NoRecords()
                .Resizable(r => r.Columns(true))
                .Selectable(s => s.Mode(GridSelectionMode.Multiple))
                .Sortable()
                .Scrollable(s => s.Height(200))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events => events.Error("GridError"))
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                    })
                    .Sort(s =>
                    {
                        s.Add(a => a.SerialNo);
                    })
                    .Read(read => read.Action("_ItemExtnOtherSelectionRead", "PoIssuance", new { transferId = @ViewData["TransferId"] }))
                )
                .Events(e => e.Change("onChangeGridSelection").DataBound("onDataBoundGridSelection"))
                .AutoBind(true)
        )
}
else if ((string)@ViewData["ItemExtnName"] == "ItemExtnVehicle")
{
        @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnVehicle>()
            .Name("gridSelections")
            .Columns(col =>
            {
                col.Select().Width(30).Visible(ViewBag.Mode == "ADD");
                col.Bound(c => c.SetLotNo).Width(50).Title("Group No.");
                col.Bound(c => c.SetLotQtyNo).Width(50).Title("Set/Lot No.");
                col.Bound(c => c.ContentNo).Width(50).Title("Item Qty No.");
                col.Bound(c => c.YearModel).Width(50);
                col.Bound(c => c.PlateNo).Width(50);
                col.Bound(c => c.ConductionNo).Width(50);
                //col.Bound(c => c.BodyNo).Width(70);
                //col.Bound(c => c.EngineNo).Width(70);
                //col.Bound(c => c.ChasisNo).Width(70);
                //col.Bound(c => c.Color).Width(50);
                //col.Bound(c => c.CRN).Width(70);
                //col.Bound(c => c.CRDate).Width(50);
                //col.Bound(c => c.MVFileNo).Width(70);
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Selectable(s => s.Mode(GridSelectionMode.Multiple))
            .Sortable()
            .Scrollable(s => s.Height(200))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Sort(s =>
                {
                    s.Add(a => a.PlateNo);
                })
                .Read(read => read.Action("_ItemExtnVehicleSelectionRead", "PoIssuance", new { transferId = @ViewData["TransferId"] }))
            )
            .Events(e => e.Change("onChangeGridSelection").DataBound("onDataBoundGridSelection"))
            .AutoBind(true)
        )
}
}





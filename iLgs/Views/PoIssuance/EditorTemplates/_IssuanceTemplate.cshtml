@model iLgs.Models.PsCardItemIssuanceVM
@{ 
    ViewBag.Mode = Model.Id == Guid.Empty ? "ADD" : "EDIT";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardItemId)
    @Html.HiddenFor(model => model.UnitCost)
    @Html.HiddenFor(model => model.IssuedToCode)
    @Html.HiddenFor(model => model.IssuedToDescription)
    @Html.HiddenFor(model => model.SelectedIds)
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.IssuedDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.IssuedTo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().ComboBoxFor(m => m.IssuedTo)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Issued To")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetIssuedTo", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Events(e => e.Select("onSelectIssuedTo").DataBound("onDataBoundIssuedTo"))
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.IssuedTo)
                </div>
            </div>
        </div>

        <div id="DIV_DEPARTMENT" class="hidden">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.DeptId, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.DeptId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Department")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    //read.Action("GetCodeList", "Getters", new { mastCode = "DEPARTMENTS", addAll = false });
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => e.Select("onSelectDeptIdIssuance"))
                            .Enable(false)
                        )
                        @Html.ValidationMessageFor(model => model.DeptId)
                    </div>
                </div>
            </div>
        </div>

        <div id="DIV_LOCATION" class="hidden">
            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.LocationId, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "LOCATIONS", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => e.Select("onSelectLocationIdIssuance"))
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(model => model.LocationId)
                    </div>
                </div>
            </div>
        </div>

        <br />

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Qty, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.Qty).Decimals(0).Format("{0:n0}").Spinners(false)
                        .Events(e => e.Change("changeAmount"))
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Qty)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Amount, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.Amount).Decimals(0).Format("{0:n2}").Enable(false).Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Amount)
                </div>
            </div>
        </div>

        <br />
        <div id="DIV_SELECTION">
            <div class="row" style="padding-left:20px;padding-right:20px;">
                @ViewBag.Mode
                <h4>Available Items:</h4>
                @RenderGridSelections();
            </div>
        </div>        

    </fieldset>
}

@helper RenderGridSelections()
{
    if ((string)@ViewData["ItemExtnName"] == "ItemExtnOther")
    {
            @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnOther>()
                .Name("gridSelections")
                .Columns(col =>
                {
                    col.Select().Width(30);
                    col.Bound(c => c.SerialNo).Width(100);
                })
                .Filterable()
                .NoRecords()
                .Resizable(r => r.Columns(true))
                .Selectable(s => s.Mode(GridSelectionMode.Multiple))
                .Sortable()
                .Scrollable(s => s.Height(200))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Events(events => events.Error("GridError"))
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                    })
                    .Sort(s =>
                    {
                        s.Add(a => a.SerialNo);
                    })
                    .Read(read => read.Action("_ItemExtnOtherSelectionRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"] }))
                )
                .Events(e => e.Change("onChangeGridSelection").DataBound("onDataBoundGridSelection"))
                .AutoBind(true)
            )
    }
    else if ((string)@ViewData["ItemExtnName"] == "ItemExtnVehicle")
    {
            @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnVehicleVm>()
            .Name("gridSelections")
            .Columns(col =>
            {
                col.Select().Width(30).Visible(ViewBag.Mode == "ADD");
                col.Bound(c => c.LocationCode).Width(50);
                col.Bound(c => c.Location).Width(70);
                col.Bound(c => c.ParIcsNo).Width(70);
                col.Bound(c => c.ParIcsDate).Width(70);
                col.Bound(c => c.YearModel).Width(50);
                col.Bound(c => c.PlateNo).Width(50);
                //col.Bound(c => c.BodyNo).Width(70);
                //col.Bound(c => c.EngineNo).Width(70);
                //col.Bound(c => c.ChasisNo).Width(70);
                col.Bound(c => c.Color).Width(50);
                col.Bound(c => c.CRN).Width(70);
                col.Bound(c => c.CRDate).Width(50);
                col.Bound(c => c.MVFileNo).Width(70);
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Selectable(s => s.Mode(GridSelectionMode.Multiple))
            .Sortable()
            .Scrollable(s => s.Height(200))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Sort(s =>
                {
                    s.Add(a => a.PlateNo);
                })
                .Read(read => read.Action("_ItemExtnVehicleSelectionRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"] }))
            )
            .Events(e => e.Change("onChangeGridSelection").DataBound("onDataBoundGridSelection"))
            .AutoBind(true)
            )
    }
}





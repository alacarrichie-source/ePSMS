@model iLgs.Models.RisIssuedVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RisItemId)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>
    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.IssuedDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.IssuedDate)
                </div>
            </div>
        </div>        
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.UnitCost, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.UnitCost).Decimals(2).Enable(false)
                        .Events(e => e.Change("onChangeQtyCost"))
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.UnitCost)
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Qty, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Decimals(0)
                        .Events(e => e.Change("onChangeQtyCost"))
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Qty)
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Amount, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.Amount).Decimals(2).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Amount)
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.ReceivedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.ReceivedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ReceivedBy)
                </div>
            </div>
        </div>        
    </fieldset>
}







        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.UnitCost, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.UnitCost).Decimals(0).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.UnitCost)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.QtyBal, "Balance", htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(m => m.QtyBal).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.QtyBal)
                </div>
            </div>
        </div>        
        

        @if (Model.IsWithItemExtn == true)
        {
            @RenderGridSelections();
        }
        else
        {
            <div class="row k-mb-2">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.TransferOut, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().NumericTextBoxFor(m => m.TransferOut).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Events(e => e.Change("UpdateBalance"))
                        )
                        @Html.ValidationMessageFor(m => m.TransferOut)
                    </div>
                </div>
            </div>

            <div class="row k-mb-2">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.RemBalance, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().NumericTextBoxFor(m => m.RemBalance).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                        @Html.ValidationMessageFor(m => m.RemBalance)
                    </div>
                </div>
            </div>
        }


        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave_" + @ViewData["CardItemId"]))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel_" + @ViewData["CardItemId"]))
                </span>
            </div>
        </div>

    </fieldset>
}

@helper RenderGridSelections()
{
if (@ViewBag.ItemExtnName == "ItemExtnOther")
{
        @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnOther>()
            .Name("gridSelections")
            .Columns(col =>
            {
                col.Select().Width(30);
                col.Bound(c => c.SerialNo).Width(100);
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Selectable(s => s.Mode(GridSelectionMode.Multiple))
            .Sortable()
            .Scrollable(s => s.Height(200))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Sort(s =>
                {
                    s.Add(a => a.SerialNo);
                })
                .Read(read => read.Action("_TransferSelectionRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"] }))
            )
            .AutoBind(true)
        )
}
else if (@ViewBag.ItemExtnName == "ItemExtnVehicle")
{
        @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnVehicle>()
            .Name("gridSelections")
            .Columns(col =>
            {
                col.Select().Width(30);
                col.Bound(c => c.YearModel).Width(50);
                col.Bound(c => c.PlateNo).Width(50);
                col.Bound(c => c.BodyNo).Width(70);
                col.Bound(c => c.EngineNo).Width(70);
                col.Bound(c => c.ChasisNo).Width(70);
                col.Bound(c => c.Color).Width(50);
                col.Bound(c => c.CRN).Width(70);
                col.Bound(c => c.CRDate).Width(50);
                col.Bound(c => c.MVFileNo).Width(70);
            })
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Selectable(s => s.Mode(GridSelectionMode.Multiple))
            .Sortable()
            .Scrollable(s => s.Height(200))
            .DataSource(dataSource => dataSource
                .Ajax()
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Sort(s =>
                {
                    s.Add(a => a.PlateNo);
                })
                .Read(read => read.Action("_TransferSelectionRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"] }))
            )
            .AutoBind(true)
        )
}
}


<script type="text/javascript">
    $("#btnSave_" + '@ViewData["CardItemId"]').click(function (e) {
        e.preventDefault();

        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');

            if ($("#IsWithItemExtn").val() == "True") {
                // Get reference to Grid object
                var grid = $("#gridSelections").data("kendoGrid");
                // Get selected rows
                var sel = $("input:checked", grid.tbody).closest("tr");
                // Get data item for each

                var selectedIds = grid.selectedKeyNames().join(",");

                $("#SelectedIds").val(selectedIds);                
            }
            
            $.ajax({
                type: "POST",
                url: '@Url.Action("_TransferSave", "PoIssuance")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave_" + '@ViewData["CardItemId"]').closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel_" +  '@ViewData["CardItemId"]').click(function (e) {
        e.preventDefault();
        $("#btnCancel_" + '@ViewData["CardItemId"]').closest(".k-window-content").data("kendoWindow").close();
    });

    
</script>
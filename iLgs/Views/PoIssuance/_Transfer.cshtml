        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PoNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.PoNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.PoNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PoDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.PoDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.PoDate)
                </div>
            </div>
        </div>

        @*<div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.AirNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.AirNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.AirNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.AirDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.AirDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.AirDate)
                </div>
            </div>
        </div>*@

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.DeptId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.DeptId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Office")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    //read.Action("GetCodeList", "Getters", new { mastCode = "DEPARTMENTS", addAll = false });
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => e.Select("onSelectDeptId"))
                            .Suggest(true)
                            .Enable(false)
                    )
                    @Html.ValidationMessageFor(model => model.DeptId)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.DeptDisplay, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.DeptDisplay).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.DeptDisplay)
                </div>
            </div>
        </div>
        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.TransDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.TransDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.TransDate)
                </div>
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.LocationId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-3">                   
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Code")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetLocationSp", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("50");
                                c.Add().Field("Desc3").Title("Main-Location").Width("300");

@model iLgs.Models.PsCardItemTransferVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardItemId)
    @*@Html.HiddenFor(model => model.PsCardId)
        @Html.HiddenFor(model => model.OrderItemId)
        @Html.HiddenFor(model => model.Description)
        @Html.HiddenFor(model => model.Remarks)
        @Html.HiddenFor(model => model.AirNo)
        @Html.HiddenFor(model => model.AirDate)
        @Html.HiddenFor(model => model.Qty)
        @Html.HiddenFor(model => model.TransferIn)
        @Html.HiddenFor(model => model.QtyIss)
        @Html.HiddenFor(model => model.InvDist)*@
    @Html.HiddenFor(model => model.IsWithItemExtn)
    @*@Html.HiddenFor(model => model.GroupId)*@
    @Html.HiddenFor(model => model.SelectedIds)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            @Html.LabelFor(m => m.PoNo, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.PoNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                @Html.ValidationMessageFor(m => m.PoNo)
            </div>

            @Html.LabelFor(m => m.PoDate, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().DatePickerFor(m => m.PoDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                @Html.ValidationMessageFor(m => m.PoDate)
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(model => model.DeptId, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.DeptId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Office")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    //read.Action("GetCodeList", "Getters", new { mastCode = "DEPARTMENTS", addAll = false });
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => e.Select("onSelectDeptId"))
                            .Suggest(true)
                            .Enable(false)
                )
                @Html.ValidationMessageFor(model => model.DeptId)
            </div>

            @Html.LabelFor(m => m.DeptDisplay, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.DeptDisplay).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                @Html.ValidationMessageFor(m => m.DeptDisplay)
            </div>
        </div>
        <br />
        <div class="row k-mb-2">
            @Html.LabelFor(m => m.TransDate, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().DatePickerFor(m => m.TransDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.TransDate)
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(model => model.LocationId, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Code")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetTransitLocation", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("50");
                                c.Add().Field("Desc3").Title("Main-Location").Width("300");
                                c.Add().Field("Desc2").Title("Location").Width("300");
                            })
                            .Events(e => e.Select("onSelectLocationId"))
                    //.Suggest(true)
                )
                @Html.ValidationMessageFor(model => model.LocationId)
            </div>
            <div class="col-md-6">
                @(Html.Kendo().TextBoxFor(m => m.Location).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.Unit, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.Unit)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select unit")
                        .DataTextField("Description")
                        .DataValueField("Code")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetCodes", "Getters", new { mastCode = "UNIT", text = "" });
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Description").Title("Unit").Width("100%");

                        })
                        .Suggest(true)
                        .Enable(false)
                )
                @Html.ValidationMessageFor(m => m.Unit)
            </div>

            @Html.LabelFor(m => m.UnitCost, htmlAttributes: new { @class = "col-md-2" })
            <div class="col-md-4">
                @(Html.Kendo().NumericTextBoxFor(m => m.UnitCost).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                @Html.ValidationMessageFor(m => m.UnitCost)
            </div>
        </div>


        @if (Model.IsWithItemExtn == true)
        {
            @*@Html.HiddenFor(model => model.Unit)
                @Html.HiddenFor(model => model.UnitCost)*@
            @(Html.Kendo().TabStrip()
                .Name("tabStrip_Item")
                //.HtmlAttributes(new { @class = "no-text-tabstrip" })
                .TabPosition(TabStripTabPosition.Top)
                .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                .SelectedIndex(0)
                .Items(items =>
                {
                    items.Add().Text("Items").Selected(true)
                    .Content(@<text>@RenderGridSelections();</text>);
                }))                            
        }
        else
        {
            <div class="row k-mb-2">
                @Html.LabelFor(m => m.QtyBal, "Balance", htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-4">
                    @(Html.Kendo().NumericTextBoxFor(m => m.QtyBal).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.QtyBal)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.TransferOut, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-4">
                    @(Html.Kendo().NumericTextBoxFor(m => m.TransferOut).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Events(e => e.Change("UpdateBalance"))
                    )
                    @Html.ValidationMessageFor(m => m.TransferOut)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.RemBalance, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-4">
                    @(Html.Kendo().NumericTextBoxFor(m => m.RemBalance).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(false))
                    @Html.ValidationMessageFor(m => m.RemBalance)
                </div>
            </div>
        }


        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave_" + @ViewData["TransferId"]))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel_" + @ViewData["TransferId"]))
                </span>
            </div>
        </div>

    </fieldset>
}

@helper RenderGridSelections()
{
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnTransitVM>()
        .Name("gridSelections")
        .Columns(col =>
        {
            col.Select().Width(30);
            col.Bound(c => c.SetLotNo).Width(50);
            col.Bound(c => c.SetLotQtyNo).Width(50);
            col.Bound(c => c.ContentNo).Width(50);
            col.Bound(c => c.RefNo).Width(150);
            col.Bound(c => c.LocationCode).Width(50);
            col.Bound(c => c.Location).Width(150);
        })
        .NoRecords("No records with ICS/PAR available.")
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Multiple))
        .PersistSelection(true)
        .Scrollable(s => s.Height(200))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Sort(s =>
            {
                s.Add(a => a.SetLotNo);
                s.Add(a => a.SetLotQtyNo);
                s.Add(a => a.ContentNo);
            })
            .Read(read => read.Action("_TransferSelectionRead", "PoIssuance", new { cardItemId = @ViewData["CardItemId"], transferId = @ViewData["TransferId"] }))
        )
        //.Events(e => e.Change("onChangeGridItemExtns"))
        .AutoBind(true)
    )
}


<script type="text/javascript">
    $("#btnSave_" + '@ViewData["TransferId"]').click(function (e) {
        e.preventDefault();

        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');

            if ($("#IsWithItemExtn").val() == "True") {
                // Get reference to Grid object
                var grid = $("#gridSelections").data("kendoGrid");
                // Get selected rows
                var selectedRows = $("input:checked", grid.tbody).closest("tr");
                // Get data item for each

                var selectedIds = selectedRows.map(function () {
                    return grid.dataItem(this);
                }).get(); // Convert to an array

                //$("#SelectedIds").val(selectedIds);
                $("#SelectedIds").val(JSON.stringify(selectedIds));
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("_TransferSave", "PoIssuance")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave_" + '@ViewData["TransferId"]').closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        var $errorList = $("#ErrorContent .errors");
                        $errorList.empty(); // Clear previous errors

                        // Append errors to the list
                        $.each(result.Errors, function (index, error) {
                            $errorList.append("<li>" + error + "</li>");
                        });

                        // Show the error container
                        $("#ErrorContent").removeClass("hidden");
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel_" +  '@ViewData["TransferId"]').click(function (e) {
        e.preventDefault();
        $("#btnCancel_" + '@ViewData["TransferId"]').closest(".k-window-content").data("kendoWindow").close();
    });


</script>
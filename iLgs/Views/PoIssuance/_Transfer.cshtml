@model iLgs.Models.PsCardItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardId)
    @Html.HiddenFor(model => model.OrderItemId)
    @Html.HiddenFor(model => model.Description)
    @Html.HiddenFor(model => model.Remarks)
    @Html.HiddenFor(model => model.AirNo)
    @Html.HiddenFor(model => model.AirDate)
    @Html.HiddenFor(model => model.Qty)
    @Html.HiddenFor(model => model.TransferIn)
    @Html.HiddenFor(model => model.QtyIss)
    @Html.HiddenFor(model => model.InvDist)
    @Html.HiddenFor(model => model.IsWithItemExtn)

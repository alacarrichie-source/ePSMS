    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    $(document).ready(function () {
        var datePicker = $("#AsOf").data("kendoDatePicker");

        //// Ensure the DatePicker calendar popup still works
        //$("#AsOf").on('mousedown', function (e) {
        //    alert('x');

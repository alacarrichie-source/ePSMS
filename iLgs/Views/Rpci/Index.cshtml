@{
    ViewBag.Title = "Report on the Physical Count of Inventories (RPCI)";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}


@(Html.Kendo().Grid<iLgs.Models.RPCI_VM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.AsOf).Width(70);
        col.Bound(c => c.Fund).Width(70);
        col.Bound(c => c.InvDistDesc).Width(70);
        col.Bound(c => c.AcqMode).Width(70);
        col.Bound(c => c.Account).Width(70);
        col.Bound(c => c.CertifiedCorrectBy).Width(70);
        col.Bound(c => c.PostedBy).Width(70);
        col.Bound(c => c.PostedDt).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RpciTemplate").Window(w => w.Width(500).Title("RPCI")))
    .Search(s =>
    {
        s.Field(o => o.AsOf, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.InvDistDesc, "contains");
        s.Field(o => o.AcqMode, "contains");
        s.Field(o => o.Account, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.FromDonation).DefaultValue(false);
        })
        .Read(read => read.Action("RpciRead", "Rpci"))
        .Create(create => create.Action("RpciCreate", "Rpci"))
        .Update(update => update.Action("RpciUpdate", "Rpci"))
        .Destroy(destroy => destroy.Action("RpciDestroy", "Rpci"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Events(e => e.Select("onSelectTab"))
    .Items(items =>
    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_RpciItem", "Rpci", new { rpciId = "#=Id#" });        
    }).ToClientTemplate())
</script>

@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<div id="windowcontainer"></div>


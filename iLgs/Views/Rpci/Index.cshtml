        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RpciTemplate").Window(w => w.Width(500).Title(@ViewBag.Header)))
    .Search(s =>
    {
        s.Field(o => o.AsOf, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.InvDistDesc, "contains");
        s.Field(o => o.AcqMode, "contains");
        s.Field(o => o.Account, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.FromDonation).DefaultValue(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.QtyBalance).Sum();
            a.Add(p => p.QtyCons).Sum();
            a.Add(p => p.QtySE).Sum();
            a.Add(p => p.QtySPHV).Sum();
            a.Add(p => p.QtySPLV).Sum();
            a.Add(p => p.AcqCost).Sum();
            a.Add(p => p.AmountCons).Sum();
            a.Add(p => p.AmountSE).Sum();
            a.Add(p => p.AmountSPHV).Sum();
            a.Add(p => p.AmountSPLV).Sum();
        })
        .Sort(s => s.Add(a => a.AsOf).Descending())
        .Read(read => read.Action("RpciRead", "Rpci", new { isPosted = @ViewData["IsPosted"], type = @ViewData["Type"] }))
        .Create(create => create.Action("RpciCreate", "Rpci"))
        .Update(update => update.Action("RpciUpdate", "Rpci"))
        .Destroy(destroy => destroy.Action("RpciDestroy", "Rpci"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Events(e => e.Select("onSelectTab"))
    .Items(items =>
    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_RpciItem", "Rpci", new { rpciId = "#=Id#" });        
    }).ToClientTemplate())
</script>


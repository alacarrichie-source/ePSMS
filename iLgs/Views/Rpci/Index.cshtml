    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    $(document).ready(function () {
        var datePicker = $("#AsOf").data("kendoDatePicker");

        //// Ensure the DatePicker calendar popup still works
        //$("#AsOf").on('mousedown', function (e) {
        //    alert('x');
        //    e.preventDefault(); // Prevent the default mouse events
        //    if (!$(e.target).is('input')) {
        //        $(this).data("kendoDatePicker").open(); // Open the calendar popup
        //    }
        //});

        // Prevent manual input by disabling all key events
        //$("#AsOf").on('keydown keypress keyup', function (e) {

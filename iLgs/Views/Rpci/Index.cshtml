    $(".k-grid-btnExport").click(function (e) {
        e.preventDefault();
        // Get the selected row's data (assuming a single selection model)
        var grid = $("#grid").data("kendoGrid");
        var selectedRow = grid.select();
        var selectedData = grid.dataItem(selectedRow);

        if (selectedData) {
            window.kendo.ui.progress($(document.body), true);
            // Get the ID of the selected row
            var reportId = selectedData.Id;

            // Construct the URL for the Excel export
            var url = '@Url.Action("RpciRpt", "Rpci")?id=' + reportId + "&save=1";

            // Redirect to the export URL to trigger download
            window.location.href = url;
            window.kendo.ui.progress($(document.body), false);
        } else {
            alert("Please select a row to export.");
        }
    });


@model iLgs.Models.RPCI_VM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.ItemType)
    @Html.HiddenFor(model => model.Fund)

    <fieldset>
        <div class="row">
            @Html.LabelFor(m => m.AsAt, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().DatePickerFor(m => m.AsAt).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.AsAt)
            </div>
        </div>

        <div id="EditDiv">
            <div class="row">
                @Html.LabelFor(m => m.AccountableOfficer, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.AccountableOfficer).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.AccountableOfficer)
                </div>
            </div>

            <div class="row">
                @Html.LabelFor(m => m.Designation, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Designation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Designation)
                </div>
            </div>

            <div class="row">
                @Html.LabelFor(m => m.AssumptionDt, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.AssumptionDt).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.AssumptionDt)
                </div>
            </div>

            <div class="row">
                @Html.LabelFor(m => m.CertifiedCorrectBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.CertifiedCorrectBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.CertifiedCorrectBy)
                </div>
            </div>

            <div class="row">
                @Html.LabelFor(m => m.ApprovedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ApprovedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ApprovedBy)
                </div>
            </div>

            <div class="row">
                @Html.LabelFor(m => m.VerifiedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.VerifiedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.VerifiedBy)
                </div>
            </div>
        </div>
        
    </fieldset>
}

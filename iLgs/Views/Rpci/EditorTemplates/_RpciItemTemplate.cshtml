@model iLgs.Models.RPCIItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RpciId)
    @Html.HiddenFor(model => model.ItemType)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Article, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Article)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Item")
                        .DataTextField("Description")
                        .DataValueField("Description")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetItems", "Items");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("ItemNo").Title("Item No.").Width("10%");
                            c.Add().Field("Code").Title("Code").Width("10%");
                            c.Add().Field("MainDesc").Title("Group").Width("60%");
                            c.Add().Field("Description").Title("Article").Width("20%");
                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectItemCode");
                            //.DataBound("onDataBoundItemCode");
                        })
                    )
                    @Html.ValidationMessageFor(m => m.Article)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.RefNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefNo)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefDate, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.RefDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.AirNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.AirNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.AirNo)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.AirDate, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.AirDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.AirDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.LocationId, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "LOCATIONS", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.LocationId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.OfficerId, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OfficerId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Officer")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAccountableOfficersByDeptId", "Getters").Data("DataOfficerId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("40%");
                                c.Add().Field("Designation").Title("Designation").Width("60%");
                            })
                            .CascadeFrom("LocationId")
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.OfficerId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.OldStockNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.OldStockNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.OldStockNo)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.StockNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.StockNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.StockNo)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Model_, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Model_).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Model_)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Brand, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Brand).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Brand)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Description).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Unit, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Unit)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select unit")
                        .DataTextField("Description")
                        .DataValueField("Code")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetCodes", "Getters", new { mastCode = "UNIT", text = "" });
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Description").Title("Unit").Width("100%");

                        })
                        .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.Unit)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.QtyBalance, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(m => m.QtyBalance).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.QtyBalance)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.QtyOnHand, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(m => m.QtyOnHand).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.QtyOnHand)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.QtyShortOver, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(m => m.QtyShortOver).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.QtyShortOver)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.UnitValue, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(m => m.UnitValue).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.UnitValue)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ValueShortOver, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(m => m.ValueShortOver).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ValueShortOver)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Remarks).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>
        </div>

    </fieldset>
}






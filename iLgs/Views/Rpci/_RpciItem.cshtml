@(Html.Kendo().Grid<iLgs.Models.RPCIItemVM>()
        .Name("gridItems_" + @ViewData["rpciId"])
        .Columns(col =>
        {
            col.Bound(c => c.Department).Width(70);
            col.Bound(c => c.Article).Width(70);
            col.Bound(c => c.PoNo).Width(50);
            col.Bound(c => c.PoDate).Width(50);
            col.Bound(c => c.Unit).Width(50);
            col.Bound(c => c.UnitCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Qty).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.LocationCode).Width(50);
            col.Bound(c => c.LocationName).Width(70);
            col.Bound(c => c.TransferIn).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.TotalBalance).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.AcqCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.StockNo).Width(70);
            col.Bound(c => c.Description).Width(150);
            //col.Command(command =>
            //{
            //    command.Edit();
            //    command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridItemDeleteClick").SendDataKeys(true);
            //}).Width(172);
        })
        @*.ToolBar(toolbar =>
        {
            toolbar.Template(@<text>
            @(Html.Kendo().Button().Name("btnAddItem_" + ViewData["orderId"]).Content("Add Order Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddOrderItem")))
            </text>);
        })*@
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RpciItemTemplate").Window(w => w.Width(800).Title("RPCI Item")))
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .Groupable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridItemError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .ServerOperation(true)
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.TransferIn).Sum();
                a.Add(p => p.TotalBalance).Sum();
                a.Add(p => p.AcqCost).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_RpciItemRead", "Rpci", new { rpciId = @ViewData["rpciId"] }))
        //.Update(update => update.Action("_RpciItemUpdate", "Rpci"))
        //.Destroy(destroy => destroy.Action("_RpciItemDestroy", "Rpci"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            //.Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        //.Remove("onRemoveGridItems")
        )
        .AutoBind(true)
)


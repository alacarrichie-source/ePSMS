@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />
@(Html.Kendo().Grid<iLgs.Models.NotificationVM>()
        .HtmlAttributes(new { @class = "custom-max-grid" })
        .Name("grid")
        .Columns(col =>
        {
            col.Bound(c => c.Name).Width(70);
            col.Bound(c => c.Description).Width(150);
            col.Bound(c => c.InsertedBy).Width(70);
            col.Bound(c => c.InsertedDt).Width(70);
            col.Command(command =>
            {
                command.Edit();
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);                
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add New Record");
            t.Search();
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_NotificationTemplate").Window(w => w.Width(800).Title("Notification")))
        .Search(s =>
        {
            s.Field(o => o.Name, "contains");
            s.Field(o => o.Description, "contains");
            s.Field(o => o.InsertedBy, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Scrollable()
        .Sortable()
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Read(read => read.Action("Read", "Notification"))
            .Create(create => create.Action("Create", "Notification"))
            .Update(update => update.Action("Update", "Notification"))
            .Destroy(destroy => destroy.Action("Destroy", "Notification"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        //.Save("onSaveGrid")
        )
        .AutoBind(true)
)


@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Users to be notified")
                    .Selected(true)
                    .LoadContentFrom("_NotificationUsers", "Notification", new { notificationId = "#=Id#" });                
            }).ToClientTemplate())
</script>


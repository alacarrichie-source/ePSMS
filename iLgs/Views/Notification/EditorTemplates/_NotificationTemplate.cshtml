@model iLgs.Models.NotificationVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>        
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Name, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Name).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Name)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Description, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Description).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>            
        </div>

    </fieldset>
}









@(Html.Kendo().Grid<iLgs.Models.NotificationUserVM>()
    .Name("gridUsers_" + @ViewData["NotificationId"])
    //.HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(o => o.UserName).Width(70);
        columns.Bound(o => o.UserFullName).Width(100);
        columns.Bound(o => o.UserDepartment).Width(100);
        columns.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.UserName, "contains");
        s.Field(o => o.UserFullName, "contains");
        s.Field(o => o.UserDepartment, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    //.Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .Editable()
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_NotificationUsersTemplate").Window(w => w.Width(800).Title("Users")))
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.NotificationId).DefaultValue(@ViewData["NotificaitonId"]);
        })
        .Read(read => read.Action("_NotificationUserRead", "Notification", new { notificationId = @ViewData["NotificaitonId"] }))
        .Create(create => create.Action("_NotificationUserCreate", "Notification"))
        .Update(update => update.Action("_NotificationUserUpdate", "Notification"))
        .Destroy(destroy => destroy.Action("_NotificationUserDestroy", "Notification"))
    )
    .Events(events => events
        .Change("onChangeGridUsers")
        .Edit("onEditGridUsers")
        .DataBound("onDataBoundGridUsers")
    )
    .AutoBind(true)
)


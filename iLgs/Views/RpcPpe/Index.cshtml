    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;
            e.model.set("RpcPpeId", selectedId);
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");

        }
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
            }
        }
    }

    $(".k-grid-btnPost_").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Recored already posted by " + postedBy);
        }
        else {
            var msg = "Post Selected Record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostRpc", "RpcPpe")',
                    data: { rpcId: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    $(".k-grid-btnUnpost_").click(function (e) {
        e.preventDefault();
        var msg = "Unpost Selected Record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UnpostRpc", "RpcPpe")',
                data: { rpcId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrint_").click(function (e) {
        e.preventDefault();
        var AsOf = new Date(selectedAsOf);        

        var url = '@Url.Action("RpcRpt", "RpcPpe")?AsOf=' + AsOf + "&id=" + selectedId;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });

    // Item Template
    function onSelectItemCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Account").val(dataItem.Account).trigger("change");
        $("#SubArticle").val(dataItem.SubArticle).trigger("change");        
    }

    // end Item Template

</script>




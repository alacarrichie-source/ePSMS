@{
    ViewBag.Title = "Report on the Physical Count of Equipment, Furnitures and Fixtures, and other PPE (RPCEFFOPPE)";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}


@(Html.Kendo().Grid<iLgs.Models.RpcPpeVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.AsOf).Width(70);
        col.Bound(c => c.Department).Width(70);
        col.Bound(c => c.CertifiedCorrectBy).Width(70);
        col.Bound(c => c.ApprovedBy).Width(70);
        col.Bound(c => c.PostedBy).Width(70);
        col.Bound(c => c.PostedDt).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrint_").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost_").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost_").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RpcTemplate").Window(w => w.Width(500).Title("RPCEFFOPPE")))
    .Search(s =>
    {
        s.Field(o => o.Department, "contains");
        s.Field(o => o.CertifiedCorrectBy, "contains");
        s.Field(o => o.ApprovedBy, "contains");
        s.Field(o => o.PostedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("Read", "RpcPpe"))
        .Create(create => create.Action("Create", "RpcPpe"))
        .Update(update => update.Action("Update", "RpcPpe"))
        .Destroy(destroy => destroy.Action("Destroy", "RpcPpe"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    .Events(e => e.Select("onSelectTab"))
    .Items(items =>
    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_Item", "RpcPpe", new { rpcId = "#=Id#" });
    }).ToClientTemplate())
</script>

@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))

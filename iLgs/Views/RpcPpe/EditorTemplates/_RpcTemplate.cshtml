@model iLgs.Models.RpcPpeVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <fieldset>
        <div class="row k-mb-2">
            @Html.LabelFor(m => m.AsOf, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().DatePickerFor(m => m.AsOf).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.AsOf)
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.Department, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.Department)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Department")
                    .DataTextField("Description")
                    .DataValueField("Description")
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetDepartments", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Code").Title("Code").Width("30%");
                        c.Add().Field("Description").Title("Description").Width("70%");
                    })
                    .Suggest(true)
                )
                @Html.ValidationMessageFor(model => model.Department)
            </div>
        </div>

        <div id="EditDiv">            

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.CertifiedCorrectBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.CertifiedCorrectBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.CertifiedCorrectBy)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.CertifiedCorrectDesignation, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.CertifiedCorrectDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.CertifiedCorrectDesignation)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.ApprovedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ApprovedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ApprovedBy)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.ApprovedDesignation, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ApprovedDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ApprovedDesignation)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.VerifiedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.VerifiedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.VerifiedBy)
                </div>
            </div>

            <div class="row k-mb-2">
                @Html.LabelFor(m => m.VerifiedDesignation, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.VerifiedDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.VerifiedDesignation)
                </div>
            </div>
        </div>

    </fieldset>
}


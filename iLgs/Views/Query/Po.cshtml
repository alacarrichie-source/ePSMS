@{
    ViewBag.Title = "Stock Card PO Printout";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
@model iLgs.Models.PoQueryVM

<br />
<div class="row">
    <div class="col-md-6">
        <div class="col-md-12">
            @Html.Label("User Name:")
        </div>
        <div class="col-md-12">
            @(Html.Kendo().MultiColumnComboBoxFor(m => m.UserName)
                //.Name("UserName")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select encoder")
                .DataTextField("NameFull")
                .DataValueField("UserName")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetGsoUsers", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("UserName").Title("User Name").Width("30%");
                    c.Add().Field("NameFull").Title("Name Full").Width("70%");
                })
                .Events(e => e.Select("onSelectUserName").Change("onChangeUserName"))
                .AutoBind(true)
            )
        </div>
    </div>

    <div class="col-md-6">
        <div class="col-md-12">
            @Html.Label("PO status:")
        </div>
        <div class="col-md-12">
            @(Html.Kendo().RadioButtonFor(m => m.PoStatus).Label("Posted").Value(1).Events(e => e.Change("onChangePoStatus"))) &nbsp;
            @(Html.Kendo().RadioButtonFor(m => m.PoStatus).Label("Not Posted").Value(2).Events(e => e.Change("onChangePoStatus"))) &nbsp;
            @(Html.Kendo().RadioButtonFor(m => m.PoStatus).Label("All").Value(3).Events(e => e.Change("onChangePoStatus")))
        </div>
    </div>
</div>
<br />

@(Html.Kendo().Grid<iLgs.Models.QueryPoVM>()
    .HtmlAttributes(new { @class = "max-grid-2" })
    .Name("grid")
    .Columns(col =>
    {
        //col.Bound(c => c.Id).Hidden();
        col.Bound(c => c.Fund).Width(40);
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.PoDate).Width(50);
        col.Bound(c => c.DeptCode).Width(50);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.ItemCount).Width(50)
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
            .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Group(group => group.Title("PO Amounts")
            .Columns(info =>
            {
                info.Bound(f => f.Amount).Width(70).Title("Original<br>PO")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.IssueAmount).Width(70).Title("Issued")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.BalanceAmount).Width(70).Title("Balance")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        col.Group(group => group.Title("Issuance")
            .Columns(info =>
            {
                info.Bound(f => f.PastAmount).Width(70).Title("Past<br>Year/s")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.CurAmount).Width(70).Title("Current<br>Year")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.FutureAmount).Width(70).Title("Future<br>Year/s")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                    .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );        
    })
    .ToolBar(t =>
    {
        t.Custom().Text("Print - Original").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Print - Update").IconClass("k-icon k-i-print").Name("btnPrintCardUpdate").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.PoNo, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(30)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.ItemCount).Sum();
            a.Add(p => p.Amount).Sum();
            a.Add(p => p.BalanceAmount).Sum();
            a.Add(p => p.IssueAmount).Sum();
            //a.Add(p => p.PastQty).Sum();
            a.Add(p => p.PastAmount).Sum();
            //a.Add(p => p.CurQty).Sum();
            a.Add(p => p.CurAmount).Sum();
            //a.Add(p => p.FutureQty).Sum();
            a.Add(p => p.FutureAmount).Sum();
        })
        .Sort(s => s.Add(a => a.PoNo).Descending())
        .Read(read => read.Action("PoRead", "Query").Data("DataStockCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)

<script id="DetailTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
    .Name("gridItem_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Account).Width(100).Title("Main Account");
        col.Bound(c => c.StockNo).Width(100);
        //col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.Description).Width(150);
        col.Bound(c => c.Unit).Width(150);
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");        
        col.Bound(c => c.InsertedBy).Width(70);
        col.Bound(c => c.InsertedDt).Width(100);
        col.Bound(c => c.UpdatedBy).Width(70);
        col.Bound(c => c.UpdatedDt).Width(100);
    })
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("PoItemRead", "Query", new { poNo = "#=PoNo#", userName = "#=UserName#"}))
    )
    .Events(events => events
        .Change("onChangeGridItems")
        .DataBound("onDataBoundGridItems")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>




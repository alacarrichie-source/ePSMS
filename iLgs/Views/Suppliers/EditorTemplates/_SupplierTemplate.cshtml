@model iLgs.Models.SupplierVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Code)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Name, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Name).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Name)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Address, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Address).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Address)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ZipCode, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.ZipCode).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ZipCode)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.BusinessName, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.BusinessName).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.BusinessName)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.DTI, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.DTI).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.DTI)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.SEC, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.SEC).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.SEC)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.BIN, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.BIN).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.BIN)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.TIN, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.TIN).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.TIN)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ContactNos, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.ContactNos).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ContactNos)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Email, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Email).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Email)
                </div>
            </div>
        </div>        

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IsCorp, "LabelBool")
                </div>
                <div class="col-md-4">
                    @(Html.Kendo().SwitchFor(m => m.IsCorp).Messages(c => c.Checked("YES").Unchecked("NO")))
                    @Html.ValidationMessageFor(m => m.IsCorp)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IsVat, "LabelBool")
                </div>
                <div class="col-md-4">
                    @(Html.Kendo().SwitchFor(m => m.IsVat).Messages(c => c.Checked("YES").Unchecked("NO")))
                    @Html.ValidationMessageFor(m => m.IsVat)
                </div>
            </div>
        </div>
    </fieldset>
}
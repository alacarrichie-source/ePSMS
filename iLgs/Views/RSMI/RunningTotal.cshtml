@{
    ViewBag.Title = "RSMI - Running Total";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Issued From", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().DatePicker().Name("startDate")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("blankGrid"))
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Issued To", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().DatePicker().Name("endDate")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("blankGrid"))
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Item Type", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().MultiColumnComboBox().Name("type")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                //.Placeholder("Select")
                .DataTextField("Description")
                .DataValueField("Code")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                //.Value("ALL")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetCodeList", "Getters", new { mastCode = "ITEM-TYPE", addAll = true });
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .Events(e => e.Change("blankGrid"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().MultiColumnComboBox()
                    .Name("deptId")
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Department")
                    .DataTextField("Description")
                    .DataValueField("Id")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetDepartmentAll", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Code").Title("Code").Width("30%");
                        c.Add().Field("Description").Title("Description").Width("70%");
                    })
                    .Events(e => e.Select("blankGrid"))
                    .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-5">
        <div class="col-md-2">
            &nbsp;
        </div>
        <div class="col-md-3">
            @(Html.Kendo().Button().Name("btnSubmit").Content("Submit").ThemeColor(ThemeColor.Primary)
            .Events(e => e.Click("refreshGrid")))
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.RSMITotalVM>()
    .Name("grid")
    //.HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(f => f.ItemType).Width(50);
        columns.Bound(f => f.Account).Width(50);
        columns.Bound(f => f.SubAccount).Width(50);
        columns.Bound(f => f.PoQty).Width(50).Title("Quantity")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        columns.Bound(f => f.PoAmount).Width(50).Title("Amount")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
            .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        columns.Group(group => group.Title("Released")
            .Columns(info =>
            {
                info.Group(g =>
                {
                    g.Title("Quantity").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(i =>
                    {
                        i.Bound(f => f.QtyIssPast).Width(50).Title("Past Years")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        i.Bound(f => f.QtyIss).Width(50).Title("Present")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        i.Bound(f => f.QtyIssTotal)
                            .Width(50).Title("Total")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
                info.Group(g =>
                {
                    g.Title("Amount").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(i =>
                    {
                        i.Bound(f => f.IssPastAmount).Width(50).Title("Past Years")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n2}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        i.Bound(f => f.IssAmount).Width(50).Title("Present")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n2}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        i.Bound(f => f.IssTotalAmount)
                            .Width(50).Title("Total")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n2}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });

                            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                            .ClientFooterTemplate("#=kendo.format('{0:n2}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.ItemType, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.SubAccount, "contains");
    })
    .Pageable(pager => pager
        //.Input(false)
        //.Numeric(true)
        //.Info(true)
        //.PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        //.ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(100000)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.PoQty).Sum();
            a.Add(p => p.PoAmount).Sum();
            a.Add(p => p.QtyIssPast).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.IssPastAmount).Sum();
            a.Add(p => p.QtyBalancePast).Sum();
            a.Add(p => p.BalancePastAmount).Sum();
            a.Add(p => p.IssAmount).Sum();
            a.Add(p => p.QtyBalance).Sum();
            a.Add(p => p.BalanceAmount).Sum();
            a.Add(p => p.QtyIssTotal).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.IssTotalAmount).Sum();
        })
        .Group(x =>
        {
            x.Add(y => y.ItemType);
            x.Add(y => y.Account);

        })
        .Sort(s =>
        {
            s.Add(a => a.ItemType);
            s.Add(a => a.Account);
            s.Add(a => a.SubAccount);
        })
        .Read(read => read.Action("RunningTotalRead", "RSMI").Data("DataGrid"))
    ).AutoBind(false)
//.Events(events => events
//    .Change("onChangeGrid")
//    .DataBound("onDataBoundGrid")
//    )
)


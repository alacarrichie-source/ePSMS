<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            var selectedGrid = $("#grid").data("kendoGrid");
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function GridItemError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selecteItemId = null;
    var trackingId = null;

    // MAIN GRID

    $(".k-grid-btnAdd").click(function (e) {
        e.preventDefault()
        window.kendo.ui.progress($("#grid"), true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                activate: function () {
                    window.kendo.ui.progress($("#grid"), false);
                },
                close: function () {
                    $("#grid").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Add",
            width: 400,
            height: 370
        });

        mywindow.refresh({
            url: '@Url.Action("_RSMIAdd", "RSMI")',
        });
        mywindow.center().open();
    });

    $(".k-grid-btnDelete").click(function (e) {
        e.preventDefault()
        window.kendo.ui.progress($("#grid"), true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                activate: function () {
                    window.kendo.ui.progress($("#grid"), false);
                },
                close: function () {
                    $("#grid").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Delete",
            width: 400,
            height: 220
        });

        mywindow.refresh({
            url: '@Url.Action("_RSMIDelete", "RSMI")',
        });
        mywindow.center().open();
    });

    $(".k-grid-btnPostBatch").click(function (e) {
        e.preventDefault()
        window.kendo.ui.progress($("#grid"), true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                activate: function () {
                    window.kendo.ui.progress($("#grid"), false);
                },
                close: function () {
                    $("#grid").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Batch Post",
            width: 400,
            height: 220
        });

        mywindow.refresh({
            url: '@Url.Action("_RSMIPostBatch", "RSMI")',
        });
        mywindow.center().open();
    });

    $(".k-grid-btnUnpostBatch").click(function (e) {
        e.preventDefault()
        window.kendo.ui.progress($("#grid"), true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                activate: function () {
                    window.kendo.ui.progress($("#grid"), false);
                },
                close: function () {
                    $("#grid").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Batch Unpost",
            width: 400,
            height: 220
        });

        mywindow.refresh({
            url: '@Url.Action("_RSMIUnpostBatch", "RSMI")',
        });
        mywindow.center().open();
    });


    function onRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
                trackingId = selectedId;
            }
        }
    }

    var postedBy = null;
    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedItemId = null;
        trackingId = selectedId;

        var grid = $("#grid");
        postedBy = selectedData.PostedBy;

        if (postedBy) {
            $(".k-grid-btnUnpost", grid).show();
            $(".k-grid-btnPost", grid).hide();            
        } else {
            $(".k-grid-btnUnpost", grid).hide();
            $(".k-grid-btnPost", grid).show();
        }

    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }
        var records = this.dataSource.total();
        //$("#btnPrint").data('kendoButton').enable(records > 0);
        //$("#btnPrintSum").data('kendoButton').enable(records > 0);
        var grid = $("#grid");
        if (records == 0) {
            $(".k-grid-btnDelete", grid).hide();
            $(".k-grid-btnPrint", grid).hide();
            $(".k-grid-btnPrintSum", grid).hide();
            $(".k-grid-btnPost", grid).hide();
            $(".k-grid-btnUnpost", grid).hide();
            $(".k-grid-btnPostBatch", grid).hide();
            $(".k-grid-btnUnpostBatch", grid).hide();
        }
        else {
            $(".k-grid-btnDelete", grid).show();
            $(".k-grid-btnPrint", grid).show();
            $(".k-grid-btnPrintSum", grid).show();
            $(".k-grid-btnPostBatch", grid).show();
            $(".k-grid-btnUnpostBatch", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
            selectedItemId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
        trackingId = selectedId;
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // Items
    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    // Printing

    $(".k-grid-btnPrint").click(function (e) {
        e.preventDefault();
        //window.kendo.ui.progress(document.body, true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                //activate: function () {
                //    window.kendo.ui.progress(document.body, false);
                //},
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Printing",
            width: 400,
            height: 390
        });

        mywindow.refresh({
            url: '@Url.Action("_PrintRsmi", "RSMI")'
        });
        mywindow.center().open();
    });

    $(".k-grid-btnPrintSum").click(function (e) {
        e.preventDefault();
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Printing",
            width: 400,
            height: 390
        });

        mywindow.refresh({
            url: '@Url.Action("_PrintSum", "RSMI")'
        });
        mywindow.center().open();
    });

    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Record was already posted by " + postedBy);
        }
        else {
            var msg = "Post selected record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("RsmiPost", "RSMI")',
                    data: { id: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record was successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost selcted record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("RsmiUnpost", "RSMI")',
                data: { id: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

</script>


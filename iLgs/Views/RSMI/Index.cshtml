@{
    ViewBag.Title = "RSMI";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.RsmiVM>()
        .Name("grid")
        .HtmlAttributes(new { style = "height: calc(90vh - 20px) !important;" })
        .Columns(col =>
        {
            col.Bound(c => c.Fund).Width(50);
            col.Bound(c => c.Date).Width(50);
            col.Bound(c => c.SerialNo).Width(50);
            col.Group(group => group.Title("Consumables")
               .Columns(info =>
               {
                   info.Bound(f => f.QtyCons)
                       .Width(50).Title("Qty")
                       .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                       .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                       .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                   info.Bound(f => f.AmountCons)
                       .Width(50).Title("Amount")
                       .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                       .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                       .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
               }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
            col.Group(group =>
            {
                group.Title("Semi-Expendable Properties").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                .Columns(c =>
                {
                    c.Group(g =>
                    {
                        g.Title("High Value").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                        .Columns(info =>
                        {
                            info.Bound(f => f.QtySPHV)
                                .Width(50).Title("Qty")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                            info.Bound(f => f.AmountSPHV)
                                .Width(50).Title("Amount")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                        });
                    });
                    c.Group(g =>
                    {
                        g.Title("Low Value").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                        .Columns(info =>
                        {
                            info.Bound(f => f.QtySPLV)
                                .Width(50).Title("Qty")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                            info.Bound(f => f.AmountSPLV)
                                .Width(50).Title("Amount")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                        });
                    });
                    c.Group(g =>
                    {
                        g.Title("Total").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                        .Columns(info =>
                        {
                            info.Bound(f => f.QtySE)
                                .Width(50).Title("Qty")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                            info.Bound(f => f.AmountSE)
                                .Width(50).Title("Amount")
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                        });
                    });
                });
            });
            col.Group(group => group.Title("Total")
               .Columns(info =>
               {
                   info.Bound(f => f.Qty)
                       .Width(50).Title("Qty")
                       .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                       .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                       .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
                   info.Bound(f => f.Amount)
                       .Width(50).Title("Amount")
                       .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                       .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                       .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
                       .HeaderHtmlAttributes(new { style = "text-align:right;" }).Filterable(false);
               }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );

@{
    ViewBag.Title = "RSMI";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.RsmiVM>()
        .Name("grid")
        .HtmlAttributes(new { @class = "max-grid" })
        .Columns(col =>
        {
            col.Bound(c => c.Fund).Width(50);
            col.Bound(c => c.Date).Width(50);
            col.Bound(c => c.SerialNo).Width(50);
            col.Bound(c => c.Custodian).Width(50);
            col.Bound(c => c.PostedBy).Width(50);
            col.Bound(c => c.PostedDt).Width(50);
            col.Command(command =>
            {
                command.Edit();
                //command.Destroy();
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            }).Width(100);
        })
        .ToolBar(toolbar =>
        {
            toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd").Content("Add New Record").Enable(false)
                    .Events(e => e.Click("onClickBtnAdd"))
                )
            <span id="span_">
                @(Html.Kendo().Button().Icon("k-icon k-i-print").Content("Print").Name("btnPrint").Events(e => e.Click("onClickBtnPrint")).Enable(true))                
            </span>
        </text>);
        })
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_StockTemplate").Window(w => w.Width(500).Title("Stocks")))
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(430))
        //.HtmlAttributes(new { style="height: 100%; border: 0;"})
        //.Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError")
                .RequestEnd("onRequestEnd")
            )
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.Fund).Editable(false);
                model.Field(p => p.Date).Editable(false);
                model.Field(p => p.SerialNo).Editable(false);
            })
            .Read(read => read.Action("RSMIRead", "RSMI"))
            //.Create(create => create.Action("StockCreate", "RSMI"))
            .Update(update => update.Action("RSMIUpdate", "RSMI"))
            .Destroy(destroy => destroy.Action("RSMIDestroy", "RSMI"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("ITEMS")
                .Selected(true)
                .Content(@<text>
                    @(Html.Kendo().Grid<iLgs.Models.RSMIItemVM>()
                        .Name("gridItems_#=Id#")
                        .Columns(columns =>
                        {
                            columns.Bound(f => f.RisNo).Width(70);
                            columns.Bound(f => f.RCC).Width(50);
                            columns.Bound(f => f.StockNo).Width(100);
                            columns.Bound(f => f.ItemName).Width(200);
                            columns.Bound(f => f.Unit).Width(50);
                            columns.Bound(f => f.UnitCost).Width(70)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                            columns.Bound(f => f.Qty).Width(50)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });                            
                            columns.Bound(f => f.Amount).Width(70)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        })
                        .Selectable()
                        .Navigatable()
                        .NoRecords()
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                            })
                            .Aggregates(a =>
                            {
                                a.Add(p => p.Qty).Sum();
                                a.Add(p => p.Amount).Sum();
                            })
                            .Events(events => events.Error("GridError"))
                            .Read("RSMIItemRead", "RSMI", new { rsmiId = "#=Id#" })
                        )
                            //.Events(e => e.Edit("onEditGridStockItems").Change("onChangeGridStockItems").DataBound("onDataBoundGridStockItems"))
                .ToClientTemplate()
                    )
                </text>);
            items.Add()
                .Text("RECAP")                
                .Content(@<text>
                    @(Html.Kendo().Grid<iLgs.Models.RSMIRecapVM>()
                        .Name("gridRecap_#=Id#")
                        .Columns(columns =>
                        {
                            columns.Bound(f => f.StockNo).Width(70);
                            columns.Bound(f => f.UnitCost).Width(70)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                            columns.Bound(f => f.Qty).Width(70)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });                            
                            columns.Bound(f => f.TotalCost).Width(70)
                                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                            columns.Bound(f => f.AccountCode).Width(70);
                        })
                        .Selectable()
                        .Navigatable()
                        .NoRecords()
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                            })
                            .Aggregates(a =>
                            {
                                a.Add(p => p.Qty).Sum();
                                a.Add(p => p.TotalCost).Sum();
                            })
                            .Events(events => events.Error("GridError"))
                            .Read("RSMIRecapRead", "RSMI", new { rsmiId = "#=Id#" })
                        )
                //.Events(e => e.Edit("onEditGridStockItems").Change("onChangeGridStockItems").DataBound("onDataBoundGridStockItems"))
                .ToClientTemplate()
                    )
                </text>);
        })
        .ToClientTemplate()
)
</script>

<div id="windowcontainer"></div>

<style>
    .k-tabstrip-content.k-state-active, .k-tabstrip > .k-content.k-state-active {
        overflow-x: hidden;
    }

    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
        overflow-x: hidden;
    }

    .k-prompt-container, .k-window-content {
        overflow-x: hidden;
    }

    #span_ {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: 7em;
    }
</style>

<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>

<script type="text/javascript">
    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selecteItemId = null;

    // MAIN GRID

    function onClickBtnAdd(e) {
        e.preventDefault()
        window.kendo.ui.progress($("#grid"), true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    activate: function () {
                        window.kendo.ui.progress($("#grid"), false);
                    },
                    close: function () {
                        $("#grid").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Add",
            width: 400,
            height: 370
        });

        mywindow.refresh({
            url: '@Url.Action("_RSMIAdd", "RSMI")',
        });
        mywindow.center().open();
    }


    function onRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedItemId = null;

        //var gridItems = $("#gridItems_" + selectedId).data("kendoGrid")
        //gridItems.dataSource.read();
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }
        var records = this.dataSource.total();
        $("#btnAdd").data('kendoButton').enable(true);
        $("#btnPrint").data('kendoButton').enable(records > 0);
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
            selectedItemId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // Items
    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    // Printing

    function onClickBtnPrint(e) {
        //window.kendo.ui.progress(document.body, true);
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    //activate: function () {
                    //    window.kendo.ui.progress(document.body, false);
                    //},
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "RSMI Printing",
            width: 400,
            height: 250
        });

        mywindow.refresh({
            url: '@Url.Action("_PrintRsmi", "RSMI")'
        });
        mywindow.center().open();
    }

</script>


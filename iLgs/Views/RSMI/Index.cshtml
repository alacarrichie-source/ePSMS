            col.Bound(c => c.PostedDt).Width(50);
            col.Command(command =>
            {
                command.Destroy();
                //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            }).Width(50);
        })
        .ToolBar(t =>
        {
            t.Custom().Text("Add Record").IconClass("k-icon k-i-add").Name("btnAdd").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Delete Record").IconClass("k-icon k-i-close").Name("btnDelete").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Print RSMI").IconClass("k-icon k-i-print").Name("btnPrint").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Print Summary").IconClass("k-icon k-i-print").Name("btnPrintSum").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Batch Post").IconClass("k-icon k-i-lock").Name("btnPostBatch").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Batch Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostBatch").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Search();
        })
        .Search(s =>
        {
            s.Field(o => o.Fund, "contains");
            s.Field(o => o.SerialNo, "contains");
            s.Field(o => o.PostedBy, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(430))
        //.HtmlAttributes(new { style="height: 100%; border: 0;"})
        //.Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError")
                .RequestEnd("onRequestEnd")
            )
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.Fund).Editable(false);
                model.Field(p => p.Date).Editable(false);
                model.Field(p => p.SerialNo).Editable(false);
                model.Field(p => p.QtyCons).Editable(false);
                model.Field(p => p.AmountCons).Editable(false);
                model.Field(p => p.QtySPHV).Editable(false);
                model.Field(p => p.AmountSPHV).Editable(false);
                model.Field(p => p.QtySPLV).Editable(false);
                model.Field(p => p.AmountSPLV).Editable(false);
                model.Field(p => p.QtySE).Editable(false);
                model.Field(p => p.AmountSE).Editable(false);
                model.Field(p => p.Qty).Editable(false);
                model.Field(p => p.Amount).Editable(false);
                model.Field(p => p.PostedBy).Editable(false);
                model.Field(p => p.PostedDt).Editable(false);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyCons).Sum();
                a.Add(p => p.QtySE).Sum();
                a.Add(p => p.QtySPHV).Sum();
                a.Add(p => p.QtySPLV).Sum();
                a.Add(p => p.Amount).Sum();
                a.Add(p => p.AmountCons).Sum();
                a.Add(p => p.AmountSE).Sum();
                a.Add(p => p.AmountSPHV).Sum();
                a.Add(p => p.AmountSPLV).Sum();
            })
            .Sort(s => { s.Add(a => a.Fund); s.Add(a => a.Date); })
            .Read(read => read.Action("RSMIRead", "RSMI"))
            //.Create(create => create.Action("StockCreate", "RSMI"))
            //.Update(update => update.Action("RSMIUpdate", "RSMI"))
            .Destroy(destroy => destroy.Action("RSMIDestroy", "RSMI"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        )
)


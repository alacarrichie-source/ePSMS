<style>
    .required:after {
        content: "*";
        font-weight: bold;
        color: red;
    }
</style>

<script type="text/javascript">

    $(document).ready(function () {
        if ('@ViewBag.Ownership' == 1) {
            $("#NameCorporate").removeAttr('disabled')
            //$("#Corporate").show();
            //$("label[for='NameLast']").text("Last Name");
        } else {
            $("#NameCorporate").attr('disabled', 'disabled');
            //$("#Corporate").hide();
            //$("label[for='NameLast']").text("Name");
        }
    });


    function onSelectCountry(e) {
        //var dataItem = this.dataItem(e.item.index());
        //alert("event :: select (" + dataItem.Text + " : " + dataItem.Value + ")");

        var index = e.item.index();

        //190 = philippines
        if (index == 190) {
            $("#Province").data('kendoComboBox').select(47);
            $("#Province").data('kendoComboBox').enable(true);
            $("#City").removeAttr('disabled');
            $("#City").val("Manila City");
        } else {
            $("#Province").data('kendoComboBox').select(0);
            $("#Province").data('kendoComboBox').enable(false);
            $("#City").attr('disabled', 'disabled');
            $("#City").val("");
        }
    }

    function ToggleInfo(el) {
        if (el.value == 1) {
            $("#NameCorporate").removeAttr('disabled')
            //$("#NameFirst").removeAttr('disabled');
            //$("#NameMid").removeAttr('disabled');
            //$("#Individual").show();
            //$("label[for='NameLast']").text("Last Name");
        } else {
            $("#NameCorporate").attr('disabled', 'disabled');
            //$("#NameFirst").attr('disabled', 'disabled');
            //$("#NameMid").attr('disabled', 'disabled');
            //$("#Individual").hide();
            //$("label[for='NameLast']").text("Name");
        }
    }

</script>

<div>
    <div class="row">
        <div class="col-md-7">
            <div class="row">
                @(Html.Kendo().Grid<iLgs.Models.ParIcsItemVm>()
                    .Name("gridItems_" + @ViewData["PoNo"])
                    .Columns(col =>
                    {
                        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.Unit).Width(50);
                        col.Bound(c => c.UnitCost).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}").HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.TotalCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.Article).Width(100);
                        col.Bound(c => c.Description).Width(100);
                    })
                    .ToolBar(t =>
                    {
                        t.Template(@<text>
                            <div style="padding: 10px; font-size: 14px; font-weight: bold;">
                                Individual Item
                            </div>
                        </text>);
                    })
                    .Sortable()
                    .NoRecords()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("GridError")
                        )
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Aggregates(a =>
                        {
                            a.Add(p => p.Qty).Sum();
                            a.Add(p => p.TotalCost).Sum();
                        })
                        .Sort(s => s.Add(a => a.InsertedDt))
                        .Read(read => read.Action("_PoItemsRead", "ParSet", new { poNo = @ViewData["PoNo"] }))
                    )
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                //.ToClientTemplate()
                    .Events(e => e
                        //.Edit("onEditGridItems")
                        .Change("onChangeGridItems")
                        .DataBound("onDataBoundGridItems")
                    )
                )
            </div>
            <br />
            <div class="row">
                @(Html.Kendo().Grid<iLgs.Models.ParIcsItemSetVm>()
                    .Name("gridItemSet_" + @ViewData["PoNo"])
                    .Columns(col =>
                    {
                        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.Unit).Width(50);
                        col.Bound(c => c.UnitCost).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}").HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.TotalCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    })
                    .ToolBar(t =>
                    {
                        t.Template(@<text>
                        <div style="padding: 10px; font-size: 14px; font-weight: bold;">
                            Set Items
                        </div>
                        </text>);
                    })
                    .ClientDetailTemplateId("item-set-description-template")
                    .Sortable()
                    .NoRecords()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("GridError")
                        )
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Aggregates(a =>
                        {
                            a.Add(p => p.Qty).Sum();
                            a.Add(p => p.TotalCost).Sum();
                        })
                        .Sort(s => s.Add(a => a.InsertedDt))
                        .Read(read => read.Action("_PoItemSetRead", "ParSet", new { poNo = @ViewData["PoNo"] }))
                    )
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                    .Events(e => e
                        //.Edit("onEditGridItemSet")
                        //.Change("onChangeGridItemSet")
                        .DataBound("onDataBoundGridItemSet")
                        )
                )
            </div>
        </div>
        <div class="col-md-5">
            <div class="row">
                @(Html.Kendo().Grid<iLgs.Models.IcsParItem>()
                    .Name("gridItemsPar_" + @ViewData["PoNo"])
                    .Columns(col =>
                    {
                        col.Bound(c => c.IcsPar.RefNo).Title("PAR No.").Width(70);
                        col.Bound(c => c.IcsPar.RefDate).Title("PAR Date").Width(70);
                        col.Bound(c => c.PropNo).Title("Property No.").Width(70);                        
                    })
                    .ToolBar(t =>
                    {
                        t.Template(@<text>
                    <div style="padding: 10px; font-size: 14px; font-weight: bold;">
                        PARS
                    </div>
                        </text>);
                    })
                    .Sortable()
                    .NoRecords()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("GridError")
                        )
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Sort(s => { s.Add(a => a.IcsPar.RefNo); s.Add(a => a.PropNo); })
                        .Read(read => read.Action("_PoItemsRead", "ParSet")) // .Data("DataGridItemPar"))
                    )
                    .AutoBind(false)
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                //.ToClientTemplate()
                //.Events(e => e
                //    .Edit("onEditGridItems")
                //    .Change("onChangeGridItems")
                //    .DataBound("onDataBoundGridItems")
                //)
                )
            </div>
        </div>
    </div>
</div>

<script id="item-template" type="text/x-kendo-template">

</script>

<script id="item-set-template" type="text/x-kendo-template">

</script>
@helper RenderGridSelections()
{
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnSetVM>()
        .Name("gridSelections")
        .Columns(col =>
        {
            col.Select().Width(30);
            col.Bound(c => c.SetLotNo).Width(50);
            col.Bound(c => c.SetLotQtyNo).Width(50);
            col.Bound(c => c.ContentNo).Width(50);
            col.Bound(c => c.Description).Width(100);
            col.Bound(c => c.RefNo).Width(100);
        })
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Multiple))
        .Scrollable(s => s.Height(200))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Sort(s =>
            {
                s.Add(a => a.SetLotNo);
                s.Add(a => a.SetLotQtyNo);
                s.Add(a => a.Description);
                s.Add(a => a.ContentNo);
            })
            .Read(read => read.Action("_GenerateParSelectionSetRead", "ParSet", new { unitGroupId = @ViewData["unitGroupId"] }))
        )
        .Events(e => e.Change("onChangeGridItemExtns"))
        .AutoBind(true)
)
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');

            // Get reference to Grid object
            var grid = $("#gridSelections").data("kendoGrid");
            // Get selected rows
            var selectedRows = $("input:checked", grid.tbody).closest("tr");
            // Get data item for each

            //var selectedIds = grid.selectedKeyNames().join(",");

            // Retrieve the dataItems of the selected rows
            var selectedIds = selectedRows.map(function () {
                return grid.dataItem(this);
            }).get(); // Convert to an array

            //$("#SelectedIds").val(selectedIds);
            $("#SelectedIds").val(JSON.stringify(selectedIds));

            $.ajax({
                type: "POST",
                url: '@Url.Action("GeneratePar", "ParSet")',
                data: $("#form").serialize(),
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                }, error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>








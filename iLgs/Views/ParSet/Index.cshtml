    function RefreshDivs() {
        var fieldsContainer = $('#DIV_ALLFIELDS');

        fieldsContainer.empty(); // Clear existing content

        var url = '@Url.Action("LoadFields", "ParSet")';
        var data = $("#form").serialize();

        $.ajax({
            url: url,
            type: 'POST',
            data: data,
            success: function(data) {
                fieldsContainer.html(data);
                resizeWindow();
            }
        });
    }

    var selectedItemParId = null;
    function onChangeGridItemsPar(e) {
        var selectedData = this.dataItem(this.select());

        selectedItemParId = selectedData.Id;
    }

    function onDataBoundGridItemsPar(e) {
        if (selectedItemParId) {
            var dataItem = this.dataSource.get(selectedItemParId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        }
    }

    function onClickDeleteGridParItems(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function onClickBtnEditParsItem(e) {
        e.preventDefault();
        // the current row for this detail
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        //var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        ParItem(dataItem.Id);
    }

    function ParItem(recId) {
        var myTitle = "PAR Item - EDIT";
        var width = 800;
        var height = 650;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    close: function () {
                        $("#gridItemsPar").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    },
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_ParItemEdit", "ParSet")',
            data: {
                parItemId: recId
            },
            complete: function () {
                RefreshDivs(); //item info edit not allowed here, use stock card.
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

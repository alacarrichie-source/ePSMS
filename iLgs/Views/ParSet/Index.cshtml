<!-- CLIENT-SIDE SCRIPTING -->
<script type="text/javascript">
    var selectedPoId = null;
    var selectedPoNo = null;
    var selectedPoDate = null;
    var selectedDeptId = null;

    $(document).ready(function () {
        fetchSummaryMetrics();
    });

    // Helper: Safely get the active PO Year as an integer
    function getSelectedYear() {
        try {
            var nt = $("#forYear").data("kendoNumericTextBox");
            if (nt && typeof nt.value === "function") {
                var val = nt.value();
                if (val && !isNaN(val)) return parseInt(val, 10);
            }
            var raw = $("#forYear").val();
            if (raw) {
                var cleaned = ("" + raw).replace(/[^\d]/g, '');
                if (cleaned.length > 0) {
                    var p = parseInt(cleaned, 10);
                    if (!isNaN(p) && p > 0) return p;
                }
            }
        } catch (e) {
            console.warn("Error reading forYear, defaulting:", e);
        }
        return @forYear;
    }

    // Helper: Safely get the active Source filter as an integer (0: All, 1: Manual, 2: Live Records)
    function getSelectedSource() {
        try {
            var ddl = $("#Source").data("kendoDropDownList");
            if (ddl && typeof ddl.value === "function") {
                var val = ddl.value();
                if (val !== undefined && val !== null && val !== "") {
                    var p = parseInt(val, 10);
                    if (!isNaN(p) && (p === 1 || p === 2)) return p;
                }
            }
            var raw = $("#Source").val();
            if (raw !== undefined && raw !== null && raw !== "") {
                var pr = parseInt(raw, 10);
                if (!isNaN(pr) && (pr === 1 || pr === 2)) return pr;
            }
        } catch (e) {
            console.warn("Error reading Source, defaulting to 0:", e);
        }
        return 0;
    }

    function onChangeForYear(e) {
        refreshWorkspace(true);
    }

    function onChangeSource(e) {
        refreshWorkspace(true);
    }

    // SECTION 2: FETCH SUMMARY METRICS
    function fetchSummaryMetrics() {
        var year = getSelectedYear();
        var source = getSelectedSource();
        $.ajax({
            url: '@Url.Action("GetSummaryMetrics", "ParSet")',
            type: "GET",
            data: { forYear: year, source: source },
            dataType: "json",
            success: function (res) {
                if (res && res.success) {
                    $("#metricTotalPos").text(res.totalPos || 0);
                    $("#metricPending").text(res.pending || 0);
                    $("#metricPartial").text(res.partial || 0);
                    $("#metricCompleted").text(res.completed || 0);
                    $("#metricRemaining").text(res.remainingItems || 0);
                }
            },
            error: function (xhr, status, error) {
                console.warn("Could not fetch summary metrics:", error);
            }
        });
    }

    function refreshWorkspace(reloadMaster) {
        fetchSummaryMetrics();
        if (reloadMaster) {
            var ordersGrid = $("#gridOrders").data("kendoGrid");
            if (ordersGrid) {
                ordersGrid.dataSource.read();
            }
        }
        if (selectedPoNo) {
            refreshCurrentPo(false);
        }
    }

    // MASTER PO GRID DATA & EVENTS
    function DataGridOrders() {
        return {
            forYear: getSelectedYear(),
            source: getSelectedSource()
        };
    }

    function onGridOrdersRequestEnd(e) {
        if (e.type === "read" && e.response) {
            fetchSummaryMetrics();
        }
    }

    function onGridOrdersError(e) {
        var msg = "An error occurred loading purchase orders.";
        if (e.errors) {
            if (typeof e.errors === "string") msg = e.errors;
            else if ($.isArray(e.errors)) msg = e.errors.join("; ");
        }
        notifyWarning(msg);
    }

    function onDataBoundOrdersGrid(e) {
        var grid = e.sender;
        var data = grid.dataSource.view();
        $("#poListCountBadge").text(data.length + " Orders");

        if (data.length > 0) {
            var targetRow = null;
            if (selectedPoId) {
                for (var i = 0; i < data.length; i++) {
                    if (data[i].Id === selectedPoId) {
                        targetRow = grid.tbody.find("tr[data-uid='" + data[i].uid + "']");
                        break;
                    }
                }
            }
            if (!targetRow || targetRow.length === 0) {
                targetRow = grid.tbody.find("tr:first");
            }
            if (targetRow.length > 0) {
                grid.select(targetRow);
                var item = grid.dataItem(targetRow);
                selectPoFromDataItem(item, targetRow);
            }
        } else {
            $("#selectedPoWorkspace").hide();
            $("#poEmptyState").show();
            selectedPoId = null;
            selectedPoNo = null;
            selectedPoDate = null;
            selectedDeptId = null;
        }
    }

    function onChangeOrdersGrid(e) {
        var grid = e.sender;
        var selected = grid.select();
        if (selected.length > 0) {
            var item = grid.dataItem(selected);
            selectPoFromDataItem(item, selected);
        }
    }

    function onSelectPoRowByElement(element) {
        var tr = $(element).closest("tr");
        var grid = $("#gridOrders").data("kendoGrid");
        if (grid && tr.length > 0) {
            grid.select(tr);
        }
    }

    function selectPoFromDataItem(dataItem, tr) {
        if (!dataItem) return;
        selectedPoId = dataItem.Id;
        selectedPoNo = dataItem.PoNo;
        selectedPoDate = dataItem.PoDate;
        selectedDeptId = dataItem.DeptId;

        $(".ics-po-item").removeClass("active");
        if (tr) {
            $(tr).find(".ics-po-item").addClass("active");
        }

        $("#poEmptyState").hide();
        $("#selectedPoWorkspace").css("display", "flex");

        // Fetch PO header details
        var poDateStr = selectedPoDate ? kendo.toString(kendo.parseDate(selectedPoDate), "yyyy-MM-dd") : null;
        $.ajax({
            url: '@Url.Action("GetPoDetails", "ParSet")',
            type: "GET",
            data: {
                poNo: selectedPoNo,
                poDate: poDateStr,
                deptId: selectedDeptId,
                source: getSelectedSource()
            },
            dataType: "json",
            success: function (res) {
                if (res && res.success) {
                    renderSelectedPoHeader(res);
                }
            }
        });

        refreshItemsGrid();
        refreshGeneratedSlipsGrid();
    }

    function renderSelectedPoHeader(d) {
        $("#lblDetailPoNo").text(d.poNo || selectedPoNo);
        $("#lblDetailDept").text(d.department || "General Services Office");
        //$("#lblDetailSupplier").text(d.supplier || "--");
        $("#lblDetailPoDate").text(d.poDate || "--");
        $("#lblDetailFund").text(d.fund || "General Fund");
        //$("#lblDetailMode").text(d.poMode || "--");
        $("#lblDetailAcqValue").text(kendo.toString(d.acqValue || 0, "c2"));

        var tot = d.totalItems || 0;
        var fin = d.finishedItems || 0;
        var bal = d.balanceItems || 0;
        $("#lblDetailItemStats").text(tot + " Total / " + fin + " Issued");

        var pct = tot > 0 ? Math.min(100, Math.round((fin / tot) * 100)) : 0;
        $("#lblProgressRatio").text(fin + " of " + tot + " Processed (" + pct + "%)");
        $("#barProgressFill").css("width", pct + "%");
        $("#lblProgressRemaining").text(bal + " Accountable Property Items Remaining");

        var statusClass = "status-unposted";
        var statusText = "Pending";
        if (bal === 0 && tot > 0) {
            statusClass = "status-accepted";
            statusText = "Complete";
        } else if (fin > 0) {
            statusClass = "status-acceptance-progress";
            statusText = "Partial";
        }
        $("#badgeDetailPoStatus").attr("class", "status-badge " + statusClass).text(statusText);
    }

    function refreshCurrentPo(showProgress) {
        if (!selectedPoNo) return;
        if (showProgress) {
            kendo.ui.progress($("#selectedPoWorkspace"), true);
        }
        var poDateStr = selectedPoDate ? kendo.toString(kendo.parseDate(selectedPoDate), "yyyy-MM-dd") : null;
        $.ajax({
            url: '@Url.Action("GetPoDetails", "ParSet")',
            type: "GET",
            data: {
                poNo: selectedPoNo,
                poDate: poDateStr,
                deptId: selectedDeptId,
                source: getSelectedSource()
            },
            dataType: "json",
            success: function (res) {
                if (showProgress) {
                    kendo.ui.progress($("#selectedPoWorkspace"), false);
                }
                if (res && res.success) {
                    renderSelectedPoHeader(res);
                }
            },
            error: function () {
                if (showProgress) {
                    kendo.ui.progress($("#selectedPoWorkspace"), false);
                }
            }
        });

        refreshItemsGrid();
        refreshGeneratedSlipsGrid();
        fetchSummaryMetrics();
    }

    // SEARCH & FILTER PILLS
    function onFilterMasterList() {
        var filterVal = $.trim($("#txtPoSearch").val()).toLowerCase();
        var activePill = $(".filter-pill-btn.active").data("filter") || "ALL";

        var grid = $("#gridOrders").data("kendoGrid");
        if (!grid) return;

        var filters = [];
        if (filterVal) {
            filters.push({
                logic: "or",
                filters: [
                    { field: "PoNo", operator: "contains", value: filterVal },
                    { field: "Department", operator: "contains", value: filterVal }
                ]
            });
        }

        if (activePill === "PENDING") {
            filters.push({ field: "QtyFinished", operator: "eq", value: 0 });
            filters.push({ field: "Qty", operator: "gt", value: 0 });
        } else if (activePill === "PARTIAL") {
            filters.push({ field: "QtyFinished", operator: "gt", value: 0 });
            filters.push({ field: "QtyBalance", operator: "gt", value: 0 });
        } else if (activePill === "COMPLETED") {
            filters.push({ field: "QtyBalance", operator: "eq", value: 0 });
            filters.push({ field: "Qty", operator: "gt", value: 0 });
        }

        grid.dataSource.filter(filters.length > 0 ? { logic: "and", filters: filters } : {});
    }

    function onSelectStatusFilter(btn, filterType) {
        $(".filter-pill-btn").removeClass("active");
        $(btn).addClass("active");
        onFilterMasterList();
    }

    // TAB 1: INDIVIDUAL ACCOUNTABLE ITEMS
    function DataGridItems() {
        return {
            poNo: selectedPoNo,
            poDate: selectedPoDate,
            deptId: selectedDeptId
        };
    }

    function refreshItemsGrid() {
        var grid = $("#gridItems").data("kendoGrid");
        if (grid) {
            grid.dataSource.read();
        }
    }

    var lastExpandedItemUid = null;
    function onDetailExpandItemGrid(e) {
        var itemUid = $(e.masterRow).attr("data-uid");
        lastExpandedItemUid = itemUid;
    }

    function onDataBoundItemsGrid(e) {
        var grid = e.sender;
        var data = grid.dataSource.view();
        if (data.length > 0) {
            var targetRow = null;
            if (lastExpandedItemUid) {
                targetRow = grid.tbody.find("tr[data-uid='" + lastExpandedItemUid + "']");
            }
            if (!targetRow || targetRow.length === 0) {
                targetRow = grid.tbody.find("tr.k-master-row:first");
            }
            if (targetRow && targetRow.length > 0) {
                grid.expandRow(targetRow);
            }
        }
    }

    function onDetailInitItemUnitsGrid(e) {
        var parentItemId = e.data.Id;
        var $container = e.detailCell.find(".item-units-detail-container");
        var $gridTarget = $container.find(".item-units-grid-target");

        $gridTarget.kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: '@Url.Action("_PoItemGeneratedUnitsRead", "ParSet")',
                        type: 'POST',
                        data: function () {
                            return { psCardItemId: parentItemId };
                        }
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors",
                    model: {
                        id: "PsCardItemExtnId",
                        fields: {
                            Id: { type: "string" },
                            UnitNo: { type: "number" },
                            PsCardItemExtnId: { type: "string" },
                            SerialNo: { type: "string" },
                            ParNo: { type: "string" },
                            PropNo: { type: "string" },
                            AccountableOfficer: { type: "string" },
                            Position: { type: "string" },
                            Status: { type: "string" },
                            IsPosted: { type: "boolean" },
                            Action: { type: "string" }
                        }
                    }
                }
            },
            noRecords: {
                template: "<div style='padding: 10px 14px; color: rgb(100, 116, 139); font-style: italic; font-size: 12px;'><span class='k-icon k-i-info'></span> No physical accountable units found.</div>"
            },
            scrollable: true,
            sortable: false,
            pageable: false,
            resizable: true,
            columns: [
                {
                    field: "UnitNo",
                    title: "Unit #",
                    width: 70,
                    attributes: { style: "text-align: center; font-weight: 600; color: rgb(71, 85, 105);" },
                    headerAttributes: { style: "text-align: center;" }
                },
                {
                    field: "SerialNo",
                    title: "Serial / (Ref. No.)",
                    width: 150,
                    template: "<span style='font-family: Consolas, monospace; color: rgb(51, 65, 85);'>#: SerialNo #</span>"
                },
                {
                    field: "ParNo",
                    title: "PAR No.",
                    width: 150,
                    template: function (dataItem) {
                        if (dataItem.Status === "Posted" && dataItem.ParNo) {
                            return "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(22, 101, 52);'>" + kendo.htmlEncode(dataItem.ParNo) + "</span>";
                        } else if (dataItem.Status === "Draft" && dataItem.ParNo) {
                            return "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(3, 105, 161);'>" + kendo.htmlEncode(dataItem.ParNo) + "</span>";
                        } else {
                            return "<span class='text-muted' style='font-style: italic;'>&mdash;</span>";
                        }
                    }
                },
                {
                    field: "PropNo",
                    title: "Property No.",
                    width: 200,
                    template: "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(0, 37, 118);'>#: PropNo #</span>"
                },
                {
                    field: "AccountableOfficer",
                    title: "Accountable Officer",
                    width: 200,
                    template: function (dataItem) {

                        var officer = dataItem.AccountableOfficer || dataItem.IssuedTo;
                        var position = dataItem.AccountableOfficerPosition || dataItem.Position;

                        if (!officer || dataItem.Status === "Available") {
                            return "<span class='text-muted' style='font-style: italic;'>&mdash;</span>";
                        }

                        var officerVal = kendo.htmlEncode(officer);
                        var positionVal = position
                            ? kendo.htmlEncode(position)
                            : "";

                        var officerColor = "";

                        if (dataItem.Status === "Posted") {
                            officerColor = "color: rgb(22, 101, 52);";
                        } else if (dataItem.Status === "Draft") {
                            officerColor = "color: rgb(3, 105, 161);";
                        }

                        var html =
                            "<div>" +
                            "<div style='font-weight: 600; " + officerColor + "'>" +
                            officerVal +
                            "</div>";

                        if (positionVal) {
                            html +=
                                "<div style='font-size: 11px; color: rgb(100, 116, 139); margin-top: 2px;'>" +
                                positionVal +
                                "</div>";
                        }

                        html += "</div>";

                        return html;
                    }
                },                
                {
                    field: "Action",
                    title: "Action",
                    width: 150,
                    sortable: false,
                    template: function (dataItem) {
                        if (dataItem.Status === "Posted") {
                            return "<button type='button' class='btn-procurement-secondary btn-sm par-view-unit' data-par-no='" + kendo.htmlEncode(dataItem.ParNo) + "' title='View Posted PAR'>" +
                                "<span class='k-icon k-i-eye'></span> View PAR" +
                                "</button>";
                        } else if (dataItem.Status === "Draft") {
                            return "<button type='button' class='btn-procurement-secondary btn-sm par-continue-unit' data-extn-id='" + kendo.htmlEncode(dataItem.PsCardItemExtnId) + "' title='Continue / Edit Draft PAR'>" +
                                "<span class='k-icon k-i-edit'></span> Continue" +
                                "</button>";
                        } else {
                            return "<button type='button' class='btn-procurement-primary btn-sm par-generate-unit' data-extn-id='" + kendo.htmlEncode(dataItem.PsCardItemExtnId) + "' title='Generate PAR for Unit'>" +
                                "<span class='k-icon k-i-play'></span> Generate" +
                                "</button>";
                        }
                    }
                }
            ],
            dataBound: function (subEvt) {
                var subGrid = subEvt.sender;
                var data = subGrid.dataSource.data();
                if (data.length === 0) {
                    subGrid.element.find(".k-grid-header").hide();
                } else {
                    subGrid.element.find(".k-grid-header").show();
                }
            }
        });
    }

    function initSubgridIssuedToCombos(subGrid) {
        subGrid.element.find("input.subgrid-employee-combo").each(function () {
            var $input = $(this);
            var parItemId = $input.data("id");
            if (!parItemId || $input.data("kendoComboBox")) return;

            $input.kendoComboBox({
                placeholder: "Search recipient / accountable officer...",
                dataTextField: "Name",
                dataValueField: "Name",
                filter: "contains",
                suggest: true,
                autoBind: false,
                minLength: 1,
                dataSource: {
                    serverFiltering: true,
                    transport: {
                        read: {
                            url: '@Url.Action("GetEmployee", "Getters")',
                            type: "GET",
                            data: function (e) {
                                var text = "";
                                var cb = $input.data("kendoComboBox");
                                if (cb) {
                                    text = cb.text() || "";
                                }
                                return { text: text };
                            }
                        }
                    }
                },
                template: "<div style='font-size: 12px; padding: 2px 0;'>" +
                            "<div style='font-weight: 600; color: rgb(30, 41, 59);'>#: data.Name #</div>" +
                            "# if (typeof data.Department !== 'undefined' && data.Department) { #" +
                                "<div style='font-size: 11px; color: rgb(100, 116, 139);'>#: data.Department # # if (typeof data.Position !== 'undefined' && data.Position) { # (#: data.Position #) # } #</div>" +
                            "# } #" +
                          "</div>",
                change: function (e) {
                    var selectedName = this.text() || this.value();
                    if (selectedName) {
                        updateIssuedTo(parItemId, selectedName, this);
                    }
                }
            });
        });
    }

    function updateIssuedTo(parItemId, newIssuedTo, comboWidget) {
        if (!parItemId || !newIssuedTo) return;

        $.ajax({
            url: '@Url.Action("UpdateIssuedTo", "ParSet")',
            type: 'POST',
            data: {
                parItemId: parItemId,
                issuedTo: newIssuedTo
            },
            success: function (res) {
                if (res && res.success) {
                    notifySuccess(res.message || "Accountable Officer updated successfully.");
                } else {
                    var err = (res && res.message) ? res.message : "Failed to update Accountable Officer.";
                    notifyWarning(err);
                    alert(err);
                    if (err.indexOf("already been posted") !== -1) {
                        refreshWorkspace(true);
                    }
                }
            },
            error: function (xhr, status, error) {
                notifyWarning("Error updating Accountable Officer: " + (error || status));
                alert("Error updating Accountable Officer: " + (error || status));
            }
        });
    }


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                }
            });
            if (validationError) {
                alert("A server error occurred. Please refresh and try again.");
            }
        }
    }

    function DataGridGeneratedSlips() {
        return {
            poNo: selectedPoNo,
            poDate: selectedPoDate,
            deptId: selectedDeptId
        };
    }

    function refreshGeneratedSlipsGrid() {
        var grid = $("#gridGeneratedSlips").data("kendoGrid");
        if (grid) {
            grid.dataSource.read();
        }
    }

    function notifySuccess(message) {
        var notification = $("#parNotification").data("kendoNotification");
        if (notification) {
            notification.show(message, "success");
        }
    }

    function notifyWarning(message) {
        var notification = $("#parNotification").data("kendoNotification");
        if (notification) {
            notification.show(message, "warning");
        } else {
            alert(message);
        }
    }

    function htmlEncodeValue(value) {
        return kendo.htmlEncode(value === null || value === undefined ? "" : String(value));
    }

    function generatedSlipActionsTemplate(dataItem) {
        var id = htmlEncodeValue(dataItem.Id);
        var extnId = htmlEncodeValue(dataItem.MainPsCardItemExtnId);
        var refNo = htmlEncodeValue(dataItem.RefNo);
        var isPosted = dataItem.Status === "Posted";
        var html = "<div class='ics-actions-cell'>";

        html += "<button type='button' class='btn-procurement-secondary btn-sm par-view-slip' data-par-no='" + refNo + "' title='View Official PAR'><span class='k-icon k-i-eye'></span> View</button>";
        html += "<button type='button' class='btn-procurement-secondary btn-sm par-print-slip' data-par-no='" + refNo + "' title='Print Official Report'><span class='k-icon k-i-print'></span> Print</button>";

        if (isPosted) {
            html += "<button type='button' class='btn-procurement-warning btn-sm par-unpost-slip' data-par-no='" + refNo + "' title='Unpost Official PAR'><span class='k-icon k-i-undo'></span> Unpost</button>";
        } else {
            html += "<button type='button' class='btn-procurement-secondary btn-sm par-edit-slip' data-par-id='" + id + "' data-extn-id='" + extnId + "' title='Continue / Edit Draft PAR'><span class='k-icon k-i-edit'></span> Edit</button>";
            html += "<button type='button' class='btn-procurement-success btn-sm par-post-slip' data-par-no='" + refNo + "' title='Post Official PAR'><span class='k-icon k-i-check'></span> Post</button>";
            html += "<button type='button' class='btn-procurement-danger btn-sm par-delete-slip' data-par-id='" + id + "' data-par-no='" + refNo + "' title='Delete Draft PAR'><span class='k-icon k-i-delete'></span> Delete</button>";
        }

        return html + "</div>";
    }

    function antiForgeryData(values) {
        var data = values || {};
        data.__RequestVerificationToken = $(".epsms-par input[name='__RequestVerificationToken']").first().val();
        return data;
    }

    function ajaxFailureMessage(xhr, fallback) {
        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }
        if (xhr && xhr.responseText) {
            var responseText = $.trim($("<div>").html(xhr.responseText).text());
            if (responseText) {
                return responseText.length > 500 ? responseText.substring(0, 500) : responseText;
            }
        }
        if (xhr && xhr.statusText && xhr.statusText !== "error") {
            return xhr.statusText;
        }
        return fallback;
    }

    function setClickedButtonBusy($button, text) {
        if (!$button || !$button.length) return;
        $button.data("par-original-html", $button.html());
        $button.prop("disabled", true).addClass("k-state-disabled").html("<span class='k-icon k-i-loading'></span> " + text);
    }

    function restoreClickedButton($button) {
        if (!$button || !$button.length) return;
        var originalHtml = $button.data("par-original-html");
        $button.prop("disabled", false).removeClass("k-state-disabled");
        if (originalHtml) {
            $button.html(originalHtml).removeData("par-original-html");
        }
    }

    function removeDynamicWindow(selector) {
        var $element = $(selector);
        var widget = $element.data("kendoWindow");
        if (widget) {
            widget.destroy();
        }
        $element.remove();
    }

    function openParEditorForUnit(mainPsCardItemExtnId, isDraft, icsParId, $trigger) {
        if (!mainPsCardItemExtnId) {
            notifyWarning("The accountable physical unit could not be identified.");
            return;
        }

        setClickedButtonBusy($trigger, isDraft ? "Loading..." : "Loading...");
        removeDynamicWindow("#windowGeneratePar");
        $("#windowcontainer").append("<div id='windowGeneratePar'></div>");

        var editorWindow = $("#windowGeneratePar").kendoWindow({
            title: isDraft ? "Continue / Edit Draft PAR" : "Generate PAR",
            width: 1000,
            maxHeight: Math.max(500, $(window).height() - 40),
            actions: ["Close"],
            draggable: true,
            modal: true,
            visible: false,
            deactivate: function () {
                var $element = this.element;
                this.destroy();
                $element.remove();
            }
        }).data("kendoWindow");

        $.ajax({
            url: '@Url.Action("_GeneratePar", "ParSet")',
            type: "GET",
            cache: false,
            data: {
                mainPsCardItemExtnId: mainPsCardItemExtnId,
                icsParId: icsParId || null,
                refType: "P"
            },
            success: function (html) {
                if (!html) {
                    removeDynamicWindow("#windowGeneratePar");
                    notifyWarning("Unable to load the Draft PAR.");
                    return;
                }
                editorWindow.content(html);
                editorWindow.center().open();
            },
            error: function (xhr, status, error) {
                var message = ajaxFailureMessage(xhr, isDraft ? "Unable to load the Draft PAR." : "Unable to load the PAR editor.");
                if (window.console && console.error) {
                    console.error(message, xhr.status, status, error, xhr.responseText);
                }
                removeDynamicWindow("#windowGeneratePar");
                notifyWarning(message);
            },
            complete: function () {
                restoreClickedButton($trigger);
            }
        });
    }

    function openViewParModal(parNo) {
        if (!parNo) {
            notifyWarning("The PAR could not be identified.");
            return;
        }

        removeDynamicWindow("#windowViewPar");
        $("#windowcontainer").append("<div id='windowViewPar'></div>");
        var win = $("#windowViewPar").kendoWindow({
            title: "Property Acknowledgment Receipt - " + parNo,
            width: 900,
            modal: true,
            visible: false,
            actions: ["Close"],
            deactivate: function () {
                var $element = this.element;
                this.destroy();
                $element.remove();
            }
        }).data("kendoWindow");

        $.ajax({
            url: '@Url.Action("_ViewPar", "ParSet")',
            type: "GET",
            cache: false,
            data: { parNo: parNo },
            success: function (html) {
                win.content(html);
                win.center().open();
            },
            error: function (xhr, status, error) {
                var message = ajaxFailureMessage(xhr, "Unable to load the PAR.");
                if (window.console && console.error) {
                    console.error(message, xhr.status, status, error, xhr.responseText);
                }
                removeDynamicWindow("#windowViewPar");
                notifyWarning(message);
            }
        });
    }

    function closeViewParModal() {
        var win = $("#windowViewPar").data("kendoWindow");
        if (win) win.close();
    }

    function printOfficialPar(parNo) {
        if (!parNo) {
            notifyWarning("The PAR could not be identified.");
            return;
        }
        window.open('@Url.Action("ParSetRpt", "IcsParRpt")' + '?parNo=' + encodeURIComponent(parNo), '_blank');
    }

    var pendingDeleteParId = null;
    var pendingDeleteParNo = null;

    function confirmDeletePar(icsParId, parNo) {
        if (!icsParId) {
            notifyWarning("The Draft PAR could not be identified.");
            return;
        }
        pendingDeleteParId = icsParId;
        pendingDeleteParNo = parNo || "";
        $("#deleteModalParNo").text(pendingDeleteParNo);
        $("#btnConfirmDeletePar").prop("disabled", false).html("<span class='k-icon k-i-delete'></span> Delete PAR");

        var win = $("#windowDeletePar").data("kendoWindow");
        if (!win) {
            win = $("#windowDeletePar").kendoWindow({
                title: "Delete Draft PAR",
                width: 480,
                modal: true,
                visible: false
            }).data("kendoWindow");
        }
        win.center().open();
    }

    function closeDeleteParModal() {
        var win = $("#windowDeletePar").data("kendoWindow");
        if (win) win.close();
    }

    function executeDeletePar() {
        if (!pendingDeleteParId) return;
        var $button = $("#btnConfirmDeletePar");
        setClickedButtonBusy($button, "Deleting...");

        $.ajax({
            url: '@Url.Action("DeletePar", "ParSet")',
            type: "POST",
            data: antiForgeryData({ icsParId: pendingDeleteParId }),
            success: function (response) {
                restoreClickedButton($button);
                if (response && response.success) {
                    closeDeleteParModal();
                    notifySuccess(response.message || "Draft PAR deleted.");
                    pendingDeleteParId = null;
                    pendingDeleteParNo = null;
                    refreshWorkspace(true);
                } else {
                    notifyWarning(response && response.message ? response.message : "Unable to delete the Draft PAR.");
                }
            },
            error: function (xhr, status, error) {
                restoreClickedButton($button);
                var message = ajaxFailureMessage(xhr, "Unable to delete the Draft PAR.");
                if (window.console && console.error) {
                    console.error(message, xhr.status, status, error, xhr.responseText);
                }
                notifyWarning(message);
            }
        });
    }

    var pendingPostParNo = null;
    function confirmPostPar(parNo) {
        if (!parNo) return;
        pendingPostParNo = parNo;
        $("#postModalParNo").text(parNo);
        $("#postParAlertBox").show();
        $("#postParMissingAirWarning").hide();
        $("#btnConfirmPostPar").prop("disabled", false).html("<span class='k-icon k-i-check'></span> Post PAR");
        var win = $("#windowPostPar").data("kendoWindow");
        if (!win) {
            win = $("#windowPostPar").kendoWindow({ title: "Post Property Acknowledgment Receipt", width: 500, modal: true, visible: false }).data("kendoWindow");
        }
        win.center().open();
    }

    function closePostParModal() {
        var win = $("#windowPostPar").data("kendoWindow");
        if (win) win.close();
    }

    function openUploadFromPostModal() {
        var parNo = pendingPostParNo;
        closePostParModal();
        openUploadAirModal(null, parNo);
    }

    function executePostPar() {
        if (!pendingPostParNo) return;
        var $button = $("#btnConfirmPostPar");
        setClickedButtonBusy($button, "Posting...");
        $.ajax({
            url: '@Url.Action("PostPar", "ParSet")',
            type: "POST",
            data: antiForgeryData({ parNo: pendingPostParNo }),
            success: function (response) {
                restoreClickedButton($button);
                if (response && response.success) {
                    closePostParModal();
                    notifySuccess(response.message || "PAR posted.");
                    refreshWorkspace(true);
                } else {
                    var message = response && response.message ? response.message : "Unable to post the PAR.";
                    notifyWarning(message);
                    if (message.indexOf("AIR") >= 0) {
                        $("#postParAlertBox").hide();
                        $("#postParMissingAirWarning").show();
                    }
                }
            },
            error: function (xhr, status, error) {
                restoreClickedButton($button);
                var message = ajaxFailureMessage(xhr, "Unable to post the PAR.");
                if (window.console && console.error) console.error(message, xhr.status, status, error, xhr.responseText);
                notifyWarning(message);
            }
        });
    }

    var pendingUnpostParNo = null;
    function confirmUnpostPar(parNo) {
        if (!parNo) return;
        pendingUnpostParNo = parNo;
        $("#unpostModalParNo").text(parNo);
        $("#btnConfirmUnpostPar").prop("disabled", false).html("<span class='k-icon k-i-undo'></span> Unpost");
        var win = $("#windowUnpostPar").data("kendoWindow");
        if (!win) {
            win = $("#windowUnpostPar").kendoWindow({ title: "Unpost Property Acknowledgment Receipt", width: 500, modal: true, visible: false }).data("kendoWindow");
        }
        win.center().open();
    }

    function closeUnpostParModal() {
        var win = $("#windowUnpostPar").data("kendoWindow");
        if (win) win.close();
    }

    function executeUnpostPar() {
        if (!pendingUnpostParNo) return;
        var $button = $("#btnConfirmUnpostPar");
        setClickedButtonBusy($button, "Unposting...");
        $.ajax({
            url: '@Url.Action("UnpostPar", "ParSet")',
            type: "POST",
            data: antiForgeryData({ parNo: pendingUnpostParNo }),
            success: function (response) {
                restoreClickedButton($button);
                if (response && response.success) {
                    closeUnpostParModal();
                    notifySuccess(response.message || "PAR unposted.");
                    refreshWorkspace(true);
                } else {
                    notifyWarning(response && response.message ? response.message : "Unable to unpost the PAR.");
                }
            },
            error: function (xhr, status, error) {
                restoreClickedButton($button);
                var message = ajaxFailureMessage(xhr, "Unable to unpost the PAR.");
                if (window.console && console.error) console.error(message, xhr.status, status, error, xhr.responseText);
                notifyWarning(message);
            }
        });
    }

    function openUploadAirModal(id, parNo) {
        if (!parNo) return;
        removeDynamicWindow("#windowUploadAir");
        $("#windowcontainer").append("<div id='windowUploadAir'></div>");
        var win = $("#windowUploadAir").kendoWindow({
            title: "Attach Acceptance & Inspection Report (AIR) - " + parNo,
            width: 560,
            modal: true,
            visible: false,
            deactivate: function () {
                var $element = this.element;
                this.destroy();
                $element.remove();
            }
        }).data("kendoWindow");
        $.ajax({
            url: '@Url.Action("_UploadAir", "ParSet")',
            type: "GET",
            cache: false,
            data: { parNo: parNo },
            success: function (html) { win.content(html); win.center().open(); },
            error: function (xhr) {
                removeDynamicWindow("#windowUploadAir");
                notifyWarning(ajaxFailureMessage(xhr, "Unable to load the AIR upload form."));
            }
        });
    }

    function closeUploadAirModal() {
        var win = $("#windowUploadAir").data("kendoWindow");
        if (win) win.close();
    }

    function viewAirDocument(parId) {
        if (!parId) return;
        window.open('@Url.Action("ViewAirDocument", "ParSet")' + '?parId=' + encodeURIComponent(parId), '_blank');
    }

    function executeUploadAirFile(event) {
        event.preventDefault();
        var form = event.currentTarget;
        var data = new FormData(form);
        data.append("__RequestVerificationToken", $(".epsms-par input[name='__RequestVerificationToken']").first().val());
        var $button = $(form).find("#btnSubmitAirUpload");
        setClickedButtonBusy($button, "Uploading...");
        $.ajax({
            url: '@Url.Action("UploadAirFile", "ParSet")',
            type: "POST",
            data: data,
            processData: false,
            contentType: false,
            success: function (response) {
                restoreClickedButton($button);
                if (response && response.success) {
                    closeUploadAirModal();
                    notifySuccess(response.message || "AIR document uploaded.");
                    refreshWorkspace(true);
                } else {
                    notifyWarning(response && response.message ? response.message : "Unable to upload the AIR document.");
                }
            },
            error: function (xhr) {
                restoreClickedButton($button);
                notifyWarning(ajaxFailureMessage(xhr, "Unable to upload the AIR document."));
            }
        });
    }

    function executeReusePoAir(parId, sourceUploadId) {
        $.ajax({
            url: '@Url.Action("ReusePoAirFile", "ParSet")',
            type: "POST",
            data: antiForgeryData({ parId: parId, sourceUploadId: sourceUploadId }),
            success: function (response) {
                if (response && response.success) {
                    closeUploadAirModal();
                    notifySuccess(response.message || "AIR document linked.");
                    refreshWorkspace(true);
                } else {
                    notifyWarning(response && response.message ? response.message : "Unable to link the AIR document.");
                }
            },
            error: function (xhr) {
                notifyWarning(ajaxFailureMessage(xhr, "Unable to link the AIR document."));
            }
        });
    }

    $(document)
        .off("click.parGenerateUnit", ".par-generate-unit")
        .on("click.parGenerateUnit", ".par-generate-unit", function (e) {
            e.preventDefault();
            e.stopPropagation();
            openParEditorForUnit($(this).attr("data-extn-id"), false, null, $(this));
        })
        .off("click.parContinueUnit", ".par-continue-unit")
        .on("click.parContinueUnit", ".par-continue-unit", function (e) {
            e.preventDefault();
            e.stopPropagation();
            openParEditorForUnit($(this).attr("data-extn-id"), true, null, $(this));
        })
        .off("click.parViewUnit", ".par-view-unit")
        .on("click.parViewUnit", ".par-view-unit", function (e) {
            e.preventDefault();
            openViewParModal($(this).attr("data-par-no"));
        })
        .off("click.parEditSlip", ".par-edit-slip")
        .on("click.parEditSlip", ".par-edit-slip", function (e) {
            e.preventDefault();
            e.stopPropagation();
            openParEditorForUnit($(this).attr("data-extn-id"), true, $(this).attr("data-par-id"), $(this));
        })
        .off("click.parViewSlip", ".par-view-slip")
        .on("click.parViewSlip", ".par-view-slip", function (e) {
            e.preventDefault();
            openViewParModal($(this).attr("data-par-no"));
        })
        .off("click.parPrintSlip", ".par-print-slip")
        .on("click.parPrintSlip", ".par-print-slip", function (e) {
            e.preventDefault();
            printOfficialPar($(this).attr("data-par-no"));
        })
        .off("click.parPostSlip", ".par-post-slip")
        .on("click.parPostSlip", ".par-post-slip", function (e) {
            e.preventDefault();
            confirmPostPar($(this).attr("data-par-no"));
        })
        .off("click.parUnpostSlip", ".par-unpost-slip")
        .on("click.parUnpostSlip", ".par-unpost-slip", function (e) {
            e.preventDefault();
            confirmUnpostPar($(this).attr("data-par-no"));
        })
        .off("click.parDeleteSlip", ".par-delete-slip")
        .on("click.parDeleteSlip", ".par-delete-slip", function (e) {
            e.preventDefault();
            confirmDeletePar($(this).attr("data-par-id"), $(this).attr("data-par-no"));
        });

</script>

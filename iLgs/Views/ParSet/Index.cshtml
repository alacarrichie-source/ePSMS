    function GeneratePar(refType, cardItemId) {
        var myTitle = refType == "P" ? "Generate PAR" : "Generate ICS";
        var width = 800;

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    var grid = $("#gridItems").data("kendoGrid");
                    grid.dataSource.read();
                    //.then(function () {
                    //    // Find the row with the specified Id.
                    //    var dataItem = grid.dataSource.get(selectedId);

                    //    // If the row is found, read geneared items.
                    //    if (dataItem) {

                    //    }
                    //});
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_GeneratePar", "ParSet")',
            data: {
                psCardItemId: cardItemId,
                refType: refType
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }


    function stripTime(date) {
        return new Date(date.getFullYear(), date.getMonth(), date.getDate());
    }

    function selectRowByConditions(gridId, conditions) {
        var grid = $("#" + gridId).data("kendoGrid");
        var rows = grid.items();  // Get all the rows
        for (var i = 0; i < rows.length; i++) {
            var row = $(rows[i]);
            var dataItem = grid.dataItem(row);  // Get the data item for the current row
            var match = true;

            // Check all conditions
            for (var condition in conditions) {
                if (conditions.hasOwnProperty(condition)) {
                    if (condition === "PoDate") {
                        // Normalize dates before comparing
                        var conditionDate = stripTime(new Date(conditions[condition]));
                        var dataItemDate = stripTime(new Date(dataItem[condition]));

                        if (conditionDate.getTime() !== dataItemDate.getTime()) {
                            match = false;
                            break;
                        }
                    } else if (dataItem[condition] !== conditions[condition]) {
                        match = false;
                        break;
                    }
                }
            }

            if (match) {
                grid.select(row);  // Select the row
                return row;  // Found and selected the row, return it
            }
        }

        return null;  // No matching row found
    }



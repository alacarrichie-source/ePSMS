@* Index.cshtml - ePSMS Property Acknowledgment Receipt (PAR) Workspace *@
@using Kendo.Mvc.UI

@{
    ViewBag.Title = "Property Acknowledgment Receipts";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    var forYear = ViewBag.ForYear != null ? (int)ViewBag.ForYear : DateTime.Now.Year;
}

<link href="@Url.Content("~/Content/ics-workspace.css")" rel="stylesheet" type="text/css" />

<style type="text/css">
    .epsms-par .item-units-detail-container {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        padding: 10px 14px;
        background: rgb(248, 250, 252);
        border-radius: 4px;
        overflow-x: auto;
    }
    .epsms-par .item-units-detail-container .k-grid {
        min-width: 1050px;
        width: 100%;
    }
    .epsms-par .item-units-detail-container .k-grid-content {
        overflow-x: auto !important;
    }
    .epsms-par .k-detail-cell {
        overflow-x: auto !important;
    }
    .epsms-par #gridItems .k-grid-content {
        overflow-x: auto !important;
    }
    .epsms-par #gridGeneratedSlips .k-grid-content {
        overflow-x: auto !important;
    }
</style>

<div class="epsms-ics epsms-par">
    @Html.AntiForgeryToken()

    <!-- SECTION 1: BREADCRUMBS & HEADER BAR -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a> &gt;
        <a href="javascript:void(0)">Property &amp; Supply</a> &gt;
        <span>Property Acknowledgment Receipts</span>
    </div>

    <div class="header-bar">
        <div>
            <h1>Property Acknowledgment Receipts (PAR)</h1>
            <p class="subtitle">Manage capital property accountability and PAR issuance from accepted Purchase Orders</p>
        </div>
        <div class="d-flex align-items-center" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 6px; background: rgb(255, 255, 255); border: 1px solid rgb(203, 213, 225); border-radius: 6px; padding: 4px 10px;">
                <span class="k-icon k-i-calendar" style="color: rgb(0, 37, 118);"></span>
                <label for="forYear" style="margin: 0; font-weight: 600; font-size: 12px; color: rgb(71, 85, 105);">PO Year:</label>
                @(Html.Kendo().NumericTextBox()
                    .Name("forYear")
                    .HtmlAttributes(new { style = "width: 85px; font-weight: bold;" })
                    .Decimals(0)
                    .Spinners(true)
                    .Events(e => e.Change("onChangeForYear"))
                    .Format("0")
                    .Value(forYear)
                )
            </div>
            <div style="display: flex; align-items: center; gap: 6px; background: rgb(255, 255, 255); border: 1px solid rgb(203, 213, 225); border-radius: 6px; padding: 4px 10px;">
                <span class="k-icon k-i-filter" style="color: rgb(0, 37, 118);"></span>
                <label for="Source" style="margin: 0; font-weight: 600; font-size: 12px; color: rgb(71, 85, 105);">Source:</label>
                @(Html.Kendo().DropDownList()
                    .Name("Source")
                    .DataTextField("Text")
                    .DataValueField("Value")
                    .BindTo(new[] {
                        new { Text = "All", Value = "0" },
                        new { Text = "Manual", Value = "1" },
                        new { Text = "Live Records", Value = "2" }
                    })
                    .Value("0")
                    .HtmlAttributes(new { style = "width: 130px; font-weight: 500;" })
                    .Events(e => e.Change("onChangeSource"))
                )
            </div>
            <button type="button" class="btn-procurement-secondary" onclick="refreshWorkspace(true)" title="Refresh all data">
                <span class="k-icon k-i-refresh"></span> Refresh
            </button>
        </div>
    </div>

    <!-- SECTION 2: LIVE SUMMARY METRICS BAR -->
    <div class="summary-cards-row">
        <div class="summary-metric-card" id="cardTotalPos" title="Total eligible candidate Purchase Orders">
            <span class="metric-dot dot-gray"></span>
            <span class="metric-label">Total POs:</span>
            <span class="metric-val" id="metricTotalPos">0</span>
        </div>
        <div class="summary-metric-card metric-pending" id="cardPending" title="POs awaiting accountable officer assignment or PAR generation">
            <span class="metric-dot dot-amber"></span>
            <span class="metric-label">Pending PAR:</span>
            <span class="metric-val" id="metricPending">0</span>
        </div>
        <div class="summary-metric-card metric-partial" id="cardPartial" title="POs with partial PAR issuance completed">
            <span class="metric-dot dot-blue"></span>
            <span class="metric-label">Partially Processed:</span>
            <span class="metric-val" id="metricPartial">0</span>
        </div>
        <div class="summary-metric-card metric-completed" id="cardCompleted" title="POs with all accountable property items issued">
            <span class="metric-dot dot-green"></span>
            <span class="metric-label">Completed:</span>
            <span class="metric-val" id="metricCompleted">0</span>
        </div>
        <div class="summary-metric-card metric-remaining" id="cardRemaining" title="Total unissued accountable items across all POs">
            <span class="metric-dot dot-indigo"></span>
            <span class="metric-label">Remaining Items:</span>
            <span class="metric-val" id="metricRemaining">0</span>
        </div>
    </div>

    <!-- MAIN OPERATIONAL WORKSPACE (MASTER-DETAIL) -->
    <div class="ics-workspace-container">

        <!-- SECTION 3: MASTER PO PANE (LEFT ~38%) -->
        <div class="ics-master-pane">
            <div class="ics-master-header d-flex justify-content-between align-items-center">
                <div>
                    <h2>Purchase Orders</h2>
                    <p>Accepted orders with capital property</p>
                </div>
                <span class="badge badge-light border" id="poListCountBadge" style="font-size: 11px; font-weight: 600;">0 Orders</span>
            </div>

            <div class="ics-master-search-bar">
                <div style="position: relative;">
                    <span class="k-icon k-i-search" style="position: absolute; left: 10px; top: 9px; color: rgb(148, 163, 184);"></span>
                    <input type="text" id="txtPoSearch" class="k-textbox" placeholder="Search PO #, Dept..."
                           style="width: 100%; padding-left: 30px; font-size: 12px; height: 32px;" onkeyup="onFilterMasterList()" />
                </div>
                <div class="ics-filter-pills">
                    <button type="button" class="filter-pill-btn active" data-filter="ALL" onclick="onSelectStatusFilter(this, 'ALL')">All</button>
                    <button type="button" class="filter-pill-btn" data-filter="PENDING" onclick="onSelectStatusFilter(this, 'PENDING')">Pending</button>
                    <button type="button" class="filter-pill-btn" data-filter="PARTIAL" onclick="onSelectStatusFilter(this, 'PARTIAL')">Partial</button>
                    <button type="button" class="filter-pill-btn" data-filter="COMPLETED" onclick="onSelectStatusFilter(this, 'COMPLETED')">Complete</button>
                </div>
            </div>

            <!-- Master PO Kendo Grid -->
            <div style="flex: 1 1 auto; overflow: hidden; display: flex; flex-direction: column; min-height: 420px;">
                @(Html.Kendo().Grid<iLgs.Models.ParIcsPOGroupVM>()
                    .Name("gridOrders")
                    .HtmlAttributes(new { style = "height: calc(100vh - 280px); min-height: 420px; border: none;" })
                    .Columns(col =>
                    {
                        col.Bound(c => c.PoNo).Title("Purchase Orders").ClientTemplate(
                            "# var qBal = (typeof QtyBalance !== 'undefined' && QtyBalance !== null) ? QtyBalance : 0; #" +
                            "# var qFin = (typeof QtyFinished !== 'undefined' && QtyFinished !== null) ? QtyFinished : 0; #" +
                            "# var qTot = (typeof Qty !== 'undefined' && Qty !== null) ? Qty : 0; #" +
                            "# var dept = (typeof Department !== 'undefined' && Department) ? Department : 'General Services'; #" +
                            "# var sDate = (typeof SPoDate !== 'undefined' && SPoDate) ? SPoDate : ''; #" +
                            "# var pct = (qTot > 0) ? Math.min(100, Math.round((qFin / qTot) * 100)) : 0; #" +
                            "<div class='ics-po-item' id='po-item-#:Id#' onclick='onSelectPoRowByElement(this)'>" +
                                "<div style='display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 2px;'>" +
                                    "<span class='po-number'>#:PoNo#</span>" +
                                    "# if (qBal == 0 && qTot > 0) { #" +
                                        "<span class='status-badge status-accepted'>Complete</span>" +
                                    "# } else if (qFin > 0) { #" +
                                        "<span class='status-badge status-acceptance-progress'>Partial</span>" +
                                    "# } else { #" +
                                        "<span class='status-badge status-unposted'>Pending</span>" +
                                    "# } #" +
                                "</div>" +
                                "<div class='po-department'>#:dept#</div>" +
                                "<div style='display:flex; justify-content:space-between; align-items:center; font-size:11px; color:rgb(100, 116, 139); margin-top:4px;'>" +
                                    "<span>PAR: <strong>#:qFin#</strong> / #:qTot#</span>" +
                                    "<span>#:sDate#</span>" +
                                "</div>" +
                                "<div style='background:rgb(226, 232, 240); border-radius:3px; height:5px; margin-top:4px; overflow:hidden;'>" +
                                    "<div style='background:rgb(0, 37, 118); height:100%; width:#:pct#%;'></div>" +
                                "</div>" +
                            "</div>"
                        );
                    })
                    .Scrollable()
                    .Sortable()
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("onGridOrdersError").RequestEnd("onGridOrdersRequestEnd"))
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty);
                            model.Field(p => p.PoNo).DefaultValue(string.Empty);
                            model.Field(p => p.PoDate).DefaultValue(null);
                            model.Field(p => p.SPoDate).DefaultValue(string.Empty);
                            model.Field(p => p.Department).DefaultValue(string.Empty);
                            model.Field(p => p.Qty).DefaultValue(0);
                            model.Field(p => p.QtyFinished).DefaultValue(0);
                            model.Field(p => p.QtyBalance).DefaultValue(0);
                        })
                        .Sort(s => s.Add(a => a.PoNo).Descending())
                        .Read(read => read.Action("Read", "ParSet").Data("DataGridOrders"))
                    )
                    .AutoBind(true)
                    .Events(e => e.DataBound("onDataBoundOrdersGrid").Change("onChangeOrdersGrid"))
                )
            </div>
        </div>

        <!-- DETAIL WORKSPACE (RIGHT ~62%) -->
        <div class="ics-detail-pane">

            <!-- Empty State Placeholder -->
            <div id="poEmptyState" class="p-5 text-center" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 400px; padding: 40px; color: rgb(100, 116, 139);">
                <span class="k-icon k-i-file-txt" style="font-size: 54px; color: rgb(203, 213, 225); margin-bottom: 16px;"></span>
                <h3 style="font-size: 18px; font-weight: 700; color: rgb(51, 65, 85); margin-bottom: 6px;">No Purchase Order Selected</h3>
                <p style="font-size: 13px; max-width: 440px; margin: 0 auto; line-height: 1.5;">
                    Please select a Purchase Order from the master list on the left to inspect candidate property records, assign accountable officers, and generate Property Acknowledgment Receipts.
                </p>
            </div>

            <!-- Active Selected PO Content Area -->
            <div id="selectedPoWorkspace" style="display: none; flex-direction: column; height: 100%; overflow: hidden;">

                <!-- SECTION 4: SELECTED PO COMPACT HEADER -->
                <div class="ics-selected-po-card" style="padding: 14px 18px; background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 232, 240);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                                <h2 id="lblDetailPoNo" style="margin: 0; font-size: 20px; font-weight: 700; color: rgb(0, 37, 118); font-family: Consolas, monospace;">PO #</h2>
                                <span id="badgeDetailPoStatus" class="status-badge status-unposted">Pending</span>
                            </div>
                            <div id="lblDetailDept" style="font-size: 13px; font-weight: 600; color: rgb(30, 41, 59);">Department</div>
                            @*<div style="font-size: 12px; color: rgb(100, 116, 139); margin-top: 1px;">
                                Supplier: <strong id="lblDetailSupplier" style="color: rgb(51, 65, 85);">--</strong>
                            </div>*@
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn-procurement-secondary btn-sm" onclick="refreshCurrentPo(true)" title="Refresh current PO">
                                <span class="k-icon k-i-refresh"></span> Refresh PO
                            </button>
                        </div>
                    </div>

                    <!-- Metadata Grid Strip -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 12px; padding-top: 10px; border-top: 1px dashed rgb(226, 232, 240); font-size: 12px;">
                        <div>
                            <span style="color: rgb(100, 116, 139); display: block; font-size: 11px;">PO Date:</span>
                            <strong id="lblDetailPoDate" style="color: rgb(15, 23, 42);">--</strong>
                        </div>
                        <div>
                            <span style="color: rgb(100, 116, 139); display: block; font-size: 11px;">Fund Source:</span>
                            <strong id="lblDetailFund" style="color: rgb(15, 23, 42);">General Fund</strong>
                        </div>
                        @*<div>
                            <span style="color: rgb(100, 116, 139); display: block; font-size: 11px;">Procurement Mode:</span>
                            <strong id="lblDetailMode" style="color: rgb(15, 23, 42);">--</strong>
                        </div>*@
                        <div>
                            <span style="color: rgb(100, 116, 139); display: block; font-size: 11px;">Acquisition Value:</span>
                            <strong id="lblDetailAcqValue" style="color: rgb(0, 37, 118); font-family: Consolas, monospace;">&#8369;0.00</strong>
                        </div>
                        <div>
                            <span style="color: rgb(100, 116, 139); display: block; font-size: 11px;">Accountable Items:</span>
                            <strong id="lblDetailItemStats" style="color: rgb(15, 23, 42);">0 Total / 0 Issued</strong>
                        </div>
                    </div>
                </div>

                <!-- SECTION 5: PAR PROGRESS BAR -->
                <div style="padding: 10px 18px; background: rgb(248, 250, 252); border-bottom: 1px solid rgb(226, 232, 240); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                    <div style="flex: 1 1 320px; max-width: 480px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px;">
                            <span style="font-weight: 600; color: rgb(51, 65, 85);">PAR Processing Progress:</span>
                            <span id="lblProgressRatio" style="font-weight: 700; color: rgb(0, 37, 118);">0 of 0 Processed (0%)</span>
                        </div>
                        <div style="background: rgb(226, 232, 240); height: 10px; border-radius: 5px; overflow: hidden;">
                            <div id="barProgressFill" style="background: rgb(0, 37, 118); height: 100%; width: 0%; transition: width 0.3s ease;"></div>
                        </div>
                        <div style="font-size: 11px; color: rgb(100, 116, 139); margin-top: 3px;" id="lblProgressRemaining">
                            0 Accountable Property Items Remaining
                        </div>
                    </div>
                </div>

                <!-- SECTION 6: CONTEXTUAL DETAIL TABS (3 TABS: INDIVIDUAL ITEMS, ITEM SETS / LOTS, GENERATED SLIPS) -->
                <div style="flex: 1 1 auto; overflow: hidden; display: flex; flex-direction: column;">
                    @(Html.Kendo().TabStrip()
                        .Name("parTabStrip")
                        .HtmlAttributes(new { style = "height: 100%; border: none; display: flex; flex-direction: column;" })
                        .SelectedIndex(0)
                        .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
                        .Items(tabs =>
                        {
                            // TAB 1: INDIVIDUAL ACCOUNTABLE ITEMS
                            tabs.Add().Text("Individual Accountable Items").Selected(true).Content(@<text>
                                <div style="height: 100%; display: flex; flex-direction: column; overflow: hidden;">
                                    <!-- Tab 1 Toolbar -->
                                    <div style="padding: 8px 14px; background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 232, 240); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="font-size: 12px; font-weight: 600; color: rgb(51, 65, 85);">
                                                <span class="k-icon k-i-list-unordered" style="color: rgb(0, 37, 118); margin-right: 4px;"></span> Accountable Property &amp; Equipment
                                            </span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <button type="button" class="btn-procurement-secondary btn-sm" onclick="refreshItemsGrid()" title="Refresh item list">
                                                <span class="k-icon k-i-refresh"></span> Refresh Items
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Tab 1 Grid -->
                                    <div style="flex: 1 1 auto; overflow: hidden; min-height: 350px;">
                                        @(Html.Kendo().Grid<iLgs.Models.ParIcsItemVm>()
                                            .Name("gridItems")
                                            .HtmlAttributes(new { style = "height: calc(100vh - 430px); min-height: 350px; border: none;" })
                                            .Columns(col =>
                                            {
                                                col.Bound(c => c.CardNo).Title("Card Number").Width(100)
                                                    .ClientTemplate(
                                                        "# var cNo = (typeof CardNo !== 'undefined' && CardNo) ? CardNo : ((typeof StockNo !== 'undefined' && StockNo) ? StockNo : ''); #" +
                                                        "# if (cNo) { #" +
                                                            "<span style='font-family: Consolas, monospace; font-weight: bold; color: rgb(0, 37, 118);'>#:cNo#</span>" +
                                                        "# } else { #" +
                                                            "<span class='text-muted' style='font-style: italic;'>-</span>" +
                                                        "# } #"
                                                    );

                                                col.Bound(c => c.Description).Title("Description").Width(150)
                                                    .HtmlAttributes(new { style = "white-space: normal; word-break: break-word;" });

                                                col.Bound(c => c.Qty).Title("Qty").Width(70).Format("{0:n0}")
                                                    .HtmlAttributes(new { style = "text-align: center; font-weight: 600;" });

                                                col.Bound(c => c.Unit).Title("Unit").Width(70)
                                                    .HtmlAttributes(new { style = "text-align: center;" });

                                                col.Bound(c => c.UnitCost).Title("Unit Cost").Width(70).Format("{0:n2}")
                                                    .HtmlAttributes(new { style = "text-align: right; font-family: Consolas, monospace; font-weight: 600;" });

                                                col.Bound(c => c.AddCost).Title("Additional Cost").Width(70).Format("{0:n2}")
                                                    .HtmlAttributes(new { style = "text-align: right; font-family: Consolas, monospace;" });

                                                col.Bound(c => c.GTotalCost).Title("Acq. Cost").Width(70).Format("{0:n2}")
                                                    .HtmlAttributes(new { style = "text-align: right; font-family: Consolas, monospace; font-weight: 700; color: rgb(0, 37, 118);" });
                                            })
                                            .Scrollable()
                                            .Resizable(x => x.Columns(true))
                                            .Sortable()
                                            .Selectable(s => s.Mode(GridSelectionMode.Single))
                                            .ClientDetailTemplateId("itemUnitsTemplate")
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Events(events => events.Error("GridError"))
                                                .Model(model =>
                                                {
                                                    model.Id(p => p.Id);
                                                    model.Field(p => p.Id).DefaultValue(Guid.Empty);
                                                    model.Field(p => p.CardNo).DefaultValue("");
                                                    model.Field(p => p.Description).DefaultValue("");
                                                    model.Field(p => p.Qty).DefaultValue(0);
                                                    model.Field(p => p.UnitCost).DefaultValue(0);
                                                })
                                                .Read(read => read.Action("_PoItemsRead", "ParSet").Data("DataGridItems"))
                                            )
                                            .AutoBind(false)
                                            .Events(e => e.DataBound("onDataBoundItemsGrid").DetailInit("onDetailInitItemUnitsGrid").DetailExpand("onDetailExpandItemGrid"))
                                        )
                                    </div>
                                </div>
                            </text>);

                            // TAB 2: GENERATED SLIPS
                            tabs.Add().Text("Generated Slips").Content(@<text>
                                <div style="height: 100%; display: flex; flex-direction: column; overflow: hidden;">
                                    <div style="padding: 8px 14px; background: rgb(255, 255, 255); border-bottom: 1px solid rgb(226, 232, 240); display: flex; justify-content: space-between; align-items: center;">
                                        <span class="text-muted small">Official Property Acknowledgment Receipts issued for this Purchase Order</span>
                                        <button type="button" class="btn-procurement-secondary btn-sm" onclick="refreshGeneratedSlipsGrid()">
                                            <span class="k-icon k-i-refresh"></span> Refresh Slips
                                        </button>
                                    </div>
                                    <div style="flex: 1 1 auto; overflow: hidden; min-height: 350px;">
                                        @(Html.Kendo().Grid<dynamic>()
                                            .Name("gridGeneratedSlips")
                                            .Resizable(r => r.Columns(true))
                                            .HtmlAttributes(new { style = "height: calc(100vh - 430px); min-height: 350px; border: none;" })
                                            .Columns(col =>
                                            {
                                                col.Bound("RefNo").Title("PAR Number").Width(100)
                                                    .ClientTemplate("<span style='font-family: Consolas, monospace; font-weight: bold; color: rgb(0, 37, 118);'>#:RefNo#</span>");
                                                col.Bound("RefDate").Title("PAR Date").Width(70).ClientTemplate(
                                                    "#= RefDate ? kendo.toString(kendo.parseDate(RefDate), 'MM/dd/yyyy') : '' #"
                                                );
                                                col.Bound("ReceivedBy").Title("Accountable Officer").Width(150)
                                                    .ClientTemplate(
                                                        "# var rBy = (typeof ReceivedBy !== 'undefined' && ReceivedBy) ? ReceivedBy : ''; #" +
                                                        "# var rPos = (typeof ReceivedByPosition !== 'undefined' && ReceivedByPosition) ? ReceivedByPosition : ''; #" +
                                                        "<div><strong>#:rBy#</strong></div>" +
                                                        "<div style='font-size:11px; color:rgb(100, 116, 139);'>#:rPos#</div>"
                                                    );                                                
                                                col.Bound("ReceivedDept").Title("Department").Width(70);
                                                col.Bound("ItemCount").Title("Item Count").Width(50)
                                                    .HtmlAttributes(new { style = "text-align: center; font-weight: 600;" });
                                                col.Bound("TotalValue").Title("Total Value").Width(70).Format("{0:n2}")
                                                    .HtmlAttributes(new { style = "text-align: right; font-family: Consolas, monospace; font-weight: bold;" });
                                                col.Bound("Status").Title("Status").Width(70)
                                                    .ClientTemplate(
                                                        "# var slipSt = (typeof Status !== 'undefined' && Status) ? Status : ''; #" +
                                                        "# if (slipSt == 'Posted') { #" +
                                                            "<span class='status-badge status-accepted'>Posted</span>" +
                                                        "# } else { #" +
                                                            "<span class='status-badge status-unposted'>Draft</span>" +
                                                        "# } #"
                                                    );
                                                col.Bound("HasAir").Title("AIR").Width(100).Sortable(false)
                                                    .ClientTemplate(
                                                        "# var hasAirDoc = (typeof HasAir !== 'undefined' && HasAir); #" +
                                                        "# var isPosted = (typeof Status !== 'undefined' && Status == 'Posted'); #" +
                                                        "# var airName = (typeof AirFileName !== 'undefined' && AirFileName) ? ((AirFileName.length > 37 && AirFileName.charAt(36) === '-') ? AirFileName.substring(37) : AirFileName) : 'Uploaded'; #" +
                                                        "<div class='ics-air-cell'>" +
                                                            "# if (hasAirDoc) { #" +
                                                                "<span class='status-badge status-air-uploaded' style='cursor:pointer;' onclick='viewAirDocument(\"#:Id#\")' title='View: ' + airName>" +
                                                                    "<span class='k-icon k-i-file-pdf'></span> #:airName#" +
                                                                "</span> " +
                                                                "<button type='button' class='btn-procurement-secondary btn-sm text-primary' onclick='viewAirDocument(\"#:Id#\")' title='View Attached AIR Document'>" +
                                                                    "<span class='k-icon k-i-eye'></span> View" +
                                                                "</button>" +
                                                                "# if (!isPosted) { #" +
                                                                    "<button type='button' class='btn-procurement-info btn-sm' onclick='openUploadAirModal(\"#:Id#\", \"#:RefNo#\")' title='Replace Attached AIR Document'>" +
                                                                        "<span class='k-icon k-i-refresh'></span> Replace" +
                                                                    "</button>" +
                                                                "# } #" +
                                                            "# } else { #" +
                                                                "<button type='button' class='btn-procurement-info btn-sm' onclick='openUploadAirModal(\"#:Id#\", \"#:RefNo#\")' title='Upload AIR Document'>" +
                                                                    "<span class='k-icon k-i-upload'></span> Upload AIR" +
                                                                "</button>" +
                                                            "# } #" +
                                                        "</div>"
                                                    );
                                                col.Bound("RefNo").Title("Actions").Width(70).Sortable(false)
                                                    .ClientTemplate("#=generatedSlipActionsTemplate(data)#");
                                            })
                                            .Scrollable()
                                            .Sortable()
                                            .DataSource(dataSource => dataSource
                                                .Ajax()
                                                .Events(events => events.Error("GridError"))
                                                .Read(read => read.Action("_PoGeneratedSlipsRead", "ParSet").Data("DataGridGeneratedSlips"))
                                            )
                                            .AutoBind(false)
                                        )
                                    </div>
                                </div>
                            </text>);
                        })
                    )
                </div>
            </div>
        </div>
    </div>
</div>


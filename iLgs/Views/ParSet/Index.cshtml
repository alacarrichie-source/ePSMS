    function ParItem(recId) {
        var myTitle = "PAR Item - EDIT";
        var width = 800;
        var height = 650;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    close: function () {
                        $("#gridItemsPar").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    },
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_ParItemEdit", "ParSet")',
            data: {
                parItemId: recId
            },
            complete: function () {
                RefreshDivs(); //item info edit not allowed here, use stock card.
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

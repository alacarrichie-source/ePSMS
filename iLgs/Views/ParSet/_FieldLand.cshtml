            @(Html.Kendo().NumericTextBoxFor(m => m.AcqCost).Format("{0:n2}").Decimals(2).Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => m.AcqCost)
        </div>

@(Html.Kendo().Grid<iLgs.Models.IcsParItem>()
    .Name("gridItemsPar")
    .Columns(col =>
    {
        col.Bound(c => c.IcsPar.RefDate).Title("PAR Date").Width(50)
            .ClientTemplate("#= kendo.toString(kendo.parseDate(IcsPar.RefDate), 'MM/dd/yyyy') #");
        col.Bound(c => c.IcsPar.RefNo).Title("PAR No.").Width(50);
        col.Bound(c => c.IcsPar.Location).Width(100);
        col.Bound(c => c.PsCardItemExtn.PropNo).Title("Property No.").Width(100);        
        col.Bound(c => c.IcsPar.PostedBy).Width(50);
        col.Bound(c => c.IcsPar.PostedDt).Width(70);
        col.Command(command =>
        {
            command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditParsItem");
            //if (string.IsNullOrEmpty((string)ViewData["postedBy"]))
            //{
            //    command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridParItems").SendDataKeys(true);
            //}
            command.Custom("Delete").IconClass("k-icon k-i-close").SendDataKeys(true).Click("onClickDeleteGridParItems").Visible("IsNotPosted");
            command.Custom("Print PAR").IconClass("k-icon k-i-print").SendDataKeys(true).Click("onClickBtnPrint");
            command.Custom("Uploads").IconClass("k-icon k-i-upload").Click("onClickUploads").SendDataKeys(true);
            command.Custom("Post").IconClass("k-icon k-i-lock").Click("onClickBtnPostPar").SendDataKeys(true).Visible("IsNotPosted");
            command.Custom("Unpost").IconClass("k-icon k-i-unlock").Click("onClickBtnUnpostPar").SendDataKeys(true).Visible("IsPosted");
            //@(Html.Kendo().Button().Content("Post").Icon("k-icon k-i-lock").Name("btnPostItemSet_").Events(e => e.Click("onClickBtnPostParSet")))
            //@(Html.Kendo().Button().Content("Unpost").Icon("k-icon k-i-unlock").Name("btnUnpostItemSet_").Events(e => e.Click("onClickBtnUnpostParSet")))
        }).Width(200);
    })
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ParsTemplate").Window(w => w.Width(800)))
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Sortable()
        .Resizable(r => r.Columns(true))
        .Navigatable()
        .Scrollable(s => s.Height(250))
        .NoRecords()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("InlineGridError").RequestEnd("onRequestEndGridParItems")
            )
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            })
            .Sort(s => { s.Add(a => a.IcsPar.RefNo); s.Add(a => a.PsCardItemExtn.PropNo); })
            .Read(read => read.Action("_ParsRead", "ParSet", new { cardItemGroupId = ViewData["cardItemGroupId"] }))
            //.Read(read => read.Action("_ParsRead", "ParSet").Data("DataGridItemPar"))
            //.Update(update => update.Action("_ParsUpdate", "ParSet"))
            .Destroy(destroy => destroy.Action("_ParsDestroy", "ParSet"))
        )
        .AutoBind(true)
        .Selectable(s => s.Mode(GridSelectionMode.Single))
    //.ToClientTemplate()
    .Events(e => e
        //.Edit("onEditGridItemsPar")
        .Change("onChangeGridItemsPar")
        .DataBound("onDataBoundGridItemsPar")
    )
)

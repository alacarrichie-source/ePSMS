<script id="StocksDetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("stock_details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("PARS")
                .Selected(true)
                .Content(@<text>
                    @RenderStockDetails()
                </text>);
            @*items.Add()
                .Text("STOCK FIELDS")
                .Content(@<text>
                    @RenderStockExtn()
                </text>);
            items.Add()
                .Text("ISSUANCE")
                .Content(@<text>
                    @RenderIssuance()
                </text>);*@
        })
       .ToClientTemplate()
    )
</script>

@helper RenderStockDetails()
{
    @(Html.Kendo().Grid<iLgs.Models.PropertyItemVM>()
        .Name("gridStockDetails_#=Id#")
        .Columns(columns =>
        {            
            columns.Bound(f => f.RefDate).EditorTemplateName("_RefDateTemplate")
                .Width(50);
            columns.Bound(f => f.RefNo).EditorTemplateName("_RefNoTemplate")
                .Width(50);            
            //columns.Bound(f => f.UnitMeas).EditorTemplateName("_UnitMeasTemplate")
            //    .Width(60);            
            //columns.Bound(f => f.QtyPo).EditorTemplateName("_QtyPoTemplate")
            //    .Width(50)
            //    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            //    .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            //    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Group(group => group.Title("Quantity")
                .Columns(info =>
                {
                    info.Bound(f => f.Qty).EditorTemplateName("_QtyTemplate")
                      .Width(50).Title("Receipt")
                      .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                      .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                      .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyIss).EditorTemplateName("_QtyIssueTemplate")
                        .Width(50).Title("Issue")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyBal).EditorTemplateName("_QtyBalTemplate")
                        .Width(50).Title("Balance")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
            columns.Bound(f => f.Amount).EditorTemplateName("_AmountTemplate")
                .Width(50)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Bound(f => f.Office).EditorTemplateName("_OfficeTemplate")
                .Width(70);
            columns.Bound(f => f.Officer)
                .Width(70);
            columns.Bound(f => f.Remarks).Width(50);
            //columns.Bound(f => f.Days).EditorTemplateName("_DaysTemplate")
            //    .Width(70)
            //    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            //    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Command(commands =>
            {
                commands.Edit();
                commands.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            }).Width(100);
        })
        .ToolBar(t =>
        {
            t.Create();
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PsItemTemplate").Window(w => w.Width(800).Title("Order")))
        //.Events(e =>
        //{
        //    e.DataBound("onOrderDetailsDataBound");
        //    e.DetailInit("onDetailInit");
        //    e.Edit("onOrderDetailsEdit");
        //})
        .Selectable()
        //.Pageable(pageable => pageable.Refresh(true))
        //.Editable()
        .Navigatable()
        .NoRecords()
        //.ClientDetailTemplateId("IssuedItems")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                //model.Field(p => p.RefNo).Editable(true);
                //model.Field(p => p.RefDate).Editable(true);
                //model.Field(p => p.Qty).Editable(true);
                //model.Field(p => p.QtyIss).Editable(true);
                //model.Field(p => p.QtyBal).Editable(true);
                //model.Field(p => p.QtyPo).Editable(true);
            })
            .Aggregates(a =>
            {
                //a.Add(p => p.QtyPo).Sum();
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyIss).Sum();
                a.Add(p => p.QtyBal).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridStockItems"))
            .Read("ItemRead", "Properties", new { psStockId = "#=Id#" })
            .Create("ItemCreate", "Properties")
            .Update("ItemUpdate", "Properties")
            .Destroy("ItemDestroy", "Properties")
        ).Events(e => e.Edit("onEditGridStockItems").Change("onChangeGridStockItems").DataBound("onDataBoundGridStockItems"))
        .ToClientTemplate()
    )
}

@helper RenderStockExtn()
{
    @(Html.Kendo().Grid<iLgs.Models.PsStockExtnVM>()
        .Name("gridStockExtn_#=Id#")
        .Columns(columns =>
        {
            columns.Bound(f => f.ItemCode).Width(50);
            columns.Bound(f => f.ItemKey).Width(70);
            columns.Bound(f => f.ItemValue).Width(200);
        })
        .Selectable()
        .Navigatable()
        .NoRecords()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Sort(s => s.Add(a => a.ItemCode))
            .Events(events => events.Error("GridError"))
            .Read("StockExtnRead", "Stocks", new { stockNo = "#=StockNo#" })
        )
        //.Events(e => e.Edit("onEditGridStockItems").Change("onChangeGridStockItems").DataBound("onDataBoundGridStockItems"))
        .ToClientTemplate()
    )
}

@helper RenderIssuance()
{
    @(Html.Kendo().Grid<iLgs.Models.RisIssuedVM>()
    .Name("gridIssuance_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(70);
        col.Bound(c => c.IssuedDate).Width(50);
        col.Bound(c => c.UnitCost).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Amount).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("error_handler")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        //.Sort(s => s.Add(a => a.Department))
        .Read(read => read.Action("_IssuanceRead", "Stocks", new { stockNo = "#=StockNo#" }))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
}


<div id="item-list" class="col col-xs-3">
    <h3>ITEMS</h3>
    @(Html.Kendo().Grid<iLgs.Models.PsCodeVM>()
    .Name("grid")
    //.HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.PsNo).Width(50);
        col.Bound(c => c.ItemName).Width(150);
    })
    //.ClientRowTemplate("itemTemplate")
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemName, "contains");
        //s.Field(o => o.ItemDescription, "contains");
    })

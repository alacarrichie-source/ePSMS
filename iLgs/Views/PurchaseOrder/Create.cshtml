@Html.Partial("_PrItemBreakdownModal")

@section scripts {
    <script type="text/javascript">
        var currentWizardStep = 1;
        var selectedPrsList = [];

        function goToWizardStep(step) {
            if (step < 1 || step > 5) return;
            if (step > 1 && selectedPrsList.length === 0) {
                alert('Please select at least one approved Purchase Request before proceeding.');
                return;
            }

            currentWizardStep = step;
            $('.wizard-pane').hide();
            $('#wizardStepPane' + step).fadeIn(150);

            // Update Stepper UI Indicators
            for (var i = 1; i <= 5; i++) {
                var circle = $('#circle' + i);
                var label = $('#label' + i);
                var line = $('#line' + i);

                if (i < step) {
                    circle.css({ 'background-color': '#1d4ed8', 'color': '#ffffff', 'box-shadow': 'none' }).html('<i class="fa fa-check"></i>');
                    label.css({ 'color': '#2c3e50', 'font-weight': '600' });
                    if (line.length) line.css('background-color', '#1d4ed8');
                } else if (i === step) {
                    circle.css({ 'background-color': '#2c3e50', 'color': '#ffffff', 'box-shadow': '0 0 0 4px #f1f5f9' }).text(i);
                    label.css({ 'color': '#2c3e50', 'font-weight': '700' });
                } else {
                    circle.css({ 'background-color': '#e2e8f0', 'color': '#64748b', 'box-shadow': 'none' }).text(i);
                    label.css({ 'color': '#64748b', 'font-weight': '500' });
                    if (line.length) line.css('background-color', '#cbd5e1');
                }
            }

            // Update Bottom Buttons
            if (step === 1) {
                $('#btnWizardBack').hide();
                $('#btnWizardCancel').show();
                $('#btnWizardNext').show();
                $('#btnWizardNextText').text('Next: Assign Items');
                $('#btnWizardPost').hide();
                $('#wizardStepSubtitle').text('Step 1 of 5 — Select Approved Purchase Requests (PRs)');
            } else if (step === 2) {
                $('#btnWizardBack').show();
                $('#btnWizardCancel').hide();
                $('#btnWizardNext').show();
                $('#btnWizardNextText').text('Next: Consolidate');
                $('#btnWizardPost').hide();
                $('#wizardStepSubtitle').text('Step 2 of 5 — Assign PR Items into Target PO Groups');
            } else if (step === 3) {
                $('#btnWizardBack').show();
                $('#btnWizardCancel').hide();
                $('#btnWizardNext').show();
                $('#btnWizardNextText').text('Next: PO Details');
                $('#btnWizardPost').hide();
                $('#wizardStepSubtitle').text('Step 3 of 5 — Consolidate Items via Interactive Kendo MVC Grid');
            } else if (step === 4) {
                $('#btnWizardBack').show();
                $('#btnWizardCancel').hide();
                $('#btnWizardNext').show();
                $('#btnWizardNextText').text('Next: Final Review');
                $('#btnWizardPost').hide();
                $('#wizardStepSubtitle').text('Step 4 of 5 — Configure PO Header, Supplier & Specifications');
            } else if (step === 5) {
                $('#btnWizardBack').show();
                $('#btnWizardCancel').hide();
                $('#btnWizardNext').hide();
                $('#btnWizardPost').show();
                $('#wizardStepSubtitle').text('Step 5 of 5 — Final Review & Post Purchase Order');
                updateStep5Summary();
            }
        }

        function onWizardNextClick() {
            alert(currentWizardStep);
            if (currentWizardStep === 1) {
                if (selectedPrsList.length === 0) {
                    alert('Please select at least one approved Purchase Request.');
                    return;
                }

                var grid = $("#PrItemAssignmentGrid").data("kendoGrid");

                if (grid) {
                    grid.dataSource.read();
                }
            }

            goToWizardStep(currentWizardStep + 1);
        }

        function onWizardBackClick() {
            goToWizardStep(currentWizardStep - 1);
        }

        function onDepartmentFilterChange(e) {
            var val = this.value();
            var grid = $("#AvailablePrSelectionGrid").data("kendoGrid");
            if (val) {
                grid.dataSource.filter({ field: "Department", operator: "eq", value: val });
            } else {
                grid.dataSource.filter({});
            }
        }

        function onPrSelectionGridChange(e) {
            var grid = e.sender;
            var selectedRows = grid.select();
            var totalAmount = 0;
            selectedPrsList = [];
            $('#hiddenSelectedPrsInputs').empty();
            $('#selectedPrsListContainer').empty();

            selectedRows.each(function () {
                var dataItem = grid.dataItem(this);
                if (dataItem) {
                    selectedPrsList.push(dataItem);
                    totalAmount += dataItem.TotalAmount;
                    $('#hiddenSelectedPrsInputs').append('<input type="hidden" name="SelectedPrIds" value="' + dataItem.Id + '" />');

                    var cardHtml = '<div style="display: flex; justify-content: space-between; align-items: center; background-color: #f8fafc; padding: 8px; border-radius: 4px; border: 1px solid #e2e8f0; margin-bottom: 6px; font-size: 11.5px;">' +
                        '<div><strong style="color: #002576; font-family: monospace;">' + dataItem.PrNumber + '</strong><div style="font-size: 10.5px; color: #64748b;">' + dataItem.Department + '</div></div>' +
                        '<div style="text-align: right;"><span style="font-family: monospace; font-weight: 700; color: #0f172a;">₱' + kendo.toString(dataItem.TotalAmount, 'n2') + '</span></div>' +
                        '</div>';
                    $('#selectedPrsListContainer').append(cardHtml);
                }
            });

            var count = selectedPrsList.length;
            $('#selectedPrCountBadge').text(count + ' PRs Selected');
            $('#step1SelectedTotalDisplay').text('₱' + kendo.toString(totalAmount, 'n2'));

            if (count === 0) {
                $('#selectedPrsListContainer').html('<div style="font-size: 12px; color: #94a3b8; font-style: italic; text-align: center; padding: 20px 0;">No PRs selected yet.</div>');
            }
        }

        function onPrSelectionGridDataBound(e) {
            var grid = e.sender;
            var total = grid.dataSource.total();
            $('#availablePrCountLabel').text(total + ' Approved PRs Available');

            // Default auto-selection of first 2 records
            var rows = grid.tbody.find("tr");
            if (rows.length >= 2 && selectedPrsList.length === 0) {
                grid.select(rows.slice(0, 2));
            }
        }

        function renderSourcePrs(prs) {
            if (!prs) return '<span class="text-muted small">Manual</span>';
            var items = prs.split(',');
            var html = '';
            for (var i = 0; i < items.length; i++) {
                html += '<span class="source-pr-pill" style="margin-right: 4px;">' + items[i].trim() + '</span>';
            }
            return html;
        }

        function onWizardGridSave(e) {
            if (e.values.Quantity !== undefined || e.values.UnitCost !== undefined) {
                var qty = e.values.Quantity !== undefined ? e.values.Quantity : e.model.Quantity;
                var cost = e.values.UnitCost !== undefined ? e.values.UnitCost : e.model.UnitCost;
                e.model.set("TotalCost", qty * cost);
            }
        }

        function onWizardGridDataBound(e) {
            $('[data-toggle="tooltip"]').tooltip();
        }

        function refreshWizardGrid() {
            var grid = $("#WizardConsolidatedItemsGrid").data("kendoGrid");
            if (grid) grid.dataSource.read();
        }

        function updateStep5Summary() {
            var supplier = $("#Supplier").val() || "Office Warehouse Inc.";
            var prs = selectedPrsList.map(function (p) { return p.PrNumber; }).join(', ') || "PR-2026-001, PR-2026-005";
            var period = $("#DeliveryPeriod").val() || "30 Days";
            var terms = $("#DeliveryTerms").val() || "FOB Destination";

            $("#reviewSupplierDisplay").text(supplier);
            $("#reviewSourcePrsDisplay").text(prs);
            $("#reviewTermsDisplay").text(period + ' / ' + terms);
        }

        function onConfirmAgreementChange(chk) {
            if (chk.checked) {
                $("#btnWizardPost").prop("disabled", false).css("opacity", "1");
            } else {
                $("#btnWizardPost").prop("disabled", true).css("opacity", "0.5");
            }
        }


@* File: ~/Views/PurchaseOrder/Create.cshtml *@
@using Kendo.Mvc.UI
@using Kendo.Mvc.Extensions
@using iLgs.Models
@model iLgs.Models.ConsolidatePrWizardViewModel

@{
    ViewBag.Title = "PO Consolidation Wizard - Create Purchase Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="epsms-procurement">
    @* Breadcrumbs Navigation *@
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a> &gt;
        <a href="@Url.Action("Index", "PurchaseOrder")">Procurement</a> &gt;
        <span>Create Purchase Order (Wizard)</span>
    </div>

    @* Wizard Header Title Bar *@
    <div class="header-actions" style="margin-bottom: 16px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: #2c3e50; margin: 0;">Create Purchase Order</h1>
            <p class="subtitle" style="margin: 2px 0 0 0; color: #64748b; font-size: 12px;">
                <span id="wizardStepSubtitle">Step 1 of 5 &mdash; Standard Government Procurement Workflow</span>
            </p>
        </div>
        <div class="actions-group">
            <a href="@Url.Action("Index", "PurchaseOrder")" class="btn-procurement-secondary">
                <i class="fa fa-times mr-1"></i> Cancel &amp; Exit
            </a>
            <span class="badge" style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; font-family: monospace; font-size: 11px; padding: 6px 10px; border-radius: 4px;">
                <i class="fa fa-save text-success mr-1"></i> Draft Auto-saved
            </span>
        </div>
    </div>

    @* 5-Step Horizontal Stepper Navigation Bar *@
    <div class="data-card" style="margin-bottom: 20px; padding: 14px 20px; background-color: #ffffff; border-radius: 8px; border: 1px solid #cbd5e1;">
        <div class="wizard-stepper" style="display: flex; align-items: center; justify-content: space-between; max-width: 960px; margin: 0 auto;">
            @* Step 1 Tab *@
            <div class="wizard-step-item active" id="stepIndicator1" onclick="goToWizardStep(1)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle1" style="width: 28px; height: 28px; border-radius: 50%; background-color: #2c3e50; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; box-shadow: 0 0 0 4px #f1f5f9;">1</div>
                <span class="step-label" id="label1" style="margin-left: 8px; font-size: 12px; font-weight: 700; color: #2c3e50;">Select PRs</span>
            </div>
            <div class="step-line" id="line1" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            @* Step 2 Tab *@
            <div class="wizard-step-item" id="stepIndicator2" onclick="goToWizardStep(2)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle2" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">2</div>
                <span class="step-label" id="label2" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Assign Items</span>
            </div>
            <div class="step-line" id="line2" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            @* Step 3 Tab (Kendo MVC Grid Consolidation) *@
            <div class="wizard-step-item" id="stepIndicator3" onclick="goToWizardStep(3)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle3" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">3</div>
                <span class="step-label" id="label3" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Consolidate (Kendo)</span>
            </div>
            <div class="step-line" id="line3" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            @* Step 4 Tab *@
            <div class="wizard-step-item" id="stepIndicator4" onclick="goToWizardStep(4)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle4" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">4</div>
                <span class="step-label" id="label4" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">PO Details</span>
            </div>
            <div class="step-line" id="line4" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            @* Step 5 Tab *@
            <div class="wizard-step-item" id="stepIndicator5" onclick="goToWizardStep(5)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle5" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">5</div>
                <span class="step-label" id="label5" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Review &amp; Post</span>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("Create", "PurchaseOrder", FormMethod.Post, new { id = "poConsolidationWizardForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
        <div id="hiddenSelectedPrsInputs"></div>

        @* ====================================================================== *@
        @* STEP 1: SELECT APPROVED PURCHASE REQUESTS                              *@
        @* ====================================================================== *@
        <div id="wizardStepPane1" class="wizard-pane">
            <div style="display: grid; grid-template-columns: 1fr 300px; gap: 16px; align-items: start;">
                <div>
                    @* Filter Bar *@
                    <div style="display: flex; justify-content: space-between; align-items: center; background-color: #ffffff; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 6px; margin-bottom: 12px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <label style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #475569; margin: 0;">Department Filter:</label>
                            @(Html.Kendo().DropDownList()
                                .Name("DepartmentFilterDropdown")
                                .DataTextField("Text")
                                .DataValueField("Value")
                                .BindTo(new List<SelectListItem>() {
                                    new SelectListItem() { Text = "All Departments", Value = "" },
                                    new SelectListItem() { Text = "Information Technology", Value = "Information Technology" },
                                    new SelectListItem() { Text = "Administrative Services", Value = "Administrative Services" },
                                    new SelectListItem() { Text = "Finance & Management", Value = "Finance & Management" },
                                    new SelectListItem() { Text = "Operations & Logistics", Value = "Operations & Logistics" }
                                })
                                .Events(e => e.Change("onDepartmentFilterChange"))
                                .HtmlAttributes(new { style = "width: 220px;" })
                            )
                        </div>
                        <div style="font-size: 12px; color: #64748b; font-family: monospace;" id="availablePrCountLabel">
                            Loading Approved PRs...
                        </div>
                    </div>

                    @* Kendo MVC Selection Grid *@
                    <div class="po-grid-card">
                        <div class="card-title-bar">
                            <h3><i class="fa fa-check-square-o text-primary mr-1"></i> Approved Purchase Requests for Consolidation</h3>
                            <span style="font-size: 11px; color: #64748b;">Click rows or checkboxes to select for bundling</span>
                        </div>

                        @(Html.Kendo().Grid<iLgs.Models.PurchaseRequestSelectionViewModel>()
                            .Name("AvailablePrSelectionGrid")
                            .Columns(columns =>
                            {
                                columns.Select().Width(45).HeaderHtmlAttributes(new { @class = "text-center" }).HtmlAttributes(new { @class = "text-center" });

                                columns.Bound(p => p.PrNumber)
                                    .Title("PR Number")
                                    .Width(135)
                                    .ClientTemplate("<span style='font-family: monospace; font-weight: 700; color: \\#002576;'>#= PrNumber #</span>")
                                    .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                                columns.Bound(p => p.PrDate)
                                    .Title("PR Date")
                                    .Format("{0:MMM dd, yyyy}")
                                    .Width(110)
                                    .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                                columns.Bound(p => p.Department)
                                    .Title("Department / Unit")
                                    .Width(175)
                                    .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                                columns.Bound(p => p.Purpose)
                                    .Title("Procurement Purpose")
                                    .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                                columns.Bound(p => p.ItemCount)
                                    .Title("Items")
                                    .Width(70)
                                    .HtmlAttributes(new { @class = "text-center font-monospace" })
                                    .HeaderHtmlAttributes(new { @class = "text-center font-weight-bold" });

                                columns.Bound(p => p.TotalAmount)
                                    .Title("Total Amount (PHP)")
                                    .Format("{0:N2}")
                                    .Width(140)
                                    .HtmlAttributes(new { @class = "text-right font-monospace font-weight-bold text-primary" })
                                    .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" })
                                    .ClientFooterTemplate("<div class='text-right font-monospace font-weight-bold'>Total: ₱#= kendo.toString(sum, 'n2') #</div>");

                                columns.Bound(p => p.Id)
                                    .Title("")
                                    .Width(80)
                                    .Filterable(false)
                                    .Sortable(false)
                                    .ClientTemplate(
                                        "<button type='button' " +
                                        "class='btn btn-xs btn-outline-secondary' " +
                                        "onclick='openPrItemBreakdownModal(\"#= Id #\", \"#= PrNumber #\")' " +
                                        "title='View PR Line Items'>" +
                                        "<i class='fa fa-eye'></i> Items" +
                                        "</button>"
                                    )
                                    .HtmlAttributes(new { @class = "text-center" });
                            })
                            .Pageable(p => p.Refresh(true).PageSizes(new[] { 5, 10, 20 }))
                            .Sortable()
                            .Filterable()
                            .NoRecords()
                            .Selectable(selectable => selectable
                                .Mode(GridSelectionMode.Multiple)
                                .Type(GridSelectionType.Row)
                            )
                            .Events(events => events
                                .Change("onPrSelectionGridChange")
                                .DataBound("onPrSelectionGridDataBound")
                            )
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .ServerOperation(false)
                                .Model(m => m.Id(p => p.Id))
                                .Aggregates(a => a.Add(p => p.TotalAmount).Sum())
                                .Read(r => r.Action("ReadApprovedPurchaseRequests", "PurchaseOrder"))
                            )
                        )
                    </div>
                </div>

                @* Step 1 Right Side Summary Card *@
                <div class="summary-card" style="margin-top: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-bottom: 12px;">
                        <h3 style="font-size: 13px; font-weight: 700; color: #2c3e50; text-transform: uppercase; margin: 0;">Selected PRs</h3>
                        <span id="selectedPrCountBadge" class="badge" style="background-color: #dbeafe; color: #1e40af; font-family: monospace; font-size: 11px;">0 Selected</span>
                    </div>

                    <div id="selectedPrsListContainer" style="max-height: 240px; overflow-y: auto; margin-bottom: 12px;">
                        <div style="font-size: 12px; color: #94a3b8; font-style: italic; text-align: center; padding: 20px 0;">
                            No PRs selected yet.
                        </div>
                    </div>

                    <div class="total" style="border-top: 1px solid #e2e8f0; padding-top: 10px;">
                        <span style="font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600;">Selected PR Total:</span>
                        <strong id="step1SelectedTotalDisplay" style="color: #2c3e50; font-family: monospace; font-size: 16px;">₱0.00</strong>
                    </div>

                    <div style="font-size: 11px; color: #64748b; margin-top: 8px; line-height: 1.4;">
                        <i class="fa fa-info-circle text-primary"></i> Identical Catalog Codes across selected PRs will be combined automatically in Step 3.
                    </div>
                </div>
            </div>
        </div>

        @* ====================================================================== *@
        @* STEP 2: ASSIGN PURCHASE REQUEST ITEMS TO PO GROUPS                     *@
        @* ====================================================================== *@
        <div id="wizardStepPane2" class="wizard-pane" style="display: none;">
            <div class="po-grid-card">
                <div class="card-title-bar">
                    <div>
                        <h3><i class="fa fa-tasks text-primary mr-1"></i> Assign Purchase Request Items</h3>
                        <p style="font-size: 12px; color: #64748b; margin: 2px 0 0 0;">Allocate requested quantities from selected department PRs into target Purchase Order Groups.</p>
                    </div>
                    <div>
                        @(Html.Kendo().DropDownList()
                            .Name("BulkGroupAssignDropdown")
                            .BindTo(new[] { "PO Group 1 (Main Award)", "Create New PO Group" })
                            .HtmlAttributes(new { style = "width: 220px;" })
                        )
                    </div>
                </div>

                @(Html.Kendo().Grid<iLgs.Models.PrItemAssignmentViewModel>()
                    .Name("PrItemAssignmentGrid")
                    .Columns(columns =>
                    {
                        columns.Bound(p => p.PrNumber)
                            .Title("PR No.")
                            .Width(130)
                            .ClientTemplate("<span style='font-family: monospace; font-weight: 700; color: \\#002576;'>#= PrNumber #</span>")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Bound(p => p.CatalogCode)
                            .Title("Catalog Code")
                            .Width(130)
                            .ClientTemplate("<span style='font-family: monospace;'>#= CatalogCode #</span>")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Bound(p => p.Description)
                            .Title("Description & Technical Specs")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Bound(p => p.Unit)
                            .Title("Unit")
                            .Width(80)
                            .HtmlAttributes(new { @class = "text-center" })
                            .HeaderHtmlAttributes(new { @class = "text-center font-weight-bold" });

                        columns.Bound(p => p.RequestedQty)
                            .Title("Req. Qty")
                            .Width(95)
                            .HtmlAttributes(new { @class = "text-right font-monospace" })
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" });

                        columns.Bound(p => p.AssignedQty)
                            .Title("Assign Qty")
                            .Width(110)
                            .ClientTemplate(
                                "<input type='number' " +
                                "min='1' " +
                                "max='#= RequestedQty #' " +
                                "value='#= AssignedQty #' " +
                                "class='k-textbox' " +
                                "style='width:100%; text-align:right; font-family:monospace; font-weight:700;' " +
                                "onchange='onAssignQtyChange(this, \"#= Id #\")' />"
                            )
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" });

                        columns.Bound(p => p.RemainingQty)
                            .Title("Remaining")
                            .Width(95)
                            .ClientTemplate("<span class='font-monospace font-weight-bold text-warning'>#= RemainingQty #</span>")
                            .HtmlAttributes(new { @class = "text-right" })
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" });

                        columns.Bound(p => p.PoGroup)
                            .Title("Target PO Group")
                            .Width(180)
                            .ClientTemplate("<span class='source-pr-pill'>#= PoGroup #</span>")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });
                    })
                    .Sortable()
                    .Filterable()
                    .Scrollable(s => s.Height("auto"))
                    .DataSource(ds => ds
                        .Ajax()
                        .ServerOperation(false)
                        .Model(m => m.Id(p => p.Id))
                        .Read(r => r.Action("ReadAssignablePrItems", "PurchaseOrder").Data("getSelectedPrIds"))
                    )
                )
            </div>
        </div>

        @* ====================================================================== *@
        @* STEP 3: CONSOLIDATE & REVIEW (INTERACTIVE KENDO MVC GRID)              *@
        @* ====================================================================== *@
        <div id="wizardStepPane3" class="wizard-pane" style="display: none;">
            @* PO Group Tab Pills *@
            <div style="display: flex; gap: 4px; margin-bottom: 12px; border-bottom: 2px solid #cbd5e1; padding-bottom: 0;">
                <button type="button" class="btn btn-sm" style="background-color: #ffffff; border: 1px solid #cbd5e1; border-bottom: 2px solid #2c3e50; font-weight: 700; color: #2c3e50; border-radius: 4px 4px 0 0; padding: 8px 16px;">
                    <i class="fa fa-folder-open text-primary mr-1"></i> PO Group 1 (Main Consolidated Award)
                </button>
                <button type="button" class="btn btn-sm" style="background-color: transparent; border: none; font-weight: 600; color: #64748b; padding: 8px 16px;">
                    <i class="fa fa-plus-circle mr-1"></i> Add PO Group
                </button>
            </div>

            <div class="po-grid-card">
                <div class="card-title-bar">
                    <div>
                        <h3 style="color: #002576; font-weight: 700; margin: 0;">
                            <i class="fa fa-cubes text-primary mr-1"></i> Consolidated Line Items Editor (InLine Mode)
                        </h3>
                        <div style="font-size: 12px; color: #64748b; margin-top: 2px;">
                            Auto-consolidated across selected PRs &bull; Quantities aggregated by <strong>Catalog Code</strong>
                        </div>
                    </div>
                    <div style="font-size: 12px; color: #5f6470;">
                        Telerik Kendo UI for ASP.NET MVC 5 (EF6)
                    </div>
                </div>

                @(Html.Kendo().Grid<iLgs.Models.PurchaseOrderItemViewModel>()
                    .Name("WizardConsolidatedItemsGrid")
                    .Columns(columns =>
                    {
                        columns.Bound(p => p.ItemNo)
                            .Title("No.")
                            .Width(60)
                            .HtmlAttributes(new { @class = "text-center font-monospace" })
                            .HeaderHtmlAttributes(new { @class = "text-center font-weight-bold" });

                        columns.Bound(p => p.CatalogCode)
                            .Title("Catalog Code")
                            .Width(130)
                            .EditorTemplateName("CatalogItemEditor")
                            .ClientTemplate("<span style='font-family: monospace; font-weight: 700; color: \\#002576;'>#= CatalogCode #</span>")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Bound(p => p.Description)
                            .Title("Description & Technical Specifications")
                            .Width(280)
                            .ClientTemplate("<div><strong>#= Description #</strong># if (TechnicalSpecs) { #<div style='font-size: 11px; color: \\#5f6470;'>#= TechnicalSpecs #</div># } #</div>")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Bound(p => p.Unit)
                            .Title("Unit")
                            .Width(90)
                            .EditorTemplateName("UnitDropdownEditor")
                            .HtmlAttributes(new { @class = "text-center" })
                            .HeaderHtmlAttributes(new { @class = "text-center font-weight-bold" });

                        columns.Bound(p => p.Quantity)
                            .Title("Quantity")
                            .Width(100)
                            .HtmlAttributes(new { @class = "text-right font-monospace font-weight-bold" })
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" })
                            .ClientFooterTemplate("<div class='text-right font-monospace font-weight-bold'>Total: #= sum #</div>");

                        columns.Bound(p => p.UnitCost)
                            .Title("Unit Cost (PHP)")
                            .Width(135)
                            .Format("{0:N2}")
                            .EditorTemplateName("CurrencyNumericTextBox")
                            .HtmlAttributes(new { @class = "text-right font-monospace" })
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" });

                        columns.Bound(p => p.TotalCost)
                            .Title("Total Cost (PHP)")
                            .Width(150)
                            .Format("{0:N2}")
                            .HtmlAttributes(new { @class = "text-right font-monospace font-weight-bold text-primary" })
                            .HeaderHtmlAttributes(new { @class = "text-right font-weight-bold" })
                            .ClientFooterTemplate(
                                "<div class='text-right font-monospace font-weight-bold' " +
                                "style='color:\\#002576; font-size:14px;'>" +
                                "₱#= kendo.toString(sum, 'n2') #" +
                                "</div>"
                            );

                        columns.Bound(p => p.SourcePrs)
                            .Title("Source PR(s)")
                            .Width(140)
                            .ClientTemplate("#= renderSourcePrs(SourcePrs) #")
                            .HeaderHtmlAttributes(new { @class = "font-weight-bold" });

                        columns.Command(command =>
                        {
                            command.Edit().Text(" ").UpdateText("Save").CancelText("Cancel");
                            command.Destroy().Text(" ");
                        })
                        .Title("Actions")
                        .Width(100)
                        .HtmlAttributes(new { @class = "text-center" })
                        .HeaderHtmlAttributes(new { @class = "text-center font-weight-bold" });
                    })
                    .ToolBar(toolbar =>
                    {
                        toolbar.Create().Text("Add Line Item");
                        toolbar.Custom().Text("Refresh").HtmlAttributes(new { onclick = "refreshWizardGrid()", href = "javascript:void(0)" });
                        toolbar.Excel();
                        toolbar.Pdf();
                        toolbar.Search();
                    })
                    .Editable(editable => editable.Mode(GridEditMode.InLine))
                    .Pageable(pageable => pageable
                        .Refresh(true)
                        .PageSizes(new[] { 10, 25, 50 })
                        .ButtonCount(5)
                    )
                    .Sortable(sortable => sortable
                    .AllowUnsort(true)
                    .SortMode(GridSortMode.MultipleColumn)
                )
                    .Filterable()
                    .Scrollable(s => s.Height("auto"))
                    .Events(events => events
                        .Save("onWizardGridSave")
                        .DataBound("onWizardGridDataBound")
                    )
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.ItemNo).Editable(false);
                            model.Field(p => p.TotalCost).Editable(false);
                            model.Field(p => p.SourcePrs).Editable(false);
                            model.Field(p => p.Quantity).DefaultValue(1);
                            model.Field(p => p.UnitCost).DefaultValue(0.00m);
                            model.Field(p => p.Unit).DefaultValue("Piece");
                        })
                        .Aggregates(aggregates =>
                        {
                            aggregates.Add(p => p.Quantity).Sum();
                            aggregates.Add(p => p.TotalCost).Sum();
                        })
                        .Read(read => read.Action("ReadConsolidatedItems", "PurchaseOrder").Data("getCurrentPoId"))
                        .Create(create => create.Action("CreateConsolidatedItem", "PurchaseOrder"))
                        .Update(update => update.Action("UpdateConsolidatedItem", "PurchaseOrder"))
                        .Destroy(destroy => destroy.Action("DeleteConsolidatedItem", "PurchaseOrder"))
                    )
                )
            </div>
        </div>

        @* ====================================================================== *@
        @* STEP 4: PO DETAILS & TECHNICAL SPECIFICATIONS                         *@
        @* ====================================================================== *@
        <div id="wizardStepPane4" class="wizard-pane" style="display: none;">
            <div style="display: grid; grid-template-columns: 380px 1fr; gap: 16px; align-items: start;">
                @* PO Header Details Form Card *@
                <div class="form-card" style="padding: 16px;">
                    <h3 style="font-size: 13px; font-weight: 700; color: #2c3e50; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px; margin-top: 0; margin-bottom: 14px;">
                        <i class="fa fa-building text-primary mr-1"></i> Purchase Order Terms
                    </h3>

                    <div class="form-grid" style="display: flex; flex-col; gap: 10px;">
                        <div>
                            @Html.LabelFor(m => m.PoNumber, new { style = "font-size: 11px; font-weight: 700; text-transform: uppercase; color: #475569;" })
                            @Html.TextBoxFor(m => m.PoNumber, new { @class = "k-textbox", @readonly = "readonly", style = "width: 100%; background-color: #f1f5f9; font-family: monospace; font-weight: bold;" })
                        </div>

                        <div>
                            @Html.LabelFor(m => m.PoDate, new { style = "font-size: 11px; font-weight: 700; text-transform: uppercase; color: #475569;" })
                            @(Html.Kendo().DatePickerFor(m => m.PoDate)

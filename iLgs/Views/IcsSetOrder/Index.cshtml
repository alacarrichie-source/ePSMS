    let isProgrammaticSelection = false;
    function onChangeGridItemExtns(e) {
        if (isProgrammaticSelection) return;
        var grid = $("#gridSelections").data("kendoGrid");
        var selectedRows = grid.select();

        selectedRows.each(function () {
            var dataItem = grid.dataItem(this);
            var setLotNo = dataItem.SetLotNo;
            var setLotQtyNo = dataItem.SetLotQtyNo;
            var contentNo = dataItem.ContentNo;

            isProgrammaticSelection = true;
            // Select all rows matching the same GroupNo
            grid.items().each(function () {
                var item = grid.dataItem(this);
                if (item.SetLotNo == setLotNo && item.SetLotQtyNo == setLotQtyNo) {
                    grid.select(this); // Select row programmatically
                }
            });

            isProgrammaticSelection = false;
        });
    }

    function onDataBoundGridItemExtns(e) {
        var grid = $("#gridSelections").data("kendoGrid");

        // Handle clicks on the checkbox column
        grid.table.on("click", "tr.k-state-selected td.k-checkbox-cell", function (e) {
            var row = $(e.target).closest("tr");
            var dataItem = grid.dataItem(row);
            var groupNo = dataItem.GroupNo;

            if (!row.hasClass("k-state-selected")) {
                // Select rows with matching GroupNo
                grid.items().each(function () {
                    var item = grid.dataItem(this);
                    if (item.GroupNo === groupNo) {
                        grid.select(this);
                    }
                });
            } else {
                // Deselect matching rows if unselected
                grid.items().each(function () {
                    var item = grid.dataItem(this);
                    if (item.GroupNo === groupNo) {
                        grid.clearSelection($(this));
                    }
                });
            }
        });
    }


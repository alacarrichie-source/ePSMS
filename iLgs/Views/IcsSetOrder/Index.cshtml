<script type="text/javascript">
    function getTotalCostSumExcludingSet() {
        var grid = $("#gridItems").data("kendoGrid");
        var data = grid.dataSource.view();

        var total = 0;

        for (var i = 0; i < data.length; i++) {
            if (data[i].ItemNo && !data[i].ItemNo.includes(".")) {
                total += data[i].TotalCost || 0;
            }
        }

        return total;
    }

    // for set/lot or !set/lot members only
    function IsNotSet(dataItem) {
        return (dataItem.IsSetLot || !data.UnitGroupId);
    }

    function onChangeForYear(e) {
        refreshAllGrids();
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function onSelectPoNo(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PoDate").data("kendoDatePicker").value(dataItem.PoDate);
        $("#AirDate").data("kendoDatePicker").value(dataItem.AirDate);

        $("#AirNo").val(dataItem.AirNo).trigger("change");
        $("#DeptId").val(dataItem.DeptId).trigger("change");
        $("#Department").val(dataItem.Department).trigger("change");

        $("#PoDate").data("kendoDatePicker").trigger("change");
        $("#AirDate").data("kendoDatePicker").trigger("change");

        $("#gridItems").data("kendoGrid").dataSource.read({ poNo: dataItem.PoNo, poDate: dataItem.PoDate });
        //$("#gridItemSet").data("kendoGrid").dataSource.read({ poNo: dataItem.PoNo, poDate: dataItem.PoDate });
    }


    function onTileResize(e) {
        if (e.container) {

            // for widgets that do not auto resize
            // https://docs.telerik.com/kendo-ui/styles-and-layout/using-kendo-in-responsive-web-pages
            kendo.resize(e.container, true);
        }
    }

    $(window).on("resize", function () {
        kendo.resize($(".k-chart, .k-grid"));
    });

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
            //var subGridName = $(e.sender).closest(".k-grid").attr("id");
            //$("#" + subGridName).data("kendoGrid").dataSource.read();
        }
    }
    //$(window).on("resize", function () {
    //    var gridElement = $("#grid"),
    //        dataArea = gridElement.find(".k-grid-content"),
    //        gridHeight = gridElement.innerHeight(),
    //        otherElements = gridElement.children().not(".k-grid-content"),
    //        otherElementsHeight = 0;
    //        otherElements.each(function () {
    //            otherElementsHeight += $(this).outerHeight();
    //        });
    //    dataArea.height(gridHeight i- otherElementsHeight);
    //});

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');

                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");

                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    //var selectedCardItemId = null;
    //var selectedGrid = null;
    //var selectedId = null;
    //var selectedItemId = null;
    //var selectedUnitCost = null;
    //var selectedDepartment = null;
    var selectedCardItemId = null;
    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var selectedDepartment = null;

    var selectedPoNo = null;
    var selectedPoDate = null;
    var selectedDeptId = null;
    var postedBy = null;

   function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());

        selectedId = selectedData.Id;
        selectedItemId = null;
        selectedItemSetId = null;
        selectedDepartment = selectedData.Department;

        selectedPoNo = selectedData.PoNo;
        selectedPoDate = selectedData.PoDate;
        selectedDeptId = selectedData.DeptId;

        $("#gridItems").data("kendoGrid").dataSource.read({ poNo: selectedPoNo, poDate: selectedPoDate });
        //$("#gridItemSet").data("kendoGrid").dataSource.read({ poNo: selectedPoNo, poDate: selectedPoDate });

        //if (selectedData.IsWithPar == true) {
        //    $(".k-grid-btnAddPars", grid).show();
        //} else {
        //    $(".k-grid-btnAddPars", grid).hide();
        //}

        //if (selectedData.IsWithIcs == true) {
        //    $(".k-grid-btnAddIcs", grid).show();
        //} else {
        //    $(".k-grid-btnAddIcs", grid).hide();
        //}

        //alert(selectedData.QtyBalance);
        if (selectedData.QtyBalance == 0) {
            $(".k-grid-btnBatchGenerate").hide();
        }
        else {
            $(".k-grid-btnBatchGenerate").show();
        }
    }

    function DataGrid(e) {
        return {
            forYear: $("#forYear").val()
        };
    }

    function refreshAllGrids() {
        $("#grid").data("kendoGrid").dataSource.read();
        refreshGridItems();
    }

    function refreshGridItems() {
        $("#gridItems").data("kendoGrid").dataSource.read();
        //$("#gridItemSet").data("kendoGrid").dataSource.read();
    }

    function onDataBoundGrid(e) {
        var selectedRow = selectRowByConditions("grid", {
            PoNo: selectedPoNo, poDate: selectedPoDate
        });

        if (!selectedRow) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }

        var grid = this;
        var items = grid.items(); // Get all the rows (tr elements) in the grid
        items.each(function (index, row) {
            var dataItem = grid.dataItem(row); // Get the corresponding data item for each row
            if (dataItem.QtyBalance === 0) {
                $(row).addClass("disabled-row"); // Add a custom class to disabled rows
                //$(row).find("input").attr("disabled", "disabled"); // Disable input elements
                //$(row).find("a.k-button").removeClass("k-button").addClass("k-disabled"); // Disable buttons
            }
        });
    }

    function formatDate(date) {
        if (date == null) return null;
        var month = (date.getMonth() + 1).toString().padStart(2, '0'); // Months are zero-based, so add 1
        var day = date.getDate().toString().padStart(2, '0');
        var year = date.getFullYear();

        return month + '/' + day + '/' + year;
    }

    function onRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
        }
    }

    function resizeWindow() {
        var mywindow = $("#window-par-item").data("kendoWindow");
        if (mywindow) {

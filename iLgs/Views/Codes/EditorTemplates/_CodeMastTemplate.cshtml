@model iLgs.Models.CodeMast

<div class="modal-body">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)
        @Html.HiddenFor(m => m.Id)

        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Code)
                    .Label(l => l.Content("Code").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Code)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Description)
                    .Label(l => l.Content("Description").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Description)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.CodeHdg)
                    .Label(l => l.Content("Code Hdg").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.CodeHdg)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Desc1Hdg)
                    .Label(l => l.Content("Desc1 Hdg").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Desc1Hdg)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Desc2Hdg)
                    .Label(l => l.Content("Desc2 Hdg").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Desc2Hdg)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Desc3Hdg)
                    .Label(l => l.Content("Desc3 Hdg").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Desc3Hdg)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Desc4Hdg)
                    .Label(l => l.Content("Desc4 Hdg").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Desc4Hdg)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Desc5Hdg)
                    .Label(l => l.Content("For Group").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Desc5Hdg)
            </div>
        </div>

    }
</div>


@model iLgs.Models.DepartmentUserVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.DeptId)
    @Html.HiddenFor(model => model.UserId)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>
    
    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.UserName, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.UserName)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select User")
                            .DataTextField("UserName")
                            .DataValueField("UserName")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetDeptUserList", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("UserName").Title("User Name").Width("20%");
                                c.Add().Field("Email").Title("Email").Width("20%");
                                c.Add().Field("NameFull").Title("Full Name").Width("60%");
                            })
                            .Events(e => e.Select("onSelectUserName"))
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.UserName)
                </div>
            </div>
        </div>
        
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Email).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Email)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.NameFull, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.NameFull).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.NameFull)
                </div>
            </div>
        </div>
        
    </fieldset>
}






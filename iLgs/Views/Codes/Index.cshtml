@{
    ViewBag.Title = "Codes";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.CodeMast>()
        .Name("grid")
        .HtmlAttributes(new { @class = "max-grid" })
        .Columns(col =>
        {
            col.Bound(c => c.Code).Width(70);
            col.Bound(c => c.Description).Width(100);
            col.Bound(c => c.CodeHdg).Width(70);
            col.Bound(c => c.Desc1Hdg).Width(70);
            col.Bound(c => c.Desc2Hdg).Width(70);
            col.Bound(c => c.Desc3Hdg).Width(70);
            col.Bound(c => c.Desc4Hdg).Width(70);
            col.Bound(c => c.Desc5Hdg).Width(70);
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(120);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add Code");
            t.Search();
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CodeMastTemplate").Window(w => w.Width(800).Title("Codes")))
        //.Editable(editable => editable.Mode(GridEditMode.InLine))
        .Search(s =>
        {
            s.Field(o => o.Code, "contains");
            s.Field(o => o.Description, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(200))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Read(read => read.Action("CodeMastRead", "Codes"))
            .Create(create => create.Action("CodeMastCreate", "Codes"))
            .Update(update => update.Action("CodeMastUpdate", "Codes"))
            .Destroy(destroy => destroy.Action("CodeMastDestroy", "Codes"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
            )
)

<div id="windowcontainer"></div>


<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            .HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add()
                    .Selected(true)
                    .LoadContentFrom("_Codextn", "Codes", new { mastId = "#=Id#" });
            }).ToClientTemplate())
</script>


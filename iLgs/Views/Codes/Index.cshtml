    function onEditGridItems(e) {
        e.preventDefault();
        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        parentGrid.select(parentRow);
       
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;

            e.model.set("MastId", selectedId);
            $("#MastId").val(selectedId).trigger("change");
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));        
        }
    }

    function onClickBtnDeleteItem(e) {
        e.preventDefault();
        
        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        parentGrid.select(parentRow);

        var parentGridDataItem = parentGrid.dataItem(parentRow);
        selectedId = parentGridDataItem.Id;
        
        selectedGrid = this;
        itemTr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(itemTr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () {
            selectedGrid.removeRow(itemTr);
        }, 200);        
    }

    // Add this script to your page or view
    $(document).on("click", ".k-pager-refresh", function (e) {
        // Find the main grid (parent grid)
        var parentGrid = $(this).closest(".k-grid").prev().data("kendoGrid");

        // Find the row for the main grid
        var parentRow = parentGrid.select().closest("tr");

        // Select the row in the main grid
        parentGrid.select(parentRow);
    });                 
    
</script>



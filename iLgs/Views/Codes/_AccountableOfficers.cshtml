@(Html.Kendo().Grid<iLgs.Models.AccountableOfficerVM>()
    .Name("gridOfficers_" + @ViewData["DeptId"])
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(o => o.Name).Width(70);
        columns.Bound(o => o.Designation).Width(100);
        columns.Bound(o => o.DateAssumption).Width(70).EditorTemplateName("_DateAssumptionTemplate");
        columns.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Name, "contains");
        s.Field(o => o.Designation, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    //.Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .Editable()
    //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_DepartmentUserTemplate").Window(w => w.Width(500).Title("Users")))
    //.Editable(e => e.Mode(GridEditMode.InLine))
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.DeptId).DefaultValue(@ViewData["DeptId"]);
        })
        .Read(read => read.Action("_AccountableOfficerRead", "Codes", new { deptId = @ViewData["DeptId"] }))
        .Create(create => create.Action("_AccountableOfficerCreate", "Codes"))
        .Update(update => update.Action("_AccountableOfficerUpdate", "Codes"))
        .Destroy(destroy => destroy.Action("_AccountableOfficerDestroy", "Codes"))
    )
    .Events(events => events
        .Change("onChangeGridOfficers")
        .Edit("onEditGridOfficers")
        .DataBound("onDataBoundGridOfficers")
    )
    .AutoBind(true)
)

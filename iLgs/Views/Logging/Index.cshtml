@(Html.Kendo().Grid<iLgs.Models.ErrorLog>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.ErrorCode).Width(50);
        col.Bound(c => c.ErrorSource).Width(70);
        col.Bound(c => c.Description).ClientTemplate("#= kendo.htmlEncode(Description).replace(/\\n/g, '<br />') #").Width(200);
        col.Bound(c => c.InsertedBy).Width(50);
        col.Bound(c => c.InsertedDt).Width(70);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.ErrorCode, "contains");
        s.Field(o => o.ErrorSource, "contains");
        s.Field(o => o.Description, "contains");
        s.Field(o => o.InsertedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        //.Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("Read", "Logging"))
    )
)

<style>
    .log-description {
        white-space: pre-wrap;
        max-height: 200px;
        overflow-y: auto;
        word-wrap: break-word;
    }

    table {
        font-size: 0.95rem;
    }
</style>

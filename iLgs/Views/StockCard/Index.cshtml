    function StockCard(mode, recId) {
        var myTitle = (mode == "A") ? "Stock Card - ADD" : "Stock Card - EDIT";
        var width = 1000;
        var height = 650;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    close: function () {
                        $("#grid").data("kendoGrid").dataSource.read();
                        var duplicate = $("#IsDuplicateStockNo").val();
                        
                        if (duplicate == "true") {
                            var psNo = $("#PsNo").val();
                            var fund = $("#Fund").val();
                            var grid = $("#grid").data("kendoGrid");
                            
                            grid.dataSource.filter({
                                logic: "and",
                                filters: [
                                    {
                                        field: "PsNo",
                                        operator: "eq",
                                        value: psNo
                                    },
                                    {
                                        field: "Fund",
                                        operator: "eq",
                                        value: fund
                                    }
                                ]
                            });

                            // Wait for filtering to complete
                            grid.dataSource.read().then(function () {
                                // Find the first visible row in the filtered data
                                var masterRow = grid.tbody.find("> tr:not(.k-detail-row)").first();

                                if (masterRow.length) {
                                    // Select the row
                                    grid.select(masterRow);
                                    // Get the DataItem from the selected row
                                    var selectedDataItem = grid.dataItem(masterRow);

                                    // Access the `Id` field or other data
                                    if (selectedDataItem) {
                                        selectedId = selectedDataItem.Id;
                                    }

                                    // Expand subgrid
                                    grid.expandRow(masterRow);

                                    //// Wait for subgrid rendering and trigger add row
                                    setTimeout(function () {
                                        //var subgrid = masterRow.next(".k-detail-row").find(".k-grid").data("kendoGrid");
                                        var subGrid = $("#gridItems_" + selectedId).data("kendoGrid");
                                        if (subGrid) {
                                            subGrid.addRow(); // Trigger the "Add" action
                                        }
                                    }, 2000); // Delay for rendering subgrid

                                } else {
                                    console.log("No visible rows to select.");
                                }
                            });

                        }
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
            //height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_StockCardAddEdit", "StockCard")',
            data: {
                cardId: recId,
                mode: mode
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        //mywindow.center();
        mywindow.open();
        //resizeWindow();
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

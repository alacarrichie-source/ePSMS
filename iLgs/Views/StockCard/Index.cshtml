@{
    ViewBag.Title = "Stock Card"; 
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row">
    <div class="col-md-6">
        <div class="col-md-12">
            @Html.Label("User Name:")
        </div>
        <div class="col-md-12">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("UserName")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select encoder")
                .DataTextField("NameFull")
                .DataValueField("UserName")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetGsoUsers", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("UserName").Title("User Name").Width("30%");
                    c.Add().Field("NameFull").Title("Name Full").Width("70%");
                })
                .Events(e => e.Select("onSelectUserName").Change("onChangeUserName"))
                .AutoBind(true)
            )
        </div>
    </div>
</div>
<br />


@(Html.Kendo().Grid<iLgs.Models.StockCardVM>()
    .HtmlAttributes(new { @class = "max-grid-2" } )
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Id).Hidden();
        col.Bound(c => c.Fund).Width(40);
        col.Bound(c => c.PsNo).Width(100);
        col.Bound(c => c.ItemType).Width(100);
        col.Bound(c => c.SubAccount1).Width(100);
        col.Bound(c => c.SubAccount2).Width(100);
        col.Bound(c => c.SubAccount3).Width(100);
        col.Bound(c => c.SubAccount4).Width(100);
        //col.Bound(c => c.SubAccount).Width(100);
        col.Bound(c => c.Item).Width(100).Title("Articles");
        col.Bound(c => c.InsertedBy).Width(70).Title("Created by");
        col.Bound(c => c.ItemCount).Width(70);
        col.Bound(c => c.NotPosted).Width(70);
        //col.Bound(c => c.Description).Width(100);
        col.Command(command =>
        {
            //command.Edit();
            command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEdit");
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            command.Destroy();
        }).Width(100);
    })
    @*.ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd_").Content("Add Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAdd")))
                @(Html.Kendo().Button().Name("btnPrintCard").Content("Print").Icon("k-icon k-i-print").Events(e => e.Click("onClickBtnPrint")))
            </text>);
        })*@
    .ToolBar(t =>
    {
        //t.Create().Text("Add New Record");
        //t.Custom().Text("Add New Record").IconClass("k-icon k-i-add").Name("btnTransfer").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Add New Record").IconClass("k-icon k-i-add").Name("btnAddNew").HtmlAttributes(new { @class = "k-grid-add-custom" });
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemType, "contains");
        s.Field(o => o.SubAccount1, "contains");
        s.Field(o => o.SubAccount2, "contains");
        s.Field(o => o.SubAccount3, "contains");
        s.Field(o => o.SubAccount4, "contains");
        s.Field(o => o.Item, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.CardCategory).DefaultValue("S").Editable(true);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => {
            s.Add(a => a.Fund);
            s.Add(a => a.ItemType);
            s.Add(a => a.SubAccount1);
            s.Add(a => a.SubAccount2);
            s.Add(a => a.SubAccount3);
            s.Add(a => a.SubAccount4);
            s.Add(a => a.Item);
            //s.Add(a => a.InsertedDt).Descending();
        })
        .Read(read => read.Action("Read", "StockCard").Data("DataStockCard"))
        //.Create(create => create.Action("Create", "StockCard"))
        //.Update(update => update.Action("Update", "StockCard"))
        .Destroy(destroy => destroy.Action("Destroy", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
    )
)

<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("PO Items")
            .Selected(true)
            .LoadContentFrom("_StockCardItem", "StockCard", new { cardId = "#=Id#", category = "#=ItemTypeCode#" });
        })
       .ToClientTemplate()
    )
</script>

<script id="IssuedItems" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemIssuanceVM>()
    .Name("gridIssuance_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(100);
        //col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.IssuedTo).Width(50);
        col.Bound(c => c.IssuedDate).Width(50).EditorTemplateName("_IssuedDateTemplate");
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridIssuanceDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemIssuanceTemplate").Window(w => w.Width(500).Title("Card Item Issuance")))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridIssuance")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.Amount).Editable(false);
            model.Field(p => p.IssuedToSw).DefaultValue(1);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("IssuanceRead", "StockCard", new { cardItemId = "#=Id#" }))
        .Create(create => create.Action("IssuanceCreate", "StockCard"))
        .Update(update => update.Action("IssuanceUpdate", "StockCard"))
        .Destroy(destroy => destroy.Action("IssuanceDestroy", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGridIssuance")
        .Edit("onEditGridIssuance")
        .DataBound("onDataBoundGridIssuance")
        .Remove("onRemoveGridIssuance")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>


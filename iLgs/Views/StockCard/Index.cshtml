@{
    ViewBag.Title = "Stock Card";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.StockCardVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Fund).Width(70); 
        col.Bound(c => c.Item).Width(100);
        col.Bound(c => c.StockNo).Width(70);
        col.Bound(c => c.StockName).Width(70);
        col.Bound(c => c.Description).Width(150);        
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardTemplate").Window(w => w.Width(800).Title("Stock Card")))    
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("Read", "StockCard"))
        .Create(create => create.Action("Create", "StockCard"))
        .Update(update => update.Action("Update", "StockCard"))
        .Destroy(destroy => destroy.Action("Destroy", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
    )
)


<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("PARS")
                .Selected(true)
                .Content(@<text>
                    @RenderPars()
                </text>);
            @*items.Add()
                .Text("PROPERTY FIELDS")
                .Content(@<text>
                    @RenderFields()
                </text>);*@
        })
       .ToClientTemplate()
    )
</script>

@helper RenderPars()
{
    @(Html.Kendo().Grid<iLgs.Models.StockItemVM>()
        .Name("gridItems_#=Id#")
        .Columns(columns =>
        {
            columns.Bound(f => f.RefDate).Width(50);
            columns.Bound(f => f.RefNo).Width(50);
            columns.Bound(f => f.RefType).Width(50);
            columns.Bound(f => f.UnitCost).Width(50)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Group(group => group.Title("Quantity")
                .Columns(info =>
                {
                    info.Bound(f => f.Qty)
                      .Width(50).Title("Receipt")
                      .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                      .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                      .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyIss)
                        .Width(50).Title("Issue")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyBal)
                        .Width(50).Title("Balance")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );            
            columns.Bound(f => f.Remarks).Width(70);
            columns.Command(commands =>
            {
                commands.Edit();
                commands.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            }).Width(120);
        })
        .ToolBar(t =>
        {
            t.Create();
        })
        //.Editable(editable => editable.Mode(GridEditMode.InLine))
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemTemplate").Window(w => w.Width(800).Title("Stock Card Item")))
        .Selectable()
        .Navigatable()
        .NoRecords()
        .ClientDetailTemplateId("IssuedItems")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyIss).Sum();
                a.Add(p => p.QtyBal).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItems"))
            .Read("ItemRead", "StockCard", new { cardId = "#=Id#" })
            .Create("ItemCreate", "StockCard")
            .Update("ItemUpdate", "StockCard")
            .Destroy("ItemDestroy", "StockCard")
        ).Events(e => e.Edit("onEditGridItems").Change("onChangeGridItems").DataBound("onDataBoundGridItems"))
        .ToClientTemplate()
    )
}


<script id="IssuedItems" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.StockItemIssuanceVM>()
    .Name("gridIssuance_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Location).Width(50);
        col.Bound(c => c.Officer).Width(50);
        col.Bound(c => c.IssuedTo).Width(50);
        col.Bound(c => c.IssuedDate).Width(50).EditorTemplateName("_IssuedDateTemplate");
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("error_handler").RequestEnd("onRequestEndGridIssuance")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.Amount).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("IssuanceRead", "StockCard", new { stockItemId = "#=Id#" }))
        .Create(create => create.Action("IssuanceCreate", "StockCard"))
        .Update(update => update.Action("IssuanceUpdate", "StockCard"))
        .Destroy(destroy => destroy.Action("IssuanceDestroy", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGridIssuance")
        .Edit("onEditGridIssuance")
        .DataBound("onDataBoundGridIssuance")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>



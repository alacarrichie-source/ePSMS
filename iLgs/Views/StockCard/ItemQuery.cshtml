        //columns.Group(group => group.Title("Released Quantity")
        //    .Columns(info =>
        //    {
        //        info.Bound(f => f.TransferOut)
        //            .Width(50).Title("Intermediary<br><br>Transit-Out")
        //            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
        //            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
        //            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //        info.Bound(f => f.QtyIss)
        //            .Width(50).Title("Issued")
        //            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
        //            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
        //            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //    }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        //);
        columns.Bound(f => f.QtyBal).Width(50).Title("Balance<br>Quantity")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #")
            .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n0}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        columns.Bound(f => f.Amount).Width(50)
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
            .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
            .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //columns.Group(group => group.Title("PO Amounts")
        //        .Columns(info =>
        //        {
        //            info.Bound(f => f.Amount).Width(50).Title("Original<br>PO")
        //                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
        //                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
        //                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
        //                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //            info.Bound(f => f.IssueAmount).Width(50).Title("Issued")
        //                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
        //                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
        //                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
        //                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //            info.Bound(f => f.BalanceAmount).Width(50).Title("Balance")
        //                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
        //                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
        //                .ClientFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #").FooterHtmlAttributes(new { Style = "text-align:right;" })
        //                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        //        }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        //    );
        columns.Bound(f => f.InsertedBy).Width(50);
        columns.Bound(f => f.InsertedDt).Width(50);
        columns.Bound(f => f.UpdatedBy).Width(50);
        columns.Bound(f => f.UpdatedDt).Width(50);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.SubAccount, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.Article, "contains");
        s.Field(o => o.StockNo, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.LocCode, "contains");
        s.Field(o => o.Location, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.Groupable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => {
            //s.Add(a => a.Article); s
            //.Add(a => a.PoNo);
            //s.Add(a => a.PoDate);
            s.Add(a => a.InsertedDt);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.TransferIn).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.TransferOut).Sum();
            a.Add(p => p.QtyBal).Sum();
            a.Add(p => p.Amount).Sum();
            //a.Add(p => p.BalanceAmount).Sum();
            //a.Add(p => p.IssueAmount).Sum();
        })
        .Read(read => read.Action("ItemQueryRead", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)

<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_StockCardItem", "StockCard", new { cardId = "#=Id#", category = "#=AccountCode#" });
        })
       .ToClientTemplate()
    )
</script>

<script id="IssuedItems" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemIssuanceVM>()
    .Name("gridIssuance_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(100);
        //col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.IssuedTo).Width(50);
        col.Bound(c => c.IssuedDate).Width(50).EditorTemplateName("_IssuedDateTemplate");
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridIssuanceDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemIssuanceTemplate").Window(w => w.Width(500).Title("Card Item Issuance")))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridIssuance")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.Amount).Editable(false);
            model.Field(p => p.IssuedToSw).DefaultValue(1);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("IssuanceRead", "StockCard", new { cardItemId = "#=Id#" }))
        .Create(create => create.Action("IssuanceCreate", "StockCard"))
        .Update(update => update.Action("IssuanceUpdate", "StockCard"))
        .Destroy(destroy => destroy.Action("IssuanceDestroy", "StockCard"))
    )
    .Events(events => events
        .Change("onChangeGridIssuance")
        .Edit("onEditGridIssuance")
        .DataBound("onDataBoundGridIssuance")
        .Remove("onRemoveGridIssuance")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>


            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(m => m.AcqMode, htmlAttributes: new { @class = "col-md-2" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(m => m.AcqMode).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))

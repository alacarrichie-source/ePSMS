                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ItemCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Item")
                        .DataTextField("Description")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetItems", "Items");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("ItemNo").Title("Item No.").Width("10%");
                            c.Add().Field("Code").Title("Code").Width("10%");
                            c.Add().Field("MainDesc").Title("Sub-Account").Width("40%");
                            c.Add().Field("Description").Title("Article").Width("40%");
                            //c.Add().Field("MainDesc").Title("Group").Width("40%")
                            //        .Template("<span class=\"k-textarea k-readonly \" ><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.MainDesc #</textarea></span>");
                            //c.Add().Field("Description").Title("Article").Width("40%")
                            //    .Template("<span class=\"k-textarea k-readonly \"><textarea data-role=\"textarea\" disabled=\"disabled\" readonly=\"readonly\" aria-disabled=\"true\" class=\"!k-overflow-y-auto k-input-inner\">#: data.Description #</textarea></span>");
                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectItemCode").DataBound("onDataBoundItemCode"); })
                    )
                    @Html.ValidationMessageFor(m => m.ItemCodeId)
                </div>
            </div>

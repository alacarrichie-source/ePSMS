@model iLgs.Models.PsCardVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.ItemCode)
    @Html.HiddenFor(model => model.ItemTypeCode)
    @Html.HiddenFor(model => model.Item)
    @Html.HiddenFor(model => model.SubAccountCode)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemCodeId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ItemCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Item")
                        .DataTextField("Description")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetItems", "Items");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("ItemNo").Title("Item No.").Width("10%");
                            c.Add().Field("Code").Title("Code").Width("10%");
                            c.Add().Field("MainDesc").Title("Group").Width("60%");
                            c.Add().Field("Description").Title("Article").Width("20%");
                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectItemCode").DataBound("onDataBoundItemCode"); })
                    )
                    @Html.ValidationMessageFor(m => m.ItemCodeId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.SubAccount, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.SubAccount).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemType).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>


        <div id="DIV_ITEM_D">
            <div class="row">

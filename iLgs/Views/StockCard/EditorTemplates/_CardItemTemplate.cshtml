                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>
        </div>*@

        <br />
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-3" })
                <div class="col-md-9">
                    @(Html.Kendo().TextAreaFor(m => m.Description).Rows(5).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(m => m.OtherDesc, htmlAttributes: new { @class = "col-md-3" })
                <div class="col-md-9">
                    @(Html.Kendo().TextAreaFor(m => m.OtherDesc).Rows(5).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.OtherDesc)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(m => m.Remarks, htmlAttributes: new { @class = "col-md-3" })
                <div class="col-md-9">
                    @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(5).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>            
        </div>

         <br />

        @if (!string.IsNullOrEmpty(partialViewName))
        {
            @Html.Partial(partialViewName)
        }
        
        @if (ViewBag.FieldSw.InvDist)
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.InvDist, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.InvDist)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Remarks")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetinvDistList", "Getters");
                                })                                
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Description").Width("100%");
                            })                            
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(m => m.InvDist)
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.FieldSw.AcqDate)
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.AcqDate, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().DatePickerFor(m => m.AcqDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.AcqDate)
                    </div>
                </div>                
            </div>
        }

        @if (ViewBag.FieldSw.AcqYear)
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.ConstructionYear, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.ConstructionYear).Decimals(0).Spinners(false).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.ConstructionYear)
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.FieldSw.PhaseNo)
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.PhaseNo, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.PhaseNo).Decimals(0).Spinners(false).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.PhaseNo)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.PhaseAmount, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.PhaseAmount).Decimals(2).Spinners(false).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.PhaseAmount)
                    </div>
                </div>
            </div>
        }        

        @if (ViewBag.FieldSw.Type)
        {
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "col-md-3" })
                    <div class="col-md-9">
                        @(Html.Kendo().TextBoxFor(m => m.Type).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.Type)
                    </div>
                </div>                
            </div>
        }


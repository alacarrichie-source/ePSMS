<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .menu-grid .k-grid-content {
        overflow-x: auto;
        height: calc(100vh - 270px) !important;
    }

    .menu-grid2 .k-grid-content {
        overflow-x: auto;
        height: calc(100vh - 210px) !important;

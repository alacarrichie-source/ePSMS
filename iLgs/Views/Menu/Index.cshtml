@{
    ViewBag.Title = "Menu";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="row">
    <div class="col-md-8">
        @Html.Label("Application")
    </div>
    <div class="col-md-8">
        @(Html.Kendo().DropDownList()//.ComboBox()
                .Name("sysCode")
                .HtmlAttributes(new { style = "width:300px" })
                .Rounded(Rounded.Medium)
                .FillMode(FillMode.Outline)
                //.OptionLabel("Select Application...")
                .DataTextField("Code")
                .DataValueField("Code")
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        //read.Action("GetCodes", "Getters", new { mastCode = "APPS" });
                        read.Action("GetSysCodes", "SysCodes");
                    })
                    .ServerFiltering(true);
                })
        )
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        @Html.Label("Menu Level")
    </div>
    <div class="col-md-8">
        @(Html.Kendo().DropDownList()//.ComboBox()
                .Name("parentId")
                .HtmlAttributes(new { style = "width:300px" })
                .Filter(FilterType.Contains)
                .Rounded(Rounded.Medium)
                .FillMode(FillMode.Outline)                
                //.OptionLabel("Select Level...")
                .DataTextField("Description")
                .DataValueField("Code")
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetMenulevels", "Menu").Data("DataLevel");
                    })
                    .ServerFiltering(true);
                }).CascadeFrom("sysCode")
        )
        @*<input type="submit" value="Submit" id="cmdSubmit" />*@
        @(Html.Kendo().Button().Content("Submit").Name("cmdSubmit"))
    </div>

</div>
<br />
<div class="col-md-9">
    @(Html.Kendo().Grid<iLgs.Models.Menubase>()
        .Name("grid")
        .HtmlAttributes(new { @class = "menu-grid" })
        .Columns(col =>
        {
            col.Bound(c => c.ChildId).Hidden();
            col.Bound(c => c.Sequence).Width(50).Filterable(true);
            col.Bound(c => c.Description).Width(150).Filterable(true);
            col.Bound(c => c.Action).Width(70);
            col.Bound(c => c.Controller).Width(70);
            col.Bound(c => c.MenuId).Width(70);
            col.Bound(c => c.ObjectParam).Width(50);
            //col.Bound(c => c.Result).Width(50);
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
                command.Custom("Select").Text("Select").Click("onCommand");
            }).Width(172);
        })
        .ToolBar(toolbar => toolbar.Create())
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Pageable()
        .Sortable()
        .Scrollable(s => s.Height(350))
        .NoRecords()
        //.HtmlAttributes(new { style = "height:500px;" })
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError")
            //.Sync("sync_handler")
                )
            .Model(model =>
            {
                model.Id(p => p.ChildId);
                model.Field(p => p.ChildId).DefaultValue(-1).Editable(false);
            })
            .Read(read => read.Action("MenuRead", "Menu").Data("MenuData"))
            .Create(create => create.Action("MenuCreate", "Menu").Data("MenuData"))
            .Update(update => update.Action("MenuUpdate", "Menu"))
            .Destroy(destroy => destroy.Action("MenuDestroy", "Menu"))
        )
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")            
        )
        .AutoBind(false)        
    )
</div>
<div class="col-md-3">
    @(Html.Kendo().Grid<iLgs.Models.MenuActionSw>()

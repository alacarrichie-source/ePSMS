    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.ChildId;
        selectedItemId = null;
        $("#gridActions").data("kendoGrid").dataSource.read();
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("ChildId");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }


    function MenuData() {
        return {
            sysCode: $("#sysCode").val(),
            parentId: $("#parentId").val()
        };
    }

    function DataLevel() {
        return {
            sysCode: $("#sysCode").val()
            //,text: $("#parentId").data("kendoComboBox").input.val()
        };
    }

    function OnGridBound(e) {
        $("#grid").data("kendoGrid").select("tr:eq(1)");
    }


    $("#cmdSubmit").click(function (e) {
        e.preventDefault();
        $("#grid").data("kendoGrid").dataSource.read();
    })

    function onCommand(e) {
        var tr = $(e.target).closest("tr"); // get the current table row (tr)
        // get the data bound to the current table row
        var data = this.dataItem(tr);
        var childId = data.ChildId;

        var cb = $('#parentId').data('kendoDropDownList');
        cb.dataSource.read({ sysCode: $("#sysCode").val() })
        cb.value(childId);
        $("#grid").data("kendoGrid").dataSource.read({
            sysCode: $("#sysCode").val(),
            parentId: childId
        });
    }

    function addToComboItems(sysCode, parentId) {
        $.ajax({
            type: "POST",
            url: '@Url.Action("index", "Menu")',
            data: { 'sysCode': sysCode, 'parentId': parentId },
            dataType: 'json',
            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert('error');
            },
            success: function (result) {
                var menuCombo = $('#parentId').data('kendoDropDownList');
                //menuCombo.dataSource.read();
                var selectItem = function (dataItem) {
                    //dataItem argument is a ComboBox data item.
                    return dataItem.Value == value;
                }

                menuCombo.select(selectItem).done($("#cmdSubmit").click());

                //menuCombo.fill(function () { //binds the combobox
                //    menuCombo.select(selectItem).done($("#cmdSubmit").click());

                //})
            }
        });
    }

    // Menu Actions

    function GridActionData() {
        return {
            sysCode: $("#sysCode").val(),
            menuId: selectedId
        };
    }

    function onInclude(e) {
        var grid = $("#gridActions").data("kendoGrid");
        var tr = $(e.target).closest("tr"); // get the current table row (tr)
        var data = this.dataItem(tr);

        selectedItemId = data.Code;
                
        var rowitem = grid.dataSource.get(selectedItemId);
        grid.select($('[data-uid=' + rowitem.uid + ']'));
        
        $.ajax({
            type: "POST",
            url: '@Url.Action("MenuActionSet", "MenuAction")',
            data: {
                sysCode: $("#sysCode").val(),
                menuId: selectedId,
                actionCode: selectedItemId
            }
        }).done(function (result) {
            grid.dataSource.read();
        }).always(function () {
            grid.dataSource.read();
        });
    }

    function onChangeGridActions(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Code;        
    }

    function onDataBoundGridActions(e) {
        var grid = this;
        grid.tbody.find(">tr").each(function () {
            var dataItem = grid.dataItem(this);
            if (!dataItem.IsAllowed) {
                $(this).css("font-style", "italic");
                $(this).css("font-weight", "normal");
                $(this).find('.k-button-text').text('Include');
            } else {
                $(this).css("font-weight", "bold");
                $(this).find('.k-button-text').text('Exclude');
            }
        });
        

        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGridActions(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedItemId = null;
        } else {
            selectedItemId = e.model.get("Code");
            var rowitem = selectedGrid.dataSource.get(selectedItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

</script>



            error: function (XMLHttpRequest, textStatus, errorThrown) {
                alert('error');
            },
            success: function (result) {
                var menuCombo = $('#parentId').data('kendoDropDownList');
                //menuCombo.dataSource.read();
                var selectItem = function (dataItem) {
                    //dataItem argument is a ComboBox data item.
                    return dataItem.Value == value;
                }

                menuCombo.select(selectItem).done($("#cmdSubmit").click());

                //menuCombo.fill(function () { //binds the combobox
                //    menuCombo.select(selectItem).done($("#cmdSubmit").click());

                //})
            }
        });
    }


</script>



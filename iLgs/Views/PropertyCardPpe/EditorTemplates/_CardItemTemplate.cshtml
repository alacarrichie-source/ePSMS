@model iLgs.Models.PropertyCardItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CardId)    
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.RefNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(m => m.RefDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefDate)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.RefType).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefType)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.TransType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.TransType).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.TransType)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Location)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    //read.Action("GetCodeList", "Getters", new { mastCode = "DEPARTMENTS", addAll = false });
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Location)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.IssuedTo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.IssuedTo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedTo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Officer, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Officer).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Officer)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PrevRefNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.PrevRefNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PrevRefNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PrevRefType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.PrevRefType).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PrevRefType)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PrevOfficer, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.PrevOfficer).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PrevOfficer)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Remarks).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>
        </div>
        
    </fieldset>
}



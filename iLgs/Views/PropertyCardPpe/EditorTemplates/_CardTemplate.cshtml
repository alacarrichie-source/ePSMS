        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PrevPropNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.PrevPropNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PrevPropNo)

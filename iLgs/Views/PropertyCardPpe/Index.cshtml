@{
    ViewBag.Title = "Property Card - Equipment";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PropertyCardPpeVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Fund).Width(70); //.EditorTemplateName("_FundTemplate");
        //col.Bound(c => c.ItemCode).Width(100);
        col.Bound(c => c.Item).Width(100);
        col.Bound(c => c.PropNo).Width(70);
        col.Bound(c => c.Description).Width(150);
        //col.Bound(c => c.Type).Width(70);
        //col.Bound(c => c.UnitMeas).Width(70).EditorTemplateName("_UnitMeasTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
    })
    //.Editable(editable => editable.Mode(GridEditMode.InLine))
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardTemplate").Window(w => w.Width(800).Title("Property Card")))
    @*.ToolBar(toolbar =>
        {
        toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd").Content("Add New Record").Icon("k-icon k-i-add")
                                .Events(e => e.Click("onClickBtnAdd"))
                )
            </text>);
        })*@
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("Read", "PropertyCardPpe"))
        .Create(create => create.Action("Create", "PropertyCardPpe"))
        .Update(update => update.Action("Update", "PropertyCardPpe"))
        .Destroy(destroy => destroy.Action("Destroy", "PropertyCardPpe"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
    )
)


<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("PARS")
                .Selected(true)
                .Content(@<text>
                    @RenderPars()
                </text>);
            @*items.Add()
                .Text("PROPERTY FIELDS")
                .Content(@<text>
                    @RenderFields()
                </text>);*@
        })
       .ToClientTemplate()
    )
</script>


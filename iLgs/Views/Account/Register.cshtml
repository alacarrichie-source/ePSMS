@model iLgs.Models.RegisterViewModel
@{
    ViewBag.Title = "Register";
}

<h2 class="text-info">@ViewBag.Title.</h2>

@using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{

    @Html.AntiForgeryToken()
    <h4>Create a new account.</h4>
    <hr />
    @Html.ValidationSummary("", new { @class = "text-danger" })
    <div class="form-group">
        <div class="col-md-5">
            @(Html.Kendo().TextBoxFor(m => m.UserName)
                .Label(l => l.Content("User Name").Floating(true))
            )            
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-5">
            @(Html.Kendo().TextBoxFor(m => m.Email)
                .Label(l => l.Content("Email").Floating(true))
            )
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-5">
            @(Html.Kendo().TextBoxFor(m => m.Password)
                .HtmlAttributes(new { type = "password" })
                .Label(l => l.Content("Password").Floating(true))
            )
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-5">
            @(Html.Kendo().TextBoxFor(m => m.ConfirmPassword)
                .HtmlAttributes(new { type = "password" })
                .Label(l => l.Content("Confirm Password").Floating(true))
            )
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-5">
            <input type="submit" class="btn btn-default" value="Register" />
        </div>
    </div>

}

<style>

    .k-floating-label-container {
        width: 100%;
    }
</style>



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

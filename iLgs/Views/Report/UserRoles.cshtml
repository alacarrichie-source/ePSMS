@model iLgs.Models.REPORT_UserRoles_VM


@{
    ViewBag.Title = "User Role Masterlist";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    <br />
    <div class="row">
        <div class="col-md-2 text-right">
            @Html.Label("Role")
        </div>
        <div class="col-md-3">
            @(Html.Kendo().DropDownListFor(m => m.RoleId)
                        .DataTextField("RoleName")
                        .DataValueField("RoleId")
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetRoleList", "Getters");
                            })
                            .ServerFiltering(true);
                        })
            )
        </div>
    </div>

    <br />
    <div class="row">
        <div class="col-md-2 text-right">
            &nbsp;
        </div>
        <div class="col-md-5">
            @(Html.Kendo().Button().Content("Submit").Name("btnSubmit"))
            @(Html.Kendo().Button().Name("btnSaveSubmit").Content("Save to Excel File"))
        </div>
    </div>

}

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .fieldlist li {
        list-style: none;
        /*padding-bottom: 1em;*/
    }

    .box-section {
        margin: 0 auto .5em;
        padding: 1em;
        padding-left: 3em;
        padding-right: 3em;
        border: 1px solid rgba(20,53,80,0.14);
    }
</style>

<script type="text/javascript">
    $("#btnSubmit").click(function (e) {
        e.preventDefault();
        Print(0);
    })

    function Print(save) {
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var data = $("#form").serialize();
            var url = '@Url.Action("UserRolesRpt", "Report")?' + data + '&save=' + save;
            $("#windowcontainer").append("<div id='windowPrint'></div>");
            var mywindow = $("#windowPrint")
                    .kendoWindow({
                        actions: ["Maximize", "Minimize", "Close"],
                        resizable: true,
                        draggable: true,
                        modal: true,
                        visible: false,
                        iframe: true,
                        deactivate: function () {
                            this.destroy();
                        }
                    }).data("kendoWindow");
            mywindow.setOptions({
                title: "Preview",
                width: 1200,
                height: 700
            });
            mywindow.refresh({
                url: url
            });
            mywindow.center();
            mywindow.open();
        }
    }

    $("#btnSaveSubmit").click(function (e) {
        e.preventDefault();
        Print(1);
    })


</script>








    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Recored already posted by " + postedBy);
        }
        else {
            var msg = "Post Selected record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "ItemCodeRequest")',
                    data: { id: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            displayErrors(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    function displayErrors(errors) {
        if (errors.length > 0) {
            // Concatenate all error messages into a single string
            var allErrors = errors.join('\n');
            alert(allErrors);
        }
    }

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost Selected Record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "ItemCodeRequest")',
                data: { id: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrint").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("CustodianRpt", "ItemCodeRequest")?id=' + selectedId;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });

    // COMMON for ITEMS
    function SaveGridItems(url)
    {
        var popupNotification = $("#popupNotification").data("kendoNotification");
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var reportId = $("#ReportId").val();
        var formData = $("#form").serialize();

        // Make an AJAX call to submit the data
        $.ajax({
            type: 'POST',
            url: url,
            data: formData,
            success: function (response) {
                disabled.attr('disabled', 'disabled');
                if (response.Errors) {
                    // Clear previous errors
                    $("#ErrorContent .errors").empty();
                    var errorMsg = "";
                    // Populate errors into the template
                    for (var field in response.Errors) {
                        var messages = response.Errors[field].errors;
                        var html = kendo.template($("#validationMessageTemplate").html())({
                            field: field,
                            messages: messages
                        });
                        $("#ErrorContent .errors").append(html);
                        errorMsg += html;
                    }
                    popupNotification.show(errorMsg, "error");
                    // Show the error content
                    $("#ErrorContent").removeClass("hidden");
                } else {
                    // Handle validation errors if any
                    $("#gridItems_" + reportId).data("kendoGrid").dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                e.sender.trigger("error", {
                    errors: [error]
                });
                alert("An error occurred: " + error);
            }
        });
    }
    // END COMMON


    // GRID IMAGES

@{
    ViewBag.Title = "Item Code Request";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
@(Html.Kendo().Grid<iLgs.Models.ItemCodeRequestVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(70);
        col.Bound(c => c.Description).Width(70);
        col.Bound(c => c.Remarks).Width(100);
        col.Bound(c => c.EstCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.IsConsumable).Width(50).ClientTemplate("#= IsConsumable ? 'Y' : 'N' #").EditorTemplateName("_IsConsumableTemplate");
        col.Bound(c => c.IsForDistribution).Width(50).ClientTemplate("#= IsForDistribution ? 'Y' : 'N' #").EditorTemplateName("_IsForDistributionTemplate");
        col.Bound(c => c.IsIncorporated).Width(50).ClientTemplate("#= IsIncorporated ? 'Y' : 'N' #").EditorTemplateName("_IsIncorporatedTemplate");
        col.Bound(c => c.Status).Width(70);
        col.Bound(c => c.StatusRemarks).Width(100);
        col.Bound(c => c.InsertedBy).Width(50);
        col.Bound(c => c.InsertedDt).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            command.Custom("Status").IconClass("k-icon k-i-book").Click("onClickStatus").Visible("CheckIsAdmin");
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        //t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ItemCodeRequestTemplate").Window(w => w.Width(800).Title("Item Code Request")))
    .Search(s =>
    {
        s.Field(o => o.Department, "contains");
        s.Field(o => o.Description, "contains");
        s.Field(o => o.Remarks, "contains");
        s.Field(o => o.InsertedBy, "contains");        
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("UploadedFiles")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.IsConsumable).DefaultValue(false).Editable(true);
            model.Field(p => p.IsForDistribution).DefaultValue(false).Editable(true);
            model.Field(p => p.IsIncorporated).DefaultValue(false).Editable(true);
        })
        .Read(read => read.Action("Read", "ItemCodeRequest"))
        .Create(create => create.Action("Create", "ItemCodeRequest"))
        .Update(update => update.Action("Update", "ItemCodeRequest"))
        .Destroy(destroy => destroy.Action("Destroy", "ItemCodeRequest"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
        .AutoBind(true)
)

@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<script id="UploadedFiles" type="text/kendo-tmpl">

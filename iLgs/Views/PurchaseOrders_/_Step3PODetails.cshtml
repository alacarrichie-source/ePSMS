@* Views/PurchaseOrders/_Step3PODetails.cshtml *@
<div class="po-details-step">
    <div class="card border mb-2">
        <div class="card-header bg-light py-1.5 px-2 font-weight-bold text-xs">
            Terms, Place of Delivery & Accounting References
        </div>
        <div class="card-body p-2 text-xs">
            <div class="form-row">
                <div class="col-md-6 form-group mb-2">
                    <label class="font-weight-bold">Place of Delivery</label>
                    <input type="text" id="txtPlaceOfDelivery" class="form-control form-control-sm" value="Central Receiving Section, Supply & Property Management Office" />
                </div>
                <div class="col-md-3 form-group mb-2">
                    <label class="font-weight-bold">Delivery Period (Calendar Days)</label>
                    <input type="number" id="txtDeliveryDays" class="form-control form-control-sm" value="30" />
                </div>
                <div class="col-md-3 form-group mb-2">
                    <label class="font-weight-bold">Payment Term</label>
                    <select id="ddlPaymentTerms" class="form-control form-control-sm">
                        <option value="Government Terms (30 Days)">Government Terms (30 Days)</option>
                        <option value="Progress Billing">Progress Billing</option>
                        <option value="Upon Full Delivery & Acceptance">Upon Full Delivery & Acceptance</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-4 form-group mb-2">
                    <label class="font-weight-bold">Fund Cluster Code</label>
                    <input type="text" id="txtFundCluster" class="form-control form-control-sm" value="01 - Regular Agency Fund" />
                </div>
                <div class="col-md-4 form-group mb-2">
                    <label class="font-weight-bold">ORS/BURS Reference No.</label>
                    <input type="text" id="txtOrsBurs" class="form-control form-control-sm" value="02-101101-2024-10-00421" />
                </div>
                <div class="col-md-4 form-group mb-2">
                    <label class="font-weight-bold">BAC Resolution No.</label>
                    <input type="text" id="txtBacResolution" class="form-control form-control-sm" value="BAC-RES-2024-189" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <button class="btn btn-outline-secondary btn-sm" onclick="goToStep(2)">
            <i class="k-icon k-i-arrow-left mr-1"></i> Back to Allocation
        </button>
        <button class="btn btn-primary btn-sm font-weight-bold" onclick="goToStep(4)">
            Review & Finalize <i class="k-icon k-i-arrow-right ml-1"></i>
        </button>
    </div>
</div>

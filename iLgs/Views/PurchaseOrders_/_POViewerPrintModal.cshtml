@* Views/PurchaseOrders/_POViewerPrintModal.cshtml (COA Standard PO Layout) *@
@model iLgs.Core.ViewModels.PurchaseOrderViewModel

<div id="poViewerModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-2 px-3 d-print-none">
                <h6 class="modal-title font-weight-bold">Official Purchase Order: @Model.PONumber</h6>
                <div>
                    <button class="btn btn-sm btn-info mr-1" onclick="window.print()"><i class="k-icon k-i-print mr-1"></i> Print</button>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
            </div>
            <div class="modal-body p-4 text-xs font-sans">
                <!-- COA Header -->
                <div class="text-center border-bottom pb-2 mb-3">
                    <p class="text-uppercase mb-0 text-muted">Republic of the Philippines</p>
                    <p class="text-uppercase mb-0 text-muted">Department of Budget and Management</p>
                    <h6 class="font-weight-bold text-uppercase mb-0">Property & Supply Management Office</h6>
                    <h5 class="font-weight-black text-uppercase mt-1 mb-0">PURCHASE ORDER</h5>
                </div>

                <!-- Supplier & PO Header Grid -->
                <table class="table table-bordered table-sm mb-3">
                    <tr>
                        <td style="width:50%"><strong>Supplier:</strong> @Model.SupplierName</td>
                        <td style="width:50%"><strong>P.O. No.:</strong> @Model.PONumber</td>
                    </tr>
                    <tr>
                        <td><strong>Address:</strong> @Model.SupplierAddress</td>
                        <td><strong>Date:</strong> @Model.PODate.Value.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <td><strong>TIN:</strong> @Model.SupplierTin</td>
                        <td><strong>Mode of Procurement:</strong> @Model.ModeOfProcurement</td>
                    </tr>
                </table>

                <!-- Line Items Table -->
                <table class="table table-bordered table-sm mb-3">
                    <thead class="bg-light text-center">
                        <tr>
                            <th style="width:40px">Stock No.</th>
                            <th style="width:50px">Unit</th>
                            <th>Description & Technical Specifications</th>
                            <th style="width:60px">Qty</th>
                            <th style="width:90px">Unit Cost</th>
                            <th style="width:110px">Amount (PHP)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            <tr>
                                <td class="text-center font-monospace">@(i + 1)</td>
                                <td class="text-center">@item.Unit</td>
                                <td>
                                    <strong>@item.Description</strong>
                                    @if (!string.IsNullOrEmpty(item.TechDescription))
                                    {
                                        <div class="text-muted text-xs">@item.TechDescription</div>
                                    }
                                    <small class="text-primary font-monospace">PR Ref: @item.SourcePrNo</small>
                                </td>
                                <td class="text-right font-weight-bold">@item.Quantity</td>
                                <td class="text-right">@item.UnitCost.ToString("N2")</td>
                                <td class="text-right font-weight-bold">@item.TotalCost.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="bg-light font-weight-bold">
                            <td colspan="5" class="text-right text-uppercase">Grand Total Amount (PHP):</td>
                            <td class="text-right text-success font-monospace">@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Signatories -->
                <div class="row mt-4 pt-3 border-top">
                    <div class="col-6 text-center">
                        <p class="mb-4 text-left">Conforme:</p>
                        <p class="font-weight-bold mb-0">@Model.SupplierName.ToUpper()</p>
                        <small class="text-muted">Signature over Printed Name</small>
                    </div>
                    <div class="col-6 text-center">
                        <p class="mb-4 text-left">Very truly yours,</p>
                        <p class="font-weight-bold mb-0">HON. EDUARDO S. DELA CRUZ</p>
                        <small class="text-muted">Head of Procuring Entity (HoPE)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        @(Html.Kendo().Grid<iLgs.Models.PsCardItemTransferVM>()
            .Name("gridTansit")
            .Columns(col =>
            {
                col.Bound(p => p.TransDate).Width(70).Title("Date")
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(Date), 'MM/dd/yyyy') #");
                col.Bound(p => p.LocationCode).Width(50);
                col.Bound(p => p.Location).Width(70);
                col.Bound(p => p.Qty).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(p => p.TransferOut).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(p => p.TransferIn).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(p => p.QtyIss).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(p => p.QtyBal).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                col.Bound(p => p.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                        .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
            })
            .Pageable(pageable => pageable.Refresh(true).PageSizes(true).ButtonCount(5))
            .Sortable(sortable => sortable
                .AllowUnsort(true)
                .SortMode(GridSortMode.MultipleColumn))
            .Filterable()
            .Scrollable()
            .NoRecords()
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(20)
                .Events(events => events.Error("InlineGridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                })
                .Aggregates(a =>
                {
                    a.Add(p => p.Qty).Sum();
                    a.Add(p => p.QtyIss).Sum();
                    a.Add(p => p.TransferIn).Sum();
                    a.Add(p => p.TransferOut).Sum();
                    a.Add(p => p.QtyBal).Sum();
                    a.Add(p => p.Amount).Sum();
                })
                .Read(read => read.Action("_TransitRead", "ItemCard", new { psCardItemExtnId = ViewData["psCardItemExtnId"] }))
                )
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .AutoBind(true)
        //.Events(events => events.Edit("onEditGridAddCost")
        //.DataBound("onDataBoundGridAddCost"))
        )
    </div>
    <div class="col-md-6">

    </div>
</div>

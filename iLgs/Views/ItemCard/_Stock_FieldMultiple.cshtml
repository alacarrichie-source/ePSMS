            @Html.DisplayFor(m => m.AllField.Multipliers, "LabelInt")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(m => m.AllField.Multipliers).HtmlAttributes(new { @readonly = "readonly",  style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))

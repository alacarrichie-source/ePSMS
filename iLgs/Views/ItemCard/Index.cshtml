@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().PanelBar()
    .Name("panelbar")
    .ExpandMode(PanelBarExpandMode.Multiple)
    .Items(panelbar =>
    {
        panelbar.Add().Text("Items")
            .Expanded(true)
            .Selected(true)
            .Content(@<text>
                <div class="div-render">
                    @RenderItems()
                </div>
            </text>);
        panelbar.Add().Text("Account")
            .Expanded(true)
            .Content(@<text>
                <div id="div-account" class="div-render">
                </div>
            </text>);
        panelbar.Add().Text("Purchase Order")
            .Expanded(true)
            .Content(@<text>                
                <div id="div-order" class="div-render">
                </div>
            </text>);
        panelbar.Add().Text("PAR/ICS/MR/ARE")
            .Expanded(true)
            .Content(@<text>
                <div id="div-par-ics" class="div-render">
                </div>
            </text>);
        panelbar.Add().Text("Item Description")
            .Expanded(true)
            .Content(@<text>
                <div id="div-description" class="div-render">
                </div>
            </text>);
        if (ViewBag.AccountGroup == 3)
        {
            panelbar.Add().Text("Vehicle Repair")
                .Expanded(true)
                .Content(@<text>
                <div id="div-repair" class="div-render">
                </div>
            </text>);
        }
    })
)


@helper  RenderItems()
{
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnVM>()
            .Name("grid")
            .Columns(columns =>
            {
                columns.Bound(f => f.PoNo).Width(50);
                columns.Bound(f => f.PsNo).Width(70);
                columns.Bound(f => f.RefNo).Width(70);
                columns.Bound(f => f.Description).Width(100);
                columns.Bound(f => f.PropNo).Width(70);
            })
            .ToolBar(t =>
            {
                t.Search();
            })
            .Search(s =>
            {
                s.Field(o => o.PsNo, "contains");
                s.Field(o => o.PropNo, "contains");
                s.Field(o => o.RefNo, "contains");
                s.Field(o => o.Description, "contains");
                s.Field(o => o.PoNo, "contains");
            })
            .Pageable(pager => pager
                .Input(false)
                .Numeric(true)
                .Info(true)
                .PreviousNext(true)
                .Refresh(true)
                .PageSizes(true)
                .ButtonCount(5)
            )
            .Filterable()
            .NoRecords()
            .Resizable(r => r.Columns(true))
            .Scrollable(scr => scr.Height("auto"))
            .Selectable(s => s.Mode(GridSelectionMode.Single))
            .Sortable()
            //.ClientDetailTemplateId("Details")
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(5)
                //.Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                })
                .Sort(s =>
                {
                    s.Add(a => a.PsNo);
                })
                //.ServerOperation(true)
                .Read(read => read.Action("Read", "ItemCard", new { accountGroup = @ViewBag.AccountGroup }))
            )
            .Events(events => events
                .Change("onChangeGrid")
                .DataBound("onDataBoundGrid")
            )
    )
}


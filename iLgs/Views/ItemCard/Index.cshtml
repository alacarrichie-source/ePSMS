@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<div class="main-section-content row" style="">
    <div id="item-list" class="col col-xs-3">
        <h3>ITEMS</h3>
        @*@Html.TextBox("searchBox", "", new { @class = "k-textbox", placeholder = "Search..." })*@
        @*<div class="k-toolbar k-grid-toolbar" >*@
        <span class="k-searchbox k-input k-input-md k-rounded-md k-input-solid" style="width: 100%;">
            <span class="k-input-icon k-icon k-i-search"></span>
            <input id="searchBox" autocomplete="off" class="k-input-inner" placeholder="Search..." title="Search..." type="text">
        </span>
        @*</div>*@

        @(Html.Kendo().ListView<iLgs.Models.PsCardItemExtnVM>()
            .HtmlAttributes(new { @class = "max-grid-2" })
            .Name("itemList")
            .TagName("div")
            .Events(e => e.DataBound("onListDataBound")
                .Change("onItemChange")
            )
            .ClientTemplateId("itemTemplate")
            .DataSource(dataSource =>
            {
                dataSource.Read(read => read.Action("Read", "ItemCard", new { accountGroup = @ViewBag.AccountGroup }));
                dataSource.PageSize(9);
            })
            .Pageable()
            .Selectable(s => s.Mode(ListViewSelectionMode.Single))
        )
    </div>
    <div id="item-details-wrapper" class="col col-xs-9">
        <div id="item-details">
            <div id="item-about" class="col-xs-12 placeholder">
                <div class="row">
                    <div id="itemBio" class="col-xs-12 col-sm-6">
                    </div>
                </div>                
                <hr />
                <div class="row">
                    <div id="itemEntry" class="col-xs-12 col-sm-6 col-md-12" style="padding-left: 0;">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


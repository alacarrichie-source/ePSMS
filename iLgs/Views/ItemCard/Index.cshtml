<script type="text/javascript">
    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

    $(document).ready(function () {
        $("#searchBox").on("input", function () {
            var value = $(this).val().toLowerCase();
            var listView = $("#itemList").data("kendoListView");
            var ds = listView.dataSource;

            ds.filter({
                logic: "or",
                filters: [
                    { field: "PropNo", operator: "contains", value: value },
                    { field: "Account", operator: "contains", value: value }
                ]
            });
        });
    });

    function onListDataBound(e) {
        this.select($(".item:first"));
    }

    function onItemChange() {
        var itemList = $("#itemList").data("kendoListView"),
            item = itemList.dataSource.getByUid(itemList.select().attr("data-uid")),
            //employeeQuarterSales = $("#EmployeeQuarterSales").data("kendoChart"),
            //employeeAverageSales = $("#EmployeeAverageSales").data("kendoChart"),
            //teamSales = $("#TeamSales").data("kendoChart"),
            //employeeSales = $("#EmployeeSales").data("kendoScheduler"),
            //startDate = $("#StartDate").data("kendoDatePicker"),
            //endDate = $("#EndDate").data("kendoDatePicker"),
            filter = { ItemID: item.Id },
            template = kendo.template($("#itemBioTemplate").html());

        $("#itemBio").html(template(item));

        //employeeSales.dataSource.filter({ field: "EmployeeID", operator: "eq", value: employee.EmployeeID });

        //teamSales.dataSource.read(filter);

        //employeeQuarterSales.dataSource.read(filter);
        //employeeAverageSales.dataSource.read(filter);
        var fieldsContainer = $('#itemEntry');
        //fieldsContainer.empty(); // Clear existing content

        var url = '@Url.Action("_ItemCardEntry", "ItemCard")';

        $.ajax({
            url: url,
            type: 'POST',
            data: {psCardItemExtnId: item.Id, accountGroup: '@ViewBag.AccountGroup'},
            success: function(data) {
                fieldsContainer.html(data);
            }
        });
    }
    
    function UpdateDescription()
    {
        return "";
    }

    function RefreshDivs(dataItem) {
        var fieldsContainer = $('#DIV_ALLFIELDS');
        fieldsContainer.removeClass('hidden');
        //fieldsContainer.empty(); // Clear existing content

        var url = "";
        var data = $("#form").serialize();

        if ('@ViewBag.AccountGroup' == 1) {
            url = '@Url.Action("LoadSuppliesFields", "ItemCard")';
        } else if ('@ViewBag.AccountGroup' == 2) {
            url = '@Url.Action("LoadPpeFields", "ItemCard")';
        } else if ('@ViewBag.AccountGroup' == 3) {
            url = '@Url.Action("LoadVehicleFields", "ItemCard")';
        } else if ('@ViewBag.AccountGroup' == 4) {
            url = '@Url.Action("LoadStructuresFields", "ItemCard")';
        } else if ('@ViewBag.AccountGroup' == 5) {
            url = '@Url.Action("LoadLandFields", "ItemCard")';
        }

        $.ajax({
            url: url,
            type: 'POST',
            data: data,
            success: function(data) {
                fieldsContainer.html(data);
                setTimeout(function () {
                    // Disable all Kendo UI Inputs (TextBox, ComboBox, NumericTextBox, etc.)
                    fieldsContainer.find("input").each(function () {
                        var textbox = $(this).data("kendoTextBox");
                        var combobox = $(this).data("kendoComboBox");
                        var numericTextBox = $(this).data("kendoNumericTextBox");

                        if (textbox) {
                            textbox.enable(false); // Disable Kendo TextBox
                        }
                        if (combobox) {
                            combobox.enable(false); // Disable Kendo ComboBox
                        }
                        if (numericTextBox) {
                            numericTextBox.enable(false); // Disable Kendo NumericTextBox
                        }
                    });

                    // Disable all regular <input>, <select>, and <textarea>
                    fieldsContainer.find("input, select, textarea").prop("disabled", true);
                }, 100); // Delay to ensure Kendo widgets are initialized
            }
        });        
    }

    function onDataBoundItemCodeId(e) {
        var comboBox = this;
        var selectedValue = comboBox.value();

        if (selectedValue !== null && selectedValue !== undefined && selectedValue != "") {
            var dataItem = comboBox.dataItem();
            RefreshDivs(dataItem);
        }
        comboBox.enable(false);
    }

</script>

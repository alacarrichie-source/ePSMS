<script type="text/javascript">
    $(document).ready(function () {
        // When mouse enters the content area
        $('#panelbar .div-render').on('mouseenter', function (event) {
            // Add hover class to the closest PanelBar item (header)
            $(this).closest('.k-item').addClass('hover-panel');
            event.stopPropagation(); // Prevent the event from bubbling up
        });

        // When mouse leaves the content area
        $('#panelbar .div-render').on('mouseleave', function (event) {
            // Remove hover class from the closest PanelBar item (header)
            $(this).closest('.k-item').removeClass('hover-panel');
            event.stopPropagation(); // Prevent the event from bubbling up
        });

        // Optional: Keep hover style on click
        $('#panelbar .div-render').on('click', function (event) {
            // Remove hover from all panels
            $('#panelbar .k-item').removeClass('hover-panel');
            // Add hover style to the clicked panel
            $(this).closest('.k-item').addClass('hover-panel');
            event.stopPropagation(); // Prevent the event from bubbling up
        });
    });

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });

@(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnAddCost>()
    .Name("gridAddCost")
    .Columns(col =>
    {
        col.Bound(p => p.PoNo).Width(70);
        col.Bound(p => p.Effectivity).Width(70)
            .ClientTemplate("#= kendo.toString(kendo.parseDate(Effectivity), 'MM/dd/yyyy') #")
            .EditorTemplateName("_EffectivityTemplate");
        col.Bound(p => p.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" })
                .EditorTemplateName("_AmountTemplate");
        col.Bound(p => p.Remarks).Width(100);
        col.Command(command =>
        {
            if (string.IsNullOrEmpty((string)ViewData["postedBy"]))
            {
                command.Edit();
                command.Destroy();
                command.Custom("Uploads").IconClass("k-icon k-i-upload").Click("onClickUploadAddCost").SendDataKeys(true);
            }
        }).Width(100);

    })
    .ToolBar(toolbar =>
    {
        toolbar.Create();
    })
    //.Editable(e => e.Mode(GridEditMode.InLine))
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AddCostTemplate").Window(w => w.Width(500).Title("Additional Cost")))
    .Pageable(pageable => pageable.Refresh(true).PageSizes(true).ButtonCount(5))
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    .Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridErrorAddCost").RequestEnd("onRequestEndGridAddCost"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.PsCardItemExtnId).DefaultValue(ViewData["psCardItemExtnId"]);
        })
        .Aggregates(a => a.Add(x => x.Amount).Sum())
        .Read(read => read.Action("_AddCostRead", "ItemCard", new { psCardItemExtnId = ViewData["psCardItemExtnId"] }))
        .Create(create => create.Action("_AddCostCreate", "ItemCard"))
        .Update(update => update.Action("_AddCostUpdate", "ItemCard"))
        .Destroy(destroy => destroy.Action("_AddCostDestroy", "ItemCard"))
        )
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .AutoBind(true)
            .Events(events => events.Edit("onEditGridAddCost")
            .Change("onChangeGridAddCost")
            .DataBound("onDataBoundGridAddCost")
        )
)
    <div class="row k-mb-2">
        <div class="item-label col-md-2">
            @Html.DisplayFor(m => m.PriceRate, "LabelDecimal")
        </div>
        <div class="col-md-4">
            @(Html.Kendo().NumericTextBoxFor(m => m.PriceRate).Decimals(2).Format("{0:n2}").Spinners(false)
                .HtmlAttributes(new { @readonly = "readonly", style = "width:100%; max-width:100%;" })
            //.Events(e => e.Change("onChangeSetValues"))
            )

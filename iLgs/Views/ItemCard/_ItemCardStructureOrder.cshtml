        <div class="item-label col-md-2">
            @Html.DisplayFor(m => m.SetLotNo, "Label")
        </div>
        <div class="col-md-4">
            @(Html.Kendo().TextBoxFor(m => m.SetLotNo).Readonly(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => m.SetLotNo)
        </div>
        <div class="item-label col-md-2">

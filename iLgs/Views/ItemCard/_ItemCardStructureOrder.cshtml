    <div class="row k-mb-2">
        <div class="item-label col-md-2">
            @Html.DisplayFor(m => m.SetLotRemarks, "Label")
        </div>
        <div class="col-md-4">
            @(Html.Kendo().TextAreaFor(m => m.SetLotRemarks).Readonly(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => m.SetLotRemarks)
        </div>
    </div>
}

@helper RenderTransit()
{
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
    .Name("gridTransit")
    .Columns(columns =>
    {
        columns.Bound(f => f.TransDate).Width(50).Title("Date");
        columns.Group(group =>
        {
            group.Title("Receipt Quantity").HeaderHtmlAttributes(new { Style = "text-align:center;" })
            .Columns(col =>
            {
                col.Group(g =>
                {
                    g.Title("Originating Department").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.DeptCode).Width(50).Title("Code");
                        info.Bound(f => f.Department).Width(70).Title("PO Owner");
                        info.Bound(f => f.Qty)
                          .Width(50).Title("In")
                          .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                          .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                          .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
                col.Group(g =>
                {
                    g.Title("Intermediary").HeaderHtmlAttributes(new { Style = "text-align:center;" })
                    .Columns(info =>
                    {
                        info.Bound(f => f.LocCode).Width(50).Title("Code");
                        info.Bound(f => f.Location).Width(50).Title("Location");
                        info.Bound(f => f.TransferIn)
                            .Width(50).Title("Transit<br>In")
                            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                            .ClientFooterTemplate("#=kendo.format('{0:n0}',sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    });
                });
            });
        });
        columns.Group(group => group.Title("Released Quantity")
            .Columns(info =>
            {
                info.Bound(f => f.TransferOut)
                    .Width(50).Title("Transit<br>Out")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.QtyIss)
                    .Width(50).Title("Issued")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.QtyBal).Width(50).Title("Balance<br>Quantity")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    //.Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        //.Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.TransferId);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.QtyIss).Sum();
            a.Add(p => p.TransferIn).Sum();
            a.Add(p => p.TransferOut).Sum();
            a.Add(p => p.QtyBal).Sum();
        })
        .Sort(s =>
        {
            s.Add(a => a.InsertedDt);
        })
        //.ServerOperation(true)
        .Read(read => read.Action("_TransitRead", "ItemCard", new { psCardItemId = ViewData["psCardItemId"] }))
    )
    .Events(events => events
        .Change("onChangeGridTransit")
        .DataBound("onDataBoundGridTransit")
        )
    )
}


@helper RenderIssuance()
{
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemTransferIssuanceVM>()
    .Name("gridIssuance")
    .Columns(col =>
    {
        col.Bound(c => c.IssuedDate).Width(40);
        col.Bound(c => c.IssuedToDescription).Width(50);
        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .ToolBar(t =>
    {
    t.Template(@<text>
            <br /><br /><br /><br />
    </text>);
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    //.Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        //.Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItems"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Sort(s => s.Add(a => a.IssuedDate))
        .Read(read => read.Action("_IssuanceRead", "ItemCard").Data("DataGridIssuance"))
    )
    .AutoBind(false)
.Selectable(s => s.Mode(GridSelectionMode.Single))
    //.Events(e => e
    //    .Edit("onEditGridItems")
    //    .Change("onChangeGridItems")
    //    .DataBound("onDataBoundGridItems")
    //    )
    )
}


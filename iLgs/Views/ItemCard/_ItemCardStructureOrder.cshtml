        </div>
        <div class="col-md-4">
            @(Html.Kendo().NumericTextBoxFor(m => m.SetLotAmount).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { @readonly = "readonly", style = "width:100%; max-width:100%;" })

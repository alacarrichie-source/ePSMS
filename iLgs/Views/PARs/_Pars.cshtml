@(Html.Kendo().Grid<iLgs.Models.IcsParItem>()
    .Name("gridParItems_" + @ViewData["CardItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.IcsPar.RefNo).Title("PAR No.").Width(50);
        col.Bound(c => c.IcsPar.RefDate).Title("PAR Date").Width(50)
            .ClientTemplate("#= IcsPar.RefDate ? kendo.toString(kendo.parseDate(IcsPar.RefDate), 'dd/MM/yyyy') : '' #");
        col.Bound(c => c.Qty).Width(20).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.Amount).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.PropNo).Width(100);
        col.Bound(c => c.Location).Width(100);
        col.Group(group => group.Title("Received by")
                .Columns(info =>
                {
                    info.Bound(f => f.IcsPar.ReceivedBy)
                      .Width(70).Title("Name");
                    info.Bound(f => f.IcsPar.ReceivedByPosition)
                      .Width(70).Title("Poisition");
                    info.Bound(f => f.IcsPar.ReceivedDept)
                      .Width(70).Title("Department");
                    info.Bound(f => f.IcsPar.ReceivedDate).ClientTemplate("#= IcsPar.ReceivedDate ? kendo.toString(kendo.parseDate(IcsPar.ReceivedDate), 'dd/MM/yyyy') : '' #")
                      .Width(40).Title("Date");
                }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
        //col.Group(group => group.Title("Received from")
        //        .Columns(info =>
        //        {
        //            info.Bound(f => f.IcsPar.IssuedBy)
        //              .Width(70).Title("Name");
        //            info.Bound(f => f.IcsPar.IssuedByPosition)
        //              .Width(70).Title("Poisition");
        //            info.Bound(f => f.IcsPar.IssuedDept)
        //              .Width(70).Title("Department");
        //            info.Bound(f => f.IcsPar.IssuedDate).ClientTemplate("#= IcsPar.ReceivedDate ? kendo.toString(kendo.parseDate(IcsPar.ReceivedDate), 'dd/MM/yyyy') : '' #")
        //              .Width(40).Title("Date");
        //        }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        //    );
        //col.Bound(c => c.PostedBy).Width(50);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridParItems").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Template(@<text>
        @(Html.Kendo().Button().Name("btnAddParItem_" + @ViewData["CardItemId"]).Content("Generate PAR").Icon("k-icon k-i-add")
            .HtmlAttributes(new { data_CardItemId = @ViewData["CardItemId"] }).Events(events => events.Click("onGridParItemClickAdd")))
        </text>);
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ParsTemplate").Window(w => w.Width(800)))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridParItems")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.PsCardItemId).DefaultValue(@ViewData["CardItemId"]);
            model.Field(p => p.UnitCost).DefaultValue(@ViewData["UnitCost"]);
            //model.Field(p => p.IssuedToSw).DefaultValue(1);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Sort(s => s.Add(a => a.IcsPar.RefNo))
        //.Group(g => g.Add(a => a.RefType))
        .Read(read => read.Action("_ParsRead", "Pars", new { cardItemId = @ViewData["CardItemId"] }))
        //.Create(create => create.Action("_IssuanceCreate", "PoIssuance"))
        .Update(update => update.Action("_ParsUpdate", "Pars"))
        .Destroy(destroy => destroy.Action("_ParsDestroy", "Pars"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e.Edit("onEditGridParItems").Change("onChangeGridParItems").DataBound("onDataBoundGridParItems"))
)


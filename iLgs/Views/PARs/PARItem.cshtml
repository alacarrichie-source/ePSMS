<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
        items.Add()
            .Text("PARs")
            .Selected(true)
            .LoadContentFrom("_PARItem", "PARs", new { orderId = "#=OrderId#", orderItemId = "#=Id#" });            
        })
       .ToClientTemplate()
    )
</script>



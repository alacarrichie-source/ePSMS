@{
    ViewBag.Title = "Property Acknowledgement Receipt";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div id="item-list" class="col col-xs-3">
    <h3>ORDERS</h3>
    @(Html.Kendo().Grid<iLgs.Models.OrderVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(70);
        col.Bound(c => c.PoDate).Width(70);
        col.Bound(c => c.SupplierName).Width(150);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.SupplierName, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("OrdersRead", "PARs"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
        )
    )
</div>

<div id="item-details" class="row">
    <div id="item-about" class="col-xs-12">
        <div class="row">
            <div id="itemBio" class="col-xs-12 col-sm-4">
            </div>
        </div>
    </div>
    <div id="item-stat" class="col-xs-12">
        <h3 class="section-header">Order Items</h3>
        @(Html.Kendo().Grid<iLgs.Models.OrderItemVM>()
                .Name("gridItems")
                .Columns(col =>
                {
                    col.Bound(c => c.PsNo).Width(70);
                    col.Bound(c => c.Unit).Width(50);
                    col.Bound(c => c.ItemName).Width(70);
                    col.Bound(c => c.Description).Width(150);
                    col.Bound(c => c.Qty).Width(50);
                    col.Bound(c => c.UnitCost).Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" })
                        .Width(50);
                    col.Bound(c => c.Amount).Format("{0:n2}")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                        .HeaderHtmlAttributes(new { style = "text-align:right;" })
                        .Width(50);
                })
                //.ToolBar(t =>
                //{
                //    t.Create();
                //    t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintStock").HtmlAttributes(new { @class = "k-button", href = "" });
                //})
                .ToolBar(t =>
                {
                t.Template(@<text>
                        @(Html.Kendo().Button().Icon("k-icon k-i-add").Name("btnParsAdd").Content("Generate PARs").Events(e => e.Click("onClickBtnAddPar")))
                        @*@(Html.Kendo().Button().Content("Print").Icon("k-icon k-i-print").Name("btnPrint_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnPrintPar")))
                        @(Html.Kendo().Button().Content("Post").Icon("k-icon k-i-lock").Name("btnPost_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnPostPar")))
                        @(Html.Kendo().Button().Content("Unpost").Icon("k-icon k-i-unlock").Name("btnUnpost_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnUnpostPar")))*@
                    </text>);
                })
                .Pageable(pager => pager
                    .Input(false)
                    .Numeric(true)
                    .Info(true)
                    .PreviousNext(true)
                    .Refresh(true)
                    .PageSizes(true)
                    .ButtonCount(5)
                )
                .Filterable()
                .NoRecords()
                .Resizable(r => r.Columns(true))
                .Scrollable()
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .Sortable()
                .ClientDetailTemplateId("DetailTemplate")
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .PageSize(20)
                    .Events(events => events.Error("GridError"))
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                    })
                    .Read(read => read.Action("OrderItemsRead", "PARs").Data("DataGridItems"))
                )
                .Events(events => events
                    .Change("onChangeGridItems")
                    .DataBound("onDataBoundGridItems")
                )
        )
    </div>
</div>

<script type="text/x-kendo-tmpl" id="itemTemplate">
    <div class="item">
        <div class="item-wrapper">
            <dl class="item-list-details">
                <dt class="name">#:ItemName#</dt>
                <dd class="title">#:PoNo#</dd>
            </dl>
        </div>
    </div>
</script>

<script type="text/x-kendo-tmpl" id="itemBioTemplate">
    # var poDate = kendo.toString(PoDate, "yyyy-MM-dd"); #
    <div>
        <dl class="item-bio-details">
            <dt class="title">#:PoNo#</dt>
            <dd class="name">#:poDate#</dd>
            <dd class="name">#:SupplierName#</dd>
        </dl>

<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var selectedParId = null;
    var selectedParItemId = null;
    var selectedDepartment = null;
    var postedBy = null;
    var selectedParNo = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedDepartment = selectedData.Department;
        selectedItemId = null;
        selectedParId = null;
        selectedParItemId = null;

        var items = $("#grid").data("kendoGrid"),
            item = items.dataSource.getByUid(items.select().attr("data-uid")),
            gridItems = $("#gridItems").data("kendoGrid"),
            template = kendo.template($("#itemBioTemplate").html());

        $("#itemBio").html(template(item));

        gridItems.dataSource.read();
    }

    function getBio(e) {
        return e.target.find("span").text();
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    // GRID ITEMS
    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;
        selectedParId = null;
        selectedParItemId = null;
    }

    function DataGridItems() {
        return {
            poId: selectedId
        };
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }

            //var selectedRow = this.select();

            //if (selectedRow.length > 0) {
            //    // Get the data item associated with the selected row
            //    var selectedItem = this.dataItem(selectedRow);

            //    // Find the corresponding detail row
            //    var detailRow = selectedRow.next(".k-detail-row");

            //    // Expand the detail row if not already expanded
            //    if (!detailRow.hasClass("k-state-expanded")) {
            //        this.expandRow(selectedRow);
            //    }
            //}
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            //Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        //// Attach a handler to the "detailExpand" event
        //this.bind("detailExpand", function (e) {
        //    // Select the expanded master row
        //    this.select(e.masterRow);
        //});

    }

    // END GRID ITEMS

    // GRID PAR
    function GridParError(args) {
        if (args.errors) {
            var selectedGrid = $("#gridPars_" + selectedItemId).data("kendoGrid");
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }
    function onClickBtnPostPar(e) {
        e.preventDefault();
        if (postedBy) {
            alert("PAR already posted by " + postedBy);
        }
        else {
            var msg = "Post PAR Number " + selectedParNo + "?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostPAR", "PARs")',
                    data: { parId: selectedParId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record Posted...", "info");
                            $("#gridPars_" + selectedItemId).data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    }

    function onClickBtnUnpostPar(e) {
        e.preventDefault();
        var msg = "Unpost PAR Number " + selectedParNo + "?";

        if (confirm(msg)) {
            var popupNotification = $("#popupNotification").data("kendoNotification");
            $.ajax({
                type: "POST",
                url: '@Url.Action("UnpostPAR", "PARs")',
                data: { parId: selectedParId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        popupNotification.show("Record Unposted...", "info");
                        $("#gridPars_" + selectedItemId).data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    }

    function onClickBtnPrintPar(e) {
        e.preventDefault();
        var url = '@Url.Action("PARRpt", "PARs")?parNo=' + selectedParNo;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    function onRequestEndGridPars(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") { // create && update not triggered for custom pupop
                // Refresh the content of the current tab
                var tabstrip = $("#details_tabstrip_" + selectedItemId).data("kendoTabStrip");
                var currentTab = tabstrip.select();
                tabstrip.reload(currentTab);

            }
        }
    }

    function onEditGridPars(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);
        //e.model.set("OrderId", parentModel.OrderId);
        //e.model.set("OrderItemId", parentModel.Id);
    }

    function onChangeGridPars(e) {
        var selectedData = this.dataItem(this.select());
        //var grid = $("#gridPars_" + selectedItemId);

        selectedParId = selectedData.ParId;
        selectedParItemId = selectedData.ParItemId;
        postedBy = selectedData.PostedBy;
        selectedParNo = selectedData.ParNo;

        if (postedBy) {
            $("#btnUnpost_" + selectedItemId).show();
            $("#btnPost_" + selectedItemId).hide();
        } else {
            $("#btnUnpost_" + selectedItemId).hide();
            $("#btnPost_" + selectedItemId).show();
        }
    }

    function onDataBoundGridPars(e) {
        if (selectedParItemId) {
            var dataItem = this.dataSource.get(selectedParItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }

        var grid = $("#gridPars_" + selectedItemId);
        if (this.dataSource.data().length == 0) {
            $("#btnPrint_" + selectedItemId).hide();
            $("#btnPost_" + selectedItemId).hide();
            $("#btnUnpost_" + selectedItemId).hide();
        }
    }

    // Order Selection
    function onClickBtnAddPar(e) {
        e.preventDefault();
        var myTitle = "Generate PAR";
        var width = 300;
        var height = 150;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#gridPars_" + selectedItemId).data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_GeneratePAR", "PARs")',
            data: {
                orderItemId: selectedItemId                
            }
        });
        mywindow.center();
        mywindow.open();
    }

    function onClickBtnEdiPar(e) {
        e.preventDefault();
        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        parentGrid.select(parentRow);

        // the current row for this detail
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.ParItemId);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        
        ParEntry("E", dataItem.ParId, dataItem.ParItemId);
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function ParEntry(mode, parId, parItemId) {
        var myTitle = (mode == "A") ? "PAR - ADD" : "PAR - EDIT";
        var width = 800;
        var height = 420;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#gridPars_" + selectedItemId).data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_PARItemAddEdit", "PARs")',
            data: {
                orderIdx: selectedId,
                orderItemIdx: selectedItemId,
                parIdx: parId,
                parItemIdx: parItemId
            }
        });
        mywindow.center();
        mywindow.open();
    }

    // END GRID PAR


    // PAR ITEM ADD EDIT

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetAmount", "PARs")',
            data: { orderItemId: selectedItemId, qty: qty },
            success: function (result) {
                if (result.Errors) {
                    alert(result.Errors);
                }
                else {
                    $("#Amount").data("kendoNumericTextBox").value(result.Amount);
                    $("#Amount").data("kendoNumericTextBox").trigger("change");
                }
            }, error: function (req, status, errorObj) {
                alert(req.responseText);
            }
        });
    }

    function DataReceivedBy() {
        var text = $("#ReceivedBy").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#ReceivedBy").data("kendoMultiColumnComboBox").value();
        }
        return {
            department: selectedDepartment,
            text: text
        };
    }

    function onSelectReceivedBy(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#ReceivedByPosition").val(dataItem.Desc2).trigger("change");
    }

    function onSelectIssuedBy(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#IssuedByPosition").val(dataItem.Desc2).trigger("change");
    }

    // END PAR ITEM ADD EDIT
</script>



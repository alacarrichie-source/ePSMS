@model iLgs.Models.PAR_VM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)

    <fieldset>
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.ParNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.ParNo).Placeholder("(AUTO)").HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.ParNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.ParDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.ParDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ParDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.OrderId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select PO No.")
                            .DataTextField("PoNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPoNosWithoutPr", "Getters").Data("DataOrderId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PoNo").Title("PO No.").Width("30%");
                                c.Add().Template("#= kendo.toString(new Date(parseInt(PoDate.substr(6))), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectOrderId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.OrderId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PoDate).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PoDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Fund).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>
        
        <br />

        <div class="row clearfix">
            <div class="col-md-6">
                <section id="acceptance" class="card ra-section">
                    <div class="card-header">Received by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedDate, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.ReceivedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedBy, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ReceivedBy)
                                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                                        .Placeholder("Select Custodian")
                                        .DataTextField("Description")
                                        .DataValueField("Description")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetCustodians", "Getters");
                                            })
                                            .ServerFiltering(true);
                                        })
                                        .Columns(c =>
                                        {
                                            c.Add().Field("Description").Title("Name").Width("60%");
                                            c.Add().Field("Desc2").Title("Designation").Width("40%");
                                        })
                                        .Suggest(true)
                                    )
                                    @Html.ValidationMessageFor(model => model.ReceivedBy)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedByPosition, htmlAttributes: new { @class = "col-md-12" })
                                <div class="col-md-12">
                                    @(Html.Kendo().TextBoxFor(m => m.ReceivedByPosition).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-md-6">
                <section id="inspection" class="card ra-section">
                    <div class="card-header">Issued by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedDate, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedBy, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.IssuedBy)
                                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                                        .Placeholder("Select Officer")
                                        .DataTextField("Description")
                                        .DataValueField("Description")
                                        .Filter(FilterType.Contains)
                                        .DataSource(source =>
                                        {
                                            source.Read(read =>
                                            {
                                                read.Action("GetOfficers", "Getters");
                                            })
                                            .ServerFiltering(true);
                                        })
                                        .Columns(c =>
                                        {
                                            c.Add().Field("Description").Title("Name").Width("60%");
                                            c.Add().Field("Desc2").Title("Designation").Width("40%");
                                        })
                                        .Suggest(true)
                                    )
                                    @Html.ValidationMessageFor(model => model.IssuedBy)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedByPosition, htmlAttributes: new { @class = "col-md-12" })
                                <div class="col-md-12">
                                    @(Html.Kendo().TextBoxFor(m => m.IssuedByPosition).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

    </fieldset>
}



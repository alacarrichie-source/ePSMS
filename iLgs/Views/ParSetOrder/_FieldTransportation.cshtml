@model iLgs.Models.IcsParItem

@{
    var vehicle = Model.PsCardItemExtn as iLgs.Models.PsCardItemExtnVehicle;
}

<div class="row k-mb-2">
    <div class="col-md-6">
        <div class="col-md-3">
            @Html.DisplayFor(m => vehicle.YearModel, "LabelInt")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(m => vehicle.YearModel).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => vehicle.YearModel)
        </div>
    </div>
    <div class="col-md-6">
        <div class="col-md-3">
            @Html.DisplayFor(m => vehicle.NetWeight, "LabelInt")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(m => vehicle.NetWeight).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => vehicle.NetWeight)
        </div>
    </div>
</div>


@*@model iLgs.Models.ParIcsPOGroupVM*@
@{
    ViewBag.Title = "Property Acknowledgement Receipt";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}


<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("PO Year", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-2">
            @(Html.Kendo().NumericTextBox()
                .Name("forYear")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )            
        </div>
    </div>
</div>
<br />

@(Html.Kendo().PanelBar()
    .Name("panelbar")
    .ExpandMode(PanelBarExpandMode.Multiple)
    .Items(panelbar =>
    {
        panelbar.Add().Text("Purchase Orders")
            .Expanded(true)
            .Selected(true)
            .Content(@<text>
                <div class="div-render">
                    @RenderOrders()
                </div>
            </text>);
        panelbar.Add().Text("Order Items")
            .Expanded(true)
            .Content(@<text>
                <div class="div-render">
                    @RenderOrderItems()
                </div>
            </text>);        
    })
)

@helper RenderOrders()
{
    @(Html.Kendo().Grid<iLgs.Models.ParIcsPOGroupVM>()
    .Name("grid")
    .HtmlAttributes(new { style = "height: calc(25vh);" })
    .Columns(col =>
    {
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.PoDate).Width(50);
        col.Bound(c => c.AirNo).Width(50);
        col.Bound(c => c.AirDate).Width(50);
        col.Bound(c => c.Department).Width(150);
        col.Bound(c => c.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.QtyFinished).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.QtyBalance).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.AirNo, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.QtyBalance, "equals");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Resizable(r => r.Columns(true))
    .Filterable()
    .Sortable()
    .Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.QtyFinished).Sum();
            a.Add(p => p.QtyBalance).Sum();
        })
        .Sort(s => {
            s.Add(a => a.PoNo);
            //s.Add(a => a.QtyBalance).Descending();            
            })
        .Read(read => read.Action("Read", "ParSetOrder").Data("DataGrid"))
    ).AutoBind(true)
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(e => e
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
    )
}

@helper RenderOrderItems()
{
    @(Html.Kendo().Grid<iLgs.Models.ParIcsItemVm>()
                    .Name("gridItems")
                    .HtmlAttributes(new { style = "height: calc(45vh);" })
                    .Columns(col =>
                    {
                        col.Bound(c => c.ItemNo).Width(50);
                        col.Bound(c => c.Article).Width(70);
                        col.Bound(c => c.Description).Width(100).ClientTemplate("<div style='padding-left: #= Padding #px;'>" +
                                                                       "<div>" +
                                                                           "# if (IsSetLot) { #" +
                                                                               "<strong>#= kendo.htmlEncode(Description) #</strong>" +
                                                                           "# } else { #" +
                                                                               "#= kendo.htmlEncode(Description) #" +
                                                                           "# } #" +
                                                                       "</div>" +
                                                                       "<div>#= OtherDesc ? OtherDesc : '' #</div>" +
                                                                   "</div>");
                        col.Bound(c => c.Unit).Width(30);
                        col.Bound(c => c.UnitCost).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}").HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.AddCost).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}").HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.TotalCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Group(group => group.Title("Quantity")
                            .Columns(info =>
                            {
                                info.Bound(f => f.SetQty).Width(40).HtmlAttributes(new { style = "text-align:right;" })
                                    .ClientTemplate("#= IsSetLot ? kendo.toString(SetQty, 'n0') : '' #")
                                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                                    .Title("Set/Lot");
                                info.Bound(f => f.Qty).Width(40).HtmlAttributes(new { style = "text-align:right;" })
                                    .ClientTemplate("#= IsSetLot ? '' : kendo.toString(Qty, 'n0') #")
                                    .FooterHtmlAttributes(new { Style = "text-align:right;" })
                                    .Title("Individual");
                                info.Bound(f => f.TotalQty).Width(40).HtmlAttributes(new { style = "text-align:right;" })
                                    .ClientTemplate("#= IsSetLot ? '' : kendo.toString(TotalQty, 'n0') #")
                                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                    .Title("Total");
                            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
                        );
                        col.Bound(c => c.GeneratedItems).Width(40).HtmlAttributes(new { style = "text-align:right;" }).Title("Generated<br>Items")
                                .ClientTemplate("#= IsSetLot ? '' : kendo.toString(GeneratedItems, 'n0') #")
                                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                                .HeaderHtmlAttributes(new { style = "text-align:right;" });
                        col.Bound(c => c.IsForICS).Width(50).EditorTemplateName("_IsForICSTemplate")
                            .ClientTemplate("#= IsForICS ? 'Y' : 'N' #")
                            .Title("For ICS")
                            .HtmlAttributes(new { style = "text-align:center;" })
                            .HeaderHtmlAttributes(new { style = "text-align:center;" });
                        // posting is per par number
                        //col.Bound(c => c.ParPostedBy).Width(50);
                        //col.Bound(c => c.ParPostedDt).Width(50);
                        //col.Bound(c => c.SetLotNo).Width(50);
                        //col.Bound(c => c.SetLotDesc).Width(50);
                        col.Command(command =>
                        {
                            command.Edit().Visible("IsNoGenerated");
                            //command.Custom("Uploads").Click("onClickUploads");
                            command.Custom("PARs").IconClass("k-icon k-i-document-manager").Click("onClickSetPars").Visible("IsNotSet");
                        }).Width(100);
                    })
                    .ToolBar(t =>
                    {
                    t.Template(@<text>
                            @(Html.Kendo().Button().Icon("k-icon k-i-add").Name("btnParsAddItem").Content("Generate PAR").Events(e => e.Click("onClickBtnAddPar")))
                            @*@(Html.Kendo().Button().Content("Post").Icon("k-icon k-i-lock").Name("btnPost_").Events(e => e.Click("onClickBtnPostPar")))
                            @(Html.Kendo().Button().Content("Unpost").Icon("k-icon k-i-unlock").Name("btnUnpost_").Events(e => e.Click("onClickBtnUnpostPar")))*@                            
                        </text>);
                    })
                    .Pageable(pager => pager
                        .Input(false)
                        .Numeric(true)
                        .Info(true)
                        .PreviousNext(true)
                        .Refresh(true)
                        .PageSizes(true)
                        .ButtonCount(5)
                    )
                    .Resizable(r => r.Columns(true))
                    .Sortable()
                    .NoRecords()
                    .Scrollable()
                    //.ClientDetailTemplateId("UploadedFiles")
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItems"))
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                            model.Field(p => p.ItemNo).Editable(false);
                            model.Field(p => p.SetQty).Editable(false);
                            model.Field(p => p.Qty).Editable(false);
                            model.Field(p => p.TotalQty).Editable(false);
                            model.Field(p => p.Unit).Editable(false);
                            model.Field(p => p.UnitCost).Editable(false);
                            model.Field(p => p.AddCost).Editable(false);
                            model.Field(p => p.TotalCost).Editable(false);
                            model.Field(p => p.Article).Editable(false);
                            model.Field(p => p.Description).Editable(false);
                            model.Field(p => p.GeneratedItems).Editable(false);
                            model.Field(p => p.ParPostedBy).Editable(false);
                            model.Field(p => p.ParPostedDt).Editable(false);
                            //model.Field(p => p.SetLotNo).Editable(false);
                            //model.Field(p => p.SetLotDesc).Editable(false);
                        })
                        .Aggregates(a =>
                        {
                            a.Add(p => p.SetQty).Sum();
                            a.Add(p => p.Qty).Sum();
                            a.Add(p => p.TotalQty).Sum();
                            a.Add(p => p.TotalCost).Sum();
                            a.Add(p => p.GeneratedItems).Sum();
                        })
                        //.Sort(s => s.Add(a => a.InsertedDt))
                        .Read(read => read.Action("_PoItemsRead", "ParSetOrder").Data("DataGridItems"))
                        .Update(update => update.Action("_PoItemsUpdate", "ParSetOrder"))
                    ).AutoBind(false)
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(e => e
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
    )
}


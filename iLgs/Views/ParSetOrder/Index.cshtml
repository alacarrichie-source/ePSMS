                model.Field(p => p.GTotalCost).Editable(false);
                model.Field(p => p.Article).Editable(false);
                model.Field(p => p.Description).Editable(false);
                model.Field(p => p.GeneratedItems).Editable(false);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.TotalQty).Sum();
                a.Add(p => p.GTotalCost).Sum();
                a.Add(p => p.GeneratedItems).Sum();
            })
            .Sort(s => s.Add(a => a.InsertedDt))
            .Read(read => read.Action("_PoItemSetDescriptionItemRead", "ParSetOrder", new { unitGroupDescriptionId = "#=Id#" }))
        //.Update(update => update.Action("_PoItemsUpdate", "ParSetOrder"))        

        ).Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(e => e
            //.Edit("onEditGridItemSetDescriptionItem")
            .Change("onChangeGridItemSetDescriptionItem")
            .DataBound("onDataBoundGridItemSetDescriptionItem")
            .DetailExpand("onDetailExpandGridItemSetDescriptionItem")
            .DetailCollapse("onDetailCollapseGridItemSetDescriptionItem")
        )
        .ToClientTemplate()
    )
</script>


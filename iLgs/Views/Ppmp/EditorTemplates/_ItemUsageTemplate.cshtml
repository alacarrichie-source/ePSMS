@model iLgs.Models.PPMPItemUsageVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PpmpItemId)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="col-md-12">
            <div class="form-group">
                @Html.DisplayFor(m => m.Type, "Label")
                @(Html.Kendo().TextBoxFor(m => m.Type)
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Type)
            </div>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="col-md-12">
            <div class="form-group">
                @Html.DisplayFor(m => m.Reference, "Label")
                @(Html.Kendo().TextBoxFor(m => m.Reference)
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Reference)
            </div>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="col-md-12">
            <div class="form-group">
                @Html.DisplayFor(m => m.Qty, "Label")
                @(Html.Kendo().TextBoxFor(m => m.Qty)
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Qty)
            </div>
        </div>
    </div>
}









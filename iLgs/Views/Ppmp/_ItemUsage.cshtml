
@(Html.Kendo().Grid<iLgs.Models.PPMPItemUsageVM>()
    .Name("gridItemUsages_" + @ViewData["ppmpItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.Type).Width(50);
        col.Bound(c => c.Reference).Width(100);
        col.Bound(c => c.Qty).Width(50)
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.InsertedBy).Width(50);
        col.Bound(c => c.InsertedDt).Width(50);
        col.Bound(c => c.UpdatedBy).Width(50);
        col.Bound(c => c.UpdatedDt).Width(50);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditItem").Visible("IsNotSet");
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridItem").SendDataKeys(true).Visible("IsNotSetItem");
        }).Width(70);
    })
    .ToolBar(t =>
    {
        t.Create();        
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ItemUsageTemplate").Window(w => w.Width(800).Title("Item Usage")))
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(180))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridItemUsageError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("_ItemUsageRead", "Ppmp", new { ppmpItemId = @ViewData["ppmpItemId"] }))
        .Create(create => create.Action("_ItemUsageCreate", "Ppmp"))
        .Update(update => update.Action("_ItemUsageUpdate", "Ppmp"))
        .Destroy(destroy => destroy.Action("_ItemUsageDestroy", "Ppmp"))
    )
    .Events(events => events
        .Change("onChangeGridItemUsages")
        .Edit("onEditGridItemUsages")
        .DataBound("onDataBoundGridItemUsages")
    )
    .AutoBind(true)
)

@using Kendo.Mvc.UI

@{
    ViewBag.Title = "PPMP";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<link href="@Url.Content("~/Content/ppmp-index.css")?v=20260916_1" rel="stylesheet" type="text/css" />

<div class="ppmp-workspace">
    <!-- PAGE HEADER -->
    <div class="ppmp-header">
        <div class="ppmp-title-group">
            <h2>
                <span class="ppmp-title-icon"><span class="k-icon k-i-folder"></span></span>
                PPMP
            </h2>
            <div class="ppmp-subtitle">Project Procurement Management Plan</div>
            <p class="ppmp-desc">Manage annual PPMP schedules, uploaded items, and utilization.</p>
        </div>
        <div class="ppmp-header-actions">
            <button type="button" id="btnNewPpmp" class="ppmp-btn-primary" title="Add a new PPMP schedule">
                <span class="k-icon k-i-plus"></span> New PPMP
            </button>
        </div>
    </div>

    <!-- SECTION 1: PPMP SCHEDULES -->
    <div class="ppmp-card">
        <div class="ppmp-card-header">
            <h3 class="ppmp-card-title">
                <span class="k-icon k-i-calendar"></span> PPMP Schedules
            </h3>
        </div>
        <div class="ppmp-card-body">
            @RenderMain()
        </div>
    </div>

    <!-- SECTION 2: SELECTED PPMP CONTEXT & SUMMARY -->
    <div id="ppmpContextPanel" class="ppmp-context-panel">
        <div class="ppmp-context-header">
            <div class="ppmp-context-title-wrap">
                <div class="ppmp-context-title-row">
                    <h3 class="ppmp-context-title" id="ctxTitle">Select a PPMP Schedule</h3>
                    <span id="ctxStatusBadge" class="ppmp-badge badge-draft" style="display: none;">DRAFT</span>
                </div>
                <div class="ppmp-context-dept" id="ctxDepartment">Select a schedule from above to review items and utilization.</div>
            </div>
            <div class="ppmp-context-actions" id="ctxActions" style="display: none;">
                <button type="button" id="btnContextPost" class="btn-ppmp-action btn-ppmp-post" style="display: none;" title="Post this PPMP schedule">
                    <span class="k-icon k-i-lock"></span> Post PPMP
                </button>
                <button type="button" id="btnContextUnpost" class="btn-ppmp-action btn-ppmp-unpost" style="display: none;" title="Unpost this PPMP schedule">
                    <span class="k-icon k-i-unlock"></span> Unpost PPMP
                </button>
            </div>
        </div>

        <div class="ppmp-context-meta" id="ctxMeta" style="display: none;">
            <div class="ppmp-meta-item">
                <span class="ppmp-meta-label">Created by:</span>
                <span class="ppmp-meta-value" id="ctxInsertedBy">&mdash;</span>
            </div>
            <div class="ppmp-meta-item">
                <span class="ppmp-meta-label">Created:</span>
                <span class="ppmp-meta-value" id="ctxInsertedDt">&mdash;</span>
            </div>
            <div class="ppmp-meta-item" id="ctxPostedByBlock" style="display: none;">
                <span class="ppmp-meta-label">Posted by:</span>
                <span class="ppmp-meta-value" id="ctxPostedBy">&mdash;</span>
            </div>
            <div class="ppmp-meta-item" id="ctxPostedDtBlock" style="display: none;">
                <span class="ppmp-meta-label">Posted:</span>
                <span class="ppmp-meta-value" id="ctxPostedDt">&mdash;</span>
            </div>
        </div>

        <!-- Compact Summary Metrics -->
        <div class="ppmp-metrics-grid" id="ctxMetrics">
            <div class="ppmp-metric-card" title="Total procurement items in this PPMP">
                <div class="ppmp-metric-label">PPMP Items</div>
                <div class="ppmp-metric-val" id="metricItemsCount">0</div>
            </div>
            <div class="ppmp-metric-card" title="Sum of planned quantities">
                <div class="ppmp-metric-label">Total Quantity</div>
                <div class="ppmp-metric-val" id="metricTotalQty">0</div>
            </div>
            <div class="ppmp-metric-card" title="Total estimated budget for all items">
                <div class="ppmp-metric-label">Estimated Budget</div>
                <div class="ppmp-metric-val val-budget" id="metricEstBudget">0.00</div>
            </div>
            <div class="ppmp-metric-card" title="Total quantity utilized so far">
                <div class="ppmp-metric-label">Quantity Used</div>
                <div class="ppmp-metric-val val-used" id="metricQtyUsed">0</div>
            </div>
            <div class="ppmp-metric-card" title="Remaining quantity available for procurement">
                <div class="ppmp-metric-label">Quantity Remaining</div>
                <div class="ppmp-metric-val val-remaining" id="metricQtyRemaining">0</div>
            </div>
        </div>
    </div>

    <!-- SECTION 3: PPMP ITEMS -->
    <div class="ppmp-card">
        <div class="ppmp-card-header">
            <div>
                <h3 class="ppmp-card-title">
                    <span class="k-icon k-i-list-unordered"></span> PPMP Items
                </h3>
                <span class="ppmp-card-sub">Review procurement items, monthly schedules, and utilization for the selected PPMP.</span>
            </div>
        </div>
        <div class="ppmp-card-body">
            <!-- Read-Only Banner for Posted PPMP -->
            <div id="ppmpPostedBanner" class="ppmp-posted-banner" style="display: none;">
                <span class="k-icon k-i-lock"></span> This PPMP is posted. Item modifications and uploads are read-only.
            </div>

            @RenderItems()
        </div>
    </div>
</div>

@helper RenderMain()
{
    @(Html.Kendo().Grid<iLgs.Models.PPMPVM>()
        .Name("grid")
        .HtmlAttributes(new { style = "height: 230px;" })
        .Columns(col =>
        {
            col.Bound(c => c.ForYear).Title("Year").Width(80);
            col.Bound(c => c.Department).Title("Department");
            col.Bound(c => c.PostedBy).Title("Status").Width(110)
                .ClientTemplate("#= renderPpmpScheduleStatus(data) #");
            col.Bound(c => c.InsertedBy).Title("Created By").Width(130);
            col.Bound(c => c.InsertedDt).Title("Created").Width(110)
                .Format("{0:MM/dd/yyyy}");
            col.Command(command =>
            {
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true).Visible("IsNotPostedMain");
            }).Title("Actions").Width(90);
        })
        .ToolBar(t =>
        {
            t.Search();
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PpmpTemplate").Window(w => w.Width("50%").Title("PPMP Setup")))
        .Search(s =>
        {
            s.Field(o => o.ForYear, "equals");
            s.Field(o => o.Department, "contains");
            s.Field(o => o.PostedBy, "contains");
            s.Field(o => o.InsertedBy, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(new[] { 10, 20, 50 })
            .ButtonCount(5)
        )
        .Resizable(r => r.Columns(true))
        .Filterable()
        .Sortable()
        .Scrollable()
        .NoRecords(n => n.Template("<div class='ppmp-empty-state'><span class='k-icon k-i-info'></span><p>No PPMP schedules found.</p><span class='ppmp-empty-sub'>Create a PPMP schedule to begin uploading procurement items.</span></div>"))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            })
            .Read(read => read.Action("Read", "Ppmp"))
            .Create(create => create.Action("Create", "Ppmp"))
            .Destroy(destroy => destroy.Action("Destroy", "Ppmp"))
        ).AutoBind(true)
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(e => e
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        )
    )
}

@helper RenderItems()
{
    @(Html.Kendo().Grid<iLgs.Models.PPMPItemVM>()
        .Name("gridItems")
        .HtmlAttributes(new { style = "min-height: 420px; height: calc(100vh - 480px);" })
        .Columns(col =>
        {
            // Group 1: ITEM INFORMATION
            col.Group(g => g.Title("Item Information").Columns(info =>
            {
                info.Bound(c => c.Code).Width(95).Title("Code").Filterable(true);
                info.Bound(c => c.Description).Width(240).Title("Description").Filterable(true)
                    .ClientTemplate("#= renderItemDescription(data) #");
                info.Bound(c => c.Qty).Width(80).Title("Qty")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(c => c.Unit).Width(70).Title("Unit");
                info.Bound(c => c.EstBudget).Width(120).Title("Est Budget")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(c => c.ProcMode).Width(130).Title("Proc Mode");
            }).HeaderHtmlAttributes(new { style = "text-align:center;" }));

            // Group 2: PROCUREMENT SCHEDULE
            col.Group(g => g.Title("Procurement Schedule").Columns(sched =>
            {
                sched.Bound(c => c.Jan).Width(60).Filterable(false).Title("Jan")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Feb).Width(60).Filterable(false).Title("Feb")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Mar).Width(60).Filterable(false).Title("Mar")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Apr).Width(60).Filterable(false).Title("Apr")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.May).Width(60).Filterable(false).Title("May")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Jun).Width(60).Filterable(false).Title("Jun")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Jul).Width(60).Filterable(false).Title("Jul")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Aug).Width(60).Filterable(false).Title("Aug")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Sep).Width(60).Filterable(false).Title("Sep")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Oct).Width(60).Filterable(false).Title("Oct")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Nov).Width(60).Filterable(false).Title("Nov")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                sched.Bound(c => c.Dec).Width(60).Filterable(false).Title("Dec")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { style = "text-align:center;" }));

            // Group 3: UTILIZATION
            col.Group(g => g.Title("Utilization").Columns(util =>
            {
                util.Bound(c => c.UnitCost).Width(95).Title("Unit Cost")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                util.Bound(c => c.QtyUsed).Width(85).Title("Qty Used")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                util.Bound(c => c.QtyBal).Width(90).Title("Qty Balance")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { style = "text-align:center;" }));

            // Group 4: ACTIONS
            col.Group(g => g.Title("Actions").Columns(act =>
            {
                act.Command(command =>
                {
                    command.Custom("Usage").IconClass("k-icon k-i-chart-line").Click("onGridUsageClick").SendDataKeys(true).Visible("IsNotMain");
                }).Width(80);
            }).HeaderHtmlAttributes(new { style = "text-align:center;" }));
        })
        .ToolBar(t =>
        {
            t.Search();
            t.Custom().Text("Upload Records").IconClass("k-icon k-i-upload").Name("btnUpload").HtmlAttributes(new { @class = "k-button", href = "javascript:void(0);" });
            if ((bool)ViewBag.IsAdmin)
            {
                t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExportGrid").HtmlAttributes(new { @class = "k-button", href = "javascript:void(0);", id = "exportGrid" });
            }
        })
        .Excel(excel => excel
            .FileName("Ppmp.xlsx")
            .Filterable(true)
            .AllPages(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "Ppmp"))
        )
        .Search(s =>
        {
            s.Field(o => o.Code, "contains");
            s.Field(o => o.Description, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(new[] { 25, 50, 100, 200 })
            .ButtonCount(5)
        )
        .Resizable(r => r.Columns(true))
        //.Filterable()
        .Sortable()
        .Scrollable()
        //.Groupable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .PersistSelection(true)
        .NoRecords(n => n.Template("<div class='ppmp-empty-state'><span class='k-icon k-i-search'></span><p>No PPMP items found.</p><span class='ppmp-empty-sub'>Select a PPMP schedule or upload items to view procurement records.</span></div>"))
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(100)
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.EstBudget).Sum();
                a.Add(p => p.QtyBal).Sum();
                a.Add(p => p.QtyUsed).Sum();
            })
            .Sort(s => { s.Add(a => a.RecNo); })
            .Read(read => read.Action("ItemRead", "Ppmp").Data("DataGridItems"))
        ).AutoBind(false)
        .Events(e => e
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
    )
}


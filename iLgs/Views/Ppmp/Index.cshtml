<script type="text/javascript">
    // Global selection state
    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var trackingId = null;
    var postedBy = null;

    // Excel Export
    $("#exportGrid").click(function (e) {
        e.preventDefault();
        var grid = $("#gridItems").data("kendoGrid");
        if (grid) {
            grid.saveAsExcel();
        }
    });

    // New PPMP button handler
    $("#btnNewPpmp").click(function (e) {
        e.preventDefault();
        var grid = $("#grid").data("kendoGrid");
        if (grid) {
            grid.addRow();
        }
    });

    // Visibility predicates
    function IsNotPostedMain(dataItem) {
        if (!dataItem) return true;
        return !dataItem.PostedBy;
    }

    function IsNotPosted(dataItem) {
        return !postedBy && (!dataItem || dataItem.Claimed !== "Y");
    }

    function IsNotMain(dataItem) {
        if (!dataItem) return false;
        return dataItem.Type === "S";
    }

    // Client templates
    function renderPpmpScheduleStatus(dataItem) {
        if (!dataItem) return "";
        if (dataItem.PostedBy) {
            return '<span class="ppmp-badge badge-posted"><span class="k-icon k-i-check"></span> POSTED</span>';
        }
        return '<span class="ppmp-badge badge-draft">DRAFT</span>';
    }

    function renderItemDescription(dataItem) {
        if (!dataItem) return "";
        var desc = kendo.htmlEncode(dataItem.Description || "");
        if (dataItem.Type === "M") {
            return '<span class="ppmp-tag-main">GROUP</span>' + desc;
        }
        return '<span class="cell-desc" style="padding-left:14px;">' + desc + '</span>';
    }

    // Selected PPMP Context Refresh
    function refreshSelectedPpmpContext(dataItem) {
        if (!dataItem || !dataItem.Id) {
            selectedId = null;
            trackingId = null;
            postedBy = null;

            $("#ctxTitle").text("Select a PPMP Schedule");
            $("#ctxStatusBadge").hide();
            $("#ctxDepartment").text("Select a schedule from above to review items and utilization.");
            $("#ctxActions").hide();
            $("#ctxMeta").hide();
            $("#ppmpPostedBanner").hide();
            $(".k-grid-btnUpload").hide();

            $("#metricItemsCount").text("0");
            $("#metricTotalQty").text("0");
            $("#metricEstBudget").text("0.00");
            $("#metricQtyUsed").text("0");
            $("#metricQtyRemaining").text("0");
            return;
        }

        selectedId = dataItem.Id;
        trackingId = selectedId;
        postedBy = dataItem.PostedBy || null;

        var yearText = dataItem.ForYear ? kendo.htmlEncode(dataItem.ForYear.toString()) + " PPMP" : "PPMP";
        $("#ctxTitle").text(yearText);
        $("#ctxDepartment").text(dataItem.Department || "No department specified");

        var $badge = $("#ctxStatusBadge");
        if (postedBy) {
            $badge.attr("class", "ppmp-badge badge-posted").html('<span class="k-icon k-i-check"></span> POSTED').show();
        } else {
            $badge.attr("class", "ppmp-badge badge-draft").text("DRAFT").show();
        }

        $("#ctxInsertedBy").text(dataItem.InsertedBy || "--");
        if (dataItem.InsertedDt) {
            var dt = new Date(dataItem.InsertedDt);
            $("#ctxInsertedDt").text(kendo.toString(dt, "MM/dd/yyyy hh:mm tt") || "--");
        } else {
            $("#ctxInsertedDt").text("--");
        }

        if (postedBy) {
            $("#ctxPostedBy").text(dataItem.PostedBy);
            if (dataItem.PostedDt) {
                var pdt = new Date(dataItem.PostedDt);
                $("#ctxPostedDt").text(kendo.toString(pdt, "MM/dd/yyyy hh:mm tt") || "--");
            } else {
                $("#ctxPostedDt").text("--");
            }
            $("#ctxPostedByBlock").show();
            $("#ctxPostedDtBlock").show();
        } else {
            $("#ctxPostedByBlock").hide();
            $("#ctxPostedDtBlock").hide();
        }
        $("#ctxMeta").show();

        refreshPpmpActionState();
    }

    // Refresh Action State (Post, Unpost, Upload button, Read-Only Banner)
    function refreshPpmpActionState() {
        if (!selectedId) {
            $("#ctxActions").hide();
            $("#btnContextPost").hide();
            $("#btnContextUnpost").hide();
            $("#ppmpPostedBanner").hide();
            $(".k-grid-btnUpload").hide();
            return;
        }

        $("#ctxActions").show();
        if (postedBy) {
            $("#btnContextPost").hide();
            $("#btnContextUnpost").show();
            $("#ppmpPostedBanner").show();
            $(".k-grid-btnUpload").hide();
        } else {
            $("#btnContextPost").show();
            $("#btnContextUnpost").hide();
            $("#ppmpPostedBanner").hide();
            $(".k-grid-btnUpload").show();
        }
    }

    // Update Live Summary Metrics from gridItems DataSource
    function updateItemsSummaryMetrics() {
        var grid = $("#gridItems").data("kendoGrid");
        if (!grid) return;
        var ds = grid.dataSource;
        var totalItems = ds.total();
        var aggregates = ds.aggregates() || {};

        var totalQty = 0;
        var estBudget = 0;
        var qtyUsed = 0;
        var qtyRem = 0;

        if (aggregates.Qty && aggregates.Qty.sum != null) {
            totalQty = aggregates.Qty.sum;
        }
        if (aggregates.EstBudget && aggregates.EstBudget.sum != null) {
            estBudget = aggregates.EstBudget.sum;
        }
        if (aggregates.QtyUsed && aggregates.QtyUsed.sum != null) {
            qtyUsed = aggregates.QtyUsed.sum;
        }
        if (aggregates.QtyBal && aggregates.QtyBal.sum != null) {
            qtyRem = aggregates.QtyBal.sum;
        }

        $("#metricItemsCount").text(kendo.toString(totalItems, "n0") || "0");
        $("#metricTotalQty").text(kendo.toString(totalQty, "n0") || "0");
        $("#metricEstBudget").text(kendo.toString(estBudget, "n2") || "0.00");
        $("#metricQtyUsed").text(kendo.toString(qtyUsed, "n0") || "0");
        $("#metricQtyRemaining").text(kendo.toString(qtyRem, "n0") || "0");
    }

    // Schedule Grid Events
    function onChangeGrid(e) {
        var grid = this;
        var selectedRow = grid.select();
        if (selectedRow.length > 0) {
            var selectedData = grid.dataItem(selectedRow);
            if (selectedData) {
                refreshSelectedPpmpContext(selectedData);
                $("#gridItems").data("kendoGrid").dataSource.read();
                return;
            }
        }
        refreshSelectedPpmpContext(null);
    }

    function onDataBoundGrid(e) {
        var grid = this;
        var items = grid.dataSource.view();
        if (!items || items.length === 0) {
            refreshSelectedPpmpContext(null);
            return;
        }

        if (selectedId) {
            var dataItem = grid.dataSource.get(selectedId);
            if (dataItem) {
                var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                if (row.length > 0) {
                    grid.select(row);
                    refreshSelectedPpmpContext(dataItem);
                    return;
                }
            }
        }

        // Auto-select first row
        var firstRow = grid.tbody.find("tr:first");
        if (firstRow.length > 0) {
            var firstItem = grid.dataItem(firstRow);
            grid.select(firstRow);
            refreshSelectedPpmpContext(firstItem);
            $("#gridItems").data("kendoGrid").dataSource.read();
        } else {
            refreshSelectedPpmpContext(null);
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            if (rowitem) {
                selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            }
        }
        trackingId = selectedId;
    }

    // Consolidated Delete Schedule Handler
    function onGridDeleteClick(e) {
        e.preventDefault();
        var grid = $(e.currentTarget).closest(".k-grid").data("kendoGrid") || $("#grid").data("kendoGrid");
        if (!grid) return;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = grid.dataItem(tr);
        if (!dataItem) return;

        if (dataItem.PostedBy) {
            alert("Posted PPMP schedules cannot be deleted.");
            return;
        }

        var yearText = dataItem.ForYear ? dataItem.ForYear + " " : "";
        var deptText = dataItem.Department ? "for " + dataItem.Department : "";
        var msg = "Are you sure you want to delete the PPMP schedule " + yearText + deptText + "?";

        if (confirm(msg)) {
            grid.select(tr);
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    // Post PPMP Handler
    $("#btnContextPost").click(function (e) {
        e.preventDefault();
        if (!selectedId) {
            alert("Please select a PPMP schedule first.");
            return;
        }
        if (postedBy) {
            alert("Request already posted by " + postedBy);
            return;
        }

        var msg = "Post the selected PPMP schedule? Once posted, item uploads and modifications will be read-only.";
        if (confirm(msg)) {
            var $btn = $(this);
            $btn.prop("disabled", true).addClass("k-state-disabled");

            $.ajax({
                type: "POST",
                url: '@Url.Action("Post", "Ppmp")',
                data: { ppmpId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    $btn.prop("disabled", false).removeClass("k-state-disabled");
                    if (!result.Errors || result.Errors === "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        var errMsg = $.isArray(result.Errors) ? result.Errors.join("\n") : result.Errors;
                        alert(errMsg);
                    }
                },
                error: function (req, status, errorObj) {
                    window.kendo.ui.progress($(document.body), false);
                    $btn.prop("disabled", false).removeClass("k-state-disabled");
                    alert(req.responseText || "An error occurred while posting.");
                }
            });
        }
    });

    // Unpost PPMP Handler
    $("#btnContextUnpost").click(function (e) {
        e.preventDefault();
        if (!selectedId) {
            alert("Please select a PPMP schedule first.");
            return;
        }

        var msg = "Unpost the selected PPMP schedule? Item uploads and modifications will be re-enabled.";
        if (confirm(msg)) {
            var $btn = $(this);
            $btn.prop("disabled", true).addClass("k-state-disabled");

            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "Ppmp")',
                data: { ppmpId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    $btn.prop("disabled", false).removeClass("k-state-disabled");
                    if (!result.Errors || result.Errors === "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        var errMsg = $.isArray(result.Errors) ? result.Errors.join("\n") : result.Errors;
                        alert(errMsg);
                    }
                },
                error: function (req, status, errorObj) {
                    window.kendo.ui.progress($(document.body), false);
                    $btn.prop("disabled", false).removeClass("k-state-disabled");
                    alert(req.responseText || "An error occurred while unposting.");
                }
            });
        }
    });

    // Grid Items Data Parameters
    function DataGridItems() {
        return {
            ppmpId: selectedId
        };
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        if (selectedData) {
            selectedItemId = selectedData.Id;
        }
    }

    function onDataBoundGridItems(e) {
        var grid = this;

        if (selectedItemId) {
            var dataItem = grid.dataSource.get(selectedItemId);
            if (dataItem) {
                var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                if (row.length > 0) {
                    grid.select(row);
                }
            }
        }

        // Apply hierarchy styling and usage action visibility
        grid.tbody.find(">tr").each(function () {
            var dataItem = grid.dataItem(this);
            if (dataItem) {
                if (dataItem.Type === "M") {
                    $(this).addClass("ppmp-row-main");
                    $(this).find(".k-grid-Usage").hide();
                } else {
                    $(this).addClass("ppmp-row-detail");
                }
            }
        });

        refreshPpmpActionState();
        updateItemsSummaryMetrics();
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (!e.model.isNew()) {
            selectedItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedItemId);
            if (rowitem) {
                selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            }
        }
    }

    // Usage Click Handler
    function onGridUsageClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        if (!dataItem) return;

        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        if (rowitem) {
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
        selectedItemId = dataItem.Id;

        var myTitle = "Item Usage";
        var width = "70%";

        $("#windowcontainer").empty().append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#gridItems").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_ItemUsage", "Ppmp")',
            data: {
                ppmpItemId: selectedItemId
            },
            complete: function () {
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    // Upload Records Click Handler (delegated)
    $(document).on("click", ".k-grid-btnUpload", function (e) {
        e.preventDefault();
        if (!selectedId) {
            alert("Please select a PPMP schedule before uploading records.");
            return;
        }
        if (postedBy) {
            alert("This PPMP is posted. Item uploads are disabled.");
            return;
        }

        var myTitle = "Upload Records";
        var width = 400;

        $("#windowcontainer").empty().append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#gridItems").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_UploadRecords", "Ppmp")',
            data: {
                ppmpId: selectedId
            },
            complete: function () {
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    });

    function onUpload(e) {
        var formArray = $("#form").serializeArray();
        var data = {};
        $.each(formArray, function (i, field) {
            data[field.name] = field.value;
        });
        e.data = data;
    }

    function onUploadSuccess(e) {
        $("#gridItems").data("kendoGrid").dataSource.read();
    }

    function onUploadError(e) {
        var err = e.XMLHttpRequest.responseText;
        alert(err);
    }

    // PPMP Template Department selection
    function onSelectDepartment(e) {
        var dataItem = this.dataItem(e.item.index());
        if (dataItem) {
            $("#DeptId").val(dataItem.Id).trigger("change");
        }
    }

    // Grid Item Usage
    var selectedItemUsageId = null;
    function onChangeGridItemUsages(e) {
        var selectedData = this.dataItem(this.select());
        if (selectedData) {
            selectedItemUsageId = selectedData.Id;
        }
    }

    function onDataBoundGridItemUsages(e) {
        var grid = this;
        if (selectedItemUsageId) {
            var dataItem = grid.dataSource.get(selectedItemUsageId);
            if (dataItem) {
                grid.select($('[data-uid=' + dataItem.uid + ']'));
            }
        }
    }

    function onEditGridItemUsages(e) {
        e.preventDefault();
        var selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedItemUsageId = null;
            e.model.set("PpmpItemId", selectedItemId);
        } else {
            selectedItemUsageId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedItemUsageId);
            if (rowitem) {
                selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            }
        }
    }

    // Error & Notification handlers
    function onShowNotification(e) {
        if (e.sender.getNotifications().length === 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName === "DeleteError" || propertyName === "AddError" || propertyName === "UpdateError" || propertyName === "AccessError") {
                    alert(this.errors);
                    validationError = false;
                    if (selectedGrid && selectedGrid.dataSource) {
                        selectedGrid.dataSource.read();
                    }
                }
            });
            if (validationError && selectedGrid && selectedGrid.editable) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');

                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    $(document).on("input", ".uppercase", function () {
        this.value = this.value.toUpperCase();
    });

    function GridItemUsageError(args) {
        if (!args || !args.errors) {
            return;
        }

        var grid = null;

        if (selectedItemId) {
            grid = $("#gridItemUsages_" + selectedItemId).data("kendoGrid");
        }

        var hasStandardError = false;
        var message = "";

        $.each(args.errors, function (propertyName, value) {
            if (!value || !value.errors) {
                return;
            }

            if (propertyName === "DeleteError" ||
                propertyName === "AddError" ||
                propertyName === "UpdateError" ||
                propertyName === "AccessError") {

                hasStandardError = true;

                $.each(value.errors, function () {
                    message += this + "\n";
                });
            }
        });

        if (hasStandardError) {
            if (message) {
                alert(message);
            }

            if (grid) {
                grid.dataSource.read();
            }

            return;
        }

        /*
         * Validation errors normally belong to the popup editor.
         * Only attempt to render them when the grid and editable
         * popup actually exist.
         */
        if (!grid || !grid.editable || !grid.editable.element) {
            message = "";

            $.each(args.errors, function (propertyName, value) {
                if (!value || !value.errors) {
                    return;
                }

                $.each(value.errors, function () {
                    message += (propertyName ? propertyName + ": " : "") +
                        this + "\n";
                });
            });

            if (message) {
                alert(message);
            }

            return;
        }

        var validationTemplateElement = $("#validationMessageTemplate");

        if (!validationTemplateElement.length) {
            return;
        }

        var validationTemplate = kendo.template(
            validationTemplateElement.html()
        );

        grid.one("dataBinding", function (e) {
            e.preventDefault();

            if (!grid.editable ||
                !grid.editable.element ||
                !grid.editable.element.length) {
                return;
            }

            var errors = grid.editable.element.find(".errors");

            if (!errors.length) {
                return;
            }

            errors.empty();

            $.each(args.errors, function (propertyName, value) {
                if (!value || !value.errors) {
                    return;
                }

                var renderedTemplate = validationTemplate({
                    field: propertyName,
                    messages: value.errors
                });

                errors.append(renderedTemplate);
            });
        });
    }
</script>

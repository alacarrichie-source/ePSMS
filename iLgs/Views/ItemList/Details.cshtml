                            <div class="model-data-row">
                                <span class="title">Description</span>
                                <span class="value model-description">@Model.Description</span>
                            </div>
                        }
                    }
                </div>
                @*<div class="model-data-right-container">
                    @{
                        if (Model.DiscountPct != 0)
                        {

                        }
                        else
                        {
                            <div class="price">$@Model.ListPrice.ToString("N2")</div>
                        }
                    }
                    <div class="buttons-container">
                        @(Html.Kendo().Button()
                            .Name("addToCartButton_" + @Model.Id)

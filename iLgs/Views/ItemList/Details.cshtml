            </div>
            <hr class="splitter1">
            <div class="model-data">
                <div class="model-data-left-container">
                    <div class="model-data-row">
                        <span class="title">Item Name</span>
                        <span class="value">@Model.Description</span>
                    </div>
                    <div class="model-data-row">
                        <span class="title">Item Code</span>
                        <span class="value">@Model.Code</span>
                    </div>
                    @*@{
                        if (Model.Size != null)
                        {

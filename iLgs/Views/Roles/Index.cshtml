    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedRoleId = null;
    var selecteUserInRoleId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedRoleId = selectedData.Id;
        selectedUserInRoleId = null;
        $("#gridUserInRole").data("kendoGrid").dataSource.read();
    }


    function onDataBoundGrid(e) {
        if (selectedRoleId) {
            var dataItem = this.dataSource.get(selectedRoleId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            //e.model.set("SbuccType", $("#sbuccType").val());
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedRoleId = null;
        } else {
            selectedRoleId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedRoleId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // User In Role

    function UserInRoleData() {
        return {
            roleId: selectedRoleId
        };
    }

    function onChangeGridUserInRole(e) {
        var selectedData = this.dataItem(this.select());
        selecteUserInRoleId = selectedData.Id;
    }


    function onDataBoundGridUserInRole(e) {
        if (selecteUserInRoleId) {
            var dataItem = this.dataSource.get(selecteUserInRoleId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridUserInRole(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteUserInRoleId = null;
        } else {
            selecteUserInRoleId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteUserInRoleId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onSelectUser(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#NameFull").val(dataItem.NameFull).trigger("change");
        $("#UserName").val(dataItem.UserName).trigger("change");
    }

    function ShowAccess(e) {
        e.preventDefault();
        var myTitle = "";
        var width = 1000;
        var heght = 300;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var userId = dataItem.UserId;
        var nameFull = dataItem.NameFull;
        var userName = dataItem.UserName;

        window.location = '@Url.Action("_Access", "Users")?userId=' + userId + "&nameFull=" + nameFull + "&userName=" + userName;
    }

    function ResetPw(e) {
        e.preventDefault();
        var myTitle = "";
        var width = 1000;
        var heght = 300;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var userId = dataItem.UserId;
        var nameFull = dataItem.NameFull;
        var userName = dataItem.UserName;

        window.location = '@Url.Action("ResetPassword", "Manage")?userId=' + userId + "&nameFull=" + nameFull + "&userName=" + userName;
    }


@{
    ViewBag.Title = "Index";
}

<h2 class="text-info">Roles</h2>

<br />
<div class="col-md-6">
    @(Html.Kendo().Grid<iLgs.Models.AspNetRole>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Id).Width(70);
        col.Bound(c => c.Name).Width(150);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Role");
        t.Search();
    })
            //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PayorTemplate").Window(w => w.Width(800).Height(500)))
    .Editable(editable => editable.Mode(GridEditMode.InLine))
    .Search(s =>
    {
        s.Field(o => o.Id, "contains");
        s.Field(o => o.Name, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Resizable(r => r.Columns(true))
    .Sortable()
    .Scrollable(s => s.Height(400))
            //.ClientDetailTemplateId("UserInRoles")
    .Filterable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).Editable(true);
        })
        .Read(read => read.Action("RolesRead", "Roles"))
        .Create(create => create.Action("RolesCreate", "Roles"))
        .Update(update => update.Action("RolesUpdate", "Roles"))
        .Destroy(destroy => destroy.Action("RolesDestroy", "Roles"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Events(events => events.Change("onChangeGrid").Edit("onEditGrid").DataBound("onDataBoundGrid"))
    )
</div>
<div id="windowcontainer"></div>

<div class="col-md-6">
      @(Html.Kendo().Grid<iLgs.Models.AspNetUserRoles_View>()
        .Name("gridUserInRole")
        .Columns(columns =>
        {
            //columns.Bound(o => o.UserId).Width(100);
            columns.Bound(o => o.UserName).Width(70);
            columns.Bound(o => o.NameFull).Width(180);
            columns.Command(command =>
            {
                //command.Edit();
                command.Destroy();
                command.Custom("Access").Click("ShowAccess");
                command.Custom("Reset PW").Click("ResetPw");
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add User In Role");
            t.Search();
        })              
        .Search(s =>
        {
            s.Field(o => o.UserName, "contains");
            s.Field(o => o.NameFull, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Resizable(r => r.Columns(true))
        .Sortable()
        .Scrollable(s => s.Height(400))
        .Filterable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_UserInRoleTemplate").Window(w => w.Width(500).Title("User in Role")))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.CompKeyId);
                model.Field(p => p.CompKeyId).DefaultValue("").Editable(true);
            })
            .Read(read => read.Action("UserInRoleRead", "Roles").Data("UserInRoleData"))            
            .Create(create => create.Action("UserInRoleCreate", "Roles").Data("UserInRoleData"))
            .Destroy(destroy => destroy.Action("UserInRoleDestroy", "Roles"))
        )
        .Events(events => events.Change("onChangeGridUserInRole").Edit("onEditGridUserInRole").DataBound("onDataBoundGridUserInRole"))
        .AutoBind(false)
        )            
</div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">

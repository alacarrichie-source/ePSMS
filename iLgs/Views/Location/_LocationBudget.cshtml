@(Html.Kendo().Grid<iLgs.Models.LocationBudgetVM>()
    .Name("gridBudget_" + @ViewData["DeptId"])
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(o => o.BudgetCode).Width(70).EditorTemplateName("_BudgetCodeTemplate");
        columns.Bound(o => o.Description).Width(100);
        columns.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.BudgetCode, "contains");
        s.Field(o => o.Description, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    //.Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .Editable()
    //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_DepartmentUserTemplate").Window(w => w.Width(500).Title("Users")))
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("InlineGridError").RequestEnd("onGridBudgetRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.LocationId).DefaultValue(@ViewData["DeptId"]);
        })
        .Read(read => read.Action("_LocationBudgetRead", "Location", new { deptId = @ViewData["DeptId"] }))
        .Create(create => create.Action("_LocationBudgetCreate", "Location"))
        .Update(update => update.Action("_LocationBudgetUpdate", "Location"))
        .Destroy(destroy => destroy.Action("_LocationBudgetDestroy", "Location"))
    )
    .Events(events => events
        .Change("onChangeGridBudget")
        .Edit("onEditGridBudget")
        .DataBound("onDataBoundGridBudget")
    )
    .AutoBind(true)
)

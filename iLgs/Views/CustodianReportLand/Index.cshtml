    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

    function onSelectStockDeptId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Department").val(dataItem.Description).trigger("change");
    }

    function onSelectLocationId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationCode").val(dataItem.Code).trigger("change");
        $("#Location").val(dataItem.Description).trigger("change");
    }

    function DataOfficerId() {
        var text = $("#OfficerId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OfficerId").data("kendoMultiColumnComboBox").value();
        }
        return {
            deptId: $("#LocationId").val(),
            text: text
        };
    }

    function onSelectLocationCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationId").val(dataItem.Id).trigger("change");
    }

    function UpdateTotalBalance(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var transferIn = $("#TransferIn").data("kendoNumericTextBox").value();
        var qtyBalance = qty + transferIn;

        $("#QtyBalance").data("kendoNumericTextBox").value(qtyBalance);
        $("#QtyBalance").data("kendoNumericTextBox").trigger("change");
    }

    function UpdateDescription(e)
    {
        //var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        //var data = $("#form").serialize();

        // Check the checkbox state explicitly
        var fromDonationChecked = $("#FromDonation").is(":checked");  // Adjust #FromDonation selector as needed
        //alert(fromDonationChecked); // For debugging purposes

        // Enable all disabled inputs, serialize data, and manually set the correct checkbox value
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var data = $("#form").serializeArray();  // Serialize to array to remove/add specific fields

        // Remove any existing "FromDonation" field in case it was included by `serialize`
        data = data.filter(function (item) { return item.name !== "FromDonation"; });
        // Add "FromDonation" with the correct checked value
        data.push({ name: "FromDonation", value: fromDonationChecked });

        // Convert array to query string format
        data = $.param(data);

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStockNo", "CustodianReportLand")',
            data: data,
            beforeSend: function () {
                window.kendo.ui.progress($(document.body), true);
            },
            success: function (result) {
                window.kendo.ui.progress($(document.body), false);
                $("#PsNo").val(result.StockNo).trigger("change");
                disabled.attr('disabled', 'disabled')
            },
            error: function (req, status, errorObj) {

    $(document).ready(function () {
        var grid = $("#grid").data("kendoGrid");
        grid.wrapper.find(".k-grid-add").hide(); // Hide the ADD button by default
        grid.wrapper.find(".k-grid-btnExport").hide();
        grid.wrapper.find(".k-grid-btnExportA").hide();
        grid.wrapper.find(".k-grid-btnExportB").hide();
        grid.wrapper.find(".k-grid-btnExportC").hide();
        grid.wrapper.find(".k-grid-btnPost").hide();
        grid.wrapper.find(".k-grid-btnUnpost").hide();
    });

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onSelectDeptId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#grid").data("kendoGrid").dataSource.read({deptId: dataItem.Id, accountGroup : '@ViewBag.AccountGroup'});
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            deptId: $("#deptId").val(),
            accountGroup: '@ViewBag.AccountGroup'
        };
    }

    var selectedGrid = null;
    var selectedId = null;
    var postedBy = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        postedBy = selectedData.PostedBy;

        if (postedBy) {
            $(".k-grid-btnUnpost", grid).show();
            $(".k-grid-btnPost", grid).hide();
        } else {
            $(".k-grid-btnUnpost", grid).hide();
            $(".k-grid-btnPost", grid).show();
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId && selectedId != "00000000-0000-0000-0000-000000000000") {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //// Attach a handler to the "detailExpand" event
            //this.bind("detailExpand", function (e) {
            //    // Select the expanded master row
            //    this.select(e.masterRow);
            //});
        }

        this.wrapper.find(".k-grid-add").show();

        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnExport", grid).hide();
            $(".k-grid-btnExportA", grid).hide();
            $(".k-grid-btnExportB", grid).hide();
            $(".k-grid-btnExportC", grid).hide();
            $(".k-grid-btnPost", grid).hide();
            $(".k-grid-btnUnpost", grid).hide();
        }
        else {
            $(".k-grid-btnExport", grid).show();
            $(".k-grid-btnExportA", grid).show();
            $(".k-grid-btnExportB", grid).show();
            $(".k-grid-btnExportC", grid).show();
            //$(".k-grid-btnPost", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;

        if (e.model.isNew()) {
            var accountGroup = '@ViewBag.AccountGroup';
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
            e.model.set("MainDeptId", $("#deptId").val());
            e.model.set("AccountGroup", accountGroup);
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function onSaveGrid(e) {
        // Prevent default Kendo UI save event
        e.preventDefault();
        var url = null;

        if (e.model.isNew()) {
            url = '@Url.Action("_ItemCreate", "CustodianReportLand")';
        } else {
            url = '@Url.Action("_ItemUpdate", "CustodianReportLand")';
        }

        SaveGridItems(url);
    }

    function SaveGridItems(url)
    {
        var popupNotification = $("#popupNotification").data("kendoNotification");
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var formData = $("#form").serialize();
        // Make an AJAX call to submit the data
        $.ajax({
            type: 'POST',
            url: url,
            data: formData,
            beforeSend: function () {
                window.kendo.ui.progress($("body, .k-window"), true);
            },
            success: function (response) {
                window.kendo.ui.progress($("body, .k-window"), false);
                disabled.attr('disabled', 'disabled');
                if (response.Errors) {
                    // Clear previous errors
                    $("#ErrorContent .errors").empty();
                    var errorMsg = "";
                    // Populate errors into the template
                    for (var field in response.Errors) {
                        var messages = response.Errors[field].errors;
                        var html = kendo.template($("#validationMessageTemplate").html())({
                            field: field,
                            messages: messages
                        });
                        $("#ErrorContent .errors").append(html);
                        errorMsg += html;
                    }
                    popupNotification.show(errorMsg, "error");
                    // Show the error content
                    $("#ErrorContent").removeClass("hidden");
                } else {
                    // Handle validation errors if any
                    $("#grid").data("kendoGrid").dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                e.sender.trigger("error", {
                    errors: [error]
                });
                alert("An error occurred: " + error);
            }
        });
    }

    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Recored already posted by " + postedBy);
        }
        else {
            var msg = "Post Selected record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "CustodianReportLand")',
                    data: { id: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            displayErrors(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    function displayErrors(errors) {
        if (errors.length > 0) {
            // Concatenate all error messages into a single string
            var allErrors = errors.join('\n');
            alert(allErrors);
        }
    }

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost Selected Record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "CustodianReportLand")',
                data: { id: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrint").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("CustodianRpt", "CustodianReportLand")?id=' + selectedId + '&accountGroup=@ViewBag.AccountGroup';

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });
    // end grid



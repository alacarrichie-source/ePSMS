        var grid = $("#gridItem_" + selectedId).data("kendoGrid");
        // Get selected rows
        var sel = $("input:checked", grid.tbody).closest("tr");
        // Get data item for each
        var selectedIds = grid.selectedKeyNames().join(",");

        var totalSelectedRow = grid.selectedKeyNames().length;

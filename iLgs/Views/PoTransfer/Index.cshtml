@helper RenderOrders()
{
    @(Html.Kendo().Grid<iLgs.Models.PoAdjustmentVM>()
        .Name("gridPo")
        .HtmlAttributes(new { @class = "grid-1" })
        .Columns(col =>
        {
            col.Bound(c => c.PoNo).Width(50);
            col.Bound(c => c.Remarks).Width(200);
            //col.Bound(c => c.IsOkay).Width(50);
            col.Bound(c => c.InsertedBy).Width(70);
            col.Bound(c => c.InsertedDt).Width(70);
            col.Bound(c => c.UpdatedBy).Width(70);
            col.Bound(c => c.UpdatedDt).Width(70);
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(120);
        })
        .ToolBar(t =>
        {
            t.Create().IconClass("k-icon k-i-add").Text("Add New Record");
            t.Search();
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PoAdjustmentTemplate").Window(w => w.Width("50%").Title("PO Adjsutment Item")))
        .Search(s =>
        {
            s.Field(o => o.PoNo, "contains");
            s.Field(o => o.Remarks, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(30)
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Read(read => read.Action("PoAdjustmentRead", "PoTransfer"))
            .Create(create => create.Action("PoAdjustmentCreate", "PoTransfer"))
            .Update(update => update.Action("PoAdjustmentUpdate", "PoTransfer"))
            .Destroy(destroy => destroy.Action("PoAdjustmentDestroy", "PoTransfer"))
        )
        .Events(events => events
            .Change("onChangeGridPo")
            .Edit("onEditGridPo")
            .DataBound("onDataBoundGridPo")
            ).AutoBind(true)
    )
}


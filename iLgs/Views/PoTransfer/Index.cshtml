<script type="text/javascript">
    var selectedIdPo = null;
    var mainPoNo = null;
    function onChangeGridPo(e) {
        var selectedData = this.dataItem(this.select());
        selectedIdPo = selectedData.Id;
        mainPoNo = selectedData.PoNo;
        selectedId = null;
        selectedPoNo = null;
        selectedPoDate = null;
        selectedPoFund = null;
        selectedDeptId = null;
        selectedDepartment = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onDataBoundGridPo(e) {
        if (selectedIdPo) {
            var dataItem = this.dataSource.get(selectedIdPo);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGridPo(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedIdPo = null;
            selectedId = null;
            //e.model.set("ForYear", $("#forYear").val());
        } else {
            selectedIdPo = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedIdPo);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onGridDeleteClickPo(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }


    function onChangePoNo(e) {
        selectedId = null;
        selectedPoNo = null;
        selectedPoDate = null;
        selectedPoFund = null;
        selectedDeptId = null;
        selectedDepartment = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var selectedPoNo = null;
    var selectedPoDate = null;
    var selectedPoFund = null;
    var selectedDeptId = null;
    var selectedDepartment = null

    $(".k-grid-btnPrintCard").click(function (e) {
        e.preventDefault();
        PrintCard(1);
    });

    $(".k-grid-btnPrintCardUpdate").click(function (e) {
        e.preventDefault();
        PrintCard(0);
    });

    function PrintCard(originalSw) {
        var url = '@Url.Action("PoRpt", "Query")?poNo=' + selectedPoNo + '&originalSw=' + originalSw;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    function onRequestEndGrid(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            //if (e.type == "create")
            //{
            //    var responseData = e.response;
            //    var newRecord = responseData.Data[0];
            //    selectedId = newRecord.Id;
            //}
        }
    }

    function onChangeGrid(e) {
        selectedGrid = this;
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedPoNo = selectedData.PoNo;
        selectedPoDate = selectedData.PoDate;
        selectedPoFund = selectedData.Fund;
        selectedDeptId = selectedData.DeptId;
        selectedDepartment = selectedData.Department;
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            //// Attach a handler to the "detailExpand" event
            //this.bind("detailExpand", function (e) {
            //    // Select the expanded master row
            //    this.select(e.masterRow);
            //});
        }
    }


    function DataStockCard() {
        return {
            poNo: mainPoNo
        };
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function onChangeGridItems(e) {

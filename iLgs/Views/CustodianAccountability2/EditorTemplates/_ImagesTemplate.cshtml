@model iLgs.Models.Upload

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "formUpload", id = "formUpload" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <div class="row k-mb-2">
        @Html.LabelFor(m => m.Description, new { @class = "text-right col-md-2" })
        <div class="col-md-10">
            @*@(Html.Kendo().TextBoxFor(m => m.Description).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))*@
            @(Html.Kendo().MultiColumnComboBoxFor(m => m.Description)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Document Type")
                    .DataTextField("Description")
                    .DataValueField("Description")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetUploadList", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Description").Title("Document Type").Width("1000%").Template("#= columnTemplate(data.Description) #");
                    }).Enable(ViewBag.IsAdmin)
            //.Suggest(true)
            )
            @Html.ValidationMessageFor(m => m.Description)
        </div>
    </div>

    <div class="row k-mb-2">
        @Html.LabelFor(m => m.Remarks, new { @class = "text-right col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(5).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            @Html.ValidationMessageFor(m => m.Remarks)
        </div>
    </div>
}








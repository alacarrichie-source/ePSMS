<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>

<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onSelectDeptCode(e) {
        var dataItem = this.dataItem(e.item.index());
        if (!dataItem) return; // safety check
        $("#deptCode").data("kendoMultiColumnComboBox").value(dataItem.Code);
        $("#deptCode").data("kendoMultiColumnComboBox").trigger("change");
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onChangeDeptCode(e) {
        var comboBox = this;
        if (!comboBox.value()) {
            $("#grid").data("kendoGrid").dataSource.data([]);
        }
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            deptCode: $("#deptCode").val()
        };
    }

    var selectedGrid = null;
    var selectedId = null;
    var trackingId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        trackingId = selectedId;
    }

    function onDataBoundGrid(e) {
        if (selectedId && selectedId != "00000000-0000-0000-0000-000000000000") {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;

        if (e.model.isNew()) {
            var accountGroup = '@ViewBag.AccountGroup';
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
        trackingId = selectedId;
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
                trackingId = selectedId;
            }
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function displayErrors(errors) {
        if (errors.length > 0) {
            // Concatenate all error messages into a single string
            var allErrors = errors.join('\n');
            alert(allErrors);
        }
    }

    $(".k-grid-btnUpload").click(function (e) {
        e.preventDefault();
        var deptCode = $("#deptCode").val();
        if (!deptCode)
        {
            alert("Please select department before proceeding..");
            return;
        }
        var myUrl = '@Url.Action("_ImagesAdd", "CustodianAccountability2")?deptCode=' + deptCode;
        var myTitle = "Upload Images/Documents";
        var width = 800;
        var height = 650;

        $("#windowcontainer").append("<div id='windowUpload'></div>");
        var mywindow = $("#windowUpload")
                .kendoWindow({
                    actions: ["Minimize", "Maximize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");

        mywindow.setOptions({ title: myTitle, width: width, height: height });
        mywindow.refresh({ url: myUrl });
        mywindow.center();
        mywindow.open();
    });

    function GridUploadError(e) {
        if (e.errors) {
            var subgrid = $("#gridImages_" + selectedId).data("kendoGrid");

            if (subgrid) {
                subgrid.dataSource.read(); // Refresh the subgrid
            }

            $.each(e.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                }
            });
        }
    }

    var selectedGridImagesItem = null;
    function onEditGridImages(e) {
        e.preventDefault();

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        //var parentModel = parentGrid.dataItem(parentRow);
        parentGrid.select(parentRow);

        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            e.model.set("ImageId", '@ViewData["imageId"]');
        } else {
            selectedGridImagesItem = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedGridImagesItem);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onDataBoundGridImages(e) {
        if (selectedGridImagesItem) {
            var dataItem = this.dataSource.get(selectedGridImagesItem);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onDeleteGridImages(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    function UploadPara(e) {
        e.data = { deptCode: $("#deptCode").val(), Description: $("#Description").val(), Remarks: $("#Remarks").val() }
    }

    function onClickPreview(e) {
        selectedGrid = this;

        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);

        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedGridImagesItem = dataItem.Id;

        var myUrl = '@Url.Action("PreviewUpload", "CustodianAccountability2")?id=' + selectedGridImagesItem;

        window.open(myUrl, "_blank");
    }

    function onClickDownload(e) {
        selectedGrid = this;

        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);

        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        if (dataItem) {
            window.kendo.ui.progress($(document.body), true);
            var fileName = dataItem.FileName;
            var url = '@Url.Action("DownloadFile", "CustodianAccountability2")?fileName=' + fileName;

            // Redirect to the export URL to trigger download
            window.location.href = url;
            window.kendo.ui.progress($(document.body), false);
        } else {
            alert("Please select a row to export.");
        }
    }

    function onError(e) {
        // invalid because the responseText is a raw string, not JSON
        //var err = $.parseJSON(e.XMLHttpRequest.responseText);
        var err = e.XMLHttpRequest.responseText;
        alert(err);
    };

    function onUploadSuccess(e)
    {
        $("#grid").data("kendoGrid").dataSource.read();
    }

    // END GRID IMAGES
</script>



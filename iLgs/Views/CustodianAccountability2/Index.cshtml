@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                    .Name("deptCode")
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Department")
                    .DataTextField("Description")
                    .DataValueField("Code")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetUserDepartmentsAsync", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Code").Title("Code").Width("30%");
                        c.Add().Field("Description").Title("Description").Width("70%");
                    })
                    .Events(e => e.Select("onSelectDeptCode").Change("onChangeDeptCode"))
                    .Suggest(true)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.Upload>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(p => p.Description).Title("")
                .ClientTemplate(
                @"<div class='upload-photo'
                   style='background-image: url(" + @Url.Content("~/CustodianAccountability2/PreviewUploadThumb?id=#:Id#") + ");'></div></div>")
                    .Width(30);
        col.Bound(p => p.Description).Width(100);
        col.Bound(p => p.Remarks).Width(100);
        col.Bound(p => p.FileName).Width(100);
        col.Bound(p => p.InsertedBy).Width(50);
        col.Bound(p => p.InsertedDt).Width(50);
        col.Command(command =>
        {
            if (ViewBag.IsAdmin)
            {
                command.Edit();
                command.Destroy();
            }
            command.Custom("Preview").IconClass("k-icon k-i-eye").Click("onClickPreview");
            command.Custom("Download").IconClass("k-icon k-i-download").Click("onClickDownload");
        }).Width(100);

    })
    .ToolBar(t =>
    {
        if (ViewBag.IsAdmin)
        {
            t.Custom().Text("Upload").IconClass("k-icon k-i-upload").Name("btnUpload").HtmlAttributes(new { @class = "k-button", href = "" });
            //t.Custom().Text("Download All").IconClass("k-icon k-i-download").Name("btnDownload").HtmlAttributes(new { @class = "k-button", href = "" });
        }
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ImagesTemplate").Window(w => w.Width(500).Title("Edit")))
    .Search(s =>
    {
        s.Field(o => o.Description, "contains");
        s.Field(o => o.Remarks, "contains");
        s.Field(o => o.FileName, "contains");
        s.Field(o => o.InsertedBy, "contains");
    })
    .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    .Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Read(read => read.Action("Read", "CustodianAccountability2").Data("DataGrid"))
        .Update(update => update.Action("Update", "CustodianAccountability2"))
        .Destroy(destroy => destroy.Action("Destroy", "CustodianAccountability2"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(false)
.Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)


@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)


@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Reporting Year-end", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().NumericTextBox()
                .Name("forYear")                
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("deptId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Department")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserDepartmentsAsync", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .Events(e => e.Select("onSelectDeptId").Change("onChangeDeptId"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Location", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("sectionId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Location")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserSectionsAsync", "Getters").Data("DataSectionId");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .CascadeFrom("deptId")
                .Events(e => e.Select("onSelectSectionId")
                    .Change("onChangeSectionId")
                )
                .Suggest(true)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.Upload>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(p => p.Description).Title("")
                .ClientTemplate(
                @"<div class='upload-photo'
                   style='background-image: url(" + @Url.Content("~/CustodianReport/PreviewUpload?id=#:Id#") + ");'></div></div>")
                    .Width(30);
        col.Bound(p => p.Description).Width(100);
        col.Bound(p => p.FileName).Width(100);
        col.Bound(p => p.InsertedBy).Width(50);
        col.Bound(p => p.InsertedDt).Width(50);
        col.Command(command =>
        {
            command.Custom("Preview").IconClass("k-icon k-i-eye").Click("onClickPreview");
            command.Custom("Download").IconClass("k-icon k-i-download").Click("onClickDownload");
        }).Width(100);

    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Description, "contains");
        s.Field(o => o.FileName, "contains");
        s.Field(o => o.InsertedBy, "contains");
    })
    .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    .Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Read(read => read.Action("UploadsRead", "CustodianReport").Data("DataGrid"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(true)
.Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)

<style>
    .upload-photo {
        display: inline-block;
        width: 70px;
        height: 70px;
        border-radius: 1%;
        background-size: 70px 70px;
        background-position: center center;
        vertical-align: middle;
        line-height: 80px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .file-name {
        display: inline-block;
        width: 150px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-window-content {
        overflow-x: hidden;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    #span_ {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: fit-content;
    }

    .no-text-tabstrip .k-item .k-link {
        padding: 0; /* Remove padding */
        text-indent: -9999px; /* Move the text outside the visible area */
        overflow: hidden; /* Hide any overflow */
    }

    .card-body {
        flex: 1 1 auto;
        padding: 1rem 1rem;
        /*min-height: 100px;*/
    }

    .card-header {
        padding: 0.5rem 1rem;
        margin-bottom: 0;
        background-color: rgba(0,0,0,.03);
        /*border-bottom: 1px solid rgba(0,0,0,.125);*/
        border-bottom: 1px solid black;
    }

    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        background-color: #fff;
        background-clip: border-box;
        /*border: 1px solid rgba(0,0,0,.125);*/
        border: 1px solid black;
        border-radius: 0.25rem;
    }

    .custom-max-grid .k-grid-content {
        overflow-x: auto;
        height: calc(100vh - 330px) !important;
    }
</style>

<script type="text/javascript">
    var reportId = null;
    var trackingId = null;
    var selectedGrid = null;
    var selectedId = null;
    var selectedSectionCode = null;
    var selectedSection = null;

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onChangeForYear(e) {
        reportId = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onSelectDeptId(e) {
        var dataItem = this.dataItem(e.item.index());
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        $("#deptId").data("kendoMultiColumnComboBox").value(dataItem.Id);
        $("#deptId").data("kendoMultiColumnComboBox").trigger("change");
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onChangeDeptId(e) {
        var comboBox = this;
        if (!comboBox.value()) {
            selectedId = null;
            trackingId = selectedId;
            reportId = null;
            $("#grid").data("kendoGrid").dataSource.data([]);
        }
    }

    function onSelectSectionId(e) {
        var dataItem = this.dataItem(e.item.index());
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        selectedSection = dataItem.Section;
        selectedSectionCode = dataItem.Code;
        $("#sectionId").data("kendoMultiColumnComboBox").value(dataItem.Id);
        $("#sectionId").data("kendoMultiColumnComboBox").trigger("change");
    }

    function onChangeSectionId(e) {
        var comboBox = this;
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function DataSectionId() {
        var text = $("#sectionId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#sectionId").data("kendoMultiColumnComboBox").value();
        }
        return {
            deptId: $("#deptId").val(),
            text: text
        };
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            forYear: $("#forYear").val(),
            deptId: $("#deptId").val(),
            locationId: $("#sectionId").val()
        };
    }

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        trackingId = selectedData.Id;
        selectedId = selectedData.Id;
    }

    var reportId = null;
    function onDataBoundGrid(e) {
        if (selectedId && selectedId != "00000000-0000-0000-0000-000000000000") {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }


    function onClickPreview(e) {
        selectedGrid = this;

        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);

        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedId = dataItem.Id;

        var myUrl = '@Url.Action("PreviewUpload", "CustodianReport")?id=' + selectedId;

        window.open(myUrl, "_blank");
    }

    function onClickDownload(e) {
        selectedGrid = this;

        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);

        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        if (dataItem) {
            window.kendo.ui.progress($(document.body), true);
            var fileName = dataItem.FileName;
            var url = '@Url.Action("DownloadFile", "CustodianReport")?fileName=' + fileName;

            // Redirect to the export URL to trigger download
            window.location.href = url;
            window.kendo.ui.progress($(document.body), false);
        } else {
            alert("Please select a row to export.");
        }
    }
</script>



@{
    var gridName = "gridRpcPpeIssuance_" + ViewData["reportItemId"];
}

@(Html.Kendo().Grid<iLgs.Models.CustodianReportItemIssuanceRpcPpeVM>()
    .Name("gridRpcPpeIssuance_" + @ViewData["reportItemId"])
    .Columns(col =>
    {
        col.Bound(p => p.ReportItemId).Visible(false);
        col.Bound(p => p.RefNo).Width(100);
        col.Bound(p => p.IssuedTo).Width(100);
        col.Bound(p => p.AccountableOfficer).Width(100);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(100);

    })
    .ToolBar(toolbar =>
    {
        toolbar.Create();
    })
    .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    //.Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Events(events => events.Error("InlineGridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.ReportItemId).DefaultValue(ViewData["reportItemId"]).Editable(false);
        })
            .Read(read => read.Action("_StockRpcPpeIssuanceRead", "CustodianReport", new { reportItemId = ViewData["reportItemId"] }))
            .Create(create => create.Action("_StockRpcPpeIssuanceCreate", "CustodianReport"))
            .Update(update => update.Action("_StockRpcPpeIssuanceUpdate", "CustodianReport"))
            .Destroy(destroy => destroy.Action("_StockRpcPpeIssuanceDestroy", "CustodianReport"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(true)
    .Events(events => events.Edit("onEditGridRpcPpeIssuance")
    .DataBound("onDataBoundGridRpcPpeIssuance")
    )
)



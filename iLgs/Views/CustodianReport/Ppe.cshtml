<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>

<script type="text/javascript">
    $(".k-grid-btnExport").click(function (e) {
        e.preventDefault();
        // Get the selected row's data (assuming a single selection model)
        var grid = $("#grid").data("kendoGrid");
        var selectedRow = grid.select();
        var selectedData = grid.dataItem(selectedRow);

        if (selectedData) {
            window.kendo.ui.progress($(document.body), true);
            // Get the ID of the selected row
            var reportId = selectedData.ReportId;

            // Construct the URL for the Excel export
            var url = "@Url.Action("ExcelExport", "CustodianReport")" + "?reportId=" + reportId;

            // Redirect to the export URL to trigger download
            window.location.href = url;
            window.kendo.ui.progress($(document.body), false);
        } else {
            alert("Please select a row to export.");
        }
    });



    $(document).ready(function () {
        var grid = $("#grid").data("kendoGrid");
        grid.wrapper.find(".k-grid-add").hide(); // Hide the ADD button by default
        grid.wrapper.find(".k-grid-btnExport").hide();
        grid.wrapper.find(".k-grid-btnPost").hide();
        grid.wrapper.find(".k-grid-btnUnpost").hide();
    });

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onSelectDeptId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#grid").data("kendoGrid").dataSource.read({deptId: dataItem.Id, accountGroup : '@ViewBag.AccountGroup'});
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            deptId: $("#deptId").val(),
            accountGroup: '@ViewBag.AccountGroup'
        };
    }

    var selectedGrid = null;
    var selectedId = null;
    var postedBy = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        postedBy = selectedData.PostedBy;

        if (postedBy) {
            $(".k-grid-btnUnpost", grid).show();
            $(".k-grid-btnPost", grid).hide();
        } else {
            $(".k-grid-btnUnpost", grid).hide();
            $(".k-grid-btnPost", grid).show();
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //// Attach a handler to the "detailExpand" event
            //this.bind("detailExpand", function (e) {
            //    // Select the expanded master row
            //    this.select(e.masterRow);
            //});
        }

        this.wrapper.find(".k-grid-add").show();

        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnExport", grid).hide();
            $(".k-grid-btnPost", grid).hide();
            $(".k-grid-btnUnpost", grid).hide();
        }
        else {
            $(".k-grid-btnExport", grid).show();
            //$(".k-grid-btnPost", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;

        if (e.model.isNew()) {
            var accountGroup = '@ViewBag.AccountGroup';
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
            e.model.set("MainDeptId", $("#deptId").val());
            e.model.set("AccountGroup", accountGroup);
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function onSaveGrid(e) {
        // Prevent default Kendo UI save event
        e.preventDefault();
        var url = null;

        if (e.model.isNew()) {
            url = '@Url.Action("_PpeItemCreate", "CustodianReport")';
        } else {
            url = '@Url.Action("_PpeItemUpdate", "CustodianReport")';
        }

        SaveGridItems(url);
    }

    function SaveGridItems(url)
    {
        var popupNotification = $("#popupNotification").data("kendoNotification");        
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var formData = $("#form").serialize();
        // Make an AJAX call to submit the data
        $.ajax({
            type: 'POST',
            url: url,
            data: formData,
            success: function (response) {
                disabled.attr('disabled', 'disabled');
                if (response.Errors) {
                    // Clear previous errors
                    $("#ErrorContent .errors").empty();
                    var errorMsg = "";
                    // Populate errors into the template
                    for (var field in response.Errors) {
                        var messages = response.Errors[field].errors;
                        var html = kendo.template($("#validationMessageTemplate").html())({
                            field: field,
                            messages: messages
                        });
                        $("#ErrorContent .errors").append(html);
                        errorMsg += html;
                    }
                    popupNotification.show(errorMsg, "error");
                    // Show the error content
                    $("#ErrorContent").removeClass("hidden");
                } else {
                    // Handle validation errors if any
                    $("#grid").data("kendoGrid").dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                e.sender.trigger("error", {
                    errors: [error]
                });
                alert("An error occurred: " + error);
            }
        });
    }

    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Recored already posted by " + postedBy);
        }
        else {
            var msg = "Post Selected record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "CustodianReport")',
                    data: { id: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            displayErrors(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    function displayErrors(errors) {
        if (errors.length > 0) {
            // Concatenate all error messages into a single string
            var allErrors = errors.join('\n');
            alert(allErrors);
        }
    }

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost Selected Record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "CustodianReport")',
                data: { id: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrint").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("CustodianRpt", "CustodianReport")?id=' + selectedId + '&accountGroup=@ViewBag.AccountGroup';

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });
    // end grid


    // item template
    function DataItemCode() {
        var text = $("#ItemCodeId").data("kendoMultiColumnComboBox").text();
        return {
            category: "S",
            text: text
        };
    }

    function onSelectItemCodeId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Article").val(dataItem.Article).trigger("change");
        $("#Item_Code").val(dataItem.Code).trigger("change");
        $("#ItemType_Code").val(dataItem.Type).trigger("change");
        $("#SubAccount").val(dataItem.MainDesc).trigger("change");
        $("#Account").val(dataItem.TypeDesc).trigger("change");

        RefreshDivs(dataItem);
    }

    function onDataBoundItemCodeId(e) {
        var comboBox = this;
        var selectedValue = comboBox.value();

        if (selectedValue !== null && selectedValue !== undefined && selectedValue != "") {
            var dataItem = comboBox.dataItem();
            $("#SubAccount").val(dataItem.MainDesc).trigger("change");
            $("#Account").val(dataItem.TypeDesc).trigger("change");
            RefreshDivs(dataItem);
        }
    }

    function RefreshDivs(dataItem) {
        var fieldsContainer = $('#DIV_ALLFIELDS');

        fieldsContainer.removeClass('hidden');
        fieldsContainer.empty(); // Clear existing content

        var url = '@Url.Action("LoadStockFields", "CustodianReport")';
        var data = $("#form").serialize();

        $.ajax({
            type: 'POST',
            url: url,
            data: data,
            success: function(data) {
                fieldsContainer.html(data);
            }
        });
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

    function onSelectStockDeptId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#Department").val(dataItem.Description).trigger("change");
    }

    function onSelectLocationId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationCode").val(dataItem.Code).trigger("change");
        $("#Location").val(dataItem.Description).trigger("change");
    }

    function DataOfficerId() {
        var text = $("#OfficerId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OfficerId").data("kendoMultiColumnComboBox").value();
        }
        return {
            deptId: $("#LocationId").val(),
            text: text
        };
    }

    function onSelectLocationCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationId").val(dataItem.Id).trigger("change");
    }

    function UpdateTotalBalance(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var transferIn = $("#TransferIn").data("kendoNumericTextBox").value();
        var qtyBalance = qty + transferIn;

        $("#QtyBalance").data("kendoNumericTextBox").value(qtyBalance);
        $("#QtyBalance").data("kendoNumericTextBox").trigger("change");
    }

    function UpdateDescription(e)
    {
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var data = $("#form").serialize();

        $.ajax({
            type: "POST",
            url: '@Url.Action("GetStockNo", "CustodianReport")',
            data: data,
            beforeSend: function () {
                window.kendo.ui.progress($(document.body), true);
            },
            success: function (result) {
                window.kendo.ui.progress($(document.body), false);
                $("#PsNo").val(result.StockNo).trigger("change");
                disabled.attr('disabled', 'disabled')
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
            }
        });
    }
    // end item template

</script>


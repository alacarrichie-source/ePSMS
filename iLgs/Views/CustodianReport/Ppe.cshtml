@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row">
    <div class="col-md-4">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("deptId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Department")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserDepartmentsAsync", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .Events(e => e.Select("onSelectDeptId"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.CustodianReportItemPpeVM>()
        .HtmlAttributes(new { @class = "custom-max-grid" })
        .Name("grid")
        .Columns(col =>
        {
            col.Bound(c => c.Article).Width(70);
            col.Bound(c => c.PoNo).Width(50);
            col.Bound(c => c.PoDate).Width(50);
            col.Bound(c => c.Unit).Width(50);
            col.Bound(c => c.UnitCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.LocationCode).Width(50);
            col.Bound(c => c.Location).Width(70);
            col.Bound(c => c.TotalCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.PsNo).Width(70);
            col.Bound(c => c.Description).Width(150);
            col.Bound(c => c.Annex).Width(50);
            //col.Bound(c => c.InsertedDt).Width(70);
            col.Command(command =>
            {
                command.Edit();
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
                //command.Destroy();
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add New Record");
            t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExport").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Search();
        })
        .Search(s =>
        {
            s.Field(o => o.Article, "contains");
            s.Field(o => o.PoNo, "contains");
            s.Field(o => o.Description, "contains");
            s.Field(o => o.PsNo, "contains");
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PpeItemTemplate").Window(w => w.Width(1000).Title("Other PPE Items")))
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Scrollable()
        .Sortable()
        .Groupable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.TotalCost).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_PpeItemRead", "CustodianReport").Data("DataGrid"))
            .Create(create => create.Action("_PpeItemCreate", "CustodianReport"))
            .Update(update => update.Action("_PpeItemUpdate", "CustodianReport"))
            .Destroy(destroy => destroy.Action("_PpeItemDestroy", "CustodianReport"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
            .Save("onSaveGrid")
        )
        .AutoBind(false)
)

@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<div id="windowcontainer"></div>

<style>

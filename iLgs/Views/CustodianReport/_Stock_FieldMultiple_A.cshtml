@model iLgs.Models.CustodianReportItemStockVM
<div class="row k-mb-2">
    <div class="col-md-6">
        <div class="col-md-3">
            @Html.DisplayFor(m => m.Multipliers, "LabelInt")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(m => m.Multipliers).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Multipliers)
        </div>
    </div>

    <div class="col-md-6">
        <div class="col-md-3">
            @Html.DisplayFor(m => m.Brand, "Label")
        </div>
        <div class="col-md-9">
            @(Html.Kendo().TextBoxFor(m => m.Brand).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Brand)
        </div>
    </div>
</div>



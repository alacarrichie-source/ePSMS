                        .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.InvDist)
                </div>
            </div>

            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Condition, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.Condition).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Condition)
                </div>                
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Remarks, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.Remarks).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>

            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Fund, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.SetLotNo, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.SetLotNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.SetLotNo)
                </div>
            </div>

            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Annex, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().MaskedTextBoxFor(m => m.Annex).Mask("L").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Annex)
                </div>
            </div>            
        </div>

    </fieldset>
}









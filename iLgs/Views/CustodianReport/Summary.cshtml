<script type="text/javascript">
    $(".k-grid-btnExport").click(function (e) {
        e.preventDefault();
        window.kendo.ui.progress($(document.body), true);

        var forYear = $("#forYear").val();
        var deptId = $("#deptId").val();
        var sectionId = $("#sectionId").val();
        var asOf = $("#asOf").val();
        var insertedAsOf = $("#insertedAsOf").val();        
        var url = "@Url.Action("ExcelExportSummary", "CustodianReport")?forYear=" + forYear + "&deptId=" + deptId + "&sectionId=" + sectionId 
            + '&asOf=' + asOf
            + '&insertedAsOf=' + insertedAsOf
            
        // Redirect to the export URL to trigger download
        window.location.href = url;
        window.kendo.ui.progress($(document.body), false);
    });

    var reportId = null;
    var trackingId = null;
    var selectedGrid = null;
    var selectedId = null;
    var selectedSectionCode = null;
    var selectedSection = null;

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onChangeForYear(e) {
        reportId = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onSelectDeptId(e) {
        var dataItem = this.dataItem(e.item.index());
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        $("#deptId").data("kendoMultiColumnComboBox").value(dataItem.Id);
        $("#deptId").data("kendoMultiColumnComboBox").trigger("change");
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function onChangeDeptId(e) {
        var comboBox = this;
        if (!comboBox.value()) {
            selectedId = null;
            trackingId = selectedId;
            reportId = null;
            $("#grid").data("kendoGrid").dataSource.data([]);
        }
    }

    function onSelectSectionId(e) {
        var dataItem = this.dataItem(e.item.index());
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        selectedSection = dataItem.Section;
        selectedSectionCode = dataItem.Code;
        $("#sectionId").data("kendoMultiColumnComboBox").value(dataItem.Id);
        $("#sectionId").data("kendoMultiColumnComboBox").trigger("change");
    }

    function onChangeSectionId(e) {
        var comboBox = this;
        selectedId = null;
        trackingId = selectedId;
        reportId = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function DataSectionId() {
        var text = $("#sectionId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#sectionId").data("kendoMultiColumnComboBox").value();
        }
        return {
            deptId: $("#deptId").val(),
            text: text
        };
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            forYear: $("#forYear").val(),
            deptId: $("#deptId").val(),
            locationId: $("#sectionId").val(),
            asOf: $("#asOf").val(),
            insertedAsOf: $("#insertedAsOf").val()
        };
    }

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        //trackingId = selectedData.Id;
        //selectedId = selectedData.Id;
    }

    var reportId = null;

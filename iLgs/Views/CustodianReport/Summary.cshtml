@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Reporting Year-end", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().NumericTextBox()
                .Name("forYear")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("deptId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Department")
                .DataTextField("Description")
                .DataValueField("Id")
                .Value("ALL")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserDepartmentsWithAllAsync", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .Events(e => e.Select("onSelectDeptId").Change("onChangeDeptId"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Location", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("sectionId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Location")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserSectionsAsync", "Getters").Data("DataSectionId");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .CascadeFrom("deptId")
                .Events(e => e.Select("onSelectSectionId")
                    .Change("onChangeSectionId")
                )
                .Suggest(true)
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Acquisition as of", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().DatePicker().Value(DateTime.Now)
                .Name("asOf")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
            )
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Inserted as of", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().DateTimePicker().Value(DateTime.Now)
                .Name("insertedAsOf")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.CustodianReportSummaryVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(p => p.GroupName).Width(70);
        col.Bound(p => p.Account).Width(100);
        col.Bound(p => p.SubAccount1).Width(100);
        col.Bound(p => p.AnnexACost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(p => p.AnnexBCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(p => p.AnnexCCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(p => p.AnnexXCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(p => p.TotalCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientGroupFooterTemplate("#= sum != null ? kendo.format('{0:n2}', sum) : '' #")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
    })
    .ToolBar(t =>
    {
        t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExport").HtmlAttributes(new { @class = "k-button", href = "", id = "exportGrid" });
        t.Search();
    })    
    .Search(s =>
    {
        s.Field(o => o.GroupName, "contains");
        s.Field(o => o.Account, "contains");
        s.Field(o => o.SubAccount1, "contains");
    })
    .Pageable(pager => pager
            //.Input(false)
            //.Numeric(true)
            //.Info(true)
            //.PreviousNext(true)
            .Refresh(true)
            .PageSizes(false)
            //.ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    .Scrollable()
    .NoRecords()
    .Groupable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(100000)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.AnnexACost).Sum();
            a.Add(p => p.AnnexBCost).Sum();
            a.Add(p => p.AnnexCCost).Sum();
            a.Add(p => p.AnnexXCost).Sum();
            a.Add(p => p.TotalCost).Sum();
        })
        .Group(x =>
            {
                x.Add(y => y.GroupName);
                x.Add(y => y.Account);

            })
        .Sort(s => s.Add(a => a.OrderNo))
        .Read(read => read.Action("SummaryRead", "CustodianReport").Data("DataGrid"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(true)
.Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)


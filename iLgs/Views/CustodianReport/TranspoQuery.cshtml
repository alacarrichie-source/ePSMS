@(Html.Kendo().Grid<iLgs.Models.CustodianReportItemVehicleVM>()
        .HtmlAttributes(new { @class = "custom-max-grid-2" })
        .Name("grid")
        .Columns(col =>
        {
            col.Bound(c => c.CustodianItemIndex).Hidden();
            col.Bound(c => c.MainDeptName).Width(70);
            col.Bound(c => c.CustodianItemNo).Width(50);
            col.Bound(c => c.Account).Width(70);
            col.Bound(c => c.SubAccount).Width(70);
            col.Bound(c => c.Article).Width(70);
            col.Bound(c => c.PoNo).Width(50);
            col.Bound(c => c.PoDate).Width(50);
            col.Bound(c => c.Unit).Width(50);
            col.Bound(c => c.UnitCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.LocationCode).Width(50);
            col.Bound(c => c.Location).Width(70);
            col.Bound(c => c.TotalCost).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.AcqDate).Width(50);
            col.Bound(c => c.PsNo).Width(70);
            col.Bound(c => c.Description).Width(70);
            col.Bound(c => c.Annex).Width(50);
            col.Bound(c => c.InsertedBy).Width(70);
            col.Bound(c => c.InsertedDt).Width(70);
            col.Bound(c => c.IsPosted).Width(30);
        })
        .ToolBar(t =>
        {
            t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExport").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Export to Excel - Annex A").IconClass("k-icon k-i-excel").Name("btnExportA").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Export to Excel - Annex B").IconClass("k-icon k-i-excel").Name("btnExportB").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Export to Excel - Annex C").IconClass("k-icon k-i-excel").Name("btnExportC").HtmlAttributes(new { @class = "k-button", href = "" });

            if (ViewBag.AnnexDUser == true)
            {
                t.Custom().Text("Export to Excel - Annex D").IconClass("k-icon k-i-excel").Name("btnExportD").HtmlAttributes(new { @class = "k-button", href = "" });
            }
            t.Custom().Text("Export to Excel - No Annex").IconClass("k-icon k-i-excel").Name("btnExportX").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Export GRID to Excel").IconClass("k-icon k-i-excel").Name("btnExportGrid").HtmlAttributes(new { @class = "k-button", href = "", id = "exportGrid" });
            t.Search();
        })
        .Excel(excel => excel
            .FileName("GridExportVehicles.xlsx")
            .Filterable(true)
            .AllPages(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "CustodianReport"))
        )
        .Search(s =>
        {
            s.Field(o => o.MainDeptName, "contains");
            s.Field(o => o.Account, "contains");
            s.Field(o => o.SubAccount, "contains");
            s.Field(o => o.Article, "contains");
            s.Field(o => o.PoNo, "contains");
            s.Field(o => o.LocationCode, "contains");
            s.Field(o => o.Location, "contains");
            s.Field(o => o.Description, "contains");
            s.Field(o => o.PsNo, "contains");
            s.Field(o => o.InsertedBy, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Scrollable()
        .Sortable()
        .Groupable()
        //.ClientDetailTemplateId("UploadedFiles")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.TotalCost).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.CustodianItemIndex);
            })
            .Read(read => read.Action("_VehicleItemReadAll", "CustodianReport").Data("DataGrid"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .DataBound("onDataBoundGrid")
        )
        .AutoBind(true)
)

<script id="UploadedFiles" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabStrip_#=Id#")
        //.HtmlAttributes(new { @class = "no-text-tabstrip" })
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Uploads").Selected(true).LoadContentFrom("_Images", "CustodianReport", new { imageId = "#=Id#" });
            items.Add().Text("PAR").LoadContentFrom("_VehicleParIssuance", "CustodianReport", new { reportItemId = "#=Id#" });
            items.Add().Text("ICS").LoadContentFrom("_VehicleIcsIssuance", "CustodianReport", new { reportItemId = "#=Id#" });
            items.Add().Text("ARE").LoadContentFrom("_VehicleAreIssuance", "CustodianReport", new { reportItemId = "#=Id#" });
            items.Add().Text("MR").LoadContentFrom("_VehicleMrIssuance", "CustodianReport", new { reportItemId = "#=Id#" });
        })
        .ToClientTemplate())
</script>


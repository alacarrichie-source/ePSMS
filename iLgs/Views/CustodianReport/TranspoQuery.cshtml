<script type="text/javascript">
    $("#exportGrid").click(function (e) {
        e.preventDefault();
        $("#grid").data("kendoGrid").saveAsExcel();
    });

    function DataAccount() {
        var text = $("#mainAccount").data("kendoMultiColumnComboBox").text();
        return {
            accountGroup: '@ViewBag.AccountGroup',
            category: '@ViewBag.Category',
            text: text
        };
    }

    function DataSubAccount1() {
        var text = $("#subAccount1").data("kendoMultiColumnComboBox").text();
        return {
            accountGroup: '@ViewBag.AccountGroup',
            mainAccount: $("#mainAccount").data("kendoMultiColumnComboBox").value(),
            text: text
        };
    }

    function DataSubAccount2() {
        var text = $("#subAccount2").data("kendoMultiColumnComboBox").text();
        return {
            accountGroup: '@ViewBag.AccountGroup',
            subAccountCode: $("#subAccount1").data("kendoMultiColumnComboBox").value(),
            text: text
        };
    }

    function DataSubAccount3() {
        var text = $("#subAccount3").data("kendoMultiColumnComboBox").text();
        return {
            accountGroup: '@ViewBag.AccountGroup',
            subAccountCode: $("#subAccount2").data("kendoMultiColumnComboBox").value(),
            text: text
        };
    }

    function DataSubAccount4() {
        var text = $("#subAccount4").data("kendoMultiColumnComboBox").text();
        return {
            accountGroup: '@ViewBag.AccountGroup',
            subAccountCode: $("#subAccount3").data("kendoMultiColumnComboBox").value(),
            text: text
        };
    }

    $(".k-grid-btnExport").click(function (e) {
        e.preventDefault();
        // Get the selected row's data (assuming a single selection model)
        //var grid = $("#grid").data("kendoGrid");
        //var selectedRow = grid.select();
        //var selectedData = grid.dataItem(selectedRow);

        window.kendo.ui.progress($(document.body), true);
        var forYear = $("#forYear").val();
        var deptId = $("#deptId").val();
        var sectionId = $("#sectionId").val();
        var mainAccount = $("#mainAccount").data("kendoMultiColumnComboBox").text();
        var subAccount1 = $("#subAccount1").val();
        var subAccount2 = $("#subAccount2").val();
        var subAccount3 = $("#subAccount3").val();
        var subAccount4 = $("#subAccount4").val();
        var asOf = $("#asOf").val();
        var insertedAsOf = $("#insertedAsOf").val();
        var acqFilter = $("#acqFilter").val();
        var acqCost = $("#acqCost").val();
        var condFilter = $("#condFilter").val();
        var acqFilter2 = $("#acqFilter2").val();
        var acqCost2 = $("#acqCost2").val();
        // Construct the URL for the Excel export

        var url = "@Url.Action("ExcelExportAll", "CustodianReport")?forYear=" + forYear + "&deptId=" + deptId + "&sectionId=" + sectionId + "&accountGroup=" + '@ViewBag.AccountGroup'
            + '&mainAccount=' + mainAccount + '&asOf=' + asOf
            + '&insertedAsOf=' + insertedAsOf
            + '&subAccount1=' + subAccount1
            + '&subAccount2=' + subAccount2
            + '&subAccount3=' + subAccount3
            + '&subAccount4=' + subAccount4
            + '&category=' + '@ViewBag.Category'
            + '&acqFilter=' + acqFilter
            + '&acqCost=' + acqCost
            + '&condFilter=' + condFilter
            + '&acqFilter2=' + acqFilter2
            + '&acqCost2=' + acqCost2;

        // Redirect to the export URL to trigger download
        window.location.href = url;
        window.kendo.ui.progress($(document.body), false);
    });

    $(".k-grid-btnExportA").click(function (e) {
        e.preventDefault();
        exportAnnex('A');
    });

    $(".k-grid-btnExportB").click(function (e) {
        e.preventDefault();
        exportAnnex('B');
    });

    $(".k-grid-btnExportC").click(function (e) {
        e.preventDefault();
        exportAnnex('C');
    });

    $(".k-grid-btnExportD").click(function (e) {
        e.preventDefault();
        exportAnnex('D');
    });

    $(".k-grid-btnExportX").click(function (e) {
        e.preventDefault();
        exportAnnex('X');
    });

    function exportAnnex(annex) {
        window.kendo.ui.progress($(document.body), true);
        var forYear = $("#forYear").val();

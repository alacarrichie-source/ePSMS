<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @if (ViewBag.IsDemand)
            {
                @(Html.Kendo().MultiColumnComboBox()
                        .Name("deptId")
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Department")
                        .DataTextField("Description")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetDepartments", "Getters");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("30%");
                            c.Add().Field("Description").Title("Description").Width("70%");
                        })
                        .Events(e => e.Select("onSelectDeptId").Change("onChangeDeptId"))
                        .Suggest(true)
                )
            }
            else
            {
                @(Html.Kendo().MultiColumnComboBox()
                        .Name("deptId")
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Department")
                        .DataTextField("Description")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetUserDepartmentsAsync", "Getters");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("30%");
                            c.Add().Field("Description").Title("Description").Width("70%");
                        })
                        .Events(e => e.Select("onSelectDeptId").Change("onChangeDeptId"))
                        .Suggest(true)
                )
            }
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Location", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("sectionId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Location")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserSectionsAsync", "Getters").Data("DataSectionId");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .CascadeFrom("deptId")
                .Events(e => e.Select("onSelectSectionId")
                    .Change("onChangeSectionId")
                )
                .Suggest(true)
            )
        </div>
    </div>
</div>


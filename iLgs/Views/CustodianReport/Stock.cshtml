    function onChangeSetValues(e) {
        var setLotAmount = $("#SetLotAmount").data("kendoNumericTextBox").value();
        var priceRate = $("#PriceRate").data("kendoNumericTextBox").value();
        var unitCost = 0;

        if (setLotAmount) {
            if (priceRate) {
                unitCost = setLotAmount * (priceRate / 100);

                $("#TotalCost").data("kendoNumericTextBox").value(0);
                $("#TotalCost").data("kendoNumericTextBox").trigger("change");
            }
        }

        $("#ProRatedCost").data("kendoNumericTextBox").value(unitCost);
        $("#ProRatedCost").data("kendoNumericTextBox").trigger("change");
    }

    // SUBMIT FOR COUNT
    function setSubmitButton(reportId, locationId)
    {
        $.ajax({
            type: "POST",
            url: '@Url.Action("IsSubmitForCount", "CustodianReport")',
            data: { reportId: reportId, locationId: locationId },
            beforeSend: function () {
                window.kendo.ui.progress($("body, .k-window"), true);
            },
            success: function (result) {
                window.kendo.ui.progress($("body, .k-window"), false);
                var btn = $(".k-grid-btnCount")
                var newText = result.IsSubmitForCount ? "Unsubmit " + result.UpdateDate + " for Count" : "Submit for Count";
                btn.html('<span class="k-icon k-i-track-changes-accept"></span>' + newText);
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
                window.kendo.ui.progress($("body, .k-window"), false);
            }
        });
    }

    function onChangeSetLotNo()
    {
        var forYear = $("#forYear").val();
        var deptId = $("#deptId").val();
        var locationId = $("#LocationId").val();
        var custodianReportItemId = $("#Id").val();
        var setLotNo = $("#SetLotNo").data("kendoMaskedTextBox").value();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetSetLotCount", "CustodianReport")',
            data: {
                foryear: forYear,
                deptId: deptId,
                locationId: locationId,
                custodianReportItemId: custodianReportItemId,
                setLotNo: setLotNo
            },
            beforeSend: function () {
                window.kendo.ui.progress($("body, .k-window"), true);
            },
            success: function (result) {
                window.kendo.ui.progress($("body, .k-window"), false);
                if (result.Count > 0)
                {
                    //$("#popupNotification").kendoNotification({
                    //    autoHideAfter: 0, // don't auto-close
                    //    button: true,     // show close button
                    //    stacking: "down"  // optional: position new messages downward
                    //});
                    var popupNotification = $("#popupNotification").data("kendoNotification");
                    popupNotification.show("Set/Lot Number " + setLotNo + " was already used " + result.Count + " time(s)", "info");
                }
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
                window.kendo.ui.progress($("body, .k-window"), false);
            }
        });
    }


    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;

        if (e.model.isNew()) {
            if (!$("#sectionId").val()) {
                alert("Please select a location before proceeding.");
                var wnd = e.container && e.container.data("kendoWindow");
                if (wnd) {
                    wnd.close();
                    selectedGrid.dataSource.remove(e.model);
                }
            }
            else {
                var accountGroup = '@ViewBag.AccountGroup';
                var row = e.sender.tbody.find("tr:first");
                this.select(row);
                selectedId = null;
                e.model.set("ForYear", $("#forYear").val());
                e.model.set("MainDeptId", $("#deptId").val());
                e.model.set("LocationId", $("#sectionId").val());
                e.model.set("LocationCode", selectedSectionCode);
                e.model.set("Location", selectedSection);
                e.model.set("MainDeptName", $("#deptId").data("kendoMultiColumnComboBox").text());
                e.model.set("AccountGroup", accountGroup);
            }
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

            var dataItem = e.model;
            e.model.set("ForYear", $("#forYear").val());
            e.model.set("MainDeptId", $("#deptId").val());
            if (IsPosted(dataItem) || '@ViewBag.IsDemand' == 'True') {
                setTimeout(function () {
                    var popup = e.container;

                    // Disable all inputs, selects, and widgets
                    popup.find("input, select, textarea, .k-datapicker, .k-numerictextbox, .k-combobox").prop("disabled", true);

                    // Disable Kendo widgets including their buttons/icons
                    popup.find("[data-role]").each(function () {
                        var widget = kendo.widgetInstance($(this));
                        if (widget && typeof widget.enable === "function") {
                            widget.enable(false); // This disables the entire widget, including the icon
                        }
                    });

                    // Hide update/save button
                    popup.find(".k-grid-update").hide();
                }, 50); // 0-50ms delay usually works well
            }
        }
        trackingId = selectedId;
    }


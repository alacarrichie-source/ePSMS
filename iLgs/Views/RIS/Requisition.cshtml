    $("#searchInput").on("input", function () {
        var listView = $("#listView").data("kendoListView");
        var searchValue = $(this).val();
        if (searchValue) {
            listView.dataSource.filter({
                logic: "or",
                filters: [
                    { field: "ItemName", operator: "contains", value: searchValue },
                    { field: "PsNo", operator: "contains", value: searchValue }
                    //{ field: "Quantity", operator: "contains", value: searchValue }
                ]
            });
        } else {
            listView.dataSource.filter();
        }
    });

    function onListViewDataBound() {        
        updateCartCount();
        $(".add-to-cart").click(function () {
            var item = $(this).closest(".k-card").data("item");
            var cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
            cartItems.push(item);
            alert(JSON.stringify(cartItems));
            localStorage.setItem("cartItems", JSON.stringify(cartItems));      
            updateCartCount();
        });                
    }

    function updateCartCount() {
        var cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
        var cartCount = cartItems.length;
        $("#cartCount").text(cartCount);
    }

    function checkout() {
        var cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
        // Perform the checkout logic here, e.g., sending the cartItems to the server for processing

        // Clear the cart items after checkout
        localStorage.removeItem("cartItems");
        updateCartCount();

        // Show a confirmation message or redirect to a checkout page
        alert("Checkout completed!");
    }

    function openCartDialog() {
        var cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
        var url = "/RIS/Cart?" + $.param({ cartItems: cartItems });
        window.location.href = url;
    }

    $("#viewCartBtn").click(function () {
        openCartDialog();
    });                

    $("#resetBtn").click(function () {
        var cartItems = JSON.parse(localStorage.getItem("cartItems")) || [];
        // Perform the checkout logic here, e.g., sending the cartItems to the server for processing

        // Clear the cart items after checkout
        localStorage.removeItem("cartItems");
        updateCartCount();
    });                
        
</script>

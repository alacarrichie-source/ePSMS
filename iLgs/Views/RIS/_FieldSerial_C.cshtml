@model iLgs.Models.RisItemEntryVM
@Html.HiddenFor(model => model.AllField.Id)

<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.AllField.PlateNo, "Plate No", htmlAttributes: new { @class = "col-md-2" })
        <div class="col-md-10">
            @(Html.Kendo().TextBoxFor(m => m.AllField.PlateNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.AllField.PlateNo)
        </div>
    </div>
</div>


@model iLgs.Models.RisItemEntryVM
@Html.HiddenFor(model => model.AllField.Id)

<div class="row k-mb-2">
    <div class="col-md-12">
        <div class="col-md-2">
            @Html.DisplayFor(m => m.AllField.Model_, "Label")
        </div>
        <div class="col-md-10">
            @(Html.Kendo().TextBoxFor(m => m.AllField.Model_).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.AllField.Model_)
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-12">
        <div class="col-md-2">
            @Html.DisplayFor(m => m.AllField.Weight, "Label")
        </div>
        <div class="col-md-10">
            @(Html.Kendo().TextBoxFor(m => m.AllField.Weight).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.AllField.Weight)
        </div>
    </div>
</div>

<div class="row k-mb-2">
    <div class="col-md-12">
        <div class="col-md-2">
            @Html.DisplayFor(m => m.AllField.Color, "Label")
        </div>
        <div class="col-md-10">
            @(Html.Kendo().TextBoxFor(m => m.AllField.Color).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.AllField.Color)
        </div>
    </div>
</div>
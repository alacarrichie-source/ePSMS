<script type="text/javascript">
    function onSelectIssuedItemIssuedBy(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#IssuedByDesignation").val(dataItem.Desc2).trigger("change");

        //var model = $("#grid").data().kendoGrid.editable.options.model;
        //model.set('IssuedByDesignation', $('#IssuedByDesignation').val());
    }

    function onSelectIssuedItemReceivedBy(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#ReceivedByDesignation").val(dataItem.Desc2).trigger("change");

        //var model = $("#grid").data().kendoGrid.editable.options.model;
        //model.set('RequestedByDesignation', $('#RequestedByDesignation').val());
    }

    function onClickGridIssuedItemAdd(subID) {
        var button = this;
        alert(subID);
        /// Get the current subgrid data item
        var subGrid = $(button).closest("[data-role=grid]").data("kendoGrid");
        var subGridItem = subGrid.dataItem(subGrid.tbody.find(".k-grid-edit-row"));

        // Get the main grid
        var mainGrid = $("#mainGrid").data("kendoGrid");

        // Select the current row in the main grid
        mainGrid.select(mainGrid.tbody.find("tr[data-uid='" + subGridItem.MainID + "']"));

        // Select the current row in the subgrid
        subGrid.select(subGrid.tbody.find("tr[data-uid='" + subGridItem.uid + "']"));

        // Get the nestedSubGrid
        var nestedSubGrid = $("#gridIssuedItems_" + subID).data("kendoGrid");

        // Add a new row to the nestedSubGrid
        nestedSubGrid.addRow();

        // Scroll the newly added row into view
        var newRow = nestedSubGrid.tbody.find("tr.k-grid-edit-row");
        if (newRow.length > 0) {
            nestedSubGrid.content.scrollTop(newRow.position().top);
        }
    }    

    
</script>
@model iLgs.Models.RisItemUnitGroupDescriptionItemVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.UnitGroupDescriptionId)
    @Html.HiddenFor(model => model.GridItems)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                @(Html.Kendo().Grid<iLgs.Models.RisItemUnitGroupAvailableVM>()
                    .Name("gridItemAvailable")
                    .Columns(col =>
                    {
                        col.Select().Width(30);
                        col.Bound(c => c.PsNo).Width(50);
                        col.Bound(c => c.ItemName).Width(70);
                        col.Bound(c => c.Description).Width(120);
                        col.Bound(c => c.Unit).Width(50);
                        col.Bound(c => c.QtyRequest).Width(50);
                    })
                    //.Editable(editable => editable.Mode(GridEditMode.InCell))
                    //.Sortable()
                    .PersistSelection(true)
                    .NoRecords()
                    .Navigatable()
                    .Scrollable(s => s.Height(200))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        //.Batch(true)
                        //.Sort(s => s.Add(a => a.ItemNo))
                        .ServerOperation(true)
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        })
                        .Read(read => read.Action("_RISItemAvailableUnitGroupItemRead", "RIS").Data("DataItemAvailableGrid"))                        
                    )
                    //.Selectable(s => s.Mode(GridSelectionMode.Single))
                    .Events(e => e.Change("onChangeGridItemAvailable"))
                    //.AutoBind(false)
                )
            </div>
        </div>
    </fieldset>
}







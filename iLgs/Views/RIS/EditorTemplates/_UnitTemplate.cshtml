@(Html.Kendo().MultiColumnComboBoxFor(m => m)
    .Name("Unit")
    .Placeholder("Select unit")
    .DataTextField("Description")
    .DataValueField("Code")
    .ValuePrimitive(true)
    .Filter(FilterType.Contains)
    .DataSource(source =>
    {
        source.Read(read =>
        {
            read.Action("GetCodes", "Getters", new { mastCode = "UNIT-GROUP", text = "" });
        })
        .ServerFiltering(true);
    })
    .Columns(c =>
    {
        c.Add().Field("Description").Title("Unit").Width("100%");

    })
    .Suggest(true)
)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    @Html.LabelFor(model => model.IssuedBy, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.IssuedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Issued By")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodes", "Getters", new { mastCode = "CASH-AVAILABLE" });

                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select PO No.")
                            .DataTextField("PoNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPoNosWithoutRis", "Getters").Data("DataOrderId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PoNo").Title("PO No.").Width("30%");
                                c.Add().Template("#= kendo.toString(kendo.parseDate(PoDate), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectOrderId"); })
                    //.Suggest(true)
                        )
                        @Html.ValidationMessageFor(model => model.OrderId)
                    </div>
                </div>

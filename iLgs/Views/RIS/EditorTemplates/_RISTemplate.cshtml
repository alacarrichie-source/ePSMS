@model iLgs.Models.RISlipVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)
    
    <fieldset>
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.RisNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.RisNo).Placeholder("(AUTO)").HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.RisNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.RisDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.RisDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RisDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.OrderId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select PO No.")
                            .DataTextField("PoNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRisPoNos", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PoNo").Title("PO No.").Width("30%");
                                c.Add().Template("#= kendo.toString(new Date(parseInt(PoDate.substr(6))), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectOrderId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.OrderId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PoDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PoDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Division, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Division).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Office, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Office).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Fund).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.FPP, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.FPP).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.FPP)
                </div>
            </div>
        </div>

        <br />

        <div class="row clearfix">
            <div class="col-md-6">
                <section id="requsted-by" class="card ra-section">
                    <div class="card-header">Requested by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.RequestedBy, "Name", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.RequestedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.RequestedByDesignation, "Designation", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.RequestedByDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.RequestedDate, "Date", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.RequestedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>                                            
                    </div>
                </section>
            </div>

            <div class="col-md-6">
                <section id="approved-by" class="card ra-section">
                    <div class="card-header">Approved by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ApprovedBy, "Name", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.ApprovedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ApprovedByDesignation, "Designation", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.ApprovedByDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ApprovedDate, "Date", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.ApprovedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="row clearfix">
            <div class="col-md-6">
                <section id="issued-by" class="card ra-section">
                    <div class="card-header">Issued by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedBy, "Name", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.IssuedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedByDesignation, "Designation", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.IssuedByDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.IssuedDate, "Date", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-md-6">
                <section id="received-by" class="card ra-section">
                    <div class="card-header">Received by</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedBy, "Name", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.ReceivedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedByDesignation, "Designation", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.ReceivedByDesignation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.ReceivedDate, "Date", htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.ReceivedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

    </fieldset>
}


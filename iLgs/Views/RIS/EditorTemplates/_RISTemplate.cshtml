                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectRequestedBy"); })
                            .Suggest(true)
                            .CascadeFrom("Office")
                        )
                        @Html.ValidationMessageFor(model => model.RequestedBy)
                    </div>
                </div>
                <div class="col-md-4">
                    @Html.LabelFor(model => model.RequestedByDesignation, htmlAttributes: new { @class = "col-md-12" })

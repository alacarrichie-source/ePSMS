                <div class="col-md-4">
                    @Html.LabelFor(model => model.IssuedByDesignation, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.IssuedByDesignation).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.IssuedByDesignation)

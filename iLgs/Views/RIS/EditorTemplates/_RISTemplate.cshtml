@model iLgs.Models.RIS_VM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.IssuanceSw)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>
    @*<p>Posted : @Model.IsPosted </p>
    <p>Ris : @Model.RisNo </p>
    @Html.TextBoxFor(m => m.IsPosted)*@ 
        <fieldset>
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(model => model.Fund)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RisNo, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.RisNo).Placeholder("(AUTO)").Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.RisNo)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RisDate, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().DatePickerFor(model => model.RisDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.RisDate)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Office, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.Office)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Office")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(model => model.Office)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Division, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.Division)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Division")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetSections", "Getters").Data("DataDivision");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                            .CascadeFrom("Office")
                        )
                        @Html.ValidationMessageFor(model => model.Division)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FPP, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.FPP)

            <div class="col-md-4">
                @Html.LabelFor(model => model.QtyRequest, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyRequest).Decimals(0).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyRequest)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.QtyIssue, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyIssue).Decimals(0).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyIssue)

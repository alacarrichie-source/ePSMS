@model iLgs.Models.RisItemEntryVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RisId)
    @Html.HiddenFor(model => model.PsNo)
    @Html.HiddenFor(model => model.PsType)
    @Html.HiddenFor(model => model.ItemType)
    @Html.HiddenFor(model => model.ItemCode)
    @Html.HiddenFor(model => model.SubAccountCode)
    @Html.HiddenFor(model => model.GridRisItemExtns)
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemCodeId, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ItemCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Item")
                        .DataTextField("Description")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetItemAccounts", "Items");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            //c.Add().Field("Code").Title("Code").Width("15%").Template("#= columnTemplate(data.Code) #");
                            //c.Add().Field("TypeDesc").Title("Account").Width("25%").Template("#= columnTemplate(data.TypeDesc) #");
                            //c.Add().Field("MainDesc").Title("Sub-Account").Width("35%").Template("#= columnTemplate(data.MainDesc) #");
                            //c.Add().Field("Description").Title("Article").Width("25%").Template("#= columnTemplate(data.Description) #");
                            c.Add().Field("Code").Title("Code").Width("10%").Template("#= columnTemplate(data.Code) #");
                            c.Add().Field("TypeDesc").Title("Account").Width("15%").Template("#= columnTemplate(data.TypeDesc) #");
                            c.Add().Field("SubAccount1").Title("Sub-Account1").Width("15%").Template("#= columnTemplate(data.SubAccount1) #");
                            c.Add().Field("SubAccount2").Title("Sub-Account2").Width("15%").Template("#= columnTemplate(data.SubAccount2) #");
                            c.Add().Field("SubAccount3").Title("Sub-Account3").Width("15%").Template("#= columnTemplate(data.SubAccount3) #");
                            c.Add().Field("SubAccount4").Title("Sub-Account4").Width("15%").Template("#= columnTemplate(data.SubAccount4) #");
                            c.Add().Field("Article").Title("Article").Width("15%").Template("#= columnTemplate(data.Article) #");
                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectItemCode").DataBound("onDataBoundItemCode"); })
                    )
                    @Html.ValidationMessageFor(m => m.ItemCodeId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.SubAccount, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.SubAccount).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PsTypeDesc, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.PsTypeDesc).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                </div>
            </div>
        </div>

        <div id="DIV_ALLFIELDS">

        </div>

        
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextAreaFor(m => m.Description).Rows(5).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.OtherDesc, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextAreaFor(m => m.OtherDesc).Rows(2).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.OtherDesc)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Unit, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Unit)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select unit")
                        .DataTextField("Description")
                        .DataValueField("Code")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetCodes", "Getters", new { mastCode = "UNIT", text = "" });
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Description").Title("Unit").Width("100%");

                        })
                        .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.Unit)
                </div>
            </div>            
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.QtyRequest, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyRequest).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyRequest)
                </div>
            </div>            
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.QtyIssue, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyIssue).Decimals(0).Format("{0:n0}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyIssue)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Remarks).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>

    </fieldset>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        //var grid = $("#gridItemExtn").data("kendoGrid");

        //// Get all data items (rows) in the Grid
        //var dataItems = grid.dataItems();

        //// Create an array to store the row values
        //var rowValues = [];

        //// Iterate over each data item (row) and extract the values
        //for (var i = 0; i < dataItems.length; i++) {
        //    var row = dataItems[i];
        //    rowValues.push(row);
        //}

        //$("#GridRisItemExtns").val(JSON.stringify(rowValues)).trigger("change");


        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            var data = $("#form").serialize();
            $.ajax({
                type: "POST",
                url: '@Url.Action("_RISItemSave", "RIS")',
                data: data,
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>

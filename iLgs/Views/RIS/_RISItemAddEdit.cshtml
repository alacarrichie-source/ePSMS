@model iLgs.Models.RisItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RisId)
    @Html.HiddenFor(model => model.PsNo)
    @Html.HiddenFor(model => model.PsType)
    @Html.HiddenFor(model => model.ItemCode)
    @Html.HiddenFor(model => model.GridRisItemExtns)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemCodeId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ItemCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select Item Code")
                        .DataTextField("Code")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetItems", "Items");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("ItemNo").Title("Item No.").Width("10%");
                            c.Add().Field("Code").Title("Code").Width("10%");
                            c.Add().Field("MainDesc").Title("Group").Width("40%");
                            c.Add().Field("Description").Title("Type").Width("40%");                            
                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectItemCode").DataBound("onDataBoundItemCode"); })
                    )
                    @Html.ValidationMessageFor(m => m.ItemCodeId)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemType, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemType).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemName, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.ItemName).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ItemName)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextAreaFor(m => m.Description).Rows(2).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().Grid<iLgs.Models.RisItemExtnVM>()
                    .Name("gridItemExtn")
                    .Columns(col =>
                    {
                        col.Bound(c => c.ItemNo).Width(50);
                        col.Bound(c => c.ItemKey).Width(70);
                        col.Bound(c => c.ItemValue).Width(120);
                        col.Bound(c => c.Sequence).Width(50);
                    })
                    .Editable(editable => editable.Mode(GridEditMode.InCell))
                    .Sortable()
                    .NoRecords()
                    .Navigatable()
                    .Scrollable(s => s.Height(130))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Batch(true)
                        .Sort(s => s.Add(a => a.ItemNo))
                        .ServerOperation(true)
                        .Model(model =>
                        {
                            model.Id(p => p.Id);
                            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                            model.Field(p => p.ItemNo).Editable(false);
                            model.Field(p => p.ItemKey).Editable(false);                            
                        })
                        .Read(read => read.Action("_RISItemExtnBatchRead", "RIS").Data("DataRisItemExtnGrid"))
                    )
                    .Selectable(s => s.Mode(GridSelectionMode.Single))
                    .Events(e => e.Save("onSaveGridItemExtn").DataBound("onDataBoundGridItemExtn"))
                    .AutoBind(false)
                )
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-4">
                @Html.LabelFor(m => m.Unit, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Unit)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select unit")
                        .DataTextField("Description")
                        .DataValueField("Code")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetCodes", "Getters", new { mastCode = "UNIT", text = "" });
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Description").Title("Unit").Width("100%");

                        })
                        .Suggest(true)                        
                    )
                    @Html.ValidationMessageFor(m => m.Unit)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.QtyRequest, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyRequest).Decimals(0).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyRequest)
                </div>
            </div>
            <div class="col-md-4">
                @Html.LabelFor(model => model.QtyIssue, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().NumericTextBoxFor(model => model.QtyIssue).Decimals(0).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.QtyIssue)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Remarks, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Remarks).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>            
        </div>

        <br />
        <div class="row">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>

    </fieldset>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        var grid = $("#gridItemExtn").data("kendoGrid");

        // Get all data items (rows) in the Grid
        var dataItems = grid.dataItems();

        // Create an array to store the row values
        var rowValues = [];

        // Iterate over each data item (row) and extract the values
        for (var i = 0; i < dataItems.length; i++) {
            var row = dataItems[i];
            rowValues.push(row);
        }
        
        $("#GridRisItemExtns").val(JSON.stringify(rowValues)).trigger("change");

        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("_RISItemSave", "RIS")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>

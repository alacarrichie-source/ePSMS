@(Html.Kendo().Grid<iLgs.Models.RisItemUnitGroupVM>()
        .Name("gridItemUnitGroups_" + @ViewData["risId"])
        .Columns(col =>
        {
            col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")                
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Unit).EditorTemplateName("_UnitTemplate").Width(100);
            col.Bound(c => c.InsertedDt).Width(100);
            col.Command(command =>
            {
                //command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditRisItemUnitGroup");
                command.Edit();
                command.Destroy();
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create();
            @*t.Template(@<text>
            @(Html.Kendo().Button().Name("btnAddItemUnitGroup_" + ViewData["risId"]).Content("Add Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddRisItemGroup")))
            </text>);*@
        })
        .Editable(e => e.Mode(GridEditMode.InLine))
        //.Pageable(pager => pager
        //    .Input(false)
        //    .Numeric(true)
        //    .Info(true)
        //    .PreviousNext(true)
        //    .Refresh(true)
        //    .PageSizes(true)
        //    .ButtonCount(5)
        //)
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("GroupDescriptions")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("InlineGridUnitGroupError").RequestEnd("onGridItemUnitGroupsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.RisId).DefaultValue(@ViewData["risId"]);
                model.Field(p => p.InsertedDt).Editable(false);
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_RISItemUnitGroupRead", "RIS", new { risId = @ViewData["risId"] }))
            .Create(create => create.Action("_RISItemUnitGroupCreate", "RIS"))
            .Update(update => update.Action("_RISItemUnitGroupUpdate", "RIS"))
            .Destroy(destroy => destroy.Action("_RISItemUnitGroupDestroy", "RIS"))
        )
        .Events(events => events
            .Change("onChangeGridItemUnitGroups")
            .Edit("onEditGridItemUnitGroups")
            .DataBound("onDataBoundGridItemUnitGroups")
        )
        .AutoBind(true)
)



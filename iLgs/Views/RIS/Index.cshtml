    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            selectedId = null;
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetModelDefault", "Requisitions")',
                success: function (result) {
                    //var date = kendo.toString(kendo.parseDate(result.model.RisDate), 'MM/dd/yyyy');
                    //var datePicker = $("#RisDate").data("kendoDatePicker");
                    //datePicker.value(date);
                    //datePicker.trigger("change");

                    $("#IssuedBy").data("kendoMultiColumnComboBox").value(result.model.IssuedBy);
                    $("#IssuedBy").data("kendoMultiColumnComboBox").trigger("change");
                    $("#IssuedByDesignation").val(result.model.IssuedByDesignation);
                    $("#IssuedByDesignation").trigger("change");

                    disabled.attr('disabled', 'disabled')
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //var combo = $("#OrderId").data("kendoMultiColumnComboBox");
            //if (combo) {
            //    combo.enable(false);
            //}
        }

        var department = $("#RisWizardDepartment").data("kendoDropDownList");
        var combo = $("#OrderRequestId").data("kendoMultiColumnComboBox");
        if (department && combo) {
            department.value(e.model.Office || "");
            combo.enable(!!department.value());
            if (department.value()) {
                combo.dataSource.read(DataOrderRequestId()).then(function () {
                    combo.value(e.model.OrderRequestId || "");
                });
            }
        }
    }

    function onClickIssue(e) {
        e.preventDefault();
        selectedGrid = this;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));

        // Remove the "selected" class from all rows
        selectedGrid.table.find("tr").removeClass("selected");

        // Add the "selected" class to the clicked row
        $(e.currentTarget).closest("tr").addClass("selected");
        selectedId = dataItem.Id;
        dataItem.set("IssuanceSw", true);
        selectedGrid.editRow(dataItem);
    }

    function onGridDeleteClickOld(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedGrid.removeRow(tr);
        //selectedGrid.dataSource.sync();
    }

    function onGridDeleteClick(e) {
        e.preventDefault();

        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);

        // Select the row first
        selectedGrid.select(tr);

        // Allow Kendo/browser to visually update the selection
        setTimeout(function () {

            risConfirm("Delete RIS", "Delete this draft RIS? Source purchase and requisition records will be preserved.", function () {
                selectedGrid.dataSource.remove(dataItem);
                selectedGrid.dataSource.sync();
            });

        }, 0);
    }

    function onRequestEndOld(e) {
        //e.preventDefault();
        alert(e.type);
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;

                if (selectedId) {

                    var grid = $("#grid").data("kendoGrid");

                    // Trigger a read operation on the data source.
                    grid.dataSource.read().then(function () {
                        // Additional actions to be performed after the read operation.

                        // Find the row with the specified Id.
                        var dataItem = grid.dataSource.get(selectedId);

                        // If the row is found, expand it.
                        if (dataItem) {
                            var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                            grid.expandRow(row);
                        }
                    });
                }
            }
        }
    }

    function onRequestEnd(e) {
        if (e.response && e.response.Errors) {
            return;
        }

        if (e.type === "create") {

            var responseData = e.response;
            var newRecord = responseData.Data[0];
            selectedId = newRecord.Id;

            var grid = $("#grid").data("kendoGrid");

            grid.dataSource.read().then(function () {

                var dataItem = grid.dataSource.get(selectedId);

                if (dataItem) {
                    var row = grid.tbody.find(
                        "tr[data-uid='" + dataItem.uid + "']"
                    );

                    grid.expandRow(row);
                }
            });
        }
        else if (e.type === "destroy" || e.type === "update") {
            selectedGrid.dataSource.read();
        }
    }


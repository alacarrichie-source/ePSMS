<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedId_OrderId = null;
    var selecteItemId = null;

    function IncludeDisabled(options)
    {
        options.includeDisabled = true;
        return options;        
    }

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedId_OrderId = selectedData.OrderId;
        selectedItemId = null;
        //$("#gridItems").data("kendoGrid").dataSource.read();
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }        
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // Grid Item

    function ItemData() {
        return {
            risId: selectedId
        };
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;
            e.model.set("RisId", selectedId);
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function DataOrderItemId() {
        var text = $("#OrderItemId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OrderItemId").data("kendoMultiColumnComboBox").value();
        }
        return {
            orderId: selectedId_OrderId,
            text: text
        };
    }

    function onSelectOrderItemId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PsItem").val(dataItem.Name).trigger("change");
        $("#PsUnit").val(dataItem.Unit).trigger("change");
        $("#PsCode").val(dataItem.Code).trigger("change");
        $("#OrderDescription").val(dataItem.Description).trigger("change");

        $("#Qty").data("kendoNumericTextBox").value(dataItem.Qty);
        $("#Qty").data("kendoNumericTextBox").trigger("change");
    }

    function DataSupplierId() {
        var text = $("#SupplierId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#SupplierId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onSelectOrderId(e) {
        var dataItem = this.dataItem(e.item.index());
        var poDate = kendo.toString(new Date(parseInt(dataItem.PoDate.substr(6))), 'MM/dd/yyyy');
        $("#Supplier").val(dataItem.Supplier).trigger("change");
        $("#PoDate").val(poDate).trigger("change");
        $("#Division").val(dataItem.Section).trigger("change");
        $("#Office").val(dataItem.Department).trigger("change");
        $("#Fund").val(dataItem.Fund).trigger("change");
        $("#FPP").val(dataItem.FPP).trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#Amount").data("kendoNumericTextBox").value(amount);
        $("#Amount").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
            }
        }
    }
</script>



@{
    ViewBag.Title = "Requisition and Issue Slips";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="epsms-ris ris-index">
    <div class="ris-page-header">
        <div>
            <h1>Requisition and Issue Slips</h1>
            <p>Manage requisitions, track their status, and prepare items for issuance.</p>
        </div>
        <div class="ris-header-actions">
            <button type="button" class="k-button" id="risRefresh"><span class="k-icon k-i-reload"></span>Refresh</button>
            <button type="button" class="k-button" id="risExport"><span class="k-icon k-i-excel"></span>Export</button>
            <button type="button" class="k-button k-primary" id="risCreate"><span class="k-icon k-i-plus"></span>Create RIS</button>
        </div>
    </div>

    <div class="ris-kpis">
        <div class="ris-kpi"><span>Total RIS</span><strong id="kpiTotal">0</strong></div>
        <div class="ris-kpi"><span>Draft</span><strong id="kpiDraft">0</strong></div>
        <div class="ris-kpi"><span>Unposted / For Posting</span><strong id="kpiUnposted">0</strong></div>
        <div class="ris-kpi ris-kpi-posted"><span>Posted</span><strong id="kpiPosted">0</strong></div>
    </div>

    <div class="ris-filter-panel">
        <div class="ris-filter-field ris-filter-search"><label for="risSearch">Search</label><input id="risSearch" class="k-textbox" placeholder="RIS no., office, purpose, requested by" /></div>
        <div class="ris-filter-field"><label for="risStatus">Status</label><select id="risStatus"><option>All</option><option>Draft</option><option>Unposted</option><option>Posted</option></select></div>
        <div class="ris-filter-field"><label for="risDepartment">Department / Office</label><select id="risDepartment"><option value="">All departments</option></select></div>
        <div class="ris-filter-field"><label for="risFund">Fund</label><select id="risFund"><option value="">All funds</option></select></div>
        <div class="ris-filter-field"><label for="risFrom">From date</label><input id="risFrom" /></div>
        <div class="ris-filter-field"><label for="risTo">To date</label><input id="risTo" /></div>
        <div class="ris-filter-actions"><button type="button" class="k-button k-primary" id="risApply">Apply Filters</button><button type="button" class="k-button" id="risReset">Reset</button></div>
    </div>

    <div class="ris-grid-surface">
@(Html.Kendo().Grid<iLgs.Models.RIS_VM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "ris-master-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.RisNo).Title("RIS No.").ClientTemplate("#= RisNo ? kendo.htmlEncode(RisNo) : '<span class=\"ris-pending\">Pending RIS No.</span>' #").Width(145);
        col.Bound(c => c.RisDate).Title("RIS Date").Format("{0:MMM dd, yyyy}").Width(115);
        col.Bound(c => c.Office).Title("Department / Office").ClientTemplate("<span class=\"ris-wrap\">#= Office ? kendo.htmlEncode(Office) : '' #</span>").Width(210);
        col.Bound(c => c.Fund).Width(120);
        col.Bound(c => c.RequestedBy).Title("Requested By").Width(170);
        col.Bound(c => c.TotalQtyRequested).Title("Total Qty Requested").Format("{0:n2}").HtmlAttributes(new { @class = "ris-number" }).HeaderHtmlAttributes(new { @class = "ris-number" }).Width(135);
        col.Bound(c => c.Status).ClientTemplate("<span class=\"ris-status ris-status-#= Status.toLowerCase() #\">#= Status #</span>").Width(100);
        col.Bound(c => c.UpdatedDt).Title("Last Updated").Format("{0:MMM dd, yyyy hh:mm tt}").Width(165);
        col.Command(command =>
        {
            command.Edit().Text("Edit").Visible("CanEditRis");
            command.Custom("Manage").Text("Manage Requisition").Click("manageRis").Visible("CanEditRis");
            command.Custom("PostRIS").Text("Post").Click("postRisRow").Visible("CanPostRis");
            command.Custom("ViewRIS").Text("View").Click("manageRis").Visible("CanUnpostRis");
            command.Custom("UnpostRIS").Text("Unpost").Click("unpostRisRow").Visible("CanUnpostRis");
            command.Custom("PrintRIS").Text("Print").Click("printRisRow").Visible("CanUnpostRis");
            command.Custom("Delete").Text("Delete").Click("onGridDeleteClick").Visible("CanDeleteRis");
        }).Title("Actions").Width(270);
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RISTemplate").Window(w => w.Width(800).Title("Requisition and Issue Slip")))
    .Pageable(pager => pager.PageSizes(new[] { 10, 25, 50, 100 }).Refresh(true).ButtonCount(5))
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Sortable()
    .Excel(excel => excel.FileName("RIS-Master-Index.xlsx").Filterable(true).AllPages(true))
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource.Ajax().PageSize(25)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model => { model.Id(p => p.Id); model.Field(p => p.Id).DefaultValue(Guid.Empty); })
        .Sort(s => s.Add(a => a.UpdatedDt).Descending())
        .Read(read => read.Action("Read", "Requisitions").Data("risGridReadData"))
        .Create(create => create.Action("Create", "Requisitions"))
        .Update(update => update.Action("Update", "Requisitions"))
        .Destroy(destroy => destroy.Action("Delete", "Requisitions")))
    .Events(events => events.Change("onChangeGrid").Edit("onEditGrid").DataBound("onDataBoundGrid"))
)
    </div>
</div>
<script id="Details" type="text/kendo-tmpl">

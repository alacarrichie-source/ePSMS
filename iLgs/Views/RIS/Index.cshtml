    function onClickDeleteGridItem(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function DataOrderRequestId() {
        var text = $("#OrderRequestId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#OrderRequestId").data("kendoMultiColumnComboBox").value();
        }
        return {
            risId: selectedId,
            department: $("#RisWizardDepartment").val() || $("#Office").val(),
            text: text
        };
    }

    function onRisWizardDepartmentChange() {
        var po = $("#OrderRequestId").data("kendoMultiColumnComboBox");
        if (po) {
            po.value("");
            po.dataSource.read();
            po.enable(!!this.value());
        }
    }

    function onSelectOrderRequestId(e) {
        var dataItem = this.dataItem(e.item.index());
        //var poDate = kendo.parseDate(dataItem.PoDate);
        var poDate = kendo.toString(kendo.parseDate(dataItem.PoDate), 'MM/dd/yyyy')

        //$("#PoNo").val(dataItem.PoNo).trigger("change");
        $("#PoDate").val(poDate).trigger("change");
        $("#Fund").val(dataItem.Fund).trigger("change");
        $("#FPP").val(dataItem.FPP).trigger("change");
        //$("#OfficeId").val(dataItem.DeptId);
        //$("#OfficeDesc").val(dataItem.DeptDesc).trigger("change");

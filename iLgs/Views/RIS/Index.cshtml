    function RisItem(mode, recId) {
        var myTitle = (mode == "A") ? "RIS Item - ADD" : "RIS Item - EDIT";
        var width = 800;
        var height = 550;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_RISItemAddEdit", "RIS")',
            data: {
                risId: selectedId,
                risItemId: recId
            }
        });
        mywindow.center();
        mywindow.open();
    }


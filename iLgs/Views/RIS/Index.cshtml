    $(".k-grid-btnPostRIS").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Request already posted by " + postedBy);
        }
        else {
            var msg = "Post RIS Number " + selectedRisNo + "?";

            if (confirm(msg)) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostRIS", "RIS")',
                    data: { risId: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                    }
                });
            }
        }
    });


@{
    ViewBag.Title = "Requisition and Issue Slip";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div id="master-details-main-content" class="main-section-content">
    @*<style>
        .k-grid-content {
            height: 100%;
        }

        html, body {
            height: 100%;
        }

        .main-section-content {
            height: calc(100% - (100px + 50px)); /* replace with the height of your header and footer elements */
            overflow: auto;
        }
    </style>*@
    <script>
        //resizeGrid();

        $(window).on("resize", function () {
            //var containerWidth = $(".sparkline-container").parent().width();
            //var sparkLineWidth = (80 * containerWidth) / 100;
            //$(".k-sparkline").data("kendoSparkline").setOptions({ chartArea: { width: sparkLineWidth } });            
            resizeGrid();
        });

        function resizeGrid() {
            var gridElement = $("#grid"),
                dataArea = gridElement.find(".k-grid-content"),
                gridHeight = gridElement.innerHeight(),
                otherElements = gridElement.children().not(".k-grid-content"),
                otherElementsHeight = 0;
            otherElements.each(function () {
                otherElementsHeight += $(this).outerHeight();
            });
            dataArea.height(gridHeight - otherElementsHeight);            
        }
    </script>
    @(Html.Kendo().Grid<iLgs.Models.RISlipVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.RisNo).Width(100);
        col.Bound(c => c.RisDate).Width(100);
        col.Bound(c => c.PoNo).Width(100);
        col.Bound(c => c.PoDate).Width(100);
        col.Bound(c => c.Office).Width(100);
        col.Bound(c => c.Fund).Width(100);
        col.Bound(c => c.FPP).Width(100);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Record");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RISTemplate").Window(w => w.Width(800).Title("Requisition and Issue")))
    .Search(s =>
    {
        s.Field(o => o.RisNo, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.Office, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.FPP, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    //.HtmlAttributes(new { style = "height: 100%;" })
    //.Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            model.Field(p => p.Division).Editable(true);
            model.Field(p => p.Office).Editable(true);
            model.Field(p => p.Fund).Editable(true);
            model.Field(p => p.FPP).Editable(true);
        })
        .Read(read => read.Action("RISRead", "RIS"))
        .Create(create => create.Action("RISCreate", "RIS").Data("IncludeDisabled"))
        .Update(update => update.Action("RISUpdate", "RIS"))
        .Destroy(destroy => destroy.Action("RISDestroy", "RIS"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )
</div>



<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add()
                .Text("ITEMS")
                .Selected(true)
                .Content(@<text>
                    @RenderItems()
                </text>);
        })
        .ToClientTemplate()
    )
</script>

@helper RenderItems()
{
    @(Html.Kendo().Grid<iLgs.Models.RISlipItemVM>()
        .Name("gridItems_#=Id#")
        .Columns(col =>
        {
            col.Bound(c => c.StockNo).Width(70);
            col.Bound(c => c.Unit).Width(50);
            col.Bound(c => c.Description).Width(150);
            col.Group(group => group.Title("Quantity")
                .Columns(info =>
                {
                    col.Bound(c => c.ReqQty)
                        .Width(70).Title("Request")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    col.Bound(c => c.IssQty)
                        .Width(70).Title("Issued")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                        .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
            col.Bound(c => c.UnitCost).Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.Amount).Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(172);
        })            
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        //.Scrollable(s => s.Height(150))
        .Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()          
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.StockNo).Editable(false);
                model.Field(p => p.Unit).Editable(false);
                model.Field(p => p.Description).Editable(false);
                model.Field(p => p.ReqQty).Editable(false);
                model.Field(p => p.UnitCost).Editable(false);
                model.Field(p => p.Amount).Editable(false);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.ReqQty).Sum();
                a.Add(p => p.IssQty).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_RISlipItemRead", "RIS").Data("ItemData"))
            .Update(update => update.Action("_RISlipItemUpdate", "RIS"))
            .Destroy(destroy => destroy.Action("_RISlipItemDestroy", "RIS"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
        .AutoBind(true)
        .ToClientTemplate()
    )
}


    function RisItem(mode, recId) {
        var myTitle = (mode == "A") ? "RIS Item - ADD" : "RIS Item - EDIT";
        var width = 1000;
        var height = 650;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    //autoCenter: true, // Set autoCenter to true
                    //position: { top: '50%' },
                    close: function () {
                        $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
            //height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_RISItemAddEdit", "RIS")',
            data: {
                risId: selectedId,
                risItemId: recId
            },
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        //mywindow.center();
        mywindow.open();
        //setTimeout(resizeWindow(), 300);
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }


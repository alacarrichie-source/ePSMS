<script>
function risGridReadData(){return{search:$("#risSearch").val(),status:$("#risStatus").val(),department:$("#risDepartment").val(),fund:$("#risFund").val(),fromDate:$("#risFrom").val(),toDate:$("#risTo").val()};}
function CanEditRis(x){return x.CanEdit===true;} function CanDeleteRis(x){return x.CanDelete===true;} function CanPostRis(x){return x.CanPost===true;} function CanUnpostRis(x){return x.CanUnpost===true;}
function selectRisRow(grid,e){var row=$(e.currentTarget).closest("tr");grid.select(row);return grid.dataItem(row);}
function manageRis(e){e.preventDefault();var row=$(e.currentTarget).closest("tr");selectRisRow(this,e);this.expandRow(row);}
function postRisRow(e){e.preventDefault();var x=selectRisRow(this,e);risCommand("Post RIS","Post this RIS and assign its permanent RIS number?","@Url.Action("Post", "Requisitions")",x.Id);}
function unpostRisRow(e){e.preventDefault();var x=selectRisRow(this,e);risCommand("Unpost RIS","Reverse posting and return this RIS to an editable state?","@Url.Action("Unpost", "Requisitions")",x.Id);}
function printRisRow(e){e.preventDefault();var x=selectRisRow(this,e);window.open("@Url.Action("Print", "Requisitions")?ctrlNo="+encodeURIComponent(x.CtrlNo),"_blank");}
function risConfirm(title,message,ok){var h=$("<div><div class='ris-confirm-message'></div><div class='ris-confirm-actions'><button class='k-button ris-no'>Cancel</button><button class='k-button k-primary ris-yes'>Continue</button></div></div>");h.find(".ris-confirm-message").text(message);$("body").append(h);var w=h.kendoWindow({title:title,modal:true,visible:false,resizable:false,width:430,deactivate:function(){this.destroy();}}).data("kendoWindow");h.on("click",".ris-no",function(){w.close();});h.on("click",".ris-yes",function(){w.close();ok();});w.center().open();}
function risCommand(title,message,url,id){risConfirm(title,message,function(){window.kendo.ui.progress($(document.body),true);$.post(url,{risId:id}).done(function(r){if(r.Errors&&r.Errors.length){alert($.isArray(r.Errors)?r.Errors.join("\n"):r.Errors);}else{$("#grid").data("kendoGrid").dataSource.read();refreshRisSummary();$("#risNotification").data("kendoNotification").show(title + " completed successfully.","success");}}).fail(function(x){alert(x.responseText||"The operation could not be completed.");}).always(function(){window.kendo.ui.progress($(document.body),false);});});}
function refreshRisSummary(){$.getJSON("@Url.Action("Summary", "Requisitions")",risGridReadData(),function(x){$("#kpiTotal").text(x.Total);$("#kpiDraft").text(x.Draft);$("#kpiUnposted").text(x.Unposted);$("#kpiPosted").text(x.Posted);});}
$(function(){
 $("#risStatus,#risDepartment,#risFund").kendoDropDownList();$("#risFrom,#risTo").kendoDatePicker({format:"MMM dd, yyyy"});
 $.getJSON("@Url.Action("FilterOptions", "Requisitions")",function(x){var d=$("#risDepartment").data("kendoDropDownList"),f=$("#risFund").data("kendoDropDownList");d.setDataSource([{text:"All departments",value:""}].concat($.map(x.Departments,function(v){return{text:v,value:v};})));d.setOptions({dataTextField:"text",dataValueField:"value"});f.setDataSource([{text:"All funds",value:""}].concat($.map(x.Funds,function(v){return{text:v,value:v};})));f.setOptions({dataTextField:"text",dataValueField:"value"});});
 $("#risApply").click(function(){$("#grid").data("kendoGrid").dataSource.page(1);refreshRisSummary();});$("#risReset").click(function(){$("#risSearch").val("");$("#risStatus").data("kendoDropDownList").select(0);$("#risDepartment").data("kendoDropDownList").select(0);$("#risFund").data("kendoDropDownList").select(0);$("#risFrom").data("kendoDatePicker").value(null);$("#risTo").data("kendoDatePicker").value(null);$("#risApply").click();});
 $("#risRefresh").click(function(){$("#grid").data("kendoGrid").dataSource.read();refreshRisSummary();});$("#risCreate").click(function(){$("#grid").data("kendoGrid").addRow();});$("#risExport").click(function(){$("#grid").data("kendoGrid").saveAsExcel();});$("#risSearch").keydown(function(e){if(e.which===13)$("#risApply").click();});refreshRisSummary();
});
</script>

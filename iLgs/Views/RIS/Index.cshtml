@{
    ViewBag.Title = "Requisition and Issue Slip";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.RIS_VM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        //col.Bound(c => c.Id);
        col.Bound(c => c.Fund).Width(50);
        col.Bound(c => c.RisNo).Width(70);
        col.Bound(c => c.RisDate).Width(70);
        col.Bound(c => c.Office).Width(100);
        col.Bound(c => c.FPP).Width(70);
        col.Bound(c => c.RequestedBy).Width(100);
        col.Bound(c => c.ApprovedBy).Width(100);
        col.Bound(c => c.IssuedBy).Width(100);
        col.Bound(c => c.ReceivedBy).Width(100);
        col.Bound(c => c.PostedBy).Width(100);
        //col.Bound(c => c.IsPosted).Width(30);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true).Visible("IsNotPosted"); 
            command.Custom("Issue").IconClass("k-icon k-i-book").Click("onClickIssue").Visible("CheckPostedBy");
        }).Width(170);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        t.Custom().Text("Print - Issuance by GSO").IconClass("k-icon k-i-print").Name("btnPrintRIS").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Print - Issuance by Department").IconClass("k-icon k-i-print").Name("btnPrintRIS2").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPostRIS").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostRIS").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Issue").IconClass("k-icon k-i-unlock").Name("btnIssueRIS").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Remove Issuance").IconClass("k-icon k-i-unlock").Name("btnRemoveIssueRIS").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RISTemplate").Window(w => w.Width(800).Title("Requisition and Issue Slip")))
    .Search(s =>
    {
        s.Field(o => o.RisNo, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.Office, "contains");
        s.Field(o => o.FPP, "contains");
        s.Field(o => o.RequestedBy, "contains");
        s.Field(o => o.IssuedBy, "contains");
        s.Field(o => o.ApprovedBy, "contains");
        s.Field(o => o.ReceivedBy, "contains");
        s.Field(o => o.PostedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    //.Scrollable(s => s.Height(430))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("RISRead", "RIS"))
        .Create(create => create.Action("RISCreate", "RIS"))
        .Update(update => update.Action("RISUpdate", "RIS"))
        .Destroy(destroy => destroy.Action("RISDestroy", "RIS"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            //.HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .Events(e => e.Select("onSelectTabStrip"))
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Items")
                    .Selected(true)
                    .LoadContentFrom("_RISItem", "RIS", new { risId = "#=Id#" });
                items.Add().Text("Groups")
                    .Selected(true)
                    .LoadContentFrom("_RISItemUnitGroup", "RIS", new { risId = "#=Id#" });
            }).ToClientTemplate())
</script>


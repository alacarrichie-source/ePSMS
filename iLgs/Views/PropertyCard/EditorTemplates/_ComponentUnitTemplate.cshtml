@model iLgs.Models.PropertyCardUnitVM

<div class="pc-unit-editor p-3">
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.PsCardItemId)
    @Html.HiddenFor(m => m.PsCardSubItemId)

    <div class="pc-popup-validation alert alert-danger" style="display:none;" role="alert"></div>
    <div id="pcCompUnitAccountableAlert" class="alert alert-warning" style="display: none;">
        <i class="fa fa-lock"></i> <strong>Assigned to PAR/ICS:</strong> Identity fields (Property No., Serial No.) are locked.
    </div>

    <div class="form-group row mb-2">
        <label class="col-sm-3 col-form-label font-weight-bold">Serial No. <span class="text-danger">*</span></label>
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.SerialNo, new { style = "width:100%; max-width: 100%;", @class = "k-textbox w-100", required = "required", placeholder = "e.g. SN-123456" })
            @Html.ValidationMessageFor(m => m.SerialNo)
        </div>
    </div>

    @*<div class="form-group row mb-2">
        <label class="col-sm-3 col-form-label">Property No.</label>
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.PropertyNo, new { @class = "k-textbox w-100", placeholder = "Optional property sticker / code" })
        </div>
    </div>

    <div class="form-group row mb-2">
        <label class="col-sm-3 col-form-label">Custodian Item No.</label>
        <div class="col-sm-9">
            @Html.TextBoxFor(m => m.CustItemNo, new { @class = "k-textbox w-100", placeholder = "Optional custodian tracking No." })
        </div>
    </div>

    <div class="form-group row mb-2">
        <label class="col-sm-3 col-form-label">Condition</label>
        <div class="col-sm-9">
            @(Html.Kendo().DropDownListFor(m => m.Condition)
                .BindTo(new[] { "Good", "Serviceable", "Fair", "Needs Repair", "Unserviceable" })
                .HtmlAttributes(new { @class = "w-100" }))
        </div>
    </div>*@

    <div class="form-group row mb-2">
        <label class="col-sm-3 col-form-label">Acq. Cost</label>
        <div class="col-sm-9">
            @(Html.Kendo().NumericTextBoxFor(m => m.AcquisitionCost)
                .Min(0)
                .Format("n2")
                .HtmlAttributes(new { style = "width:100%; max-width: 100%;", @class = "w-100" }))
        </div>
    </div>
</div>

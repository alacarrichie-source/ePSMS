                                .Columns(c =>
                                {
                                    c.Add().Field("Description").Title("Description").Width("100%");
                                })
                                .Suggest(true)
                                )
                                @Html.ValidationMessageFor(m => m.InvDist)
                            </div>
                        </div>
                </div>
            }*@

        <div class="row">
            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.PrevPsNo, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.PrevPsNo).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PrevPsNo)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Remarks, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(2).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>
        </div>

        <br />

        @if (!string.IsNullOrEmpty(partialViewName))
        {
            @Html.Partial(partialViewName)
        }

        @if (ViewBag.FieldSw.AcqDate)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-3">
                        @Html.DisplayFor(m => m.AcqDate, "LabelDate")
                    </div>
                    <div class="col-md-9">
                        @(Html.Kendo().DatePickerFor(m => m.AcqDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.AcqDate)
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.FieldSw.AcqYear)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-3">
                        @Html.DisplayFor(m => m.ConstructionYear, "LabelInt")
                    </div>
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.ConstructionYear).Decimals(0).Spinners(false).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.ConstructionYear)
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.FieldSw.PhaseNo)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-3">
                        @Html.DisplayFor(m => m.PhaseNo, "LabelInt")
                    </div>
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.PhaseNo).Decimals(0).Spinners(false).Format("{0:n0}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.PhaseNo)
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="col-md-3">
                        @Html.DisplayFor(m => m.PhaseAmount, "LabelDecimal")
                    </div>
                    <div class="col-md-9">
                        @(Html.Kendo().NumericTextBoxFor(m => m.PhaseAmount).Decimals(2).Spinners(false).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.PhaseAmount)
                    </div>
                </div>
            </div>
        }

        @if (ViewBag.FieldSw.Type)
        {
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-3">
                        @Html.DisplayFor(m => m.Type, "Label")
                    </div>
                    <div class="col-md-9">
                        @(Html.Kendo().TextBoxFor(m => m.Type).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.Type)
                    </div>
                </div>
            </div>
        }


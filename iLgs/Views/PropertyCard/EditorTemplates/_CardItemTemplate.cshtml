                                .DataTextField("Description")
                                .DataValueField("Description")
                                .ValuePrimitive(true)
                                .Filter(FilterType.Contains)
                                .DataSource(source =>
                                {
                                    source.Read(read =>
                                    {
                                        read.Action("GetCodeList", "Getters", new { mastCode = "PS-REMARKS", addAll = false });
                                    })
                                    .ServerFiltering(true);
                                })
                                .Columns(c =>
                                {
                                    c.Add().Field("Description").Title("Description").Width("100%");
                                })
                                .Suggest(true)
                        )
                        @Html.ValidationMessageFor(m => m.Remarks)
                    </div>
                </div>
            </div>*@

        <br />
        <div class="row">
            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.Description, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextAreaFor(m => m.Description).Rows(5).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Description)
                </div>
            </div>

            <div class="col-md-6">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.InvDist, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.InvDist)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select..")
                        .DataTextField("Description")
                        .DataValueField("Code")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetinvDistList", "Getters");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Description").Title("Description").Width("100%");
                        })
                        .Suggest(true)
                    )
                    @Html.ValidationMessageFor(m => m.InvDist)
                </div>
            </div>
        </div>


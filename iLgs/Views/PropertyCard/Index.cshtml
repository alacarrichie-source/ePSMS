@{
    ViewBag.Title = "Property Card";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<link href="@Url.Content("~/Content/property-card-index.css")" rel="stylesheet" />
<section id="propertyCardWorkspace" class="epsms-property-card" aria-label="Property cards">
    <div class="pc-header">
        <div><h1>Property Cards</h1><p>Find property cards and review their acquisition records and item details.</p></div>
        <div class="pc-view-switch" role="group" aria-label="Display property cards as">
            <button type="button" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary" data-pc-view="list" aria-pressed="true">List</button>
            <button type="button" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base" data-pc-view="catalogue" aria-pressed="false">Catalog</button>
        </div>
    </div>
    <div class="pc-filter-summary"><span id="pcResultCount" role="status" aria-live="polite"></span>
        <button type="button" id="pcClearFilters" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base">Clear filters</button>
    </div>
<div class="row pc-encoder-filter">
    <div class="col-md-6">
        <div class="col-md-12">
            @Html.Label("UserName", "Encoder")
        </div>
        <div class="col-md-12">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("UserName")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select encoder")
                .DataTextField("NameFull")
                .DataValueField("UserName")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetGsoUsers", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("UserName").Title("User Name").Width("30%");
                    c.Add().Field("NameFull").Title("Name Full").Width("70%");
                })
                .Events(e => e.Select("onSelectUserName").Change("onChangeUserName"))
                .AutoBind(true)
            )
        </div>
    </div>
</div>
<br />


@(Html.Kendo().Grid<iLgs.Models.PropertyCardVM>()
    .HtmlAttributes(new { @class = "max-grid" })
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Id).Hidden();
        col.Bound(c => c.Fund).Width(40);
        col.Bound(c => c.PsNo).Width(210).Title("Property Card No.");
        col.Bound(c => c.ItemType).Width(100);
        col.Bound(c => c.SubAccount1).Width(100);
        col.Bound(c => c.SubAccount2).Width(100);
        col.Bound(c => c.SubAccount3).Width(100);
        col.Bound(c => c.SubAccount4).Width(100);
        //col.Bound(c => c.PsName).Width(70);
        //col.Bound(c => c.Description).Width(100);
        col.Bound(c => c.Item).Width(240).Title("Article").HtmlAttributes(new { @class = "pc-article" });
        col.Bound(c => c.InsertedBy).Width(70).Title("Created by");
        col.Bound(c => c.ItemCount).Width(70);
        col.Bound(c => c.NotPosted).Width(70);
        col.Command(command =>
        {
            //command.Edit();
            command.Custom("View Property Card").Click("onViewPropertyCard");
            command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEdit");
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            command.Destroy();
        }).Width(220);
    })
    @*.ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd_").Content("Add Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAdd")))
                @(Html.Kendo().Button().Name("btnPrintCard").Content("Print").Icon("k-icon k-i-print").Events(e => e.Click("onClickBtnPrint")))
            </text>);
        })*@
    .ToolBar(t =>
    {
        //t.Create().Text("Add New Record");
        //t.Custom().Text("Add New Record").IconClass("k-icon k-i-add").Name("btnTransfer").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Add Property Card").IconClass("k-icon k-i-add").Name("btnAddNew").HtmlAttributes(new { @class = "k-grid-add-custom" });
        t.Custom().Text("Print Selected Card").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemType, "contains");
        s.Field(o => o.SubAccount1, "contains");
        s.Field(o => o.SubAccount2, "contains");
        s.Field(o => o.SubAccount3, "contains");
        s.Field(o => o.SubAccount4, "contains");
        s.Field(o => o.Item, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(new int[] { 12, 20, 40, 80 })
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()

    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.CardCategory).DefaultValue("P").Editable(true);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("Read", "PropertyCard").Data("DataStockCard"))
        //.Create(create => create.Action("Create", "PropertyCard"))
        //.Update(update => update.Action("Update", "PropertyCard"))
        .Destroy(destroy => destroy.Action("Destroy", "PropertyCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")

    )
)

<div id="pcCataloguePanel" hidden>
    <p class="pc-catalogue-help">Open a card to review acquisitions, individual units, accountability and documents. List filters and sorting also apply here.</p>
    <div id="pcCatalogue" aria-label="Property card catalog"></div>
    <div id="pcCataloguePager" aria-label="Catalog pages"></div>
</div>
</section>
<script id="pcCatalogueTemplate" type="text/x-kendo-template">
    <article class="pc-card">
        <div class="pc-card-heading"><span class="pc-card-number">#: PsNo || 'No card number' #</span><span class="pc-fund">Fund #: Fund || '\u2014' #</span></div>
        <h2>#: Item || 'No article description' #</h2>
        <p class="pc-account">#: ItemType || '\u2014' #</p>
        <p class="pc-subaccounts">#: propertyCardClassification(data) #</p>
        <dl class="pc-card-counts"><div><dt>Item count</dt><dd>#: ItemCount == null ? '\u2014' : ItemCount #</dd></div><div><dt>Not posted</dt><dd>#: NotPosted == null ? '\u2014' : NotPosted #</dd></div></dl>
        <p class="pc-created">Created by #: InsertedBy || '\u2014' #</p>
        <div class="pc-card-actions"><button type="button" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-primary pc-open-card" data-card-id="#: Id #">View Property Card</button><button type="button" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base pc-edit-card" data-card-id="#: Id #">Edit</button><button type="button" class="k-button k-button-md k-rounded-md k-button-solid k-button-solid-base pc-print-card" data-card-id="#: Id #">Print</button></div>
    </article>
</script>

<div id="windowcontainer"></div>
@Html.Partial("_ValidationTemplate")
@Html.Partial("_ClientConfig")
<link href="@Url.Content("~/Content/property-card-legacy.css?v=20260912_3")" rel="stylesheet" />
<script src="@Url.Content("~/Scripts/property-card-legacy.js?v=20260912_3")"></script>
<script src="@Url.Content("~/Scripts/property-card-index.js?v=20260912_3")"></script>

@{
    ViewBag.Title = "Property Card";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.PropertyCardVM>()
    .HtmlAttributes(new { @class = "max-grid" })
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.Fund).Width(40);
        col.Bound(c => c.PsNo).Width(100);
        col.Bound(c => c.ItemType).Width(100);
        col.Bound(c => c.SubAccount).Width(100);
        col.Bound(c => c.Item).Width(100).Title("Articles");
        //col.Bound(c => c.PsName).Width(70);
        //col.Bound(c => c.Description).Width(100);
        col.Command(command =>
        {
            //command.Edit();
            command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEdit");
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            command.Destroy();
        }).Width(100);
    })
    @*.ToolBar(toolbar =>
            {
            toolbar.Template(@<text>
                @(Html.Kendo().Button().Name("btnAdd_").Content("Add Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAdd")))
                @(Html.Kendo().Button().Name("btnPrintCard").Content("Print").Icon("k-icon k-i-print").Events(e => e.Click("onClickBtnPrint")))
            </text>);
        })*@
    .ToolBar(t =>
    {
        //t.Create().Text("Add New Record");
        //t.Custom().Text("Add New Record").IconClass("k-icon k-i-add").Name("btnTransfer").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Add New Record").IconClass("k-icon k-i-add").Name("btnAddNew").HtmlAttributes(new { @class = "k-grid-add-custom" });
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintCard").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        //t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostPO").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.PsNo, "contains");
        s.Field(o => o.ItemType, "contains");
        s.Field(o => o.SubAccount, "contains");
        s.Field(o => o.Item, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.CardCategory).DefaultValue("S").Editable(true);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("Read", "PropertyCard"))
        //.Create(create => create.Action("Create", "PropertyCard"))
        //.Update(update => update.Action("Update", "PropertyCard"))
        .Destroy(destroy => destroy.Action("Destroy", "PropertyCard"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
    )
)

<script id="DetailTemplate" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("details_tabstrip_#=Id#")
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation =>
        {
            animation.Open(config =>
            {
                config.Fade(FadeDirection.In);
            });
        })
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_PropertyCardItem", "PropertyCard", new { cardId = "#=Id#", category = "#=ItemTypeCode#" });
        })
       .ToClientTemplate()
    )
</script>

<script id="IssuedItems" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemIssuanceVM>()
    .Name("gridIssuance_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Department).Width(100);
        //col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.IssuedTo).Width(50);
        col.Bound(c => c.IssuedDate).Width(50).EditorTemplateName("_IssuedDateTemplate");
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridIssuanceDeleteClick").SendDataKeys(true);
        }).Width(100);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemIssuanceTemplate").Window(w => w.Width(500).Title("Card Item Issuance")))
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridIssuance")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.Amount).Editable(false);
            model.Field(p => p.IssuedToSw).DefaultValue(1);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("IssuanceRead", "PropertyCard", new { cardItemId = "#=Id#" }))
        .Create(create => create.Action("IssuanceCreate", "PropertyCard"))
        .Update(update => update.Action("IssuanceUpdate", "PropertyCard"))
        .Destroy(destroy => destroy.Action("IssuanceDestroy", "PropertyCard"))
    )
    .Events(events => events
        .Change("onChangeGridIssuance")
        .Edit("onEditGridIssuance")
        .DataBound("onDataBoundGridIssuance")
        .Remove("onRemoveGridIssuance")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>


@model iLgs.Controllers.GetPsNoVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardItemId)


    <div class="pc-popup-validation alert alert-danger" style="display:none;" role="alert"></div>
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>
    
    <fieldset>
        <div class="row k-mb-2">
            @Html.LabelFor(m => m.PsNo, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.PsNo)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select destination stock/property no")
                        .DataTextField("PsNo")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetPsNos", "Getters");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Fund").Title("Code").Width("5%");
                            c.Add().Field("PsNo").Title("Stock/Property No.").Width("20%").Template("#= columnTemplate(data.PsNo) #"); 
                            c.Add().Field("Account").Title("Account").Width("15%").Template("#= columnTemplate(data.Account) #"); 
                            c.Add().Field("SubAccount1").Title("Sub-Account 1").Width("15%").Template("#= columnTemplate(data.SubAccount1) #"); 
                            c.Add().Field("SubAccount2").Title("Sub-Account 2").Width("15%").Template("#= columnTemplate(data.SubAccount2) #"); 
                            c.Add().Field("SubAccount3").Title("Sub-Account 3").Width("15%").Template("#= columnTemplate(data.SubAccount3) #"); 
                            c.Add().Field("SubAccount4").Title("Sub-Account 4").Width("15%").Template("#= columnTemplate(data.SubAccount4) #"); 
                            //c.Add().Field("Article").Title("Article").Width("15%").Template("#= columnTemplate(data.Article) #"); ;

                        })
                        .Suggest(true)
                        .Events(e =>
                        {
                            e.Select("onSelectPsNo");
                        })
                )
                @Html.ValidationMessageFor(m => m.PsNo)
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.Fund, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.Fund).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.Account, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.Account).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.SubAccount1, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.SubAccount1).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.SubAccount2, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.SubAccount2).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.SubAccount3, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.SubAccount3).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.SubAccount4, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.SubAccount4).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            @Html.LabelFor(m => m.Article, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.Article).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Transfer").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>

    </fieldset>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        var $popup = $("#btnSave").closest(".k-window-content");
        if (typeof clearPropertyCardPopupError === 'function') {
            clearPropertyCardPopupError($popup);
        }
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("_PoTransferSave", "PropertyCard")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $popup.data("kendoWindow").close();
                    }
                    else {
                        if (typeof showPropertyCardPopupError === 'function' && $popup.find(".pc-popup-validation").length) {
                            showPropertyCardPopupError($popup, result.Errors);
                        } else {
                            notifyWarning(result.Errors);
                        }
                    }
                },
                error: function (req, status, errorObj) {
                    window.kendo.ui.progress($("#form"), false);
                    var msg = typeof ajaxFailureMessage === 'function' ? ajaxFailureMessage(req, "Transfer failed.") : "Transfer failed.";
                    if (typeof showPropertyCardPopupError === 'function' && $popup.find(".pc-popup-validation").length) {
                        showPropertyCardPopupError($popup, msg);
                    } else {
                        notifyWarning(msg);
                    }
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>



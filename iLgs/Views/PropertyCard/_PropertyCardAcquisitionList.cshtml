<aside class="pc-master-pane" aria-label="Acquisitions and Locations">
    <div class="pc-acquisition-list-header">
        <div class="pc-acquisition-title-row">
            <span class="pc-acquisition-title">ACQUISITIONS / LOCATIONS</span>
            <span class="pc-acquisition-count-badge pc-acq-badge" title="Total acquisitions">0</span>
        </div>
        <div class="pc-acquisition-search-wrap">
            <i class="fa fa-search" aria-hidden="true"></i>
            <input type="text" class="pc-acquisition-search" placeholder="Search acquisition..." autocomplete="off" spellcheck="false" />
            <button type="button" class="pc-acquisition-search-clear" title="Clear search" style="display:none;">&times;</button>
        </div>
    </div>
    <div class="pc-acquisition-list-body" role="listbox" aria-label="Acquisitions">
        <div class="pc-acquisition-loading">
            <span class="k-icon k-i-loading"></span> Loading acquisitions...
        </div>
    </div>
    <div class="pc-acquisition-empty" style="display:none;">
        <i class="fa fa-inbox" style="font-size: 24px; color: #94a3b8; display: block; margin-bottom: 6px;"></i>
        <span>No acquisitions / locations are available.</span>
    </div>
    <div class="pc-acquisition-search-empty" style="display:none;">
        <i class="fa fa-filter" style="font-size: 20px; color: #94a3b8; display: block; margin-bottom: 6px;"></i>
        <span>No matching acquisitions found.</span>
    </div>
</aside>
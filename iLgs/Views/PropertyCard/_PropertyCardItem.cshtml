@(Html.Kendo().Grid<iLgs.Models.PropertyCardItemVM>()
    .Name("gridItems_" + ViewData["cardId"])
    .HtmlAttributes(new { @class = "pc-acquisitions" })
    .Columns(c => {
        c.Bound(x => x.PoNo).Title("Reference").Width(180).ClientTemplate("#= pcAcquisitionReference(data) #");
        c.Bound(x => x.Department).Title("PO Owner").Width(200).ClientTemplate("#= pcAcquisitionLocation(data) #");
        c.Bound(x => x.Description).Title("Description").Width(175).ClientTemplate("#= pcDescription(data) #");
        c.Bound(x => x.UnitCost).Title("Acquisition").Width(175).ClientTemplate("#= pcAcquisitionCost(data) #");        
        c.Bound(x => x.TransferIn).Title("Movement").Width(140).ClientTemplate("#= pcAcquisitionMovement(data) #");
        c.Bound(x => x.QtyBal).Title("Balance").Width(100).ClientTemplate("<strong class='pc-balance'>#: kendo.toString(QtyBal || 0, 'n0') #</strong><br>#: Unit || '' #");
        c.Bound(x => x.PostedDt).Title("Posting").Width(145).ClientTemplate("#= pcAcquisitionStatus(data) #");
        c.Command(commands => {
            commands.Custom("View Details").Click("pcShowAcquisitionDetails");
            commands.Custom("More").Click("pcAcquisitionMore");
        }).Width(160);
    })
    .ToolBar(t => t.Create().Text("Add Acquisition"))
    .Editable(e => e.Mode(GridEditMode.PopUp).TemplateName("_CardItemTemplate").DisplayDeleteConfirmation(false).Window(w => w.Width(1000).Title("Property Card Acquisition")))
    .Selectable().Navigatable().NoRecords().Sortable().Filterable().Scrollable().Resizable(r => r.Columns(true))
    .Pageable(p => p.PageSizes(new int[] { 12, 20, 40, 80 }).Refresh(true))
    .ClientDetailTemplateId("pcAcquisitionDetails")
    .DataSource(d => d.Ajax().PageSize(20)
        .Model(m => {
            m.Id(x => x.TransferId);
            m.Field(x => x.Id).DefaultValue(Guid.Empty);
            m.Field(x => x.TransferId).DefaultValue(Guid.Empty);
            m.Field(x => x.PsCardId).DefaultValue(ViewData["cardId"]);
        })
        .Sort(s => { s.Add(x => x.PoNo); s.Add(x => x.InsertedDt); })
        .Aggregates(a => { a.Add(x => x.Qty).Sum(); a.Add(x => x.TransferIn).Sum(); a.Add(x => x.QtyIss).Sum(); a.Add(x => x.TransferOut).Sum(); a.Add(x => x.QtyBal).Sum(); a.Add(x => x.Amount).Sum(); })
        .Events(e => e.Error("GridItemError").RequestEnd("onRequestEndGridItems"))
        .Read(r => r.Action("ItemRead", "PropertyCard", new { cardId = ViewData["cardId"] }))
        .Create("ItemCreate", "PropertyCard").Update("ItemUpdate", "PropertyCard").Destroy("ItemDestroy", "PropertyCard"))
    .Events(e => e.Edit("onEditGridItems").Change("onChangeGridItems").DataBound("onDataBoundGridItems").Remove("onRemoveGridItems"))
)
<div id="pcAcquisitionDetailHost" class="pc-acquisition-detail-host" style="margin-top: 18px;"></div>

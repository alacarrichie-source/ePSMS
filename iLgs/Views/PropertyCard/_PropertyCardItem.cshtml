@(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
        .Name("gridItems_" + @ViewData["cardId"])
        .Columns(columns =>
        {
            columns.Bound(f => f.PoNo).Width(50);
            columns.Bound(f => f.PoDate).Width(50);
            columns.Bound(f => f.AirNo).Width(50);
            columns.Bound(f => f.AirDate).Width(50);
            columns.Bound(f => f.Unit).Width(50);
            columns.Bound(f => f.UnitCost).Width(50)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Group(group => group.Title("Quantity")
                .Columns(info =>
                {
                    info.Bound(f => f.Qty)
                      .Width(50).Title("Receipt")
                      .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                      .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                      .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyIss)
                        .Width(50).Title("Issue")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                    info.Bound(f => f.QtyBal)
                        .Width(50).Title("Balance")
                        .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                        .ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                        .HeaderHtmlAttributes(new { style = "text-align:right;" });
                }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
            );
            columns.Bound(f => f.Department).Width(100);
            columns.Bound(f => f.Remarks).Width(50);
            columns.Command(commands =>
            {
                commands.Edit();
                commands.Destroy();
            }).Width(120);
        })
        .ToolBar(t =>
        {
            t.Create();
        })
        //.Editable(editable => editable.Mode(GridEditMode.InLine))
        @*.ToolBar(toolbar =>
            {
                toolbar.Template(@<text>
                    @(Html.Kendo().Button().Name("btnAddItem_" + ViewData["cardId"]).Content("Add Order Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddItem")))
                </text>);
            })*@
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemTemplate").Window(w => w.Width(800).Title("Property Card Item")))
        .Selectable()
        .Navigatable()
        .NoRecords()
        .ClientDetailTemplateId("IssuedItems")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                //model.Field(p => p.Qty).DefaultValue(0);
                //model.Field(p => p.QtyIss).DefaultValue(0);
                //model.Field(p => p.QtyBal).DefaultValue(0);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.QtyIss).Sum();
                a.Add(p => p.QtyBal).Sum();
                a.Add(p => p.Amount).Sum();
            })
            .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItems"))
            .Read("ItemRead", "PropertyCard", new { cardId = @ViewData["cardId"] })
            .Create("ItemCreate", "PropertyCard")
            .Update("ItemUpdate", "PropertyCard")
            .Destroy("ItemDestroy", "PropertyCard")
        )
        .Events(e => e.Edit("onEditGridItems").Change("onChangeGridItems").DataBound("onDataBoundGridItems").Remove("onRemoveGridItems")
        //.DetailExpand("onExpandGridItems")
        )
)

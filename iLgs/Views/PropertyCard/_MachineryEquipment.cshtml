@model iLgs.Models.PropertyCardPpeVM
<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Type, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">
            @(Html.Kendo().TextBoxFor(m => m.Type).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Type)
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Brand, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">
            @(Html.Kendo().TextBoxFor(m => m.Brand).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Brand)
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Model_, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">
            @(Html.Kendo().TextBoxFor(m => m.Model_).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Model_)
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Color, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">
            @(Html.Kendo().TextBoxFor(m => m.Color).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Color)
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Others, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">
            @(Html.Kendo().TextBoxFor(m => m.Others).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Events(e => e.Change("UpdateDescription")))
            @Html.ValidationMessageFor(m => m.Others)
        </div>
    </div>
</div>


<div class="row">
    <div class="col-md-12">
        @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-12" })
        <div class="col-md-12">

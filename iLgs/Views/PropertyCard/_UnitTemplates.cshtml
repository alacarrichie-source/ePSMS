<script id="default-template" type="text/kendo-tmpl">
    <h4>Loading..</h4>
</script>

<script id="ItemExtnVehicle" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemExtnVehicleVM>()
    .Name("gridItemExtn_#=TransferId#")
    .Columns(col =>
    {
        col.Bound(c => c.ContentNo).Width(50);
        col.Bound(c => c.PropNo).Width(100);
        col.Bound(c => c.CustItemNo).Width(100);
        col.Bound(c => c.SeriesNo).Width(50);
        col.Bound(c => c.ConductionNo).Width(50);
        col.Bound(c => c.PlateNo).Width(50);
        col.Bound(c => c.Location).Width(150);
        col.Bound(c => c.Condition).Width(100).Title("Condition");        
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").Click("pcDeleteUnit");
            command.Custom("Documents").Click("pcUnitDocuments");
            command.Custom("Accountability").Click("pcUnitAccountability");
            //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridItemExtnDeleteClick").SendDataKeys(true);
        }).Width(260);
    })
    .ToolBar(t =>
    {
        t.Create();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CardItemExtnVehicleTemplate").Window(w => w.Width(1000).Title("Individual Unit")))
    .Pageable(p => p.PageSizes(new int[] { 12, 20, 40 }).Refresh(true))
    .Scrollable().Resizable(r => r.Columns(true))
    .Sortable()
    .NoRecords()
    //.ClientDetailTemplateId("UploadedFiles")
    .DataSource(dataSource => dataSource
        .Ajax().PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridItemExtn")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Read(read => read.Action("_ItemExtnVehicleRead", "PropertyCard", new { transferId = "#=TransferId#" }))
        .Create(create => create.Action("_ItemExtnVehicleCreate", "PropertyCard"))
        .Update(update => update.Action("_ItemExtnVehicleUpdate", "PropertyCard"))
        .Destroy(destroy => destroy.Action("_ItemExtnVehicleDestroy", "PropertyCard"))
    )
    .Events(events => events
        .Change("onChangeGridItemExtn")
        .Edit("onEditGridItemExtn")
        .DataBound("onDataBoundGridItemExtn")
        .Remove("onRemoveGridItemExtn")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>


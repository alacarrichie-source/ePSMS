<script id="UploadedFiles" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
        .Name("tabStrip_#=Id#")
        .HtmlAttributes(new { @class = "no-text-tabstrip" })
        .TabPosition(TabStripTabPosition.Top)
        .Animation(animation => animation.Open(open => open.Fade(FadeDirection.In)))
        .SelectedIndex(0)
        .Items(items =>
        {
            items.Add().Text("Uploads").Selected(true).LoadContentFrom("_Images", "CardUpload", new { imageId = "#=Id#", psCardItemId = "#=PsCardItemId#" });
        })
        .ToClientTemplate())
</script>
@model dynamic
@{
    var cardId = ViewData["cardId"];
}

<section class="pc-tab-section" data-tab-name="Components">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <h3 class="mb-1">Components</h3>
            <p class="text-muted mb-0">Persistent master-detail view of acquisitions and their component definitions. Expand any component row to manage its individual physical units.</p>
        </div>
    </div>

    <div class="pc-master-detail">
        @Html.Partial("_PropertyCardAcquisitionList")

        <section class="pc-detail-pane">
            <!-- Selected Acquisition Header -->
            <div class="pc-detail-header-card">
                <div class="pc-detail-header-main">
                    <div class="pc-detail-title-row">
                        <span class="pc-eyebrow">SELECTED ACQUISITION</span>
                        <h4 id="pcCompAcqPo" class="pc-detail-heading">Select an Acquisition</h4>
                    </div>
                    <div id="pcCompAcqDesc" class="pc-detail-subtext">Choose an acquisition card from the left panel to browse its component definitions.</div>
                </div>
                <div class="pc-detail-header-actions">
                    <div id="pcComponentContext" class="badge badge-light border text-muted" style="font-size: 11px; padding: 6px 10px;">Select an acquisition to filter components or add new ones.</div>
                </div>
            </div>

            <!-- Fallback hidden input for legacy compatibility -->
            <input id="pcComponentAcquisitionChoice" type="hidden" />

            <div id="pcCompPostedLockBanner" class="pc-posted-lock-banner" style="display:none;">
                <i class="fa fa-lock"></i> This acquisition is posted. Components are read-only.
            </div>

            <div id="pcComponentsGridContainer">
                @(Html.Kendo().Grid<iLgs.Models.PropertyCardComponentVM>()
                    .Name("gridComponents_" + cardId)
                    .HtmlAttributes(new { @class = "pc-components-grid" })
                    .Columns(c => {
                        c.Bound(x => x.SubItemNo).Title("Sub Item #").Width(100);
                        c.Bound(x => x.Description).Title("Description").Width(230);
                        c.Bound(x => x.Unit).Title("Unit").Width(75);
                        c.Bound(x => x.Qty).Title("Qty").Width(80).Format("{0:n0}").HtmlAttributes(new { @class = "text-right font-weight-bold" });
                        c.Bound(x => x.QtyPerParent).Title("Qty / Parent").Width(105).Format("{0:n0}").HtmlAttributes(new { @class = "text-right" });
                        c.Bound(x => x.SourceType).Title("Source Type").Width(125).ClientTemplate("#= pcComponentSourceBadge(data) #");
                        c.Bound(x => x.IsRequiredForBundle).Title("Required for Bundle").Width(145).ClientTemplate("#= pcComponentRequiredBadge(data) #");
                        c.Bound(x => x.PhysicalUnitCount).Title("Physical Units").Width(110).HtmlAttributes(new { @class = "text-center font-weight-bold" });
                        c.Bound(x => x.AssignedCount).Title("Assigned").Width(90).Format("{0:n0}").HtmlAttributes(new { @class = "text-center" });
                        c.Bound(x => x.AvailableCount).Title("Available").Width(90).Format("{0:n0}").HtmlAttributes(new { @class = "text-center" });
                        c.Command(commands => {
                            commands.Edit().Text("Edit");
                            commands.Destroy().Text("Delete");
                        }).Width(175).Title("Actions");
                    })
                    .ToolBar(t => t.Create().Text("Add Component"))
                    .Editable(e => e.Mode(GridEditMode.PopUp).TemplateName("_ComponentTemplate").DisplayDeleteConfirmation(false).Window(w => w.Width(620).Title("Property Card Component")))
                    .Selectable().Navigatable().NoRecords("No components found for this acquisition.").Sortable().Filterable().Scrollable().Resizable(r => r.Columns(true))
                    .Pageable(p => p.PageSizes(new int[] { 10, 20, 50 }).Refresh(true))
                    .ClientDetailTemplateId("pcComponentUnitsTemplate")
                    .DataSource(d => d.Ajax().PageSize(20)
                        .Model(m => {
                            m.Id(x => x.Id);
                            m.Field(x => x.Id).DefaultValue(Guid.Empty);
                            m.Field(x => x.PsCardItemId).DefaultValue(Guid.Empty);
                            m.Field(x => x.Qty).DefaultValue(1);
                            m.Field(x => x.QtyPerParent).DefaultValue(1);
                            m.Field(x => x.SourceType).DefaultValue("ORDERED");
                            m.Field(x => x.IsRequiredForBundle).DefaultValue(true);
                        })
                        .Sort(s => s.Add(x => x.SubItemNo))
                        .Events(e => e.Error("onErrorGridComponents").RequestEnd("onRequestEndGridComponents"))
                        .Read(r => r.Action("WorkspaceComponentRead", "PropertyCard", new { id = cardId }).Data("pcComponentReadData"))
                        .Create(c => c.Action("WorkspaceComponentCreate", "PropertyCard", new { cardId = cardId }))
                        .Update(u => u.Action("WorkspaceComponentUpdate", "PropertyCard", new { cardId = cardId }))
                        .Destroy(x => x.Action("WorkspaceComponentDestroy", "PropertyCard", new { cardId = cardId }))
                    )
                    .Events(e => e.Edit("onEditGridComponents").DataBound("onDataBoundGridComponents").Remove("onRemoveGridComponents"))
                )
            </div>
        </section>
    </div>
</section>

<script id="pcComponentUnitsTemplate" type="text/x-kendo-template">
    <div class="pc-child-units-detail p-2 bg-white border rounded">
        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
            <h5 class="mb-0 text-dark">
                <strong>#: Description #</strong> <span class="text-muted font-weight-normal">&mdash; Individual Physical Units</span>
            </h5>
            <div class="small text-muted">
                Component Qty: <strong>#: Qty #</strong> | Registered Units: <strong>#: PhysicalUnitCount #</strong>
            </div>
        </div>

        @(Html.Kendo().Grid<iLgs.Models.PropertyCardUnitVM>()
            .Name("gridCompUnits_#=Id#")
            .HtmlAttributes(new { @class = "pc-child-unit-grid", data_parent_qty = "#=Qty#", data_component_id = "#=Id#" })
            .Columns(c => {
                c.Bound(x => x.ContentNo).Title("Unit \\#").Width(75).HtmlAttributes(new { @class = "text-center font-weight-bold" });
                c.Bound(x => x.SerialNo).Title("Serial No.").Width(160);
                c.Bound(x => x.AcquisitionCost).Title("Acq. Cost").Width(100).Format("{0:n2}").HtmlAttributes(new { @class = "text-right" });
                c.Bound(x => x.AccountabilityStatus).Title("Accountability Status").Width(160).ClientTemplate("\\#= pcComponentUnitStatusBadge(data) \\#");
                c.Command(commands => {
                    commands.Edit().Text("Edit");
                    commands.Destroy().Text("Delete");
                }).Width(160).Title("Actions");
            })
            .ToolBar(t => t.Create().Text("Add Physical Unit"))
            .Editable(e => e.Mode(GridEditMode.PopUp).TemplateName("_ComponentUnitTemplate").DisplayDeleteConfirmation(false).Window(w => w.Width(580).Title("Component Physical Unit")))
            .Selectable().Navigatable().NoRecords("No individual physical units registered for this component.").Sortable().Filterable().Scrollable().Resizable(r => r.Columns(true))
            .Pageable(p => p.PageSizes(new int[] { 5, 10, 20 }).Refresh(true))
            .DataSource(d => d.Ajax().PageSize(10)
                .Model(m => {
                    m.Id(x => x.Id);
                    m.Field(x => x.Id).DefaultValue(Guid.Empty);
                    m.Field(x => x.PsCardItemId).DefaultValue(Guid.Empty);
                    m.Field(x => x.PsCardSubItemId).DefaultValue(Guid.Empty);
                    m.Field(x => x.Condition).DefaultValue("Good");
                })
                .Sort(s => s.Add(x => x.ContentNo))
                .Events(e => e.Error("onErrorGridComponentUnits").RequestEnd("onRequestEndGridComponentUnits"))
                .Read(r => r.Action("WorkspaceComponentUnitRead", "PropertyCard", new { id = cardId, componentId = "#=Id#" }))
                .Create(c => c.Action("WorkspaceComponentUnitCreate", "PropertyCard", new { cardId = cardId }).Data("pcComponentUnitCreateData"))
                .Update(u => u.Action("WorkspaceComponentUnitUpdate", "PropertyCard", new { cardId = cardId }))
                .Destroy(x => x.Action("WorkspaceComponentUnitDestroy", "PropertyCard", new { cardId = cardId }))
            )
            .Events(e => e.Edit("onEditGridComponentUnits").DataBound("onDataBoundGridComponentUnits").Remove("onRemoveGridComponentUnits"))
            .ToClientTemplate()
        )
    </div>
</script>
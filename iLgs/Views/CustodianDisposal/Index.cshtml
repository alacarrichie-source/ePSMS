<script type="text/javascript">
    // Attach click event to the custom export button
   $(".k-grid-btnExport").click(function (e) {
        e.preventDefault();
        // Get the selected row's data (assuming a single selection model)
        var grid = $("#grid").data("kendoGrid");
        var selectedRow = grid.select();
        var selectedData = grid.dataItem(selectedRow);

        if (selectedData) {
            // Get the ID of the selected row
            var reportId = selectedData.Id;

            // Construct the URL for the Excel export
            var url = "@Url.Action("ExcelExport", "CustodianDisposal")" + "?reportId=" + reportId;

            // Redirect to the export URL to trigger download
            window.location.href = url;
        } else {
            alert("Please select a row to export.");
        }
    });

    //function reloadTab(idx) {
    //    var ts = $("#tabStrip").data("kendoTabStrip");
    //    if (idx == 0) {
    //        ts.contentHolder(idx).load("../Orders/_OrderItem?orderId=" + selectedId);
    //    } else {
    //        ts.contentHolder(idx).load("../Orders/_UnitGroup?orderId=" + selectedItem);
    //    }
    //}
    function onSelectDeptId(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#grid").data("kendoGrid").dataSource.read({ deptId: dataItem.Id });
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function onSelectTab(e) {
        var ts = this;
        for (var idx = 0; ; ++idx) {
            var tab = ts.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                if (idx == 0) {
                    ts.contentHolder(idx).load("../CustodianDisposal/_StockItem?reportId=" + selectedId);
                }
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError" || propertyName == "GridError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    $(document).ready(function () {
        var grid = $("#grid").data("kendoGrid");
        //grid.wrapper.find(".k-grid-add").prop("disabled", true); // Disable the ADD button
        grid.wrapper.find(".k-grid-add").hide(); // Hide the ADD button by default
        //grid.wrapper.find(".k-grid-btnExport").hide();
        grid.wrapper.find(".k-grid-btnPrint").hide();
        grid.wrapper.find(".k-grid-btnPost").hide();
        grid.wrapper.find(".k-grid-btnUnpost").hide();
    });

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedAsOf = null;
    var selecteItemId = null;
    var postedBy = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedAsOf = selectedData.AsOf;
        selectedItemId = null;
        postedBy = selectedData.PostedBy;

        if (postedBy) {
            $(".k-grid-btnUnpost", grid).show();
            $(".k-grid-btnPost", grid).hide();
        } else {
            $(".k-grid-btnUnpost", grid).hide();
            $(".k-grid-btnPost", grid).show();
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        this.wrapper.find(".k-grid-add").show();

        if (this.dataSource.data().length == 0) {
            //$(".k-grid-btnExport", grid).hide();
            $(".k-grid-btnPrint", grid).hide();
            $(".k-grid-btnPost", grid).hide();
            $(".k-grid-btnUnpost", grid).hide();
        }
        else {
            //$(".k-grid-btnExport", grid).show();
            $(".k-grid-btnPrint", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            var deptId = $("#deptId").data("kendoMultiColumnComboBox").value();
            var department = $("#deptId").data("kendoMultiColumnComboBox").text();
            this.select(row);
            selectedId = null;
            selectedAsOf = null;
            //e.container.find("[id=EditDiv]").addClass('hidden');
            e.model.set("DeptId", deptId);
            e.model.set("Department", department);
        } else {
            selectedId = e.model.get("Id");
            //selectedAsOf = e.model.get("AsOf");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#AsOf").data("kendoDatePicker").enable(false);
            //$("#Fund").data("kendoMultiColumnComboBox").enable(false);
            //$("#FromDonation").data("kendoCheckBox").enable(false);
            //$("#InvDist").data("kendoComboBox").enable(false);
            //$("#ItemTypeId").data("kendoMultiColumnComboBox").enable(false);
            //e.container.find("[id=EditDiv]").removeClass('hidden');
        }
    }

    function onSaveGrid(e) {
        //e.preventDefault();
        if (e.model.isNew()) {
            alert('new');
        } else {
            alert('edit');
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        const tr = $(e.currentTarget).closest("tr");
        const dataItem = this.dataItem(tr);
        const rowitem = this.dataSource.get(dataItem.Id);
        this.select($('[data-uid=' + rowitem.uid + ']'));
        this.removeRow(tr);
    }

    function onGridItemDeleteClick(e) {
        //e.preventDefault();
        //selectedGrid = this;
        //const tr = $(e.currentTarget).closest("tr");
        //const dataItem = this.dataItem(tr);
        //const rowitem = this.dataSource.get(dataItem.Id);
        //this.select($('[data-uid=' + rowitem.uid + ']'));
        //this.removeRow(tr);
         e.preventDefault();
        selectedGrid = this; // Reference to the current grid
        const tr = $(e.currentTarget).closest("tr"); // Find the closest row
        const dataItem = selectedGrid.dataItem(tr); // Get the data item for the row

        // Optional: Show a confirmation dialog before deletion
        if (confirm("Are you sure you want to delete this item?")) {
            // Remove the item from the DataSource
            selectedGrid.dataSource.remove(dataItem);

            // Remove the row from the grid
            selectedGrid.removeRow(tr);

            // Sync the DataSource if you're using server-side operations
            selectedGrid.dataSource.sync();
        }
    }

    function DataGrid() {
        return {
            deptId: $("#deptId").val()
        };
    }

    // Grid Item
    function GridItemError(args) {
        if (args.errors) {
            var validationError = true;
            var selectedGrid = $("#gridItems_" + selectedId).data("kendoGrid");
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        e.preventDefault();
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
            }
        }
    }

    function onRemoveGridItems(e) { // triggers after confirm
        e.preventDefault();
        selectedGrid = e.sender;

        //the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);
        parentGrid.select(parentRow);
    }

    function onClickBtnAddItem(e) {
        e.preventDefault();

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        parentGrid.select(parentRow);

        DisposalItem();
    }

    function DisposalItem() {
        var myTitle = "Disposal Item - ADD";
        var width = 1000;
        var height = 450;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#gridItems_" + selectedId).data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_ItemAddEdit", "CustodianDisposal")',
            data: {
                disposalId: selectedId,
                deptId: $("#deptId").data("kendoMultiColumnComboBox").value()
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();        
    }

    // end grid items

    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Recored already posted by " + postedBy);
        }
        else {
            var msg = "Post Selected record?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "CustodianDisposal")',
                    data: { id: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record successfully posted...", "info");
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            displayErrors(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    });

    function displayErrors(errors) {
        if (errors.length > 0) {
            // Concatenate all error messages into a single string
            var allErrors = errors.join('\n');
            alert(allErrors);
        }
    }

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost Selected Record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "CustodianDisposal")',
                data: { id: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrint").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("CustodianRpt", "CustodianDisposal")?id=' + selectedId;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });

    // COMMON for ITEMS
    function SaveGridItems(url)
    {
        var popupNotification = $("#popupNotification").data("kendoNotification");
        var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
        var reportId = $("#ReportId").val();
        var formData = $("#form").serialize();

        // Make an AJAX call to submit the data
        $.ajax({
            type: 'POST',
            url: url,
            data: formData,
            success: function (response) {
                disabled.attr('disabled', 'disabled');
                if (response.Errors) {
                    // Clear previous errors
                    $("#ErrorContent .errors").empty();
                    var errorMsg = "";
                    // Populate errors into the template
                    for (var field in response.Errors) {
                        var messages = response.Errors[field].errors;
                        var html = kendo.template($("#validationMessageTemplate").html())({
                            field: field,
                            messages: messages
                        });
                        $("#ErrorContent .errors").append(html);
                        errorMsg += html;
                    }
                    popupNotification.show(errorMsg, "error");
                    // Show the error content
                    $("#ErrorContent").removeClass("hidden");
                } else {
                    // Handle validation errors if any
                    $("#gridItems_" + reportId).data("kendoGrid").dataSource.read();
                }
            },
            error: function (xhr, status, error) {
                e.sender.trigger("error", {
                    errors: [error]
                });
                alert("An error occurred: " + error);
            }
        });
    }
    // END COMMON
</script>




@{
    ViewBag.Title = "Custodian Disposal";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row k-mb-2">
    <div class="col-md-4">
        @Html.Label("Department", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().MultiColumnComboBox()
                .Name("deptId")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Placeholder("Select Department")
                .DataTextField("Description")
                .DataValueField("Id")
                .ValuePrimitive(true)
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUserDepartmentsAsync", "Getters");
                    })
                    .ServerFiltering(true);
                })
                .Columns(c =>
                {
                    c.Add().Field("Code").Title("Code").Width("30%");
                    c.Add().Field("Description").Title("Description").Width("70%");
                })
                .Events(e => e.Select("onSelectDeptId"))
                .Suggest(true)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.CustodianDisposal>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.TransmittalNo).Width(70);
        col.Bound(c => c.RequestedBy).Width(100);
        col.Bound(c => c.RequestedDt).Width(70);
        col.Bound(c => c.PostedBy).Width(70);
        col.Bound(c => c.PostedDt).Width(70);
        col.Command(command =>
        {
            command.Edit();
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(150);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add New Record");
        //t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExport").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrint").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CustodianDisposalTemplate").Window(w => w.Width(500).Title("Custodian Disposal")))
    .Search(s =>
    {
        s.Field(o => o.TransmittalNo, "contains");
        s.Field(o => o.RequestedBy, "contains");
        s.Field(o => o.RequestedDt, "contains");
        s.Field(o => o.PostedBy, "contains");
        s.Field(o => o.PostedDt, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);            
        })
        .Read(read => read.Action("Read", "CustodianDisposal").Data("DataGrid"))
        .Create(create => create.Action("Create", "CustodianDisposal"))
        .Update(update => update.Action("Update", "CustodianDisposal"))
        .Destroy(destroy => destroy.Action("Destroy", "CustodianDisposal"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
        .AutoBind(false)
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)
    .Animation(animation =>
    {
        animation.Open(config =>
        {
            config.Fade(FadeDirection.In);
        });
    })
    .SelectedIndex(0)
    //.Events(e => e.Select("onSelectTab"))
    .Items(items =>
    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_Item", "CustodianDisposal", new { disposalId = "#=Id#" });
    }).ToClientTemplate())
</script>


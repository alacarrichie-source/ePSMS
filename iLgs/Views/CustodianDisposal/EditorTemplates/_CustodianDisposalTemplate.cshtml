@model iLgs.Models.CustodianDisposal

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.DeptId)
    @Html.HiddenFor(model => model.Department)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.TransmittalNo, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.TransmittalNo).Placeholder("(Auto)").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.TransmittalNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.RequestedBy, "Label")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.RequestedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RequestedBy)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-3">
                    @Html.DisplayFor(m => m.RequestedDt, "LabelDate")
                </div>
                <div class="col-md-9">
                    @(Html.Kendo().DatePickerFor(m => m.RequestedDt)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    )
                    @Html.ValidationMessageFor(m => m.RequestedDt)
                </div>
            </div>
        </div>

    </fieldset>
}



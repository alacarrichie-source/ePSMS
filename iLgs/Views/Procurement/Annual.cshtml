@model iLgs.Models.AnnualProcurementViewModel

@{
    ViewBag.Title = "Annual Procurement";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<link href="@Url.Content("~/Content/procurement.css")?v=20260916_1" rel="stylesheet" type="text/css" />

<section class="epsms-procurement epsms-procurement-annual">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@Url.Action("Index", "Requests")">Purchase Requests</a>
        <span class="breadcrumb-separator">&gt;</span>
        Annual Procurement
    </div>

    <!-- Page Header -->
    <div class="procurement-header">

        <div class="header-title-group">
            <div class="header-icon-pill">
                <span class="k-icon k-i-cart"></span>
            </div>
            <div>
                <h1>@(Model.IsRevision ? "Add Items to PR Revision" : (Model.IsDraftResume ? "Add Items to Draft PR" : "Annual Procurement"))</h1>
                <p class="subtitle">
                @(Model.IsRevision
                    ? "Add approved procurement items to the same returned Purchase Request."
                    : (Model.IsDraftResume
                        ? "Add approved procurement items to the same Draft Purchase Request."
                        : "Select items from the approved annual procurement plan to create a Purchase Request."))
            </p>
            </div>
        </div>

        <!-- View Selector -->
        <div class="view-selector-container">
            <label>View</label>
            <div id="procurementViewSelector"></div>
        </div>

    </div>


    @if (Model.IsRevision)
    {
        <div class="pr-revision-banner" style="display: flex; align-items: center; justify-content: space-between; background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 12px 18px; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="k-icon k-i-info" style="color: #2563eb; font-size: 18px;"></span>
                <div>
                    <strong style="color: #1e40af;">Revising Returned Purchase Request</strong>
                    <div style="color: #3b82f6; font-size: 12px;">Browse and add catalog items for this department and fiscal year, then return to your cart to complete the revision.</div>
                </div>
            </div>
            <a href="@Url.Action("Cart", "Procurement", new { mode = "REVISION", requestId = Model.RequestId })" class="k-button k-primary" style="display: inline-flex; align-items: center; gap: 6px;">
                <span class="k-icon k-i-cart"></span> Return to Revision Cart
            </a>
        </div>
    }

    @if (Model.IsDraftResume)
    {
        <div class="pr-revision-banner" style="display: flex; align-items: center; justify-content: space-between; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 18px; margin-bottom: 16px;">
            <div>
                <strong>Continuing Draft Purchase Request</strong>
                <div style="font-size: 12px; color: #475569;">Add approved procurement items, then return to the same Draft cart to complete and submit the request.</div>
            </div>
            <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <span style="background-color:#e2e8f0; color:#334155; padding:4px 10px; border-radius:6px; font-size:12px; font-weight:600;">
                    My Cart: <span id="cartCount">@Model.CartCount</span> @(Model.CartCount == 1 ? "item" : "items")
                </span>
                <a href="@Url.Action("Cart", "Procurement")" class="k-button k-primary">
                    <span class="k-icon k-i-cart"></span> Return to My Cart
                </a>
            </div>
        </div>
    }

    <!-- ========================================================= -->
    <!-- FILTERS -->
    <!-- ========================================================= -->

    @using (Html.BeginForm(
                "Annual",
                "Procurement",
                FormMethod.Get,
                new { @class = "filter-panel" }))
    {
        if (Model.IsRevision)
        {
            @Html.Hidden("mode", "REVISION")
            @Html.Hidden("requestId", Model.RequestId)
        }
        else if (Model.IsDraftResume)
        {
            @Html.Hidden("mode", "NORMAL")
            @Html.Hidden("requestId", Model.RequestId)
        }
        <div class="filter-row">

            <div>
                <label>Fiscal Year</label>

                @(Html.Kendo().DropDownListFor(m => m.FiscalYear)
                    .Enable(!Model.IsRevision && !Model.IsDraftResume)
                    .BindTo(Model.FiscalYears)
                    .HtmlAttributes(new
                    {
                        style = "width:100%"
                    }))
            </div>

            <div>
                <label>Department</label>

                @(Html.Kendo().DropDownListFor(m => m.Department)
                    .Enable(!Model.IsRevision && !Model.IsDraftResume)
                    .DataTextField("Description")
                    .DataValueField("Id")
                    .Filter(FilterType.Contains)
                    .BindTo(Model.Departments)
                    .HtmlAttributes(new
                    {
                        style = "width:100%"
                    }))
            </div>

            <div>
                <label>Procurement Mode</label>

                @(Html.Kendo().DropDownListFor(m => m.Category)
                    .BindTo(Model.Categories)
                    .HtmlAttributes(new
                    {
                        style = "width:100%"
                    }))
            </div>

            <div class="search">

                <label>Search</label>

                @(Html.Kendo().TextBoxFor(m => m.SearchText)
                    .Placeholder("Search procurement items...")
                    .HtmlAttributes(new
                    {
                        style = "width:100%"
                    }))

            </div>

            <div class="filter-button">

                @(Html.Kendo().Button()
                    .Name("filterButton")
                    .Content(
                        "<span class='k-icon k-i-filter'></span> Filter"
                    )
                    .HtmlAttributes(new
                    {
                        type = "submit",
                        @class = "k-primary"
                    }))

            </div>

        </div>
    }


    <!-- ========================================================= -->
    <!-- CATALOG VIEW -->
    <!-- ========================================================= -->

    <div id="catalogView" class="procurement-view">

        <div class="catalog-grid" id="catalogGrid">

            @if (!Model.Items.Any())
            {
                <div class="procurement-empty-state">
                    No procurement items match the selected filters.
                </div>
            }

            @foreach (var item in Model.Items)
            {
                <article class="catalog-card"
                         data-item-id="@item.Id">

                    <div class="item-code">
                        @item.Code
                    </div>

                    <h2>
                        @item.Description
                    </h2>

                    <div class="unit">
                        @item.Unit
                    </div>

                    <dl class="metrics">

                        <div>
                            <dt>Planned</dt>
                            <dd>@item.Qty</dd>
                        </div>

                        <div>
                            <dt>Req.</dt>
                            <dd>@item.QtyUsed</dd>
                        </div>

                        <div>
                            <dt>Rem.</dt>
                            <dd class="remaining">
                                @item.QtyBal
                            </dd>
                        </div>

                    </dl>

                    <div class="cost">

                        <span>Est. Unit Cost</span>

                        <strong>
                            @((item.UnitCost ?? 0m).ToString(
                                "C2",
                                System.Globalization.CultureInfo
                                    .GetCultureInfo("en-PH")))
                        </strong>

                    </div>


                    <!-- Catalog Add To Cart -->
                    @using (Html.BeginForm(
                    "AddToCart",
                    "Procurement",
                    FormMethod.Post,
                    new
                    {
                        @class =
                            "add-to-cart-form catalog-add-to-cart-form",
                        data_item_id = item.Id
                    }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden("id", item.Id)
                        if (Model.IsRevision)
        {
            @Html.Hidden("mode", "REVISION")
            @Html.Hidden("requestId", Model.RequestId)
        }
        else if (Model.IsDraftResume)
        {
            @Html.Hidden("mode", "NORMAL")
            @Html.Hidden("requestId", Model.RequestId)
        }

                        var disabled =
                            item.QtyBal <= 0 ||
                            item.IsInCart;

                        @(Html.Kendo().Button()
                            .Name(
                                "catalogAddToCart_" +
                                item.Id)
                            .Content(
                                item.IsInCart
                                    ? "<span class='k-icon k-i-check'></span> Already in Cart"
                                    : item.QtyBal <= 0
                                        ? "<span class='k-icon k-i-lock'></span> Fully Requested"
                                        : "<span class='k-icon k-i-cart'></span> Add to Cart"
                            )
                            .Enable(!disabled)
                            .HtmlAttributes(new
                            {
                                type = "submit",
                                @class = disabled
                                    ? "add-to-cart-button disabled"
                                    : "k-primary add-to-cart-button"
                            }))
                    }

                </article>
            }

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- LIST VIEW -->
    <!-- ========================================================= -->

    <div id="listView"
         class="procurement-view"
         style="display:none;">

        <div class="procurement-list-container">

            <table class="procurement-list">

                <thead>

                    <tr>

                        <th class="item-column">
                            Item
                        </th>

                        <th>
                            Unit
                        </th>

                        <th class="number-column">
                            Planned
                        </th>

                        <th class="number-column">
                            Requested
                        </th>

                        <th class="number-column">
                            Remaining
                        </th>

                        <th class="cost-column">
                            Est. Unit Cost
                        </th>

                        <th class="action-column">
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody id="procurementListBody">

                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="procurement-empty-state">
                                No procurement items match the selected filters.
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model.Items)
                    {
                        <tr class="procurement-list-item"
                            data-item-id="@item.Id">

                            <!-- Item -->
                            <td class="item-column">

                                <div class="list-item-info">

                                    <div class="list-item-code">
                                        @item.Code
                                    </div>

                                    <div class="list-item-description"
                                         title="@item.Description">

                                        @item.Description

                                    </div>

                                </div>

                            </td>


                            <!-- Unit -->
                            <td>
                                @item.Unit
                            </td>


                            <!-- Planned -->
                            <td class="number-column">
                                @item.Qty
                            </td>


                            <!-- Requested -->
                            <td class="number-column">
                                @item.QtyUsed
                            </td>


                            <!-- Remaining -->
                            <td class="number-column">

                                <strong class="remaining">
                                    @item.QtyBal
                                </strong>

                            </td>


                            <!-- Cost -->
                            <td class="cost-column">

                                <strong>
                                    @((item.UnitCost ?? 0m).ToString(
                                        "C2",
                                        System.Globalization.CultureInfo
                                            .GetCultureInfo("en-PH")))
                                </strong>

                            </td>


                            <!-- Action -->
                            <td class="action-column">

                                @using (Html.BeginForm(
                    "AddToCart",
                    "Procurement",
                    FormMethod.Post,
                    new
                    {
                        @class =
                            "add-to-cart-form list-add-to-cart-form",
                        data_item_id = item.Id
                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    @Html.Hidden("id", item.Id)
                                    if (Model.IsRevision)
        {
            @Html.Hidden("mode", "REVISION")
            @Html.Hidden("requestId", Model.RequestId)
        }
        else if (Model.IsDraftResume)
        {
            @Html.Hidden("mode", "NORMAL")
            @Html.Hidden("requestId", Model.RequestId)
        }

                                    var disabled =
                                        item.QtyBal <= 0 ||
                                        item.IsInCart;

                                    @(Html.Kendo().Button()
                                        .Name(
                                            "listAddToCart_" +
                                            item.Id)
                                        .Content(
                                            item.IsInCart
                                                ? "<span class='k-icon k-i-check'></span> In Cart"
                                                : item.QtyBal <= 0
                                                    ? "<span class='k-icon k-i-lock'></span> Fully Requested"
                                                    : "<span class='k-icon k-i-cart'></span> Add"
                                        )
                                        .Enable(!disabled)
                                        .HtmlAttributes(new
                                        {
                                            type = "submit",
                                            @class = disabled
                                                ? "add-to-cart-button disabled"
                                                : "k-primary add-to-cart-button"
                                        }))
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PAGINATION -->
    <!-- ========================================================= -->

    <div class="catalog-pagination">

        <div class="catalog-pagination-info">
            <span id="catalogPageInfo"></span>
        </div>

        <div class="catalog-pagination-controls">

            <button type="button"
                    id="catalogPrevious"
                    class="k-button">

                <span class="k-icon k-i-arrow-w"></span>
                Previous

            </button>

            <div id="catalogPageNumbers"
                 class="catalog-page-numbers">
            </div>

            <button type="button"
                    id="catalogNext"
                    class="k-button">

                Next

                <span class="k-icon k-i-arrow-e"></span>

            </button>

        </div>

        <div class="catalog-page-size">

            <label for="catalogPageSize">
                Items per page:
            </label>

            @(Html.Kendo().DropDownList()
                .Name("catalogPageSize")
                .BindTo(new[]
                {
                    new SelectListItem
                    {
                        Text = "20",
                        Value = "20"
                    },
                    new SelectListItem
                    {
                        Text = "40",
                        Value = "40"
                    },
                    new SelectListItem
                    {
                        Text = "60",
                        Value = "60"
                    }
                })
                .Value("20")
                .HtmlAttributes(new
                {
                    style = "width:80px"
                }))

        </div>

    </div>

</section>





<script type="text/javascript">

    $(document).ready(function () {

        /* =====================================================
           VIEW STATE
           ===================================================== */

        var currentView =
            localStorage.getItem(
                "epsms.annualProcurement.view"
            ) || "catalog";


        /* =====================================================
           KENDO VIEW SELECTOR
           ===================================================== */

        $("#procurementViewSelector").kendoButtonGroup({

            index:
            currentView === "catalog"
                ? 0
                : 1,

            items: [

                {
                    text:
                    "<span class='k-icon k-i-grid'></span> Catalog",
                    encoded: false
                },

                {
                    text:
                    "<span class='k-icon k-i-list-bulleted'></span> List",
                    encoded: false
                }

            ],

            select: function (e) {

                if (e.indices[0] === 0) {

                    setView("catalog");

                }
                else {

                    setView("list");

                }

            }

        });


        /* =====================================================
           SET VIEW
           ===================================================== */

        function setView(view) {

            currentView = view;

            localStorage.setItem(
                "epsms.annualProcurement.view",
                view
            );

            if (view === "catalog") {

                $("#catalogView").show();

                $("#listView").hide();

            }
            else {

                $("#catalogView").hide();

                $("#listView").show();

            }

            currentPage = 1;

            renderPagination();

        }


        /* =====================================================
           PAGINATION
           ===================================================== */

        var currentPage = 1;

        var pageSize = 20;

        var $catalogItems =
            $("#catalogGrid")
                .find(".catalog-card");

        var $listItems =
            $("#procurementListBody")
                .find(".procurement-list-item");

        var totalItems = 0;

        var totalPages = 0;


        function getCurrentItems() {

            return currentView === "catalog"
                ? $catalogItems
                : $listItems;

        }


        function renderPagination() {

            var $items =
                getCurrentItems();

            totalItems =
                $items.length;

            totalPages =
                Math.ceil(
                    totalItems / pageSize
                );


            if (
                currentPage > totalPages &&
                totalPages > 0
            ) {

                currentPage =
                    totalPages;

            }


            if (totalPages === 0) {

                currentPage = 1;

            }


            /*
             * Hide all items from both views.
             */
            $catalogItems.hide();

            $listItems.hide();


            /*
             * Calculate page indexes.
             */
            var startIndex =
                (currentPage - 1) *
                pageSize;

            var endIndex =
                startIndex +
                pageSize;


            /*
             * Display current page.
             */
            $items
                .slice(
                startIndex,
                endIndex
                )
                .show();


            renderPageNumbers();

            updateButtons();

            updatePageInfo();

        }


        /* =====================================================
           PAGE NUMBERS
           ===================================================== */

        function renderPageNumbers() {

            var $container =
                $("#catalogPageNumbers");

            $container.empty();


            if (totalPages <= 1) {

                return;

            }


            var startPage =
                Math.max(
                    1,
                    currentPage - 2
                );

            var endPage =
                Math.min(
                    totalPages,
                    currentPage + 2
                );


            if (startPage > 1) {

                addPageButton(1);

                if (startPage > 2) {

                    $container.append(
                        '<span class="catalog-page-ellipsis">...</span>'
                    );

                }

            }


            for (
                var i = startPage;
                i <= endPage;
                i++
            ) {

                addPageButton(i);

            }


            if (endPage < totalPages) {

                if (
                    endPage <
                    totalPages - 1
                ) {

                    $container.append(
                        '<span class="catalog-page-ellipsis">...</span>'
                    );

                }

                addPageButton(totalPages);

            }

        }


        function addPageButton(page) {

            var $button =
                $("<button>", {

                    type: "button",

                    class:
                    "k-button catalog-page-button",

                    text: page

                });


            if (page === currentPage) {

                $button.addClass(
                    "k-primary"
                );

            }


            $button.on(
                "click",
                function () {

                    currentPage =
                        page;

                    renderPagination();

                    scrollToProcurement();

                }
            );


            $("#catalogPageNumbers")
                .append($button);

        }


        /* =====================================================
           PREVIOUS
           ===================================================== */

        $("#catalogPrevious").on(
            "click",
            function () {

                if (currentPage > 1) {

                    currentPage--;

                    renderPagination();

                    scrollToProcurement();

                }

            }
        );


        /* =====================================================
           NEXT
           ===================================================== */

        $("#catalogNext").on(
            "click",
            function () {

                if (
                    currentPage <
                    totalPages
                ) {

                    currentPage++;

                    renderPagination();

                    scrollToProcurement();

                }

            }
        );


        /* =====================================================
           PAGE SIZE
           ===================================================== */

        var pageSizeDropDown =
            $("#catalogPageSize")
                .data("kendoDropDownList");


        if (pageSizeDropDown) {

            pageSizeDropDown.bind(
                "change",
                function () {

                    pageSize =
                        parseInt(
                            this.value(),
                            10
                        );

                    currentPage = 1;

                    renderPagination();

                }
            );

        }


        /* =====================================================
           BUTTON STATE
           ===================================================== */

        function updateButtons() {

            $("#catalogPrevious")
                .prop(
                "disabled",
                currentPage <= 1
                );


            $("#catalogNext")
                .prop(
                "disabled",
                currentPage >= totalPages
                );

        }


        /* =====================================================
           PAGE INFORMATION
           ===================================================== */

        function updatePageInfo() {

            if (totalItems === 0) {

                $("#catalogPageInfo").text(
                    "No procurement items found."
                );

                return;

            }


            var startItem =
                ((currentPage - 1) *
                    pageSize) + 1;


            var endItem =
                Math.min(
                    currentPage *
                    pageSize,
                    totalItems
                );


            $("#catalogPageInfo").text(

                "Showing " +
                startItem +
                "-" +
                endItem +
                " of " +
                totalItems +
                " items"

            );

        }


        /* =====================================================
           SCROLL
           ===================================================== */

        function scrollToProcurement() {

            var $target =
                currentView === "catalog"
                    ? $("#catalogView")
                    : $("#listView");


            if (!$target.length) {
                return;
            }


            $("html, body").animate({

                scrollTop:
                $target.offset().top - 100

            }, 200);

        }


        /* =====================================================
           CART SYNCHRONIZATION
           ===================================================== */

        /*
         * Catalog and List views use the same Item Id.
         *
         * Catalog:
         *     .catalog-card[data-item-id]
         *
         * List:
         *     .procurement-list-item[data-item-id]
         *
         * The Item Id is therefore the single
         * synchronization key.
         */


        function synchronizeCartState(itemId) {

            var normalizedId =
                String(itemId).toLowerCase();


            $(
                ".catalog-card[data-item-id], " +
                ".procurement-list-item[data-item-id]"
            ).each(function () {

                var $item =
                    $(this);


                var currentId =
                    String(
                        $item.attr(
                            "data-item-id"
                        )
                    ).toLowerCase();


                if (
                    currentId !==
                    normalizedId
                ) {

                    return;

                }


                /*
                 * =============================================
                 * CATALOG BUTTON
                 * =============================================
                 */

                var $catalogButton =
                    $item.find(
                        ".catalog-add-to-cart-form " +
                        ".add-to-cart-button"
                    );


                if ($catalogButton.length) {

                    $catalogButton
                        .html(
                        "<span class='k-icon k-i-check'></span> " +
                        "Already in Cart"
                        )
                        .prop(
                        "disabled",
                        true
                        )
                        .removeClass(
                        "k-primary"
                        )
                        .removeClass(
                        "cart-updating"
                        )
                        .addClass(
                        "disabled"
                        );

                }


                /*
                 * =============================================
                 * LIST BUTTON
                 * =============================================
                 */

                var $listButton =
                    $item.find(
                        ".list-add-to-cart-form " +
                        ".add-to-cart-button"
                    );


                if ($listButton.length) {

                    $listButton
                        .html(
                        "<span class='k-icon k-i-check'></span> " +
                        "In Cart"
                        )
                        .prop(
                        "disabled",
                        true
                        )
                        .removeClass(
                        "k-primary"
                        )
                        .removeClass(
                        "cart-updating"
                        )
                        .addClass(
                        "disabled"
                        );

                }

            });

        }


        /* =====================================================
           RESTORE ADD TO CART BUTTON
           ===================================================== */

        function restoreAddToCartButton($form) {

            var $button =
                $form.find(
                    ".add-to-cart-button"
                );


            if (!$button.length) {
                return;
            }


            $button
                .prop(
                "disabled",
                false
                )
                .removeClass(
                "disabled"
                )
                .removeClass(
                "cart-updating"
                )
                .addClass(
                "k-primary"
                );


            if (
                $form.hasClass(
                    "catalog-add-to-cart-form"
                )
            ) {

                $button.html(
                    "<span class='k-icon k-i-cart'></span> " +
                    "Add to Cart"
                );

            }
            else {

                $button.html(
                    "<span class='k-icon k-i-cart'></span> " +
                    "Add"
                );

            }

        }


        /* =====================================================
           UPDATE CART COUNT
           ===================================================== */

        function updateCartCount(cartCount) {

            if (
                cartCount === undefined ||
                cartCount === null
            ) {

                return;

            }


            /*
             * Update the cart badge if it exists.
             */
            $("#cartCount").text(
                cartCount
            );

            @if (!Model.IsRevision)
            {
                <text>
                if (typeof updateCartBadge === "function") {
                    updateCartBadge(cartCount);
                }
                </text>
            }

        }


        /* Signal to the global _AppLayout.cshtml handler that this page
           owns the .add-to-cart-form submission (supports Revision/AdminEdit).
           The layout handler will skip when this flag is set. */
        window.__annualCartHandlerRegistered = true;

        /* =====================================================
           AJAX ADD TO CART
           ===================================================== */

        $(document).on(
            "submit",
            ".add-to-cart-form",
            function (e) {

                e.preventDefault();


                var $form =
                    $(this);


                var itemId =
                    $form
                        .find(
                        "input[name='id']"
                        )
                        .val();


                if (!itemId) {

                    console.error(
                        "AddToCart: Item ID is missing."
                    );

                    return;

                }

                /*
                 * Catalog and list views each contain a form for the same
                 * item. Lock both forms so only one request can be active
                 * for an item at a time.
                 */
                var $relatedForms =
                    $(".add-to-cart-form").filter(function () {
                        return String(
                            $(this).find("input[name='id']").val()
                        ).toLowerCase() === String(itemId).toLowerCase();
                    });


                /*
                 * Prevent double submission.
                 */
                if (
                    $relatedForms.filter(function () {
                        return $(this).data("submitting") === true;
                    }).length > 0
                ) {

                    return;

                }


                $relatedForms.data(
                    "submitting",
                    true
                );


                var $button =
                    $relatedForms.find(
                        ".add-to-cart-button"
                    );


                /*
                 * Show temporary processing state.
                 */
                $button
                    .addClass(
                    "cart-updating"
                    )
                    .prop(
                    "disabled",
                    true
                    );


                /*
                 * Submit the existing MVC form.
                 *
                 * This preserves:
                 * - AntiForgeryToken
                 * - id
                 */
                $.ajax({

                    url:
                    $form.attr(
                        "action"
                    ),

                    type: "POST",

                    data:
                    $form.serialize(),

                    dataType: "json",

                    cache: false,


                    success: function (
                        response
                    ) {

                        console.log(
                            "AddToCart response:",
                            response
                        );


                        /*
                         * =====================================
                         * ITEM SUCCESSFULLY ADDED
                         * =====================================
                         */

                        if (
                            response &&
                            response.success === true
                        ) {

                            /*
                             * Synchronize the same
                             * item in BOTH views.
                             */
                            synchronizeCartState(
                                itemId
                            );


                            /*
                             * Update cart count.
                             */
                            updateCartCount(
                                response.cartCount
                            );


                            $relatedForms.data(
                                "submitting",
                                false
                            );


                            return;

                        }


                        /*
                         * =====================================
                         * ITEM ALREADY IN CART
                         * =====================================
                         */

                        if (
                            response &&
                            response.alreadyInCart === true
                        ) {

                            synchronizeCartState(
                                itemId
                            );


                            updateCartCount(
                                response.cartCount
                            );


                            $relatedForms.data(
                                "submitting",
                                false
                            );


                            return;

                        }


                        /*
                         * =====================================
                         * BUSINESS VALIDATION ERROR
                         * =====================================
                         */

                        $relatedForms.each(function () {
                            restoreAddToCartButton($(this));
                        });


                        $relatedForms.data(
                            "submitting",
                            false
                        );


                        alert(
                            response &&
                                response.message
                                ? response.message
                                : "Unable to add the item to the cart."
                        );

                    },


                    error: function (
                        xhr,
                        status,
                        error
                    ) {

                        console.error(
                            "AddToCart AJAX error:",
                            status,
                            error
                        );


                        console.error(
                            "HTTP Status:",
                            xhr.status
                        );


                        console.error(
                            "Response:",
                            xhr.responseText
                        );


                        $relatedForms.each(function () {
                            restoreAddToCartButton($(this));
                        });


                        $relatedForms.data(
                            "submitting",
                            false
                        );


                        alert(
                            "Unable to add the item to the cart."
                        );

                    }

                });

            }
        );


        /* =====================================================
           INITIAL VIEW
           ===================================================== */

        setView(
            currentView
        );

    });

</script>

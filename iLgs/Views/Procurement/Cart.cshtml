@model iLgs.Models.CartViewModel
@using Kendo.Mvc.UI

@{
    var isDraftResume = !Model.IsAdminEdit && !Model.IsRevision && Model.RequestId.HasValue;
    ViewBag.Title = Model.IsAdminEdit
        ? "Admin Edit - Purchase Request"
        : (Model.IsRevision
            ? "Purchase Request Revision"
            : (isDraftResume ? "Continue Draft Purchase Request" : "My Procurement Cart"));
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<link href="@Url.Content("~/Content/procurement.css")?v=20260916_1" rel="stylesheet" type="text/css" />

<script type="text/javascript">
    /* ==========================================================================
       CART TEMPLATE HELPERS & FORMATTERS
       Defined before Grid initialization for complete template execution safety
       ========================================================================== */
    function renderCartItemCode(data) {
        if (!data || !data.Code) return "";
        var encoded = kendo.htmlEncode(data.Code);
        return "<span class='cart-item-code'>" + encoded + "</span>";
    }

    function renderCartUnitCost(data) {
        if (!data || data.UnitCost == null) return "&#8369;0.00";
        return "&#8369;" + kendo.toString(data.UnitCost, "n2");
    }

    function renderCartEstimatedAmount(data) {
        if (!data || data.EstimatedAmount == null) return "&#8369;0.00";
        return "&#8369;" + kendo.toString(data.EstimatedAmount, "n2");
    }
</script>

<section class="epsms-procurement epsms-procurement-cart">
    <div class="breadcrumbs">
        @if (Model.IsAdminEdit)
        {
            <a href="@Url.Action("Posting", "Requests")">Requests / Posting</a>
            <span class="breadcrumb-separator">&gt;</span>
            <span>Admin Edit Cart</span>
        }
        else
        {
            <a href="@Url.Action("Index", "Requests")">Purchase Requests</a>
            <span class="breadcrumb-separator">&gt;</span>
            <a href="@((Model.IsRevision || isDraftResume) ? Url.Action("Annual", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }) : Url.Action("Annual", "Procurement"))">Annual Procurement</a>
            <span class="breadcrumb-separator">&gt;</span>
            <span>My Cart</span>
        }
    </div>

    <!-- Page Header -->
    <div class="procurement-header">
        <div class="header-title-group">
            <div class="header-icon-pill">
                <span class="k-icon k-i-cart"></span>
            </div>
            <div>
                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:4px;">
                    <h1 style="margin:0;">@(Model.IsAdminEdit ? "Admin Edit - Purchase Request" : (Model.IsRevision ? "Purchase Request Revision" : (isDraftResume ? "Continue Draft Purchase Request" : "My Procurement Cart")))</h1>
                    @if (Model.IsAdminEdit)
                    {
                        <span id="adminEditCartCountBadge" class="badge" style="background-color: #e0e7ff; color: #3730a3; font-size: 0.95rem; font-weight: 600; padding: 4px 10px; border-radius: 6px;">
                            Admin Edit Cart: @(Model.Items == null ? 0 : Model.Items.Count) @((Model.Items != null && Model.Items.Count == 1) ? "item" : "items")
                        </span>
                    }
                    else if (Model.IsRevision)
                    {
                        <span class="badge" style="background-color: #fef3c7; color: #92400e; font-size: 0.95rem; font-weight: 600; padding: 4px 10px; border-radius: 6px;">
                            Revision Cart: @(Model.Items == null ? 0 : Model.Items.Count) @((Model.Items != null && Model.Items.Count == 1) ? "item" : "items")
                        </span>
                    }
                    else if (isDraftResume)
                    {
                        <span id="draftCartCountBadge" class="badge" style="background-color: #e2e8f0; color: #334155; font-size: 0.95rem; font-weight: 600; padding: 4px 10px; border-radius: 6px;">
                            Draft Cart: @(Model.Items == null ? 0 : Model.Items.Count) @((Model.Items != null && Model.Items.Count == 1) ? "item" : "items")
                        </span>
                    }
                </div>
                <p class="subtitle">@(Model.IsAdminEdit ? "Make administrative corrections to the submitted/unposted Purchase Request. Adding new catalog items is disabled." : (Model.IsRevision ? "Update the returned Purchase Request, then proceed to Checkout to resubmit it." : (isDraftResume ? "Continue updating the same Draft Purchase Request, then proceed to Checkout to submit it." : "Review quantities before creating your purchase request.")))</p>
            </div>
        </div>
        <div class="header-actions">
            @if (Model.IsAdminEdit)
            {
                <a class="k-button btn-secondary-action" href="@Url.Action("CancelAdminEdit", "Procurement", new { requestId = Model.RequestId })">
                    <span class="k-icon k-i-close"></span> Cancel Admin Edit
                </a>
            }
            else if (Model.IsRevision)
            {
                <a class="k-button btn-secondary-action" href="@Url.Action("Annual", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId })">
                    <span class="k-icon k-i-arrow-left"></span> Add More Items
                </a>
            }
            else
            {
                <a class="k-button btn-secondary-action" href="@(isDraftResume ? Url.Action("Annual", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }) : Url.Action("Annual", "Procurement"))">
                    <span class="k-icon k-i-arrow-left"></span> @(isDraftResume ? "Add More Items" : "Continue Shopping")
                </a>
            }
        </div>
    </div>

        @if (Model.IsAdminEdit)
    {
        <div class="pr-revision-notice" style="border-left: 4px solid #d97706; background-color: #fffbeb;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
                <div>
                    <strong style="color: #b45309; font-size: 1.05rem;"><span class="k-icon k-i-edit"></span> Admin Edit &mdash; Purchase Request Correction</strong>
                    <div style="margin-top: 6px; font-size: 0.9rem; color: #374151;">
                        <span><b>PR Reference:</b> @(String.IsNullOrWhiteSpace(Model.AdminEditPrNo) ? (String.IsNullOrWhiteSpace(Model.AdminEditCtrlNo) ? "Unassigned" : Model.AdminEditCtrlNo) : Model.AdminEditPrNo)</span>
                        <span style="margin: 0 8px; color: #9ca3af;">&bull;</span>
                        <span><b>Status:</b> <span class="badge badge-warning" style="background-color: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 4px; font-weight: 600;">@(String.IsNullOrWhiteSpace(Model.AdminEditStatus) ? "Submitted" : Model.AdminEditStatus)</span></span>
                        <span style="margin: 0 8px; color: #9ca3af;">&bull;</span>
                        <span><b>Department:</b> @(String.IsNullOrWhiteSpace(Model.AdminEditDepartment) ? "N/A" : Model.AdminEditDepartment)</span>
                    </div>
                </div>
                <div>
                    <span style="background-color: #fee2e2; color: #991b1b; padding: 4px 10px; border-radius: 4px; font-size: 0.85rem; font-weight: 500;">
                        <span class="k-icon k-i-lock"></span> Catalog additions disabled
                    </span>
                </div>
            </div>
            <p style="margin-top: 8px; margin-bottom: 0; font-size: 0.85rem; color: #4b5563;">
                You may modify existing item quantities, specifications, or sub-items, or remove permitted lines. Proceed to Checkout to save changes directly to this Purchase Request.
            </p>
        </div>
    }

    @if (Model.IsRevision)
    {
        <div class="pr-revision-notice">
            <strong>Returned for Revision</strong>
            <span>Revision No. @Model.RevisionNo</span>
            <p><b>Reviewer Comment:</b> @(String.IsNullOrWhiteSpace(Model.ReviewComment) ? "No comment was recorded." : Model.ReviewComment)</p>
        </div>
        <div class="pr-revision-toolbar">
            <a class="k-button k-button-solid-base" href="@Url.Action("Annual", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId })"><span class="k-icon k-i-plus"></span> Add More Items</a>
            <span>Cart changes are saved automatically for this session.</span>
        </div>
    }

    @Html.AntiForgeryToken()

    @(Html.Kendo().Grid<iLgs.Models.CartItemViewModel>()
        .Name("cartGrid")
        .Columns(columns =>
        {
            columns.Bound(x => x.ItemNo)
                .Title("Item No.")
                .Width(75);
            columns.Bound(x => x.Code)
                .Title("Item Code")
                .Width(130)
                .ClientTemplate("#= renderCartItemCode(data) #");
            columns.Bound(x => x.Description)
                .HtmlAttributes(new { @class = "cart-multiline-description" });
            columns.Bound(x => x.Unit)
                .Width(95);
            columns.Bound(x => x.Quantity)
                .Width(110)
                .Title("Quantity");
            columns.Bound(x => x.UnitCost)
                .Title("Unit Cost")
                .Width(130)
                .ClientTemplate("#= renderCartUnitCost(data) #");
            columns.Bound(x => x.EstimatedAmount)
                .Title("Est. Amount")
                .Width(140)
                .ClientTemplate("#= renderCartEstimatedAmount(data) #");

            columns.Command(command =>
            {
                command.Edit().Text("Edit");
                command.Destroy().Text("Remove");
            }).Width(180);
        })
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .ClientDetailTemplateId("cartSubItemsTemplate")
        .Events(events => events
            .Edit("onCartGridEdit")
            .DetailInit("onCartDetailInit"))
        .Scrollable(scrollable => scrollable.Height(350))
        .Pageable()
        .Sortable()
        .HtmlAttributes(new { @class = "data-card" })
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(10)
            .Events(events => events.Error("onCartGridError"))
            .Model(model =>
            {
                model.Id(x => x.Id);
                model.Field(x => x.ItemNo).Editable(false);
                model.Field(x => x.Code).Editable(false);
                model.Field(x => x.Description).Editable(true);
                model.Field(x => x.Unit).Editable(Model.IsAdminEdit);
                model.Field(x => x.Quantity).Editable(true);
                model.Field(x => x.UnitCost).Editable(Model.IsAdminEdit);
                model.Field(x => x.EstimatedAmount).Editable(false);
            })
            .Read(read => read.Action("CartRead", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId, cartId = Model.CartId }))
            .Update(update => update
                .Action("UpdateCartItem", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId })
                .Data("addAntiForgeryToken"))
            .Destroy(destroy => destroy
                .Action("RemoveCartItem", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId })
                .Data("addAntiForgeryToken"))
            .Events(events => events.RequestEnd("onCartGridRequestEnd"))
        )
    )

    <div class="summary-bar">
        <span>Estimated Total</span>
        <strong id="cartEstimatedTotal">
            @Model.EstimatedTotal.ToString("C2",
                System.Globalization.CultureInfo.GetCultureInfo("en-PH"))
        </strong>

        @(Html.Kendo().Button()
            .Name("proceedToCheckout")
            .Content("<span class='k-icon k-i-arrow-right'></span> " + (Model.IsAdminEdit ? "Proceed to Checkout" : (Model.IsRevision ? "Proceed to Revision Checkout" : "Proceed to Checkout")))
            .HtmlAttributes(new
            {
                type = "button",
                @class = "k-primary",
                style = "min-width: 180px;"
            })
            .Events(e => e.Click("proceedToCheckout"))
            .Enable(Model.Items != null && Model.Items.Any())
        )
    </div>
</section>

<script id="cartSubItemsTemplate" type="text/x-kendo-template">
    <div class="cart-sub-items-host"></div>
</script>

@section scripts {
    <script>
        var cartSubItemUrls = {
            read: "@Html.Raw(Url.Action("CartSubItemsRead", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }))",
            create: "@Html.Raw(Url.Action("CreateCartSubItem", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }))",
            update: "@Html.Raw(Url.Action("UpdateCartSubItem", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }))",
            destroy: "@Html.Raw(Url.Action("RemoveCartSubItem", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId }))",
            units: "@Url.Action("GetUnits", "Getters")"
        };

        var isAdminEditMode = @(Model.IsAdminEdit ? "true" : "false");



        function columnTemplate(value) {
            var encodedValue = kendo.htmlEncode(value || "");
            return "<span title='" + encodedValue + "'>" + encodedValue + "</span>";
        }

        function cartSubItemUnitEditor(container, options) {
            var $input =
                $("<input required name='" + options.field +
                    "' data-bind='value:" + options.field + "' />")
                    .appendTo(container);

            $input.kendoMultiColumnComboBox({
                    placeholder: "Select unit",
                    dataTextField: "Code",
                    dataValueField: "Code",
                    valuePrimitive: true,
                    filter: "contains",
                    autoBind: false,
                    suggest: true,
                    dataSource: {
                        transport: {
                            read: {
                                url: cartSubItemUrls.units,
                                dataType: "json",
                                data: function () {
                                    var widget =
                                        $input.data("kendoMultiColumnComboBox");
                                    return {
                                        text: widget ? widget.input.val() : ""
                                    };
                                }
                            }
                        },
                        serverFiltering: true
                    },
                    columns: [
                        { field: "Code", title: "Code", width: 100 },
                        {
                            field: "Description",
                            title: "Description",
                            width: 220,
                            template: "#= columnTemplate(data.Description) #"
                        },
                        {
                            field: "Desc2",
                            title: "Category",
                            width: 180,
                            template: "#= columnTemplate(data.Desc2) #"
                        }
                    ]
                });
        }

        function cartDescriptionEditor(container, options) {
            $("<textarea class='k-textbox cart-description-editor' " +
                "name='" + options.field + "' data-bind='value:" +
                options.field + "' rows='4'></textarea>")
                .appendTo(container);
        }

        function cartSubItemRequestData(parentItemId) {
            return {
                parentItemId: parentItemId,
                __RequestVerificationToken:
                    $("input[name='__RequestVerificationToken']").val()
            };
        }

        function onCartDetailInit(e) {
            var parentItemId = e.data.Id;
            var $host = e.detailCell.find(".cart-sub-items-host");

            $("<div class='cart-sub-items-title'>User-defined sub-items</div>")
                .prependTo($host);

            var $subGridElement = $("<div />").appendTo($host);

            $subGridElement.kendoGrid({
                toolbar: [{
                    template: "<button type='button' class='k-button k-primary cart-add-sub-item'>" +
                        "<span class='k-icon k-i-plus'></span>Add Sub-item</button>"
                }],
                editable: "inline",
                scrollable: true,
                height: 200,
                sortable: false,
                pageable: false,
                columns: [
                    { field: "ItemNo", title: "Item No.", width: 85 },
                    {
                        field: "Description",
                        title: "Description",
                        editor: cartDescriptionEditor,
                        attributes: { "class": "cart-multiline-description" }
                    },
                    {
                        field: "Unit",
                        title: "Unit",
                        width: 120,
                        editor: cartSubItemUnitEditor
                    },
                    { field: "Quantity", title: "Qty", width: 95, format: "{0:n2}" },
                    {
                        field: "UnitCost",
                        title: "Unit Cost",
                        width: 125,
                        template: "\u20B1#= kendo.toString(UnitCost, 'n2') #"
                    },
                    {
                        field: "Total",
                        title: "Total",
                        width: 130,
                        template: "\u20B1#= kendo.toString(Total, 'n2') #"
                    },
                    {
                        command: [
                            { name: "edit", text: "Edit" },
                            { name: "destroy", text: "Remove" }
                        ],
                        width: 175
                    }
                ],
                dataSource: {
                    transport: {
                        read: {
                            url: cartSubItemUrls.read,
                            type: "POST",
                            data: function () {
                                return cartSubItemRequestData(parentItemId);
                            }
                        },
                        create: {
                            url: cartSubItemUrls.create,
                            type: "POST",
                            data: function () {
                                return cartSubItemRequestData(parentItemId);
                            }
                        },
                        update: {
                            url: cartSubItemUrls.update,
                            type: "POST",
                            data: function () {
                                return cartSubItemRequestData(parentItemId);
                            }
                        },
                        destroy: {
                            url: cartSubItemUrls.destroy,
                            type: "POST",
                            data: function () {
                                return cartSubItemRequestData(parentItemId);
                            }
                        }
                    },
                    error: onCartSubItemError,
                    requestEnd: function (request) {
                        var isMutation =
                            request.type === "create" ||
                            request.type === "update" ||
                            request.type === "destroy";

                        if (isMutation &&
                            request.response &&
                            !request.response.Errors) {
                            this.read();
                        }
                    },
                    schema: {
                        data: "Data",
                        total: "Total",
                        errors: "Errors",
                        model: {
                            id: "Id",
                            fields: {
                                Id: {
                                    type: "string",
                                    editable: false,
                                    nullable: true,
                                    defaultValue: null
                                },
                                ParentItemId: {
                                    type: "string",
                                    editable: false,
                                    defaultValue: parentItemId
                                },
                                ItemNo: { type: "string", editable: false },
                                Description: {
                                    type: "string",
                                    validation: { required: true }
                                },
                                Unit: {
                                    type: "string",
                                    validation: { required: true }
                                },
                                Quantity: {
                                    type: "number",
                                    defaultValue: 1,
                                    validation: { required: true, min: 0.01 }
                                },
                                UnitCost: {
                                    type: "number",
                                    defaultValue: 0,
                                    validation: { required: true, min: 0 }
                                },
                                Total: { type: "number", editable: false }
                            }
                        }
                    }
                }
            });

            var subGrid = $subGridElement.data("kendoGrid");
            subGrid.wrapper.on("click.cartSubItem", ".cart-add-sub-item", function (event) {
                event.preventDefault();
                event.stopPropagation();

                // Explicit insertion is more reliable than Grid.addRow() inside
                // a hierarchy/detail row. It also guarantees that Kendo regards
                // the item as new and therefore calls the create transport.
                var newSubItem = subGrid.dataSource.insert(0, {
                    Id: null,
                    ParentItemId: parentItemId,
                    ItemNo: "New",
                    Description: "",
                    Unit: "",
                    Quantity: 1,
                    UnitCost: 0,
                    Total: 0
                });
                var $newRow = subGrid.tbody.find("tr[data-uid='" +
                    newSubItem.uid + "']");

                if (!$newRow.length) {
                    alert("Unable to open a new sub-item row. Please refresh the cart and try again.");
                    return;
                }

                subGrid.editRow($newRow);
            });
        }

        function onCartSubItemError(e) {
            var messages = [];

            if (e.errors) {
                $.each(e.errors, function (fieldName, error) {
                    if (error.errors) {
                        $.each(error.errors, function () {
                            messages.push(this);
                        });
                    }
                });
            }

            if (!messages.length) {
                return;
            }

            $("[data-role='grid']").each(function () {
                var grid = $(this).data("kendoGrid");
                if (grid && grid.dataSource === e.sender) {
                    grid.one("dataBinding", function (event) {
                        event.preventDefault();
                    });
                }
            });

            alert(messages.join("\n"));
        }

        function onCartGridError(e) {
            var messages = [];

            if (e.errors) {
                $.each(e.errors, function (fieldName, error) {
                    if (error.errors) {
                        $.each(error.errors, function () {
                            messages.push(this);
                        });
                    }
                });
            }

            if (messages.length) {
                // Prevent the Grid from rebinding and losing the edit context.
                var grid = $("#cartGrid").data("kendoGrid");

                grid.one("dataBinding", function (event) {
                    event.preventDefault();
                });

                alert(messages.join("\n"));
            }
        }

        function addAntiForgeryToken(data) {
            data.__RequestVerificationToken =
                $("input[name='__RequestVerificationToken']").val();

            return data;
        }

        function refreshCartSummary() {
            $.get("@Html.Raw(Url.Action("CartSummary", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId, cartId = Model.CartId }))", function (result) {
                $("#cartEstimatedTotal").text(
                    kendo.toString(result.estimatedTotal, "c2")
                        .replace("$", "\u20B1")
                );

                // The global My Cart badge belongs only to the standalone NORMAL cart.
                // Request-bound Draft, Revision, and Admin Edit carts keep their own local counts.
                @if (!Model.IsAdminEdit && !Model.IsRevision && !isDraftResume)
                {
                    <text>
                    if (typeof updateCartBadge === "function") {
                        updateCartBadge(result.cartCount);
                    }
                    </text>
                }
                else if (Model.IsAdminEdit)
                {
                    <text>
                    $("#adminEditCartCountBadge").text(
                        "Admin Edit Cart: " + result.itemCount + (result.itemCount === 1 ? " item" : " items")
                    );
                    </text>
                }
                else if (isDraftResume)
                {
                    <text>
                    $("#draftCartCountBadge").text(
                        "Draft Cart: " + result.itemCount + (result.itemCount === 1 ? " item" : " items")
                    );
                    </text>
                }

                var checkoutButton = $("#proceedToCheckout").data("kendoButton");
                if (checkoutButton) {
                    checkoutButton.enable(result.itemCount > 0);
                }
            });
        }

        function onCartGridRequestEnd(e) {
            if (e.type === "read" || e.type === "update" || e.type === "destroy") {
                refreshCartSummary();
            }
        }

        function onCartGridEdit(e) {
            var descriptionInput = e.container.find("input[name='Description']");

            if (descriptionInput.length) {
                var descriptionValue = descriptionInput.val();
                var $textArea =
                    $("<textarea class='k-textbox cart-description-editor' " +
                        "name='Description' data-bind='value:Description' " +
                        "rows='4'></textarea>")
                        .val(descriptionValue);

                descriptionInput.replaceWith($textArea);
                kendo.bind($textArea, e.model);
            }

            var quantityInput = e.container
                .find("input[name='Quantity']")
                .data("kendoNumericTextBox");

            if (!quantityInput) {
                return;
            }

            var maxQuantity = Number(e.model.QtyBal);

            quantityInput.min(1);

            if (!isNaN(maxQuantity) && maxQuantity > 0) {
                quantityInput.max(maxQuantity);
            }

            if (isAdminEditMode) {
                var unitInput = e.container.find("input[name='Unit']");
                if (unitInput.length && !unitInput.data("kendoMultiColumnComboBox")) {
                    unitInput.kendoMultiColumnComboBox({
                        placeholder: "Select unit",
                        dataTextField: "Code",
                        dataValueField: "Code",
                        valuePrimitive: true,
                        filter: "contains",
                        autoBind: false,
                        suggest: true,
                        dataSource: {
                            transport: {
                                read: {
                                    url: cartSubItemUrls.units,
                                    dataType: "json",
                                    data: function () {
                                        var widget = unitInput.data("kendoMultiColumnComboBox");
                                        return {
                                            text: widget ? widget.input.val() : ""
                                        };
                                    }
                                }
                            },
                            serverFiltering: true
                        },
                        columns: [
                            { field: "Code", title: "Code", width: 100 },
                            {
                                field: "Description",
                                title: "Description",
                                width: 220,
                                template: "#= columnTemplate(data.Description) #"
                            },
                            {
                                field: "Desc2",
                                title: "Category",
                                width: 180,
                                template: "#= columnTemplate(data.Desc2) #"
                            }
                        ]
                    });
                }

                var unitCostWidget = e.container
                    .find("input[name='UnitCost']")
                    .data("kendoNumericTextBox");
                if (unitCostWidget) {
                    unitCostWidget.min(0.01);
                } else {
                    var unitCostInput = e.container.find("input[name='UnitCost']");
                    if (unitCostInput.length) {
                        unitCostInput.kendoNumericTextBox({
                            format: "n2",
                            decimals: 2,
                            min: 0.01,
                            placeholder: "0.00"
                        });
                    }
                }
            }
        }

        function proceedToCheckout(e) {
            window.location.href = "@Html.Raw(Url.Action("Checkout", "Procurement", new { mode = Model.CartMode, requestId = Model.RequestId, cartId = Model.CartId }))";
        }

        $(document).ready(function () {
            refreshCartSummary();
        });
    </script>
}

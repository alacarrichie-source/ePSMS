@model iLgs.Models.PurchaseRequestViewModel
@using System.Collections.Generic
@using System.Globalization
@using Kendo.Mvc.UI

@{
    ViewBag.Title = Model.IsAdminEdit ? "Admin Edit - Purchase Request Checkout" : (Model.IsRevision ? "Purchase Request Revision Checkout" : "Purchase Request Checkout");
    Layout = "~/Views/Shared/_AppLayout.cshtml";

    var cartItems = Model.Items ?? new List<iLgs.Models.CartItemViewModel>();    
}

<link href="@Url.Content("~/Content/procurement.css")?v=20260916_2" rel="stylesheet" type="text/css" />

<section class="epsms-procurement epsms-procurement-checkout">
    <div class="checkout-breadcrumbs">
        @if (Model.IsAdminEdit)
        {
            <a href="@Url.Action("Posting", "Requests")">Requests / Posting</a>
            <span class="breadcrumb-separator">&gt;</span>
            <a href="@Url.Action("Cart", "Procurement", new { mode = Model.CartMode, requestId = Model.SourceRequestId })">Admin Edit Cart</a>
            <span class="breadcrumb-separator">&gt;</span>
            <span class="breadcrumb-current">Checkout</span>
        }
        else
        {
            <a href="@Url.Action("Index", "Requests")">Purchase Requests</a>
            <span class="breadcrumb-separator">&gt;</span>
            <a href="@Url.Action("Annual")">Annual Procurement</a>
            <span class="breadcrumb-separator">&gt;</span>
            <a href="@Url.Action("Cart")">My Cart</a>
            <span class="breadcrumb-separator">&gt;</span>
            <span class="breadcrumb-current">Checkout</span>
        }
    </div>

    <div class="checkout-header">
        <div class="checkout-title-group">
            <h1>
                <span class="checkout-title-icon"><span class="k-icon k-i-check-outline"></span></span>
                @(Model.IsAdminEdit ? "Admin Edit - Purchase Request Checkout" : (Model.IsRevision ? "Purchase Request Revision Checkout" : "Purchase Request Checkout"))
            </h1>
            <p class="checkout-subtitle">@(Model.IsAdminEdit ? "Review administrative corrections to the Purchase Request before saving changes." : (Model.IsRevision ? "Review the revised Purchase Request before returning it to the review queue." : "Review and finalize your procurement request details."))</p>
        </div>
    </div>

        @if (Model.IsAdminEdit)
    {
        <div class="pr-revision-notice" style="border-left: 4px solid #d97706; background-color: #fffbeb;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
                <div>
                    <strong style="color: #b45309; font-size: 1.05rem;"><span class="k-icon k-i-edit"></span> Admin Edit &mdash; Updating Existing Purchase Request</strong>
                    <div style="margin-top: 6px; font-size: 0.9rem; color: #374151;">
                        <span><b>PR Reference:</b> @(String.IsNullOrWhiteSpace(Model.AdminEditPrNo) ? (String.IsNullOrWhiteSpace(Model.AdminEditCtrlNo) ? "Unassigned" : Model.AdminEditCtrlNo) : Model.AdminEditPrNo)</span>
                        <span style="margin: 0 8px; color: #9ca3af;">&bull;</span>
                        <span><b>Status:</b> <span class="badge badge-warning" style="background-color: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 4px; font-weight: 600;">@(String.IsNullOrWhiteSpace(Model.AdminEditStatus) ? "Submitted" : Model.AdminEditStatus)</span></span>
                        <span style="margin: 0 8px; color: #9ca3af;">&bull;</span>
                        <span><b>Department:</b> @(String.IsNullOrWhiteSpace(Model.AdminEditDepartment) ? "N/A" : Model.AdminEditDepartment)</span>
                    </div>
                </div>
            </div>
            <p style="margin-top: 8px; margin-bottom: 0; font-size: 0.85rem; color: #4b5563;">
                Saving checkout will update the existing Purchase Request, reconcile item quantities and PPMP allocations, and return you to Requests / Posting without altering the PR Number or workflow status.
            </p>
        </div>
    }

    @if (Model.IsRevision)
    {
        <div class="pr-revision-notice">
            <strong><span class="k-icon k-i-warning"></span> Returned for Revision</strong>
            <span>Revision No. @Model.RevisionNo</span>
            <p><b>Reviewer Comment:</b> @(String.IsNullOrWhiteSpace(Model.ReviewComment) ? "No comment was recorded." : Model.ReviewComment)</p>
        </div>
    }

    @using (Html.BeginForm("Checkout", "Procurement", FormMethod.Post, new { name = "formCheckout", id = "formCheckout" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.CheckoutToken)
        @Html.HiddenFor(m => m.CartId)
        @Html.HiddenFor(m => m.CartMode)
        @Html.HiddenFor(m => m.SourceRequestId)
        @Html.HiddenFor(m => m.RequestId)
        @Html.ValidationSummary(
            true,
            "",
            new { @class = "text-danger validation-summary-errors" })

        @Html.HiddenFor(m => m.DeptId)

        <div class="checkout-grid">
            <section class="checkout-form-card">
                <h2 class="checkout-section-title">
                    <span class="k-icon k-i-file-data"></span> Purchase Request Information
                </h2>

                <div class="checkout-form-grid">                                                                      
                    <div class="checkout-form-group wide">
                        <label>@Html.DisplayNameFor(m => m.Department)</label>
                        @(Html.Kendo().TextBoxFor(m => m.Department)
                            .HtmlAttributes(new
                            {
                                style = "width:100%",
                                @readonly = "readonly"
                            }))
                    </div>

                    <div class="checkout-form-group wide">
                        <label>@Html.DisplayNameFor(m => m.Purpose)</label>
                        @(Html.Kendo().TextAreaFor(m => m.Purpose)
                            .Rows(4)
                            .HtmlAttributes(new
                            {
                                style = "width:100%",
                                placeholder = "Enter the purpose of this request..."
                            }))
                        @Html.ValidationMessageFor(
                            m => m.Purpose,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.FPP)</label>
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.FPP)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select FPP")
                            .DataTextField("Code")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetFpp", "Getters").Data("DataFpp");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => { e.Select("onSelectFpp"); })                    
                        )
                        @Html.ValidationMessageFor(m => m.FPP,"",new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.Fund)</label>
                        @(Html.Kendo().TextBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%", @readonly = "readonly" }))
                        @Html.ValidationMessageFor(
                            m => m.Fund,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group wide">
                        <label>@Html.DisplayNameFor(m => m.FundSpecific)</label>
                        @(Html.Kendo().TextBoxFor(m => m.FundSpecific)
                            .HtmlAttributes(new { style = "width:100%", placeholder = "Enter fund specific details if applicable..." }))
                        @Html.ValidationMessageFor(
                            m => m.FundSpecific,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.RequestedBy)</label>
                        @(Html.Kendo().TextBoxFor(m => m.RequestedBy)
                            .HtmlAttributes(new { style = "width:100%" }))
                        @Html.ValidationMessageFor(
                            m => m.RequestedBy,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.RequestedDesig)</label>
                        @(Html.Kendo().TextBoxFor(m => m.RequestedDesig)
                            .HtmlAttributes(new { style = "width:100%" }))
                        @Html.ValidationMessageFor(
                            m => m.RequestedDesig,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.Availability)</label>
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.Availability)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Name")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodes", "Getters", new { mastCode = "CASH-AVAILABLE" });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => e.Select("onSelectAvailability"))
                        )
                        @Html.ValidationMessageFor(m => m.Availability, "", new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.AvaialbilityDesig)</label>
                        @(Html.Kendo().TextBoxFor(m => m.AvaialbilityDesig)
                            .HtmlAttributes(new { style = "width:100%", @readonly = "readonly" }))
                        @Html.ValidationMessageFor(
                            m => m.AvaialbilityDesig,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.ApprovedBy)</label>
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.ApprovedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Approved by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetApprovedBy", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectApprovedBy"); })
                        )
                        @Html.ValidationMessageFor(
                            m => m.ApprovedBy,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="checkout-form-group">
                        <label>@Html.DisplayNameFor(m => m.ApprovedDesig)</label>
                        @(Html.Kendo().TextBoxFor(m => m.ApprovedDesig)
                            .HtmlAttributes(new { style = "width:100%", @readonly = "readonly" }))
                        @Html.ValidationMessageFor(
                            m => m.ApprovedDesig,
                            "",
                            new { @class = "text-danger" })
                    </div>          
                </div>

                <h2 class="checkout-section-title">
                    <span class="k-icon k-i-list-unordered"></span> Purchase Request Items
                </h2>

                @(Html.Kendo().Grid<iLgs.Models.CartItemViewModel>()
                    .Name("requestItems")
                    .ClientDetailTemplateId("checkoutSubItemsTemplate")
                    .Columns(columns =>
                    {
                        columns.Bound(x => x.ItemNo)
                            .Title("No.")
                            .Width(65)
                            .HtmlAttributes(new { @class = "font-weight-bold font-mono" });

                        columns.Bound(x => x.Code)
                            .Title("Item Code")
                            .Width(110)
                            .HtmlAttributes(new { @class = "font-weight-bold font-mono" });

                        columns.Bound(x => x.Description)
                            .Title("Description")
                            .HtmlAttributes(new { @class = "cart-multiline-description" });

                        columns.Bound(x => x.Unit)
                            .Title("Unit")
                            .Width(95)
                            .HtmlAttributes(new { @class = "text-center text-muted" })
                            .HeaderHtmlAttributes(new { @class = "text-center" });

                        columns.Bound(x => x.Quantity)
                            .Title("Quantity")
                            .Width(115)
                            .Format("{0:n0}")
                            .HtmlAttributes(new { style = "text-align:right;" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" });

                        columns.Bound(x => x.UnitCost)
                            .Title("Unit Cost")
                            .Width(130)
                            .HtmlAttributes(new { style = "text-align:right;", @class = "checkout-amount-cell" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" })
                            .ClientTemplate("&#8369;#= kendo.toString(UnitCost, 'n2') #");

                        columns.Bound(x => x.EstimatedAmount)
                            .Title("Estimated Amount")
                            .Width(150)
                            .HtmlAttributes(new { style = "text-align:right;", @class = "checkout-amount-cell" })
                            .HeaderHtmlAttributes(new { style = "text-align:right;" })
                            .ClientTemplate("&#8369;#= kendo.toString(EstimatedAmount, 'n2') #");
                    })
                    .Events(events => events.DetailInit("onCheckoutDetailInit"))
                    .Scrollable(scrollable => scrollable.Height(420))
                    .Pageable()
                    .Sortable()
                    .HtmlAttributes(new { @class = "checkout-items-grid" })
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .PageSize(10)
                        .Read(read => read.Action("CartRead", "Procurement", new { mode = Model.CartMode, requestId = Model.SourceRequestId }))
                    )
                )
            </section>

            <aside class="checkout-summary-card">
                <h2>
                    <span class="k-icon k-i-calculator"></span> Summary
                </h2>

                <div class="checkout-summary-stat">
                    <span>Distinct Items</span>
                    <strong>@cartItems.Count</strong>
                </div>

                <div class="checkout-summary-stat">
                    <span>Total Quantity</span>
                    <strong>@cartItems.Sum(x => x.Quantity)</strong>
                </div>

                <hr />

                <div class="checkout-total-block">
                    <span class="checkout-total-label">Estimated Total</span>
                    <strong class="checkout-total-value">
                        @Model.EstimatedTotal.ToString(
                            "C2",
                            CultureInfo.GetCultureInfo("en-PH"))
                    </strong>
                </div>

                <div class="submit-confirmation">
                    <label>
                        <input type="checkbox" id="confirmCheckout"
                               @(Model.Confirmed ? "checked=checked" : "") />
                        @Html.HiddenFor(m => m.Confirmed, new { id = "confirmedCheckoutValue" })
                        <span>I have reviewed the purchase request details and confirm that they are correct.</span>
                    </label>
                    @Html.ValidationMessageFor(m => m.Confirmed, "", new { @class = "text-danger" })
                </div>

                @(Html.Kendo().Button()
                .Name("submitForReview")
                .Content("<span class='k-icon k-i-check'></span> " + (Model.IsAdminEdit ? "Save Corrections to Purchase Request" : (Model.IsRevision ? "Resubmit Purchase Request" : "Submit for Review")))
                .HtmlAttributes(new
                {
                    type = "submit",
                    @class = "submit",
                    style = "width:100%;"
                })
                .Enable(false))

                @(Html.Kendo().Button()
                .Name("backToCart")
                .Content("<span class='k-icon k-i-arrow-left'></span> Back to Cart")
                .HtmlAttributes(new
                {
                    type = "button",
                    style = "width:100%; margin-top:10px;"
                })
                .Events(e => e.Click("onBackToCart")))

                @if (Model.IsAdminEdit)
                {
                    <a class="k-button btn-secondary-action" href="@Url.Action("CancelAdminEdit", "Procurement", new { requestId = Model.SourceRequestId })" style="width:100%; margin-top:10px;">
                        <span class="k-icon k-i-close"></span> Cancel Admin Edit
                    </a>
                }
            </aside>
        </div>
    }
</section>

<script id="checkoutSubItemsTemplate" type="text/x-kendo-template">
    <div class="checkout-sub-items-host"></div>
</script>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function onCheckoutDetailInit(e) {
            var parentItemId = e.data.Id;
            var $host = e.detailCell.find(".checkout-sub-items-host");

            $("<div class='cart-sub-items-title'><span class='k-icon k-i-list-unordered'></span> User-defined sub-items</div>")
                .prependTo($host);

            $("<div />")
                .appendTo($host)
                .kendoGrid({
                    dataSource: {
                        transport: {
                            read: {
                                url: "@Url.Action("CartSubItemsRead", "Procurement", new { mode = Model.CartMode, requestId = Model.SourceRequestId })",
                                type: "POST",
                                data: function () {
                                    return { parentItemId: parentItemId };
                                }
                            }
                        },
                        schema: {
                            data: "Data",
                            total: "Total",
                            errors: "Errors"
                        }
                    },
                    scrollable: true,
                    height: 300,
                    sortable: false,
                    pageable: false,
                    columns: [
                        { field: "ItemNo", title: "Item No.", width: "12%", attributes: { "class": "font-weight-bold font-mono" } },
                        {
                            field: "Description",
                            title: "Description",
                            width: "35%",
                            attributes: { "class": "cart-multiline-description" }
                        },
                        { field: "Unit", title: "Unit", width: "12%", headerAttributes: { "style": "text-align:center;" }, attributes: { "class": "text-center text-muted" } },
                        { field: "Quantity", title: "Qty", width: "11%", format: "{0:n2}", headerAttributes: { "style": "text-align:right;" }, attributes: { "style": "text-align:right;" } },
                        {
                            field: "UnitCost",
                            title: "Unit Cost",
                            width: "15%",
                            headerAttributes: { "style": "text-align:right;" },
                            attributes: { "style": "text-align:right;", "class": "checkout-amount-cell" },
                            template: "&#8369;#= kendo.toString(UnitCost, 'n2') #"
                        },
                        {
                            field: "Total",
                            title: "Total",
                            width: "15%",
                            headerAttributes: { "style": "text-align:right;" },
                            attributes: { "style": "text-align:right;", "class": "checkout-amount-cell font-weight-bold" },
                            template: "&#8369;#= kendo.toString(Total, 'n2') #"
                        }
                    ]
                });
        }

        $(document).ready(function () {
            var isRevisionCheckout = @Html.Raw(Json.Encode(Model.IsRevision));
            var revisionConfirmed = false;

            // Initially disable Submit for Review
            var submitButton = $("#submitForReview").data("kendoButton");
            submitButton.enable($("#confirmCheckout").is(":checked"));

            // Enable/disable Submit for Review based on confirmation checkbox
            $("#confirmCheckout").on("change", function () {
                $("#confirmedCheckoutValue").val(this.checked ? "true" : "false");
                submitButton.enable(this.checked);
            });

            $("#formCheckout").on("submit", function () {
                var confirmed = $("#confirmCheckout").is(":checked");
                $("#confirmedCheckoutValue").val(confirmed ? "true" : "false");

                if (!confirmed) {
                    submitButton.enable(false);
                    return false;
                }

                if (isRevisionCheckout && !revisionConfirmed && window.kendo && kendo.confirm) {
                    var form = this;
                    kendo.confirm("Resubmit this Purchase Request for review?<br><br>The revised Purchase Request will become read-only again and return to the review queue.")
                        .done(function () {
                            revisionConfirmed = true;
                            form.submit();
                        });
                    return false;
                }

                return true;
            });

            $.ajax({
                type: "POST",
                url: '@Url.Action("GetModelDefault", "Requests")',
                success: function (result) {
                    var availability = $("#Availability").data("kendoMultiColumnComboBox");
                    var approvedBy = $("#ApprovedBy").data("kendoMultiColumnComboBox");

                    if (availability && !availability.value()) {
                        availability.value(result.model.Availability);
                        availability.trigger("change");
                    }

                    if (!$("#AvaialbilityDesig").val()) {
                        $("#AvaialbilityDesig").val(result.model.AvaialbilityDesig).trigger("change");
                    }

                    if (approvedBy && !approvedBy.value()) {
                        approvedBy.value(result.model.ApprovedBy);
                        approvedBy.trigger("change");
                    }

                    if (!$("#ApprovedDesig").val()) {
                        $("#ApprovedDesig").val(result.model.ApprovedDesig).trigger("change");
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        });

        function onBackToCart() {
            window.location.href = '@Url.Action("Cart", "Procurement", new { mode = Model.CartMode, requestId = Model.SourceRequestId })';
        }

        function onDepartmentChange(e) {
            var departmentDropDown = $("#DeptId").data("kendoDropDownList");

            if (departmentDropDown) {
                $("#Department").val(departmentDropDown.text());
            }
        }

        function DataFpp() {
            var text = $("#FPP").data("kendoMultiColumnComboBox").text();
            return {
                department: $("#Department").val(),
                text: text
            };
        }

        function onSelectFpp(e) {
            var dataItem = this.dataItem(e.item.index());

            $("#Fund").val(dataItem.Fund).trigger("change");
        }

        function onSelectAvailability(e) {
            var dataItem = this.dataItem(e.item.index());

            $("#AvaialbilityDesig").val(dataItem.Desc2).trigger("change");
        }

        function onSelectApprovedBy(e) {
            var dataItem = this.dataItem(e.item.index());
            $("#ApprovedDesig").val(dataItem.Desc2).trigger("change");
        }
    </script>
}

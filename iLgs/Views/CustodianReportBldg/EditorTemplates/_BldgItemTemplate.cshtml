                    @Html.DisplayFor(m => m.Account, "Label")
                </div>
                <div class="col-md-8">
                    @(Html.Kendo().TextBoxFor(m => m.Account).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Account)
                </div>
            </div>

            <div class="col-md-6">
                <div class="col-md-4">
                    @Html.DisplayFor(m => m.SubAccount, "Label")
                </div>
                <div class="col-md-8">

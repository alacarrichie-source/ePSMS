                @Html.ValidationMessageFor(m => m.Account)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.SubAccount, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.SubAccount).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.SubAccount)
            </div>
        </div>

        <br />
        <div class="row k-mb-2">

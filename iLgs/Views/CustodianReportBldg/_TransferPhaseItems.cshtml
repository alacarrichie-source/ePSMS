
@model iLgs.Models.CustodianReportBldgItemTransferVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "formTransfer", id = "formTransfer" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.ReportId)
    @Html.HiddenFor(model => model.SourceId)


    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(m => m.SourceCustodianItemNo)
                @(Html.Kendo().TextBoxFor(m => m.SourceCustodianItemNo).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.SourceCustodianItemNo)
            </div>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="form-group">
            <div class="col-md-12">
                @Html.LabelFor(m => m.TargetCustodianItemNo)
                @(Html.Kendo().TextBoxFor(m => m.TargetCustodianItemNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.TargetCustodianItemNo)
            </div>
        </div>
    </div>

    <br />
    <div class="row k-mb-2">
        <div class="col-md-12">
            <span id="span_">
                @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Submit").Name("btnSave"))
                @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
            </span>
        </div>
    </div>
}

<script type="text/javascript">
    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    $("#btnSave").click(function (e) {
        e.preventDefault();
        var validator = $("#formTransfer").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            SaveRecords();
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });

    function SaveRecords() {
        var disabled = $("#formTransfer").find(':input:disabled').removeAttr('disabled');
            var popupNotification = $("#popupNotification").data("kendoNotification");
            $.ajax({
                type: "POST",
                url: '@Url.Action("_TransferPhaseItemSave", "CustodianReportBldg")',
                data: $("#formTransfer").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#formTransfer"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#formTransfer"), false);

                    if (result.Errors == "") {
                        $('#ErrorContent').addClass('hidden');
                        popupNotification.show("Saved successfully.", "success");
                        selectedId = result.Model.Id;
                        disabled.attr('disabled', 'disabled');

                        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
                    } else {
                        const errors = result.Errors;
                        const html = Object.entries(errors)
                            .map(([key, messages]) =>
                                `<li>${key}<ul>${messages.map(m => `<li>${m}</li>`).join('')}</ul></li>`
                            )
                            .join('');
                        $('#ErrorContent .errors').empty().append(html);
                        $('#ErrorContent').removeClass('hidden');
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            }).always(function () {
                window.kendo.ui.progress($("#form"), false);
            });
    }
</script>

@(Html.Kendo().Grid<iLgs.Models.CustodianReportBldgItemPhasVM>()
    .Name("gridAmounts_" + @ViewData["reportItemId"])
    .Columns(col =>
    {
        col.Bound(c => c.Id).Hidden();
        col.Bound(c => c.PhaseNo).Width(50);
        col.Bound(c => c.ProjectName).Width(100);
        col.Bound(c => c.AcqDate).Width(50);
        col.Bound(c => c.PercentComplete).Width(50);
        col.Bound(c => c.Status).Width(50);
        col.Bound(c => c.CapitalOutlay).Width(50)//.EditorTemplateName("_CapitalOutlayTemplate")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
            .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.MOOE).Width(50)//.EditorTemplateName("_MooeTemplate")
            .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
            .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });        
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(50);
    })
    .ToolBar(toolbar => toolbar.Create().Text("Add Items"))
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ItemPhaseTemplate").Window(w => w.Width(1000).Title("Project Name")))
    .Resizable(r => r.Columns(true))
    .Sortable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .NoRecords()
    //.Pageable(pager => pager
    //    .Input(false)
    //    .Numeric(true)
    //    .Info(true)
    //    .PreviousNext(true)
    //    .Refresh(true)
    //    .PageSizes(true)
    //    .ButtonCount(5)
    //)
    //.Scrollable(s => s.Height(100))
    .DataSource(dataSource => dataSource
        .Ajax()
        //.PageSize(10000)
        .Events(events => events.Error("InlineGridError")
            //.RequestEnd("onRequestEndGridAmount")
            )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.BldgItemId).DefaultValue(ViewData["reportItemId"]).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.CapitalOutlay).Sum();
            a.Add(p => p.MOOE).Sum();
        })
        .Sort(s => s.Add(a => a.InsertedDt))
        .Read(read => read.Action("_ItemPhaseRead", "CustodianReportBldg", new { reportItemId = ViewData["reportItemId"] }))
        .Create(create => create.Action("_ItemPhaseCreate", "CustodianReportBldg"))
        .Update(update => update.Action("_ItemPhaseUpdate", "CustodianReportBldg"))
        .Destroy(destroy => destroy.Action("_ItemPhaseDestroy", "CustodianReportBldg"))
    )    
    .Events(events => events.Edit("onEditGridAmount")
    .Change("onChangeGridAmount")
    .DataBound("onDataBoundGridAmount")
    )
.AutoBind(true)
//.Events(e => e.Edit("onEditGridAmount")
//.Change("onChangeGridItems")
//.Save("onSaveGridItems")
//.DataBound("onDataBoundGridItems")
//)
)


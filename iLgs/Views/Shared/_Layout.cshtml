@helper GetMenus(IQueryable<iLgs.Models.Menubase> menu)
{
    if (menu != null)
    {
        foreach (var item in menu)
        {
            if (item.ParentId == 0) //Level one items will have 0 parent id
            {

                var children = menu.Where(x => x.ParentId == item.ChildId && x.Description != "-").OrderBy(o => o.Description).ToList();
                if (children != null) //Level one item has children so append them
                {
                    <li class="nav dropdown">
                        <a class="nav-link dropdown-toggle" href="#"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            @item.Description<span class="caret"></span>
                        </a>
                        <ul id="nav" class="dropdown-menu">
                            @foreach (var itm in children)
                            {
                                var subMenu = menu.Where(x => x.ParentId == itm.ChildId && x.Description != "-").OrderBy(o => o.Description).ToList();
                                <li>
                                    @if (subMenu.Any())
                                    {
                                        <a href="@Url.Action(@itm.Action, @itm.Controller)">@itm.Description<span class="caret"></span></a>
                                    }
                                    else
                                    {
                                        @Html.ActionLink(@itm.Description, @itm.Action, @itm.Controller)
                                    }

                                    @if (string.IsNullOrEmpty(itm.Controller))
                                    {
                                        <ul class="submenu">
                                            @foreach (var sm in subMenu)
                                            {
                                                <li>@Html.ActionLink(@sm.Description, @sm.Action, @sm.Controller)</li>

                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </li>
                }
            }
        }
    }
}



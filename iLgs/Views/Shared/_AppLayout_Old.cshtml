@*Define a recursive helper function to render menu items*@
@helper   RenderMenuItems(IEnumerable<TreeViewItemModel> items)
{
if (items != null)
{
        <ul>
            @foreach (var item in items)
            {
                <li>
                    <a href="@item.Url">@item.Text</a>
                    @if (item.HasChildren)
                    {
                        // Recursively call the helper function for sub-items
                        @RenderSubMenuItems(item.Items);

                    }
                    else
                    {
                        <hr />
                    }
                </li>
            }
        </ul>
}
}


@helper   RenderSubMenuItems(IEnumerable<TreeViewItemModel> subItems)
{
if (subItems != null)
{
        <ul>
            @foreach (var subItem in subItems)
        {
                <li>
                    <a href="@subItem.Url">@subItem.Text</a>

                    @if (subItem.HasChildren)
                    {
                        // Recursively call the helper function for sub-items
                        @RenderSubMenuItems(subItem.Items);
                    }
                    else
                    {
                        <hr />
                    }
                </li>
            }
        </ul>
}
}


@helper GetMenus(IQueryable<iLgs.Models.Menubase> menu, string websiteName)
{
if (menu != null)
{
    foreach (var item in menu)
    {
        if (item.ParentId == 0) //Level one items will have 0 parent id
        {
                <ul class="root-nav-categories kd-list">
                    <li>
                        <h3 class="kd-title"><span class="root-nav expand"></span>@item.Description</h3>
                        <ul class="root-nav-widgets kd-list">
                            @{
                                var children = menu.Where(x => x.ParentId == item.ChildId && x.Description != "-").OrderBy(o => o.Description).ToList();
                            }
                            @if (children.Any())
                            {
                                foreach (var child in children)
                                {
                                    var grandChildren = menu.Where(w => w.ParentId == child.ChildId && w.Description != "-").OrderBy(o => o.Description).ToList();
                                    if (grandChildren.Any())
                                    {
                                        <li class="">
                                            <ul>
                                                <div class="title2"><span class="root-nav expand"></span>@child.Description:</div>
                                                @foreach (var grandChild in grandChildren)
                                                {
                                                    <li class="title3">
                                                        @if (websiteName == string.Empty)
                                                        {
                                                            <a style="text-decoration: none;" class="k-drawer-item" href="/@grandChild.Controller/@grandChild.Action"><span class="link-text">@grandChild.Description</span></a>
                                                        }
                                                        else
                                                        {
                                                            <a style="text-decoration: none;" class="k-drawer-item" href="/@websiteName/@grandChild.Controller/@grandChild.Action"><span class="link-text">@grandChild.Description</span></a>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="">
                                            @if (websiteName == string.Empty)
                                            {
                                                <a style="text-decoration: none;" class="k-drawer-item" href="/@child.Controller/@child.Action"><span class="link-text">@child.Description</span></a>
                                            }
                                            else
                                            {
                                                <a style="text-decoration: none;" class="k-drawer-item" href="/@websiteName/@child.Controller/@child.Action"><span class="link-text">@child.Description</span></a>
                                            }
                                        </li>
                                    }
                                }
                            }
                            else
                            {
                                <li class="title2b">
                                    @if (websiteName == string.Empty)
                                    {
                                        <a style="text-decoration: none;" class="k-drawer-item" href="/@item.Controller/@item.Action"><span class="link-text">@item.Description</span></a>
                                    }
                                    else
                                    {
                                        <a style="text-decoration: none;" class="k-drawer-item" href="/@websiteName/@item.Controller/@item.Action"><span class="link-text">@item.Description</span></a>
                                    }
                                </li>
                            }
                        </ul>
                    </li>
                </ul>
                                        }
                                    }
                                }
}





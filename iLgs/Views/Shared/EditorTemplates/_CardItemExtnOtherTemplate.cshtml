@model iLgs.Models.PsCardItemExtnOtherVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardItemId)
    @Html.HiddenFor(model => model.AIRItemExtnId)
    @Html.HiddenFor(model => model.TransferId)
    @Html.HiddenFor(model => model.PsCardItemExtnId)
    @Html.HiddenFor(model => model.SetLotNo)
    @Html.HiddenFor(model => model.SetLotQtyNo)
    @Html.HiddenFor(model => model.ContentNo)
    @Html.HiddenFor(model => model.UnitCost)

    <fieldset>                
        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.PropNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.PropNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.PropNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.CustItemNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.CustItemNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.CustItemNo)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.SeriesNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.SeriesNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.SeriesNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.Annex, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().MaskedTextBoxFor(m => m.Annex).PromptChar(" ").Mask("L").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Annex)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.SerialNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.SerialNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.SerialNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(model => model.LocationId, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Location")
                    .DataTextField("Code")
                    .DataValueField("Id")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetLandLocation", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Code").Title("Code").Width("50");
                        c.Add().Field("Desc3").Title("Main-Location").Width("300");
                        c.Add().Field("Desc2").Title("Location").Width("300");
                    })
                    .Events(e => e.Select("onSelectLocationId").DataBound("onDataBoundLocationId"))                
                )
                @Html.ValidationMessageFor(model => model.LocationId)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.Location, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.Location).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Location)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.SubLocation, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.SubLocation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.SubLocation)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.Condition, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.Condition)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select Condition")
                    .DataTextField("Description")
                    .DataValueField("Description")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetConditions", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Description").Title("Condition").Width("100%");
                    })                    
                )
                @Html.ValidationMessageFor(m => m.Condition)
            </div>
        </div>

        
        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.OldAmount, "LabelDecimal")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().NumericTextBoxFor(m => m.OldAmount).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.OldAmount)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.OldPropNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.OldPropNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.OldPropNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.AddCost, "LabelDecimal")
            </div>
            <div class="col-md-4">
                <div class="numeric-wrapper">
                    @(Html.Kendo().NumericTextBoxFor(m => m.AddCost)
                .Decimals(2)
                .Format("{0:n2}")
                .Spinners(false)                
                .HtmlAttributes(new
                {
                    style = "width: 100%; padding-right: 2rem;" // space for icon                    
                })
                    )

                    <button type="button"
                            class="custom-icon-btn"
                            onclick="onClickAddCost()">
                        <span class="k-icon k-i-calculator"></span>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.AddCost)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.AcqCost, "LabelDecimal")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().NumericTextBoxFor(m => m.AcqCost).Decimals(2).Format("{0:n2}").Spinners(false)
                    .HtmlAttributes(new { @readonly = "readonly", style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.AcqCost)
            </div>
        </div>

    </fieldset>
}





            </div>
            <div class="col-md-4">
                @(Html.Kendo().DatePickerFor(m => m.OrDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.OrDate)
            </div>

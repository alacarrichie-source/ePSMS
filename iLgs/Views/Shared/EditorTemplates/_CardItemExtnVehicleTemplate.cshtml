            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.ConductionNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.ConductionNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.EngineNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.EngineNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.EngineNo)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.ChasisNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.ChasisNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.ChasisNo)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.BodyNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.BodyNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.BodyNo)
            </div>
            <div class="col-md-2">
                @Html.DisplayFor(m => m.YearModel, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().NumericTextBoxFor(m => m.YearModel).Decimals(0).Spinners(false).Format("0").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.YearModel)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-2">
                @Html.DisplayFor(m => m.OrNo, "Label")
            </div>
            <div class="col-md-4">
                @(Html.Kendo().TextBoxFor(m => m.OrNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.OrNo)
            </div>

@model iLgs.Models.AspNetUsers_View

<div class="modal-body">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)

        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Email)
                    .Label(l => l.Content("Email").Floating(true))
                    .HtmlAttributes(new { style = "readonly:true; " }) // width:100%; max-width:100%;" })
                )
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.NameLast).HtmlAttributes(new { style = "width:100%; max-width:100%;", @onchange = "onChangeNames();" })
                    .Label(l => l.Content("Last Name").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.NameLast)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.NameFirst).HtmlAttributes(new { style = "width:100%; max-width:100%;", @onchange = "onChangeNames();" })
                    .Label(l => l.Content("First Name").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.NameFirst)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.NameMid).HtmlAttributes(new { style = "width:100%; max-width:100%;", @onchange = "onChangeNames();" })
                    .Label(l => l.Content("Midle Initial").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.NameMid)
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.NameFull).HtmlAttributes(new { style = "width:100%; max-width:100%;" }).Enable(true)
                    .Label(l => l.Content("Full Name").Floating(false))
                )
            </div>
        </div>
        <div class="row">            
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Sex).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Label(l => l.Content("Sex").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Sex)
            </div>
        </div>

        
        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.MobileNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Label(l => l.Content("Mobile No.").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.MobileNo)
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.Department).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Label(l => l.Content("Group").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.Department)
            </div>        
        </div>

        <div class="row">
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(Model => Model.UserCode).HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Label(l => l.Content("User Code").Floating(true))
                )
                @Html.ValidationMessageFor(model => model.UserCode)
            </div>
        </div>
    }
</div>

<style>
    .dropdown-header {
        font-size: 1.2em;
    }

        .dropdown-header > span {
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            text-align: left;
            display: inline-block;
            border-style: solid;
            border-width: 0 0 1px 1px;
            padding: .3em .6em;
            width: 312px;
        }

            .dropdown-header > span:first-child {
                width: 82px;
                border-left-width: 0;
            }
</style>



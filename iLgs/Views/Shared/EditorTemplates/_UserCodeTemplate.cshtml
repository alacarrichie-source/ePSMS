@model iLgs.Models.UserCodes_View

<div class="modal-body">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)

        <h4>User Code</h4>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.LabelFor(Model => Model.UserCode)
            </div>
            <div class="col-md-8">
                @Html.Kendo().TextBoxFor(Model => Model.UserCode)
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.Label("User")
            </div>
            <div class="col-md-8">
                @(Html.Kendo().ComboBoxFor(Model => Model.UserId)
                .HtmlAttributes(new { style = "width:300px" })
            //.HtmlAttributes(new { style = "width:300px", data_value_primitive = "true" })
                .Placeholder("Select user")
                .DataTextField("NameFull")
                .DataValueField("OwnerId")
                .Filter(FilterType.Contains)
                .DataSource(source =>
                {
                    source.Read(read =>
                    {
                        read.Action("GetUsers", "Users");
                    })
                    .ServerFiltering(true);
                })
                .AutoBind(true)
            //.Events(e => { e.Select("onSelectUser"); })
                )
                @Html.ValidationMessageFor(model => model.UserId)
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.LabelFor(Model => Model.Department)
            </div>
            <div class="col-md-8">
                @Html.Kendo().TextBoxFor(Model => Model.Department)
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.LabelFor(Model => Model.Division)
            </div>
            <div class="col-md-8">
                @Html.Kendo().TextBoxFor(Model => Model.Division)
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.LabelFor(Model => Model.Section)
            </div>
            <div class="col-md-8">
                @Html.Kendo().TextBoxFor(Model => Model.Section)
            </div>
        </div>
        <div class="row k-mb-2">
            <div class="col-md-2 text-right">
                @Html.LabelFor(Model => Model.UserGroup)
            </div>
            <div class="col-md-8">
                @Html.Kendo().TextBoxFor(Model => Model.UserGroup)
            </div>
        </div>


    }
</div>

<style>
    .dropdown-header {
        font-size: 1.2em;
    }

        .dropdown-header > span {
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            text-align: left;
            display: inline-block;
            border-style: solid;
            border-width: 0 0 1px 1px;
            padding: .3em .6em;
            width: 312px;
        }

            .dropdown-header > span:first-child {
                width: 82px;
                border-left-width: 0;
            }
</style>



@(Html.Kendo().ComboBox()
    .Name("PsType")
    .DataTextField("Code")
    .DataValueField("Code")
    .Filter("startswith")
    .DataSource(source =>
    {
        source.Read(read =>
        {
            read.Action("GetCodes", "Getters", new { mastCode = "PS-CODES", text = "" });
        })
        .ServerFiltering(false);
    })
)


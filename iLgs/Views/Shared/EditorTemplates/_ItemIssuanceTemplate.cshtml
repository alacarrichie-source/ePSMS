@model iLgs.Models.IcsParItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PsCardItemExtnId)


    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.ItemNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.ItemNo).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ItemNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.RefNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.RefNo).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.RefNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.PropNo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.PropNo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.PropNo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.IssuedTo, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IssuedTo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedTo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.LabelFor(m => m.Designation, htmlAttributes: new { @class = "col-md-2" })
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Designation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Designation)
                </div>
            </div>
        </div>        

    </fieldset>
}









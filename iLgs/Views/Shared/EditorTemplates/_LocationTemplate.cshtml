@(Html.Kendo().MultiColumnComboBox()
        .Name("LocationId")
        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
        .Placeholder("Select Location")
        .DataTextField("Description")
        .DataValueField("Id")
        .ValuePrimitive(true)
        .Filter(FilterType.Contains)
        .DataSource(source =>
        {
            source.Read(read =>
            {
                read.Action("GetLocationSp", "Getters");
            })
            .ServerFiltering(true);
        })
        .Columns(c =>
        {
            c.Add().Field("Code").Title("Code").Width("10%");
            c.Add().Field("Desc3").Title("Main-Location").Width("50%");
            c.Add().Field("Desc2").Title("Location").Width("40%");
        })
        .Suggest(false)
)
@(Html.Kendo().ComboBox()
    .Name("Office")
    .DataTextField("Description")
    .DataValueField("Description")
    .ValuePrimitive(true)
    .Filter("contains")
    .DataSource(source =>
    {
        source.Read(read =>
        {
            //read.Action("GetCodes", "Getters", new { mastCode = "DEPARTMENTS", text = "" });
            read.Action("GetDepartments", "Getters");
        })
        .ServerFiltering(false);
    })
)


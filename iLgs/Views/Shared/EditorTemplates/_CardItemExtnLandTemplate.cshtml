                    <div class="col-md-3">
                        @(Html.Kendo().SwitchFor(m => m.RelocationCap).Messages(c => c.Checked("YES").Unchecked("NO")))
                        @Html.ValidationMessageFor(m => m.RelocationCap)
                    </div>
                </div>

                <div class="row k-mb-2">
                    <div class="col-md-2">
                        @Html.DisplayFor(m => m.Surveying, "LabelDecimal")
                    </div>
                    <div class="col-md-4">
                        @(Html.Kendo().NumericTextBoxFor(m => m.Surveying).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.Surveying)
                    </div>
                    <div class="col-md-3">
                        @(Html.Kendo().SwitchFor(m => m.SurveyingCap).Messages(c => c.Checked("YES").Unchecked("NO")))
                        @Html.ValidationMessageFor(m => m.SurveyingCap)
                    </div>
                </div>

                <div class="row k-mb-2">
                    <div class="col-md-2">
                        @Html.DisplayFor(m => m.IncidentalExpenses, "LabelDecimal")
                    </div>
                    <div class="col-md-4">
                        @(Html.Kendo().NumericTextBoxFor(m => m.IncidentalExpenses).Decimals(2).Format("{0:n2}").Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(m => m.IncidentalExpenses)
                    </div>
                    <div class="col-md-3">
                        @(Html.Kendo().SwitchFor(m => m.IncidentalExpensesCap).Messages(c => c.Checked("YES").Unchecked("NO")))
                        @Html.ValidationMessageFor(m => m.IncidentalExpensesCap)
                    </div>
                </div>
            </div>
        </section>

    </fieldset>
}






@using Kendo.Mvc.UI.Fluent

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<TreeViewItemModel> menuTree = (IEnumerable<TreeViewItemModel>)ViewData["MenuTreeList"];
}
<head>
    <link href="@Url.Content("~/Content/Sidebar/dist/hc-offcanvas-nav.css")" rel="stylesheet" type="text/css" />
    <script src="@Url.Content("~/Content/Sidebar/dist/hc-offcanvas-nav.js")"></script>
</head>

<main role="main" class="k-content" style="height: 100%!important">
    @if (Request.IsAuthenticated)
    {
        @(Html.Kendo().AppBar()
                .Name("appbar")
                .ThemeColor(AppBarThemeColor.Inherit)
                .HtmlAttributes(new { style = "height: 48px" })
                .Items(items =>
                {
                    items.Add().Template("<span id='menuIcon' href='\\#'><span class='k-icon k-i-menu' onclick='toggleDrawer()'></span></span>").Type(AppBarItemType.ContentItem);
                    items.Add().Type(AppBarItemType.Spacer).Width("16px");
                    items.Add().Template("<div class='title'>" + @ViewData["Title"] + "</div>").Type(AppBarItemType.ContentItem);
                    if (ViewData["IsAdminUser"] as bool? == true)
                    {
                        items.Add().Type(AppBarItemType.Spacer);
                        items.Add().Template(@"
                            <div class='app-bar-link'>
                                <span class='k-icon k-i-track-changes' title='Track Changes' onclick='openTrackChanges()'></span>
                                <span class='k-icon k-i-notification' title='Notifications' onclick='openNotifications()' style='position: relative;'>
                                    <span id='notificationBadge'></span>
                                </span>
                            </div>
                            ").Type(AppBarItemType.ContentItem);
                    }
                    items.Add().Type(AppBarItemType.Spacer).Width("8px");
                    //items.Add().Template("<a href='" + @Url.Action("About", "Home") + "' class='k-link app-bar-link'>About</a>").Type(AppBarItemType.ContentItem);
                    //items.Add().Template("<a href='" + @Url.Action("Contact", "Home") + "' class='k-link app-bar-link'>Contact</a>").Type(AppBarItemType.ContentItem);
                })
        )
    }
    <div id="main-div" style="height: 100%!important;">
        @RenderBody()
    </div>
</main>

<div id="windowAppLayout"></div>
@*<button id="dialog" class="k-button k-button-solid-base k-button-solid k-button-md k-rounded-md"></button>*@

<nav id="main-nav">
    @if (Request.IsAuthenticated)
    {
        @RenderMenuItems(menuTree);
    }
</nav>

@RenderSection("scripts", required: false)
@*<footer>
        <p>Copyright &copy; City Government of Las Pinas.</p>
    </footer>*@

@helper   RenderMenuItems(IEnumerable<TreeViewItemModel> items)
{
if (items != null)
{
        <ul class="first-nav">
            @foreach (var item in items)
            {
                <li>
                    <a href="@item.Url">@item.Text</a>
                    @if (item.HasChildren)
                    {
                        // Recursively call the helper function for sub-items
                        @RenderSubMenuItems(item.Items);
                    }
                    else
                    {
                        <hr />
                    }
                </li>
            }
        </ul>
}
}


@helper   RenderSubMenuItems(IEnumerable<TreeViewItemModel> subItems)
{
if (subItems != null)
{
        <ul>
            @foreach (var subItem in subItems)
        {
                <li>
                    <a href="@subItem.Url">@subItem.Text</a>

                    @if (subItem.HasChildren)
                    {
                        // Recursively call the helper function for sub-items
                        @RenderSubMenuItems(subItem.Items);
                    }
                    else
                    {
                        <hr />
                    }
                </li>
            }
        </ul>
}
}

@section Scripts {

    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script type="text/javascript">
        var notificationHub = $.connection.notificationHub;
        var chatHub = $.connection.chatHub;
        var notificationName = "@ViewBag.NotificationName";
        $(document).ready(function () {
            notificationHub.client.refreshUserNotification = function () {
                console.log("refresh user notification called");
                RefreshNotification();
            }

            notificationHub.client.refreshNotification = function () {
                console.log("refresh notification called");
                RefreshNotification();
            }

            // Define what happens when a message arrives
            chatHub.client.broadcastMessage = function (user, message, time) {
                console.log('broadcast');
                //$("#chatWindowMessages").append(
                //    "<div><strong>" + user + "</strong>: " + message + " <small>" + time + "</small></div>"
                //);

                 // Check if this message is from the current user
                var currentUser = "@User.Identity.Name"; // Razor will render the logged-in username
                var isCurrentUser = (user === currentUser);

                // Build the message bubble
                var bubble = `
                    <div class="message ${isCurrentUser ? "message-right" : "message-left"}">
                        ${message}
                        <div class="meta">
                            ${!isCurrentUser ? user + " · " : ""}${time}
                        </div>
                    </div>
                    <div style="clear: both;"></div>
                `;

                // Append to chat window
                $("#chatWindow").append(bubble);

                // Auto-scroll to bottom
                var chatWindow = $("#chatWindow");
                chatWindow.scrollTop(chatWindow[0].scrollHeight);
            }

            chatHub.client.sendTest = function (message) {
                console.log("sendTest called : " + message);
            }

            $.connection.hub.error(function (err) {
                console.error("SignalR error: ", err);
            });

            $.connection.hub.start()
            .done(function () {
                console.log("Hub Started");
                RefreshNotification();
            })
            .fail(function () {
                console.log("Error");
            });
        });

        function RefreshNotification()
        {
            var badge = $("#notificationBadge").kendoBadge({
                themeColor: "error",
                size: "small",
                shape: "rounded",
                fill: "solid",
                position: "edge",
                align: "top end",
            }).data("kendoBadge");

            $.get('@Url.Action("GetNotificationCount", "Notification")', function (data) {
                if (data) {
                    console.log("Notification Count:", data.Notifications);
                    var $badge = $("#notificationBadge");

                    if (data.Notifications > 0) {
                        var $bell = $(".k-i-notification"); // bell icon span

                        $badge.stop(true, true).fadeOut(100, function () {
                            $badge.text(String(data.Notifications)).fadeIn(120);

                            // Trigger bell ring
                            $bell.removeClass("ringing");          // reset
                            void $bell[0].offsetWidth;             // force reflow
                            $bell.addClass("ringing");             // play animation
                        });
                    }
                    else {
                        $badge.text("0").fadeIn(120);
                    }
                }
            });
        }

    </script>

    @Html.Action("_AuditTrailScripts", "AuditTrail")
    @Html.Action("_NotificationScripts", "Notification")    
}

<style>
    @@keyframes ring {
        0% {
            transform: rotate(0);
        }

        10% {
            transform: rotate(25deg);
        }

        20% {
            transform: rotate(-20deg);
        }

        30% {
            transform: rotate(15deg);
        }

        40% {
            transform: rotate(-10deg);
        }

        50% {
            transform: rotate(5deg);
        }

        60% {
            transform: rotate(-2deg);
        }

        70%, 100% {
            transform: rotate(0);
        }
    }

    .ringing {
        animation: ring 0.8s ease-in-out;
        transform-origin: top center; /* pivot like a hanging bell */
    }

    @@keyframes badge-bounce {
        0% {
            transform: translateY(0) scale(1);
        }

        30% {
            transform: translateY(-6px) scale(1.15);
        }

        50% {
            transform: translateY(0) scale(1);
        }

        100% {
            transform: translateY(0) scale(1);
        }
    }

    #notificationBadge.bounce {
        animation: badge-bounce 420ms cubic-bezier(.23,1,.32,1);
        will-change: transform;
    }

    #notificationBadge {
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .offcanvas-nav footer {
        padding: 1em;
        background-color: #f8f8f8;
        border-top: 1px solid #ccc;
        text-align: center;
    }

    #name {
        font-weight: bold;
        font-size: 14px;
    }

    #email {
        font-size: 12px;
        text-decoration-line: underline;
    }

    #menuIcon {
        cursor: pointer;
    }

    .title {
        font-size: 14px;
        line-height: 20px;
    }

    .app-bar-link {
        font-size: 14px;
        line-height: 20px;
        color: #424242;
        cursor: pointer;
    }

    li[data-role='drawer-item'] > a {
        color: #424242;
    }

    li.k-state-selected[data-role='drawer-item'] > a {
        color: #FFFFFF;
    }

    @@media (max-width: 716px) {
        .k-drawer-wrapper {
            transition: none;
        }
    }

    #rights p {
        margin: 5px 0;
    }

    #rights {
        position: absolute;
        bottom: 10px;
        left: 15px;
        padding-right: 15px;
        color: #848690;
        font-size: 10px;
    }

    .link-text {
        color: inherit;
    }

    .title2 {
        font-size: 10px;
        line-height: 20px;
        padding: 0 32px;
        text-transform: uppercase;
    }

    .title2b {
        font-size: 10px;
        line-height: 20px;
        padding-left: 15px;
    }

    .title3 {
        font-size: 10px;
        line-height: 20px;
        padding-left: 15px;
    }

    .menu-section {
        justify-content: space-evenly;
    }

    #avatar {
        width: 50%;
        height: 50%;
    }

    .max-grid .k-grid-content {
        overflow-x: auto;
        height: calc(80vh - 30px) !important;
    }

    .hc-nav-trigger.hc-nav-1 {
        display: none;
    }

    .navbar > .container .navbar-brand, .navbar > .container-fluid .navbar-brand {
        margin-left: auto;
    }

    .footer-label {
        padding: 10px;
        background-color: #f2f2f2;

<script type="text/javascript">
    // as a jQuery plugin
    var $nav = $('#main-nav').hcOffcanvasNav({
            // Customize the text for the close/back labels.
            insertClose: true,
            insertBack: true,
            labelClose: 'Close',
            labelBack: 'Back',
            levelTitleAsBack: true,

            ////Specify the screen width at which breakppint the plugin hides the regular navigation.
            //disableAt: 1024,

            ////Push the main content to the other side when the HC MobileNav is toggled.
            pushContent: '#container', //true, // default false

            ////Set the direction of the HC MobileNav. Possible values: 'left'(default), 'right', 'top' and 'bottom'

            //position: 'left',


            //// width & height
            //width: 280,
            height: 'auto',

            //// enable swipe gestures
            swipeGestures: true,

            //// initialize the menu in expanded mode
            expanded: true,

            //// overlap / expand / none
            //levelOpen: 'overlap',

            //// in pixels
            //levelSpacing: 40,

            //// shows titles for submenus
            //levelTitles: false,

            //// close sub levels when the nav closes
            //closeOpenLevels: true,

            //// clear active levels when the nav closes
            //closeActiveLevel: false,

            //// the title of the first level
            navTitle: 'Main Menu',

            //// extra CSS class(es)
            //navClass: '',

            //// disable body scroll
            disableBody: false,

            //// close the nav on click
            //closeOnClick: true,

            //// custom toggle element
            //customToggle: null,

            //// prepend or append the menu to body
            //bodyInsert: 'append'

            //// should original menus and their items classes be preserved or excluded.
            //keepClasses: true,

            //// remove original menu from the DOM
            removeOriginalNav: true

            // enable RTL mode
            //rtl: false
    });
    var Nav = $nav.data('hcOffcanvasNav');
    var sw = 1;
    var isDrawerVisible = true;
    function toggleDrawer(e) {
        Nav.toggle();

        ////resize widgets after Drawer animmation has completed
        setTimeout(resizeWidgets, 400)
    }

    $(document).ready(function () {

        //resizeWidgets();
        $(window).resize(function () {
            resizeWidgets();
        });
    });

    function resizeWidgets() {        
        //alert(sw);
        var container = document.getElementById('container');
        var width = window.innerWidth;
        var height = window.innerHeight;

        if (sw == 1)
        {
            width -= 280;
            container.style.width = width + 'px';
        }
        else {
            container.style.width = '100%';
        }


        // Adjust the container size
        
        container.style.height = height + 'px';
    }

    Nav.on('toggle', (e, settings) => {
        if (e.data.action == 'open') {
            // do something when `open` action is triggered
            sw = 1;
            resizeWidgets();
        } else if (e.data.action == 'close')
        {
            sw = 0;
            resizeWidgets();
        }
    });

</script>

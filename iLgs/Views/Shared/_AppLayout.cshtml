        <li role="menu" aria-orientation="vertical" class="k-state-selected"><a class="k-link k-drawer-item" href="/aspnet-mvc/admin-dashboard/" data-role="drawer-item" role="menuitem" aria-label="Dashboard"><span class="k-icon k-i-grid "></span>Dashboard</a></li>
        <li><a class="k-link k-drawer-item" href="/aspnet-mvc/admin-dashboard/Home/Performance" data-role="drawer-item" role="menuitem" aria-label="Performance and Sales"><span class="k-icon k-i-globe"></span>Performance and Sales</a></li>
        <li><a class="k-link k-drawer-item" href="/aspnet-mvc/admin-dashboard/Home/Products" data-role="drawer-item" role="menuitem" aria-label="Products"><span class="k-icon k-i-aggregate-fields"></span>Products</a></li>
        <li data-role="drawer-separator" class="k-drawer-item k-drawer-separator" role="separator"></li>

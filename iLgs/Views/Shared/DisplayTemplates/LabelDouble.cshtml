@model double?

@{
    var metadata = ViewData.ModelMetadata;
    var isRequired = metadata.IsRequired;
    var labelText = metadata.DisplayName ?? metadata.PropertyName;
}

<label class="form-label">
    <span class="required-marker">
        @if (isRequired)
        {
            <span class="text-danger">*</span>
        }
    </span>
    @labelText
</label>

<style>
    .form-label {
        display: flex;
        align-items: center;
    }

    .required-marker {
        display: inline-block;
        width: 10px; /* Adjust width as needed to align the text properly */
        text-align: right;
        margin-right: 5px; /* Adjust spacing between the asterisk and label */
    }
</style>





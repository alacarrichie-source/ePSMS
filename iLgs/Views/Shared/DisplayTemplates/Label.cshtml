@*@model System.Web.Mvc.ModelMetadata

@Html.LabelFor(m => m.PropertyName)
@{
    var isRequired = Model.ContainerType
        .GetProperty(Model.PropertyName)
        .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), false)
        .Any();

    if (isRequired)
    {
        <span class="text-danger">Required *</span>
    }
    else
    {
        <span class="text-danger">Not Required *</span>
    }
}*@


@*@model System.Web.Mvc.ModelMetadata

@{
    var htmlAttributes = ViewData["htmlAttributes"] as IDictionary<string, object> ?? new Dictionary<string, object>();
    var labelText = Model.DisplayName ?? Model.PropertyName;
}

<label @Html.Raw(string.Join(" ", htmlAttributes.Select(attr => $"{attr.Key}=\"{attr.Value}\"")))>
    @labelText
    @if (Model.ContainerType
                .GetProperty(Model.PropertyName)
                .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), false)
                .Any())
    {
        <span class="text-danger">*</span>
    }
</label>*@


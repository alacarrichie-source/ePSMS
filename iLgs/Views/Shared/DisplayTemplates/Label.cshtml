@*@model System.Web.Mvc.ModelMetadata


@if (Model == null)
{
    <span>Error: Model is null.</span>
}
else
{
    var htmlAttributes = ViewData["htmlAttributes"] as IDictionary<string, object> ?? new Dictionary<string, object>();
    var labelText = Model.DisplayName ?? Model.PropertyName;

    // Build HTML attributes string
    //var attributesString = string.Join(" ", htmlAttributes.Select(attr => $"{attr.Key}=\"{attr.Value}\""));
    var attributesString = string.Join(" ", htmlAttributes.Select(attr => string.Format("{0}=\"{1}\"", attr.Key, attr.Value)));

    // Check if property is required
    var containerType = Model.ContainerType;
    if (containerType == null)
    {
        <span>Error: Container type is null.</span>
    }
    else
    {
        var property = containerType.GetProperty(Model.PropertyName);
        var isRequired = property != null &&
            property.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), false).Any();

        <label @Html.Raw(attributesString)>
            @labelText
            @if (isRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }
}*@


@model string

@{
    var metadata = ViewData.ModelMetadata;
    var isRequired = metadata.IsRequired;
    var labelText = metadata.DisplayName ?? metadata.PropertyName;
}

<label>
    @labelText
    @if (isRequired)
    {
        <span class="text-danger">*</span>
    }
</label>
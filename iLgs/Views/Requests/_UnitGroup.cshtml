@(Html.Kendo().Grid<iLgs.Models.RequestItemUnitGroupVM>()
        .Name("gridItemUnitGroups_" + @ViewData["requestId"])
        .Columns(col =>
        {
            col.Bound(c => c.RisItemUnitGroup.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            col.Bound(c => c.RisItemUnitGroup.Unit).Width(100);
            col.Bound(c => c.UnitCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_UnitCostTemplate");
            col.Bound(c => c.TotalCost).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_TotalCostTemplate");
            col.Bound(c => c.InsertedDt).Width(100);
            col.Command(command =>
            {
                //command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditRisItemUnitGroup");
                command.Edit();
                //command.Destroy();
            }).Width(70);
        })
        //.ToolBar(t =>
        //{
        //    t.Create();            
        //})
        .Editable(e => e.Mode(GridEditMode.InLine))
        //.Pageable(pager => pager
        //    .Input(false)
        //    .Numeric(true)
        //    .Info(true)
        //    .PreviousNext(true)
        //    .Refresh(true)
        //    .PageSizes(true)
        //    .ButtonCount(5)
        //)
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("GroupDescriptions")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemUnitGroupsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.PrId).DefaultValue(@ViewData["requestId"]);
                model.Field(p => p.RisItemUnitGroup.Qty).Editable(false);
                model.Field(p => p.RisItemUnitGroup.Unit).Editable(false);
                model.Field(p => p.InsertedDt).Editable(false);
                model.Field(p => p.TotalCost).Editable(false);
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_UnitGroupRead", "Requests", new { requestId = @ViewData["requestId"] }))
            .Update(update => update.Action("_UnitGroupUpdate", "Requests"))
        )
        .Events(events => events
            .Change("onChangeGridItemUnitGroups")
            .Edit("onEditGridItemUnitGroups")
            .DataBound("onDataBoundGridItemUnitGroups")
        )
        .AutoBind(true)
)



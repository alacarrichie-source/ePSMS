                )
                .Selectable(s => s.Mode(GridSelectionMode.Single))
                .AutoBind(false)
                )
            </div>
        </div>*@

        @*<div class="row">
            @Html.LabelFor(m => m.BrandName, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.BrandName).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(m => m.OtherSpecs, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.OtherSpecs).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>*@

        <div class="row">
            @Html.LabelFor(m => m.PsUnit, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsUnit).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.Qty, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.Qty)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.UnitCost, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.UnitCost).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.UnitCost)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(model => model.TotalCost, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.TotalCost).Enable(false).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.TotalCost)
            </div>
        </div>

    </fieldset>
}
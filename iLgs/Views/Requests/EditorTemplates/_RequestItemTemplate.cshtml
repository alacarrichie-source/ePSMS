@model iLgs.Models.RequestItemVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PrId)
    @Html.HiddenFor(model => model.PsCode)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>

        <div class="row">
            @Html.LabelFor(m => m.PsCodeId, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.PsCodeId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select stock/property Code")
                        .DataTextField("Code")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetPsCode", "Getters").Data("DataPsCodeId");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("20%");
                            c.Add().Field("Name").Title("Item Name").Width("50%");
                            c.Add().Field("Unit").Title("Unit").Width("15%");
                            c.Add().Field("Type").Title("Type").Width("15%");

                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectPsCode").DataBound("onDataBoundPsCode"); })
                )
                @Html.ValidationMessageFor(m => m.PsCodeId)
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(m => m.PsItem, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsItem).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row">
            @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "col-md-12" })
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.Description).Rows(2).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        @*<div class="row">
            <div class="col-md-12">
                @(Html.Kendo().Grid<iLgs.Models.RequestItemExtnVM> ()
                .Name("gridItemExtn")
                .Columns(col =>
                {
                    col.Bound(c => c.ItemKey).Width(100);
                    col.Bound(c => c.ItemValue).Width(250);
                })
                //.ToolBar(toolbar =>
                //{
                //    toolbar.Save();
                //})
                .Editable(editable => editable.Mode(GridEditMode.InCell))
                .Sortable()
                .NoRecords()
                .Navigatable()
                .Scrollable(s => s.Height(100))
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Batch(true)
                    .Sort(s => s.Add(a => a.ItemKey))
                    .ServerOperation(true)
                        //.Events(events => events.Error("error_handler"))
                    .Model(model =>
                    {
                        model.Id(p => p.Id);
                        model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                        model.Field(p => p.ItemKey).Editable(false);

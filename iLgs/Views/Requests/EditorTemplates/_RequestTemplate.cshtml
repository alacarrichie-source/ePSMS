                </div>
            </div>
        </div>*@

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.DeptId, "LabelGuid")
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.DeptId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Department")
                            .DataTextField("Description")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetUserDepartmentsAsync", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Events(e => e.Select("onSelectOffice").Change("onChangeOffice"))
                    )

                    @Html.ValidationMessageFor(model => model.DeptId)
                </div>
            </div>

            <div class="col-md-6">
                @Html.DisplayFor(model => model.Department, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().MaskedTextBoxFor(model => model.Department).PromptChar(" ")

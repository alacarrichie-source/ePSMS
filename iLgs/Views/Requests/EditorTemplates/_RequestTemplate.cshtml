@model iLgs.Models.RequestVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RisNo)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.PrNo, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().MaskedTextBoxFor(model => model.PrNo).Mask("0000-00-0000")
                                .PromptChar(" ")
                                .Enable(true).HtmlAttributes(new { placeholder = "(AUTO)", style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PrNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.PrDate, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PrDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PrDate)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.RisId, "LabelGuid")
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.RisId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select RIS No.")
                            .DataTextField("RisNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRisNosWithNoPr", "Getters").Data("DataRisId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("RisNo").Title("RIS No.").Width("30%");
                                c.Add().Template("#= kendo.toString(kendo.parseDate(RisDate), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectRisId"); })
                            //.Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.RisId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.RisDate, "LabelDate")
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.RisDate).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RisDate)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Department, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Department).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                    @Html.ValidationMessageFor(model => model.Department)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Section, "Label")
                <div class="col-md-12">                    
                    @(Html.Kendo().TextBoxFor(model => model.Section).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Section)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(model => model.Purpose, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Purpose).Enable(false)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Purpose)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.FPP, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.FPP).Enable(false)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.FPP)
                </div>
            </div>

            <div class="col-md-6">
                @Html.DisplayFor(model => model.Fund, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Fund).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.RequestedBy, "Label")
                <div class="col-md-12">                    
                    @(Html.Kendo().TextBoxFor(model => model.RequestedBy).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RequestedBy)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.RequestedDesig, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.RequestedDesig).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RequestedDesig)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Availability, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Availability)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Name")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodes", "Getters", new { mastCode = "CASH-AVAILABLE" });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => e.Select("onSelectAvailability"))                            
                    )
                    @Html.ValidationMessageFor(model => model.Availability)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.AvaialbilityDesig, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.AvaialbilityDesig).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.AvaialbilityDesig)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-6">
                @Html.DisplayFor(model => model.ApprovedBy, "Label")
                <div class="col-md-12">                    
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ApprovedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Approved by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetApprovedBy", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectApprovedBy"); })                            
                    )
                    @Html.ValidationMessageFor(model => model.ApprovedBy)
                </div>
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.ApprovedDesig, "Label")
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.ApprovedDesig).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ApprovedDesig)
                </div>
            </div>
        </div>
    </fieldset>
}




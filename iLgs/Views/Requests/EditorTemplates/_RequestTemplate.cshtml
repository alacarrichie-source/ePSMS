@model iLgs.Models.RequestVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RisNo)

    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <fieldset>
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.PrNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.PrNo).Placeholder("(AUTO)").Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PrNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PrDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PrDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PrDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.RisId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.RisId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select RIS No.")
                            .DataTextField("RisNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRisNosWithNoPr", "Getters").Data("DataRisId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("RisNo").Title("RIS No.").Width("30%");
                                c.Add().Template("#= kendo.toString(new Date(parseInt(RisDate.substr(6))), 'MM/dd/yyyy') #").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectRisId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.RisId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund).Enable(false)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Fund)
                </div>
            </div>            
        </div>        

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.Department, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Department).Enable(false)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Department")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetDepartments", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Department)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.Section, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @*@(Html.Kendo().MultiColumnComboBoxFor(m => m.Section).Enable(false)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Section")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetSections", "Getters").Data("DataSection");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)                            
                    )*@
                    @(Html.Kendo().TextBoxFor(model => model.Section).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Section)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Purpose, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.Purpose).Enable(false)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Purpose)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.FPP, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.FPP).Enable(false)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.FPP)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.RequestedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @*@(Html.Kendo().MultiColumnComboBoxFor(m => m.RequestedBy).Enable(false)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Requested by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetRequestedBy", "Getters").Data("DataRequestedBy");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectRequestedBy"); })
                            .Suggest(true)                            
                    )*@
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.RequestedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Requested by")
                            .DataTextField("Name")
                            .DataValueField("Name")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAccountableOfficers", "Getters").Data("DataRequestedBy");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("40%");
                                c.Add().Field("Designation").Title("Designation").Width("60%");
                            })
                            .Events(e => { e.Select("onSelectRequestedBy"); })
                            .CascadeFrom("Department")
                            .Suggest(true)
                    )                            
                    @Html.ValidationMessageFor(model => model.RequestedBy)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.RequestedDesig, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.RequestedDesig).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RequestedDesig)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.Availability, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.Availability)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Name")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodes", "Getters", new { mastCode = "CASH-AVAILABLE" });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectAvailability"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.Availability)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.AvaialbilityDesig, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.AvaialbilityDesig).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.AvaialbilityDesig)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.ApprovedBy, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @*@(Html.Kendo().MultiColumnComboBoxFor(m => m.ApprovedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Approved by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetApprovedBy", "Getters").Data("DataApprovedBy");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("60%");
                                c.Add().Field("Desc2").Title("Designation").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectApprovedBy"); })
                            .Suggest(true)
                            .CascadeFrom("Department")
                    )*@
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ApprovedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Approved by")
                            .DataTextField("Name")
                            .DataValueField("Name")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetAccountableOfficers", "Getters").Data("DataApprovedBy");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("40%");
                                c.Add().Field("Designation").Title("Designation").Width("60%");
                            })
                            .Events(e => { e.Select("onSelectApprovedBy"); })
                            .CascadeFrom("Department")
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.ApprovedBy)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.ApprovedDesig, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.ApprovedDesig).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ApprovedDesig)
                </div>
            </div>
        </div>
    </fieldset>
}




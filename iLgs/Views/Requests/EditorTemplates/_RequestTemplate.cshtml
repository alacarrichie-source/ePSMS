@model iLgs.Models.RequestVM

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Id)

        <fieldset>
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Fund, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().MultiColumnComboBoxFor(m => m.Fund)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Fund")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetCodeList", "Getters", new { mastCode = "FUND", addAll = false });
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("30%");
                                c.Add().Field("Description").Title("Description").Width("70%");
                            })
                            .Suggest(true)
                        )
                        @Html.ValidationMessageFor(model => model.Fund)
                    </div>
                </div>
            </div>

            <div class="row">                
                <div class="col-md-6">
                    @Html.LabelFor(model => model.PrNo, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.PrNo).Placeholder("(AUTO)").Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.PrNo)
                    </div>
                </div>                
                <div class="col-md-6">
                    @Html.LabelFor(model => model.PrDate, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().DatePickerFor(model => model.PrDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.PrDate)
                    </div>
                </div>                
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Department, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.Department).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.Department)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Section, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.Section).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.Section)
                    </div>
                </div>                
            </div>

            <div class="row">
                <div class="col-md-12">
                    @Html.LabelFor(model => model.Purpose, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.Purpose).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.Purpose)
                    </div>
                </div>                                
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RequestedBy, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.RequestedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.RequestedBy)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.RequestedDesig, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.RequestedDesig).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                        @Html.ValidationMessageFor(model => model.RequestedDesig)
                    </div>
                </div>                
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.Availability, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.Availability).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.Availability)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.AvaialbilityDesig, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.AvaialbilityDesig).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.AvaialbilityDesig)
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.ApprovedBy, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.ApprovedBy).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.ApprovedBy)
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.ApprovedDesig, htmlAttributes: new { @class = "col-md-12" })
                    <div class="col-md-12">
                        @(Html.Kendo().TextBoxFor(model => model.ApprovedDesig).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                        @Html.ValidationMessageFor(model => model.ApprovedDesig)
                    </div>
                </div>                
            </div>
        </fieldset>
    }




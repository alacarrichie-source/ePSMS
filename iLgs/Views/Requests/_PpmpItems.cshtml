                //}).Width(100);
            })
            .ToolBar(t =>
            {
                t.Search();
            })
            .Search(s =>
            {
                s.Field(o => o.Code, "contains");
                s.Field(o => o.Description, "contains");
            })
            .Pageable(pager => pager
                .Refresh(true)
            )
            .Resizable(r => r.Columns(true))
            .Filterable()
            .Sortable()
            .Scrollable()
            //.Groupable()
            .Selectable(selectable => selectable
                .Mode(GridSelectionMode.Multiple)
                .Type(GridSelectionType.Row)
            )
            //.Selectable(s => s.Mode(GridSelectionMode.Single))
            .PersistSelection(true)
            .NoRecords()
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(100)
                .Events(events => events.Error("GridError"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                })
                .Aggregates(a =>
                {
                    a.Add(p => p.Qty).Sum();
                    a.Add(p => p.QtyBal).Sum();
                    a.Add(p => p.QtyUsed).Sum();
                })
                .Sort(s => { s.Add(a => a.RecNo); })
                .Read(read => read.Action("_PpmpItemRead", "Requests", new { prId = @ViewData["prId"] }))
            ).AutoBind(true)

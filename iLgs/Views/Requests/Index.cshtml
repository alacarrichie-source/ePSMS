@{
    var isSubmittedMode = ViewBag.IsSubmitted == true;
    ViewBag.Title = isSubmittedMode ? "Purchase Request Posting & Review" : "Purchase Requests";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<link href="@Url.Content("~/Content/requests.css")?v=20260916_2" rel="stylesheet" type="text/css" />

<script type="text/javascript">
    /* ==========================================================================
       GLOBAL TEMPLATE RENDERERS & DATA FORMATTERS
       Defined before Grid initialization for complete template execution safety
       ========================================================================== */
    var isPrReviewMode = @Html.Raw(Json.Encode(ViewBag.IsSubmitted == true));
    var canUnpostPr = @Html.Raw(Json.Encode(ViewBag.AllowUnpost == true));

    function renderPrNumber(data) {
        if (!data) return "";
        var id = data.Id;
        var prNo = data.PrNo;
        var ctrlNo = data.CtrlNo || "-";
        var html = "<div class='pr-number-col'>";
        html += "<a href='javascript:void(0)' class='pr-number-link' onclick=\"viewPurchaseRequest('" + id + "')\">";
        if (prNo) {
            html += "<span class='pr-no-text'>" + kendo.htmlEncode(prNo) + "</span>";
        } else {
            html += "<span class='pr-no-draft'>Unnumbered</span>";
        }
        html += "</a>";
        html += "<span class='pr-ctrl-sub'>Ctrl: " + kendo.htmlEncode(ctrlNo) + "</span>";
        html += "</div>";
        return html;
    }

    function renderPrDepartment(data) {
        if (!data) return "";
        var dept = data.Department || "-";
        var fund = data.Fund || "";
        var html = "<div class='pr-dept-col'>";
        html += "<span class='pr-dept-name' title='" + kendo.htmlEncode(dept) + "'>" + kendo.htmlEncode(dept) + "</span>";
        if (fund) {
            html += "<span class='pr-fund-sub'>" + kendo.htmlEncode(fund) + "</span>";
        }
        html += "</div>";
        return html;
    }

    function renderPrPurpose(data) {
        if (!data) return "";
        var purpose = data.Purpose || "";
        return "<span class='pr-purpose' title='" + kendo.htmlEncode(purpose) + "'>" + kendo.htmlEncode(purpose) + "</span>";
    }

    function renderPrAmount(data) {
        if (!data) return "";
        var amount = kendo.toString(data.TotalAmount, 'n2') || "0.00";
        var count = data.ItemCount || 0;
        var itemLabel = count === 1 ? "item" : "items";
        var html = "<div class='pr-amount-col text-right'>";
        html += "<span class='pr-amount-text font-weight-bold'>" + amount + "</span>";
        html += "<span class='pr-items-sub'>" + count + " " + itemLabel + "</span>";
        html += "</div>";
        return html;
    }

    function renderPrDate(data) {
        if (!data) return "";
        var dateStr = data.InsertedDt ? kendo.toString(data.InsertedDt, 'MMM dd, yyyy') : "-";
        var creator = data.InsertedBy || "-";
        var html = "<div class='pr-date-col'>";
        html += "<span class='pr-date-text font-weight-bold'>" + dateStr + "</span>";
        html += "<span class='pr-creator-sub'>by " + kendo.htmlEncode(creator) + "</span>";
        html += "</div>";
        return html;
    }

    function renderPrStatus(status) {
        var value = status || "Draft";
        var cssClass = "status-draft";
        var dotClass = "dot-draft";
        if (value === "Posted") {
            cssClass = "status-posted";
            dotClass = "dot-posted";
        } else if (value === "Submitted") {
            cssClass = "status-submitted";
            dotClass = "dot-submitted";
        } else if (value === "Returned") {
            cssClass = "status-returned";
            dotClass = "dot-returned";
        } else if (value === "Unposted") {
            cssClass = "status-unposted";
            dotClass = "dot-unposted";
        } else if (value === "Revising") {
            cssClass = "status-revising";
            dotClass = "dot-revising";
        }

        return "<span class='status-badge " + cssClass + "'>" +
            "<span class='status-dot " + dotClass + "'></span>" +
            kendo.htmlEncode(value) + "</span>";
    }

    function renderPrActions(item) {
        if (!item) return "";
        var id = item.Id;
        var status = item.Status ? (item.Status + "").replace(/^\s+|\s+$/g, "") : "Draft";
        var html = "<div class='pr-row-actions'>";

        if (isPrReviewMode) {
            // ==========================================
            // REQUESTS / POSTING - ADMINISTRATIVE MATRIX
            // ==========================================
            if (status === "Submitted" || status === "Unposted") {
                // PRIMARY: Review, Post
                html += "<button type='button' class='pr-btn-sm-primary' onclick=\"openPurchaseRequestReview('" + id + "')\" title='Review Purchase Request'><span class='k-icon k-i-search'></span> Review</button>";
                html += "<button type='button' class='pr-btn-sm-primary' onclick=\"openReviewPostDialogForPr('" + id + "')\" title='Post Purchase Request'><span class='k-icon k-i-check'></span> Post</button>";

                // SECONDARY / MORE: Admin Edit, Return for Revision, View
                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); startPurchaseRequestAdminEdit('" + id + "')\"><span class='k-icon k-i-edit'></span> Admin Edit</a>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); openReviewReturnDialogForPr('" + id + "')\"><span class='k-icon k-i-undo'></span> Return for Revision</a>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); viewPurchaseRequest('" + id + "')\"><span class='k-icon k-i-eye'></span> View</a>";
                html += "</div></div>";
            } else if (status === "Returned") {
                // PRIMARY: View
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Purchase Request'><span class='k-icon k-i-eye'></span> View</button>";

                // SECONDARY / MORE: Review Comment
                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); showReturnComment('" + id + "')\"><span class='k-icon k-i-comment'></span> Review Comment</a>";
                html += "</div></div>";
            } else if (status === "Posted") {
                // PRIMARY: View
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Purchase Request'><span class='k-icon k-i-eye'></span> View</button>";

                // SECONDARY / MORE: Print, Unpost
                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); printPurchaseRequest('" + id + "')\"><span class='k-icon k-i-print'></span> Print</a>";
                if (canUnpostPr) {
                    html += "<a href='javascript:void(0)' class='pr-action-menu-item pr-action-menu-item-warn' onclick=\"closeAllPrActionMenus(); unpostPurchaseRequest(this, '" + id + "')\"><span class='k-icon k-i-unlock'></span> Unpost</a>";
                }
                html += "</div></div>";
            } else {
                // Draft or other statuses (normally not shown in Posting queue)
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Details'><span class='k-icon k-i-eye'></span> View</button>";
            }
        } else {
            // ==========================================
            // REQUESTS / INDEX - REQUESTER MATRIX
            // ==========================================
            if (status === "Draft") {
                // PRIMARY: Continue
                html += "<button type='button' class='pr-btn-sm-primary' onclick=\"continueDraftPurchaseRequest('" + id + "')\" title='Continue Draft PR'><span class='k-icon k-i-arrow-right'></span> Continue</button>";

                // SECONDARY / MORE: View, Delete
                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); viewPurchaseRequest('" + id + "')\"><span class='k-icon k-i-eye'></span> View</a>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item pr-action-menu-item-danger' onclick=\"closeAllPrActionMenus(); deletePurchaseRequest('" + id + "')\"><span class='k-icon k-i-trash'></span> Delete</a>";
                html += "</div></div>";
            } else if (status === "Returned") {
                // PRIMARY: Revise PR
                html += "<button type='button' class='pr-btn-sm-primary' onclick=\"startPurchaseRequestRevision('" + id + "')\" title='Revise Returned PR'><span class='k-icon k-i-edit'></span> Revise PR</button>";

                // SECONDARY / MORE: Review Comment, View
                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); showReturnComment('" + id + "')\"><span class='k-icon k-i-comment'></span> Review Comment</a>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); viewPurchaseRequest('" + id + "')\"><span class='k-icon k-i-eye'></span> View</a>";
                html += "</div></div>";
            } else if (status === "Revising") {
                // Revising: Continue Revision
                html += "<button type='button' class='pr-btn-sm-primary' onclick=\"continuePurchaseRequestRevision()\" title='Continue Revision in Cart'><span class='k-icon k-i-arrow-right'></span> Continue Revision</button>";

                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); showReturnComment('" + id + "')\"><span class='k-icon k-i-comment'></span> Review Comment</a>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); viewPurchaseRequest('" + id + "')\"><span class='k-icon k-i-eye'></span> View</a>";
                html += "</div></div>";
            } else if (status === "Submitted" || status === "Unposted") {
                // Submitted / Unposted: PRIMARY: View only (strictly read-only)
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Purchase Request'><span class='k-icon k-i-eye'></span> View</button>";
            } else if (status === "Posted") {
                // Posted: PRIMARY: View, SECONDARY / MORE: Print
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Purchase Request'><span class='k-icon k-i-eye'></span> View</button>";

                html += "<div class='pr-dropdown-wrapper'>";
                html += "<button type='button' class='pr-btn-sm-secondary pr-btn-more' onclick=\"togglePrActionMenu(event, this)\" title='More actions'>More <span class='k-icon k-i-arrow-60-down'></span></button>";
                html += "<div class='pr-action-menu' style='display:none;'>";
                html += "<a href='javascript:void(0)' class='pr-action-menu-item' onclick=\"closeAllPrActionMenus(); printPurchaseRequest('" + id + "')\"><span class='k-icon k-i-print'></span> Print</a>";
                html += "</div></div>";
            } else {
                html += "<button type='button' class='pr-btn-sm-secondary' onclick=\"viewPurchaseRequest('" + id + "')\" title='View Details'><span class='k-icon k-i-eye'></span> View</button>";
            }
        }

        html += "</div>";
        return html;
    }

    /* ==========================================================================
       ACTION DROPDOWN (MORE) MENU PORTAL
       Appended to body to guarantee zero table-cell overflow clipping
       ========================================================================== */
    function togglePrActionMenu(e, btn) {
        if (e) {
            e.stopPropagation();
            e.preventDefault();
        }
        var $btn = $(btn);
        var $wrapper = $btn.closest(".pr-dropdown-wrapper");
        var $menu = $wrapper.find(".pr-action-menu");
        if (!$menu.length) return;

        var wasActive = $btn.hasClass("active");
        closeAllPrActionMenus();
        if (wasActive) return;

        $btn.addClass("active");

        var $portal = $("#prActionMenuPortal");
        if (!$portal.length) {
            $portal = $("<div id='prActionMenuPortal' class='pr-action-menu-portal'></div>").appendTo("body");
        }
        $portal.empty().html($menu.html());

        var rect = btn.getBoundingClientRect();
        var menuWidth = 175;
        var left = rect.right - menuWidth;
        if (left < 10) left = 10;
        var top = rect.bottom + 4;

        var windowHeight = $(window).height();
        $portal.css({ top: top + "px", left: left + "px", display: "block" });
        var portalHeight = $portal.outerHeight();
        if (top + portalHeight > windowHeight - 10 && rect.top > portalHeight + 10) {
            top = rect.top - portalHeight - 4;
            $portal.css({ top: top + "px" });
        }

        $(document).off("click.prActionMenu").on("click.prActionMenu", function (ev) {
            if (!$(ev.target).closest("#prActionMenuPortal, .pr-btn-more").length) {
                closeAllPrActionMenus();
            }
        });
        $(window).off("scroll.prActionMenu resize.prActionMenu").on("scroll.prActionMenu resize.prActionMenu", function () {
            closeAllPrActionMenus();
        });
    }

    function closeAllPrActionMenus() {
        $(".pr-btn-more").removeClass("active");
        $("#prActionMenuPortal").hide().empty();
        $(document).off("click.prActionMenu");
        $(window).off("scroll.prActionMenu resize.prActionMenu");
    }

    /* ==========================================================================
       GRID / DATASOURCE EVENT HANDLERS & SELECTION STATE
       Pre-declared before Grid rendering to guarantee immediate availability
       ========================================================================== */
    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var submittedBy = null;
    var postedBy = null;
    var selectedPrNo = null;
    var selectedCtrlNo = null;

    function addAntiForgeryToken(data) {
        data = data || {};
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        if (token) {
            data.__RequestVerificationToken = token;
        }
        return data;
    }

    function onChangeGrid(e) {
        var grid = (e && e.sender) ? e.sender : (this.dataItem ? this : $("#grid").data("kendoGrid"));
        if (!grid || typeof grid.select !== "function") {
            return;
        }

        var row = grid.select();
        if (!row || row.length === 0) {
            return;
        }

        var dataItem = grid.dataItem(row);
        if (!dataItem) {
            return;
        }

        selectedId = dataItem.Id;
        selectedItemId = null;
        submittedBy = dataItem.SubmittedBy;
        postedBy = dataItem.PostedBy;
        selectedPrNo = dataItem.PrNo;
        selectedCtrlNo = dataItem.CtrlNo;
    }

    function onDataBoundGrid(e) {
        var grid = (e && e.sender) ? e.sender : this;
        var rawData = (grid && grid.dataSource) ? grid.dataSource.data() : [];
        if (typeof updateQuickFilterCountsAndDept === "function") {
            updateQuickFilterCountsAndDept(rawData);
        }

        if (selectedId && grid && grid.dataSource) {
            var dataItem = grid.dataSource.get(selectedId);
            if (dataItem) {
                grid.select($('[data-uid="' + dataItem.uid + '"]'));
            }
        } else if (grid && grid.tbody) {
            var row = grid.tbody.find("tr:first");
            if (row && row.length > 0) {
                grid.select(row);
            }

            grid.unbind("detailExpand.prSelect").bind("detailExpand.prSelect", function (ev) {
                grid.select(ev.masterRow);
            });
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        selectedId = null;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            if (row && row.length > 0) {
                this.select(row);
            }

            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetModelDefault", "Requests")',
                success: function (result) {
                    if (result && result.model) {
                        var availCombo = $("#Availability").data("kendoMultiColumnComboBox");
                        if (availCombo) {
                            availCombo.value(result.model.Availability);
                            availCombo.trigger("change");
                        }
                        $("#AvaialbilityDesig").val(result.model.AvaialbilityDesig).trigger("change");

                        var approvedCombo = $("#ApprovedBy").data("kendoMultiColumnComboBox");
                        if (approvedCombo) {
                            approvedCombo.value(result.model.ApprovedBy);
                            approvedCombo.trigger("change");
                        }
                        $("#ApprovedDesig").val(result.model.ApprovedDesig).trigger("change");
                    }
                    disabled.attr('disabled', 'disabled');
                },
                error: function (req) {
                    alert(req.responseText);
                }
            });
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            if (rowitem) {
                selectedGrid.select($('[data-uid="' + rowitem.uid + '"]'));
            }
        }
    }

    function onRequestEnd(e) {
        if (!e.response || !e.response.Errors) {
            if (e.type == "destroy" || e.type == "update") {
                if (selectedGrid && selectedGrid.dataSource) selectedGrid.dataSource.read();
                else if (typeof refreshPrGrid === "function") refreshPrGrid();
            }
            if (e.type == "create") {
                var responseData = e.response;
                if (responseData && responseData.Data && responseData.Data.length > 0) {
                    var newRecord = responseData.Data[0];
                    selectedId = newRecord.Id;

                    if (selectedId) {
                        var grid = $("#grid").data("kendoGrid");
                        if (grid) {
                            grid.dataSource.read().then(function () {
                                var dataItem = grid.dataSource.get(selectedId);
                                if (dataItem) {
                                    var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                                    grid.expandRow(row);
                                }
                            });
                        }
                        if (typeof PpeItems === "function") {
                            PpeItems();
                        }
                    }
                }
            }
        }
    }

    function GridError(args) {
        if (args && args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    if (selectedGrid && selectedGrid.dataSource) selectedGrid.dataSource.read();
                }
            });
            if (validationError && selectedGrid && selectedGrid.editable) {
                var templateEl = $("#validationMessageTemplate");
                if (templateEl.length > 0) {
                    var validationTemplate = kendo.template(templateEl.html());
                    $('#ErrorContent').removeClass('hidden');

                    selectedGrid.one("dataBinding", function (e) {
                        e.preventDefault();
                        var errors = selectedGrid.editable.element.find(".errors");
                        errors.empty();
                        $.each(args.errors, function (propertyName) {
                            var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                            errors.append(renderedTemplate);
                        });
                    });
                }
            }
        }
    }

    function onSelectTabStrip(e) {
        var tabStrip = this;
        for (var idx = 0; ; ++idx) {
            var tab = tabStrip.contentElement(idx);
            if (tab == null) break;
            if (tab != e.contentElement) {
                $(tab).html("");
            }
        }
    }
</script>

<div class="requests-workspace epsms-requests po-wizard">
    @Html.AntiForgeryToken()

    <!-- PAGE HEADER -->
    <div class="requests-header">
        <div class="requests-title-group">
            <h2>
                <span class="requests-title-icon"><span class="k-icon k-i-cart"></span></span>
                @(isSubmittedMode ? "PURCHASE REQUEST POSTING & REVIEW" : "PURCHASE REQUESTS")
            </h2>
            <p class="requests-subtitle">
                @(isSubmittedMode
                    ? "Review verified requisitions, return items for corrections, or assign official PR numbers and post."
                    : "Create, review, track, and manage departmental purchase requests.")
            </p>
        </div>
        <div class="requests-header-actions">
            @if (!isSubmittedMode)
            {
                <a href="@Url.Action("Annual", "Procurement")" class="btn-primary-action" title="Create a New Purchase Request">
                    <span class="k-icon k-i-plus"></span> Create a New PR
                </a>
            }
            <button type="button" class="btn-secondary-action" onclick="refreshPrGrid()" title="Refresh grid data">
                <span class="k-icon k-i-reload"></span> Refresh
            </button>
        </div>
    </div>

    <!-- KPI SUMMARY CARDS (Interactive click-to-filter, matching PpmpAcctgCode) -->
    <div class="requests-metrics-row">
        <div class="requests-metric-card active" id="cardMetricTotal" data-status="" onclick="filterByStatusPill('')" title="Click to view all requests">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Total Requests</span>
                <span class="requests-metric-dot dot-total"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricTotal">0</span>
                <span class="requests-metric-subtext">All records</span>
            </div>
        </div>

        <div class="requests-metric-card" id="cardMetricDraft" data-status="Draft" onclick="filterByStatusPill('Draft')" title="Click to filter by draft">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Draft</span>
                <span class="requests-metric-dot dot-draft"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricDraft">0</span>
                <span class="requests-metric-subtext">In preparation</span>
            </div>
        </div>

        <div class="requests-metric-card" id="cardMetricSubmitted" data-status="Submitted" onclick="filterByStatusPill('Submitted')" title="Click to filter by submitted">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Submitted</span>
                <span class="requests-metric-dot dot-submitted"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricSubmitted">0</span>
                <span class="requests-metric-subtext">Pending review</span>
            </div>
        </div>

        <div class="requests-metric-card" id="cardMetricReturned" data-status="Returned" onclick="filterByStatusPill('Returned')" title="Click to filter by returned">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Returned</span>
                <span class="requests-metric-dot dot-returned"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricReturned">0</span>
                <span class="requests-metric-subtext">Needs revision</span>
            </div>
        </div>

        <div class="requests-metric-card" id="cardMetricUnposted" data-status="Unposted" onclick="filterByStatusPill('Unposted')" title="Click to filter by unposted">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Unposted</span>
                <span class="requests-metric-dot dot-unposted"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricUnposted">0</span>
                <span class="requests-metric-subtext">Needs action</span>
            </div>
        </div>

        <div class="requests-metric-card" id="cardMetricPosted" data-status="Posted" onclick="filterByStatusPill('Posted')" title="Click to filter by posted">
            <div class="requests-metric-header">
                <span class="requests-metric-label">Posted</span>
                <span class="requests-metric-dot dot-posted"></span>
            </div>
            <div class="requests-metric-value-row">
                <span class="requests-metric-number" id="metricPosted">0</span>
                <span class="requests-metric-subtext">Official PR</span>
            </div>
        </div>
    </div>

    <!-- MAIN UNIFIED WORKSPACE CARD -->
    <div class="requests-card">
        <div class="requests-card-header">
            <h3 class="requests-card-title">
                <span class="k-icon k-i-grid"></span> @(isSubmittedMode ? "Purchase Request Posting Queue" : "Purchase Requests Directory")
            </h3>
            <div class="requests-card-stats">
                <span id="pillCountAllBadge">0</span> Records
            </div>
        </div>

        <!-- INTEGRATED TOOLBAR: Search & Filters directly above grid -->
        <div class="requests-toolbar">
            <div class="requests-search-container">
                <span class="k-icon k-i-search requests-search-icon"></span>
                <input id="searchPR" type="text" class="requests-search-input"
                       placeholder="Search by PR#, Ctrl#, department, purpose, fund, creator..." />
            </div>

            <div class="requests-filter-group">
                <select id="prDeptFilter" class="requests-select" onchange="applyPrFilters()">
                    <option value="">All Departments</option>
                </select>

                <select id="prStatusFilter" class="requests-select" onchange="onStatusFilterChange()">
                    <option value="">All Statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Returned">Returned</option>
                    <option value="Revising">Revising</option>
                    <option value="Unposted">Unposted</option>
                    <option value="Posted">Posted</option>
                </select>

                <button type="button" class="requests-btn-reset" onclick="resetPrFilters()" title="Clear all filters">
                    <span class="k-icon k-i-reload"></span> Clear
                </button>
            </div>
        </div>

        <!-- KENDO GRID BODY -->
        <div class="requests-card-body">
            @(Html.Kendo().Grid<iLgs.Models.RequestVM>()
            .Name("grid")
            .HtmlAttributes(new { @class = "pr-directory-grid" })
            .Columns(col =>
            {
                col.Bound(c => c.PrNo).Title("PR / Ctrl No.").Width(160)
                    .ClientTemplate("#= renderPrNumber(data) #");
                col.Bound(c => c.Department).Title("Department & Fund").Width(210)
                    .ClientTemplate("#= renderPrDepartment(data) #");
                col.Bound(c => c.Purpose).Title("Purpose").Width(280)
                    .ClientTemplate("#= renderPrPurpose(data) #");
                col.Bound(c => c.TotalAmount).Title("Items & Amount").Width(150)
                    .HtmlAttributes(new { @class = "text-right" })
                    .HeaderHtmlAttributes(new { @class = "text-right" })
                    .ClientTemplate("#= renderPrAmount(data) #");
                col.Bound(c => c.PrDate).Title("Date & Creator").Width(140)
                    .ClientTemplate("#= renderPrDate(data) #");
                col.Bound(c => c.Status).Title("Status").Width(125)
                    .HtmlAttributes(new { @class = "text-center" })
                    .HeaderHtmlAttributes(new { @class = "text-center" })
                    .ClientTemplate("#= renderPrStatus(Status) #");
                col.Bound(c => c.Id).Title("Actions").Width(isSubmittedMode ? 245 : 190)
                    .Sortable(false).Filterable(false)
                    .HtmlAttributes(new { @class = "text-right" })
                    .HeaderHtmlAttributes(new { @class = "text-right" })
                    .ClientTemplate("#= renderPrActions(data) #");
            })
            .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RequestTemplate").Window(w => w.Width(800).Title("Purchase Request")))
            .Pageable(pager => pager
                .Input(false)
                .Numeric(true)
                .Info(true)
                .PreviousNext(true)
                .Refresh(true)
                .PageSizes(new[] { 10, 20, 50, 100 })
                .ButtonCount(5)
            )
            .Filterable()
            .NoRecords(n => n.Template(
                "<div class='item-empty-state pr-empty-state'>" +
                    "<span class='k-icon k-i-folder-open pr-empty-icon'></span>" +
                    "<p>No Purchase Requests found</p>" +
                    "<span class='item-empty-sub pr-empty-sub'>No records match your search query or selected status filter.</span>" +
                    "<div style='margin-top: 10px;'><button type='button' class='btn-secondary-action' onclick='resetPrFilters()'><span class='k-icon k-i-reload'></span> Reset Filters</button></div>" +
                "</div>"
            ))
            .Resizable(r => r.Columns(true))
            .Scrollable()
            .Selectable(s => s.Mode(GridSelectionMode.Single))
            .Sortable()
            .ClientDetailTemplateId("Details")
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(20)
                .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
                .Model(model =>
                {
                    model.Id(p => p.Id);
                    model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                })
                .Sort(s => s.Add(a => a.InsertedDt).Descending())
                .Read(read => read.Action("RequestRead", "Requests", new { isSubmitted = ViewBag.IsSubmitted }))
                .Update(update => update.Action("RequestUpdate", "Requests").Data("addAntiForgeryToken"))
                .Destroy(destroy => destroy.Action("RequestDestroy", "Requests").Data("addAntiForgeryToken"))
            )
            .Events(events => events
                .Change("onChangeGrid")
                .Edit("onEditGrid")
                .DataBound("onDataBoundGrid")
            )
            )
        </div>
    </div>
</div>


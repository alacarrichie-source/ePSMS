<script type="text/javascript">
    var purchaseRequestPrintUrl = '@Url.Action("PurchaseRequestRpt", "Requests")';
    var purchaseRequestReviewUrl = '@Url.Action("Review", "Requests")';
    var purchaseRequestViewUrl = '@Url.Action("View", "Requests")';
    var startRevisionUrl = '@Url.Action("StartRevision", "Procurement")';
    var postPurchaseRequestUrl = '@Url.Action("PostPurchaseRequest", "Requests")';
    var unpostPurchaseRequestUrl = '@Url.Action("UnpostPurchaseRequest", "Requests")';
    var returnForRevisionUrl = '@Url.Action("ReturnForRevision", "Requests")';
    var resubmitRequestUrl = '@Url.Action("ResubmitRequest", "Requests")';
    var reviewRequestId = null;
    var searchTimer = null;
    var knownDepartments = {};

    // --- Row Target & Dialog Helpers ---

    function getPurchaseRequestRow(id) {
        var grid = $("#grid").data("kendoGrid");
        var item = grid ? grid.dataSource.get(id) : null;
        return item ? { grid: grid, item: item, row: grid.tbody.find("tr[data-uid='" + item.uid + "']") } : null;
    }

    function viewPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (target) {
            target.grid.select(target.row);
        }
        openPurchaseRequestModal(id, true);
    }

    function editPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target) return;
        var st = target.item.Status;
        if (st !== "Draft" && st !== "Returned" && st !== "Submitted" && st !== "Unposted") return;
        target.grid.select(target.row);
        target.grid.editRow(target.row);
    }

    function openReviewPostDialogForPr(id) {
        reviewRequestId = id;
        openReviewPostDialog();
    }

    function openReviewReturnDialogForPr(id) {
        reviewRequestId = id;
        openReviewReturnDialog();
    }

        var startAdminEditUrl = "@Url.Action("StartAdminEdit", "Requests")";

    function startPurchaseRequestAdminEdit(id) {
        $.ajax({
            url: startAdminEditUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                id: id
            }
        }).done(function (result) {
            if (result.success) {
                window.location.href = result.redirectUrl;
            } else if (window.kendo && kendo.alert) {
                kendo.alert(kendo.htmlEncode(result.message || "Admin Edit could not be started."));
            } else {
                alert(result.message || "Admin Edit could not be started.");
            }
        }).fail(function () {
            if (window.kendo && kendo.alert) {
                kendo.alert("Admin Edit could not be started.");
            } else {
                alert("Admin Edit could not be started.");
            }
        });
    }

    function startPurchaseRequestRevision(id) {
        $.ajax({
            url: startRevisionUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                id: id
            }
        }).done(function (result) {
            if (result.success) window.location.href = result.redirectUrl;
            else if (window.kendo && kendo.alert) kendo.alert(kendo.htmlEncode(result.message || "The revision could not be started."));
        }).fail(function () {
            if (window.kendo && kendo.alert) kendo.alert("The revision could not be started.");
        });
    }

    function continuePurchaseRequestRevision() {
        window.location.href = '@Url.Action("Cart", "Procurement")';
    }

    function deletePurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target || target.item.Status !== "Draft") return;
        if (!window.confirm("Delete this draft Purchase Request?")) return;
        target.grid.dataSource.remove(target.item);
        target.grid.dataSource.sync();
    }

    function printPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target || !target.item.CtrlNo) return;
        window.open(purchaseRequestPrintUrl + "?ctrlNo=" +
            encodeURIComponent(target.item.CtrlNo), "_blank");
    }

    function continueDraftPurchaseRequest(id) {
        window.location.href = '@Url.Action("Cart", "Procurement")';
    }

    var getReturnCommentUrl = '@Url.Action("GetReturnComment", "Requests")';

    function showReturnComment(id) {
        var target = getPurchaseRequestRow(id);
        var item = target ? target.item : null;

        var wnd = ensureReviewDialog("#reviewCommentWindow", "Review Comment / Reason for Return", 500);
        $("#reviewCommentText").text("Loading comment...");
        $("#reviewCommentUser").text("-");
        $("#reviewCommentDate").text("-");
        wnd.center().open();

        $.ajax({
            url: getReturnCommentUrl,
            type: "GET",
            data: { id: id }
        }).done(function (result) {
            if (result && result.success) {
                $("#reviewCommentText").text(result.remarks || "No comments recorded.");
                $("#reviewCommentUser").text(result.returnedBy || (item ? item.StatusUser : "-") || "-");
                $("#reviewCommentDate").text(result.returnedDate || "-");
            } else {
                var remarks = (item && item.StatusRemarks) ? item.StatusRemarks : "No review comment was recorded.";
                $("#reviewCommentText").text(remarks);
                $("#reviewCommentUser").text((item && item.StatusUser) ? item.StatusUser : "-");
                $("#reviewCommentDate").text((item && item.StatusDate) ? kendo.toString(item.StatusDate, 'MMM dd, yyyy') : "-");
            }
        }).fail(function () {
            var remarks = (item && item.StatusRemarks) ? item.StatusRemarks : "No review comment was recorded.";
            $("#reviewCommentText").text(remarks);
            $("#reviewCommentUser").text((item && item.StatusUser) ? item.StatusUser : "-");
            $("#reviewCommentDate").text((item && item.StatusDate) ? kendo.toString(item.StatusDate, 'MMM dd, yyyy') : "-");
        });
    }

    function closeReviewCommentDialog() {
        var wnd = $("#reviewCommentWindow").data("kendoWindow");
        if (wnd) wnd.close();
    }

    function resubmitPurchaseRequest(id) {
        if (!window.confirm("Resubmit this revised Purchase Request for review?")) return;

        $.ajax({
            url: resubmitRequestUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                requestId: id
            }
        }).done(function (result) {
            if (!result.success) {
                window.alert(result.message || "The Purchase Request could not be resubmitted.");
                return;
            }
            refreshPrGrid();
        }).fail(function () {
            window.alert("The Purchase Request could not be resubmitted.");
        });
    }

    function unpostPurchaseRequest(btn, id) {
        var target = getPurchaseRequestRow(id);
        var prNo = (target && target.item && target.item.PrNo) ? target.item.PrNo : (target && target.item && target.item.CtrlNo ? target.item.CtrlNo : "");
        var confirmMsg = "Unpost PR " + (prNo ? prNo : "") + "? The Purchase Request will return to the review stage. If changes are required, use Return for Revision after unposting.";

        var confirmPromise = (window.kendo && kendo.confirm)
            ? kendo.confirm(confirmMsg)
            : (window.confirm(confirmMsg) ? $.Deferred().resolve().promise() : $.Deferred().reject().promise());

        confirmPromise.done(function () {
            var $btn = $(btn);
            if ($btn.data("processing") === true) {
                return;
            }
            $btn.data("processing", true);
            var originalHtml = $btn.html();
            $btn.data("original-html", originalHtml);
            $btn.addClass("k-state-disabled").prop("disabled", true).attr("aria-disabled", "true");
            $btn.html("<span class='k-icon k-i-loading'></span> Unposting...");

            $.ajax({
                url: unpostPurchaseRequestUrl,
                type: "POST",
                data: {
                    __RequestVerificationToken: $("input[name='__RequestVerificationToken']").first().val(),
                    requestId: id
                }
            }).done(function (result) {
                if (result && result.success) {
                    if (window.kendo && kendo.alert) {
                        kendo.alert(result.message || "Purchase Request has been unposted and returned to the review stage.");
                    } else {
                        window.alert(result.message || "Purchase Request has been unposted and returned to the review stage.");
                    }
                    refreshPrGrid();
                    if (typeof closePurchaseRequestReview === "function") { closePurchaseRequestReview(); }
                } else {
                    var errorMsg = (result && result.message) ? result.message : ((result && result.Errors) ? (Array.isArray(result.Errors) ? result.Errors.join(" ") : result.Errors) : "The operation was blocked.");
                    if (window.kendo && kendo.alert) {
                        kendo.alert(errorMsg);
                    } else {
                        window.alert(errorMsg);
                    }
                    restoreUnpostButton($btn, originalHtml);
                }
            }).fail(function (xhr) {
                var failMsg = "The unpost operation failed. Please try again.";
                if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                    failMsg = xhr.responseJSON.message;
                }
                if (window.kendo && kendo.alert) {
                    kendo.alert(failMsg);
                } else {
                    window.alert(failMsg);
                }
                restoreUnpostButton($btn, originalHtml);
            });
        });
    }

    function restoreUnpostButton($btn, originalHtml) {
        if (!$btn || !$btn.length) return;
        $btn.data("processing", false);
        $btn.removeClass("k-state-disabled").prop("disabled", false).removeAttr("aria-disabled");
        if (originalHtml) {
            $btn.html(originalHtml);
        }
    }

    // --- Review & Details Modal Handlers ---

    function openPurchaseRequestModal(id, viewOnly) {
        reviewRequestId = id;
        var wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        var title = viewOnly ? "Purchase Request Details" : "Review Purchase Request";
        var url = viewOnly ? purchaseRequestViewUrl : purchaseRequestReviewUrl;

        if (!wnd) {
            $("#purchaseRequestReviewWindow").kendoWindow({
                title: title,
                width: "94%",
                height: "86%",
                modal: true,
                visible: false,
                actions: ["Maximize", "Close"],
                refresh: function () { this.center(); }
            });
            wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        } else {
            wnd.title(title);
        }

        wnd.content("<div class='pr-review-loading' style='padding: 30px; text-align: center; color: #64748b;'><span class='k-icon k-i-loading' style='font-size: 20px;'></span> Loading Purchase Request...</div>");
        wnd.center().open();
        wnd.refresh({ url: url, data: { id: id } });
    }

    function openPurchaseRequestReview(id) {
        var target = getPurchaseRequestRow(id);
        if (target) {
            target.grid.select(target.row);
        }
        openPurchaseRequestModal(id, false);
    }

    function closePurchaseRequestReview() {
        var wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        if (wnd) wnd.close();
        reviewRequestId = null;
    }

    function openReviewPostDialog() {
        $("#reviewPostError").text("");
        $("#reviewPostPrNumber").val("");
        var target = getPurchaseRequestRow(reviewRequestId);
        var datePicker = $("#reviewPostPrDate").data("kendoDatePicker");
        if (!datePicker) {
            $("#reviewPostPrDate").kendoDatePicker({ format: "MM/dd/yyyy" });
            datePicker = $("#reviewPostPrDate").data("kendoDatePicker");
        }
        datePicker.value(target && target.item.PrDate ? target.item.PrDate : new Date());
        var wnd = ensureReviewDialog("#postPurchaseRequestWindow", "Post Purchase Request", 500);
        wnd.center().open();
    }

    function closeReviewPostDialog() {
        var wnd = $("#postPurchaseRequestWindow").data("kendoWindow");
        if (wnd) wnd.close();
    }

    function submitReviewPost() {
        var prNumber = $.trim($("#reviewPostPrNumber").val());
        var datePicker = $("#reviewPostPrDate").data("kendoDatePicker");
        var prDate = datePicker ? datePicker.value() : null;
        if (!prDate) {
            $("#reviewPostError").text("The PR Date is required.");
            return;
        }
        setReviewButtonBusy("#confirmReviewPost", true);
        $.ajax({
            url: postPurchaseRequestUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                RequestId: reviewRequestId,
                PrNumber: prNumber,
                PrDate: kendo.toString(prDate, "yyyy-MM-dd")
            }
        }).done(function (result) {
            if (result.success) completeReviewAction();
            else $("#reviewPostError").text(result.message || "The Purchase Request could not be posted.");
        }).fail(function () {
            $("#reviewPostError").text("The Purchase Request could not be posted.");
        }).always(function () {
            setReviewButtonBusy("#confirmReviewPost", false);
        });
    }

    function openReviewReturnDialog() {
        $("#returnRevisionRemarks").val("");
        $("#returnRevisionError").text("");
        var wnd = ensureReviewDialog("#returnForRevisionWindow", "Return Purchase Request for Revision", 520);
        wnd.center().open();
    }

    function closeReturnForRevision() {
        var wnd = $("#returnForRevisionWindow").data("kendoWindow");
        if (wnd) wnd.close();
    }

    function submitReturnForRevision() {
        var remarks = $.trim($("#returnRevisionRemarks").val());
        if (!remarks) {
            $("#returnRevisionError").text("A review comment is required.");
            $("#returnRevisionRemarks").focus();
            return;
        }

        setReviewButtonBusy("#confirmReturnForRevision", true);
        $.ajax({
            url: returnForRevisionUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                RequestId: reviewRequestId,
                ReviewComment: remarks
            }
        }).done(function (result) {
            if (!result.success) {
                $("#returnRevisionError").text(result.message || "The Purchase Request could not be returned.");
                return;
            }
            completeReviewAction();
        }).fail(function () {
            $("#returnRevisionError").text("The Purchase Request could not be returned.");
        }).always(function () {
            setReviewButtonBusy("#confirmReturnForRevision", false);
        });
    }

    function ensureReviewDialog(selector, title, width) {
        var wnd = $(selector).data("kendoWindow");
        if (!wnd) {
            $(selector).kendoWindow({
                title: title,
                width: width + "px",
                modal: true,
                visible: false,
                actions: ["Close"]
            });
            wnd = $(selector).data("kendoWindow");
        }
        return wnd;
    }

    function setReviewButtonBusy(selector, busy) {
        $(selector).prop("disabled", busy).toggleClass("k-disabled", busy);
    }

    function completeReviewAction() {
        closeReviewPostDialog();
        closeReturnForRevision();
        closePurchaseRequestReview();
        refreshPrGrid();
    }

    // --- Search, Filtering & Metric Calculations ---

    function applyPrFilters() {
        var grid = $("#grid").data("kendoGrid");
        if (!grid) return;

        var query = $.trim($("#searchPR").val());
        var dept = $("#prDeptFilter").val();
        var status = $("#prStatusFilter").val();
        var filters = [];

        if (query) {
            filters.push({
                logic: "or",
                filters: [
                    { field: "PrNo", operator: "contains", value: query },
                    { field: "CtrlNo", operator: "contains", value: query },
                    { field: "Department", operator: "contains", value: query },
                    { field: "Purpose", operator: "contains", value: query },
                    { field: "Fund", operator: "contains", value: query },
                    { field: "InsertedBy", operator: "contains", value: query }
                ]
            });
        }

        if (dept) {
            filters.push({ field: "Department", operator: "eq", value: dept });
        }

        if (status) {
            filters.push({ field: "Status", operator: "eq", value: status });
        }

        grid.dataSource.filter(filters.length ? { logic: "and", filters: filters } : {});
    }

    function filterByStatusPill(status) {
        $("#prStatusFilter").val(status);
        $(".requests-metric-card").removeClass("active");
        if (status) {
            $(".requests-metric-card[data-status='" + status + "']").addClass("active");
        } else {
            $(".requests-metric-card[data-status='']").addClass("active");
        }

        applyPrFilters();
    }

    function onStatusFilterChange() {
        var status = $("#prStatusFilter").val();
        filterByStatusPill(status);
    }

    function resetPrFilters() {
        $("#searchPR").val("");
        $("#prDeptFilter").val("");
        var defaultStatus = isPrReviewMode ? "Submitted" : "";
        filterByStatusPill(defaultStatus);
    }

    function refreshPrGrid() {
        var grid = $("#grid").data("kendoGrid");
        if (grid) grid.dataSource.read();
    }

    function updateQuickFilterCountsAndDept(data) {
        if (!data) return;

        var totalCount = data.length;
        var draftCount = 0;
        var submittedCount = 0;
        var returnedCount = 0;
        var unpostedCount = 0;
        var postedCount = 0;

        var deptSelect = $("#prDeptFilter");
        var currentDept = deptSelect.val();

        for (var i = 0; i < data.length; i++) {
            var item = data[i];

            var st = item.Status || "Draft";
            if (st === "Draft" || st === "Revising") draftCount++;
            if (st === "Submitted") submittedCount++;
            if (st === "Returned") returnedCount++;
            if (st === "Unposted") unpostedCount++;
            if (st === "Posted") postedCount++;

            if (item.Department && !knownDepartments[item.Department]) {
                knownDepartments[item.Department] = true;
                deptSelect.append($("<option>", { value: item.Department, text: item.Department }));
            }
        }

        if (currentDept) deptSelect.val(currentDept);

        // Update KPI metrics and badge
        $("#metricTotal").text(totalCount);
        $("#metricDraft").text(draftCount);
        $("#metricSubmitted").text(submittedCount);
        $("#metricReturned").text(returnedCount);
        $("#metricUnposted").text(unpostedCount);
        $("#metricPosted").text(postedCount);
        $("#pillCountAllBadge").text(totalCount);
    }

    // Attach debounced search listener
    $(document).ready(function () {
        $("#searchPR").on("input", function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
                applyPrFilters();
            }, 250);
        });

        if (isPrReviewMode) {
            $("#prStatusFilter").val("Submitted");
            $(".requests-metric-card").removeClass("active");
            $(".requests-metric-card[data-status='Submitted']").addClass("active");
        }

        $(window).on("resize", function () {
            var grid = $("#grid").data("kendoGrid");
            if (grid) {
                grid.resize();
            }
        });
    });

    // --- Row Action Helpers ---
    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedGrid.removeRow(tr);
    }

    function error_handler(e) {
        if (e.errors) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    // --- Detail Grid Items Handlers ---

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        if (selectedData) selectedItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedItemId = null;
            e.model.set("PrId", selectedId);
        } else {
            selectedItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onClickDeleteGridItem(e) {
        e.preventDefault();
        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function onClickBtnAddRequestItem(e) {
        e.preventDefault();
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        parentGrid.select(parentRow);
        RequestItem("A", null, null);
    }

    function onClickBtnEditRequestItem(e) {
        e.preventDefault();
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        parentGrid.select(parentRow);

        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        RequestItem("E", dataItem.Id, dataItem.SetLotNo);
    }

    function onClickBtnAddPpmpItem(e) {
        e.preventDefault();
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        parentGrid.select(parentRow);
        PpeItems();
    }

    function RequestItem(mode, recId, setLotNo) {
        var myTitle = (mode == "A") ? "Request Item - ADD" : "Request Item - EDIT";
        var width = 800;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    var detailGrid = $("#gridItems_" + selectedId).data("kendoGrid");
                    if (detailGrid) detailGrid.dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");

        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_RequestItemAddEdit", "Requests")',
            data: {
                prId: selectedId,
                requestItemId: recId,
                setLotNo: setLotNo
            },
            complete: function () {
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    function PpeItems() {
        var myTitle = "PPMP Items";
        var width = "80%";
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    var detailGrid = $("#gridItems_" + selectedId).data("kendoGrid");
                    if (detailGrid) detailGrid.dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");

        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_PpmpItems", "Requests")',
            data: { prId: selectedId },
            complete: function () {
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({ width: "800", height: "auto" });
            mywindow.center();
        }
    }

    function changeAmount() {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = (qty || 0) * (unitCost || 0);

        $("#TotalCost").data("kendoNumericTextBox").value(amount);
        $("#TotalCost").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                var detailGrid = $("#gridItems_" + selectedId).data("kendoGrid");
                if (detailGrid) detailGrid.dataSource.read();
            }
        }
    }

    function getQtySumExcludingSet() {
        var grid = $("#gridItems_" + selectedId).data("kendoGrid");
        if (!grid) return 0;
        var data = grid.dataSource.view();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            if (data[i].ItemNo && !data[i].ItemNo.includes(".")) {
                total += data[i].Qty || 0;
            }
        }
        return total;
    }

    function getTotalCostSumExcludingSet() {
        var grid = $("#gridItems_" + selectedId).data("kendoGrid");
        if (!grid) return 0;
        var data = grid.dataSource.view();
        var total = 0;
        for (var i = 0; i < data.length; i++) {
            if (data[i].ItemNo && !data[i].ItemNo.includes(".")) {
                total += data[i].TotalCost || 0;
            }
        }
        return total;
    }

    // --- Helpers used by _RequestTemplate popup editor ---

    function DataRisId() {
        var combo = $("#RisId").data("kendoMultiColumnComboBox");
        var text = combo ? (combo.text() || combo.value()) : "";
        return {
            prId: $("#Id").val(),
            text: text
        };
    }

    function onSelectRisId(e) {
        var dataItem = this.dataItem(e.item.index());
        var risDate = kendo.parseDate(dataItem.RisDate);

        $("#PrNo").val(dataItem.RisNo).trigger("change");
        $("#RisNo").val(dataItem.RisNo).trigger("change");
        $("#RisDate").val(risDate).trigger("change");
        $("#Fund").val(dataItem.Fund).trigger("change");
        $("#FPP").val(dataItem.FPP).trigger("change");
        $("#Department").val(dataItem.Department).trigger("change");
        $("#Section").val(dataItem.Section).trigger("change");
        $("#Purpose").val(dataItem.Purpose).trigger("change");
        $("#RequestedBy").val(dataItem.ApprovedBy).trigger("change");
        $("#RequestedDesig").val(dataItem.ApprovedByDesignation).trigger("change");

        var model = $("#grid").data().kendoGrid.editable.options.model;
        model.set("RisDate", risDate);
        model.set("RisNo", dataItem.RisNo);
        model.set("Fund", dataItem.Fund);
        model.set("FPP", dataItem.FPP);
        model.set("Department", dataItem.Department);
        model.set("Section", dataItem.Section);
        model.set("Purpose", dataItem.Purpose);
        model.set("RequestedBy", dataItem.ApprovedBy);
        model.set("RequestedDesig", dataItem.ApprovedByDesignation);
    }


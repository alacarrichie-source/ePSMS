    $(".k-grid-btnSubmitPR").click(function (e) {
        e.preventDefault();
        if (submittedBy) {
            alert("Request already posted by " + submittedBy);
        }
        else {
            var msg = "Post PR Number " + selectedPrNo + "?";

            if (confirm(msg)) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("PostRequest", "Requests")',
                    data: { requestId: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                    }
                });
            }
        }
    });

    $(".k-grid-btnUnpostPR").click(function (e) {
        e.preventDefault();
        var msg = "Unpost PR Number " + selectedPrNo + "?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UnpostRequest", "Requests")',
                data: { requestId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    $(".k-grid-btnPrintPR").click(function (e) {
        e.preventDefault();
        var url = '@Url.Action("PurchaseRequestRpt", "Requests")?prNo=' + selectedPrNo;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    });

    $(".k-grid-btnAddRequestItem").click(function (e) {
        e.preventDefault();
        alert('x');
        RequestItem("A", null);
    });

    function onClickBtnAddRequestItem(e) {
        e.preventDefault();
        alert('x');
        RequestItem("A", null);
    }
    
    function onClickBtnEditRequestItem(e) {
        e.preventDefault();
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        RequestItem("E", dataItem.Id);
    }

    function RequestItem(mode, recId) {
        var myTitle = (mode == "A") ? "Request Item - ADD" : "Request Item - EDIT";
        var width = 800;
        var height = 550;
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#grid").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width,
            height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_RequestItemAddEdit", "Requests")',
            data: {
                requestItemId: recId
            }
        });
        mywindow.center();
        mywindow.open();

    }
</script>



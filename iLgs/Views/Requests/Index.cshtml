@{
    ViewBag.Title = "Purchase Request";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}


@(Html.Kendo().Grid<iLgs.Models.RequestVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PrNo).Width(70);
        col.Bound(c => c.PrDate).Width(70);
        col.Bound(c => c.Fund).Width(70);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.FPP).Width(70);
        col.Bound(c => c.RequestedBy).Width(100);
        col.Bound(c => c.Availability).Width(100);
        col.Bound(c => c.ApprovedBy).Width(100);
        col.Bound(c => c.SubmittedBy).Width(100);
        col.Command(command =>
        {
            command.Custom("Edit");
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Request");
        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrintPR").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnSubmitPR").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpostPR").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RequestTemplate").Window(w => w.Width(800).Title("Purchase Request")))
    .Search(s =>
    {
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.FPP, "contains");
        s.Field(o => o.RequestedBy, "contains");
        s.Field(o => o.Availability, "contains");
        s.Field(o => o.ApprovedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("RequestRead", "Requests"))
        .Create(create => create.Action("RequestCreate", "Requests"))
        .Update(update => update.Action("RequestUpdate", "Requests"))
        .Destroy(destroy => destroy.Action("RequestDestroy", "Requests"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.RequestItemVM>()
        .Name("gridItems_#=Id#")
        .Columns(columns =>
        {
            columns.Bound(o => o.PsCode).Width(70);
            columns.Bound(o => o.PsUnit).Width(70);
            columns.Bound(o => o.PsItem).Width(70);
            columns.Bound(o => o.Description).Width(150);
            columns.Bound(o => o.Qty).Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Bound(o => o.UnitCost).Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Bound(o => o.TotalCost).Width(70)
                .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });
            columns.Command(command =>
            {
                command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditRequestItem");
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            }).Width(172);
        })
        .ToolBar(toolbar =>
        {
          toolbar.Custom().Text("Add Request Item").IconClass("k-icon k-i-add").Name("btnAddRequestItem").HtmlAttributes(new { href = "" });
        @*toolbar.Template(@<text>
            @(Html.Kendo().Button().Name("btnAddRequestItem").Content("New Record")
                .Events(e => e.Click("onClickBtnAddRequestItem"))
            )
        </text>);*@
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        //.Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();
                a.Add(p => p.TotalCost).Sum();
            })
            .Read(read => read.Action("_RequestItemRead", "Requests", new { prId = "#=Id#" }))
            .Create(create => create.Action("_RequestItemCreate", "Requests", new { prId = "#=Id#" }))
            .Update(update => update.Action("_RequestItemUpdate", "Requests"))
            .Destroy(destroy => destroy.Action("_RequestItemDestroy", "Requests"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
        .AutoBind(true)
        .ToClientTemplate()
    )
</script>


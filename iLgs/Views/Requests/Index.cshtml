<script type="text/javascript">
    var purchaseRequestPrintUrl = '@Url.Action("PurchaseRequestRpt", "Requests")';
    var purchaseRequestReviewUrl = '@Url.Action("Review", "Requests")';
    var startRevisionUrl = '@Url.Action("StartRevision", "Procurement")';
    var postPurchaseRequestUrl = '@Url.Action("PostPurchaseRequest", "Requests")';
    var returnForRevisionUrl = '@Url.Action("ReturnForRevision", "Requests")';
    var resubmitRequestUrl = '@Url.Action("ResubmitRequest", "Requests")';
    var isPrReviewMode = @Html.Raw(Json.Encode(ViewBag.IsSubmitted == true));
    var reviewRequestId = null;

    function renderPrStatus(status) {
        var value = status || "Draft";
        var cssClass = value === "Posted"
            ? "status-posted"
                : (value === "Submitted"
                ? "status-submitted"
                : (value === "Returned" ? "status-returned" : (value === "Revising" ? "status-revising" : "status-draft")));

        return "<span class='status-badge " + cssClass + "'>" +
            kendo.htmlEncode(value) + "</span>";
    }

    function renderPrActions(item) {
        var id = item.Id;
        var html = "<div class='pr-row-actions'>";

        if (item.Status === "Draft") {
            html += "<button type='button' class='k-button k-button-sm k-button-solid-primary' " +
                "onclick=\"editPurchaseRequest('" + id + "')\">Continue</button>";
        } else if (item.Status === "Returned" && !isPrReviewMode) {
            html += "<button type='button' class='k-button k-button-sm k-button-solid-primary' " +
                "onclick=\"startPurchaseRequestRevision('" + id + "')\">Revise PR</button>";
            html += "<button type='button' class='k-button k-button-sm k-button-flat-primary' " +
                "title='Review Comment' onclick=\"showReturnComment('" + id + "')\">" +
                "<span class='k-icon k-i-comment'></span></button>";
        } else if (item.Status === "Revising" && !isPrReviewMode) {
            html += "<button type='button' class='k-button k-button-sm k-button-solid-primary' " +
                "onclick=\"startPurchaseRequestRevision('" + id + "')\">Continue Revision</button>";
        } else if (item.Status === "Submitted" && isPrReviewMode) {
            html += "<button type='button' class='k-button k-button-sm k-button-solid-primary' " +
                "onclick=\"openPurchaseRequestReview('" + id + "')\"><span class='k-icon k-i-eye'></span> Review</button>";
        }

        if (!(item.Status === "Submitted" && isPrReviewMode)) {
            html += "<button type='button' class='k-button k-button-sm k-button-flat-primary' " +
                "title='View Details' onclick=\"viewPurchaseRequest('" + id + "')\">" +
                "<span class='k-icon k-i-eye'></span></button>";
        }

        if (item.Status !== "Draft" && item.Status !== "Returned") {
            html += "<button type='button' class='k-button k-button-sm k-button-flat-secondary' " +
                "title='Print Purchase Request' onclick=\"printPurchaseRequest('" + id + "')\">" +
                "<span class='k-icon k-i-print'></span></button>";
        } else if (item.Status === "Draft") {
            html += "<button type='button' class='k-button k-button-sm k-button-flat-secondary' " +
                "title='Delete Draft' onclick=\"deletePurchaseRequest('" + id + "')\">" +
                "<span class='k-icon k-i-close'></span></button>";
        }

        return html + "</div>";
    }

    function getPurchaseRequestRow(id) {
        var grid = $("#grid").data("kendoGrid");
        var item = grid ? grid.dataSource.get(id) : null;
        return item ? { grid: grid, item: item, row: grid.tbody.find("tr[data-uid='" + item.uid + "']") } : null;
    }

    function viewPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target) return;
        target.grid.select(target.row);
        target.grid.expandRow(target.row);
    }

    function editPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target || (target.item.Status !== "Draft" && target.item.Status !== "Returned")) return;
        target.grid.select(target.row);
        target.grid.editRow(target.row);
    }

    function startPurchaseRequestRevision(id) {
        $.ajax({ url: startRevisionUrl, type: "POST", data: {
            __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(), id: id
        }}).done(function (result) {
            if (result.success) window.location.href = result.redirectUrl;
            else if (window.kendo && kendo.alert) kendo.alert(kendo.htmlEncode(result.message || "The revision could not be started."));
        }).fail(function () {
            if (window.kendo && kendo.alert) kendo.alert("The revision could not be started.");
        });
    }

    function continuePurchaseRequestRevision() {
        window.location.href = '@Url.Action("Cart", "Procurement")';
    }

    function deletePurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target || target.item.Status !== "Draft") return;
        if (!window.confirm("Delete this draft Purchase Request?")) return;
        target.grid.dataSource.remove(target.item);
        target.grid.dataSource.sync();
    }

    function printPurchaseRequest(id) {
        var target = getPurchaseRequestRow(id);
        if (!target || !target.item.CtrlNo) return;
        window.open(purchaseRequestPrintUrl + "?ctrlNo=" +
            encodeURIComponent(target.item.CtrlNo), "_blank");
    }

    function openPurchaseRequestReview(id) {
        reviewRequestId = id;
        var wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        if (!wnd) {
            $("#purchaseRequestReviewWindow").kendoWindow({
                title: "Review Purchase Request", width: "94%", height: "86%", modal: true,
                visible: false, actions: ["Maximize", "Close"], refresh: function () { this.center(); }
            });
            wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        }
        wnd.content("<div class='pr-review-loading'>Loading Purchase Request...</div>");
        wnd.center().open();
        wnd.refresh({ url: purchaseRequestReviewUrl, data: { id: id } });
    }

    function closePurchaseRequestReview() {
        var wnd = $("#purchaseRequestReviewWindow").data("kendoWindow");
        if (wnd) wnd.close();
        reviewRequestId = null;
    }

    function openReviewPostDialog() {
        $("#reviewPostError").text("");
        var target = getPurchaseRequestRow(reviewRequestId);
        $("#reviewPostPrNumber").val(target && target.item.PrNo ? target.item.PrNo : "");
        var datePicker = $("#reviewPostPrDate").data("kendoDatePicker");
        if (!datePicker) { $("#reviewPostPrDate").kendoDatePicker({ format: "MM/dd/yyyy" }); datePicker = $("#reviewPostPrDate").data("kendoDatePicker"); }
        datePicker.value(target && target.item.PrDate ? target.item.PrDate : new Date());
        var wnd = ensureReviewDialog("#postPurchaseRequestWindow", "Post Purchase Request", 500);
        wnd.center().open();
    }

    function closeReviewPostDialog() {
        var wnd = $("#postPurchaseRequestWindow").data("kendoWindow");
        if (wnd) wnd.close();
    }

    function openReviewReturnDialog() {
        $("#returnRevisionRemarks").val("");
        $("#returnRevisionError").text("");
        var wnd = ensureReviewDialog("#returnForRevisionWindow", "Return Purchase Request for Revision", 520);
        wnd.center().open();
    }

    function ensureReviewDialog(selector, title, width) {
        var wnd = $(selector).data("kendoWindow");
        if (!wnd) { $(selector).kendoWindow({ title: title, width: width + "px", modal: true, visible: false, actions: ["Close"] }); wnd = $(selector).data("kendoWindow"); }
        return wnd;
    }

    function closeReturnForRevision() {
        var wnd = $("#returnForRevisionWindow").data("kendoWindow");
        if (wnd) wnd.close();
    }

    function setReviewButtonBusy(selector, busy) {
        $(selector).prop("disabled", busy).toggleClass("k-disabled", busy);
    }

    function completeReviewAction() {
        closeReviewPostDialog();
        closeReturnForRevision();
        closePurchaseRequestReview();
        var grid = $("#grid").data("kendoGrid");
        if (grid) grid.dataSource.read();
    }

    function submitReviewPost() {
        var prNumber = $.trim($("#reviewPostPrNumber").val());
        var datePicker = $("#reviewPostPrDate").data("kendoDatePicker");
        var prDate = datePicker ? datePicker.value() : null;
        if (!prNumber || !prDate) { $("#reviewPostError").text("PR Number and PR Date are required."); return; }
        setReviewButtonBusy("#confirmReviewPost", true);
        $.ajax({ url: postPurchaseRequestUrl, type: "POST", data: {
            __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
            RequestId: reviewRequestId, PrNumber: prNumber, PrDate: kendo.toString(prDate, "yyyy-MM-dd")
        }}).done(function (result) {
            if (result.success) completeReviewAction();
            else $("#reviewPostError").text(result.message || "The Purchase Request could not be posted.");
        }).fail(function () { $("#reviewPostError").text("The Purchase Request could not be posted."); })
          .always(function () { setReviewButtonBusy("#confirmReviewPost", false); });
    }

    function submitReturnForRevision() {
        var remarks = $.trim($("#returnRevisionRemarks").val());
        if (!remarks) {
            $("#returnRevisionError").text("A review comment is required.");
            $("#returnRevisionRemarks").focus();
            return;
        }

        setReviewButtonBusy("#confirmReturnForRevision", true);
        $.ajax({
            url: returnForRevisionUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                RequestId: reviewRequestId,
                ReviewComment: remarks
            }
        }).done(function (result) {
            if (!result.success) {
                $("#returnRevisionError").text(result.message || "The Purchase Request could not be returned.");
                return;
            }

            completeReviewAction();
        }).fail(function () {
            $("#returnRevisionError").text("The Purchase Request could not be returned.");
        }).always(function () { setReviewButtonBusy("#confirmReturnForRevision", false); });
    }

    function resubmitPurchaseRequest(id) {
        if (!window.confirm("Resubmit this revised Purchase Request for review?")) return;

        $.ajax({
            url: resubmitRequestUrl,
            type: "POST",
            data: {
                __RequestVerificationToken: $("input[name='__RequestVerificationToken']").val(),
                requestId: id
            }
        }).done(function (result) {
            if (!result.success) {
                window.alert(result.message || "The Purchase Request could not be resubmitted.");
                return;
            }

            $("#grid").data("kendoGrid").dataSource.read();
        }).fail(function () {
            window.alert("The Purchase Request could not be resubmitted.");
        });
    }

    function showReturnComment(id) {
        var target = getPurchaseRequestRow(id);
        if (!target) return;
        var message = target.item.StatusRemarks || "No review comment was recorded.";

        if (window.kendo && kendo.alert) {
            kendo.alert("<strong>Review comment</strong><br><br>" + kendo.htmlEncode(message));
        } else {
            window.alert(message);
        }
    }

    function applyPrFilters() {
        var grid = $("#grid").data("kendoGrid");
        if (!grid) return;

        var query = $.trim($("#searchPR").val());
        var status = $("#prStatusFilter").val();
        var filters = [];

        if (query) {
            filters.push({
                logic: "or",
                filters: [
                    { field: "PrNo", operator: "contains", value: query },
                    { field: "CtrlNo", operator: "contains", value: query },
                    { field: "Department", operator: "contains", value: query },
                    { field: "Purpose", operator: "contains", value: query },
                    { field: "Fund", operator: "contains", value: query }
                ]
            });
        }

        if (status) filters.push({ field: "Status", operator: "eq", value: status });
        grid.dataSource.filter(filters.length ? { logic: "and", filters: filters } : {});
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function getQtySumExcludingSet() {
        var grid = $("#gridItems_" + selectedId).data("kendoGrid");
        var data = grid.dataSource.view();

        var total = 0;

        for (var i = 0; i < data.length; i++) {
            if (data[i].ItemNo && !data[i].ItemNo.includes(".")) {
                total += data[i].Qty || 0;
            }
        }

        return total;
    }

    function getTotalCostSumExcludingSet() {
        var grid = $("#gridItems_" + selectedId).data("kendoGrid");
        var data = grid.dataSource.view();

        var total = 0;

        for (var i = 0; i < data.length; i++) {
            if (data[i].ItemNo && !data[i].ItemNo.includes(".")) {
                total += data[i].TotalCost || 0;
            }
        }

        return total;
    }


    function onSelectTabStrip(e) {
        var tabStrip = this;
        for (var idx = 0; ; ++idx) {
            var tab = tabStrip.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    //$(window).on("resize", function () {
    //    var gridElement = $("#grid"),
    //        dataArea = gridElement.find(".k-grid-content"),
    //        gridHeight = gridElement.innerHeight(),
    //        otherElements = gridElement.children().not(".k-grid-content"),
    //        otherElementsHeight = 0;
    //        otherElements.each(function () {
    //            otherElementsHeight += $(this).outerHeight();
    //        });
    //    dataArea.height(gridHeight - otherElementsHeight);
    //});

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');

                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");

                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var submittedBy = null;
    var postedBy = null;
    var selectedPrNo = null;
    var selectedCtrlNo = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedItemId = null;
        submittedBy = selectedData.SubmittedBy;
        postedBy = selectedData.PostedBy;
        selectedPrNo = selectedData.PrNo;
        selectedCtrlNo = selectedData.CtrlNo;

        if (postedBy) {
            $(".k-grid-btnUnpostPR", grid).show();
            $(".k-grid-btnPostPR", grid).hide();
            $(".k-grid-btnSubmitPR", grid).hide();
            $(".k-grid-btnUnsubmitPR", grid).hide();
        } else {
            if (submittedBy) {
                $(".k-grid-btnUnsubmitPR", grid).show();
                $(".k-grid-btnSubmitPR", grid).hide();

                $(".k-grid-btnUnpostPR", grid).hide();
                $(".k-grid-btnPostPR", grid).show();
            } else {
                $(".k-grid-btnUnsubmitPR", grid).hide();
                $(".k-grid-btnSubmitPR", grid).show();

                $(".k-grid-btnUnpostPR", grid).hide();
                $(".k-grid-btnPostPR", grid).hide();
            }
        }

        @*var isSubmitted = @Html.Raw(Json.Encode(ViewBag.IsSubmitted ?? false));
        if (isSubmitted || postedBy) {
            $(".k-grid-btnPrintPR", grid).show();
        }
        else {
            $(".k-grid-btnPrintPR", grid).hide();
        }*@
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row

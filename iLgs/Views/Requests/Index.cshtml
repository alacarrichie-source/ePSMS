@{
    var isSubmittedMode = ViewBag.IsSubmitted == true;
    ViewBag.Title = isSubmittedMode ? "Purchase Request Posting & Review" : "Purchase Requests";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="epsms-procurement pr-index-page">
    @Html.AntiForgeryToken()

    <div class="header-bar">
        <div>
            <div class="pr-breadcrumbs">
                <span>Procurement</span> &gt;
                <span>@(isSubmittedMode ? "Posting & Review" : "Purchase Requests")</span>
                @if (isSubmittedMode)
                {
                    <span class="pr-mode-badge">Posting Queue</span>
                }
            </div>
            <h1>@(isSubmittedMode ? "Purchase Request Posting & Review" : "Purchase Requests")</h1>
            <p class="subtitle">
                @(isSubmittedMode
                    ? "Review verified requisitions, return items for corrections, or assign official PR numbers and post."
                    : "Create, review, track, and manage departmental purchase requests.")
            </p>
        </div>
        <div class="action-toolbar">
            @if (!isSubmittedMode)
            {
                <a href="@Url.Action("Annual", "Procurement")" class="k-button k-button-solid-primary k-rounded-md">
                    <span class="k-icon k-i-plus"></span> Create a New PR
                </a>
            }
            <button type="button" class="k-button k-button-solid-base k-rounded-md" onclick="refreshPrGrid()" title="Refresh grid data">
                <span class="k-icon k-i-reload"></span> Refresh
            </button>
        </div>
    </div>

    <!-- Filter Panel with Quick Filters -->
    <div class="filter-panel pr-filter-panel">
        <div class="pr-filter-row">
            <div class="pr-filter-search">
                <label for="searchPR">Quick Search</label>
                <div class="pr-search-wrapper">
                    <span class="k-icon k-i-search pr-search-icon"></span>
                    <input id="searchPR" type="text" class="form-control-custom pr-search-input"
                           placeholder="Search by PR#, Ctrl#, department, purpose, fund, creator..." />
                </div>
            </div>
            <div class="pr-filter-dept">
                <label for="prDeptFilter">Department</label>
                <select id="prDeptFilter" class="form-control-custom" onchange="applyPrFilters()">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="pr-filter-status">
                <label for="prStatusFilter">Status Filter</label>
                <select id="prStatusFilter" class="form-control-custom" onchange="onStatusFilterChange()">
                    <option value="">All Statuses</option>
                    <option value="Draft">Draft</option>
                    <option value="Submitted">Submitted</option>
                    <option value="Returned">Returned</option>
                    <option value="Revising">Revising</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
            <div class="pr-filter-actions">
                <button type="button" class="k-button k-button-solid-base pr-btn-reset" onclick="resetPrFilters()" title="Clear all filters">
                    <span class="k-icon k-i-reset"></span> Reset
                </button>
            </div>
        </div>
        <div class="pr-quick-pills">
            <span class="pr-pill-label">Quick Filter:</span>
            <button type="button" class="pr-pill active" data-status="" onclick="filterByStatusPill('')">All (<span id="pillCountAll">0</span>)</button>
            <button type="button" class="pr-pill" data-status="Draft" onclick="filterByStatusPill('Draft')">Draft (<span id="pillCountDraft">0</span>)</button>
            <button type="button" class="pr-pill" data-status="Submitted" onclick="filterByStatusPill('Submitted')">Submitted (<span id="pillCountSubmitted">0</span>)</button>
            <button type="button" class="pr-pill" data-status="Returned" onclick="filterByStatusPill('Returned')">Returned (<span id="pillCountReturned">0</span>)</button>
            <button type="button" class="pr-pill" data-status="Posted" onclick="filterByStatusPill('Posted')">Posted (<span id="pillCountPosted">0</span>)</button>
        </div>
    </div>

    <!-- Data Card with Kendo Grid -->
    <div class="data-card">
@(Html.Kendo().Grid<iLgs.Models.RequestVM>()
        .Name("grid")
        .HtmlAttributes(new { @class = "pr-directory-grid" })
        .Columns(col =>
        {
            col.Bound(c => c.PrNo).Title("PR / Ctrl No.").Width(150)
                .ClientTemplate(
                    "<div class='pr-number-col'>" +
                        "<a href='javascript:void(0)' class='pr-number-link' onclick=\"viewPurchaseRequest('#=Id#')\">" +
                            "# if (PrNo) { #" +
                                "<span class='pr-no-text'>#= kendo.htmlEncode(PrNo) #</span>" +
                            "# } else { #" +
                                "<span class='pr-no-draft'>Unnumbered</span>" +
                            "# } #" +
                        "</a>" +
                        "<span class='pr-ctrl-sub'>Ctrl: #= kendo.htmlEncode(CtrlNo || '-') #</span>" +
                    "</div>"
                );            
            col.Bound(c => c.Department).Title("Department & Fund").Width(190)
                .ClientTemplate(
                    "<div class='pr-dept-col'>" +
                        "<span class='pr-dept-name' title='#= kendo.htmlEncode(Department || '') #'>#= kendo.htmlEncode(Department || '-') #</span>" +
                        "<span class='pr-fund-sub'>#= kendo.htmlEncode(Fund || '') #</span>" +
                    "</div>"
                );
            col.Bound(c => c.Purpose).Title("Purpose").Width(260)
                .ClientTemplate("<span class='pr-purpose' title='#=kendo.htmlEncode(Purpose || \'\')#'>#=kendo.htmlEncode(Purpose || '')#</span>");
            col.Bound(c => c.TotalAmount).Title("Items & Amount").Width(150)
                .HtmlAttributes(new { @class = "text-right" })
                .HeaderHtmlAttributes(new { @class = "text-right" })
                .ClientTemplate(
                    "<div class='pr-amount-col text-right'>" +
                        "<span class='pr-amount-text font-weight-bold'>#= kendo.toString(TotalAmount, 'n2') #</span>" +
                        "<span class='pr-items-sub'>#= ItemCount # #= ItemCount === 1 ? 'item' : 'items' #</span>" +
                    "</div>"
                );
            col.Bound(c => c.PrDate).Title("Date & Creator").Width(140)
                .ClientTemplate(
                    "<div class='pr-date-col'>" +
                        "<span class='pr-date-text font-weight-bold'>#= InsertedDt ? kendo.toString(InsertedDt, 'MMM dd, yyyy') : '-' #</span>" +
                        "<span class='pr-creator-sub'>by #= kendo.htmlEncode(InsertedBy || '-') #</span>" +
                    "</div>"
                );
            col.Bound(c => c.Status).Title("Status").Width(120)
                .HtmlAttributes(new { @class = "text-center" })
                .HeaderHtmlAttributes(new { @class = "text-center" })
                .ClientTemplate("#=renderPrStatus(Status)#");
            col.Bound(c => c.Id).Title("Actions").Width(190)
                .Sortable(false).Filterable(false)
                .HtmlAttributes(new { @class = "text-right" })
                .HeaderHtmlAttributes(new { @class = "text-right" })
                .ClientTemplate("#=renderPrActions(data)#");
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RequestTemplate").Window(w => w.Width(800).Title("Purchase Request")))
        .Pageable(pager => pager
            .Refresh(true)
            .PageSizes(new[] { 10, 20, 50, 100 })
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords(n => n.Template(
            "<div class='pr-empty-state'>" +
                "<span class='k-icon k-i-folder-open pr-empty-icon'></span>" +
                "<h3>No Purchase Requests found</h3>" +
                "<p>No records match your search query or selected status filter.</p>" +
                "<button type='button' class='k-button k-button-solid-base k-rounded-md' onclick='resetPrFilters()'>Reset Filters</button>" +
            "</div>"
        ))
        .Resizable(r => r.Columns(true))
        .Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Sort(s => s.Add(a => a.InsertedDt).Descending())
            .Read(read => read.Action("RequestRead", "Requests", new { isSubmitted = ViewBag.IsSubmitted }))
            .Update(update => update.Action("RequestUpdate", "Requests"))
            .Destroy(destroy => destroy.Action("RequestDestroy", "Requests"))
        )
        .Events(events => events
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        )
)
    </div>
</div>

<!-- Review PR Modal Window -->
<div id="purchaseRequestReviewWindow" style="display:none;"></div>

<!-- Post PR Confirmation Modal Window -->
<div id="postPurchaseRequestWindow" style="display:none;">
    <div class="pr-return-form">
        <p>Confirm the official Purchase Request number and date before posting.</p>
        <label for="reviewPostPrNumber">PR Number</label>
        <input id="reviewPostPrNumber" class="k-textbox" maxlength="50" style="width:100%;" placeholder="Auto-generate" />
        <label for="reviewPostPrDate">PR Date <span class="text-danger">*</span></label>
        <input id="reviewPostPrDate" style="width:100%;" />
        <div id="reviewPostError" class="text-danger" role="alert"></div>
        <div class="pr-return-actions">
            <button type="button" class="k-button" onclick="closeReviewPostDialog()">Cancel</button>
            <button id="confirmReviewPost" type="button" class="k-button k-button-solid-primary" onclick="submitReviewPost()">Confirm Post</button>
        </div>
    </div>
</div>

<!-- Return PR for Revision Modal Window -->
<div id="returnForRevisionWindow" style="display:none;">
    <div class="pr-return-form">
        <p>Explain the corrections required before this Purchase Request can be resubmitted.</p>
        <label for="returnRevisionRemarks">Review comment <span class="text-danger">*</span></label>
        <textarea id="returnRevisionRemarks" class="k-textbox" rows="6" maxlength="1000"></textarea>
        <div id="returnRevisionError" class="text-danger" role="alert"></div>
        <div class="pr-return-actions">
            <button type="button" class="k-button" onclick="closeReturnForRevision()">Cancel</button>
            <button id="confirmReturnForRevision" type="button" class="k-button k-button-solid-primary" onclick="submitReturnForRevision()">
                Return for Revision
            </button>
        </div>
    </div>
</div>

<!-- Master-Detail Template -->
<script id="Details" type="text/kendo-tmpl">
    # if (StatusRemarks && Status === "Returned") { #
    <div class="pr-detail-returned-alert">
        <span class="k-icon k-i-warning pr-alert-icon"></span>
        <div>
            <strong>Review Comment / Reason for Return:</strong>
            <p>#= kendo.htmlEncode(StatusRemarks) #</p>
        </div>
    </div>
    # } #
    <div class="pr-detail-wrapper">
        @(Html.Kendo().TabStrip()
                .Name("tabStrip_#=Id#")
                .HtmlAttributes(new { @class = "pr-clean-tabstrip" })
                .TabPosition(TabStripTabPosition.Top)
                .Animation(animation =>
                {
                    animation.Open(config =>
                    {
                        config.Fade(FadeDirection.In);
                    });
                })
                .Events(e => e.Select("onSelectTabStrip"))
                .SelectedIndex(0)
                .Items(items =>
                {
                    items.Add().Text("Requisition Items")
                        .Selected(true)
                        .LoadContentFrom("_RequestItem", "Requests", new { requestId = "#=Id#" });
                }).ToClientTemplate())
    </div>
</script>

<div id="windowcontainer"></div>


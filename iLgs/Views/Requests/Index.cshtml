@{
    ViewBag.Title = "Purchase Request";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.RequestVM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.PrNo).Width(70);
        col.Bound(c => c.PrDate).Width(100);
        col.Bound(c => c.Fund).Width(100);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.FPP).Width(100);
        col.Bound(c => c.RequestedBy).Width(100);
        col.Bound(c => c.Availability).Width(100);
        col.Bound(c => c.ApprovedBy).Width(100);
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Request");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RequestTemplate").Window(w => w.Width(800).Title("Purchase Request")))        
    .Search(s =>
    {
        s.Field(o => o.PrNo, "contains");
        s.Field(o => o.Fund, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.FPP, "contains");
        s.Field(o => o.RequestedBy, "contains");
        s.Field(o => o.Availability, "contains");
        s.Field(o => o.ApprovedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(200))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("RequestRead", "Requests"))
        .Create(create => create.Action("RequestCreate", "Requests"))
        .Update(update => update.Action("RequestUpdate", "Requests"))
        .Destroy(destroy => destroy.Action("RequestDestroy", "Requests"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )
</div>

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.RequestItemVM>()
        .Name("gridItems")
        .Columns(columns =>
        {
            columns.Bound(o => o.PsCode).Width(70);
            columns.Bound(o => o.PsUnit).Width(70);
            columns.Bound(o => o.PsItem).Width(70);
            columns.Bound(o => o.Description).Width(150);
            columns.Bound(o => o.Qty).Width(70);
            columns.Bound(o => o.UnitCost).Width(70);
            columns.Bound(o => o.TotalCost).Width(70);            
            columns.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add Request Item");            
        })        
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_RequestItemTemplate").Window(w => w.Width(500).Title("Request Item")))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Read(read => read.Action("_RequestItemRead", "Requests").Data("ItemData"))
            .Create(create => create.Action("_RequestItemCreate", "Requests").Data("ItemData"))
            .Update(update => update.Action("_RequestItemUpdate", "Requests"))
            .Destroy(destroy => destroy.Action("_RequestItemDestroy", "Requests"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
        .AutoBind(true)
    )
</div>

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">


    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selecteItemId = null;
    
    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedItemId = null;
        $("#gridItems").data("kendoGrid").dataSource.read();
    }


    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
        //if (this.dataSource.total() == 0) {
        //   // to do: disable item add button
        //}
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }

    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }

    // Grid Item

    function ItemData() {
        return {
            prId: selectedId
        };
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selecteItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selecteItemId) {
            var dataItem = this.dataSource.get(selecteItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selecteItemId = null;
            e.model.set("PrId", selectedId);
        } else {
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            //$("#Code").attr("readonly", "readonly");
        }
    }

    function DataPsCodeId() {
        var text = $("#PsCodeId").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#PsCodeId").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    function onSelectPsCode(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#PsItem").val(dataItem.Name).trigger("change");
        $("#PsUnit").val(dataItem.Unit).trigger("change");
        $("#PsCode").val(dataItem.Code).trigger("change");
    }

    function changeAmount(e) {
        var qty = $("#Qty").data("kendoNumericTextBox").value();
        var unitCost = $("#UnitCost").data("kendoNumericTextBox").value();
        var amount = qty * unitCost;

        $("#TotalCost").data("kendoNumericTextBox").value(amount);
        $("#TotalCost").data("kendoNumericTextBox").trigger("change");
    }

    function onGridItemsRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#gridItems").data("kendoGrid").dataSource.read();
            }
        }
    }
</script>



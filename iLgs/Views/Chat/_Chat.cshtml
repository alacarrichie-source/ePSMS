@model IEnumerable<iLgs.Models.Chat>
@{
    var conversationId = ViewBag.ConversationId;
    var currentUser = User.Identity.Name;
}

<style>
    #chatContainer {
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #ccc;
        border-radius: 8px;
        overflow: hidden;
    }

    #chatWindow {
        flex: 1;
        padding: 10px;
        overflow-y: auto;
        background: #f5f5f5;
    }

    .message {
        margin: 6px 0;
        max-width: 70%;
        padding: 8px 12px;
        border-radius: 16px;
        display: inline-block;
        clear: both;
        word-wrap: break-word;
    }

    .message-left {
        float: left;
        background-color: #ffffff;
        border: 1px solid #ddd;
    }

    .message-right {
        float: right;
        background-color: #0084ff;
        color: #fff;
    }

    .meta {
        font-size: 0.75rem;
        color: #666;
        margin-top: 2px;
    }

    #chatInput {
        display: flex;
        width: 100%; /* Full width */
        border-top: 1px solid #ccc;
        background: #fff;
        padding: 8px;
        box-sizing: border-box;
    }

    #messageInput {
        flex: 1;
        border: 1px solid #ccc;
        border-radius: 20px;
        padding: 10px 14px;
        outline: none;
        margin-right: 8px;
    }

    #sendBtn {
        border: none;
        background: #0084ff;
        color: #fff;
        padding: 10px 20px;
        border-radius: 20px;
        cursor: pointer;
    }

    #sendBtn:hover {
        background: #006fd6;
    }
</style>

<div id="chatContainer">
    <div id="chatWindow">
        @foreach (var msg in Model)
        {
            var isCurrentUser = msg.AspNetUser.UserName == currentUser;
            <div class="message @(isCurrentUser ? "message-right" : "message-left")">
                @msg.Text
                <div class="meta">
                    @(!isCurrentUser ? msg.AspNetUser.UserName + " · " : "") @msg.SentAt.Value.ToShortTimeString()
                </div>
            </div>
            <div style="clear: both;"></div>
        }
    </div>

    <div id="chatInput">
        <input type="text" id="messageInput" placeholder="Type a message..." />
        <button id="sendBtn">Send</button>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var conversationId = "@ViewBag.ConversationId";
        //var chat = $.connection.chatHub;
        console.log("Conversation Id " + conversationId);
        console.log(chatHub);

        // Join conversation when hub is already connected
        if ($.connection.hub.state === $.signalR.connectionState.connected) {
            chatHub.server.joinConversation(conversationId);
            console.log("Joining group (already connected): " + conversationId);
            console.log("ChatHub client:", chatHub.client);
            console.log("ChatHub server:", chatHub.server);
            chatHub.server.send("drahxir", "Hello world!");
        } else {
            // Or wait until hub connects
            $.connection.hub.start().done(function () {
                console.log("Joining group after start: " + conversationId);
                chatHub.server.joinConversation(conversationId);
            });
        }

        var chatWindow = $("#chatWindow");
        chatWindow.scrollTop(chatWindow[0].scrollHeight);

        // Send message
        $("#sendBtn").click(function () {
            var text = $("#messageInput").val();
            if (!text) return;

            $.post("@Url.Action("Send", "Chat")",
                {
                    conversationId: conversationId,
                    text: text,
                    notificationName: "@ViewBag.NotificationName",
                    notificationMessage: "@ViewBag.NotificationMessage"
                }
            );

            $("#messageInput").val("");
        });
    });
</script>

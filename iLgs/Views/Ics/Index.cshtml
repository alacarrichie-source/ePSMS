    function onGridItemClickAdd(e) {
        e.preventDefault();
        var cardItemId = $(e.sender.element).data("carditemid");
        selectedGrid = $("#gridIssuedItems_" + cardItemId).data("kendoGrid");
        if (selectedGrid) {
            selectedGrid.addRow();
        }

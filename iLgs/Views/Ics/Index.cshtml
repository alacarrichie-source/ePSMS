    function GeneratePar(refType, cardItemId) {
        var myTitle = refType == "P" ? "Generate PAR" : "Generate ICS";
        var width = 500;

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    //$("#grid").data("kendoGrid").dataSource.read();
                    var grid = $("#grid").data("kendoGrid");
                    grid.dataSource.read().then(function () {
                        // Additional actions to be performed after the read operation.

                        // Find the row with the specified Id.
                        var dataItem = grid.dataSource.get(selectedId);

                        // If the row is found, expand it.
                        if (dataItem) {
                            var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                            grid.expandRow(row);

                            //// Find the detail row corresponding to the current data item
                            //var detailRow = row.next(".k-detail-row");

                            //if (detailRow) {
                            //    var tabStrip = $(detailRow).find(".k-tabstrip").data("kendoTabStrip");
                            //    if (tabStrip) {
                            //        // Activate the tab based on refType (adjust as per your logic)
                            //        if (refType == "P") {
                            //            tabStrip.select(1); // Select 2nd tab (index 1)
                            //        } else {
                            //            tabStrip.select(2); // Select 3rd tab (index 2)
                            //        }
                            //    }
                            //}
                        }
                    });
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });
        mywindow.refresh({
            url: '@Url.Action("_GenerateIcs", "Ics")',
            data: {
                psCardItemId: cardItemId,
                refType: refType
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }


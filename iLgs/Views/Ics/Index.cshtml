@{
    ViewBag.Title = "Inventory Custodian Slip";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.IcsVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(columns =>
    {
        columns.Bound(f => f.Department).Width(70);
        columns.Group(group => group.Title("Reference")
            .Columns(info =>
            {
                info.Bound(f => f.PoNo).Width(50);
                info.Bound(f => f.PoDate).Width(50);
                info.Bound(f => f.AirNo).Width(50);
                info.Bound(f => f.AirDate).Width(50);
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.Qty).Width(50).Title("Quantity");
        columns.Bound(f => f.Unit).Width(50).Title("Unit of<br>Measurement");
        columns.Group(group => group.Title("Amount")
            .Columns(info =>
            {
                info.Bound(f => f.PriceRate)
                    .Width(50).Title("%")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                    //.ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.UnitCost)
                    .Width(50).Title("PO Unit<br>Cost")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
                info.Bound(f => f.Amount)
                    .Width(50).Title("Total<br>Cost")
                    .HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                    .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;" });
            }).HeaderHtmlAttributes(new { Style = "text-align:center;" })
        );
        columns.Bound(f => f.Article).Width(70).Title("Articles");
        columns.Bound(f => f.Description).Width(70).Title("Item<br>Description");
    })
    .ToolBar(t =>
    {
        //t.Custom().Text("Transfer").IconClass("k-icon k-i-add").Name("btnTransfer").HtmlAttributes(new { @class = "k-button", href = "" });
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Department, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.AirNo, "contains");
        s.Field(o => o.Article, "contains");
        s.Field(o => o.Description, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.UnitCost).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Sort(s =>
        {
            s.Add(a => a.PoNo);
        })
        .Read(read => read.Action("Read", "Ics"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            //.HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("ICS")
                    .Selected(true)
                    .LoadContentFrom("_Ics", "Ics", new { cardItemId = "#=Id#", unitCost = "#=UnitCost#" });
                items.Add().Text("Issued Items")
                    .LoadContentFrom("_Issuance", "Ics", new { cardItemId = "#=Id#" });
                //items.Add().Text("ICS")
                //    .LoadContentFrom("_Ics", "PoIssuance", new { CardItemId = "#=Id#", UnitCost = "#=UnitCost#" });
            }).ToClientTemplate())
</script>


@model iLgs.Models.AccountCodeVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="col-md-12">
            <div class="form-group">
                @Html.DisplayFor(m => m.Effectivity, "LabelDate")
                @(Html.Kendo().DatePickerFor(m => m.Effectivity)
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Effectivity)
            </div>
        </div>
    </div>

    <div class="row k-mb-2">
        <div class="col-md-12">
            <div class="form-group">
                @Html.DisplayFor(m => m.Description, "Label")
                @(Html.Kendo().TextBoxFor(m => m.Description)
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(m => m.Description)
            </div>
        </div>
    </div>
}









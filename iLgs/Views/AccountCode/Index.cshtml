<script type="text/javascript">
    $("#exportGrid").click(function (e) {
        e.preventDefault();
        $("#gridItems").data("kendoGrid").saveAsExcel();
    });

    function IsNotPostedMain(dataItem) {
        return !dataItem.PostedBy;
    }

    function IsNotPosted(dataItem) {
        return !postedBy && dataItem.Claimed != "Y";
    }

    function onChangeBirthday(e) {
        e.preventDefault();
        $.ajax({
            type: "POST",
            url: '@Url.Action("GetCurrentAge", "Getters")',
            data: { birthday: $("#Birthday").val() },
            beforeSend: function () {
                window.kendo.ui.progress($(document.body), true);
            },
            success: function (result) {
                window.kendo.ui.progress($(document.body), false);
                $("#Age").val(result.Age).trigger("change");
            },
            error: function (req, status, errorObj) {
                alert(req.responseText);
            }
        });
    }

    $(document).on("input", ".uppercase", function () {
        this.value = this.value.toUpperCase();
    });

    var showSelection = 1;
    function SelectTransaction()
    {
        // Prevent duplicate windows
        $("#windowTransaction").remove();

        $("#windowcontainer").append("<div id='windowTransaction'></div>");
        var mywindow = $("#windowTransaction")
            .kendoWindow({
                actions: ["Minimize", "Close"],
                draggable: true,
                modal: true,
                visible: false,
                close: function () {
                    $("#grid").data("kendoGrid").dataSource.read();
                },
                deactivate: function () {
                    this.destroy();
                }
            }).data("kendoWindow");
        mywindow.setOptions({
            title: "Select Transaction",
            width: "350"
        });

        mywindow.refresh({
            url: '@Url.Action("_SelectTransaction", "Application")',
            complete: function () {
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function onSelectTabStrip(e) {
        var tabStrip = this;
        for (var idx = 0; ; ++idx) {
            var tab = tabStrip.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function InlineGridError(e) {
        if (e.errors) {
            let message = "Errors:\n";

            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += (key ? key + ": " : "") + value.errors.join("\n") + "\n";
                    });
                }
            });

            alert(message); // You can replace this with any other UI method to display errors
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError" || propertyName == "AccessError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');

                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");

                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function GridItemError(args) {
        if (args.errors) {
            var validationError = true;
            var selectedGrid = $("#gridItems_" + selectedId).data("kendoGrid");
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedItemId = null;
    var trackingId = null;
    var postedBy = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        trackingId = selectedId;
        selectedItemId = null;
        //postedBy = selectedData.PostedBy;

        //if (postedBy) {
        //    $(".k-grid-btnUnpost", grid).show();
        //    $(".k-grid-btnPost", grid).hide();
        //} else {
        //    $(".k-grid-btnUnpost", grid).hide();
        //    $(".k-grid-btnPost", grid).show();
        //}

        $("#gridItems").data("kendoGrid").dataSource.read();
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        }
        else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            //// Attach a handler to the "detailExpand" event
            //this.bind("detailExpand", function (e) {
            //    // Select the expanded master row
            //    this.select(e.masterRow);
            //});
        }
        var grid = $("#grid");
        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrint", grid).hide();
            //$(".k-grid-btnPost", grid).hide();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }

        trackingId = selectedId;
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedGrid.removeRow(tr);
    }

    $(".k-grid-btnPost").click(function (e) {
        e.preventDefault();
        if (postedBy) {
            alert("Request already posted by " + postedBy);
        }
        else {
            var msg = "Post the selected record?";

            if (confirm(msg)) {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "AccountCode")',
                    data: { accountCodeId: selectedId },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            alert(result.Errors);
                        }
                    },
                    error: function (req, status, errorObj) {
                        alert(req.responseText);
                    }
                });
            }
        }
    });

    $(".k-grid-btnUnpost").click(function (e) {
        e.preventDefault();
        var msg = "Unpost the selected record?";

        if (confirm(msg)) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Unpost", "AccountCode")',
                data: { accountCodeId: selectedId },
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($(document.body), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($(document.body), false);
                    if (result.Errors == "") {
                        $("#grid").data("kendoGrid").dataSource.read();
                    } else {
                        alert(result.Errors);
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
        }
    });

    function onRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
                trackingId = selectedId;
            }
        }
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        const grid = $(e.currentTarget).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;

        const tr = $(e.currentTarget).closest("tr");
        const dataItem = grid.dataItem(tr);

        // Confirm deletion
        if (confirm(`Are you sure you want to delete this record?`)) {
            grid.select(tr);
            grid.dataSource.remove(dataItem); // Triggers the Destroy action
            grid.dataSource.sync(); // Send the delete request to the server
        }
    }
    // end transaction.cshtml


    // GRID ITEMS
    function DataGridItems() {
        return {
            accountCodeId: selectedId
        }
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());

        selectedItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        var grid = this;
        if (selectedItemId) {
            var dataItem = grid.dataSource.get(selectedItemId);
            if (dataItem) {
                grid.select($('[data-uid=' + dataItem.uid + ']'));
            }
        }

        //grid.tbody.find(">tr").each(function () {
        //    var dataItem = grid.dataItem(this);
        //    if (dataItem.Type == "M") {
        //        $(this).css("font-weight", "bold");
        //    } else {
        //        //$(this).css("font-style", "italic");
        //        $(this).css("font-weight", "normal");
        //    }
        //});
    }

    function onEditGridItems(e) {
        e.preventDefault();

        selectedGrid = e.sender;
        if (!e.model.isNew()) {             
            selecteItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selecteItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
            e.model.set("AccountCodeId", selectedId);
            e.model.set("AccountCodeItemId", e.model.get("Id"));
        }

        //trackingId = selectedItemId;
    }


    // END GRID ITEMS
</script>






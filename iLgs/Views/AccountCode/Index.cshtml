@{
    //ViewBag.Title = "Account Codes";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().PanelBar()
    .Name("panelbar")
    .ExpandMode(PanelBarExpandMode.Multiple)
    .Items(panelbar =>
    {
        panelbar.Add().Text("Effectivity")
            .Expanded(true)
            .Selected(true)
            .Content(@<text>
                <div class="div-render">
                    @RenderMain()
                </div>
            </text>);
        panelbar.Add().Text("Items")
            .Expanded(true)
            .Content(@<text>
                <div class="div-render">
                    @RenderItems()
                </div>
            </text>);
    })
)

@helper RenderMain()
{
    @(Html.Kendo().Grid<iLgs.Models.AccountCodeVM>()
        .Name("grid")
        .HtmlAttributes(new { style = "height: calc(25vh);" })
        .Columns(col =>
        {
            col.Bound(c => c.Effectivity).Width(30);
            col.Bound(c => c.Description).Width(50);
            col.Bound(c => c.UpdatedBy).Width(30);
            col.Bound(c => c.UpdatedDt).Width(50);
            col.Command(command =>
            {
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true); //.Visible("IsNotPostedMain");
            }).Width(50);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add New Record");
            //t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost").HtmlAttributes(new { @class = "k-button", href = "" });
            //t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Search();
        })
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AccountCodeTemplate").Window(w => w.Width("30%").Title("Account Code Setup")))
        .Search(s =>
        {
            s.Field(o => o.Description, "equals");
            s.Field(o => o.UpdatedBy, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Resizable(r => r.Columns(true))
        .Filterable()
        .Sortable()
        .Scrollable()
        .NoRecords()
        //.ClientDetailTemplateId("Users")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                model.Field(p => p.Type).DefaultValue(@ViewBag.Type).Editable(false);
            })
            .Read(read => read.Action("Read", "AccountCode", new { type = @ViewBag.Type}))
            .Create(create => create.Action("Create", "AccountCode"))
            .Update(update => update.Action("Update", "AccountCode"))
            .Destroy(destroy => destroy.Action("Destroy", "AccountCode"))
        ).AutoBind(true)
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(e => e
            .Change("onChangeGrid")
            .Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
        )
    )
}

@helper RenderItems()
{
    @(Html.Kendo().Grid<iLgs.Models.ItemTypeAccountVM>()
        .Name("gridItems")
        .HtmlAttributes(new { style = "height: calc(51vh);" })
        .Columns(col =>
        {
            col.Bound(c => c.Category).Width(30);
            col.Bound(c => c.Code).Width(50);
            col.Bound(c => c.Description).Width(100);
            col.Bound(c => c.GroupCode).Width(50);
            col.Bound(c => c.AccountItemCode).Width(50);
            col.Command(command =>
            {
                command.Edit();
                //command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true).Visible("IsNotPosted");
            }).Width(50);
        })
        .ToolBar(t =>
        {
            //t.Create().Text("Add New Record");
            if ((bool)ViewBag.IsAdmin)
            {
                t.Custom().Text("Export to Excel").IconClass("k-icon k-i-excel").Name("btnExportGrid").HtmlAttributes(new { @class = "k-button", href = "", id = "exportGrid" });
            }
            t.Search();
        })
        .Excel(excel => excel
            .FileName("ItemTypeAccount.xlsx")
            .Filterable(true)
            .AllPages(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "AccountCode"))
        )
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_PayoutTemplate").Window(w => w.Width("50%").Title("Payout Setup")))
        .Editable(editable => editable.Mode(GridEditMode.InLine))
        .Search(s =>
        {
            s.Field(o => o.Code, "contains");
            s.Field(o => o.Description, "contains");
        })
        .Pageable(pager => pager
            .Refresh(true)
        )
        .Resizable(r => r.Columns(true))
        .Filterable()
        .Sortable()
        .Scrollable()
        //.Selectable(selectable => selectable
        //    .Mode(GridSelectionMode.Multiple)
        //    .Type(GridSelectionType.Row)
        //)
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .PersistSelection(true)
        .NoRecords()
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(100)
            .Events(events => events.Error("GridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                model.Field(p => p.Category).Editable(false);
                model.Field(p => p.Code).Editable(false);
                model.Field(p => p.Description).Editable(false);
                model.Field(p => p.GroupCode).Editable(false);
            })
            .Sort(s => s.Add(a => a.GroupCode))
            .Read(read => read.Action("ItemRead", "AccountCode").Data("DataGridItems"))
            //.Create(create => create.Action("ItemCreate", "AccountCode"))
            .Update(update => update.Action("ItemUpdate", "AccountCode"))
        //.Destroy(destroy => destroy.Action("ItemDestroy", "AccountCode"))
        ).AutoBind(false)
        .Events(e => e
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
    )
}


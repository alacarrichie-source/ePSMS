@model iLgs.Models.GenerateIcsParVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    //@Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.PoNo)
    @Html.HiddenFor(model => model.PoDate)
    @Html.HiddenFor(model => model.DeptId)
    @Html.HiddenFor(model => model.RefType)
    @Html.HiddenFor(model => model.LocationCode)
    @Html.HiddenFor(model => model.BundleDataJson)
    @*@Html.HiddenFor(model => model.IcsPar.RefDate)
    @Html.HiddenFor(model => model.IcsPar.LocationId)*@
    @Html.HiddenFor(model => model.IcsPar.ReceivedBy)

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.Date, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(model => model.Date).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Date)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.LocationId, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location Code")
                            .DataTextField("Code")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetLocationSp", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("10%");
                                c.Add().Field("Desc3").Title("Main-Location").Width("50%").Template("#= columnTemplate(data.Desc3) #");
                                c.Add().Field("Desc2").Title("Location").Width("40%").Template("#= columnTemplate(data.Desc2) #");
                            })
                            .Events(e => e.Select("onSelectGenerateParLocationId"))
                            .Suggest(false)
                    )
                    @Html.ValidationMessageFor(model => model.LocationId)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.Location, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.Location).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Location)
                </div>
            </div>
        </div>

        <div id="icsBatchPreview" style="margin:18px 0;padding:14px;border:1px solid #dbe5f1;border-radius:8px;background:#f8fafc">
            <div style="font-weight:700;color:#002576;margin-bottom:8px">Proposed component bundles</div>
            <div class="batch-preview-content"><span class="k-icon k-i-loading"></span> Building deterministic assignments...</div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.IcsPar.ReceivedByTitle, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.IcsPar.ReceivedByTitle).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.IcsPar.ReceivedByTitle)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.ReceivedById, "LabelGuid")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.IcsPar.ReceivedById)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Employee..")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetEmployee", "Getters").Data("DataEmployeeId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("30%").Template("#= columnTemplate(data.Name) #");
                                c.Add().Field("Department").Title("Department").Width("30%").Template("#= columnTemplate(data.Department) #");
                                c.Add().Field("Position").Title("Position").Width("30%").Template("#= columnTemplate(data.Position) #");
                                c.Add().Field("Status").Title("Status").Width("10%").Template("#= columnTemplate(data.Status) #");
                            })
                            //.MinLength(3)
                            .Events(e => { e.Select("onSelectEmployee"); })
                    )
                    @Html.ValidationMessageFor(m => m.IcsPar.ReceivedById)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.IcsPar.ReceivedByTitle2, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.IcsPar.ReceivedByTitle2).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.IcsPar.ReceivedByTitle2)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.ReceivedByPosition, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IcsPar.ReceivedByPosition).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.ReceivedByPosition)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.ReceivedDept, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IcsPar.ReceivedDept).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.ReceivedDept)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.ReceivedDate, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.IcsPar.ReceivedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.ReceivedDate)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IssuedTo, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IssuedTo).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedTo)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Designation, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.Designation).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Designation)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.IssuedBy, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.IcsPar.IssuedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Issued by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetIssuedBy", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("40%").Template("#= columnTemplate(data.Description) #");
                                c.Add().Field("Desc3").Title("Department").Width("30%").Template("#= columnTemplate(data.Desc3) #");
                                c.Add().Field("Desc2").Title("Position").Width("30%").Template("#= columnTemplate(data.Desc2) #");
                            })
                            //.MinLength(3)
                            .Events(e => { e.Select("onSelectIssuedBy"); })
                    )
                    @Html.ValidationMessageFor(m => m.IcsPar.IssuedBy)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.IssuedByPosition, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IcsPar.IssuedByPosition).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.IssuedByPosition)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.IssuedDept, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IcsPar.IssuedDept).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.IssuedDept)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IcsPar.IssuedDate, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.IcsPar.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IcsPar.IssuedDate)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Generate Ready Drafts").Name("btnSave").Enable(false))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>
    </fieldset>
}


<script type="text/javascript">
    (function loadBatchPreview() {
        $.get('@Url.Action("PreviewIcsBatch", "IcsSet")', {
            poNo: $('#PoNo').val(),
            poDate: $('#PoDate').val(),
            deptId: $('#DeptId').val()
        }).done(function (result) {
            if (result.error) {
                $('#icsBatchPreview .batch-preview-content').html("<div class='alert alert-danger'>" + kendo.htmlEncode(result.error) + "</div>");
                return;
            }
            var bundles = result.Bundles || [];
            var ready = $.grep(bundles, function (b) { return b.Status === 'Ready'; });
            $('#BundleDataJson').val(JSON.stringify(ready));
            var html = "<div style='margin-bottom:10px'><b>" + ready.length + " Ready</b> &middot; " + (bundles.length - ready.length) + " Incomplete</div>";
            $.each(bundles, function (_, b) {
                var ok = b.Status === 'Ready';
                html += "<div style='background:white;border-left:4px solid " + (ok ? "#16a34a" : "#dc2626") + ";padding:10px 12px;margin:8px 0'>";
                html += "<div style='display:flex;justify-content:space-between'><b>" + kendo.htmlEncode(b.MainDescription || 'Accountable unit') + " - " + kendo.htmlEncode(b.PropNo || 'Unassigned') + "</b><span class='status-badge'>" + b.Status + "</span></div>";
                html += "<div style='color:#475569;margin:4px 0'>Officer: " + kendo.htmlEncode(b.IssuedTo || 'Not assigned') + (b.Designation ? " - " + kendo.htmlEncode(b.Designation) : "") + "</div><ul style='margin:5px 0'>";
                $.each(b.Components || [], function (_, c) { html += "<li>" + kendo.htmlEncode(c.Description || 'Component') + (c.SerialNo ? " - " + kendo.htmlEncode(c.SerialNo) : "") + "</li>"; });
                html += "</ul>";
                if (!ok) html += "<div style='color:#b91c1c'><b>Missing:</b> " + $.map(b.MissingComponents || [], kendo.htmlEncode).join(', ') + "</div>";
                html += "</div>";
            });
            if (!bundles.length) html = "<div class='alert alert-warning'>No eligible physical units were found.</div>";
            $('#icsBatchPreview .batch-preview-content').html(html);
            var btn = $('#btnSave').data('kendoButton');
            if (btn) btn.enable(ready.length > 0);
        }).fail(function (xhr) {
            $('#icsBatchPreview .batch-preview-content').html("<div class='alert alert-danger'>Unable to build preview: " + kendo.htmlEncode(xhr.responseText || 'Request failed') + "</div>");
        });
    })();

    $("#btnSave").click(function (e) {
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("GenerateIcsBatch", "IcsSet")',
                data: $("#form").serialize(),
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                }, error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>









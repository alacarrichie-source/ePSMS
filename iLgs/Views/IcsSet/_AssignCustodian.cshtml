@{
    Layout = null;
}

<div class="p-3" style="font-size: 13px; padding: 16px;">
    <div class="alert alert-info py-2 px-3 mb-3" style="font-size: 12px; margin-bottom: 12px;">
        <span class="k-icon k-i-info"></span>
        Select an employee to assign as the designated custodian for the <strong id="assignSelectedCount">0</strong> selected items.
    </div>

    <div class="form-group mb-3" style="margin-bottom: 12px;">
        <label class="font-weight-bold mb-1" style="font-weight: 600; display: block; margin-bottom: 4px;">Designated Custodian (Employee):</label>
        @(Html.Kendo().MultiColumnComboBox()
            .Name("assignEmployeeCombo")
            .Placeholder("Search by employee name, designation, department...")
            .DataTextField("Name")
            .DataValueField("Id")
            .Filter(FilterType.Contains)
            .HtmlAttributes(new { style = "width: 100%;" })
            .DataSource(source =>
            {
                source.Read(read =>
                {
                    read.Action("GetEmployee", "Getters");
                })
                .ServerFiltering(true);
            })
            .Columns(columns =>
            {
                columns.Add().Field("Name").Title("Employee Name").Width("40%");
                columns.Add().Field("Position").Title("Designation").Width("30%");
                columns.Add().Field("Department").Title("Department").Width("30%");
            })
        )
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #e2e8f0;">
        <button type="button" class="btn-procurement-secondary" onclick="closeAssignCustodianModal()">Cancel</button>
        <button type="button" class="btn-procurement-primary" onclick="submitCustodianAssignment()">
            <span class="k-icon k-i-check"></span> Apply Custodian Assignment
        </button>
    </div>
</div>

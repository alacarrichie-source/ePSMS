    // --- NOTIFICATIONS & ERROR HANDLING ---
    function notifySuccess(msg) {
        var notif = $("#icsNotification").data("kendoNotification");
        if (notif) notif.show(msg, "success");
    }

    function notifyWarning(msg) {
        var notif = $("#icsNotification").data("kendoNotification");
        if (notif) notif.show(msg, "warning");
    }

    function GridError(args) {
        if (args && args.errors) {
            var msg = "Validation Error:\n";
            $.each(args.errors, function (prop) {
                if (this.errors) {
                    msg += this.errors.join("\n") + "\n";
                }
            });
            alert(msg);
        }
    }

    // --- GENERATED SLIPS ROW ACTIONS & CONTEXTUAL MENU ---
    var pendingDeleteRefNo = null;
    var pendingPostRefNo = null;
    var pendingPostHasAir = false;

    function toggleRowActionMenu(btn, e) {
        e.preventDefault();
        e.stopPropagation();

        var grid = $("#gridGeneratedSlips").data("kendoGrid");
        if (!grid) return;
        var tr = $(btn).closest("tr");
        var dataItem = grid.dataItem(tr);
        if (!dataItem) return;

        var id = dataItem.Id;
        var refNo = dataItem.RefNo;
        var status = dataItem.Status || "Draft";
        var hasAir = !!dataItem.HasAir;
        var receivedBy = dataItem.ReceivedBy || "";
        var receivedDept = dataItem.ReceivedDept || "";

        var menu = $("#floatingIcsActionsMenu");
        if (menu.is(":visible") && menu.data("activeRefNo") === refNo) {
            menu.hide().removeData("activeRefNo");
            return;
        }

        menu.data("activeRefNo", refNo);

        var html = "";

        if (hasAir) {
            html += "<button type='button' class='ics-menu-item' onclick='viewAirDocument(\"" + id + "\")'>" +
                    "<span class='k-icon k-i-file-pdf' style='color:rgb(239, 68, 68);'></span> View ICS Document" +
                    "</button>";
            html += "<button type='button' class='ics-menu-item' onclick='openUploadAirModal(\"" + id + "\", \"" + refNo + "\")'>" +
                    "<span class='k-icon k-i-refresh' style='color:rgb(2, 132, 199);'></span> Replace ICS Document" +
                    "</button>";
        } else {
            html += "<button type='button' class='ics-menu-item' onclick='openUploadAirModal(\"" + id + "\", \"" + refNo + "\")'>" +
                    "<span class='k-icon k-i-upload' style='color:rgb(37, 99, 235);'></span> Upload ICS Document" +
                    "</button>";
        }

        if (status !== "Posted") {
            html += "<div class='ics-menu-divider'></div>";
            html += "<button type='button' class='ics-menu-item' onclick='confirmPostIcs(\"" + refNo + "\")'>" +
                    "<span class='k-icon k-i-check-circle' style='color:rgb(22, 163, 74);'></span> Post ICS" +
                    "</button>";
            html += "<div class='ics-menu-divider'></div>";
            html += "<button type='button' class='ics-menu-item danger' onclick='confirmDeleteIcs(\"" + refNo + "\")'>" +
                    "<span class='k-icon k-i-delete'></span> Delete ICS" +
                    "</button>";
        }

        menu.html(html);

        var rect = btn.getBoundingClientRect();
        var top = rect.bottom + 2;
        var left = rect.right - 185;
        if (left < 10) left = 10;

        menu.css({ top: top + "px", left: left + "px" }).fadeIn(100);
    }

    function closeRowActionMenu() {
        $("#floatingIcsActionsMenu").hide().removeData("activeRefNo");
    }

    $(document).on("click", function (e) {
        if (!$(e.target).closest(".ics-actions-menu, .btn-ics-actions").length) {
            closeRowActionMenu();
        }
    });

    $(window).on("scroll resize", function () {
        closeRowActionMenu();
    });

    // Existing endpoints retain their route names; this surface stores the uploaded ICS document.
    function openUploadAirModal(id, refNo, custodian, dept) {
        if (!refNo) return;
        closeRowActionMenu();
        $("#windowcontainer").append("<div id='windowUploadAir'></div>");
        var win = $("#windowUploadAir").kendoWindow({
            title: "Attach ICS Document - " + refNo,
            width: 560,
            modal: true,
            visible: false,
            deactivate: function () {
                this.destroy();
            }
        }).data("kendoWindow");

        win.refresh({
            url: '@Url.Action("_UploadAir", "IcsSet")',
            data: { icsNo: refNo },
            complete: function () {
                win.center();
            }
        });
        win.open();
    }

    function closeUploadAirModal() {
        var win = $("#windowUploadAir").data("kendoWindow");
        if (win) win.close();
    }

    function viewAirDocument(id) {
        closeRowActionMenu();
        if (!id) return;
        var url = '@Url.Action("ViewAirDocument", "IcsSet")?icsId=' + encodeURIComponent(id);
        window.open(url, '_blank');
    }

    function openUploadIcsModal(id, refNo) { openUploadAirModal(id, refNo); }
    function closeUploadIcsModal() { closeUploadAirModal(); }
    function viewIcsDocument(id) { viewAirDocument(id); }

    // --- DELETE ICS MODAL ---
    function confirmDeleteIcs(refNo) {
        if (!refNo) return;
        closeRowActionMenu();
        pendingDeleteRefNo = refNo;
        $("#deleteModalIcsNo").text(refNo);

        var win = $("#windowDeleteIcs").data("kendoWindow");
        if (!win) {
            win = $("#windowDeleteIcs").kendoWindow({
                title: "Delete Inventory Custodian Slip",
                width: 480,
                modal: true,
                visible: false
            }).data("kendoWindow");
        }
        win.center().open();
    }

    function closeDeleteIcsModal() {
        var win = $("#windowDeleteIcs").data("kendoWindow");
        if (win) win.close();
    }

    function executeDeleteIcs() {
        if (!pendingDeleteRefNo) return;

        var btn = $("#btnConfirmDeleteIcs");
        btn.prop("disabled", true).html("<span class='k-icon k-i-loading'></span> Deleting...");

        $.ajax({
            url: '@Url.Action("DeleteIcs", "IcsSet")',
            type: "POST",
            data: { icsNo: pendingDeleteRefNo },
            success: function (res) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-delete'></span> Delete ICS");
                closeDeleteIcsModal();
                if (res && res.success) {
                    notifySuccess(res.message || "ICS permanently deleted.");
                    refreshWorkspace(true);
                } else {
                    alert(res.message || "Failed to delete ICS.");
                }
            },
            error: function (xhr, status, error) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-delete'></span> Delete ICS");
                alert("Error deleting ICS: " + (error || status));
            }
        });
    }

    // --- POST ICS MODAL ---
    function confirmPostIcs(refNo) {
        if (!refNo) return;
        closeRowActionMenu();
        pendingPostRefNo = refNo;

        $("#postModalIcsNo").text(refNo);
        $("#postIcsAlertBox").show();
        $("#postIcsMissingAirWarning").hide();
        $("#btnConfirmPostIcs").prop("disabled", false).removeClass("k-state-disabled");

        var win = $("#windowPostIcs").data("kendoWindow");
        if (!win) {
            win = $("#windowPostIcs").kendoWindow({
                title: "Post Inventory Custodian Slip",
                width: 500,
                modal: true,
                visible: false
            }).data("kendoWindow");
        }
        win.center().open();
    }

    function closePostIcsModal() {
        var win = $("#windowPostIcs").data("kendoWindow");
        if (win) win.close();
    }

    function openUploadFromPostModal() {
        var refNo = pendingPostRefNo;
        closePostIcsModal();
        openUploadAirModal(null, refNo);
    }

    function executePostIcs() {
        if (!pendingPostRefNo) return;

        var btn = $("#btnConfirmPostIcs");
        btn.prop("disabled", true).html("<span class='k-icon k-i-loading'></span> Posting...");

        $.ajax({
            url: '@Url.Action("PostIcs", "IcsSet")',
            type: "POST",
            data: { icsNo: pendingPostRefNo },
            success: function (res) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-check'></span> Post ICS");
                if (res && res.success) {
                    closePostIcsModal();
                    notifySuccess(res.message || "ICS successfully posted.");
                    refreshWorkspace(true);
                } else {
                    var errorMsg = (res && res.message) ? res.message : "Failed to post ICS.";
                    notifyWarning(errorMsg);
                    alert(errorMsg);
                    if (errorMsg.indexOf("ICS document has not been uploaded") !== -1 || errorMsg.indexOf("upload the ICS") !== -1) {
                        $("#postIcsAlertBox").hide();
                        $("#postIcsMissingAirWarning").show();
                    }
                }
            },
            error: function (xhr, status, error) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-check'></span> Post ICS");
                alert("Error posting ICS: " + (error || status));
            }
        });
    }

    // --- UNPOST ICS MODAL ---
    var pendingUnpostRefNo = null;

    function confirmUnpostIcs(refNo) {
        if (!refNo) return;
        closeRowActionMenu();
        pendingUnpostRefNo = refNo;

        $("#unpostModalIcsNo").text(refNo);
        $("#btnConfirmUnpostIcs").prop("disabled", false).html("<span class='k-icon k-i-undo'></span> Unpost");

        var win = $("#windowUnpostIcs").data("kendoWindow");

            openGenerateSingleModal($(this).attr("data-extn-id"), $(this).attr("data-ics-id"));
        })
        .off("click.icsViewSlip", ".ics-view-slip")
        .on("click.icsViewSlip", ".ics-view-slip", function (e) {
            e.preventDefault();
            openViewIcsModal($(this).attr("data-ics-no"));
        })
        .off("click.icsPrintSlip", ".ics-print-slip")
        .on("click.icsPrintSlip", ".ics-print-slip", function (e) {
            e.preventDefault();
            printOfficialIcs($(this).attr("data-ics-no"));
        })
        .off("click.icsPostSlip", ".ics-post-slip")
        .on("click.icsPostSlip", ".ics-post-slip", function (e) {
            e.preventDefault();
            confirmPostIcs($(this).attr("data-ics-no"));
        })
        .off("click.icsUnpostSlip", ".ics-unpost-slip")
        .on("click.icsUnpostSlip", ".ics-unpost-slip", function (e) {
            e.preventDefault();
            confirmUnpostIcs($(this).attr("data-ics-no"));
        })
        .off("click.icsDeleteSlip", ".ics-delete-slip")
        .on("click.icsDeleteSlip", ".ics-delete-slip", function (e) {
            e.preventDefault();
            confirmDeleteIcs($(this).attr("data-ics-no"));
        });
</script>









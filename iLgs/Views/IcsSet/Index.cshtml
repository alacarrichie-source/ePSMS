    function htmlEncodeValue(value) {
        return kendo.htmlEncode(value === null || value === undefined ? "" : String(value));
    }

    function generatedSlipActionsTemplate(dataItem) {
        var id = htmlEncodeValue(dataItem.Id);
        var extnId = htmlEncodeValue(dataItem.MainPsCardItemExtnId);
        var refNo = htmlEncodeValue(dataItem.RefNo);
        var isPosted = dataItem.Status === "Posted";
        var canEditIndividually = !isPosted && dataItem.ItemCount === 1 && extnId;
        var html = "<div class='ics-actions-cell'>";
        html += "<button type='button' class='btn-procurement-secondary btn-sm ics-view-slip' data-ics-no='" + refNo + "' title='View Official ICS'><span class='k-icon k-i-eye'></span> View</button>";
        html += "<button type='button' class='btn-procurement-secondary btn-sm ics-print-slip' data-ics-no='" + refNo + "' title='Print Official Report'><span class='k-icon k-i-print'></span> Print</button>";
        if (isPosted) {
            html += "<button type='button' class='btn-procurement-warning btn-sm ics-unpost-slip' data-ics-no='" + refNo + "' title='Unpost Official ICS'><span class='k-icon k-i-undo'></span> Unpost</button>";
        } else {
            if (canEditIndividually) html += "<button type='button' class='btn-procurement-secondary btn-sm ics-edit-slip' data-ics-id='" + id + "' data-extn-id='" + extnId + "' title='Continue / Edit Draft ICS'><span class='k-icon k-i-edit'></span> Edit</button>";
            html += "<button type='button' class='btn-procurement-success btn-sm ics-post-slip' data-ics-no='" + refNo + "' title='Post Official ICS'><span class='k-icon k-i-check'></span> Post</button>";
            html += "<button type='button' class='btn-procurement-danger btn-sm ics-delete-slip' data-ics-id='" + id + "' data-ics-no='" + refNo + "' title='Delete Draft ICS'><span class='k-icon k-i-delete'></span> Delete</button>";
        }
        return html + "</div>";
    }


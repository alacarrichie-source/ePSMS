    function onDataBoundGridItemSet(e) {
        var mainGrid = this;

        mainGrid.tbody.find("tr.k-master-row").each(function () {
            var mainRow = $(this);
            mainGrid.expandRow(mainRow);

            setTimeout(function () {
                var subGrid = mainRow.next().find(".k-grid");
                if (subGrid.length) {
                    var subGridInstance = subGrid.data("kendoGrid");
                    if (subGridInstance) {
                        subGridInstance.one("dataBound", function () {
                            subGridInstance.tbody.find("tr.k-master-row").each(function () {
                                var subRow = $(this);
                                subGridInstance.expandRow(subRow);

                                setTimeout(function () {
                                    var innerGrid = subRow.next().find(".k-grid");
                                    if (innerGrid.length) {
                                        var innerGridInstance = innerGrid.data("kendoGrid");
                                        if (innerGridInstance) {
                                            innerGridInstance.one("dataBound", function () {
                                                innerGridInstance.tbody.find("tr.k-master-row").each(function () {
                                                    innerGridInstance.expandRow($(this));
                                                });
                                            });
                                        }
                                    }
                                });
                            });
                        });
                    }
                }
            });
        });
    }


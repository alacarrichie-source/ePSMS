<!-- CLIENT-SIDE SCRIPTING -->
<script type="text/javascript">
    var selectedPoId = null;
    var selectedPoNo = null;
    var selectedPoDate = null;
    var selectedDeptId = null;

    $(document).ready(function () {
        fetchSummaryMetrics();
    });

    // Helper: Safely get the active PO Year as an integer
    function getSelectedYear() {
        try {
            var nt = $("#forYear").data("kendoNumericTextBox");
            if (nt && typeof nt.value === "function") {
                var val = nt.value();
                if (val && !isNaN(val)) return parseInt(val, 10);
            }
            var raw = $("#forYear").val();
            if (raw) {
                var cleaned = ("" + raw).replace(/[^\d]/g, '');
                if (cleaned.length > 0) {
                    var p = parseInt(cleaned, 10);
                    if (!isNaN(p) && p > 0) return p;
                }
            }
        } catch (e) {
            console.warn("Error reading forYear, defaulting:", e);
        }
        return @forYear;
    }

    // Helper: Safely get the active Source filter as an integer (0: All, 1: Manual, 2: Live Records)
    function getSelectedSource() {
        try {
            var ddl = $("#Source").data("kendoDropDownList");
            if (ddl && typeof ddl.value === "function") {
                var val = ddl.value();
                if (val !== undefined && val !== null && val !== "") {
                    var p = parseInt(val, 10);
                    if (!isNaN(p) && (p === 1 || p === 2)) return p;
                }
            }
            var raw = $("#Source").val();
            if (raw !== undefined && raw !== null && raw !== "") {
                var pr = parseInt(raw, 10);
                if (!isNaN(pr) && (pr === 1 || pr === 2)) return pr;
            }
        } catch (e) {
            console.warn("Error reading Source, defaulting to 0:", e);
        }
        return 0;
    }

    // --- SECTION 2: METRICS, YEAR & SOURCE SELECTION ---
    function onChangeForYear(e) {
        refreshWorkspace(true);
    }

    function onChangeSource(e) {
        refreshWorkspace(true);
    }

    function fetchSummaryMetrics() {
        var yearVal = getSelectedYear();
        var sourceVal = getSelectedSource();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetSummaryMetrics", "IcsSet")',
            data: { forYear: yearVal, source: sourceVal },
            cache: false,
            dataType: "json",
            success: function (res) {
                if (res && res.success) {
                    $("#metricTotalPos").text(kendo.toString(res.totalPos, "n0"));
                    $("#metricPending").text(kendo.toString(res.pending, "n0"));
                    $("#metricPartial").text(kendo.toString(res.partial, "n0"));
                    $("#metricCompleted").text(kendo.toString(res.completed, "n0"));
                    $("#metricRemaining").text(kendo.toString(res.remainingItems, "n0"));
                } else if (res && res.message) {
                    console.warn("GetSummaryMetrics returned error:", res.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("fetchSummaryMetrics AJAX error:", status, error);
            }
        });
    }

    function refreshWorkspace(reloadMaster) {
        fetchSummaryMetrics();
        if (reloadMaster) {
            var gridOrders = $("#gridOrders").data("kendoGrid");
            if (gridOrders) {
                gridOrders.dataSource.read();
            } else if (selectedPoNo) {
                refreshCurrentPo(false);
            }
        } else if (selectedPoNo) {
            refreshCurrentPo(false);
        }
    }

    // --- SECTION 3: MASTER PO GRID & FILTERING ---
    function DataGridOrders() {
        return {
            forYear: getSelectedYear(),
            source: getSelectedSource()
        };
    }

    function onGridOrdersRequestEnd(e) {
        if (e && e.type === "read" && e.response) {
            var total = (e.response.Total !== undefined) ? e.response.Total : (e.response.Data ? e.response.Data.length : 0);
            $("#poListCountBadge").text(total + " Orders");
        }
    }

    function onGridOrdersError(e) {
        console.error("gridOrders DataSource Error:", e);
        if (e && e.errors) {
            var msg = "Error loading Purchase Orders:\n";
            $.each(e.errors, function (key, val) {
                if (val.errors) msg += val.errors.join("\n") + "\n";
            });
            alert(msg);
        }
    }

    function onDataBoundOrdersGrid(e) {
        var grid = e.sender;
        var items = grid.dataSource.view();
        var total = grid.dataSource.total();
        $("#poListCountBadge").text((items ? items.length : 0) + " Orders");

        // Keep summary metrics synchronized on master read
        fetchSummaryMetrics();

        if (!items || items.length === 0) {
            selectedPoId = null;
            selectedPoNo = null;
            selectedPoDate = null;
            selectedDeptId = null;
            $("#poEmptyState").show();
            $("#selectedPoWorkspace").hide();
            return;
        }

        // Try to reselect previously selected PO
        var selectedRow = null;
        var rows = grid.items();
        if (selectedPoNo) {
            for (var i = 0; i < items.length; i++) {
                if (items[i].PoNo === selectedPoNo) {
                    selectedRow = rows.eq(i);
                    break;
                }
            }
        }

        // Default to first row if no active selection or if previous selection was filtered out
        if (!selectedRow || !selectedRow.length) {
            selectedRow = rows.first();
        }

        if (selectedRow && selectedRow.length) {
            grid.select(selectedRow);
            var dataItem = grid.dataItem(selectedRow);
            if (dataItem) {
                selectPoFromDataItem(dataItem, selectedRow);
            }
        }
    }

    function onChangeOrdersGrid(e) {
        var grid = e.sender;
        var selected = grid.select();
        if (selected.length > 0) {
            var dataItem = grid.dataItem(selected);
            if (dataItem) {
                selectPoFromDataItem(dataItem, selected);
            }
        }
    }

    function onSelectPoRowByElement(element) {
        var grid = $("#gridOrders").data("kendoGrid");
        if (!grid) return;
        var tr = $(element).closest("tr");
        grid.select(tr);
        var dataItem = grid.dataItem(tr);
        if (dataItem) {
            selectPoFromDataItem(dataItem, tr);
        }
    }

    function selectPoFromDataItem(dataItem, tr) {
        $(".ics-po-item").removeClass("selected");
        if (tr) {
            tr.find(".ics-po-item").addClass("selected");
        }

        selectedPoId = dataItem.Id;
        selectedPoNo = dataItem.PoNo;
        selectedPoDate = dataItem.PoDate ? kendo.toString(dataItem.PoDate, "MM/dd/yyyy") : (dataItem.SPoDate || null);
        selectedDeptId = dataItem.DeptId || null;

        // Fetch PO header details via AJAX
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetPoDetails", "IcsSet")',
            data: {
                poNo: selectedPoNo,
                poDate: selectedPoDate,
                deptId: selectedDeptId,
                source: getSelectedSource()
            },
            cache: false,
            beforeSend: function () {
                window.kendo.ui.progress($("#selectedPoWorkspace"), true);
            },
            success: function (res) {
                window.kendo.ui.progress($("#selectedPoWorkspace"), false);
                if (res && res.success) {
                    renderSelectedPoHeader(res);
                }
            },
            error: function () {
                window.kendo.ui.progress($("#selectedPoWorkspace"), false);
            }
        });

        // Show workspace, hide empty state
        $("#poEmptyState").hide();
        $("#selectedPoWorkspace").css("display", "flex");

        // Refresh detail tabs
        refreshItemsGrid();
        refreshGeneratedSlipsGrid();
    }

    function renderSelectedPoHeader(d) {
        $("#lblDetailPoNo").text(d.poNo);
        $("#lblDetailDept").text(d.department ? d.department : "General Services Office");
        //$("#lblDetailSupplier").text(d.supplier ? d.supplier : "Not Specified");
        $("#lblDetailPoDate").text(d.poDate ? d.poDate : "--");
        $("#lblDetailFund").text(d.fund ? d.fund : "General Fund");
        //$("#lblDetailMode").text(d.poMode ? d.poMode : "Public Bidding");
        $("#lblDetailAcqValue").text("â‚±" + kendo.toString(d.acqValue, "n2"));
        $("#lblDetailItemStats").text(d.totalItems + " Total / " + d.finishedItems + " Issued");

        // Status badge
        var statusBadge = $("#badgeDetailPoStatus");
        statusBadge.removeClass("status-accepted status-acceptance-progress status-unposted");
        if (d.balanceItems == 0 && d.totalItems > 0) {
            statusBadge.addClass("status-accepted").text("Complete");
        } else if (d.finishedItems > 0) {
            statusBadge.addClass("status-acceptance-progress").text("Partial (" + d.finishedItems + "/" + d.totalItems + ")");
        } else {
            statusBadge.addClass("status-unposted").text("Pending (" + d.balanceItems + " items)");
        }

        // Progress bar
        var pct = (d.totalItems > 0) ? Math.min(100, Math.round((d.finishedItems / d.totalItems) * 100)) : 0;
        $("#lblProgressRatio").text(d.finishedItems + " of " + d.totalItems + " Processed (" + pct + "%)");
        $("#barProgressFill").css("width", pct + "%");
        if (pct >= 100) {
            $("#barProgressFill").css("background", "#16a34a");
            $("#lblProgressRemaining").html("<span style='color:#16a34a; font-weight:600;'><span class='k-icon k-i-check'></span> All accountable items successfully issued through ICS</span>");
            $("#btnHeaderBatchGenerate").prop("disabled", true).addClass("k-state-disabled");
        } else {
            $("#barProgressFill").css("background", "#002576");
            $("#lblProgressRemaining").text(d.balanceItems + " Accountable Items Remaining");
            $("#btnHeaderBatchGenerate").prop("disabled", false).removeClass("k-state-disabled");
        }
    }

    function refreshCurrentPo(showProgress) {
        if (!selectedPoNo) return;
        var grid = $("#gridOrders").data("kendoGrid");
        if (grid) {
            var sel = grid.select();
            if (sel.length > 0) {
                var dataItem = grid.dataItem(sel);
                if (dataItem) {
                    selectPoFromDataItem(dataItem, sel);
                    return;
                }
            }
        }
        selectPoFromDataItem({ Id: selectedPoId, PoNo: selectedPoNo, SPoDate: selectedPoDate, DeptId: selectedDeptId }, null);
    }

    // Filter pills & search
    function onFilterMasterList() {
        var term = $("#txtPoSearch").val().toLowerCase();
        var activeFilter = $(".filter-pill-btn.active").data("filter");

        var grid = $("#gridOrders").data("kendoGrid");
        if (!grid) return;
        var filters = [];

        if (term) {
            filters.push({
                logic: "or",
                filters: [
                    { field: "PoNo", operator: "contains", value: term },
                    { field: "Department", operator: "contains", value: term }
                ]
            });
        }

        if (activeFilter === "PENDING") {
            filters.push({ field: "QtyFinished", operator: "eq", value: 0 });
        } else if (activeFilter === "PARTIAL") {
            filters.push({ field: "QtyFinished", operator: "gt", value: 0 });
            filters.push({ field: "QtyBalance", operator: "gt", value: 0 });
        } else if (activeFilter === "COMPLETED") {
            filters.push({ field: "QtyBalance", operator: "eq", value: 0 });
        }

        grid.dataSource.filter(filters.length > 0 ? { logic: "and", filters: filters } : {});
    }

    function onSelectStatusFilter(btn, filterType) {
        $(".filter-pill-btn").removeClass("active");
        $(btn).addClass("active");
        onFilterMasterList();
    }

    // --- TAB 1: INDIVIDUAL ITEMS GRID & SUBGRID ---
    var lastPoForItemsGrid = null;
    var lastExpandedItemId = null;

    function DataGridItems() {
        return {
            poNo: selectedPoNo,
            poDate: selectedPoDate,
            deptId: selectedDeptId
        };
    }

    function refreshItemSubgrids() {
        $("#gridItems").find(".item-units-grid-target").each(function () {
            var subGrid = $(this).data("kendoGrid");
            if (subGrid) {
                subGrid.dataSource.read();
            }
        });
    }

    function refreshItemsGrid() {
        var grid = $("#gridItems").data("kendoGrid");
        if (grid) {
            grid.dataSource.read();
        }
        refreshItemSubgrids();
    }

    function onDetailExpandItemGrid(e) {
        if (e.data && e.data.Id) {
            lastExpandedItemId = e.data.Id;
        }
    }

    function onDataBoundItemsGrid(e) {
        var grid = e.sender;
        var masterRows = grid.tbody.find("> tr.k-master-row");
        if (masterRows.length === 0) return;

        // Reset expanded item when switching to a different PO
        if (selectedPoNo !== lastPoForItemsGrid) {
            lastPoForItemsGrid = selectedPoNo;
            lastExpandedItemId = null;
        }

        var targetRow = null;
        if (lastExpandedItemId) {
            masterRows.each(function () {
                var dataItem = grid.dataItem(this);
                if (dataItem && dataItem.Id === lastExpandedItemId) {
                    targetRow = $(this);
                    return false;
                }
            });
        }

        // Default to expanding the first parent row if none active
        if (!targetRow || targetRow.length === 0) {
            targetRow = masterRows.first();
            var firstItem = grid.dataItem(targetRow);
            if (firstItem) {
                lastExpandedItemId = firstItem.Id;
            }
        }

        if (targetRow && targetRow.length) {
            grid.expandRow(targetRow);
        }
    }

    function onDetailInitItemUnitsGrid(e) {
        var parentItemId = e.data.Id;
        var $container = e.detailCell.find(".item-units-detail-container");
        var $target = $container.find(".item-units-grid-target");

        $target.kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: '@Url.Action("_PoItemGeneratedUnitsRead", "IcsSet")',
                        type: 'POST',
                        data: function () {
                            return { psCardItemId: parentItemId };
                        }
                    }
                },
                schema: {
                    data: "Data",
                    total: "Total",
                    errors: "Errors",
                    model: {
                        id: "PsCardItemExtnId",
                        fields: {
                            Id: { type: "string" },
                            UnitNo: { type: "number" },
                            IcsParItemId: { type: "string", nullable: true },
                            IcsParId: { type: "string", nullable: true },
                            PsCardItemExtnId: { type: "string" },
                            PropNo: { type: "string" },
                            SerialNo: { type: "string" },
                            AccountableOfficer: { type: "string" },
                            AccountableOfficerPosition: { type: "string" },
                            Position: { type: "string" },
                            IssuedTo: { type: "string" },
                            IsPosted: { type: "boolean" },
                            Status: { type: "string" },
                            IcsNo: { type: "string" }
                        }
                    }
                }
            },
            noRecords: {
                template: "<div style='padding: 10px 14px; color: rgb(100, 116, 139); font-style: italic; font-size: 12px;'><span class='k-icon k-i-info'></span> No accountable physical units are available.</div>"
            },
            scrollable: true,
            sortable: false,
            pageable: false,
            resizable: true,
            columns: [
                {
                    field: "UnitNo",
                    title: "Unit #",
                    width: 70,
                    attributes: { style: "text-align: center; font-weight: 600; color: rgb(71, 85, 105);" },
                    headerAttributes: { style: "text-align: center;" }
                },
                {
                    field: "SerialNo",
                    title: "Serial / (Ref. No.)",
                    width: 150,
                    template: "<span style='font-family: Consolas, monospace; color: rgb(51, 65, 85);'>#: SerialNo #</span>"
                },
                {
                    field: "IcsNo",
                    title: "ICS No.",
                    width: 150,
                    template: function (dataItem) {
                        if (dataItem.Status === "Posted" && dataItem.IcsNo) {
                            return "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(22, 101, 52);'>" + kendo.htmlEncode(dataItem.IcsNo) + "</span>";
                        } else if (dataItem.Status === "Draft" && dataItem.IcsNo) {
                            return "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(3, 105, 161);'>" + kendo.htmlEncode(dataItem.IcsNo) + "</span>";
                        } else {
                            return "<span class='text-muted' style='font-style: italic;'>&mdash;</span>";
                        }
                    }
                },
                {
                    field: "PropNo",
                    title: "Property No.",
                    width: 200,
                    template: "<span style='font-family: Consolas, monospace; font-weight: 600; color: rgb(0, 37, 118);'>#: PropNo #</span>"
                },
                {
                    field: "AccountableOfficer",
                    title: "Accountable Officer",
                    width: 200,
                    template: function (dataItem) {
                        var officer = dataItem.AccountableOfficer || dataItem.IssuedTo;
                        var position = dataItem.AccountableOfficerPosition || dataItem.Position;
                        if (!officer || dataItem.Status === "Available") return "<span class='text-muted' style='font-style: italic;'>&mdash;</span>";
                        var color = dataItem.Status === "Posted" ? "color: rgb(22, 101, 52);" : (dataItem.Status === "Draft" ? "color: rgb(3, 105, 161);" : "");
                        var html = "<div><div style='font-weight: 600; " + color + "'>" + kendo.htmlEncode(officer) + "</div>";
                        if (position) html += "<div style='font-size: 11px; color: rgb(100, 116, 139); margin-top: 2px;'>" + kendo.htmlEncode(position) + "</div>";
                        return html + "</div>";
                    }
                },
                {
                    title: "Action",
                    width: 150,
                    sortable: false,
                    template: function (dataItem) {
                        if (dataItem.Status === "Posted") return "<button type='button' class='btn-procurement-secondary btn-sm ics-view-unit' data-ics-no='" + kendo.htmlEncode(dataItem.IcsNo) + "' title='View Posted ICS'><span class='k-icon k-i-eye'></span> View ICS</button>";
                        if (dataItem.Status === "Draft") return "<button type='button' class='btn-procurement-secondary btn-sm ics-continue-unit' data-extn-id='" + kendo.htmlEncode(dataItem.PsCardItemExtnId) + "' data-ics-id='" + kendo.htmlEncode(dataItem.IcsParId || '') + "' title='Continue / Edit Draft ICS'><span class='k-icon k-i-edit'></span> Continue</button>";
                        if (dataItem.Status === "Available") return "<button type='button' class='btn-procurement-primary btn-sm ics-generate-unit' data-extn-id='" + kendo.htmlEncode(dataItem.PsCardItemExtnId) + "' title='Generate ICS for Unit'><span class='k-icon k-i-play'></span> Generate</button>";
                        return "<span class='text-muted' style='font-style: italic;'>Assigned elsewhere</span>";
                    }
                }
            ],
            dataBound: function (subEvt) {
                var subGrid = subEvt.sender;
                var data = subGrid.dataSource.data();
                if (data.length === 0) {
                    subGrid.element.find(".k-grid-header").hide();
                } else {
                    subGrid.element.find(".k-grid-header").show();
                }
            }
        });
    }

    function initSubgridIssuedToCombos(subGrid) {
        subGrid.element.find("input.subgrid-employee-combo").each(function () {
            var $input = $(this);
            var icsParItemId = $input.data("id");
            if (!icsParItemId || $input.data("kendoComboBox")) return;

            $input.kendoComboBox({
                placeholder: "Search recipient...",
                dataTextField: "Name",
                dataValueField: "Name",
                filter: "contains",
                suggest: true,
                autoBind: false,
                minLength: 1,
                dataSource: {
                    serverFiltering: true,
                    transport: {
                        read: {
                            url: '@Url.Action("GetEmployee", "Getters")',
                            type: "GET",
                            data: function (e) {
                                var text = "";
                                var cb = $input.data("kendoComboBox");
                                if (cb) {
                                    text = cb.text() || "";
                                }
                                return { text: text };
                            }
                        }
                    }
                },
                template: "<div style='font-size: 12px; padding: 2px 0;'>" +
                            "<div style='font-weight: 600; color: rgb(30, 41, 59);'>#: data.Name #</div>" +
                            "# if (typeof data.Department !== 'undefined' && data.Department) { #" +
                                "<div style='font-size: 11px; color: rgb(100, 116, 139);'>#: data.Department # # if (typeof data.Position !== 'undefined' && data.Position) { # (#: data.Position #) # } #</div>" +
                            "# } #" +
                          "</div>",
                change: function (e) {
                    var selectedName = this.text() || this.value();
                    if (selectedName) {
                        updateIssuedTo(icsParItemId, selectedName, this);
                    }
                }
            });
        });
    }

    function updateIssuedTo(icsParItemId, newIssuedTo, comboWidget) {
        if (!icsParItemId || !newIssuedTo) return;

        $.ajax({
            url: '@Url.Action("UpdateIssuedTo", "IcsSet")',
            type: 'POST',
            data: {
                icsParItemId: icsParItemId,
                issuedTo: newIssuedTo
            },
            success: function (res) {
                if (res && res.success) {
                    notifySuccess(res.message || "Issued To updated successfully.");
                } else {
                    var err = (res && res.message) ? res.message : "Failed to update Issued To.";
                    notifyWarning(err);
                    alert(err);
                    if (err.indexOf("already been posted") !== -1) {
                        refreshWorkspace(true);
                    }
                }
            },
            error: function (xhr, status, error) {
                notifyWarning("Error updating Issued To: " + (error || status));
                alert("Error updating Issued To: " + (error || status));
            }
        });
    }


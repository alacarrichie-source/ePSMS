    function executeUnpostIcs() {
        if (!pendingUnpostRefNo) return;

        var btn = $("#btnConfirmUnpostIcs");
        btn.prop("disabled", true).html("<span class='k-icon k-i-loading'></span> Unposting...");

        $.ajax({
            url: '@Url.Action("UnpostIcs", "IcsSet")',
            type: "POST",
            data: { icsNo: pendingUnpostRefNo },
            success: function (res) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-undo'></span> Unpost");
                if (res && res.success) {
                    closeUnpostIcsModal();
                    notifySuccess(res.message || "ICS successfully unposted.");
                    refreshWorkspace(true);
                } else {
                    var errorMsg = (res && res.message) ? res.message : "Failed to unpost ICS.";
                    notifyWarning(errorMsg);
                    alert(errorMsg);
                }
            },
            error: function (xhr, status, error) {
                btn.prop("disabled", false).html("<span class='k-icon k-i-undo'></span> Unpost");
                alert("Error unposting ICS: " + (error || status));
            }
        });
    }


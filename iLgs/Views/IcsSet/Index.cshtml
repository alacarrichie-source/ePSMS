@helper RenderPars()
{
    @(Html.Kendo().Grid<iLgs.Models.IcsParItem>()
                        .Name("gridItemsPar")
                        .Columns(col =>
                        {
                            col.Bound(c => c.IcsPar.RefNo).Title("ICS No.").Width(70);
                            col.Bound(c => c.IcsPar.RefDate).Title("ICS Date").Width(70).Format("{0:MM/dd/yyyy}");
                            col.Bound(c => c.PropNo).Title("Property No.").Width(70);
                            col.Command(command =>
                            {
                                command.Edit();
                                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridParItems").SendDataKeys(true);
                            }).Width(100);
                        })
                        .ToolBar(t =>
                        {
                        t.Template(@<text>
        <div clas="row" style="padding: 10px; font-size: 14px; font-weight: bold;">
            ICS
        </div>

        @*@(Html.Kendo().Button().Icon("k-icon k-i-add").Name("btnParsAdd").Content("Generate ICS").Events(e => e.Click("onClickBtnAddPar")))*@
        @*@(Html.Kendo().Button().Content("Print").Icon("k-icon k-i-print").Name("btnPrint_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnPrintPar")))
            @(Html.Kendo().Button().Content("Post").Icon("k-icon k-i-lock").Name("btnPost_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnPostPar")))
            @(Html.Kendo().Button().Content("Unpost").Icon("k-icon k-i-unlock").Name("btnUnpost_" + @ViewData["orderItemId"]).Events(e => e.Click("onClickBtnUnpostPar")))*@

                    </text>);
                        })
                        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_IcsTemplate").Window(w => w.Width(800)))
                        .Sortable()
                        .NoRecords()
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Events(events => events.Error("GridError").RequestEnd("onRequestEndGridParItems")
                            )
                            .Model(model =>
                            {
                                model.Id(p => p.Id);
                                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
                            })
                            .Sort(s => { s.Add(a => a.IcsPar.RefNo); s.Add(a => a.PropNo); })
                            .Read(read => read.Action("_IcsRead", "IcsSet").Data("DataGridItemPar"))
                            //.Read(read => read.Action("_IcsRead", "IcsSet", new { cardItemId = "#=Id#" }))
                            .Update(update => update.Action("_IcsUpdate", "IcsSet"))
                            .Destroy(destroy => destroy.Action("_IcsDestroy", "IcsSet"))
                        )
                        .AutoBind(false)
                        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Events(e => e
            .Edit("onEditGridItemsPar")
            .Change("onChangeGridItemsPar")
            .DataBound("onDataBoundGridItemsPar"))
        //).ToClientTemplate()
    )
}


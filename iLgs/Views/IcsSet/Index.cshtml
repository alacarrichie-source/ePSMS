<!-- Kendo Detail Template for Individual Accountable Items Subgrid -->
<script id="itemUnitsTemplate" type="text/x-kendo-tmpl">
    <div class="item-units-detail-container">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(71, 85, 105); margin-bottom: 8px;">
            <span class="k-icon k-i-list-bulleted" style="font-size: 12px; margin-right: 4px;"></span> Generated Accountable Units
        </div>
        <div class="item-units-grid-target"></div>

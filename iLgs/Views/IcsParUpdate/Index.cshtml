<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>

<script type="text/javascript">
    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();
                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onSelectType(e) {
        var refType = $(e.target[0]).val();
        $("#grid").data("kendoGrid").dataSource.read({ refType: refType });
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedPoNo = null;


    $(".k-grid-btnPrintCard").click(function (e) {
        e.preventDefault();
        PrintCard(1);
    });

    $(".k-grid-btnPrintCardUpdate").click(function (e) {
        e.preventDefault();
        PrintCard(0);
    });

    function PrintCard(originalSw) {
        var url = '@Url.Action("PoRpt", "Query")?poNo=' + selectedPoNo + '&originalSw=' + originalSw;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    function onRequestEndGrid(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                selectedGrid.dataSource.read();
            }
            if (e.type == "create")
            {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var postedBy = null;

    function onChangeGrid(e) {
        selectedGrid = this;
        var selectedData = this.dataItem(this.select());
        selectedId = selectedData.Id;
        selectedPoNo = selectedData.PoNo
        selectedItemId = null;
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        var grid = $("#grid");
        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrintCard", grid).hide();
            //$(".k-grid-btnPost", grid).hide();
            //$(".k-grid-btnUnpost", grid).hide();
        }
        else {
            $(".k-grid-btnPrintCard", grid).show();
        }
    }

    function DataGrid() {
        return {
            refType: $("#refType").data("kendoRadioGroup").value()
        };
    }

    function onSelectUserName(e) {
        if (!e.item) {
            return;
        }

        var dataItem = this.dataItem(e.item.index());

        if (dataItem) {
            var userName = dataItem.UserName;
            $("#grid").data("kendoGrid").dataSource.read({userName: userName});
        }
    }

    function onChangeUserName(e) {
        var comboBox = this;
        var value = comboBox.value(); // Get the current value of the combo box

        if (!value) {
            var userName = "";
            $("#grid").data("kendoGrid").dataSource.read({ userName: userName });
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
        }
    }

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            //var row = e.sender.tbody.find("tr:first");
            //this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }
    }

    //////

    function IsActive(dataItem) {
        return dataItem.Status_ == "Active" && dataItem.PostedDt != null;
    }

    function IsPosted(dataItem) {
        return dataItem.PostedDt != null;
    }

    function IsNotPosted(dataItem) {
        return !IsPosted(dataItem);
    }


    function onClickBtnPrint(e) {
        e.preventDefault();
        // the current row for this detail
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        var url = "";
        var refType = $("#refType").data("kendoRadioGroup").value();

        if (refType == "I") {
            url = '@Url.Action("IcsSetRpt", "IcsParRpt")?icsNo=' + dataItem.RefNo;
        } else {
            url = '@Url.Action("ParSetRpt", "IcsParRpt")?parNo=' + dataItem.RefNo;
        }

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    function onClickDelete(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function onClickPost(e) {
        e.preventDefault();
        selectedGrid = this;
        var selectedRow  = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(selectedRow);
        selectedGrid.select(selectedRow);
        var postedBy = dataItem.PostedBy;

        if (postedBy) {
            alert("Record is already posted by " + postedBy);
        }
        else {
            var refNo = dataItem.RefNo;
            var refType = dataItem.RefType;
            var msg = "Post " + (refType == "I" ? "ICS" : "PAR") + " No. " + refNo + "?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Post", "IcsParUpdate")',
                    data: { refNo: refNo, refType: refType },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Record Posted...", "info");
                            //$("#grid").data("kendoGrid").dataSource.read();
                            selectedGrid.dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    }

    function onClickUnpost(e) {
        e.preventDefault();
        selectedGrid = this;
        var selectedRow = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(selectedRow);
        selectedGrid.select(selectedRow);
        var postedBy = dataItem.PostedBy;

        if (!postedBy) {
            alert("Record is not yet posted!");
        }
        else {
            var refNo = dataItem.RefNo;
            var refType = dataItem.RefType;
            var msg = "Post " + (refType == "I" ? "ICS" : "PAR") + " No. " + refNo + "?";

            if (confirm(msg)) {
                var popupNotification = $("#popupNotification").data("kendoNotification");
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Unpost", "IcsParUpdate")',
                    data: { refNo: refNo, refType: refType },
                    async: true,
                    beforeSend: function () {
                        window.kendo.ui.progress($(document.body), true);
                    },
                    success: function (result) {
                        window.kendo.ui.progress($(document.body), false);
                        if (result.Errors == "") {
                            popupNotification.show("Done...", "info");
                            selectedGrid.dataSource.read();
                        } else {
                            alert(result.Errors);
                            return false;
                        }
                    },
                    error: function (req, status, errorObj) {
                        disabled.attr('disabled', 'disabled');
                        alert(req.responseText);
                        return false;
                    }
                });
            }
        }
    }

    function onClickUploads(e) {
        e.preventDefault();
        selectedGrid = this;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        //selectedId = dataItem.Id;
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        Uploads(dataItem.Id, dataItem.PostedBy);
    }

    function Uploads(imageId, postedBy) {
        var myTitle = "Uploads";
        var width = 1000;
        var height = 650;

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
            //height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_Images", "ParIcsUpload")',
            data: {
                imageId: imageId,
                postedBy: postedBy
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        //mywindow.center();
        mywindow.open();
        //resizeWindow();
    }

    function onClickTransfer(e) {
        e.preventDefault();
        selectedGrid = this;
        var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

        var refNo = dataItem.RefNo;
        var refType = dataItem.RefType;
        var myTitle = "Transfer";
        var width = 1000;
        var height = 650;

        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    autoheight: true,
                    close: function () {
                        grid = $("#grid").data("kendoGrid").dataSource.read();
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
            //height: height
        });
        mywindow.refresh({
            url: '@Url.Action("_Transfer", "IcsParUpdate")',
            data: {
                refNo: refNo,
                refType: refType
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        //mywindow.center();
        mywindow.open();
        //resizeWindow();
    }

    // TRANSFER TEMPLATE
    function onSelectLocationId(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#LocationCode").val(dataItem.Code).trigger("change");
        $("#Location").val(dataItem.Description).trigger("change");
    }

    function onSelectIssuedBy(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#IssuedBy").val(dataItem.Description).trigger("change");
        $("#IssuedByPosition").val(dataItem.Desc2).trigger("change");
        $("#IssuedDept").val(dataItem.Desc3).trigger("change");
    }

    function onSelectEmployee(e) {
        var dataItem = this.dataItem(e.item.index());
        $("#ReceivedBy").val(dataItem.Name).trigger("change");
        $("#ReceivedByPosition").val(dataItem.Position).trigger("change");
        $("#ReceivedDept").val(dataItem.Department).trigger("change");
    }

    function DataEmployeeId() {
        var text = $("#ReceivedById").data("kendoMultiColumnComboBox").text();
        if (text == null || text == "") {
            text = $("#ReceivedById").data("kendoMultiColumnComboBox").value();
        }
        return {
            text: text
        };
    }

    // END TRANSFER TEMPLATE


    // GRID IMAGES
    function GridUploadError(e) {
        if (e.errors) {
            $.each(e.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                }
            });
        }
    }

    var selectedGridImagesItem = null;
    function onEditGridImages(e) {
        e.preventDefault();

        var selectedGrid = e.sender; // local, grid is popup
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            e.model.set("ImageId", '@ViewData["imageId"]');
        } else {
            selectedGridImagesItem = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedGridImagesItem);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onDataBoundGridImages(e) {
        if (selectedGridImagesItem) {
            var dataItem = this.dataSource.get(selectedGridImagesItem);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onDeleteGridImages(e) {
        e.preventDefault();
        selectedGrid = this;
        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        setTimeout(function () { selectedGrid.removeRow(tr); }, 10);
    }


    function onClickUpload(e) {
        var button = e.sender.element; // Use the sender's element;
        // Retrieve the grid name from the data attribute
        var imageId = $(button).data("imageid");
        var myUrl = '@Url.Action("_ImagesAdd", "ParIcsUpload")?imageId=' + imageId;
        var myTitle = "Upload Images/Documents";
        var width = 800;
        var height = 650;

        $("#windowcontainer").append("<div id='windowUpload'></div>");
        var mywindow = $("#windowUpload")
                .kendoWindow({
                    actions: ["Minimize", "Maximize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");

        mywindow.setOptions({ title: myTitle, width: width, height: height });
        mywindow.refresh({ url: myUrl });
        mywindow.center();
        mywindow.open();

    }

    function onError(e) {
        // invalid because the responseText is a raw string, not JSON
        //var err = $.parseJSON(e.XMLHttpRequest.responseText);
        var err = e.XMLHttpRequest.responseText;
        alert(err);
    };

    function UploadPara(e) {
        var data = JSON.stringify({ model: $("#formUpload").serialize() });
        e.data = { imageId: $("#ImageId").val(), Description: $("#Description").val() }
    }

    $(document).ready(function () {
        var previewUploadUrl = '@Url.Action("GridPreview", "ParIcsUpload")';

        $(document).on("click", ".upload-photo", function () {
            var bgImage = $(this).css("background-image");

            // Extract ID from URL
            var match = bgImage.match(/id=([^"&]+)/i); // More flexible ID extraction
            if (match && match[1]) {
                var myUrl = previewUploadUrl + "?id=" + match[1];
                window.open(myUrl, "_blank");
            } else {
                console.log("ID not found in background-image:", bgImage);
            }
        });
    });

    function onClickPreview(e) {
        var selectedGrid = this; // local, grid is popup

        var tr = $(e.currentTarget).closest("tr");
        var dataItem = selectedGrid.dataItem(tr);
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);

        selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        selectedGridImagesItem = dataItem.Id;

        var myUrl = '@Url.Action("PreviewUpload", "ParIcsUpload")?id=' + selectedGridImagesItem;
        window.open(myUrl, "_blank");
    }

    function onUploadSuccess(e)
    {
        $("#gridImages_").data("kendoGrid").dataSource.read();
    }

    // END GRID IMAGES
</script>







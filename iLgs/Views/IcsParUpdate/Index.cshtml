@{
    ViewBag.Title = "ICS/PAR Updates";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}
<br />
<div class="row">
    <div class="col-md-6">
        <div class="col-md-1">
            @Html.Label("Type:")
        </div>
        <div class="col-md-11">
            @(Html.Kendo().RadioGroup()
            .Name("refType")
            .Layout("horizontal")
            .Events(e => e.Select("onSelectType"))
            .Items(i =>
                {
                    i.Add().Label("ICS").Value("I");
                    i.Add().Label("PAR").Value("P");                    
                })
            .Value("I")
            )
        </div>
    </div>
</div>
<br />


@(Html.Kendo().Grid<iLgs.Models.IcsParVM>()
    .HtmlAttributes(new { @class = "max-grid-2" })
    .Name("grid")
    .Columns(col =>
    {
        //col.Bound(p => p.Id).Title("")
        //        .ClientTemplate(
        //        @"<div class='upload-photo'
        //           style='background-image: url(" + @Url.Content("~/ParIcsUpload/GridPreview?id=#:Id#") + ");" +
        //           "onclick='oClickImage(#:Id#)'></div></div>")
        //            .Width(70);
        col.Bound(c => c.RefNo).Width(50);
        col.Bound(c => c.RefDate).Width(50);
        col.Bound(c => c.UpdateCode).Width(30);
        col.Bound(c => c.LocationCode).Width(30);
        col.Bound(c => c.Location).Width(100);
        col.Bound(c => c.ReceivedBy).Width(100);
        col.Bound(c => c.ReceivedDate).Width(50);
        col.Bound(c => c.PostedBy).Width(50);
        col.Bound(c => c.PostedDt).Width(70);
        col.Bound(c => c.Status_).Width(50);
        col.Command(command =>
        {
            command.Custom("Print").IconClass("k-icon k-i-print").SendDataKeys(true).Click("onClickBtnPrint");
            command.Custom("Uploads").IconClass("k-icon k-i-upload").Click("onClickUploads").SendDataKeys(true);
            command.Custom("Transfer").IconClass("k-icon k-i-copy").Click("onClickTransfer").SendDataKeys(true).Visible("IsActive");
            command.Custom("Delete").IconClass("k-icon k-i-close").SendDataKeys(true).Click("onClickDelete").Visible("IsNotPosted");
            command.Custom("Post").IconClass("k-icon k-i-lock").Click("onClickPost").SendDataKeys(true).Visible("IsNotPosted");
            command.Custom("Unpost").IconClass("k-icon k-i-unlock").Click("onClickUnpost").SendDataKeys(true).Visible("IsPosted");
        }).Width(250);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.RefNo, "contains");
        s.Field(o => o.LocationCode, "contains");
        s.Field(o => o.Location, "contains");
        s.Field(o => o.ReceivedBy, "contains");
        s.Field(o => o.IssuedBy, "contains");
        s.Field(o => o.PostedBy, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable()
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.ClientDetailTemplateId("DetailTemplate")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(30)
        .Events(events => events.Error("GridError")
            .RequestEnd("onRequestEndGrid")
        )
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Sort(s => s.Add(a => a.RefNo).Descending())
        .Read(read => read.Action("Read", "IcsParUpdate").Data("DataGrid"))
        .Destroy(destroy => destroy.Action("Destroy", "IcsParUpdate"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .DataBound("onDataBoundGrid")
    )
)

<script id="DetailTemplate" type="text/kendo-tmpl">
    @(Html.Kendo().Grid<iLgs.Models.PsCardItemVM>()
    .Name("gridItem_#=Id#")
    .Columns(col =>
    {
        col.Bound(c => c.Account).Width(100).Title("Main Account");
        col.Bound(c => c.StockNo).Width(100);
        //col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.Description).Width(150);
        col.Bound(c => c.Unit).Width(150);
        col.Bound(c => c.Qty).Width(30).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n0}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_QtyTemplate");
        col.Bound(c => c.Amount).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("\\#=kendo.format('{0:n2}', sum)\\#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" }).EditorTemplateName("_AmountTemplate");
        col.Bound(c => c.InsertedBy).Width(70);
        col.Bound(c => c.InsertedDt).Width(100);
        col.Bound(c => c.UpdatedBy).Width(70);
        col.Bound(c => c.UpdatedDt).Width(100);
    })
    .Sortable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Aggregates(a =>
        {
            a.Add(p => p.Qty).Sum();
            a.Add(p => p.Amount).Sum();
        })
        .Read(read => read.Action("PoItemRead", "Query", new { poNo = "#=PoNo#", userName = "#=UserName#" }))
    )
    .Events(events => events
        .Change("onChangeGridItems")
        .DataBound("onDataBoundGridItems")
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .ToClientTemplate())
</script>


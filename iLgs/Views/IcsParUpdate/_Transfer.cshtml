@model iLgs.Models.IcsParVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.RefNo)
    @Html.HiddenFor(model => model.PrevRefNo)
    @Html.HiddenFor(model => model.RefType)
    @Html.HiddenFor(model => model.LocationCode)
    @Html.HiddenFor(model => model.ReceivedBy)

    <fieldset>
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.RefDate, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(model => model.RefDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.RefDate)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.LocationId, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.LocationId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select Location Code")
                            .DataTextField("Code")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetLocationSp", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("10%");
                                c.Add().Field("Desc3").Title("Main-Location").Width("50%").Template("#= columnTemplate(data.Desc3) #");
                                c.Add().Field("Desc2").Title("Location").Width("40%").Template("#= columnTemplate(data.Desc2) #");
                            })
                            .Events(e => e.Select("onSelectLocationId"))
                            .Suggest(false)
                    )
                    @Html.ValidationMessageFor(model => model.LocationId)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.Location, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.Location).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.Location)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.ReceivedByTitle, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.ReceivedByTitle).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ReceivedByTitle)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ReceivedById, "LabelGuid")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.ReceivedById)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Employee..")
                            .DataTextField("Name")
                            .DataValueField("Id")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetEmployee", "Getters").Data("DataEmployeeId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Name").Title("Name").Width("30%").Template("#= columnTemplate(data.Name) #");
                                c.Add().Field("Department").Title("Department").Width("30%").Template("#= columnTemplate(data.Department) #");
                                c.Add().Field("Position").Title("Position").Width("30%").Template("#= columnTemplate(data.Position) #");
                                c.Add().Field("Status").Title("Status").Width("10%").Template("#= columnTemplate(data.Status) #");
                            })
                            //.MinLength(3)
                            .Events(e => { e.Select("onSelectEmployee"); })
                    )
                    @Html.ValidationMessageFor(m => m.ReceivedById)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(model => model.ReceivedByTitle2, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(model => model.ReceivedByTitle2).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.ReceivedByTitle2)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ReceivedByPosition, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.ReceivedByPosition).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ReceivedByPosition)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ReceivedDept, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.ReceivedDept).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ReceivedDept)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.ReceivedDate, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.ReceivedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.ReceivedDate)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IssuedBy, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.IssuedBy)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;", data_value_primitive = "true" })
                            .Placeholder("Select Issued by")
                            .DataTextField("Description")
                            .DataValueField("Description")
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetIssuedBy", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Name").Width("40%").Template("#= columnTemplate(data.Description) #");
                                c.Add().Field("Desc3").Title("Department").Width("30%").Template("#= columnTemplate(data.Desc3) #");
                                c.Add().Field("Desc2").Title("Position").Width("30%").Template("#= columnTemplate(data.Desc2) #");
                            })
                            //.MinLength(3)
                            .Events(e => { e.Select("onSelectIssuedBy"); })
                    )
                    @Html.ValidationMessageFor(m => m.IssuedBy)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IssuedByPosition, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IssuedByPosition).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedByPosition)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IssuedDept, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextBoxFor(m => m.IssuedDept).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedDept)
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.IssuedDate, "LabelDate")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().DatePickerFor(m => m.IssuedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.IssuedDate)
                </div>
            </div>
        </div>

        <br />

        <div class="row k-mb-2">
            <div class="col-md-12">
                <div class="col-md-2">
                    @Html.DisplayFor(m => m.Remarks, "Label")
                </div>
                <div class="col-md-10">
                    @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(3).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(m => m.Remarks)
                </div>
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Submit").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>
    </fieldset>
}


<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();
        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("TransferSave", "IcsParUpdate")',
                data: $("#form").serialize(),
                async: true,
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        alert(result.Errors);
                    }
                }, error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>










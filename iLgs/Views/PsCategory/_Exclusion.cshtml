@{
    var gridName = "gridExclusion_" + ViewData["ItemUserId"];
}

@(Html.Kendo().Grid<iLgs.Models.ItemTypeExclusion>()
    .Name("gridExclusion_" + @ViewData["ItemUserId"])
    .Columns(col =>
    {
        col.Bound(p => p.ItemUserId).Visible(false);
        col.Bound(p => p.ItemTypeId).Width(100);
        //col.Bound(p => p.ItemType.Category).Width(100);        
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(100);

    })
    .ToolBar(toolbar =>
    {
        toolbar.Create();
    })
    .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    //.Scrollable()
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Events(events => events.Error("InlineGridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
            model.Field(p => p.ItemUserId).DefaultValue(ViewData["ItemUserId"]).Editable(false);
        })
            .Read(read => read.Action("_ExclusionRead", "PsCategory", new { itemUserId = ViewData["ItemUserId"] }))
            .Create(create => create.Action("_ExclusionCreate", "PsCategory"))
            .Update(update => update.Action("_ExclusionUpdate", "PsCategory"))
            .Destroy(destroy => destroy.Action("_ExclusioneDestroy", "PsCategory"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(true)
    .Events(events => events.Edit("onEditGridExclusion")
    .DataBound("onDataBoundExclusion")
    )
)

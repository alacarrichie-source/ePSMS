@model iLgs.Models.CodeMast

@{
    ViewBag.Title = ViewData["title"];
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.CodextnVM>()
        .Name("gridItems")
        .HtmlAttributes(new { @class = "max-grid" })
        .Columns(columns =>
        {
            //columns.Bound(o => o.Desc4).Width(70).Title(Model.Desc4Hdg ?? "Desc4");
            columns.Bound(o => o.Code).Width(70).Title(Model.CodeHdg ?? "Code");
            columns.Bound(o => o.Description).Width(300).Title(Model.Desc1Hdg ?? "Description")
                .ClientTemplate("<div style='padding-left: #= Padding #px;'>#= Description #</div>");
            columns.Bound(o => o.Desc2).Width(100).Title(Model.Desc2Hdg ?? "Desc2");
            columns.Bound(o => o.Desc3).Width(70).Title(Model.Desc3Hdg ?? "Desc3");
            //columns.Bound(o => o.Pad).Width(50);
            //columns.Bound(o => o.Desc4).Width(70).Title(Model.Desc4Hdg ?? "Desc4");
            //columns.Bound(o => o.Desc5).Width(70).Title(Model.Desc5Hdg ?? "Desc5");
            columns.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(120);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add New Record");
            t.Search();
        })
        .Search(s =>
        {
            s.Field(o => o.Desc3, "contains");
            s.Field(o => o.Code, "contains");
            s.Field(o => o.Description, "contains");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable()
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .Editable()
        //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_CodextnGenTemplate").Window(w => w.Width(500).Title(ViewData["code"] + " Item")))
        .ClientDetailTemplateId("Details")
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("InlineGridError"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
                model.Field(p => p.MastId).DefaultValue(Model.Id);
                model.Field(p => p.CodeHdg).DefaultValue(Model.CodeHdg);
                model.Field(p => p.Desc1Hdg).DefaultValue(Model.Desc1Hdg);
                model.Field(p => p.Desc2Hdg).DefaultValue(Model.Desc2Hdg);
                model.Field(p => p.Desc3Hdg).DefaultValue(Model.Desc3Hdg);
                model.Field(p => p.Desc4Hdg).DefaultValue(Model.Desc4Hdg);
                model.Field(p => p.Desc5Hdg).DefaultValue(Model.Desc5Hdg);
            })
            .Read(read => read.Action("Read", "PsCategory", new { mastId = Model.Id }))
            .Create(create => create.Action("Create", "PsCategory"))
            .Update(update => update.Action("Update", "PsCategory"))
            .Destroy(destroy => destroy.Action("Destroy", "PsCategory"))
            .Sort(s => { s.Add(a => a.Desc4); })
    )
    .Events(events => events
        .Change("onChangeGridItems")
        .Edit("onEditGridItems")
        .DataBound("onDataBoundGridItems")
    )
.AutoBind(true)
)

<script id="Details" type="text/kendo-tmpl">
    @(Html.Kendo().TabStrip()
            .Name("tabStrip_#=Id#")
            //.HtmlAttributes(new { @class = "no-text-tabstrip" })
            .TabPosition(TabStripTabPosition.Top)
            .Animation(animation =>
            {
                animation.Open(config =>
                {
                    config.Fade(FadeDirection.In);
                });
            })
            .SelectedIndex(0)
            .Items(items =>
            {
                items.Add().Text("Users")
                    .Selected(true)
                    .LoadContentFrom("_CategoryUsers", "PsCategory", new { deptId = "#=Id#" });                
            }).ToClientTemplate())
</script>

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }
</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>


<script type="text/javascript">
    function InlineGridError(e) {
        if (e.errors) {
            let message = "Errors:\n";

            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += (key ? key + ": " : "") + value.errors.join("\n") + "\n";
                    });
                }
            });

            alert(message); // You can replace this with any other UI method to display errors
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    var selectedGrid = null;
    var selectedItemId = null;
    var selectedUserItemId = null;
    var selectedOfficerItemId = null;

    function onChangeGridItems(e) {
        var selectedData = this.dataItem(this.select());
        selectedItemId = selectedData.Id;
        selectedUserItemId = null;
        selectedOfficerItemId = null;
    }

    function onDataBoundGridItems(e) {
        if (selectedItemId) {
            var dataItem = this.dataSource.get(selectedItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            var firstRow = this.tbody.find("tr.k-master-row").first();
            this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }
    }

    function onEditGridItems(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedItemId = null;
        } else {
            selectedItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onClickDeleteGridItem(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    // GRID USERS


    function onChangeGridUsers(e) {
        var selectedData = this.dataItem(this.select());
        selectedUserItemId = selectedData.Id;
    }

    function onDataBoundGridUsers(e) {
        if (selectedUserItemId) {
            var dataItem = this.dataSource.get(selectedUserItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridUsers(e) {
        e.preventDefault();

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);

        parentGrid.select(parentRow);

        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedUserItemId = null;
            e.model.set("DeptId", selectedItemId);
        } else {
            selectedUserItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedUserItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onClickDeleteGridUsers(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }

    function onSelectUserName(e) {
        var dataItem = this.dataItem(e.item.index());

        $("#UserId").val(dataItem.Id).trigger("change");
        $("#Email").val(dataItem.Email).trigger("change");
        $("#NameFull").val(dataItem.NameFull).trigger("change");

        var model = $("#gridUsers_" + selectedItemId).data().kendoGrid.editable.options.model;
        model.set('Email', dataItem.Email);
        model.set('UserId', dataItem.Id);
        model.set('NameFull', dataItem.NameFull);
    }

    // GRID OFFICERS


    function onChangeGridOfficers(e) {
        var selectedData = this.dataItem(this.select());
        selectedOfficerItemId = selectedData.Id;
    }

    function onDataBoundGridOfficers(e) {
        if (selectedOfficerItemId) {
            var dataItem = this.dataSource.get(selectedOfficerItemId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }
    }

    function onEditGridOfficers(e) {
        e.preventDefault();

        // the master row for this detail
        var parentRow = this.wrapper.closest("tr").prev();
        var parentGrid = parentRow.closest("[data-role=grid]").data("kendoGrid");
        var parentModel = parentGrid.dataItem(parentRow);

        parentGrid.select(parentRow);

        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedUserItemId = null;
            e.model.set("DeptId", selectedItemId);
        } else {
            selectedOfficerItemId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedOfficerItemId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        }
    }

    function onClickDeleteGridOfficers(e) {
        e.preventDefault();

        var grid = $(e.target).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;
        var dataItem = grid.dataItem($(e.currentTarget).closest("tr"));

        if (confirm("Are you sure you want to delete this record?")) {
            grid.dataSource.remove(dataItem);
            grid.dataSource.sync();
        }
    }
</script>




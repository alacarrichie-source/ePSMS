@*Wizard.cshtml*@
@model iLgs.Ai.Models.AIRWizardViewModel

@{
    ViewBag.Title = Model.IsSubmittedView ? ("View Submitted Inspection - " + (!string.IsNullOrEmpty(Model.AirNo) ? Model.AirNo : (Model.CtrlNo ?? "AIR"))) : (Model.IsRevisionMode ? "Revise Inspection Report" : "AIR Inspection Wizard");
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="epsms-procurement po-wizard air-wizard">

    <!-- ================================================================
         BREADCRUMBS
         ================================================================ -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "AIRs"))">@(ViewBag.ReturnLabel != null ? ((string)ViewBag.ReturnLabel).Replace("Back to ", "") : "Acceptance & Inspection Reports")</a>
        <span class="breadcrumb-separator">&gt;</span>
        <span>@(Model.IsSubmittedView ? "View Submitted Inspection" : (Model.IsRevisionMode ? "Revise Inspection" : "Inspect Orders"))</span>
    </div>

    <!-- ================================================================
         PAGE HEADER
         ================================================================ -->
    <div class="wizard-header">
        <div class="wizard-header-content">
            <h1 class="page-title">
                @(Model.IsSubmittedView ? "View Submitted Inspection" : (Model.IsRevisionMode ? "Revise Inspection Report" : "AIR Inspection Wizard"))
            </h1>
            <p class="page-subtitle">
                @(Model.IsSubmittedView ? "Review the historical submitted inspection report, physical verification records, committee details, and invoices." : "Record physical deliveries, verify quantities against Purchase Orders, capture supplier invoices, and submit for official acceptance.")
            </p>
        </div>

        <div class="wizard-header-actions">
            @if (Model.IsSubmittedView)
            {
                <span class="badge bg-light text-secondary border p-2 me-2">
                    <span class="k-icon k-i-lock"></span> Read-Only Mode
                </span>
                <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "AIRs"))" class="btn-procurement-secondary">
                    <span class="k-icon k-i-arrow-left"></span>
                    @(ViewBag.ReturnLabel ?? "Back to Inspection List")
                </a>
            }
            else
            {
                <span class="wizard-draft-status" aria-live="polite">
                    <span class="wizard-draft-icon">
                        <span class="k-icon k-i-save"></span>
                    </span>
                    <span id="wizardDraftStatusText">@(Model.DraftId.HasValue ? ("Draft " + (Model.DraftNo ?? "") + " loaded") : (Model.AirId.HasValue ? "Draft loaded" : "Not yet saved"))</span>
                </span>

                <a href="@Url.Action("Index", "AIRs")" class="btn-procurement-secondary">
                    <span class="k-icon k-i-close"></span>
                    Cancel &amp; Exit
                </a>
            }
        </div>
    </div>

    @if (Model.IsSubmittedView)
    {
        <!-- ============================================================
             HISTORICAL VIEW BANNER (READ-ONLY SUBMITTED INSPECTION)
             ============================================================ -->
        <div class="card mb-4 border-info shadow-sm" style="border-left: 5px solid #0284c7; background: #f0f9ff;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="k-icon k-i-info text-info" style="font-size: 20px;"></span>
                            <h4 class="mb-0 fs-6 fw-bold text-dark">Submitted Inspection &ndash; Read Only</h4>
                        </div>
                        <p class="small text-secondary mb-0">
                            This view shows the inspection exactly as it was submitted. Changes cannot be made here.
                        </p>
                        <div class="d-flex flex-wrap gap-3 mt-2 small">
                            <span><strong>AIR No:</strong> <span class="fw-bold text-primary">@(!string.IsNullOrEmpty(Model.AirNo) ? Model.AirNo : Model.CtrlNo)</span></span>
                            <span>&bull;</span>
                            <span><strong>Submitted By:</strong> @(!string.IsNullOrEmpty(Model.SubmittedBy) ? Model.SubmittedBy : "--")</span>
                            <span>&bull;</span>
                            <span><strong>Submitted:</strong> @(Model.SubmittedDt.HasValue ? Model.SubmittedDt.Value.ToString("MMM dd, yyyy hh:mm tt") : "--")</span>
                            <span>&bull;</span>
                            <span><strong>Status:</strong> <span class="badge bg-secondary">@Model.OverallStatus</span></span>
                        </div>
                    </div>

                    @if (Model.AvailableVersions != null && Model.AvailableVersions.Count > 1)
                    {
                        <div class="d-flex align-items-center gap-2 p-2 bg-white rounded border">
                            <label for="ddlSubmissionVersion" class="small fw-bold mb-0 text-secondary" style="white-space:nowrap;">
                                <span class="k-icon k-i-history"></span> Version:
                            </label>
                            <select id="ddlSubmissionVersion" class="form-control-custom form-control-sm" onchange="onSubmissionVersionChange(this.value)">
                                @foreach (var v in Model.AvailableVersions)
                                {
                                    <option value="@v.SnapshotId" @(v.IsCurrent ? "selected=\"selected\"" : "")>
                                        Version @v.VersionNo (@(v.SubmittedDt != default(DateTime) ? v.SubmittedDt.ToString("MMM dd, yyyy") : "--"))
                                    </option>
                                }
                            </select>
                        </div>
                    }
                    else if (Model.CurrentVersionNo > 0)
                    {
                        <div class="badge bg-white text-secondary border p-2">
                            <span class="k-icon k-i-clock"></span> Version @Model.CurrentVersionNo
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.IsRevisionMode)
    {
        <!-- ============================================================
             REVISION NOTICE BANNER
             ============================================================ -->
        <div class="pr-revision-notice" style="border-left: 5px solid #dc2626; background: #fef2f2; margin-bottom: 20px; padding: 12px 16px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="k-icon k-i-warning" style="color: #dc2626; font-size: 18px;"></span>
                    <strong style="color: #991b1b; font-size: 14px;">Returned for Revision by Acceptance Officer</strong>
                </div>
                <p style="color: #7f1d1d; margin-bottom: 0; font-size: 13px;">
                    <strong>Acceptance Feedback:</strong> @Model.RevisionComments
                </p>
            </div>
            <div class="text-end">
                <span class="badge" style="background:#fee2e2; color:#991b1b; padding: 6px 12px; border-radius: 4px; font-weight:600;">Action Required</span>
            </div>
        </div>
    }

    <!-- ================================================================
         STEPPER (PURE HTML/CSS - CONSISTENT WITH PO WIZARD)
         ================================================================ -->
    <div class="data-card" style="margin-bottom: 20px; padding: 14px 20px; background-color: #ffffff; border-radius: 8px; border: 1px solid #cbd5e1;">
        <div class="wizard-stepper" style="display: flex; align-items: center; justify-content: space-between; max-width: 860px; margin: 0 auto;">
            <!-- Step 1 Tab -->
            <div class="wizard-step-item active" id="stepIndicator1" onclick="goToWizardStep(1)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle1" style="width: 28px; height: 28px; border-radius: 50%; background-color: #2c3e50; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; box-shadow: 0 0 0 4px #f1f5f9;">1</div>
                <span class="step-label" id="label1" style="margin-left: 8px; font-size: 12px; font-weight: 700; color: #2c3e50;">Select PO</span>
            </div>
            <div class="step-line" id="line1" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 2 Tab -->
            <div class="wizard-step-item" id="stepIndicator2" onclick="goToWizardStep(2)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle2" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">2</div>
                <span class="step-label" id="label2" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Inspect Items</span>
            </div>
            <div class="step-line" id="line2" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 3 Tab -->
            <div class="wizard-step-item" id="stepIndicator3" onclick="goToWizardStep(3)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle3" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">3</div>
                <span class="step-label" id="label3" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Inspection Details</span>
            </div>
            <div class="step-line" id="line3" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 4 Tab -->
            <div class="wizard-step-item" id="stepIndicator4" onclick="goToWizardStep(4)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle4" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">4</div>
                <span class="step-label" id="label4" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Review &amp; Submit</span>
            </div>
        </div>
    </div>

    <!-- ================================================================
         WIZARD CONTENT
         ================================================================ -->
    <!-- Pre-initialize selectedOrderId globally before partials/grids render -->
    <script type="text/javascript">
        var selectedOrderId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderId));
    </script>

    <div class="wizard-content">

        @using (Html.BeginForm("SubmitForAcceptance", "AIRs", FormMethod.Post, new { id = "airWizardForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AirId, new { id = "hdnAirId" })
            @Html.HiddenFor(m => m.OrderId, new { id = "hdnOrderId" })
            @Html.HiddenFor(m => m.DraftId, new { id = "hdnDraftId" })
            @Html.HiddenFor(m => m.SourceAIRId, new { id = "hdnSourceAIRId" })
            @Html.HiddenFor(m => m.RevisionNo, new { id = "hdnRevisionNo" })

            <div id="wizardValidationSummary" class="validation-summary-errors" style="display:none;"></div>

            <!-- STEP 1 -->
            <div id="wizardStepPane1" class="wizard-pane">
                @Html.Partial("_Step1_SelectPO", Model)
            </div>

            <!-- STEP 2 -->
            <div id="wizardStepPane2" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step2_InspectItems", Model)
            </div>

            <!-- STEP 3 -->
            <div id="wizardStepPane3" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step3_InvoiceEntry", Model)
            </div>

            <!-- STEP 4 -->
            <div id="wizardStepPane4" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step4_ReviewSubmit", Model)
            </div>
        }
    </div>

</div>

<!-- ITEM HISTORY MODAL -->
@(Html.Kendo().Window()
    .Name("itemHistoryModal")
    .Title("Inspection History")
    .Width(750)
    .Height(450)
    .Modal(true)
    .Visible(false)
    .Actions(actions => actions.Close())
    .Content(@<text><div id="itemHistoryModalContent" class="p-3"></div></text>)
)

<!-- INVENTORY DETAILS MODAL -->
@(Html.Kendo().Window()
    .Name("inventoryDetailsWindow")
    .Title("Inventory Asset Details")
    .Width(1050)
    .Height(620)
    .Modal(true)
    .Visible(false)
    .Draggable(true)
    //.Resizable(true)
    .Actions(actions => actions.Close())
    .Content(@<text><div id="inventoryDetailsModalContent" class="p-3"></div></text>)
)

<!-- ADD / EDIT RECEIVED COMPONENT MODAL -->
@(Html.Kendo().Window()
    .Name("componentModalWindow")
    .Title("Received Component / Sub-Item")
    .Width(620)
    .Modal(true)
    .Visible(false)
    .Draggable(true)
    .Actions(actions => actions.Close())
    .Content(@<text>
        <div class="p-3" id="componentModalContent">
            <input type="hidden" id="compParentItemIdx" value="" />
            <input type="hidden" id="compSubItemIdx" value="" />
            
            <div class="mb-3 p-2 bg-light rounded border">
                <div class="small text-muted fw-bold">Parent Accountable Item:</div>
                <div id="compParentItemDisplay" class="fw-semibold text-primary"></div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="form-label small fw-bold" for="txtCompDescription">Component Description <span class="text-danger">*</span></label>
                    <input type="text" id="txtCompDescription" class="form-control-custom w-100" placeholder="e.g. Wireless Mouse, USB-C Dock, Laptop Bag..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold" for="txtCompUnit">Unit <span class="text-danger">*</span></label>
                    <input type="text" id="txtCompUnit" class="form-control-custom w-100" value="pc" placeholder="unit, pc, set..." />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold" for="numCompQtyReceived">Quantity Received <span class="text-danger">*</span></label>
                    <input type="number" id="numCompQtyReceived" step="any" min="0.01" class="form-control-custom w-100" placeholder="0.00" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold" for="ddlCompSourceType">Source Type <span class="text-danger">*</span></label>
                    <select id="ddlCompSourceType" class="form-control-custom w-100">
                        <option value="FREEBIE">FREEBIE (Freebie / Promotional)</option>
                        <option value="INSPECTION_ADDED">INSPECTION_ADDED (Extra / Discovered)</option>
                        <option value="ORDERED">ORDERED (Contract / PO Item)</option>
                    </select>
                </div>
            </div>

            <div class="mb-3 p-2 border rounded" style="background:#f0f9ff; border-color:#bae6fd !important;">
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="chkCompRequiredForBundle" />
                    <label class="form-check-label fw-bold text-dark ms-1" for="chkCompRequiredForBundle">
                        Required for Bundle
                    </label>
                </div>
                <div class="small text-muted ms-4" id="compBundleReqHelp">
                    Marks this component as mandatory when the property is later grouped into ICS/PAR bundles.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold" for="txtCompRemarks">Remarks / Notes</label>
                <textarea id="txtCompRemarks" class="form-control-custom w-100" rows="2" placeholder="Inspection findings, serials, or remarks..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
                <button type="button" class="btn-procurement-secondary" onclick="$('#componentModalWindow').data('kendoWindow').close()">Cancel</button>
                <button type="button" class="btn-procurement-primary" onclick="onSaveReceivedComponent()"><span class="k-icon k-i-check"></span> Save Component</button>
            </div>
        </div>
    </text>)
)

<!-- WITHDRAW SUBMISSION MODAL (IF ELIGIBLE) -->
@if (Model.IsSubmittedView && Model.CanWithdraw)
{
    @(Html.Kendo().Window()
        .Name("withdrawActionWindow")
        .Title("AIR Submission Withdrawal")
        .Width(500)
        .Modal(true)
        .Visible(false)
        .Actions(actions => actions.Close())
        .Content(@<text>
            <div class="p-3">
                <p class="mb-3 text-muted">Provide a reason for recalling this inspection submission. A new revision draft will be created.</p>
                <input type="hidden" id="withdrawAirId" value="@(Model.AirId.HasValue ? Model.AirId.Value.ToString() : "")" />
                <div class="form-group mb-3">
                    <label for="withdrawReason" class="font-weight-bold mb-1">Reason / Explanation <span class="text-danger">*</span></label>
                    <textarea id="withdrawReason" class="form-control-custom w-100" rows="4" placeholder="Enter detailed withdrawal reason..."></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="btn-procurement-secondary" onclick="$('#withdrawActionWindow').data('kendoWindow').close()">Cancel</button>
                    <button type="button" id="btnConfirmWithdraw" class="btn-procurement-primary" onclick="submitWithdrawFromView()">Confirm Withdrawal</button>
                </div>
            </div>
        </text>)
    )
}

@section scripts {
    <script type="text/javascript">
        var currentWizardStep = @Convert.ToInt32(ViewBag.CurrentStep ?? 1);
        var airId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AirId));
        var draftId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DraftId));
        var selectedOrderId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderId));
        var isRevisionMode = @(Model.IsRevisionMode ? "true" : "false");
        var isSubmittedView = @(Model.IsSubmittedView ? "true" : "false");
        var isReadOnly = @(Model.IsReadOnly ? "true" : "false");
        var airWizardState = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
        var wizardAutoSaveTimer = null;
        var wizardReady = false;
        var isSavingDraft = false;
        var isSavingDraft = false;

        function getLocalDateValue(selector) {
            var raw = $(selector).val();
            return (raw && raw.trim() !== "") ? raw.trim() : null;
        }

        function setLocalDateValue(selector, val) {
            if (!val) {
                $(selector).val("");
                return;
            }
            if (typeof val === "string") {
                var match = val.match(/^(\d{4}-\d{2}-\d{2})/);
                if (match) {
                    $(selector).val(match[1]);
                    return;
                }
            }
            var d = new Date(val);
            if (!isNaN(d.getTime())) {
                var year = d.getFullYear();
                var month = ("0" + (d.getMonth() + 1)).slice(-2);
                var day = ("0" + d.getDate()).slice(-2);
                $(selector).val(year + "-" + month + "-" + day);
            } else {
                $(selector).val("");
            }
        }

        function formatDisplayDate(val) {
            if (!val) return "--";
            if (typeof val === "string") {
                var match = val.match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (match) {
                    var localD = new Date(parseInt(match[1], 10), parseInt(match[2], 10) - 1, parseInt(match[3], 10));
                    return localD.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
                }
            }
            var d = new Date(val);
            if (isNaN(d.getTime())) return "--";
            return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
        }

        $(document).ready(function () {
            goToWizardStep(currentWizardStep);
            wizardReady = true;

            // In submitted view or if pre-populated with items, render Step 2 immediately
            if (isSubmittedView || isReadOnly) {
                if (airWizardState && airWizardState.Items && airWizardState.Items.length > 0) {
                    if (typeof renderStep2Items === "function") renderStep2Items(airWizardState);
                }
            } else {
                // If loaded with a pre-selected PO (e.g. from orderId param), render Step 2 immediately
                if (airWizardState && airWizardState.OrderId && (!airWizardState.Items || airWizardState.Items.length === 0)) {
                    loadPODetailsForWizard(airWizardState.OrderId);
                } else if (airWizardState && airWizardState.Items && airWizardState.Items.length > 0) {
                    if (typeof renderStep2Items === "function") renderStep2Items(airWizardState);
                }

                // Attach autosave only in editable mode
                $("#airWizardForm").on("input change", "input, select, textarea", function () {
                    scheduleWizardAutoSave();
                });
            }

            // Restore initial state into DOM controls
            if (airWizardState) {
                if (airWizardState.InspectionDate) {
                    setLocalDateValue("#txtInspectionDate", airWizardState.InspectionDate);
                } else {
                    $("#txtInspectionDate").val("");
                }
                if (airWizardState.Invoice && airWizardState.Invoice.InvoiceDate) {
                    setLocalDateValue("#txtInvoiceDate", airWizardState.Invoice.InvoiceDate);
                } else {
                    $("#txtInvoiceDate").val("");
                }

                if (airWizardState.Disposition && $("#ddlPoDisposition").length) {
                    $("#ddlPoDisposition").val(airWizardState.Disposition);
                }
                setTimeout(function () {
                    var cb = $("#InspectorName").data("kendoMultiColumnComboBox");
                    if (cb && airWizardState.InspectorName) {
                        cb.value(airWizardState.InspectorName);
                        cb.text(airWizardState.InspectorName);
                    }
                }, 200);
            }
        });

        function updateStepperUI(step) {
            for (var i = 1; i <= 4; i++) {
                var circle = $('#circle' + i);
                var label = $('#label' + i);
                var line = $('#line' + i);

                if (i < step) {
                    circle.css({ 'background-color': '#1d4ed8', 'color': '#ffffff', 'box-shadow': 'none' }).html('<span class="k-icon k-i-check"></span>');
                    label.css({ 'color': '#2c3e50', 'font-weight': '600' });
                    if (line.length) line.css('background-color', '#1d4ed8');
                } else if (i === step) {
                    circle.css({ 'background-color': '#2c3e50', 'color': '#ffffff', 'box-shadow': '0 0 0 4px #f1f5f9' }).text(i);
                    label.css({ 'color': '#2c3e50', 'font-weight': '700' });
                } else {
                    circle.css({ 'background-color': '#e2e8f0', 'color': '#64748b', 'box-shadow': 'none' }).text(i);
                    label.css({ 'color': '#64748b', 'font-weight': '500' });
                    if (line.length) line.css('background-color', '#cbd5e1');
                }
            }
        }

        function goToWizardStep(step) {
            if (step < 1 || step > 4) return;

            // In Read-Only Submitted View, allow free historical navigation without validations or saving
            if (isSubmittedView || isReadOnly) {
                currentWizardStep = step;
                updateStepperUI(step);
                hideWizardMessage();

                for (var i = 1; i <= 4; i++) {
                    $("#wizardStepPane" + i).hide();
                }
                $("#wizardStepPane" + step).fadeIn(150);

                if (step === 1 && typeof updateStep1Summary === "function") {
                    updateStep1Summary(airWizardState);
                } else if (step === 2 && typeof renderStep2Items === "function") {
                    renderStep2Items(airWizardState);
                } else if (step === 3 && typeof syncStep3Form === "function") {
                    syncStep3Form();
                } else if (step === 4 && typeof renderStep4Review === "function") {
                    renderStep4Review();
                }

                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            // Normal Editable Step Validations
            // Step 1 Validation
            if (step > 1 && !selectedOrderId) {
                showWizardMessage("Please select a Purchase Order to inspect before proceeding.");
                return;
            }

            // Step 2 Validation (Inspect Items)
            if (step > 2) {
                var hasInspectQty = false;
                $(".inspect-now-input").each(function () {
                    var val = parseFloat($(this).val()) || 0;
                    if (val > 0) hasInspectQty = true;
                });

                if (!hasInspectQty && airWizardState.Items && airWizardState.Items.length > 0) {
                    hasInspectQty = airWizardState.Items.some(function (i) { return (i.InspectNowQty || 0) > 0; });
                }

                if (!hasInspectQty) {
                    showWizardMessage("You must enter an 'Inspect Now' quantity greater than 0 for at least one item.");
                    return;
                }

                // Inventory Details completion validation (parent and sub-items evaluated independently)
                var incompleteInventory = [];
                if (airWizardState.Items) {
                    for (var i = 0; i < airWizardState.Items.length; i++) {
                        var itm = airWizardState.Items[i];
                        if (itm.Disposition === "Inventory" && (itm.InspectNowQty || 0) > 0) {
                            if (itm.ParentRequiresInventory) {
                                var req = Math.floor(itm.InspectNowQty);
                                var comp = (itm.InventoryDetails || []).filter(function (d) {
                                    return typeof checkInventoryDetailCompleted === "function" ? checkInventoryDetailCompleted(itm.ItemExtnName, d) : d.IsCompleted;
                                }).length;
                                if (comp < req) {
                                    incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " (" + (itm.Description || "Item") + "): " + comp + " of " + req + " parent units completed");
                                } else if ((itm.InventoryDetails || []).length > req) {
                                    incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " (" + (itm.Description || "Item") + "): " + itm.InventoryDetails.length + " unit details exist for " + req + " units being inspected (excess details must be removed)");
                                }
                            }
                            if (itm.SubItems && itm.SubItems.length > 0) {
                                for (var s = 0; s < itm.SubItems.length; s++) {
                                    var sub = itm.SubItems[s];
                                    if (sub.RequiresInventory && (sub.InspectNowQty || 0) > 0) {
                                        var subReq = Math.floor(sub.InspectNowQty);
                                        var subComp = (sub.InventoryDetails || []).filter(function (d) {
                                            return typeof checkInventoryDetailCompleted === "function" ? checkInventoryDetailCompleted(sub.ItemExtnName, d) : d.IsCompleted;
                                        }).length;
                                        if (subComp < subReq) {
                                            incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " - Sub-item '" + (sub.Description || "Component") + "': " + subComp + " of " + subReq + " units completed");
                                        } else if ((sub.InventoryDetails || []).length > subReq) {
                                            incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " - Sub-item '" + (sub.Description || "Component") + "': " + sub.InventoryDetails.length + " unit details exist for " + subReq + " units being inspected (excess details must be removed)");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if (incompleteInventory.length > 0) {
                    showWizardMessage("Inventory details are incomplete:<br/>" + incompleteInventory.join("<br/>") + "<br/>Please click [Enter Details] in Step 2 to complete all required unit records before proceeding.");
                    return;
                }
            }

            // Step 3 Validation (Invoice Entry)
            if (step > 3) {
                var invoices = airWizardState.Invoices || [];
                if (invoices.length === 0) {
                    showWizardMessage("Please add at least one Sales Invoice record in Step 3 before proceeding.");
                    return;
                }
            }

            hideWizardMessage();

            // Hide all panes
            for (var i = 1; i <= 4; i++) {
                $("#wizardStepPane" + i).hide();
            }

            currentWizardStep = step;
            updateStepperUI(step);
            $("#wizardStepPane" + step).fadeIn(150);

            // Step 1: restore disposition
            if (step === 1 && airWizardState) {
                if (airWizardState.Disposition && $("#ddlPoDisposition").length) {
                    $("#ddlPoDisposition").val(airWizardState.Disposition);
                }
            }

            if (step === 3) {
                if (typeof syncStep3Form === "function") {
                    syncStep3Form();
                }
            }
            if (step === 4 && typeof renderStep4Review === "function") {
                renderStep4Review();
            }
        }

        function showWizardMessage(msg) {
            $("#wizardValidationSummary").html("<span>" + msg + "</span>").show();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hideWizardMessage() {
            $("#wizardValidationSummary").hide();
        }

        function scheduleWizardAutoSave() {
            if (isSubmittedView || isReadOnly) return;
            if (!wizardReady) return;
            // In Step 1, do NOT auto-save if no draft exists yet (selecting POs should never create drafts)
            if (currentWizardStep === 1 && (!airWizardState || !airWizardState.DraftId)) return;
            if (!airWizardState || !airWizardState.OrderId) return;
            $("#wizardDraftStatusText").text("Unsaved changes...");
            clearTimeout(wizardAutoSaveTimer);
            wizardAutoSaveTimer = setTimeout(saveDraftSilent, 2500);
        }

        // Collect all form inputs into airWizardState before saving/submitting
        function collectWizardFormData() {
            if (!airWizardState || isSubmittedView || isReadOnly) return;

            airWizardState.OrderId = selectedOrderId || $("#hdnOrderId").val();

            // Step 1: Disposition
            if ($("#ddlPoDisposition").length) {
                var dVal = $("#ddlPoDisposition").val();
                if (dVal !== undefined && dVal !== null) {
                    airWizardState.Disposition = dVal || airWizardState.Disposition || "";
                }
            }

            // Step 2: Inspection Header & Details
            var inspVal = typeof getLocalDateValue === "function" ? getLocalDateValue("#txtInspectionDate") : ($("#txtInspectionDate").val() || null);
            airWizardState.InspectionDate = inspVal;
            if (inspVal) {
                airWizardState.AirDate = inspVal;
            }
            airWizardState.InspectionLocation = $("#txtInspectionLocation").val() || "";

            var inspectorCb = $("#InspectorName").data("kendoMultiColumnComboBox");
            if (inspectorCb) {
                airWizardState.InspectorName = inspectorCb.value() || "";
            } else if ($("#InspectorName").length) {
                airWizardState.InspectorName = $("#InspectorName").val() || "";
            }

            airWizardState.InspectorDesignation = $("#txtInspectorDesignation").val() || "";
            airWizardState.InspectionCommittee = $("#txtInspectionCommittee").val() || "";
            airWizardState.GeneralRemarks = $("#txtGeneralRemarks").val() || "";

            // Step 3: Invoices & Supporting Documents
            if (!airWizardState.Invoices) airWizardState.Invoices = [];
            if (!airWizardState.SupportingDocuments) airWizardState.SupportingDocuments = [];
            // Collect line item inspect quantities, remarks, and disposition from Step 2 inputs
            if (airWizardState.Items && airWizardState.Items.length > 0) {
                airWizardState.Items.forEach(function (item, idx) {
                    var inputQty = $("#txtInspectNow_" + idx);
                    if (inputQty.length) {
                        item.InspectNowQty = parseFloat(inputQty.val()) || 0;
                    }
                    var inputRemarks = $("#txtRemarks_" + idx);
                    if (inputRemarks.length) {
                        item.Remarks = inputRemarks.val() || "";
                    }
                    var selDisp = $("#ddlItemDisposition_" + idx);
                    if (selDisp.length) {
                        item.Disposition = selDisp.val() || item.Disposition || airWizardState.Disposition || "Inventory";
                    }
                    if (item.Disposition === "I") item.Disposition = "Inventory";
                    if (item.Disposition === "D") item.Disposition = "For Distribution";

                    if (item.SubItems && item.SubItems.length > 0) {
                        item.SubItems.forEach(function (sub, sIdx) {
                            if (sub.SubItemNo) {
                                sub.SubItemNo = sub.SubItemNo.toString().replace(/^#+/, "").trim();
                            }
                            var sInputQty = $("#txtSubInspectNow_" + idx + "_" + sIdx);
                            if (sInputQty.length) {
                                sub.InspectNowQty = parseFloat(sInputQty.val()) || 0;
                            }
                            var sInputRemarks = $("#txtSubRemarks_" + idx + "_" + sIdx);
                            if (sInputRemarks.length) {
                                sub.Remarks = sInputRemarks.val() || "";
                            }
                            var sType = (sub.SourceType || "ORDERED").toUpperCase();
                            if (sType === "ORDERED") {
                                sub.IsRequiredForBundle = true;
                            } else {
                                var sChkBundle = $("#chkBundleReq_" + idx + "_" + sIdx);
                                if (sChkBundle.length) {
                                    sub.IsRequiredForBundle = sChkBundle.is(":checked");
                                }
                            }
                        });
                    }
                });
            }
        }

        function saveDraftSilent() {
            if (isSubmittedView || isReadOnly) return;
            if (currentWizardStep === 1 && (!airWizardState || !airWizardState.DraftId)) return;
            if (!airWizardState || !airWizardState.OrderId) return;
            if (isSavingDraft) return;
            isSavingDraft = true;
            collectWizardFormData();
            var token = $("input[name='__RequestVerificationToken']").val();

            $.ajax({
                url: '@Url.Action("SaveDraft", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-RequestVerificationToken': token },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    isSavingDraft = false;
                    if (res.success) {
                        if (res.draftId) {
                            airWizardState.DraftId = res.draftId;
                            $("#hdnDraftId").val(res.draftId);
                        }
                        if (res.draftNo) {
                            airWizardState.DraftNo = res.draftNo;
                        }
                        if (res.airId) {
                            airWizardState.AirId = res.airId;
                            $("#hdnAirId").val(res.airId);
                        }
                        $("#wizardDraftStatusText").text("Draft " + (airWizardState.DraftNo || "") + " saved at " + new Date().toLocaleTimeString());
                    } else {
                        $("#wizardDraftStatusText").text("Auto-save failed");
                    }
                },
                error: function () {
                    isSavingDraft = false;
                    $("#wizardDraftStatusText").text("Auto-save error");
                }
            });
        }

        function saveDraftExplicit() {
            if (isSubmittedView || isReadOnly) return;
            if (!airWizardState || !airWizardState.OrderId) {
                alert("Please select a Purchase Order before saving a draft.");
                return;
            }
            if (isSavingDraft) return;
            isSavingDraft = true;
            collectWizardFormData();
            var token = $("input[name='__RequestVerificationToken']").val();
            var btn = $(".btn-procurement-secondary:contains('Save Draft'), .btn-procurement-secondary:contains('Save as Draft')");
            btn.prop("disabled", true);

            $.ajax({
                url: '@Url.Action("SaveDraft", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-RequestVerificationToken': token },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    btn.prop("disabled", false);
                    isSavingDraft = false;
                    if (res.success) {
                        if (res.draftId) {
                            airWizardState.DraftId = res.draftId;
                            $("#hdnDraftId").val(res.draftId);
                        }
                        if (res.draftNo) {
                            airWizardState.DraftNo = res.draftNo;
                        }
                        if (res.airId) {
                            airWizardState.AirId = res.airId;
                            $("#hdnAirId").val(res.airId);
                        }
                        $("#wizardDraftStatusText").text("Draft " + (airWizardState.DraftNo || "") + " saved at " + new Date().toLocaleTimeString());
                        alert("Draft saved successfully! You can resume this inspection anytime.");
                    } else {
                        alert("Save failed: " + res.message);
                    }
                },
                error: function (xhr) {
                    btn.prop("disabled", false);
                    isSavingDraft = false;
                    alert("Error saving draft: " + (xhr.responseJSON ? xhr.responseJSON.message : xhr.statusText));
                }
            });
        }

        function submitInspectionFinal() {
            if (isSubmittedView || isReadOnly) return;
            submitInspectionExplicit();
        }

        function submitInspectionExplicit() {
            if (isSubmittedView || isReadOnly) return;
            collectWizardFormData();

            // Guard against submitting with incomplete inventory records
            var incompleteInventory = [];
            if (airWizardState.Items) {
                for (var i = 0; i < airWizardState.Items.length; i++) {
                    var itm = airWizardState.Items[i];
                    if (itm.Disposition === "Inventory" && (itm.InspectNowQty || 0) > 0) {
                        if (itm.ParentRequiresInventory) {
                            var req = Math.floor(itm.InspectNowQty);
                            var comp = (itm.InventoryDetails || []).filter(function (d) {
                                return typeof checkInventoryDetailCompleted === "function" ? checkInventoryDetailCompleted(itm.ItemExtnName, d) : d.IsCompleted;
                            }).length;
                            if (comp < req) {
                                incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " (" + (itm.Description || "Item") + "): " + comp + " of " + req + " completed");
                            }
                        }
                        if (itm.SubItems && itm.SubItems.length > 0) {
                            for (var s = 0; s < itm.SubItems.length; s++) {
                                var sub = itm.SubItems[s];
                                if (sub.RequiresInventory && (sub.InspectNowQty || 0) > 0) {
                                    var subReq = Math.floor(sub.InspectNowQty);
                                    var subComp = (sub.InventoryDetails || []).filter(function (d) {
                                        return typeof checkInventoryDetailCompleted === "function" ? checkInventoryDetailCompleted(sub.ItemExtnName, d) : d.IsCompleted;
                                    }).length;
                                    if (subComp < subReq) {
                                        incompleteInventory.push("Item #" + (itm.ItemNo || (i + 1)) + " - Sub-item '" + (sub.Description || "Component") + "': " + subComp + " of " + subReq + " completed");
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (incompleteInventory.length > 0) {
                showWizardMessage("Cannot submit inspection: Inventory details are incomplete:<br/>" + incompleteInventory.join("<br/>") + "<br/>Please return to Step 2 and complete all required unit records.");
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();
            var $btn = $("#btnSubmitForAcceptance, #btnSubmitInspection");
            $btn.prop('disabled', true).text('Submitting...');

            $.ajax({
                url: '@Url.Action("SubmitForAcceptance", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'X-RequestVerificationToken': token
                },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    if (res.success) {
                        window.location.href = '@(ViewBag.ReturnUrl ?? Url.Action("Index", "AIRs"))';
                    } else {
                        $btn.prop('disabled', false).html('<span class="k-icon k-i-check"></span> Submit for Acceptance');
                        showWizardMessage("Submission failed: " + res.message);
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html('<span class="k-icon k-i-check"></span> Submit for Acceptance');
                    var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.statusText;
                    showWizardMessage("Error submitting inspection: " + msg);
                }
            });
        }

        function selectPOForInspection(orderId, poNo) {
            if (isSubmittedView || isReadOnly) return;
            selectedOrderId = orderId;
            $("#hdnOrderId").val(orderId);
            loadPODetailsForWizard(orderId);
        }

        function loadPODetailsForWizard(orderId) {
            if (isSubmittedView || isReadOnly) return;
            var url = '@Url.Action("GetPOInspectionDetails", "AIRs")?orderId=' + orderId + (airId ? '&airId=' + airId : '');
            $.get(url, function (res) {
                if (res.success && res.data) {
                    airWizardState = res.data;
                    if (typeof updateStep1Summary === "function") {
                        updateStep1Summary(airWizardState);
                    }
                    if (typeof renderStep2Items === "function") {
                        renderStep2Items(airWizardState);
                    }
                    goToWizardStep(2);
                } else {
                    showWizardMessage("Failed to load PO details: " + res.message);
                }
            });
        }

        function proceedToStep3() {
            goToWizardStep(3);
        }

        function proceedToStep4() {
            goToWizardStep(4);
        }

        function openItemHistory(orderItemId) {
            var url = '@Url.Action("GetItemInspectionHistory", "AIRs")?orderItemId=' + orderItemId;
            $.get(url, function (html) {
                $("#itemHistoryModalContent").html(html);
                $("#itemHistoryModal").data("kendoWindow").center().open();
            });
        }

        function onSubmissionVersionChange(snapshotId) {
            if (!snapshotId) return;
            var targetAirId = airId || '@(Model.AirId.HasValue ? Model.AirId.Value.ToString() : "")';
            window.location.href = window.location.pathname + '?id=' + targetAirId + '&snapshotId=' + snapshotId;
        }

        function openWithdrawModal(targetId) {
            var aid = targetId || airId || '@(Model.AirId.HasValue ? Model.AirId.Value.ToString() : "")';
            $("#withdrawAirId").val(aid);
            $("#withdrawReason").val("");
            var win = $("#withdrawActionWindow").data("kendoWindow");
            if (win) win.center().open();
        }

        function submitWithdrawFromView() {
            var aid = $("#withdrawAirId").val();
            var reason = $("#withdrawReason").val();

            if (!reason || !reason.trim()) {
                alert("Please provide a reason for withdrawal.");
                return;
            }

            var token = $('input[name="__RequestVerificationToken"]').val();
            $("#btnConfirmWithdraw").prop("disabled", true).text("Processing...");

            $.ajax({
                url: '@Url.Action("WithdrawSubmission", "AIRs")',
                type: "POST",
                data: {
                    __RequestVerificationToken: token,
                    AirId: aid,
                    Reason: reason
                },
                success: function (res) {
                    if (res.success) {
                        $("#withdrawActionWindow").data("kendoWindow").close();
                        if (res.draftId) {
                            if (confirm((res.message || "Submission withdrawn successfully.") + "\n\nWould you like to open the newly created revision draft now?")) {
                                window.location.href = '@Url.Action("Wizard", "AIRs")?id=' + res.draftId;
                                return;
                            }
                        } else {
                            alert(res.message || "Submission withdrawn successfully.");
                        }
                        window.location.href = '@(ViewBag.ReturnUrl ?? Url.Action("Index", "AIRs"))';
                    } else {
                        alert(res.message || "Failed to process withdrawal.");
                    }
                },
                error: function () {
                    alert("A network error occurred. Please try again.");
                },
                complete: function () {
                    $("#btnConfirmWithdraw").prop("disabled", false).text("Confirm Withdrawal");
                }
            });
        }
    </script>
}


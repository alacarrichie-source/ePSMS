@*Wizard.cshtml*@
@model iLgs.Ai.Models.AIRWizardViewModel

@{
    ViewBag.Title = Model.IsRevisionMode ? "Revise Inspection Report" : "AIR Inspection Wizard";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="epsms-procurement po-wizard air-wizard">

    <!-- ================================================================
         BREADCRUMBS
         ================================================================ -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a>
        <span class="breadcrumb-separator">&gt;</span>
        <a href="@Url.Action("Index", "AIRs")">Acceptance &amp; Inspection Reports</a>
        <span class="breadcrumb-separator">&gt;</span>
        <span>@(Model.IsRevisionMode ? "Revise Inspection" : "Inspect Orders")</span>
    </div>

    <!-- ================================================================
         PAGE HEADER
         ================================================================ -->
    <div class="wizard-header">
        <div class="wizard-header-content">
            <h1 class="page-title">
                @(Model.IsRevisionMode ? "Revise Inspection Report" : "AIR Inspection Wizard")
            </h1>
            <p class="page-subtitle">
                Record physical deliveries, verify quantities against Purchase Orders, capture supplier invoices, and submit for official acceptance.
            </p>
        </div>

        <div class="wizard-header-actions">
            <span class="wizard-draft-status" aria-live="polite">
                <span class="wizard-draft-icon">
                    <span class="k-icon k-i-save"></span>
                </span>
                <span id="wizardDraftStatusText">@(Model.AirId.HasValue ? "Draft loaded" : "Not yet saved")</span>
            </span>

            <a href="@Url.Action("Index", "AIRs")" class="btn-procurement-secondary">
                <span class="k-icon k-i-close"></span>
                Cancel &amp; Exit
            </a>
        </div>
    </div>

    @if (Model.IsRevisionMode)
    {
        <!-- ============================================================
             REVISION NOTICE BANNER
             ============================================================ -->
        <div class="pr-revision-notice" style="border-left: 5px solid #dc2626; background: #fef2f2; margin-bottom: 20px; padding: 12px 16px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="k-icon k-i-warning" style="color: #dc2626; font-size: 18px;"></span>
                    <strong style="color: #991b1b; font-size: 14px;">Returned for Revision by Acceptance Officer</strong>
                </div>
                <p style="color: #7f1d1d; margin-bottom: 0; font-size: 13px;">
                    <strong>Acceptance Feedback:</strong> @Model.RevisionComments
                </p>
            </div>
            <div class="text-end">
                <span class="badge" style="background:#fee2e2; color:#991b1b; padding: 6px 12px; border-radius: 4px; font-weight:600;">Action Required</span>
            </div>
        </div>
    }

    <!-- ================================================================
         STEPPER (PURE HTML/CSS - CONSISTENT WITH PO WIZARD)
         ================================================================ -->
    <div class="data-card" style="margin-bottom: 20px; padding: 14px 20px; background-color: #ffffff; border-radius: 8px; border: 1px solid #cbd5e1;">
        <div class="wizard-stepper" style="display: flex; align-items: center; justify-content: space-between; max-width: 860px; margin: 0 auto;">
            <!-- Step 1 Tab -->
            <div class="wizard-step-item active" id="stepIndicator1" onclick="goToWizardStep(1)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle1" style="width: 28px; height: 28px; border-radius: 50%; background-color: #2c3e50; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; box-shadow: 0 0 0 4px #f1f5f9;">1</div>
                <span class="step-label" id="label1" style="margin-left: 8px; font-size: 12px; font-weight: 700; color: #2c3e50;">Select PO</span>
            </div>
            <div class="step-line" id="line1" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 2 Tab -->
            <div class="wizard-step-item" id="stepIndicator2" onclick="goToWizardStep(2)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle2" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">2</div>
                <span class="step-label" id="label2" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Inspect Items</span>
            </div>
            <div class="step-line" id="line2" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 3 Tab -->
            <div class="wizard-step-item" id="stepIndicator3" onclick="goToWizardStep(3)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle3" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">3</div>
                <span class="step-label" id="label3" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Invoice Entry</span>
            </div>
            <div class="step-line" id="line3" style="flex: 1; height: 2px; background-color: #cbd5e1; margin: 0 10px;"></div>

            <!-- Step 4 Tab -->
            <div class="wizard-step-item" id="stepIndicator4" onclick="goToWizardStep(4)" style="display: flex; align-items: center; cursor: pointer;">
                <div class="step-circle" id="circle4" style="width: 28px; height: 28px; border-radius: 50%; background-color: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">4</div>
                <span class="step-label" id="label4" style="margin-left: 8px; font-size: 12px; font-weight: 600; color: #64748b;">Review &amp; Submit</span>
            </div>
        </div>
    </div>

    <!-- ================================================================
         WIZARD CONTENT
         ================================================================ -->
    <div class="wizard-content">

        @using (Html.BeginForm("SubmitForAcceptance", "AIRs", FormMethod.Post, new { id = "airWizardForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AirId, new { id = "hdnAirId" })
            @Html.HiddenFor(m => m.OrderId, new { id = "hdnOrderId" })

            <div id="wizardValidationSummary" class="validation-summary-errors" style="display:none;"></div>

            <!-- STEP 1 -->
            <div id="wizardStepPane1" class="wizard-pane">
                @Html.Partial("_Step1_SelectPO")
            </div>

            <!-- STEP 2 -->
            <div id="wizardStepPane2" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step2_InspectItems")
            </div>

            <!-- STEP 3 -->
            <div id="wizardStepPane3" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step3_InvoiceEntry")
            </div>

            <!-- STEP 4 -->
            <div id="wizardStepPane4" class="wizard-pane" style="display:none;">
                @Html.Partial("_Step4_ReviewSubmit")
            </div>
        }
    </div>

</div>

<!-- ITEM HISTORY MODAL -->
@(Html.Kendo().Window()
    .Name("itemHistoryModal")
    .Title("Inspection History")
    .Width(750)
    .Height(450)
    .Modal(true)
    .Visible(false)
    .Actions(actions => actions.Close())
    .Content(@<text><div id="itemHistoryModalContent" class="p-3"></div></text>)
)

@section scripts {
    <script type="text/javascript">
        var currentWizardStep = @Convert.ToInt32(ViewBag.CurrentStep ?? 1);
        var airId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.AirId));
        var selectedOrderId = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.OrderId));
        var isRevisionMode = @(Model.IsRevisionMode ? "true" : "false");
        var airWizardState = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));
        var wizardAutoSaveTimer = null;
        var wizardReady = false;

        $(document).ready(function () {
            goToWizardStep(currentWizardStep);
            wizardReady = true;

            // If loaded with a pre-selected PO (e.g. from orderId param), render Step 2 immediately
            if (airWizardState && airWizardState.OrderId && (!airWizardState.Items || airWizardState.Items.length === 0)) {
                loadPODetailsForWizard(airWizardState.OrderId);
            } else if (airWizardState && airWizardState.Items && airWizardState.Items.length > 0) {
                if (typeof renderStep2Items === "function") renderStep2Items(airWizardState);
            }

            $("#airWizardForm").on("input change", "input, select, textarea", function () {
                scheduleWizardAutoSave();
            });
        });

        function updateStepperUI(step) {
            for (var i = 1; i <= 4; i++) {
                var circle = $('#circle' + i);
                var label = $('#label' + i);
                var line = $('#line' + i);

                if (i < step) {
                    circle.css({ 'background-color': '#1d4ed8', 'color': '#ffffff', 'box-shadow': 'none' }).html('<span class="k-icon k-i-check"></span>');
                    label.css({ 'color': '#2c3e50', 'font-weight': '600' });
                    if (line.length) line.css('background-color', '#1d4ed8');
                } else if (i === step) {
                    circle.css({ 'background-color': '#2c3e50', 'color': '#ffffff', 'box-shadow': '0 0 0 4px #f1f5f9' }).text(i);
                    label.css({ 'color': '#2c3e50', 'font-weight': '700' });
                } else {
                    circle.css({ 'background-color': '#e2e8f0', 'color': '#64748b', 'box-shadow': 'none' }).text(i);
                    label.css({ 'color': '#64748b', 'font-weight': '500' });
                    if (line.length) line.css('background-color', '#cbd5e1');
                }
            }
        }

        function goToWizardStep(step) {
            if (step < 1 || step > 4) return;

            // Step 1 Validation
            if (step > 1 && !selectedOrderId) {
                showWizardMessage("Please select a Purchase Order to inspect before proceeding.");
                return;
            }

            // Step 2 Validation (Inspect Items)
            if (step > 2) {
                var hasInspectQty = false;
                $(".inspect-now-input").each(function () {
                    var val = parseFloat($(this).val()) || 0;
                    if (val > 0) hasInspectQty = true;
                });

                if (!hasInspectQty && airWizardState.Items && airWizardState.Items.length > 0) {
                    hasInspectQty = airWizardState.Items.some(function (i) { return (i.InspectNowQty || 0) > 0; });
                }

                if (!hasInspectQty) {
                    showWizardMessage("You must enter an 'Inspect Now' quantity greater than 0 for at least one item.");
                    return;
                }
            }

            // Step 3 Validation (Invoice Entry)
            if (step > 3) {
                var invoiceNo = $("#txtInvoiceNo").val();
                if (!invoiceNo || !invoiceNo.trim()) {
                    showWizardMessage("Please enter the Invoice Number in Step 3.");
                    return;
                }
            }

            hideWizardMessage();

            // Hide all panes
            for (var i = 1; i <= 4; i++) {
                $("#wizardStepPane" + i).hide();
            }
            $("#wizardStepPane" + step).fadeIn(200);

            currentWizardStep = step;
            updateStepperUI(step);

            // Trigger step-specific sync hooks
            if (step === 3 && typeof syncStep3Form === "function") {
                syncStep3Form();
            }
            if (step === 4 && typeof renderStep4Review === "function") {
                renderStep4Review();
            }
        }

        function showWizardMessage(msg) {
            $("#wizardValidationSummary").html("<span>" + msg + "</span>").show();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hideWizardMessage() {
            $("#wizardValidationSummary").hide();
        }

        function scheduleWizardAutoSave() {
            if (!wizardReady) return;
            $("#wizardDraftStatusText").text("Unsaved changes...");
            clearTimeout(wizardAutoSaveTimer);
            wizardAutoSaveTimer = setTimeout(saveDraftSilent, 2000);
        }

        // Collect all form inputs into airWizardState before saving/submitting
        function collectWizardFormData() {
            if (!airWizardState) return;

            airWizardState.OrderId = selectedOrderId || $("#hdnOrderId").val();
            airWizardState.AirDate = $("#txtInspectionDate").val() || new Date().toISOString();
            airWizardState.InspectionDate = $("#txtInspectionDate").val() || new Date().toISOString();
            airWizardState.InspectionLocation = $("#txtInspectionLocation").val();
            airWizardState.InspectorName = $("#txtInspectorName").val();
            airWizardState.InspectorDesignation = $("#txtInspectorDesignation").val();
            airWizardState.InspectionCommittee = $("#txtInspectionCommittee").val();
            airWizardState.GeneralRemarks = $("#txtGeneralRemarks").val();

            if (!airWizardState.Invoice) airWizardState.Invoice = {};
            airWizardState.Invoice.InvoiceNo = $("#txtInvoiceNo").val();
            airWizardState.Invoice.InvoiceDate = $("#txtInvoiceDate").val() || new Date().toISOString();
            airWizardState.Invoice.DrNo = $("#txtDrNo").val();
            airWizardState.Invoice.InvoiceAmount = parseFloat($("#txtInvoiceAmount").val()) || 0;
            airWizardState.Invoice.InvoiceType = $("#ddlInvoiceType").val();
            airWizardState.Invoice.BillingReference = $("#txtBillingReference").val();

            // Collect line item inspect quantities and remarks from Step 2 inputs
            if (airWizardState.Items && airWizardState.Items.length > 0) {
                airWizardState.Items.forEach(function (item, idx) {
                    var inputQty = $("#txtInspectNow_" + idx);
                    if (inputQty.length) {
                        item.InspectNowQty = parseFloat(inputQty.val()) || 0;
                    }
                    var inputRemarks = $("#txtRemarks_" + idx);
                    if (inputRemarks.length) {
                        item.Remarks = inputRemarks.val() || "";
                    }
                });
            }
        }

        function saveDraftSilent() {
            collectWizardFormData();
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("SaveDraft", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'X-RequestVerificationToken': token
                },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    if (res.success) {
                        airWizardState.AirId = res.airId;
                        $("#hdnAirId").val(res.airId);
                        $("#wizardDraftStatusText").text("Draft saved at " + new Date().toLocaleTimeString());
                    } else {
                        $("#wizardDraftStatusText").text("Auto-save failed");
                    }
                },
                error: function () {
                    $("#wizardDraftStatusText").text("Auto-save error");
                }
            });
        }

        function saveDraftExplicit() {
            collectWizardFormData();
            var token = $('input[name="__RequestVerificationToken"]').val();
            var $btn = $(".btn-procurement-secondary:contains('Save Draft')");
            $btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("SaveDraft", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'X-RequestVerificationToken': token
                },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    $btn.prop('disabled', false);
                    if (res.success) {
                        airWizardState.AirId = res.airId;
                        $("#hdnAirId").val(res.airId);
                        $("#wizardDraftStatusText").text("Draft saved at " + new Date().toLocaleTimeString());
                        alert("Draft saved successfully! You can resume this inspection anytime.");
                    } else {
                        alert("Save failed: " + res.message);
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false);
                    alert("Error saving draft: " + (xhr.responseJSON ? xhr.responseJSON.message : xhr.statusText));
                }
            });
        }

        function submitInspectionExplicit() {
            collectWizardFormData();
            var token = $('input[name="__RequestVerificationToken"]').val();
            var $btn = $("#btnSubmitInspection");
            $btn.prop('disabled', true).text('Submitting...');

            $.ajax({
                url: '@Url.Action("SubmitForAcceptance", "AIRs")',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'X-RequestVerificationToken': token
                },
                data: JSON.stringify(airWizardState),
                success: function (res) {
                    if (res.success) {
                        window.location.href = '@Url.Action("Index", "AIRs")';
                    } else {
                        $btn.prop('disabled', false).html('<span class="k-icon k-i-check"></span> Submit for Official Acceptance');
                        showWizardMessage("Submission failed: " + res.message);
                    }
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).html('<span class="k-icon k-i-check"></span> Submit for Official Acceptance');
                    var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.statusText;
                    showWizardMessage("Error submitting inspection: " + msg);
                }
            });
        }

        function selectPOForInspection(orderId, poNo) {
            selectedOrderId = orderId;
            $("#hdnOrderId").val(orderId);
            loadPODetailsForWizard(orderId);
        }

        function loadPODetailsForWizard(orderId) {
            var url = '@Url.Action("GetPOInspectionDetails", "AIRs")?orderId=' + orderId + (airId ? '&airId=' + airId : '');
            $.get(url, function (res) {
                if (res.success) {
                    airWizardState = res.data;
                    if (typeof renderStep2Items === "function") {
                        renderStep2Items(airWizardState);
                    }
                    goToWizardStep(2);
                } else {
                    showWizardMessage("Failed to load PO details: " + res.message);
                }
            });
        }

        function proceedToStep3() {
            goToWizardStep(3);
        }

        function proceedToStep4() {
            goToWizardStep(4);
        }

        function openItemHistory(orderItemId) {
            var url = '@Url.Action("GetItemInspectionHistory", "AIRs")?orderItemId=' + orderItemId;
            $.get(url, function (html) {
                $("#itemHistoryModalContent").html(html);
                $("#itemHistoryModal").data("kendoWindow").center().open();
            });
        }
    </script>
}

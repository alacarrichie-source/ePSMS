@using Kendo.Mvc.UI

<div class="wizard-card step4-review-container">
    <div class="step4-header mb-4">
        <div>
            <div class="step4-title-row d-flex align-items-center gap-2 mb-1">
                <h2 class="mb-0">Step 4: Review Acceptance &amp; Post Official Report</h2>
                <span class="k-badge k-badge-solid k-badge-success k-rounded-md">Ready to Post</span>
            </div>
            <p class="subtitle mb-0">Confirm government acceptance decisions and item dispositions before committing official obligation to property records.</p>
        </div>
        <div class="step4-metrics d-flex align-items-center gap-3">
            <div class="step4-readiness is-ready p-2 px-3 rounded border d-flex align-items-center gap-2 bg-light">
                <span class="k-icon k-i-check text-success fs-5"></span>
                <div>
                    <strong class="d-block small text-success">Acceptance Verified</strong>
                    <span class="small text-muted">Ready to obligate</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="p-3 bg-light rounded border h-100">
                <span class="small text-muted fw-bold d-block mb-1">Purchase Order</span>
                <div class="fs-6 fw-bold text-primary" id="accRevPONo">--</div>
                <div class="small text-dark" id="accRevSupplier">--</div>
                <div class="small text-muted" id="accRevDept">--</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light rounded border h-100">
                <span class="small text-muted fw-bold d-block mb-1">Inspection Record</span>
                <div class="fs-6 fw-bold" id="accRevInspector">--</div>
                <div class="small text-muted" id="accRevInspDate">--</div>
                <div class="small text-muted" id="accRevInvoice">--</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-success bg-opacity-10 rounded border border-success h-100">
                <span class="small text-success fw-bold d-block mb-1">Acceptance Accountability</span>
                <div class="fs-6 fw-bold text-dark" id="accRevOfficer">--</div>
                <div class="small text-dark" id="accRevAccDate">--</div>
                <div class="small text-muted" id="accRevOffice">--</div>
            </div>
        </div>
    </div>

    <!-- Final Table Summary -->
    <div class="mb-4">
        <h4 class="fs-6 fw-bold text-dark mb-2"><span class="k-icon k-i-check-outline"></span> Official Acceptance &amp; Disposition Schedule</h4>
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th style="width:70px;">Item No.</th>
                        <th>Description</th>
                        <th style="width:60px;">Unit</th>
                        <th style="width:110px;" class="text-end">Inspected Qty</th>
                        <th style="width:110px;" class="text-end text-success fw-bold">Accepted Qty</th>
                        <th style="width:140px;">Disposition</th>
                        <th>Target Destination / Recipient</th>
                    </tr>
                </thead>
                <tbody id="accRevTableBody" class="small">
                    <!-- Populated dynamically -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Acceptance Certification -->
    <div class="step4-certification p-3 bg-white rounded border mb-4">
        <label for="chkAcceptanceCert" class="d-flex align-items-start gap-2 mb-0" style="cursor:pointer;">
            <input type="checkbox" id="chkAcceptanceCert" class="mt-1" onchange="toggleAcceptanceCert(this.checked)" />
            <span class="small">
                <strong>Acceptance Officer Official Certification:</strong> I certify that the items and quantities listed above have been inspected by the designated committee and are hereby officially accepted on behalf of the Local Government Unit. The post-acceptance dispositions (Inventory / For Distribution) have been allocated in compliance with COA and GAM regulations.
            </span>
        </label>
    </div>

    <!-- Actions Bar -->
    <div class="wizard-summary-bar wizard-final-actions">
        <button type="button" class="btn-procurement-secondary" onclick="goToAcceptanceStep(3)">
            <span class="k-icon k-i-arrow-left"></span> Back to Disposition
        </button>

        <div class="wizard-action-group">
            <button type="button" class="btn-procurement-secondary text-danger border-danger" onclick="openReturnRevisionModal()">
                <span class="k-icon k-i-undo text-danger"></span> Return for Revision
            </button>
            <button type="button" id="btnPostAcceptance" class="btn-procurement-primary bg-success border-success" onclick="postAcceptanceFinal()" disabled="disabled">
                <span class="k-icon k-i-check"></span> Post Official Acceptance
            </button>
        </div>
    </div>

</div>

<script type="text/javascript">
    function collectAcceptanceFormData() {
        if (!acceptanceState) return;
        acceptanceState.AcceptanceDate = $("#txtAcceptanceDate").val() || new Date();
        acceptanceState.AcceptedBy = $("#txtAcceptedBy").val();
        acceptanceState.AcceptedByDesignation = $("#txtAcceptedByDesignation").val();
        acceptanceState.DepartmentOffice = $("#txtDepartmentOffice").val();
        acceptanceState.AcceptanceRemarks = $("#txtAcceptanceRemarks").val();
    }

    function renderStep4AcceptanceReview() {
        collectAcceptanceFormData();

        $("#accRevPONo").text(acceptanceState.PONumber || "N/A");
        $("#accRevSupplier").text("Supplier: " + (acceptanceState.SupplierName || "N/A"));
        $("#accRevDept").text("Dept: " + (acceptanceState.Department || "N/A"));

        $("#accRevInspector").text(acceptanceState.InspectorName || "GSO Inspection Team");
        $("#accRevInspDate").text("Inspected: " + (acceptanceState.InspectionDate ? new Date(acceptanceState.InspectionDate).toLocaleDateString() : "--"));
        $("#accRevInvoice").text("Invoice: " + (acceptanceState.InvoiceNo || "N/A"));

        $("#accRevOfficer").text(acceptanceState.AcceptedBy + (acceptanceState.AcceptedByDesignation ? " (" + acceptanceState.AcceptedByDesignation + ")" : ""));
        $("#accRevAccDate").text("Date: " + (acceptanceState.AcceptanceDate ? new Date(acceptanceState.AcceptanceDate).toLocaleDateString() : new Date().toLocaleDateString()));
        $("#accRevOffice").text("Office: " + (acceptanceState.DepartmentOffice || "GSO Warehouse"));

        var tbody = $("#accRevTableBody");
        tbody.empty();

        if (acceptanceState.Items) {
            acceptanceState.Items.forEach(function (i) {
                var dispBadge = i.Disposition === "ForDistribution"
                    ? "<span class='badge bg-success'>For Distribution</span>"
                    : "<span class='badge bg-primary'>Inventory</span>";

                var target = i.Disposition === "ForDistribution"
                    ? ((i.DestinationDepartment || "Direct Department") + (i.DestinationCustodian ? " (c/o " + i.DestinationCustodian + ")" : ""))
                    : "Warehouse Stock / Property Cards";

                var tr = "<tr>" +
                         "  <td class='fw-bold'>" + (i.ItemNo || "--") + "</td>" +
                         "  <td>" + (i.Description || "Item") + "</td>" +
                         "  <td class='text-muted'>" + (i.Unit || "") + "</td>" +
                         "  <td class='text-end font-monospace'>" + Number(i.InspectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>" +
                         "  <td class='text-end font-monospace fw-bold text-success'>" + Number(i.AcceptedQty != null ? i.AcceptedQty : i.InspectedQty).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>" +
                         "  <td>" + dispBadge + "</td>" +
                         "  <td class='small'>" + target + "</td>" +
                         "</tr>";
                tbody.append(tr);
            });
        }
    }

    function toggleAcceptanceCert(checked) {
        $("#btnPostAcceptance").prop("disabled", !checked);
    }
</script>

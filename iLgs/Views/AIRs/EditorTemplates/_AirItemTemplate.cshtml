@model iLgs.Models.AIRItemVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.AirId)

    <fieldset>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.OrderItemId, "LabelGuid")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderItemId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select stock/property No.")
                        .DataTextField("Code")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetPoItems", "Getters").Data("DataOrderItemId");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("20%");
                            c.Add().Field("Name").Title("Item Name").Width("50%");
                            c.Add().Field("Unit").Title("Unit").Width("15%");
                            c.Add().Field("Qty").Title("Type").Width("15%");
                            c.Add().Field("UnitCost").Title("Type").Width("15%");

                        })
                        .Suggest(true).Enable(false)
                        .Events(e => { e.Select("onSelectOrderItemId"); })
                )
                @Html.ValidationMessageFor(m => m.OrderItemId)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.PsItem, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsItem).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.Description, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.Description).Rows(3).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.OrderDescription, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.OrderDescription).Rows(3).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.PsUnit, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsUnit).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(model => model.Qty, "LabelDecimal")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Enable(false).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                //.Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.Qty)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.InvDist, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.InvDist)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select a value..")
                            .DataTextField("Description")
                            .DataValueField("Code")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetinvDistList", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Description").Title("Description").Width("100%");
                            })
                            .Suggest(true)
                )
                @Html.ValidationMessageFor(m => m.InvDist)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.Remarks, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(3).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.Remarks)
            </div>
        </div>

    </fieldset>
}
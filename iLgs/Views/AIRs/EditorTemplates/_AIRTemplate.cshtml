@model iLgs.Models.AIR_VM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)

    <fieldset>
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.AIRNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.AIRNo).Placeholder("(AUTO)").HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.AIRNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.AIRDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.AIRDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.AIRDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.OrderId, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select PO No.")
                            .DataTextField("PoNo")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPoNos", "Getters");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("PoNo").Title("PO No.").Width("30%");
                                c.Add().Field("PoDate").Title("Date").Width("30%");
                                c.Add().Field("Department").Title("Department").Width("40%");
                            })
                            .Events(e => { e.Select("onSelectOrderId"); })
                            .Suggest(true)
                    )
                    @Html.ValidationMessageFor(model => model.OrderId)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.PoDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.PoDate).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.PoDate)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Supplier, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Supplier).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                @Html.LabelFor(model => model.Department, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(m => m.Department).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.InvoiceNo, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().TextBoxFor(model => model.InvoiceNo).HtmlAttributes(new { style = "width:100%; max-width:100%;text-transform: uppercase;" }))
                    @Html.ValidationMessageFor(model => model.InvoiceNo)
                </div>
            </div>
            <div class="col-md-6">
                @Html.LabelFor(model => model.InvoiceDate, htmlAttributes: new { @class = "col-md-12" })
                <div class="col-md-12">
                    @(Html.Kendo().DatePickerFor(model => model.InvoiceDate).Enable(true).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                    @Html.ValidationMessageFor(model => model.InvoiceDate)
                </div>
            </div>
        </div>

        <br />

        <div class="row clearfix">
            <div class="col-md-6">
                <section id="acceptance" class="card ra-section">
                    <div class="card-header">Acceptance</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.AcceptedDate, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.AcceptedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-offset-2">
                                    @(Html.Kendo().CheckBoxFor(m => m.IsComplete).Label("Complete"))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-offset-2">
                                    @(Html.Kendo().CheckBoxFor(m => m.IsPartial).Label("Partial (pls. specify)"))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-3">
                                    &nbsp;
                                </div>
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.Remarks).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.Custodian, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.Custodian).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-md-6">
                <section id="inspection" class="card ra-section">
                    <div class="card-header">Inspection</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.InspectedDate, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().DatePickerFor(m => m.InspectedDate).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-offset-2">
                                    @(Html.Kendo().CheckBoxFor(m => m.IsInspected).Label("Inspected, verified and found in order as to quality and specifications."))
                                </div>
                            </div>
                        </div>
                        <br />                        
                        <div class="row">
                            <div class="col-md-12">
                                @Html.LabelFor(model => model.Officer, htmlAttributes: new { @class = "col-md-3" })
                                <div class="col-md-9">
                                    @(Html.Kendo().TextBoxFor(m => m.Officer).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>

    </fieldset>
}


    function reconcileSubItemInventoryDetails(item, sub) {
        if (!sub) return;
        if (!sub.InventoryDetails) sub.InventoryDetails = [];

        var parentDisp = (item && item.Disposition) ? item.Disposition : (airWizardState ? airWizardState.Disposition : "Inventory");
        var subReqInv = sub.RequiresInventory && (parentDisp === "Inventory");

        if (!subReqInv || (sub.InspectNowQty || 0) <= 0) {
            sub.RequiredInventoryCount = 0;
            sub.CompletedInventoryCount = 0;
            return;
        }

        var req = Math.floor(sub.InspectNowQty);
        sub.RequiredInventoryCount = req;

        var subRatio = (sub.QtyPerParent > 0) ? sub.QtyPerParent : 1;

        if (item && item.Allocations && item.Allocations.length > 0) {
            var reconciledDetails = [];
            var globalUnitNo = 1;

            item.Allocations.forEach(function (alloc) {
                var allocQty = Math.floor((alloc.QtyInspected || 0) * subRatio);
                var allocOirId = (alloc.OrderItemRequestId || "").toLowerCase();

                var existingForAlloc = sub.InventoryDetails.filter(function (d) {
                    return d.OrderItemRequestId && d.OrderItemRequestId.toLowerCase() === allocOirId;
                });

                if (existingForAlloc.length === 0 && item.Allocations.length === 1) {
                    existingForAlloc = sub.InventoryDetails.slice(0);
                }

                if (existingForAlloc.length > allocQty) {
                    existingForAlloc = existingForAlloc.slice(0, allocQty);
                } else {
                    while (existingForAlloc.length < allocQty) {
                        existingForAlloc.push({
                            OrderItemRequestId: alloc.OrderItemRequestId,
                            RequestId: alloc.RequestId || null,
                            RequestItemId: alloc.RequestItemId || null,
                            PRNumber: alloc.PRNumber || "",
                            DepartmentId: alloc.DepartmentId || null,
                            DepartmentName: alloc.Department || "",
                            AirSubItemId: sub.AirSubItemId || null,
                            IsCompleted: false
                        });
                    }
                }

                existingForAlloc.forEach(function (d) {
                    d.OrderItemRequestId = alloc.OrderItemRequestId;
                    d.RequestId = alloc.RequestId || d.RequestId || null;
                    d.RequestItemId = alloc.RequestItemId || d.RequestItemId || null;
                    d.PRNumber = alloc.PRNumber || d.PRNumber || "";
                    d.DepartmentId = alloc.DepartmentId || d.DepartmentId || null;
                    d.DepartmentName = alloc.Department || d.DepartmentName || "";
                    d.AirSubItemId = sub.AirSubItemId || d.AirSubItemId || null;
                    d.ContentNo = globalUnitNo;
                    d.TContentNo = globalUnitNo;
                    d.UnitIndex = globalUnitNo;
                    d.UnitNumber = globalUnitNo;
                    d.IsCompleted = checkInventoryDetailCompleted(sub.ItemExtnName, d);
                    globalUnitNo++;
                    reconciledDetails.push(d);
                });
            });

            sub.InventoryDetails = reconciledDetails;
        } else {
            if (sub.InventoryDetails.length > req) {
                sub.InventoryDetails = sub.InventoryDetails.slice(0, req);
            } else {
                while (sub.InventoryDetails.length < req) {
                    var uIdx = sub.InventoryDetails.length + 1;
                    sub.InventoryDetails.push({
                        UnitIndex: uIdx,
                        UnitNumber: uIdx,
                        ContentNo: uIdx,
                        TContentNo: uIdx,
                        PRNumber: (item ? item.PRNumber : "") || "",
                        DepartmentName: (item ? item.Department : "") || "",
                        AirSubItemId: sub.AirSubItemId || null,
                        IsCompleted: false
                    });
                }
            }
            sub.InventoryDetails.forEach(function (d, i) {
                d.UnitIndex = i + 1;
                d.UnitNumber = i + 1;
                d.ContentNo = i + 1;
                d.TContentNo = i + 1;
                d.PRNumber = d.PRNumber || (item ? item.PRNumber : "") || "";
                d.DepartmentName = d.DepartmentName || (item ? item.Department : "") || "";
                d.IsCompleted = checkInventoryDetailCompleted(sub.ItemExtnName, d);
            });
        }

        var compCount = 0;
        sub.InventoryDetails.forEach(function (d) {
            if (d.IsCompleted) compCount++;
        });
        sub.CompletedInventoryCount = compCount;
    }
    function onItemDispositionChange(idx, newDisp) {
        if (typeof isSubmittedView !== 'undefined' && isSubmittedView) return;
        if (typeof isReadOnly !== 'undefined' && isReadOnly) return;
        var item = airWizardState.Items[idx];
        if (!item) return;

        var prevDisp = item.Disposition;
        if (prevDisp === "Inventory" && newDisp !== "Inventory") {
            var hasData = (item.InventoryDetails || []).some(function (d) {
                return d && (d.SerialNo || d.EngineNo || d.ChasisNo || d.PlateNo || d.PIN || d.Address || d.ProjectName || d.IsCompleted);
            });
            if (!hasData && item.SubItems) {
                hasData = item.SubItems.some(function (sub) {
                    return (sub.InventoryDetails || []).some(function (d) {
                        return d && (d.SerialNo || d.EngineNo || d.ChasisNo || d.PlateNo || d.PIN || d.Address || d.ProjectName || d.IsCompleted);
                    });
                });
            }

            if (hasData) {
                var confirmed = confirm("Changing disposition from Inventory to " + newDisp + " will discard entered inventory details for this item and its sub-items. Are you sure you want to proceed?");
                if (!confirmed) {
                    $("#ddlItemDisposition_" + idx).val("Inventory");
                    return;
                }
            }
            item.InventoryDetails = [];
            item.CompletedInventoryCount = 0;
            item.RequiredInventoryCount = 0;
            if (item.SubItems) {
                item.SubItems.forEach(function (sub) {
                    sub.InventoryDetails = [];
                    sub.CompletedInventoryCount = 0;
                    sub.RequiredInventoryCount = 0;
                });
            }
        }

        item.Disposition = newDisp;
        if (newDisp === "Inventory") {
            reconcileItemInventoryDetails(item);
            if (item.SubItems) {
                item.SubItems.forEach(function (sub) {
                    sub.RequiresInventory = !!(sub.ItemExtnName);
                    reconcileSubItemInventoryDetails(item, sub);
                });
            }
        }

        updateInventoryDetailsButton(idx);
        if (item.SubItems) {
            item.SubItems.forEach(function (sub, sIdx) {
                updateSubItemInventoryDetailsButton(idx, sIdx);
            });
        }
        scheduleWizardAutoSave();
    }

    function onAllocationInspectNowChange(idx, aIdx, valStr) {
        if (typeof isSubmittedView !== 'undefined' && isSubmittedView) return;
        if (typeof isReadOnly !== 'undefined' && isReadOnly) return;
        var val = parseFloat(valStr) || 0;
        var item = airWizardState.Items[idx];
        if (!item || !item.Allocations || !item.Allocations[aIdx]) return;
        var alloc = item.Allocations[aIdx];

        var maxAllowed = alloc.RemainingBefore;
        if (val < 0) {
            val = 0;
            $("#txtAllocInspectNow_" + idx + "_" + aIdx).val(0);
        } else if (val > maxAllowed) {
            val = maxAllowed;
            $("#txtAllocInspectNow_" + idx + "_" + aIdx).val(maxAllowed);
            alert("Quantity for PR " + (alloc.PRNumber || "") + " cannot exceed Remaining quantity (" + maxAllowed + ").");
        }

        alloc.QtyInspected = val;

        // Update allocation row total inspected
        var allocTotal = (alloc.PreviousInspected || 0) + val;
        $("#lblAllocTotal_" + idx + "_" + aIdx).text(Number(allocTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Recompute parent InspectNowQty as sum of all child allocations
        var parentSum = 0;
        item.Allocations.forEach(function (a) {
            parentSum += (a.QtyInspected || 0);
        });

        var oldQty = item.InspectNowQty || 0;
        item.InspectNowQty = parentSum;
        $("#txtInspectNow_" + idx).val(parentSum);

        var parentTotal = (item.PreviousInspectedQty || 0) + parentSum;
        $("#lblTotalInspected_" + idx).text(Number(parentTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Reconcile inventory details count
        reconcileItemInventoryDetails(item);
        updateInventoryDetailsButton(idx);

        // If parent item has Set/Lot sub-items, proportionally adjust sub-items
        if (item.IsSetLot && item.SubItems) {
            item.SubItems.forEach(function (sub, sIdx) {
                var subRatio = (sub.QtyPerParent > 0) ? sub.QtyPerParent : ((sub.ExpectedQty || 0) / (item.OrderedQty || 1) || 1);
                var subVal = parentSum * subRatio;
                if (subVal > sub.RemainingBeforeQty) subVal = sub.RemainingBeforeQty;
                sub.InspectNowQty = subVal;
                $("#txtSubInspectNow_" + idx + "_" + sIdx).val(subVal);
                var subTotal = (sub.PreviousInspectedQty || 0) + subVal;
                $("#lblSubTotal_" + idx + "_" + sIdx).text(Number(subTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

                reconcileSubItemInventoryDetails(item, sub);
                updateSubItemInventoryDetailsButton(idx, sIdx);
            });
        }

        recalculateGrandTotals();
        scheduleWizardAutoSave();
    }


    function onModalUnitFieldChange(uIdx) {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var extnName = item.ItemExtnName || "ItemExtnOther";

        var row = $("#unitRow_" + uIdx);
        var dummy = readUnitFromRow(row, extnName);
        var isComp = checkInventoryDetailCompleted(extnName, dummy);

        var cell = $("#unitStatusCell_" + uIdx);
        if (isComp) {
            cell.html("<span class='badge bg-success'>OK</span>");
        } else {
            cell.html("<span class='badge bg-light text-muted border'>--</span>");
        }

        updateModalCompletionCounter();
    }

    function readUnitFromRow(row, extnName) {
        var u = {
            Condition: row.find(".unit-condition").val() || "Brand New"
        };

        if (extnName === "ItemExtnVehicle") {
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.ConductionNo = row.find(".unit-conduction").val() || "";
            u.EngineNo = row.find(".unit-engine").val() || "";
            u.ChasisNo = row.find(".unit-chasis").val() || "";
            u.PlateNo = row.find(".unit-plate").val() || "";
            u.Color = row.find(".unit-color").val() || "";
            u.YearModel = row.find(".unit-year").val() || "";
            u.SeriesNo = row.find(".unit-series").val() || "";
        } else if (extnName === "ItemExtnLand") {
            u.PIN = row.find(".unit-pin").val() || "";
            u.TctNo = row.find(".unit-tct").val() || "";
            u.LotNo = row.find(".unit-lot").val() || "";
            u.SurveyNo = row.find(".unit-survey").val() || "";
            u.Area = row.find(".unit-area").val() || "";
            u.Address = row.find(".unit-address").val() || "";
            u.SerialNo = u.PIN || u.TctNo || "";
        } else if (extnName === "ItemExtnBuilding") {
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.ProjectName = row.find(".unit-project").val() || "";
            u.BuildingType = row.find(".unit-buildingtype").val() || "";
            u.NumStoreys = parseInt(row.find(".unit-storeys").val()) || null;
            u.FloorArea = row.find(".unit-floorarea").val() || "";
            u.Address = row.find(".unit-address").val() || "";
        } else { // ItemExtnOther
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.Brand = row.find(".unit-brand").val() || "";
            u.Model = row.find(".unit-model").val() || "";
            u.Remarks = row.find(".unit-remarks").val() || "";
        }

        return u;
    }

    function updateModalCompletionCounter() {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var extnName = item.ItemExtnName || "ItemExtnOther";

        var comp = 0;
        $("#modalInventoryTbody tr").each(function () {
            var u = readUnitFromRow($(this), extnName);
            if (checkInventoryDetailCompleted(extnName, u)) comp++;
        });

        var req = item.RequiredInventoryCount;
        var badge = $("#modalLiveCompletionBadge");
        if (comp >= req && req > 0) {
            badge.removeClass("bg-warning text-dark").addClass("bg-success text-white").text(comp + " of " + req + " Completed");
        } else {
            badge.removeClass("bg-success text-white").addClass("bg-warning text-dark").text(comp + " of " + req + " Completed");
        }
    }

    function applyBatchCondition() {
        var val = $("#batchConditionSelect").val();
        $("#modalInventoryTbody .unit-condition").val(val);
        $("#modalInventoryTbody tr").each(function (uIdx) {
            onModalUnitFieldChange(uIdx);
        });
    }

    function applyBatchSerials() {
        var prefix = $("#batchSerialPrefix").val() || "";
        var startNo = parseInt($("#batchSerialStart").val());
        if (isNaN(startNo)) {
            alert("Please enter a valid starting serial number (e.g. 1001).");
            return;
        }

        $("#modalInventoryTbody tr").each(function (idx) {
            var serialInput = $(this).find(".unit-serial");
            if (serialInput.length) {
                serialInput.val(prefix + (startNo + idx));
            }
            onModalUnitFieldChange(idx);
        });
    }

    function copyUnit1ToAll() {
        var rows = $("#modalInventoryTbody tr");
        if (rows.length < 2) return;

        var row1 = rows.eq(0);
        var item = airWizardState.Items[activeModalItemIdx];
        var extnName = item.ItemExtnName || "ItemExtnOther";

        if (extnName === "ItemExtnVehicle") {
            var color = row1.find(".unit-color").val();
            var year = row1.find(".unit-year").val();
            var series = row1.find(".unit-series").val();
            rows.slice(1).each(function () {
                if (color) $(this).find(".unit-color").val(color);
                if (year) $(this).find(".unit-year").val(year);
                if (series) $(this).find(".unit-series").val(series);
            });
        } else if (extnName === "ItemExtnLand" || extnName === "ItemExtnBuilding") {
            var addr = row1.find(".unit-address").val();
            var proj = row1.find(".unit-project").val();
            var bType = row1.find(".unit-buildingtype").val();
            rows.slice(1).each(function () {
                if (addr) $(this).find(".unit-address").val(addr);
                if (proj) $(this).find(".unit-project").val(proj);
                if (bType) $(this).find(".unit-buildingtype").val(bType);
            });
        } else {
            var brand = row1.find(".unit-brand").val();
            var model = row1.find(".unit-model").val();
            var remarks = row1.find(".unit-remarks").val();
            rows.slice(1).each(function () {
                if (brand) $(this).find(".unit-brand").val(brand);
                if (model) $(this).find(".unit-model").val(model);
                if (remarks) $(this).find(".unit-remarks").val(remarks);
            });
        }

        rows.each(function (idx) {
            onModalUnitFieldChange(idx);
        });
    }

    function saveInventoryModal() {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var extnName = item.ItemExtnName || "ItemExtnOther";

        var details = [];
        var compCount = 0;

        $("#modalInventoryTbody tr").each(function (uIdx) {
            var u = readUnitFromRow($(this), extnName);
            u.UnitIndex = uIdx + 1;
            u.UnitNumber = uIdx + 1;
            u.IsCompleted = checkInventoryDetailCompleted(extnName, u);

            // Retain existing ExtnId if previously persisted
            if (item.InventoryDetails && item.InventoryDetails[uIdx]) {
                u.ExtnId = item.InventoryDetails[uIdx].ExtnId;
                u.AirItemId = item.InventoryDetails[uIdx].AirItemId;
            }

            if (u.IsCompleted) compCount++;
            details.push(u);
        });

        item.InventoryDetails = details;
        item.RequiredInventoryCount = item.RequiredInventoryCount || details.length;
        item.CompletedInventoryCount = compCount;

        updateInventoryDetailsButton(activeModalItemIdx);
        closeInventoryModal();
        scheduleWizardAutoSave();
    }

    function closeInventoryModal() {
        var win = $("#inventoryDetailsWindow").data("kendoWindow");
        if (win) {
            win.close();
        }
        activeModalItemIdx = -1;
    }
</script>

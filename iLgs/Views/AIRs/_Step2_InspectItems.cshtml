@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="wizard-card">

    <div class="wizard-card-header">
        <div>
            <h2>Step 2: Inspect Items &amp; Record Deliveries</h2>
            <p class="subtitle">
                Enter physically verified quantities delivered against each Purchase Order item. For items designated as Inventory, enter physical inventory details per inspected unit.
            </p>
        </div>
    </div>

    <!-- ============================================================
         INSPECTION METADATA PANEL
         Field order: Inspection Date -> Inspection Committee -> Inspection Location (optional) -> Inspector Name -> Designation -> Remarks
         ============================================================ -->
    <div class="form-card mb-4 p-3 bg-light rounded border">
        <h4 class="fs-6 fw-bold mb-3 text-primary"><span class="k-icon k-i-user"></span> Inspection Header &amp; Committee Details</h4>
        <div class="row g-3">
            <div class="col-md-4">
                <label for="txtInspectionDate" class="form-label small fw-bold">Inspection Date <span class="text-danger">*</span></label>
                <input type="date" id="txtInspectionDate" class="form-control-custom w-100" value="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="scheduleWizardAutoSave()" />
            </div>
            <div class="col-md-4">
                <label for="txtInspectionCommittee" class="form-label small fw-bold">Inspection Committee / Team Members <span class="text-muted fw-normal">(Optional)</span></label>
                <input type="text" id="txtInspectionCommittee" class="form-control-custom w-100" placeholder="Names of assisting committee members..." onchange="scheduleWizardAutoSave()" />
            </div>
            <div class="col-md-4">
                <label for="txtInspectionLocation" class="form-label small fw-bold">Inspection Location <span class="text-muted fw-normal">(Optional)</span></label>
                <input type="text" id="txtInspectionLocation" class="form-control-custom w-100" placeholder="e.g. GSO Warehouse, City Hall" onchange="scheduleWizardAutoSave()" />
            </div>
            <div class="col-md-4">
                <label for="InspectorName" class="form-label small fw-bold">Inspector Name <span class="text-danger">*</span></label>
                @(Html.Kendo().MultiColumnComboBox()
                    .Name("InspectorName")
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;", id = "InspectorName" })
                    .Placeholder("Select Officer")
                    .DataTextField("Description")
                    .DataValueField("Description")
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetOfficers", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Description").Title("Name").Width("60%");
                        c.Add().Field("Desc2").Title("Designation").Width("40%");
                    })
                    .Events(e => e.Select("onInspectorSelect").Change("onInspectorChange"))
                    .Suggest(true)
                )
            </div>
            <div class="col-md-4">
                <label for="txtInspectorDesignation" class="form-label small fw-bold">Designation</label>
                <input type="text" id="txtInspectorDesignation" class="form-control-custom w-100" placeholder="e.g. Inspection Officer I" onchange="scheduleWizardAutoSave()" />
            </div>
            <div class="col-md-4">
                <label for="txtGeneralRemarks" class="form-label small fw-bold">General Inspection Remarks</label>
                <input type="text" id="txtGeneralRemarks" class="form-control-custom w-100" placeholder="Physical condition, batch notes, delivery notes..." onchange="scheduleWizardAutoSave()" />
            </div>
        </div>
    </div>

    <!-- ============================================================
         SUPPORTING DOCUMENTS / PHOTOS UPLOADER
         ============================================================ -->
    <div class="mb-4 p-3 bg-white rounded border">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <h4 class="fs-6 fw-bold mb-0 text-dark"><span class="k-icon k-i-attachment"></span> Supporting Inspection Documents &amp; Delivery Photos</h4>
                <p class="small text-muted mb-0">Attach physical delivery photos, technical verification sheets, or delivery receipts (PDF, JPG, PNG).</p>
            </div>
            <div>
                <label class="btn-procurement-secondary btn-sm mb-0" style="cursor:pointer;">
                    <span class="k-icon k-i-upload"></span> Attach Files
                    <input type="file" id="fileInspectionDoc" multiple accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" style="display:none;" onchange="handleInspectionFileUpload(this)" />
                </label>
            </div>
        </div>

        <div id="inspectionDocsList" class="d-flex flex-wrap gap-2 mt-2">
            <span class="small text-muted font-italic" id="noDocsPlaceholder">No supporting documents attached yet.</span>
        </div>
    </div>

    <!-- ============================================================
         ITEMS INSPECTION TABLE
         Includes: #, PR Number, Department, Item No., PPMP Code, Description, Unit, PO Qty, Prev. Inspected, Remaining, Qty This Insp, Total Insp, Disposition, Inventory Details, Remarks, History
         ============================================================ -->
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle mb-0" id="tblInspectItems">
            <thead class="table-light">
                <tr>
                    <th style="width: 35px;" class="text-center">#</th>
                    <th style="width: 110px;">PR Number</th>
                    <th style="width: 120px;">Department</th>
                    <th style="width: 70px;">Item No.</th>
                    <th style="width: 90px;">PPMP Code</th>
                    <th>Description</th>
                    <th style="width: 60px;">Unit</th>
                    <th style="width: 85px;" class="text-end">PO Qty</th>
                    <th style="width: 85px;" class="text-end">Prev. Insp.</th>
                    <th style="width: 85px;" class="text-end">Remaining</th>
                    <th style="width: 105px;" class="text-end text-primary">Qty This Insp.</th>
                    <th style="width: 85px;" class="text-end">Total Insp.</th>
                    <th style="width: 125px;">Disposition</th>
                    <th style="width: 155px;" class="text-center">Inventory Details</th>
                    <th style="width: 120px;">Remarks</th>
                    <th style="width: 50px;" class="text-center">Hist.</th>
                </tr>
            </thead>
            <tbody id="inspectItemsTableBody">
                <tr>
                    <td colspan="16" class="p-4 text-center text-muted">
                        Please select a Purchase Order in Step 1 to load items.
                    </td>
                </tr>
            </tbody>
            <tfoot class="table-light fw-bold" id="inspectItemsTableFooter" style="display:none;">
                <tr>
                    <td colspan="7" class="text-end">Grand Totals:</td>
                    <td class="text-end" id="lblGrandOrdered">0.00</td>
                    <td class="text-end" id="lblGrandPrevInspected">0.00</td>
                    <td class="text-end" id="lblGrandRemaining">0.00</td>
                    <td class="text-end text-primary" id="lblGrandInspectNow">0.00</td>
                    <td class="text-end" id="lblGrandTotalInspected">0.00</td>
                    <td colspan="4"></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- ============================================================
         STEP ACTIONS
         ============================================================ -->
    <div class="wizard-summary-bar mt-4">
        <button type="button" class="btn-procurement-secondary" onclick="goToWizardStep(1)">
            <span class="k-icon k-i-arrow-left"></span> Back to PO Selection
        </button>

        <div class="wizard-action-group">
            <button type="button" class="btn-procurement-secondary" onclick="saveDraftExplicit()">
                <span class="k-icon k-i-save"></span> Save Draft
            </button>
            <button type="button" class="btn-procurement-primary" onclick="proceedToStep3()">
                Proceed to Invoice Entry <span class="k-icon k-i-arrow-right"></span>
            </button>
        </div>
    </div>

</div>

<script type="text/javascript">
    var activeModalItemIdx = -1;

    function onInspectorSelect(e) {
        var dataItem = e.dataItem;
        if (dataItem) {
            var name = dataItem.Description || "";
            var designation = dataItem.Desc2 || "";
            $("#txtInspectorDesignation").val(designation);
            if (airWizardState) {
                airWizardState.InspectorName = name;
                airWizardState.InspectorDesignation = designation;
            }
            if (typeof scheduleWizardAutoSave === "function") {
                scheduleWizardAutoSave();
            }
        }
    }

    function onInspectorChange(e) {
        var cb = this;
        var val = cb.value() || "";
        var dataItem = cb.dataItem();
        var designation = (dataItem && dataItem.Desc2) ? dataItem.Desc2 : $("#txtInspectorDesignation").val();
        $("#txtInspectorDesignation").val(designation);
        if (airWizardState) {
            airWizardState.InspectorName = val;
            airWizardState.InspectorDesignation = designation;
        }
        if (typeof scheduleWizardAutoSave === "function") {
            scheduleWizardAutoSave();
        }
    }

    function checkInventoryDetailCompleted(extnName, d) {
        if (!d) return false;
        extnName = extnName || "ItemExtnOther";
        if (extnName === "ItemExtnVehicle") {
            return !!((d.ConductionNo && d.ConductionNo.trim()) ||
                      (d.EngineNo && d.EngineNo.trim()) ||
                      (d.ChasisNo && d.ChasisNo.trim()) ||
                      (d.PlateNo && d.PlateNo.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else if (extnName === "ItemExtnLand") {
            return !!((d.PIN && d.PIN.trim()) ||
                      (d.TctNo && d.TctNo.trim()) ||
                      (d.Address && d.Address.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else if (extnName === "ItemExtnBuilding") {
            return !!((d.ProjectName && d.ProjectName.trim()) ||
                      (d.Address && d.Address.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else {
            return !!((d.SerialNo && d.SerialNo.trim()) || (d.Remarks && d.Remarks.trim()));
        }
    }

    function reconcileItemInventoryDetails(itm) {
        if (!itm) return;
        var currentDisp = itm.Disposition || (airWizardState ? airWizardState.Disposition : "") || "Inventory";
        itm.Disposition = currentDisp;

        if (currentDisp === "Inventory") {
            var req = Math.floor(itm.InspectNowQty || 0);
            itm.RequiredInventoryCount = req;
            if (!itm.InventoryDetails) itm.InventoryDetails = [];

            if (itm.InventoryDetails.length > req) {
                itm.InventoryDetails = itm.InventoryDetails.slice(0, req);
            } else {
                while (itm.InventoryDetails.length < req) {
                    var uIdx = itm.InventoryDetails.length + 1;
                    itm.InventoryDetails.push({
                        UnitIndex: uIdx,
                        UnitNumber: uIdx,
                        Condition: "Brand New",
                        IsCompleted: false
                    });
                }
            }

            var compCount = 0;
            itm.InventoryDetails.forEach(function (d, i) {
                d.UnitIndex = i + 1;
                d.UnitNumber = i + 1;
                d.IsCompleted = checkInventoryDetailCompleted(itm.ItemExtnName, d);
                if (d.IsCompleted) compCount++;
            });
            itm.CompletedInventoryCount = compCount;
        } else {
            itm.RequiredInventoryCount = 0;
            itm.CompletedInventoryCount = 0;
        }
    }

    function renderStep2Items(data) {
        if (!data || !data.Items || data.Items.length === 0) {
            $("#inspectItemsTableBody").html("<tr><td colspan='16' class='p-4 text-center text-muted'>No items found for this Purchase Order.</td></tr>");
            $("#inspectItemsTableFooter").hide();
            return;
        }

        // Populate Inspector MultiColumnComboBox
        var cb = $("#InspectorName").data("kendoMultiColumnComboBox");
        if (cb) {
            cb.value(data.InspectorName || "");
            cb.text(data.InspectorName || "");
        } else {
            $("#InspectorName").val(data.InspectorName || "");
        }

        if (data.InspectorDesignation !== undefined) $("#txtInspectorDesignation").val(data.InspectorDesignation || "");
        if (data.InspectionLocation !== undefined && data.InspectionLocation !== null) {
            $("#txtInspectionLocation").val(data.InspectionLocation);
        } else if (!$("#txtInspectionLocation").val()) {
            $("#txtInspectionLocation").val(data.DeliveryPlace || "");
        }
        if (data.InspectionCommittee !== undefined) $("#txtInspectionCommittee").val(data.InspectionCommittee || "");
        if (data.GeneralRemarks !== undefined) $("#txtGeneralRemarks").val(data.GeneralRemarks || "");

        var html = "";
        data.Items.forEach(function (item, idx) {
            // Default item disposition from wizard state if not set
            if (!item.Disposition) {
                item.Disposition = data.Disposition || "Inventory";
            }
            reconcileItemInventoryDetails(item);

            var isSet = item.IsSetLot && item.SubItems && item.SubItems.length > 0;
            var expandBtn = isSet ? "<button type='button' class='btn btn-xs btn-link p-0 text-decoration-none' onclick='toggleSubItemsRow(" + idx + ")'><span id='expandIcon_" + idx + "' class='k-icon k-i-arrow-chevron-right'></span></button>" : "";

            var prCellContent = "";
            var deptCellContent = "";

            if (item.Sources && item.Sources.length > 1) {
                prCellContent = item.Sources.map(function (s) {
                    var qtyFormatted = Number(s.Qty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    return "<div class='small fw-bold text-primary'>" + (s.PRNumber || "--") + " <span class='text-muted fw-normal'>(" + qtyFormatted + ")</span></div>";
                }).join("");

                deptCellContent = item.Sources.map(function (s) {
                    return "<div class='small text-muted text-truncate' title='" + (s.Department || "--") + "'>" + (s.Department || "--") + "</div>";
                }).join("");
            } else if (item.Sources && item.Sources.length === 1) {
                var s = item.Sources[0];
                prCellContent = "<span class='small fw-bold text-primary'>" + (s.PRNumber || item.PRNumber || "--") + "</span>";
                deptCellContent = "<span class='small text-muted text-truncate' title='" + (s.Department || item.Department || "--") + "'>" + (s.Department || item.Department || "--") + "</span>";
            } else {
                prCellContent = "<span class='small fw-bold text-primary'>" + (item.PRNumber || data.PRNumber || "--") + "</span>";
                deptCellContent = "<span class='small text-muted text-truncate' title='" + (item.Department || data.DepartmentName || "--") + "'>" + (item.Department || data.DepartmentName || "--") + "</span>";
            }

            html += "<tr id='parentItemRow_" + idx + "' data-item-idx='" + idx + "' class='" + (isSet ? "table-set-parent" : "") + "'>";
            html += "<td class='text-center'>" + expandBtn + "</td>";
            html += "<td>" + prCellContent + "</td>";
            html += "<td>" + deptCellContent + "</td>";
            html += "<td class='fw-bold'>" + (item.ItemNo || (idx + 1)) + "</td>";
            html += "<td class='small text-muted'>" + (item.PPMPCode || "--") + "</td>";
            html += "<td>";
            html += "  <div class='fw-semibold'>" + (item.Description || "Item") + "</div>";
            if (isSet) {
                html += "  <span class='badge bg-info text-dark small'>Set / Lot (" + item.SubItems.length + " components)</span>";
            }
            if (item.ItemExtnName) {
                html += "  <span class='badge bg-light text-secondary border small mt-1'>" + item.ItemExtnName.replace("ItemExtn", "Type: ") + "</span>";
            }
            html += "</td>";
            html += "<td class='text-muted small'>" + (item.Unit || "unit") + "</td>";
            html += "<td class='text-end font-monospace'>" + Number(item.OrderedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
            html += "<td class='text-end font-monospace text-muted'>" + Number(item.PreviousInspectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
            html += "<td class='text-end font-monospace fw-bold text-danger' id='lblRemaining_" + idx + "'>" + Number(item.RemainingBeforeQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";

            // Inspect Now Input
            html += "<td class='text-end'>";
            html += "  <input type='number' step='any' min='0' max='" + item.RemainingBeforeQty + "' class='form-control-custom text-end fw-bold text-primary inspect-now-input' id='txtInspectNow_" + idx + "' value='" + (item.InspectNowQty || 0) + "' oninput='onItemInspectNowChange(" + idx + ", this.value)' />";
            html += "</td>";

            html += "<td class='text-end font-monospace fw-bold' id='lblTotalInspected_" + idx + "'>" + Number(item.TotalInspectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";

            // Disposition Selector
            html += "<td>";
            html += "  <select class='form-control-custom w-100 form-control-sm' id='ddlItemDisposition_" + idx + "' onchange='onItemDispositionChange(" + idx + ", this.value)'>";
            html += "    <option value='Inventory'" + (item.Disposition === 'Inventory' ? " selected" : "") + ">Inventory</option>";
            html += "    <option value='For Distribution'" + (item.Disposition === 'For Distribution' ? " selected" : "") + ">For Distribution</option>";
            html += "    <option value='N/A'" + (item.Disposition === 'N/A' ? " selected" : "") + ">N/A</option>";
            html += "  </select>";
            html += "</td>";

            // Inventory Details Cell
            html += "<td class='text-center' id='inventoryDetailsCell_" + idx + "'>";
            html += renderInventoryDetailsButtonHtml(item, idx);
            html += "</td>";

            // Remarks
            html += "<td><input type='text' class='form-control-custom w-100 item-remarks-input' id='txtRemarks_" + idx + "' value='" + (item.Remarks || "") + "' placeholder='Item notes...' onchange='onItemRemarksChange(" + idx + ", this.value)' /></td>";

            // History
            html += "<td class='text-center'><button type='button' class='btn btn-xs btn-outline-secondary' onclick='openItemHistory(\"" + item.OrderItemId + "\")' title='View Inspection History'><span class='k-icon k-i-history'></span></button></td>";
            html += "</tr>";

            // If Set/Lot, render collapsible child sub-items table
            if (isSet) {
                html += "<tr id='subItemsRow_" + idx + "' style='display:none;' class='table-light'>";
                html += "  <td></td>";
                html += "  <td colspan='15' class='p-3'>";
                html += "    <div class='p-2 bg-white rounded border'>";
                html += "      <div class='fw-bold small text-secondary mb-2'><span class='k-icon k-i-layers'></span> Set/Lot Components for: " + (item.Description || "Item") + "</div>";
                html += "      <table class='table table-sm table-bordered mb-0'>";
                html += "        <thead class='table-light small'>";
                html += "          <tr>";
                html += "            <th style='width:90px;'>Sub-No.</th>";
                html += "            <th>Component Description</th>";
                html += "            <th style='width:60px;'>Unit</th>";
                html += "            <th style='width:90px;' class='text-end'>Expected</th>";
                html += "            <th style='width:90px;' class='text-end'>Prev. Insp.</th>";
                html += "            <th style='width:90px;' class='text-end'>Remaining</th>";
                html += "            <th style='width:110px;' class='text-end text-primary'>Inspect Now</th>";
                html += "            <th style='width:90px;' class='text-end'>Total Insp.</th>";
                html += "            <th>Remarks</th>";
                html += "          </tr>";
                html += "        </thead>";
                html += "        <tbody>";
                item.SubItems.forEach(function (sub, sIdx) {
                    html += "          <tr>";
                    html += "            <td class='fw-bold small'>" + (sub.SubItemNo || ("#" + (sIdx + 1))) + "</td>";
                    html += "            <td>" + (sub.Description || "") + "</td>";
                    html += "            <td class='small text-muted'>" + (sub.Unit || "") + "</td>";
                    html += "            <td class='text-end font-monospace small'>" + Number(sub.ExpectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
                    html += "            <td class='text-end font-monospace small text-muted'>" + Number(sub.PreviousInspectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
                    html += "            <td class='text-end font-monospace small fw-bold text-danger' id='lblSubRemaining_" + idx + "_" + sIdx + "'>" + Number(sub.RemainingBeforeQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
                    html += "            <td class='text-end'><input type='number' step='any' min='0' max='" + sub.RemainingBeforeQty + "' class='form-control-custom text-end fw-bold form-control-sm' id='txtSubInspectNow_" + idx + "_" + sIdx + "' value='" + (sub.InspectNowQty || 0) + "' oninput='onSubItemInspectNowChange(" + idx + ", " + sIdx + ", this.value)' /></td>";
                    html += "            <td class='text-end font-monospace small fw-bold' id='lblSubTotal_" + idx + "_" + sIdx + "'>" + Number(sub.TotalInspectedQty || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>";
                    html += "            <td><input type='text' class='form-control-custom w-100 form-control-sm' id='txtSubRemarks_" + idx + "_" + sIdx + "' value='" + (sub.Remarks || "") + "' placeholder='Sub-item notes...' onchange='onSubItemRemarksChange(" + idx + ", " + sIdx + ", this.value)' /></td>";
                    html += "          </tr>";
                });
                html += "        </tbody>";
                html += "      </table>";
                html += "    </div>";
                html += "  </td>";
                html += "</tr>";
            }
        });

        $("#inspectItemsTableBody").html(html);
        $("#inspectItemsTableFooter").show();
        recalculateGrandTotals();
    }

    function renderInventoryDetailsButtonHtml(item, idx) {
        if (item.Disposition !== "Inventory") {
            return "<span class='badge bg-light text-muted border'>Not Required</span>";
        }
        var inspectQty = item.InspectNowQty || 0;
        if (inspectQty <= 0) {
            return "<span class='text-muted small'>Inspect Qty is 0</span>";
        }
        var req = Math.floor(inspectQty);
        var comp = (item.InventoryDetails || []).filter(function (d) { return checkInventoryDetailCompleted(item.ItemExtnName, d); }).length;
        item.RequiredInventoryCount = req;
        item.CompletedInventoryCount = comp;

        if (comp >= req && req > 0) {
            return "<button type='button' class='btn btn-xs btn-success w-100 text-nowrap' onclick='openInventoryModal(" + idx + ")'><span class='k-icon k-i-check'></span> Details " + comp + " / " + req + "</button>";
        } else {
            return "<button type='button' class='btn btn-xs btn-warning text-dark w-100 text-nowrap' onclick='openInventoryModal(" + idx + ")'><span class='k-icon k-i-edit'></span> Enter Details (" + comp + " / " + req + ")</button>";
        }
    }

    function updateInventoryDetailsButton(idx) {
        var item = airWizardState.Items[idx];
        if (!item) return;
        var container = $("#inventoryDetailsCell_" + idx);
        if (container.length) {
            container.html(renderInventoryDetailsButtonHtml(item, idx));
        }
    }

    function onItemDispositionChange(idx, newDisp) {
        var item = airWizardState.Items[idx];
        if (!item) return;

        var prevDisp = item.Disposition;
        if (prevDisp === "Inventory" && newDisp !== "Inventory") {
            var hasData = (item.InventoryDetails || []).some(function (d) {
                return d && (d.SerialNo || d.EngineNo || d.ChasisNo || d.PlateNo || d.PIN || d.Address || d.ProjectName || d.IsCompleted);
            });

            if (hasData) {
                var confirmed = confirm("Changing disposition from Inventory to " + newDisp + " will discard entered inventory details for this item. Are you sure you want to proceed?");
                if (!confirmed) {
                    $("#ddlItemDisposition_" + idx).val("Inventory");
                    return;
                }
            }
            item.InventoryDetails = [];
            item.CompletedInventoryCount = 0;
            item.RequiredInventoryCount = 0;
        }

        item.Disposition = newDisp;
        if (newDisp === "Inventory") {
            reconcileItemInventoryDetails(item);
        }

        updateInventoryDetailsButton(idx);
        scheduleWizardAutoSave();
    }

    function onItemInspectNowChange(idx, valStr) {
        var val = parseFloat(valStr) || 0;
        var item = airWizardState.Items[idx];
        if (!item) return;

        var maxAllowed = item.RemainingBeforeQty;
        if (val < 0) {
            val = 0;
            $("#txtInspectNow_" + idx).val(0);
        } else if (val > maxAllowed) {
            val = maxAllowed;
            $("#txtInspectNow_" + idx).val(maxAllowed);
            alert("Inspect Now quantity cannot exceed Remaining quantity (" + maxAllowed + ").");
        }

        var oldQty = item.InspectNowQty || 0;
        var newRequired = Math.floor(val);
        var currentDetails = item.InventoryDetails || [];

        // If reducing quantity on an Inventory item, check if entered details would be discarded
        if (item.Disposition === "Inventory" && newRequired < currentDetails.length) {
            var hasEnteredDataDiscarded = false;
            for (var k = newRequired; k < currentDetails.length; k++) {
                var d = currentDetails[k];
                if (d && (d.SerialNo || d.EngineNo || d.ChasisNo || d.PlateNo || d.PIN || d.Address || d.ProjectName || d.IsCompleted)) {
                    hasEnteredDataDiscarded = true;
                    break;
                }
            }
            if (hasEnteredDataDiscarded) {
                var confirmed = confirm("Reducing quantity to " + newRequired + " will discard entered inventory details for unit(s) " + (newRequired + 1) + " to " + currentDetails.length + ". Do you wish to proceed?");
                if (!confirmed) {
                    $("#txtInspectNow_" + idx).val(oldQty);
                    return;
                }
            }
        }

        item.InspectNowQty = val;
        var total = (item.PreviousInspectedQty || 0) + val;
        $("#lblTotalInspected_" + idx).text(Number(total).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        // Reconcile inventory details count
        reconcileItemInventoryDetails(item);
        updateInventoryDetailsButton(idx);

        // If parent item has sub-items, proportionally adjust sub-items inspect now
        if (item.IsSetLot && item.SubItems) {
            item.SubItems.forEach(function (sub, sIdx) {
                var subRatio = (sub.ExpectedQty || 0) / (item.OrderedQty || 1);
                var subVal = val * subRatio;
                if (subVal > sub.RemainingBeforeQty) subVal = sub.RemainingBeforeQty;
                sub.InspectNowQty = subVal;
                $("#txtSubInspectNow_" + idx + "_" + sIdx).val(subVal);
                var subTotal = (sub.PreviousInspectedQty || 0) + subVal;
                $("#lblSubTotal_" + idx + "_" + sIdx).text(Number(subTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            });
        }

        recalculateGrandTotals();
        scheduleWizardAutoSave();
    }

    function toggleSubItemsRow(idx) {
        var row = $("#subItemsRow_" + idx);
        var icon = $("#expandIcon_" + idx);
        if (row.is(":visible")) {
            row.hide();
            icon.removeClass("k-i-arrow-chevron-down").addClass("k-i-arrow-chevron-right");
        } else {
            row.show();
            icon.removeClass("k-i-arrow-chevron-right").addClass("k-i-arrow-chevron-down");
        }
    }

    function onSubItemInspectNowChange(idx, sIdx, valStr) {
        var val = parseFloat(valStr) || 0;
        var item = airWizardState.Items[idx];
        if (!item || !item.SubItems[sIdx]) return;
        var sub = item.SubItems[sIdx];

        if (val < 0) val = 0;
        if (val > sub.RemainingBeforeQty) val = sub.RemainingBeforeQty;
        sub.InspectNowQty = val;
        $("#txtSubInspectNow_" + idx + "_" + sIdx).val(val);

        var subTotal = (sub.PreviousInspectedQty || 0) + val;
        $("#lblSubTotal_" + idx + "_" + sIdx).text(Number(subTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

        scheduleWizardAutoSave();
    }

    function onItemRemarksChange(idx, val) {
        if (airWizardState.Items[idx]) {
            airWizardState.Items[idx].Remarks = val;
            scheduleWizardAutoSave();
        }
    }

    function onSubItemRemarksChange(idx, sIdx, val) {
        if (airWizardState.Items[idx] && airWizardState.Items[idx].SubItems[sIdx]) {
            airWizardState.Items[idx].SubItems[sIdx].Remarks = val;
            scheduleWizardAutoSave();
        }
    }

    function recalculateGrandTotals() {
        if (!airWizardState || !airWizardState.Items) return;
        var grandOrdered = 0;
        var grandPrev = 0;
        var grandRemaining = 0;
        var grandInspectNow = 0;
        var grandTotal = 0;

        airWizardState.Items.forEach(function (i) {
            grandOrdered += (i.OrderedQty || 0);
            grandPrev += (i.PreviousInspectedQty || 0);
            grandRemaining += (i.RemainingBeforeQty || 0);
            grandInspectNow += (i.InspectNowQty || 0);
            grandTotal += ((i.PreviousInspectedQty || 0) + (i.InspectNowQty || 0));
        });

        $("#lblGrandOrdered").text(Number(grandOrdered).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandPrevInspected").text(Number(grandPrev).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandRemaining").text(Number(grandRemaining).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandInspectNow").text(Number(grandInspectNow).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandTotalInspected").text(Number(grandTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }

    function handleInspectionFileUpload(input) {
        if (!input.files || input.files.length === 0) return;
        var formData = new FormData();
        formData.append("file", input.files[0]);
        formData.append("category", "InspectionDoc");

        $.ajax({
            url: '@Url.Action("UploadAttachment", "AIRs")',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                if (res.success && res.document) {
                    if (!airWizardState.SupportingDocuments) airWizardState.SupportingDocuments = [];
                    airWizardState.SupportingDocuments.push(res.document);
                    renderSupportingDocs();
                    scheduleWizardAutoSave();
                } else {
                    alert(res.message || "Failed to upload file.");
                }
            }
        });
    }

    function renderSupportingDocs() {
        var container = $("#inspectionDocsList");
        container.empty();
        if (!airWizardState.SupportingDocuments || airWizardState.SupportingDocuments.length === 0) {
            container.html("<span class='small text-muted font-italic'>No supporting documents attached yet.</span>");
            return;
        }

        airWizardState.SupportingDocuments.forEach(function (doc, idx) {
            var badge = "<span class='badge bg-light text-dark border p-2 d-inline-flex align-items-center gap-2'>" +
                        "  <span class='k-icon k-i-file'></span> " +
                        "  <span>" + doc.FileName + " (" + doc.FileSize + ")</span>" +
                        "  <button type='button' class='btn-close btn-close-sm' onclick='removeSupportingDoc(" + idx + ")' title='Remove attachment'></button>" +
                        "</span>";
            container.append(badge);
        });
    }

    function removeSupportingDoc(idx) {
        if (airWizardState.SupportingDocuments) {
            airWizardState.SupportingDocuments.splice(idx, 1);
            renderSupportingDocs();
            scheduleWizardAutoSave();
        }
    }

    function proceedToStep3() {
        var hasInspectQty = false;
        if (airWizardState.Items) {
            hasInspectQty = airWizardState.Items.some(function (i) { return (i.InspectNowQty || 0) > 0; });
        }
        if (!hasInspectQty) {
            alert("You must enter an 'Inspect Now' quantity greater than 0 for at least one item before continuing.");
            return;
        }

        // Completion validation: Ensure all inventory items have Completed Count == Required Count
        if (airWizardState.Items) {
            for (var idx = 0; idx < airWizardState.Items.length; idx++) {
                var itm = airWizardState.Items[idx];
                if (itm.Disposition === "Inventory" && (itm.InspectNowQty || 0) > 0) {
                    var req = Math.floor(itm.InspectNowQty);
                    var comp = (itm.InventoryDetails || []).filter(function (d) { return checkInventoryDetailCompleted(itm.ItemExtnName, d); }).length;
                    if (comp < req) {
                        alert("Item #" + (itm.ItemNo || (idx + 1)) + " (" + (itm.Description || "Item") + ") requires " + req + " inventory detail records, but only " + comp + " completed.\n\nPlease click [Enter Details] to complete inventory records before continuing.");
                        return;
                    }
                }
            }
        }

        goToWizardStep(3);
    }


    function recalculateGrandTotals() {
        if (!airWizardState || !airWizardState.Items) return;
        var grandOrdered = 0;
        var grandPrev = 0;
        var grandRemaining = 0;
        var grandInspectNow = 0;
        var grandTotal = 0;

        airWizardState.Items.forEach(function (i) {
            grandOrdered += (i.OrderedQty || 0);
            grandPrev += (i.PreviousInspectedQty || 0);
            grandRemaining += (i.RemainingBeforeQty || 0);
            grandInspectNow += (i.InspectNowQty || 0);
            grandTotal += ((i.PreviousInspectedQty || 0) + (i.InspectNowQty || 0));
        });

        $("#lblGrandOrdered").text(Number(grandOrdered).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandPrevInspected").text(Number(grandPrev).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandRemaining").text(Number(grandRemaining).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandInspectNow").text(Number(grandInspectNow).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        $("#lblGrandTotalInspected").text(Number(grandTotal).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
    }



        function proceedToStep3() {
        if (typeof isSubmittedView !== 'undefined' && isSubmittedView) { goToWizardStep(3); return; }
        var hasInspectQty = false;
        if (airWizardState.Items) {
            hasInspectQty = airWizardState.Items.some(function (i) { return (i.InspectNowQty || 0) > 0; });
        }
        if (!hasInspectQty) {
            alert("You must enter an 'Inspect Now' quantity greater than 0 for at least one item before continuing.");
            return;
        }

        // Completion validation: Ensure all parent items and qualifying sub-items have Completed Count == Required Count
        var incompleteErrors = [];
        if (airWizardState.Items) {
            for (var idx = 0; idx < airWizardState.Items.length; idx++) {
                var itm = airWizardState.Items[idx];
                if (itm.Disposition === "Inventory" && (itm.InspectNowQty || 0) > 0) {
                    if (itm.ParentRequiresInventory) {
                        var req = Math.floor(itm.InspectNowQty);
                        var comp = (itm.InventoryDetails || []).filter(function (d) { return checkInventoryDetailCompleted(itm.ItemExtnName, d); }).length;
                        if (comp < req) {
                            incompleteErrors.push("Item #" + (itm.ItemNo || (idx + 1)) + " (" + (itm.Description || "Item") + "): " + comp + " of " + req + " completed");
                        }
                    }
                    if (itm.SubItems && itm.SubItems.length > 0) {
                        for (var sIdx = 0; sIdx < itm.SubItems.length; sIdx++) {
                            var sub = itm.SubItems[sIdx];
                            if (sub.RequiresInventory && (sub.InspectNowQty || 0) > 0) {
                                var sReq = Math.floor(sub.InspectNowQty);
                                var sComp = (sub.InventoryDetails || []).filter(function (d) { return checkInventoryDetailCompleted(sub.ItemExtnName, d); }).length;
                                if (sComp < sReq) {
                                    incompleteErrors.push("Item #" + (itm.ItemNo || (idx + 1)) + " (" + (itm.Description || "Item") + ") - Sub-item '" + (sub.Description || "Component") + "': " + sComp + " of " + sReq + " completed");
                                }
                            }
                        }
                    }
                }
            }
        }

        if (incompleteErrors.length > 0) {
            alert("Inventory details are incomplete:\n\n" + incompleteErrors.join("\n") + "\n\nPlease click [Enter Details] to complete all required unit records before continuing.");
            return;
        }

        goToWizardStep(3);
    }

        // ============================================================
    // ============================================================
    // INVENTORY DETAILS MODAL LOGIC (Grouped by PR / Department)
    // Quick Tools, Condition, Brand, Model removed
    // ============================================================
    var activeModalItemIdx = -1;
    var activeModalSubItemIdx = null;

    function openInventoryModal(idx, sIdx) {
        activeModalItemIdx = idx;
        activeModalSubItemIdx = (sIdx !== undefined && sIdx !== null) ? sIdx : null;

        var item = airWizardState.Items[idx];
        if (!item) return;

        var isSub = (activeModalSubItemIdx !== null);
        var targetObj = isSub ? item.SubItems[activeModalSubItemIdx] : item;
        if (!targetObj) return;

        if (isSub) {
            reconcileSubItemInventoryDetails(item, targetObj);
        } else {
            reconcileItemInventoryDetails(targetObj);
        }

        var extnName = targetObj.ItemExtnName || "ItemExtnOther";
        var reqCount = targetObj.RequiredInventoryCount;

        var extnTitle = "Other / General Equipment";
        if (extnName === "ItemExtnVehicle") extnTitle = "Motor Vehicle";
        else if (extnName === "ItemExtnLand") extnTitle = "Real Property / Land";
        else if (extnName === "ItemExtnBuilding") extnTitle = "Building / Structure";

        var targetTitle = isSub 
            ? (targetObj.Description || "Sub-Item") + " <span class='badge bg-info text-dark ms-1'>Sub-Item of " + (item.Description || "Parent") + "</span>"
            : (targetObj.Description || "Parent Item");

        var html = "";

        // Header info bar inside modal
        html += "<div class='p-3 bg-light rounded border mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2'>";
        html += "  <div>";
        html += "    <div class='fw-bold fs-6 text-dark'>" + targetTitle + "</div>";
        html += "    <div class='small text-muted'>Required Inventory Assets: <strong class='text-primary'>" + reqCount + " units</strong> &bull; Asset Category: <span class='badge bg-secondary'>" + extnTitle + "</span></div>";
        html += "  </div>";
        html += "  <div class='d-flex align-items-center gap-2'>";
        html += "    <span id='modalLiveCompletionBadge' class='badge " + (targetObj.CompletedInventoryCount >= reqCount ? "bg-success" : "bg-warning text-dark") + " fs-6'>";
        html += "      " + (targetObj.CompletedInventoryCount || 0) + " of " + reqCount + " Completed";
        html += "    </span>";
        html += "  </div>";
        html += "</div>";

        // Scrollable container for grouped PR tables
        html += "<div style='max-height: 440px; overflow-y: auto;' class='pe-1'>";

        var allocationsToRender = (item.Allocations && item.Allocations.length > 0) 
            ? item.Allocations 
            : [{
                OrderItemRequestId: null,
                RequestId: null,
                RequestItemId: null,
                DepartmentId: null,
                PRNumber: item.PRNumber || "--",
                Department: item.Department || "--",
                QtyAllocated: item.OrderedQty || reqCount,
                QtyInspected: item.InspectNowQty || reqCount
              }];

        var subRatio = isSub ? ((targetObj.QtyPerParent > 0) ? targetObj.QtyPerParent : 1) : 1;
        var globalRowIdx = 0;

        allocationsToRender.forEach(function (alloc) {
            var allocQty = Math.floor((alloc.QtyInspected || 0) * subRatio);
            var allocOirId = (alloc.OrderItemRequestId || "").toLowerCase();

            // Find units belonging to this allocation
            var allocUnits = targetObj.InventoryDetails.filter(function (d) {
                if (alloc.OrderItemRequestId) {
                    return d.OrderItemRequestId && d.OrderItemRequestId.toLowerCase() === allocOirId;
                }
                return true;
            });

            html += "<div class='card mb-3 border shadow-sm'>";
            html += "  <div class='card-header bg-light py-2 d-flex justify-content-between align-items-center flex-wrap gap-1'>";
            html += "    <div>";
            html += "      <span class='fw-bold text-dark'>PR No.: </span><span class='badge bg-primary fs-7 me-3'>" + (alloc.PRNumber || "--") + "</span>";
            html += "      <span class='fw-bold text-dark'>Department: </span><span class='text-secondary fw-semibold'>" + (alloc.Department || "--") + "</span>";
            html += "    </div>";
            html += "    <div class='d-flex align-items-center gap-1'>";
            html += "      <span class='badge bg-light text-dark border'>Allocated: " + (alloc.QtyAllocated || 0) + "</span>";
            html += "      <span class='badge bg-info text-dark'>Inspecting: " + allocQty + "</span>";
            html += "    </div>";
            html += "  </div>";

            if (allocUnits.length === 0) {
                html += "  <div class='card-body py-2 px-3 text-muted small fst-italic'>";
                html += "    No units being inspected for this PR allocation in this transaction.";
                html += "  </div>";
            } else {
                html += "  <div class='card-body p-0'>";
                html += "    <div class='table-responsive'>";
                html += "      <table class='table table-sm table-bordered align-middle mb-0'>";
                html += "        <thead class='table-light small'>";
                html += "          <tr>";
                html += "            <th style='width:45px;' class='text-center'>#</th>";

                if (extnName === "ItemExtnVehicle") {
                    html += "        <th style='width:120px;'>Serial No.</th>";
                    html += "        <th style='width:120px;'>Conduction No.</th>";
                    html += "        <th style='width:120px;'>Engine No.</th>";
                    html += "        <th style='width:120px;'>Chassis No.</th>";
                    html += "        <th style='width:100px;'>Plate No.</th>";
                    html += "        <th style='width:90px;'>Color</th>";
                    html += "        <th style='width:90px;'>Year Model</th>";
                    html += "        <th style='width:100px;'>Series No.</th>";
                } else if (extnName === "ItemExtnLand") {
                    html += "        <th style='width:120px;'>Property Index (PIN)</th>";
                    html += "        <th style='width:120px;'>TCT No.</th>";
                    html += "        <th style='width:100px;'>Lot No.</th>";
                    html += "        <th style='width:100px;'>Survey No.</th>";
                    html += "        <th style='width:90px;'>Area</th>";
                    html += "        <th>Location Address</th>";
                } else if (extnName === "ItemExtnBuilding") {
                    html += "        <th style='width:120px;'>Ref / Serial</th>";
                    html += "        <th style='width:140px;'>Project Name</th>";
                    html += "        <th style='width:110px;'>Building Type</th>";
                    html += "        <th style='width:75px;'>Storeys</th>";
                    html += "        <th style='width:90px;'>Floor Area</th>";
                    html += "        <th>Building Address</th>";
                } else { // ItemExtnOther
                    html += "        <th style='width:220px;'>Serial Number</th>";
                    html += "        <th>Notes / Remarks</th>";
                }

                html += "            <th style='width:60px;' class='text-center'>Status</th>";
                html += "          </tr>";
                html += "        </thead>";
                html += "        <tbody class='small'>";

                allocUnits.forEach(function (u, localIdx) {
                    var uIdx = globalRowIdx;
                    globalRowIdx++;
                    var isComp = checkInventoryDetailCompleted(extnName, u);

                    html += "      <tr id='unitRow_" + uIdx + "' data-unit-idx='" + uIdx + "' data-oir-id='" + (alloc.OrderItemRequestId || "") + "' data-pr-no='" + (alloc.PRNumber || "") + "' data-dept-name='" + (alloc.Department || "") + "' data-req-id='" + (alloc.RequestId || "") + "' data-req-item-id='" + (alloc.RequestItemId || "") + "' data-dept-id='" + (alloc.DepartmentId || "") + "'>";
                    html += "        <td class='text-center fw-bold bg-light'>" + (localIdx + 1) + "</td>";

                    if (extnName === "ItemExtnVehicle") {
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-serial' value='" + (u.SerialNo || "") + "' placeholder='Serial...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-conduction' value='" + (u.ConductionNo || "") + "' placeholder='Conduction...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-engine' value='" + (u.EngineNo || "") + "' placeholder='Engine...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-chasis' value='" + (u.ChasisNo || "") + "' placeholder='Chassis...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-plate' value='" + (u.PlateNo || "") + "' placeholder='Plate...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-color' value='" + (u.Color || "") + "' placeholder='Color...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-year' value='" + (u.YearModel || "") + "' placeholder='Year...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-series' value='" + (u.SeriesNo || "") + "' placeholder='Series...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                    } else if (extnName === "ItemExtnLand") {
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-pin' value='" + (u.PIN || "") + "' placeholder='PIN...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-tct' value='" + (u.TctNo || "") + "' placeholder='TCT No...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-lot' value='" + (u.LotNo || "") + "' placeholder='Lot No...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-survey' value='" + (u.SurveyNo || "") + "' placeholder='Survey No...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-area' value='" + (u.Area || "") + "' placeholder='Area...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-address' value='" + (u.Address || "") + "' placeholder='Location address...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                    } else if (extnName === "ItemExtnBuilding") {
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-serial' value='" + (u.SerialNo || "") + "' placeholder='Ref / Serial...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-project' value='" + (u.ProjectName || "") + "' placeholder='Project Name...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-buildingtype' value='" + (u.BuildingType || "") + "' placeholder='Type...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='number' class='form-control-custom form-control-sm w-100 unit-storeys' value='" + (u.NumStoreys || "") + "' placeholder='Storeys' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-floorarea' value='" + (u.FloorArea || "") + "' placeholder='Floor Area...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-address' value='" + (u.Address || "") + "' placeholder='Building Address...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                    } else { // ItemExtnOther
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-serial' value='" + (u.SerialNo || "") + "' placeholder='Serial Number...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                        html += "    <td><input type='text' class='form-control-custom form-control-sm w-100 unit-remarks' value='" + (u.Remarks || "") + "' placeholder='Notes/Specs...' oninput='onModalUnitFieldChange(" + uIdx + ")' /></td>";
                    }

                    html += "        <td class='text-center' id='unitStatusCell_" + uIdx + "'>";
                    html += "          " + (isComp ? "<span class='badge bg-success'>OK</span>" : "<span class='badge bg-light text-muted border'>--</span>");
                    html += "        </td>";
                    html += "      </tr>";
                });

                html += "        </tbody>";
                html += "      </table>";
                html += "    </div>";
                html += "  </div>";
            }
            html += "</div>";
        });

        html += "</div>";

        // Modal Action bar
        html += "<div class='d-flex justify-content-between align-items-center mt-3 pt-2 border-top'>";
        html += "  <span class='small text-muted' id='modalFooterHint'>Enter physical serial numbers and identifiers for each physical asset grouped by PR.</span>";
        html += "  <div class='d-flex gap-2'>";
        html += "    <button type='button' class='btn-procurement-secondary btn-sm' onclick='closeInventoryModal()'>Cancel</button>";
        html += "    <button type='button' class='btn-procurement-primary btn-sm' onclick='saveInventoryModal()'><span class='k-icon k-i-check'></span> Save Details</button>";
        html += "  </div>";
        html += "</div>";

        $("#inventoryDetailsModalContent").html(html);

        var win = $("#inventoryDetailsWindow").data("kendoWindow");
        if (win) {
            var modalHeading = isSub ? ((targetObj.Description || "Sub-Item") + " - Sub-Item Inventory (" + reqCount + " Units)") : ((item.Description || "Item") + " (" + reqCount + " Units)");
            win.title("Inventory Details: " + modalHeading);
            win.center().open();
            var isReadOnlyMode = (typeof isSubmittedView !== 'undefined' && isSubmittedView) || (typeof isReadOnly !== 'undefined' && isReadOnly) || (airWizardState && (airWizardState.IsSubmittedView || airWizardState.IsReadOnly));
            if (isReadOnlyMode) {
                setTimeout(function () {
                    $("#inventoryDetailsModalContent input, #inventoryDetailsModalContent select, #inventoryDetailsModalContent textarea").prop("disabled", true).addClass("bg-light");
                    $("#inventoryDetailsModalContent button:contains('Save')").hide();
                    $("#inventoryDetailsModalContent button:contains('Cancel')").text("Close");
                }, 50);
            }
        }
    }

    function onModalUnitFieldChange(uIdx) {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var isSub = (activeModalSubItemIdx !== null);
        var targetObj = isSub ? item.SubItems[activeModalSubItemIdx] : item;
        var extnName = targetObj.ItemExtnName || "ItemExtnOther";

        var row = $("#unitRow_" + uIdx);
        var dummy = readUnitFromRow(row, extnName);
        var isComp = checkInventoryDetailCompleted(extnName, dummy);

        var cell = $("#unitStatusCell_" + uIdx);
        if (isComp) {
            cell.html("<span class='badge bg-success'>OK</span>");
        } else {
            cell.html("<span class='badge bg-light text-muted border'>--</span>");
        }

        updateModalCompletionCounter();
    }

    function updateModalCompletionCounter() {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var isSub = (activeModalSubItemIdx !== null);
        var targetObj = isSub ? item.SubItems[activeModalSubItemIdx] : item;
        var extnName = targetObj.ItemExtnName || "ItemExtnOther";

        var comp = 0;
        $("tr[id^='unitRow_']").each(function () {
            var dummy = readUnitFromRow($(this), extnName);
            if (checkInventoryDetailCompleted(extnName, dummy)) comp++;
        });

        var req = targetObj.RequiredInventoryCount;
        var badge = $("#modalLiveCompletionBadge");
        if (comp >= req && req > 0) {
            badge.removeClass("bg-warning text-dark").addClass("bg-success text-white").text(comp + " of " + req + " Completed");
        } else {
            badge.removeClass("bg-success text-white").addClass("bg-warning text-dark").text(comp + " of " + req + " Completed");
        }
    }

    function saveInventoryModal() {
        var item = airWizardState.Items[activeModalItemIdx];
        if (!item) return;
        var isSub = (activeModalSubItemIdx !== null);
        var targetObj = isSub ? item.SubItems[activeModalSubItemIdx] : item;
        var extnName = targetObj.ItemExtnName || "ItemExtnOther";

        var details = [];
        var compCount = 0;

        $("tr[id^='unitRow_']").each(function (uIdx) {
            var row = $(this);
            var u = readUnitFromRow(row, extnName);
            u.ContentNo = uIdx + 1;
            u.TContentNo = uIdx + 1;
            u.UnitIndex = uIdx + 1;
            u.UnitNumber = uIdx + 1;
            u.IsCompleted = checkInventoryDetailCompleted(extnName, u);

            if (isSub) {
                u.AirSubItemId = targetObj.AirSubItemId;
                u.AirItemId = null;
            } else {
                u.AirItemId = item.AirItemId;
                u.AirSubItemId = null;
            }

            // Retain existing ExtnId/Id if previously persisted
            if (targetObj.InventoryDetails && targetObj.InventoryDetails[uIdx]) {
                u.Id = targetObj.InventoryDetails[uIdx].Id;
                u.ExtnId = targetObj.InventoryDetails[uIdx].ExtnId || targetObj.InventoryDetails[uIdx].Id;
            }

            if (u.IsCompleted) compCount++;
            details.push(u);
        });

        targetObj.InventoryDetails = details;
        targetObj.RequiredInventoryCount = targetObj.RequiredInventoryCount || details.length;
        targetObj.CompletedInventoryCount = compCount;

        if (isSub) {
            updateSubItemInventoryDetailsButton(activeModalItemIdx, activeModalSubItemIdx);
        } else {
            updateInventoryDetailsButton(activeModalItemIdx);
        }

        closeInventoryModal();
        scheduleWizardAutoSave();
    }

    function readUnitFromRow(row, extnName) {
        var u = {
            OrderItemRequestId: row.attr("data-oir-id") || null,
            PRNumber: row.attr("data-pr-no") || "",
            DepartmentName: row.attr("data-dept-name") || "",
            RequestId: row.attr("data-req-id") || null,
            RequestItemId: row.attr("data-req-item-id") || null,
            DepartmentId: row.attr("data-dept-id") || null
        };
        extnName = extnName || "ItemExtnOther";

        if (extnName === "ItemExtnVehicle") {
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.ConductionNo = row.find(".unit-conduction").val() || "";
            u.EngineNo = row.find(".unit-engine").val() || "";
            u.ChasisNo = row.find(".unit-chasis").val() || "";
            u.PlateNo = row.find(".unit-plate").val() || "";
            u.Color = row.find(".unit-color").val() || "";
            u.YearModel = row.find(".unit-year").val() || "";
            u.SeriesNo = row.find(".unit-series").val() || "";
        } else if (extnName === "ItemExtnLand") {
            u.PIN = row.find(".unit-pin").val() || "";
            u.TctNo = row.find(".unit-tct").val() || "";
            u.LotNo = row.find(".unit-lot").val() || "";
            u.SurveyNo = row.find(".unit-survey").val() || "";
            u.Area = row.find(".unit-area").val() || "";
            u.Address = row.find(".unit-address").val() || "";
        } else if (extnName === "ItemExtnBuilding") {
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.ProjectName = row.find(".unit-project").val() || "";
            u.BuildingType = row.find(".unit-buildingtype").val() || "";
            u.NumStoreys = parseInt(row.find(".unit-storeys").val()) || null;
            u.FloorArea = row.find(".unit-floorarea").val() || "";
            u.Address = row.find(".unit-address").val() || "";
        } else { // ItemExtnOther
            u.SerialNo = row.find(".unit-serial").val() || "";
            u.Remarks = row.find(".unit-remarks").val() || "";
        }
        return u;
    }

    function closeInventoryModal() {
        var win = $("#inventoryDetailsWindow").data("kendoWindow");
        if (win) {
            win.close();
        }
        activeModalItemIdx = -1;
        activeModalSubItemIdx = null;
    }
</script>


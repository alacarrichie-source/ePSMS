@model iLgs.Models.AIRItemVM

@using (Html.BeginForm(null, null, FormMethod.Post, new { name = "form", id = "form" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div id="ErrorContent" class="hidden x-bootstrap-content">
        <div class="alert alert-danger x-popup-alert">
            <ul class="errors"></ul>
        </div>
    </div>

    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.AirId)
    @Html.HiddenFor(model => model.Mode)
    @Html.HiddenFor(model => model.IsSetLot)
    @Html.HiddenFor(model => model.IsSetLotItem)

    <fieldset>
        @if (!Model.IsSetLot)
        {
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.OrderItemRequestId, "LabelGuid")
            </div>
            <div class="col-md-12">
                @if (Model.Mode == "A")
                {
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderItemRequestId)
                        .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                        .Placeholder("Select stock/property No.")
                        .DataTextField("Code")
                        .DataValueField("Id")
                        .ValuePrimitive(true)
                        .Filter(FilterType.Contains)
                        .DataSource(source =>
                        {
                            source.Read(read =>
                            {
                                read.Action("GetPoItemRequestsWithBalance", "Getters").Data("DataOrderItemRequestId");
                            })
                            .ServerFiltering(true);
                        })
                        .Columns(c =>
                        {
                            c.Add().Field("Code").Title("Code").Width("20%");
                            c.Add().Field("Name").Title("Item").Width("20%");
                            c.Add().Field("Description").Title("Description").Width("30%");
                            c.Add().Field("Unit").Title("Unit").Width("15%");
                            c.Add().Field("Qty").Title("Qty").Width("15%");
                            c.Add().Field("UnitCost").Title("Unit Cost").Width("15%");

                        })
                        .Suggest(true)
                        .Events(e => { e.Select("onSelectOrderItemRequestId"); })
    )
                }
                else
                {
                    @(Html.Kendo().MultiColumnComboBoxFor(m => m.OrderItemRequestId)
                            .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                            .Placeholder("Select stock/property No.")
                            .DataTextField("Code")
                            .DataValueField("Id")
                            .ValuePrimitive(true)
                            .Filter(FilterType.Contains)
                            .DataSource(source =>
                            {
                                source.Read(read =>
                                {
                                    read.Action("GetPoItemRequests", "Getters").Data("DataOrderItemRequestId");
                                })
                                .ServerFiltering(true);
                            })
                            .Columns(c =>
                            {
                                c.Add().Field("Code").Title("Code").Width("20%");
                                c.Add().Field("Name").Title("Item").Width("20%");
                                c.Add().Field("Description").Title("Description").Width("30%");
                                c.Add().Field("Unit").Title("Unit").Width("15%");
                                c.Add().Field("Qty").Title("Qty").Width("15%");
                                c.Add().Field("UnitCost").Title("Unit Cost").Width("15%");

                            })
                            .Suggest(true).Enable(false)
                            .Events(e => { e.Select("onSelectOrderItemRequestId"); })
                    )
                }
                @Html.ValidationMessageFor(m => m.OrderItemRequestId)
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.PsItem, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsItem).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>
        }
        else
        {
            @Html.HiddenFor(model => model.OrderItemRequestId)
            @Html.HiddenFor(model => model.PsItem)
            @Html.HiddenFor(model => model.InvDist)
        }

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.Description, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.Description).Rows(5).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        @*<div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.OtherDesc, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.OtherDesc).Rows(5).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>*@

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.PsUnit, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextBoxFor(m => m.PsUnit).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(model => model.Qty, "LabelDecimal")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().NumericTextBoxFor(model => model.Qty).Enable(true).Decimals(2).Format("{0:n2}").HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                //.Events(e => e.Change("changeAmount"))
                )
                @Html.ValidationMessageFor(model => model.Qty)
            </div>
        </div>

        @if (!Model.IsSetLot)
        {
        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.InvDist, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().MultiColumnComboBoxFor(m => m.InvDist)
                    .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                    .Placeholder("Select a value..")
                    .DataTextField("Description")
                    .DataValueField("Code")
                    .ValuePrimitive(true)
                    .Filter(FilterType.Contains)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("GetinvDistList", "Getters");
                        })
                        .ServerFiltering(true);
                    })
                    .Columns(c =>
                    {
                        c.Add().Field("Description").Title("Description").Width("100%");
                    })
                    .Suggest(true)
                )
                @Html.ValidationMessageFor(m => m.InvDist)
            </div>
        </div>
        }

        <div class="row k-mb-2">
            <div class="col-md-12">
                @Html.DisplayFor(m => m.Remarks, "Label")
            </div>
            <div class="col-md-12">
                @(Html.Kendo().TextAreaFor(m => m.Remarks).Rows(3).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))
                @Html.ValidationMessageFor(model => model.Remarks)
            </div>
        </div>

        <br />
        <div class="row k-mb-2">
            <div class="col-md-12">
                <span id="span_">
                    @(Html.Kendo().Button().Icon("k-icon k-i-check").Content("Save").Name("btnSave"))
                    @(Html.Kendo().Button().Icon("k-icon k-i-cancel").Content("Close").Name("btnCancel"))
                </span>
            </div>
        </div>
    </fieldset>
}

<script type="text/javascript">
    $("#btnSave").click(function (e) {
        e.preventDefault();

        //var grid = $("#gridItemExtn").data("kendoGrid");

        //// Get all data items (rows) in the Grid
        //var dataItems = grid.dataItems();

        //// Create an array to store the row values
        //var rowValues = [];

        //// Iterate over each data item (row) and extract the values
        //for (var i = 0; i < dataItems.length; i++) {
        //    var row = dataItems[i];
        //    rowValues.push(row);
        //}

        //$("#GridOrderItemExtns").val(JSON.stringify(rowValues)).trigger("change");

        var validator = $("#form").kendoValidator().data("kendoValidator");
        if (validator.validate()) {
            var disabled = $("#form").find(':input:disabled').removeAttr('disabled');
            $.ajax({
                type: "POST",
                url: '@Url.Action("_AIRItemSave", "AIRs")',
                data: $("#form").serialize(),
                beforeSend: function () {
                    window.kendo.ui.progress($("#form"), true);
                },
                success: function (result) {
                    window.kendo.ui.progress($("#form"), false);
                    if (result.Errors == "") {
                        $("#btnSave").closest(".k-window-content").data("kendoWindow").close();
                    }
                    else {
                        //// Clear previous error messages
                        $('#ErrorContent .errors').empty();

                        result.Errors.forEach(function (error) {
                            var key = error.Key;
                            var messages = error.Message; // Use Message from the JSON

                            // Check if messages exists and is an array
                            if (Array.isArray(messages)) {
                                // Create the field name list item
                                var errorListItem = $('<li></li>').text(key);

                                // Create a nested unordered list for the messages
                                var messageList = $('<ul></ul>');

                                // Loop through each message and append it to the messageList
                                messages.forEach(function (message) {
                                    messageList.append($('<li></li>').text(message));
                                });

                                // Append the message list to the error list item
                                errorListItem.append(messageList);

                                // Append the error list item to the .errors container
                                $('#ErrorContent .errors').append(errorListItem);
                            } else {
                                console.error(`Expected messages to be an array for field ${key}`);
                            }
                        });
                        // Show the error content
                        $('#ErrorContent').removeClass('hidden');
                    }
                },
                error: function (req, status, errorObj) {
                    alert(req.responseText);
                }
            });
            disabled.attr('disabled', 'disabled');
        }
    });

    $("#btnCancel").click(function (e) {
        e.preventDefault();
        $("#btnCancel").closest(".k-window-content").data("kendoWindow").close();
    });
</script>
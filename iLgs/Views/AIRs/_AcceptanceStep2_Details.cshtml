@model iLgs.Ai.Models.AIRAcceptanceWizardViewModel
@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="wizard-card">

    <div class="wizard-card-header">
        <div>
            <h2>Step 2: Accept Items</h2>
            <p class="subtitle">
                Enter the quantities being accepted against the quantities already inspected. Only inspected quantities that have not yet been accepted may be accepted.
            </p>
        </div>
    </div>

    <!-- ================================================================
         ACCEPTANCE OFFICER ACCOUNTABILITY CARD
         ================================================================ -->
    <div class="form-card mb-4 p-4 bg-white rounded border shadow-sm">
        <h4 class="fs-6 fw-bold mb-3 text-primary"><span class="k-icon k-i-user"></span> Acceptance Officer Accountability</h4>
        <div class="row g-3">
            <div class="col-md-3">
                <label for="txtAcceptanceDate" class="form-label small fw-bold">Acceptance Date <span class="text-danger">*</span></label>
                <input type="date" id="txtAcceptanceDate" class="form-control-custom w-100" value="@(Model.AcceptanceDate.HasValue ? Model.AcceptanceDate.Value.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label for="txtAcceptedBy" class="form-label small fw-bold">Accepted By (Officer Name) <span class="text-danger">*</span></label>
                <input type="text" id="txtAcceptedBy" class="form-control-custom w-100" placeholder="Full name of Acceptance Officer..." value="@Model.AcceptedBy" />
            </div>
            <div class="col-md-3">
                <label for="txtAcceptedByDesignation" class="form-label small fw-bold">Designation</label>
                <input type="text" id="txtAcceptedByDesignation" class="form-control-custom w-100" placeholder="e.g. Supply Officer IV / Custodian" value="@Model.AcceptedByDesignation" />
            </div>
            <div class="col-md-3">
                <label for="txtDepartmentOffice" class="form-label small fw-bold">Department / Custodian Office</label>
                <input type="text" id="txtDepartmentOffice" class="form-control-custom w-100" placeholder="e.g. General Services Office" value="@Model.Department" />
            </div>
            <div class="col-12">
                <label for="txtAcceptanceRemarks" class="form-label small fw-bold">General Acceptance Remarks</label>
                <textarea id="txtAcceptanceRemarks" class="form-control-custom w-100" rows="2" placeholder="Official notes on acceptance, packaging condition, or reasons for any partial acceptance...">@Model.AcceptanceRemarks</textarea>
            </div>
        </div>
    </div>

    <!-- ================================================================
         ITEMS ACCEPTANCE TABLE
         Includes: #, PR Number, Department, Item No., PPMP Code, Description,
         Unit, PO Qty, Total Insp., Prev. Accepted, Available, Qty This Acceptance,
         Total Accepted, Remaining, Disposition, Inventory Details, Remarks, Hist.
         ================================================================ -->
    <div class="form-card mb-4 p-4 bg-white rounded border shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h4 class="fs-6 fw-bold mb-0 text-primary"><span class="k-icon k-i-check"></span> Officially Accepted Item Quantities</h4>
                <p class="small text-muted mb-0">Specify accepted quantities against physically inspected units. Accepted quantity cannot exceed the available inspected quantity.</p>
            </div>
            @if (!Model.IsReadOnly)
            {
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-success" onclick="acceptAllAvailableQuantities()">
                        <span class="k-icon k-i-check-outline"></span> Accept All Available
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="resetAllAcceptanceToZero()">
                        <span class="k-icon k-i-reset"></span> Reset to Zero
                    </button>
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" id="tblAcceptItems">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 35px;" class="text-center">#</th>
                        <th style="width: 105px;">PR Number</th>
                        <th style="width: 120px;">Department</th>
                        <th style="width: 65px;">Item No.</th>
                        <th style="width: 90px;">PPMP Code</th>
                        <th>Description</th>
                        <th style="width: 55px;">Unit</th>
                        <th style="width: 80px;" class="text-end">PO Qty</th>
                        <th style="width: 80px;" class="text-end">Total Insp.</th>
                        <th style="width: 80px;" class="text-end">Prev. Accepted</th>
                        <th style="width: 85px;" class="text-end text-primary fw-bold">Available</th>
                        <th style="width: 110px;" class="text-end text-success fw-bold">Qty This Acceptance</th>
                        <th style="width: 80px;" class="text-end">Total Accepted</th>
                        <th style="width: 80px;" class="text-end">Remaining</th>
                        <th style="width: 110px;" class="text-center">Disposition</th>
                        <th style="width: 150px;" class="text-center">Inventory Details</th>
                        <th style="width: 115px;">Remarks</th>
                        <th style="width: 45px;" class="text-center">Hist.</th>
                    </tr>
                </thead>
                <tbody id="accItemsTableBody" class="small">
                    <tr>
                        <td colspan="18" class="p-4 text-center text-muted">
                            Loading items for acceptance...
                        </td>
                    </tr>
                </tbody>
                <tfoot class="table-light fw-bold small" id="accItemsTableFooter" style="display:none;">
                    <tr>
                        <td colspan="7" class="text-end">Grand Totals:</td>
                        <td class="text-end font-monospace" id="lblGrandPOQty">0.00</td>
                        <td class="text-end font-monospace" id="lblGrandTotalInspected">0.00</td>
                        <td class="text-end font-monospace text-muted" id="lblGrandPrevAccepted">0.00</td>
                        <td class="text-end font-monospace text-primary" id="lblGrandAvailable">0.00</td>
                        <td class="text-end font-monospace text-success fs-6" id="lblGrandQtyThisAcceptance">0.00</td>
                        <td class="text-end font-monospace" id="lblGrandTotalAccepted">0.00</td>
                        <td class="text-end font-monospace text-danger" id="lblGrandRemaining">0.00</td>
                        <td colspan="4"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ================================================================
         ACCEPTANCE SUMMARY CARD
         ================================================================ -->
    <div class="card mb-4 border shadow-sm" style="border-radius: 8px; overflow: hidden;">
        <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="fw-bold text-dark"><span class="k-icon k-i-aggregate-fields"></span> Acceptance Summary</div>
            <div id="acceptanceStatusBadgeContainer">
                <span class="badge bg-secondary fs-6" id="badgeAcceptanceStatus">Evaluating...</span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="row g-3 text-center">
                <div class="col-md-2 col-4">
                    <div class="small text-muted mb-1">PO Quantity</div>
                    <div class="fs-6 fw-bold text-dark font-monospace" id="summaryPOQty">0.00</div>
                </div>
                <div class="col-md-2 col-4">
                    <div class="small text-muted mb-1">Total Inspected</div>
                    <div class="fs-6 fw-bold text-dark font-monospace" id="summaryTotalInspected">0.00</div>
                </div>
                <div class="col-md-2 col-4">
                    <div class="small text-muted mb-1">Previously Accepted</div>
                    <div class="fs-6 fw-bold text-muted font-monospace" id="summaryPrevAccepted">0.00</div>
                </div>
                <div class="col-md-2 col-4">
                    <div class="small text-success mb-1 fw-semibold">Qty This Acceptance</div>
                    <div class="fs-6 fw-bold text-success font-monospace" id="summaryThisAcceptance">0.00</div>
                </div>
                <div class="col-md-2 col-4">
                    <div class="small text-primary mb-1 fw-semibold">Total Accepted</div>
                    <div class="fs-6 fw-bold text-primary font-monospace" id="summaryTotalAccepted">0.00</div>
                </div>
                <div class="col-md-2 col-4">
                    <div class="small text-danger mb-1 fw-semibold">Remaining</div>
                    <div class="fs-6 fw-bold text-danger font-monospace" id="summaryRemaining">0.00</div>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="small text-muted" id="summaryStatusText">
                    Checking acceptance requirements against Purchase Order items...
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small fw-bold text-secondary">Acceptance Type:</span>
                    <span id="summaryStatusPill" class="badge bg-secondary fs-6">Pending Calculation</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================
         STEP ACTIONS
         ================================================================ -->
    <div class="wizard-summary-bar mt-4">
        <button type="button" class="btn-procurement-secondary" onclick="goToAcceptanceStep(1)">
            <span class="k-icon k-i-arrow-left"></span> Back to Review Inspection
        </button>
        <button type="button" class="btn-procurement-primary" onclick="proceedToAcceptanceStep3()">
            @(Model.IsReadOnly ? "Proceed to Final Summary " : "Proceed to Review & Post ") <span class="k-icon k-i-arrow-right"></span>
        </button>
    </div>

</div>

<script type="text/javascript">
    var expandedItemRows = {};
    var activeModalItemIdx = -1;
    var activeModalSubItemIdx = null;

    function formatNumber(val, decimals) {
        if (val === undefined || val === null || isNaN(val)) return "0.00";
        var dec = (decimals !== undefined) ? decimals : 2;
        return Number(val).toLocaleString("en-US", { minimumFractionDigits: dec, maximumFractionDigits: dec });
    }

    function checkInventoryDetailCompleted(extnName, d) {
        if (!d) return false;
        extnName = extnName || "ItemExtnOther";
        if (extnName === "ItemExtnVehicle") {
            return !!((d.ConductionNo && d.ConductionNo.trim()) ||
                      (d.EngineNo && d.EngineNo.trim()) ||
                      (d.ChasisNo && d.ChasisNo.trim()) ||
                      (d.PlateNo && d.PlateNo.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else if (extnName === "ItemExtnLand") {
            return !!((d.PIN && d.PIN.trim()) ||
                      (d.TctNo && d.TctNo.trim()) ||
                      (d.Address && d.Address.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else if (extnName === "ItemExtnBuilding") {
            return !!((d.ProjectName && d.ProjectName.trim()) ||
                      (d.Address && d.Address.trim()) ||
                      (d.SerialNo && d.SerialNo.trim()));
        } else {
            return !!((d.SerialNo && d.SerialNo.trim()) || (d.Remarks && d.Remarks.trim()));
        }
    }

    function renderAccStep2Items() {
        var tbody = $("#accItemsTableBody");
        tbody.empty();

        if (!acceptanceState || !acceptanceState.Items || acceptanceState.Items.length === 0) {
            tbody.html('<tr><td colspan="18" class="p-4 text-center text-muted">No items available for acceptance.</td></tr>');
            $("#accItemsTableFooter").hide();
            return;
        }

        var isReadOnlyMode = (typeof isReadOnly !== 'undefined' && isReadOnly) || (acceptanceState && acceptanceState.IsReadOnly);

        var html = "";
        acceptanceState.Items.forEach(function (item, idx) {
            // Reconcile item formulas
            var poQty = Number(item.POQty != null ? item.POQty : (item.OrderedQty || 0));
            var totInsp = Number(item.TotalInspectedQty != null ? item.TotalInspectedQty : (item.InspectedQty || 0));
            var prevAcc = Number(item.PreviouslyAcceptedQty != null ? item.PreviouslyAcceptedQty : 0);
            var avail = Math.max(0, totInsp - prevAcc);

            item.POQty = poQty;
            item.TotalInspectedQty = totInsp;
            item.PreviouslyAcceptedQty = prevAcc;
            item.AvailableForAcceptanceQty = avail;

            // Default QtyThisAcceptance if not set
            if (item.QtyThisAcceptance === undefined || item.QtyThisAcceptance === null) {
                if (item.AcceptedQty != null) {
                    item.QtyThisAcceptance = Math.min(avail, Math.max(0, Number(item.AcceptedQty)));
                } else {
                    item.QtyThisAcceptance = avail;
                }
            } else {
                item.QtyThisAcceptance = Math.min(avail, Math.max(0, Number(item.QtyThisAcceptance)));
            }

            var qtyThisAcc = Number(item.QtyThisAcceptance || 0);
            var totAcc = prevAcc + qtyThisAcc;
            var rem = Math.max(0, poQty - totAcc);

            item.TotalAcceptedQty = totAcc;
            item.RemainingQty = rem;
            item.AcceptedQty = qtyThisAcc; // Sync for Step 3/4 and backend payload

            var hasMultipleAllocations = item.Allocations && item.Allocations.length > 1;
            var isSet = item.IsSetLot && item.SubItems && item.SubItems.length > 0;
            var canExpand = hasMultipleAllocations || isSet;
            var isExpanded = !!expandedItemRows[idx];

            var expandBtn = "";
            if (canExpand) {
                var initialIcon = isExpanded ? "k-i-arrow-chevron-down" : "k-i-arrow-chevron-right";
                expandBtn = "<button type='button' class='btn btn-xs btn-link p-0 text-decoration-none' onclick='toggleItemBreakdown(" + idx + ")' title='Toggle breakdown'><span id='expandIcon_" + idx + "' class='k-icon " + initialIcon + "'></span></button>";
            }

            var prCellContent = "";
            var deptCellContent = "";

            if (hasMultipleAllocations) {
                prCellContent = "<span class='badge bg-primary text-white mb-1'>" + item.Allocations.length + " PR Allocations</span>";
                var prNums = item.Allocations.map(function (a) { return a.PRNumber; }).filter(function (p) { return !!p; });
                if (prNums.length > 0) {
                    prCellContent += "<div class='small text-muted text-truncate' style='max-width:125px;' title='" + prNums.join(", ") + "'>" + prNums.join(", ") + "</div>";
                }
                var depts = item.Allocations.map(function (a) { return a.Department; }).filter(function (d) { return !!d; });
                if (depts.length > 0) {
                    deptCellContent = "<div class='small text-muted text-truncate' style='max-width:130px;' title='" + depts.join(", ") + "'>" + depts.join(", ") + "</div>";
                }
            } else if (item.Allocations && item.Allocations.length === 1) {
                var a0 = item.Allocations[0];
                prCellContent = "<span class='small fw-bold text-primary'>" + (a0.PRNumber || item.PRNumber || "--") + "</span>";
                deptCellContent = "<span class='small text-muted text-truncate d-block' style='max-width:130px;' title='" + (a0.Department || item.Department || "--") + "'>" + (a0.Department || item.Department || "--") + "</span>";
            } else {
                prCellContent = "<span class='small fw-bold text-primary'>" + (item.PRNumber || acceptanceState.PRNumber || "--") + "</span>";
                deptCellContent = "<span class='small text-muted text-truncate d-block' style='max-width:130px;' title='" + (item.Department || acceptanceState.Department || "--") + "'>" + (item.Department || acceptanceState.Department || "--") + "</span>";
            }

            html += "<tr id='accItemRow_" + idx + "' data-item-idx='" + idx + "' class='" + (isSet ? "table-set-parent" : "") + "'>";
            html += "<td class='text-center'>" + expandBtn + "</td>";
            html += "<td>" + prCellContent + "</td>";
            html += "<td>" + deptCellContent + "</td>";
            html += "<td class='fw-bold'>" + (item.ItemNo || (idx + 1)) + "</td>";
            html += "<td class='small text-muted'>" + (item.PPMPCode || "--") + "</td>";
            html += "<td>";
            html += "  <div class='fw-semibold text-dark'>" + (item.Description || "Item") + "</div>";
            if (isSet) {
                html += "  <span class='badge bg-info text-dark small me-1'>Set / Lot (" + item.SubItems.length + " components)</span>";
            }
            if (item.ItemExtnName) {
                html += "  <span class='badge bg-light text-secondary border small mt-1'>" + item.ItemExtnName.replace("ItemExtn", "Type: ") + "</span>";
            }
            html += "</td>";
            html += "<td class='text-muted small'>" + (item.Unit || "unit") + "</td>";
            html += "<td class='text-end font-monospace'>" + formatNumber(poQty) + "</td>";
            html += "<td class='text-end font-monospace text-dark'>" + formatNumber(totInsp) + "</td>";
            html += "<td class='text-end font-monospace text-muted'>" + formatNumber(prevAcc) + "</td>";
            html += "<td class='text-end font-monospace fw-bold text-primary' id='lblItemAvail_" + idx + "'>" + formatNumber(avail) + "</td>";

            // Qty This Acceptance (editable input or read-only badge)
            html += "<td class='text-end'>";
            if (isReadOnlyMode) {
                html += "  <span class='fw-bold font-monospace text-success fs-6'>" + formatNumber(qtyThisAcc) + "</span>";
            } else if (hasMultipleAllocations) {
                html += "  <input type='number' step='any' readonly class='form-control-custom text-end fw-bold text-success bg-light border-success' id='txtQtyThisAcceptance_" + idx + "' value='" + qtyThisAcc + "' title='Auto-calculated from PR allocations below' />";
                html += "  <div class='small text-muted' style='font-size:10px;'>Sum of PRs</div>";
            } else {
                html += "  <input type='number' step='any' min='0' max='" + avail + "' class='form-control-custom text-end fw-bold text-success border-success' id='txtQtyThisAcceptance_" + idx + "' value='" + qtyThisAcc + "' oninput='onItemAcceptNowChange(" + idx + ", this.value)' />";
            }
            html += "</td>";

            html += "<td class='text-end font-monospace fw-bold' id='lblItemTotalAcc_" + idx + "'>" + formatNumber(totAcc) + "</td>";
            html += "<td class='text-end font-monospace fw-bold " + (rem > 0 ? "text-danger" : "text-muted") + "' id='lblItemRem_" + idx + "'>" + formatNumber(rem) + "</td>";

            // Disposition (Read-only badge established during inspection)
            var disp = item.Disposition || acceptanceState.Disposition || "Inventory";
            var dispBadgeClass = (disp === "Inventory") ? "bg-primary text-white" : (disp === "For Distribution" || disp === "ForDistribution" ? "bg-success text-white" : "bg-light text-dark border");
            html += "<td class='text-center'><span class='badge " + dispBadgeClass + " px-2 py-1 small'>" + disp + "</span></td>";

            // Inventory Details Cell (Read-Only review button)
            html += "<td class='text-center' id='accInvDetailsCell_" + idx + "'>";
            html += renderAcceptanceInventoryDetailsButtonHtml(item, idx);
            html += "</td>";

            // Acceptance Remarks
            if (isReadOnlyMode) {
                html += "<td><span class='small text-muted'>" + (item.Remarks ? item.Remarks : "--") + "</span></td>";
            } else {
                html += "<td><input type='text' class='form-control-custom w-100 form-control-sm' id='txtItemRemarks_" + idx + "' value='" + (item.Remarks || "") + "' placeholder='Acceptance remarks...' onchange='onItemRemarksChange(" + idx + ", this.value)' /></td>";
            }

            // Hist.
            html += "<td class='text-center'><button type='button' class='btn btn-xs btn-outline-secondary' onclick='openItemHistory(\"" + item.OrderItemId + "\")' title='View History'><span class='k-icon k-i-history'></span></button></td>";
            html += "</tr>";

            // Breakdown row for multiple allocations OR Set/Lot components
            if (canExpand) {
                html += "<tr id='breakdownRow_" + idx + "' style='" + (isExpanded ? "" : "display:none;") + "' class='table-light'>";
                html += "  <td></td>";
                html += "  <td colspan='17' class='p-3'>";

                // 1. Multiple PR Allocations Table
                if (hasMultipleAllocations) {
                    html += "    <div class='p-2 bg-white rounded border mb-3 shadow-sm'>";
                    html += "      <div class='d-flex justify-content-between align-items-center mb-2'>";
                    html += "        <div class='fw-bold small text-primary'><span class='k-icon k-i-list-unordered'></span> PR Allocations Breakdown for Item #" + (item.ItemNo || (idx + 1)) + ":</div>";
                    html += "        <span class='badge bg-light text-secondary border small'>Enter acceptance quantities per PR allocation</span>";
                    html += "      </div>";
                    html += "      <table class='table table-sm table-bordered mb-0'>";
                    html += "        <thead class='table-light small'>";
                    html += "          <tr>";
                    html += "            <th style='width:120px;'>PR Number</th>";
                    html += "            <th>Department</th>";
                    html += "            <th style='width:90px;' class='text-end'>Allocated</th>";
                    html += "            <th style='width:90px;' class='text-end'>Total Insp.</th>";
                    html += "            <th style='width:90px;' class='text-end'>Prev. Accepted</th>";
                    html += "            <th style='width:90px;' class='text-end text-primary'>Available</th>";
                    html += "            <th style='width:110px;' class='text-end text-success fw-bold'>Accept Now</th>";
                    html += "            <th style='width:90px;' class='text-end'>Total Accepted</th>";
                    html += "            <th style='width:90px;' class='text-end'>Remaining</th>";
                    html += "            <th>Remarks</th>";
                    html += "          </tr>";
                    html += "        </thead>";
                    html += "        <tbody>";

                    item.Allocations.forEach(function (alloc, aIdx) {
                        var aTotInsp = Number(alloc.QtyInspected || 0);
                        var aPrevAcc = Number(alloc.PreviousAccepted || 0);
                        var aAvail = Math.max(0, aTotInsp - aPrevAcc);

                        alloc.TotalInspected = aTotInsp;
                        alloc.PreviousAccepted = aPrevAcc;
                        alloc.AvailableForAcceptance = aAvail;

                        if (alloc.QtyThisAcceptance === undefined || alloc.QtyThisAcceptance === null) {
                            alloc.QtyThisAcceptance = Math.min(aAvail, aTotInsp);
                        } else {
                            alloc.QtyThisAcceptance = Math.min(aAvail, Math.max(0, Number(alloc.QtyThisAcceptance)));
                        }

                        var aQtyThis = Number(alloc.QtyThisAcceptance || 0);
                        var aTotAcc = aPrevAcc + aQtyThis;
                        var aAllocated = Number(alloc.QtyAllocated || 0);
                        var aRem = Math.max(0, aAllocated - aTotAcc);

                        alloc.TotalAccepted = aTotAcc;
                        alloc.RemainingQty = aRem;

                        html += "          <tr>";
                        html += "            <td class='fw-bold small text-primary'>" + (alloc.PRNumber || "--") + "</td>";
                        html += "            <td class='small text-muted'>" + (alloc.Department || "--") + "</td>";
                        html += "            <td class='text-end font-monospace small'>" + formatNumber(aAllocated) + "</td>";
                        html += "            <td class='text-end font-monospace small'>" + formatNumber(aTotInsp) + "</td>";
                        html += "            <td class='text-end font-monospace small text-muted'>" + formatNumber(aPrevAcc) + "</td>";
                        html += "            <td class='text-end font-monospace small text-primary fw-bold' id='lblAllocAvail_" + idx + "_" + aIdx + "'>" + formatNumber(aAvail) + "</td>";

                        if (isReadOnlyMode) {
                            html += "            <td class='text-end font-monospace small fw-bold text-success'>" + formatNumber(aQtyThis) + "</td>";
                        } else {
                            html += "            <td class='text-end'><input type='number' step='any' min='0' max='" + aAvail + "' class='form-control-custom text-end fw-bold form-control-sm text-success border-success' id='txtAllocAcceptNow_" + idx + "_" + aIdx + "' value='" + aQtyThis + "' oninput='onAllocAcceptNowChange(" + idx + ", " + aIdx + ", this.value)' /></td>";
                        }

                        html += "            <td class='text-end font-monospace small fw-bold' id='lblAllocTotAcc_" + idx + "_" + aIdx + "'>" + formatNumber(aTotAcc) + "</td>";
                        html += "            <td class='text-end font-monospace small fw-bold " + (aRem > 0 ? "text-danger" : "text-muted") + "' id='lblAllocRem_" + idx + "_" + aIdx + "'>" + formatNumber(aRem) + "</td>";

                        if (isReadOnlyMode) {
                            html += "            <td><span class='small text-muted'>" + (alloc.Remarks || "--") + "</span></td>";
                        } else {
                            html += "            <td><input type='text' class='form-control-custom w-100 form-control-sm' id='txtAllocRemarks_" + idx + "_" + aIdx + "' value='" + (alloc.Remarks || "") + "' placeholder='Allocation notes...' onchange='onAllocRemarksChange(" + idx + ", " + aIdx + ", this.value)' /></td>";
                        }
                        html += "          </tr>";
                    });

                    html += "        </tbody>";
                    html += "      </table>";
                    html += "    </div>";
                }

                // 2. Set/Lot Components Table
                if (isSet) {
                    html += "    <div class='p-2 bg-white rounded border shadow-sm'>";
                    html += "      <div class='d-flex justify-content-between align-items-center mb-2'>";

    function renderAcceptanceInventoryDetailsButtonHtml(item, idx) {
        var disp = item.Disposition || (acceptanceState ? acceptanceState.Disposition : "") || "Inventory";
        if (disp !== "Inventory") {
            return "<span class='badge bg-light text-muted border'>Not Required</span>";
        }

        var details = item.InventoryDetails || [];
        var totalUnits = details.length;
        var compUnits = details.filter(function (d) { return checkInventoryDetailCompleted(item.ItemExtnName, d); }).length;

        if (totalUnits > 0) {
            return "<button type='button' class='btn btn-xs btn-outline-primary w-100 text-nowrap' onclick='openInventoryModal(" + idx + ")'><span class='k-icon k-i-eye'></span> View Details (" + compUnits + " / " + totalUnits + ")</button>";
        } else {
            return "<span class='badge bg-light text-muted border'>0 units recorded</span>";
        }
    }

    function renderAcceptanceSubItemInventoryDetailsButtonHtml(item, idx, sub, sIdx) {
        var parentDisp = item.Disposition || (acceptanceState ? acceptanceState.Disposition : "") || "Inventory";
        if (!sub.RequiresInventory || parentDisp !== "Inventory") {
            return "<span class='badge bg-light text-muted border'>Not Required</span>";
        }

        var details = sub.InventoryDetails || [];
        var totalUnits = details.length;
        var compUnits = details.filter(function (d) { return checkInventoryDetailCompleted(sub.ItemExtnName, d); }).length;

        if (totalUnits > 0) {
            return "<button type='button' class='btn btn-xs btn-outline-primary w-100 text-nowrap' onclick='openInventoryModal(" + idx + ", " + sIdx + ")'><span class='k-icon k-i-eye'></span> View Details (" + compUnits + " / " + totalUnits + ")</button>";
        } else {
            return "<span class='badge bg-light text-muted border'>0 units recorded</span>";
        }
    }

    function openInventoryModal(idx, sIdx) {
        activeModalItemIdx = idx;
        activeModalSubItemIdx = (sIdx !== undefined && sIdx !== null) ? sIdx : null;

        var item = acceptanceState.Items[idx];
        if (!item) return;

        var isSub = (activeModalSubItemIdx !== null);
        var targetObj = isSub ? item.SubItems[activeModalSubItemIdx] : item;
        if (!targetObj) return;

        var extnName = targetObj.ItemExtnName || "ItemExtnOther";
        var details = targetObj.InventoryDetails || [];
        var totalCount = details.length;
        var compCount = details.filter(function (d) { return checkInventoryDetailCompleted(extnName, d); }).length;

        var extnTitle = "Other / General Equipment";
        if (extnName === "ItemExtnVehicle") extnTitle = "Motor Vehicle";
        else if (extnName === "ItemExtnLand") extnTitle = "Real Property / Land";
        else if (extnName === "ItemExtnBuilding") extnTitle = "Building / Structure";

        var targetTitle = isSub 
            ? (targetObj.Description || "Sub-Item") + " <span class='badge bg-info text-dark ms-1'>Sub-Item of " + (item.Description || "Parent") + "</span>"
            : (targetObj.Description || "Parent Item");

        var html = "";

        // Modal Header Info
        html += "<div class='p-3 bg-light rounded border mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2'>";
        html += "  <div>";
        html += "    <div class='fw-bold fs-6 text-dark'>" + targetTitle + "</div>";
        html += "    <div class='small text-muted'>Inspected Units Recorded: <strong class='text-primary'>" + totalCount + " units</strong> &bull; Category: <span class='badge bg-secondary'>" + extnTitle + "</span> &bull; Mode: <span class='badge bg-info text-dark'>Read-Only Review</span></div>";
        html += "  </div>";
        html += "  <div class='d-flex align-items-center gap-2'>";
        html += "    <span class='badge " + (compCount >= totalCount && totalCount > 0 ? "bg-success" : "bg-warning text-dark") + " fs-6'>";
        html += "      " + compCount + " of " + totalCount + " Complete";
        html += "    </span>";
        html += "  </div>";
        html += "</div>";

        // Scrollable container
        html += "<div style='max-height: 430px; overflow-y: auto;' class='pe-1'>";

        if (details.length === 0) {
            html += "<div class='p-4 text-center text-muted bg-light rounded border'>No physical inventory details were recorded during inspection for this item.</div>";
        } else {
            // Group details by PR
            var prGroups = {};
            details.forEach(function (d) {
                var prKey = d.PRNumber || "Default PR";
                if (!prGroups[prKey]) prGroups[prKey] = [];
                prGroups[prKey].push(d);
            });

            var globalIdx = 0;
            for (var prKey in prGroups) {
                if (!prGroups.hasOwnProperty(prKey)) continue;
                var units = prGroups[prKey];
                var deptName = (units[0] && units[0].DepartmentName) ? units[0].DepartmentName : (item.Department || "--");

                html += "<div class='card mb-3 border shadow-sm'>";
                html += "  <div class='card-header bg-light py-2 d-flex justify-content-between align-items-center flex-wrap gap-1'>";
                html += "    <div>";
                html += "      <span class='fw-bold text-dark'>PR No.: </span><span class='badge bg-primary fs-7 me-3'>" + prKey + "</span>";
                html += "      <span class='fw-bold text-dark'>Department: </span><span class='text-secondary fw-semibold'>" + deptName + "</span>";
                html += "    </div>";
                html += "    <span class='badge bg-light text-dark border'>Recorded Units: " + units.length + "</span>";
                html += "  </div>";
                html += "  <div class='card-body p-0'>";
                html += "    <div class='table-responsive'>";
                html += "      <table class='table table-sm table-bordered align-middle mb-0'>";
                html += "        <thead class='table-light small'>";
                html += "          <tr>";
                html += "            <th style='width:45px;' class='text-center'>#</th>";

                if (extnName === "ItemExtnVehicle") {
                    html += "        <th style='width:120px;'>Serial No.</th>";
                    html += "        <th style='width:120px;'>Conduction No.</th>";
                    html += "        <th style='width:120px;'>Engine No.</th>";
                    html += "        <th style='width:120px;'>Chassis No.</th>";
                    html += "        <th style='width:100px;'>Plate No.</th>";
                    html += "        <th style='width:90px;'>Color</th>";
                    html += "        <th style='width:90px;'>Year</th>";
                    html += "        <th>Series</th>";
                } else if (extnName === "ItemExtnLand") {
                    html += "        <th style='width:110px;'>PIN</th>";
                    html += "        <th style='width:110px;'>TCT No.</th>";
                    html += "        <th style='width:100px;'>Lot No.</th>";
                    html += "        <th style='width:100px;'>Survey No.</th>";
                    html += "        <th style='width:100px;'>Area</th>";
                    html += "        <th>Address</th>";
                } else if (extnName === "ItemExtnBuilding") {
                    html += "        <th style='width:130px;'>Ref / Serial</th>";
                    html += "        <th style='width:160px;'>Project Name</th>";
                    html += "        <th style='width:110px;'>Type</th>";
                    html += "        <th style='width:80px;'>Storeys</th>";
                    html += "        <th style='width:100px;'>Floor Area</th>";
                    html += "        <th>Address</th>";
                } else { // ItemExtnOther
                    html += "        <th style='width:220px;'>Serial Number</th>";
                    html += "        <th>Notes / Remarks</th>";
                }

                html += "            <th style='width:60px;' class='text-center'>Status</th>";
                html += "          </tr>";
                html += "        </thead>";
                html += "        <tbody class='small'>";

                units.forEach(function (u, localIdx) {
                    globalIdx++;
                    var isComp = checkInventoryDetailCompleted(extnName, u);

                    html += "      <tr>";
                    html += "        <td class='text-center fw-bold bg-light'>" + (localIdx + 1) + "</td>";

                    if (extnName === "ItemExtnVehicle") {
                        html += "    <td><span class='font-monospace fw-bold text-dark'>" + (u.SerialNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.ConductionNo || "--") + "</span></td>";
                        html += "    <td><span class='font-monospace'>" + (u.EngineNo || "--") + "</span></td>";
                        html += "    <td><span class='font-monospace'>" + (u.ChasisNo || "--") + "</span></td>";
                        html += "    <td><span class='badge bg-light text-dark border'>" + (u.PlateNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.Color || "--") + "</span></td>";
                        html += "    <td><span>" + (u.YearModel || "--") + "</span></td>";
                        html += "    <td><span>" + (u.SeriesNo || "--") + "</span></td>";
                    } else if (extnName === "ItemExtnLand") {
                        html += "    <td><span class='font-monospace'>" + (u.PIN || "--") + "</span></td>";
                        html += "    <td><span class='font-monospace'>" + (u.TctNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.LotNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.SurveyNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.Area || "--") + "</span></td>";
                        html += "    <td><span>" + (u.Address || "--") + "</span></td>";
                    } else if (extnName === "ItemExtnBuilding") {
                        html += "    <td><span class='font-monospace'>" + (u.SerialNo || "--") + "</span></td>";
                        html += "    <td><span class='fw-bold'>" + (u.ProjectName || "--") + "</span></td>";
                        html += "    <td><span>" + (u.BuildingType || "--") + "</span></td>";
                        html += "    <td><span>" + (u.NumStoreys || "--") + "</span></td>";
                        html += "    <td><span>" + (u.FloorArea || "--") + "</span></td>";
                        html += "    <td><span>" + (u.Address || "--") + "</span></td>";
                    } else { // ItemExtnOther
                        html += "    <td><span class='font-monospace fw-bold text-dark'>" + (u.SerialNo || "--") + "</span></td>";
                        html += "    <td><span>" + (u.Remarks || "--") + "</span></td>";
                    }

                    html += "        <td class='text-center'>";
                    html += "          " + (isComp ? "<span class='badge bg-success'>OK</span>" : "<span class='badge bg-light text-muted border'>--</span>");
                    html += "        </td>";
                    html += "      </tr>";
                });

                html += "        </tbody>";
                html += "      </table>";
                html += "    </div>";
                html += "  </div>";
                html += "</div>";
            }
        }

        html += "</div>";

        // Read-only Modal footer
        html += "<div class='d-flex justify-content-between align-items-center mt-3 pt-2 border-top'>";
        html += "  <span class='small text-muted'><span class='k-icon k-i-lock'></span> Inventory details entered during physical inspection (Read-Only Review).</span>";
        html += "  <button type='button' class='btn-procurement-secondary btn-sm' onclick='closeInventoryModal()'>Close</button>";
        html += "</div>";

        $("#inventoryDetailsModalContent").html(html);
        var win = $("#inventoryDetailsWindow").data("kendoWindow");
        if (win) {
            win.center().open();
        }
    }

    function closeInventoryModal() {
        var win = $("#inventoryDetailsWindow").data("kendoWindow");
        if (win) win.close();
    }

    // ================================================================
    // VALIDATION & STEP ADVANCEMENT
    // ================================================================
    function proceedToAcceptanceStep3() {
        var officer = $("#txtAcceptedBy").val();
        if (!officer || !officer.trim()) {
            alert("Please enter the name of the Authorized Acceptance Officer.");
            $("#txtAcceptedBy").focus();
            return;
        }

        // Validate quantities client-side
        if (acceptanceState.Items && acceptanceState.Items.length > 0) {
            for (var i = 0; i < acceptanceState.Items.length; i++) {
                var itm = acceptanceState.Items[i];
                var avail = itm.AvailableForAcceptanceQty || 0;
                var qtyThis = itm.QtyThisAcceptance || 0;

                if (qtyThis < 0) {
                    alert("Accepted quantity for Item #" + (itm.ItemNo || (i + 1)) + " cannot be negative.");
                    $("#txtQtyThisAcceptance_" + i).focus();
                    return;
                }
                if (qtyThis > avail) {
                    alert("Accepted quantity for Item #" + (itm.ItemNo || (i + 1)) + " cannot exceed Available Inspected Quantity (" + formatNumber(avail) + ").");
                    $("#txtQtyThisAcceptance_" + i).focus();
                    return;
                }
                var poQty = itm.POQty || 0;
                var totAcc = (itm.PreviouslyAcceptedQty || 0) + qtyThis;
                if (totAcc > poQty) {
                    alert("Total accepted quantity for Item #" + (itm.ItemNo || (i + 1)) + " cannot exceed original Purchase Order Quantity (" + formatNumber(poQty) + ").");
                    $("#txtQtyThisAcceptance_" + i).focus();
                    return;
                }

                // Check components
                if (itm.IsSetLot && itm.SubItems && itm.SubItems.length > 0) {
                    for (var s = 0; s < itm.SubItems.length; s++) {
                        var sub = itm.SubItems[s];
                        var sAvail = sub.AvailableForAcceptanceQty || 0;
                        var sQtyThis = sub.QtyThisAcceptance || 0;
                        if (sQtyThis < 0 || sQtyThis > sAvail) {
                            alert("Component '" + (sub.Description || ("#" + (s + 1))) + "' accepted quantity (" + sQtyThis + ") exceeds available (" + sAvail + ").");
                            return;
                        }
                    }
                }
            }
        }

        // Synchronize form fields into acceptanceState
        if (typeof collectAcceptanceFormData === "function") {
            collectAcceptanceFormData();
        }

        goToAcceptanceStep(3);
    }

    $(document).ready(function () {
        renderAccStep2Items();
    });
</script>


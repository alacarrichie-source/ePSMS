    function toggleItemBreakdown(idx) {
        var row = $("#breakdownRow_" + idx);
        var icon = $("#expandIcon_" + idx);
        if (row.is(":visible")) {
            row.hide();
            icon.removeClass("k-i-arrow-chevron-down").addClass("k-i-arrow-chevron-right");
            expandedItemRows[idx] = false;
        } else {
            row.show();
            icon.removeClass("k-i-arrow-chevron-right").addClass("k-i-arrow-chevron-down");
            expandedItemRows[idx] = true;
        }
    }

    function onItemAcceptNowChange(idx, valStr) {
        var item = acceptanceState.Items[idx];
        if (!item) return;

        var val = parseFloat(valStr);
        if (isNaN(val) || val < 0) val = 0;

        var avail = item.AvailableForAcceptanceQty || 0;
        if (val > avail) {
            val = avail;
            $("#txtQtyThisAcceptance_" + idx).val(val);
            alert("Accepted quantity cannot exceed the available inspected quantity (" + formatNumber(avail) + ").");
        }

        item.QtyThisAcceptance = val;
        item.AcceptedQty = val;
        var prevAcc = item.PreviouslyAcceptedQty || 0;
        item.TotalAcceptedQty = prevAcc + val;
        item.RemainingQty = Math.max(0, (item.POQty || 0) - item.TotalAcceptedQty);

        $("#lblItemTotalAcc_" + idx).text(formatNumber(item.TotalAcceptedQty));
        var lblRem = $("#lblItemRem_" + idx);
        lblRem.text(formatNumber(item.RemainingQty));
        if (item.RemainingQty > 0) lblRem.removeClass("text-muted").addClass("text-danger");
        else lblRem.removeClass("text-danger").addClass("text-muted");

        // If Set/Lot, proportionally synchronize child component quantities
        if (item.IsSetLot && item.SubItems && item.SubItems.length > 0) {
            var pRatio = (item.POQty > 0) ? (val / item.POQty) : 0;
            item.SubItems.forEach(function (sub, sIdx) {
                var sAvail = sub.AvailableForAcceptanceQty || 0;
                var targetSub = (sub.QtyPerParent > 0) ? (val * sub.QtyPerParent) : (sub.ExpectedQty * pRatio);
                sub.QtyThisAcceptance = Math.min(sAvail, Math.max(0, Math.round(targetSub * 100) / 100));
                sub.TotalAcceptedQty = (sub.PreviouslyAcceptedQty || 0) + sub.QtyThisAcceptance;
                sub.RemainingQty = Math.max(0, (sub.ExpectedQty || 0) - sub.TotalAcceptedQty);

                $("#txtSubAcceptNow_" + idx + "_" + sIdx).val(sub.QtyThisAcceptance);
                $("#lblSubTotAcc_" + idx + "_" + sIdx).text(formatNumber(sub.TotalAcceptedQty));
                var subRemLbl = $("#lblSubRem_" + idx + "_" + sIdx);
                subRemLbl.text(formatNumber(sub.RemainingQty));
                if (sub.RemainingQty > 0) subRemLbl.removeClass("text-muted").addClass("text-danger");
                else subRemLbl.removeClass("text-danger").addClass("text-muted");
            });
        }

        recalculateAccGrandTotals();
    }

    function onSubItemAcceptNowChange(idx, sIdx, valStr) {
        var item = acceptanceState.Items[idx];
        if (!item || !item.SubItems || !item.SubItems[sIdx]) return;

        var sub = item.SubItems[sIdx];
        var val = parseFloat(valStr);
        if (isNaN(val) || val < 0) val = 0;

        var avail = sub.AvailableForAcceptanceQty || 0;
        if (val > avail) {
            val = avail;
            $("#txtSubAcceptNow_" + idx + "_" + sIdx).val(val);
            alert("Component accepted quantity cannot exceed available inspected quantity (" + formatNumber(avail) + ").");
        }

        sub.QtyThisAcceptance = val;
        sub.TotalAcceptedQty = (sub.PreviouslyAcceptedQty || 0) + val;
        sub.RemainingQty = Math.max(0, (sub.ExpectedQty || 0) - sub.TotalAcceptedQty);

        $("#lblSubTotAcc_" + idx + "_" + sIdx).text(formatNumber(sub.TotalAcceptedQty));
        var subRemLbl = $("#lblSubRem_" + idx + "_" + sIdx);
        subRemLbl.text(formatNumber(sub.RemainingQty));
        if (sub.RemainingQty > 0) subRemLbl.removeClass("text-muted").addClass("text-danger");
        else subRemLbl.removeClass("text-danger").addClass("text-muted");

        // Verify parent Set/Lot consistency: parent sets cannot exceed supported component sets
        var maxPossibleSets = 99999999;
        item.SubItems.forEach(function (c) {
            var qtyPer = c.QtyPerParent > 0 ? c.QtyPerParent : 1;
            var compSets = Math.floor(((c.PreviouslyAcceptedQty || 0) + (c.QtyThisAcceptance || 0)) / qtyPer) - (item.PreviouslyAcceptedQty || 0);
            if (compSets < maxPossibleSets) maxPossibleSets = compSets;
        });
        if (maxPossibleSets < 0) maxPossibleSets = 0;

        if (item.QtyThisAcceptance > maxPossibleSets) {
            item.QtyThisAcceptance = maxPossibleSets;
            item.AcceptedQty = maxPossibleSets;
            item.TotalAcceptedQty = (item.PreviouslyAcceptedQty || 0) + maxPossibleSets;
            item.RemainingQty = Math.max(0, (item.POQty || 0) - item.TotalAcceptedQty);

            $("#txtQtyThisAcceptance_" + idx).val(maxPossibleSets);
            $("#lblItemTotalAcc_" + idx).text(formatNumber(item.TotalAcceptedQty));
            var pRemLbl = $("#lblItemRem_" + idx);
            pRemLbl.text(formatNumber(item.RemainingQty));
            if (item.RemainingQty > 0) pRemLbl.removeClass("text-muted").addClass("text-danger");
            else pRemLbl.removeClass("text-danger").addClass("text-muted");
        }

        recalculateAccGrandTotals();
    }

    function onAllocAcceptNowChange(idx, aIdx, valStr) {
        var item = acceptanceState.Items[idx];
        if (!item || !item.Allocations || !item.Allocations[aIdx]) return;

        var alloc = item.Allocations[aIdx];
        var val = parseFloat(valStr);
        if (isNaN(val) || val < 0) val = 0;

        var avail = alloc.AvailableForAcceptance || 0;
        if (val > avail) {
            val = avail;
            $("#txtAllocAcceptNow_" + idx + "_" + aIdx).val(val);
            alert("Allocation accepted quantity cannot exceed available inspected quantity (" + formatNumber(avail) + ").");
        }

        alloc.QtyThisAcceptance = val;
        alloc.TotalAccepted = (alloc.PreviousAccepted || 0) + val;
        alloc.RemainingQty = Math.max(0, (alloc.QtyAllocated || 0) - alloc.TotalAccepted);

        $("#lblAllocTotAcc_" + idx + "_" + aIdx).text(formatNumber(alloc.TotalAccepted));
        var allocRemLbl = $("#lblAllocRem_" + idx + "_" + aIdx);
        allocRemLbl.text(formatNumber(alloc.RemainingQty));
        if (alloc.RemainingQty > 0) allocRemLbl.removeClass("text-muted").addClass("text-danger");
        else allocRemLbl.removeClass("text-danger").addClass("text-muted");

        // Sum allocations into parent item
        var sumAlloc = 0;
        item.Allocations.forEach(function (a) {
            sumAlloc += Number(a.QtyThisAcceptance || 0);
        });
        item.QtyThisAcceptance = sumAlloc;
        item.AcceptedQty = sumAlloc;
        item.TotalAcceptedQty = (item.PreviouslyAcceptedQty || 0) + sumAlloc;
        item.RemainingQty = Math.max(0, (item.POQty || 0) - item.TotalAcceptedQty);

        $("#txtQtyThisAcceptance_" + idx).val(sumAlloc);
        $("#lblItemTotalAcc_" + idx).text(formatNumber(item.TotalAcceptedQty));
        var lblRem = $("#lblItemRem_" + idx);
        lblRem.text(formatNumber(item.RemainingQty));
        if (item.RemainingQty > 0) lblRem.removeClass("text-muted").addClass("text-danger");
        else lblRem.removeClass("text-danger").addClass("text-muted");

        recalculateAccGrandTotals();
    }


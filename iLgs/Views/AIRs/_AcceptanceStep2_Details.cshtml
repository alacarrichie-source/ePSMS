                        sub.ExpectedQty = sExpected;
                        sub.TotalInspectedQty = sTotInsp;
                        sub.PreviouslyAcceptedQty = sPrevAcc;
                        sub.AvailableForAcceptanceQty = sAvail;

                        // Default component Accept Now

                            var ratio = (poQty > 0) ? (qtyThisAcc / poQty) : 0;
                            var subRatioTarget = (sub.QtyPerParent > 0) ? (qtyThisAcc * sub.QtyPerParent) : (sExpected * ratio);
                            sub.QtyThisAcceptance = Math.min(sAvail, Math.max(0, subRatioTarget));
                        } else {
                            sub.QtyThisAcceptance = Math.min(sAvail, Math.max(0, Number(sub.QtyThisAcceptance)));
                        }

                        var sQtyThis = Number(sub.QtyThisAcceptance || 0);
                        var sTotAcc = sPrevAcc + sQtyThis;
                        var sRem = Math.max(0, sExpected - sTotAcc);

                        sub.TotalAcceptedQty = sTotAcc;
                        sub.RemainingQty = sRem;

                        html += "          <tr>";

    function acceptAllAvailableQuantities() {
        if (!acceptanceState || !acceptanceState.Items) return;
        acceptanceState.Items.forEach(function (item, idx) {
            var avail = item.AvailableForAcceptanceQty || 0;
            item.QtyThisAcceptance = avail;
            item.AcceptedQty = avail;
            item.TotalAcceptedQty = (item.PreviouslyAcceptedQty || 0) + avail;
            item.RemainingQty = Math.max(0, (item.POQty || 0) - item.TotalAcceptedQty);

            $("#txtQtyThisAcceptance_" + idx).val(avail);
            $("#lblItemTotalAcc_" + idx).text(formatNumber(item.TotalAcceptedQty));
            var lblRem = $("#lblItemRem_" + idx);
            lblRem.text(formatNumber(item.RemainingQty));
            if (item.RemainingQty > 0) lblRem.removeClass("text-muted").addClass("text-danger");
            else lblRem.removeClass("text-danger").addClass("text-muted");

            if (item.Allocations && item.Allocations.length > 0) {
                item.Allocations.forEach(function (alloc, aIdx) {
                    var aAvail = alloc.AvailableForAcceptance || 0;
                    alloc.QtyThisAcceptance = aAvail;
                    alloc.TotalAccepted = (alloc.PreviousAccepted || 0) + aAvail;
                    alloc.RemainingQty = Math.max(0, (alloc.QtyAllocated || 0) - alloc.TotalAccepted);
                    $("#txtAllocAcceptNow_" + idx + "_" + aIdx).val(aAvail);
                    $("#lblAllocTotAcc_" + idx + "_" + aIdx).text(formatNumber(alloc.TotalAccepted));
                    var aRemLbl = $("#lblAllocRem_" + idx + "_" + aIdx);
                    aRemLbl.text(formatNumber(alloc.RemainingQty));
                    if (alloc.RemainingQty > 0) aRemLbl.removeClass("text-muted").addClass("text-danger");
                    else aRemLbl.removeClass("text-danger").addClass("text-muted");
                });
            }

            if (item.IsSetLot && item.SubItems && item.SubItems.length > 0) {
                item.SubItems.forEach(function (sub, sIdx) {
                    var sAvail = sub.AvailableForAcceptanceQty || 0;
                    sub.QtyThisAcceptance = sAvail;
                    sub.TotalAcceptedQty = (sub.PreviouslyAcceptedQty || 0) + sAvail;
                    sub.RemainingQty = Math.max(0, (sub.ExpectedQty || 0) - sub.TotalAcceptedQty);
                    $("#txtSubAcceptNow_" + idx + "_" + sIdx).val(sAvail);
                    $("#lblSubTotAcc_" + idx + "_" + sIdx).text(formatNumber(sub.TotalAcceptedQty));
                    var sRemLbl = $("#lblSubRem_" + idx + "_" + sIdx);
                    sRemLbl.text(formatNumber(sub.RemainingQty));
                    if (sub.RemainingQty > 0) sRemLbl.removeClass("text-muted").addClass("text-danger");
                    else sRemLbl.removeClass("text-danger").addClass("text-muted");
                });
            }
        });

        recalculateAccGrandTotals();
    }

    function resetAllAcceptanceToZero() {
        if (!acceptanceState || !acceptanceState.Items) return;
        acceptanceState.Items.forEach(function (item, idx) {
            item.QtyThisAcceptance = 0;
            item.AcceptedQty = 0;
            item.TotalAcceptedQty = item.PreviouslyAcceptedQty || 0;
            item.RemainingQty = Math.max(0, (item.POQty || 0) - item.TotalAcceptedQty);

            $("#txtQtyThisAcceptance_" + idx).val(0);
            $("#lblItemTotalAcc_" + idx).text(formatNumber(item.TotalAcceptedQty));
            var lblRem = $("#lblItemRem_" + idx);
            lblRem.text(formatNumber(item.RemainingQty));
            if (item.RemainingQty > 0) lblRem.removeClass("text-muted").addClass("text-danger");
            else lblRem.removeClass("text-danger").addClass("text-muted");

            if (item.Allocations && item.Allocations.length > 0) {
                item.Allocations.forEach(function (alloc, aIdx) {
                    alloc.QtyThisAcceptance = 0;
                    alloc.TotalAccepted = alloc.PreviousAccepted || 0;
                    alloc.RemainingQty = Math.max(0, (alloc.QtyAllocated || 0) - alloc.TotalAccepted);
                    $("#txtAllocAcceptNow_" + idx + "_" + aIdx).val(0);
                    $("#lblAllocTotAcc_" + idx + "_" + aIdx).text(formatNumber(alloc.TotalAccepted));
                    var aRemLbl = $("#lblAllocRem_" + idx + "_" + aIdx);
                    aRemLbl.text(formatNumber(alloc.RemainingQty));
                    if (alloc.RemainingQty > 0) aRemLbl.removeClass("text-muted").addClass("text-danger");
                    else aRemLbl.removeClass("text-danger").addClass("text-muted");
                });
            }

            if (item.IsSetLot && item.SubItems && item.SubItems.length > 0) {
                item.SubItems.forEach(function (sub, sIdx) {
                    sub.QtyThisAcceptance = 0;
                    sub.TotalAcceptedQty = sub.PreviouslyAcceptedQty || 0;
                    sub.RemainingQty = Math.max(0, (sub.ExpectedQty || 0) - sub.TotalAcceptedQty);
                    $("#txtSubAcceptNow_" + idx + "_" + sIdx).val(0);
                    $("#lblSubTotAcc_" + idx + "_" + sIdx).text(formatNumber(sub.TotalAcceptedQty));
                    var sRemLbl = $("#lblSubRem_" + idx + "_" + sIdx);
                    sRemLbl.text(formatNumber(sub.RemainingQty));
                    if (sub.RemainingQty > 0) sRemLbl.removeClass("text-muted").addClass("text-danger");
                    else sRemLbl.removeClass("text-danger").addClass("text-muted");
                });
            }
        });

        recalculateAccGrandTotals();
    }

    function recalculateAccGrandTotals() {
        if (!acceptanceState || !acceptanceState.Items) return;

        var gPOQty = 0;
        var gTotInsp = 0;
        var gPrevAcc = 0;
        var gAvail = 0;
        var gQtyThis = 0;
        var gTotAcc = 0;
        var gRem = 0;

        var allItemsComplete = true;
        var hasAnyAcceptance = false;

        acceptanceState.Items.forEach(function (item) {
            var poQty = Number(item.POQty || 0);
            var totInsp = Number(item.TotalInspectedQty || 0);
            var prevAcc = Number(item.PreviouslyAcceptedQty || 0);
            var avail = Number(item.AvailableForAcceptanceQty || 0);
            var qtyThis = Number(item.QtyThisAcceptance || 0);
            var totAcc = prevAcc + qtyThis;
            var rem = Math.max(0, poQty - totAcc);

            gPOQty += poQty;
            gTotInsp += totInsp;
            gPrevAcc += prevAcc;
            gAvail += avail;
            gQtyThis += qtyThis;
            gTotAcc += totAcc;
            gRem += rem;

            if (totAcc > 0) hasAnyAcceptance = true;

            // Check individual item completion
            if (totAcc < poQty) {
                allItemsComplete = false;
            }

            // If Set/Lot, also check individual component completion
            if (item.IsSetLot && item.SubItems && item.SubItems.length > 0) {
                item.SubItems.forEach(function (sub) {
                    var sExp = Number(sub.ExpectedQty || 0);
                    var sTot = Number(sub.TotalAcceptedQty || 0);
                    if (sTot < sExp) {
                        allItemsComplete = false;
                    }
                });
            }
        });

        // Update footer
        $("#lblGrandPOQty").text(formatNumber(gPOQty));
        $("#lblGrandTotalInspected").text(formatNumber(gTotInsp));
        $("#lblGrandPrevAccepted").text(formatNumber(gPrevAcc));
        $("#lblGrandAvailable").text(formatNumber(gAvail));
        $("#lblGrandQtyThisAcceptance").text(formatNumber(gQtyThis));
        $("#lblGrandTotalAccepted").text(formatNumber(gTotAcc));
        $("#lblGrandRemaining").text(formatNumber(gRem));

        // Update summary card
        $("#summaryPOQty").text(formatNumber(gPOQty));
        $("#summaryTotalInspected").text(formatNumber(gTotInsp));
        $("#summaryPrevAccepted").text(formatNumber(gPrevAcc));
        $("#summaryThisAcceptance").text(formatNumber(gQtyThis));
        $("#summaryTotalAccepted").text(formatNumber(gTotAcc));
        $("#summaryRemaining").text(formatNumber(gRem));

        // Save totals to state
        acceptanceState.TotalPOQty = gPOQty;
        acceptanceState.TotalInspectedQty = gTotInsp;
        acceptanceState.TotalPreviouslyAcceptedQty = gPrevAcc;
        acceptanceState.TotalAvailableQty = gAvail;
        acceptanceState.TotalQtyThisAcceptance = gQtyThis;
        acceptanceState.TotalAcceptedQty = gTotAcc;
        acceptanceState.TotalRemainingQty = gRem;

        // Auto-determination of Complete vs Partial Acceptance
        var isComplete = (acceptanceState.Items.length > 0) && allItemsComplete;
        var isPartial = !isComplete && hasAnyAcceptance;

        acceptanceState.IsComplete = isComplete;
        acceptanceState.IsPartial = isPartial;

        var badgeContainer = $("#acceptanceStatusBadgeContainer");
        var statusPill = $("#summaryStatusPill");
        var statusText = $("#summaryStatusText");

        if (isComplete) {
            badgeContainer.html("<span class='badge bg-success fs-6'><span class='k-icon k-i-check-circle'></span> Complete Acceptance</span>");
            statusPill.removeClass("bg-secondary bg-warning text-dark").addClass("bg-success").text("Complete Acceptance");
            statusText.html("<strong class='text-success'><span class='k-icon k-i-check'></span> All Purchase Order items and required components are fully accepted.</strong> This transaction completes the Purchase Order.");
        } else if (isPartial) {
            badgeContainer.html("<span class='badge bg-warning text-dark fs-6'><span class='k-icon k-i-clock'></span> Partial Acceptance</span>");
            statusPill.removeClass("bg-secondary bg-success").addClass("bg-warning text-dark").text("Partial Acceptance");
            statusText.html("<strong class='text-warning text-dark'><span class='k-icon k-i-info'></span> Partial delivery accepted.</strong> Additional uninspected or pending quantities remain for this Purchase Order.");
        } else {
            badgeContainer.html("<span class='badge bg-secondary fs-6'>Pending Acceptance</span>");
            statusPill.removeClass("bg-success bg-warning text-dark").addClass("bg-secondary").text("Pending Acceptance");
            statusText.html("<span class='text-muted'>No quantities accepted in this transaction yet. Specify accepted quantities above.</span>");
        }
    }


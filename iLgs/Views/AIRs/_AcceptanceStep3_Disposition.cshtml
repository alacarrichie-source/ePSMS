@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="wizard-card">

    <div class="wizard-card-header">
        <div>
            <h2>Step 3: Item Disposition Allocation</h2>
            <p class="subtitle">
                Assign post-acceptance destination for each accepted item. Items can be booked into <strong>Inventory</strong> (stock card/property card control) or designated <strong>For Distribution</strong> (direct issuance to end-users).
            </p>
        </div>
    </div>

    <!-- Informational Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary text-white">Inventory</span>
                    <strong class="text-dark small">Warehouse &amp; Property Control</strong>
                </div>
                <p class="small text-muted mb-0">
                    Items are recorded under official stock cards / property cards before future issuance. Suitable for centralized supplies, bulk stock, or equipment held in storage.
                </p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-success text-white">For Distribution</span>
                    <strong class="text-dark small">Direct End-User Issuance</strong>
                </div>
                <p class="small text-muted mb-0">
                    Items are intended for immediate distribution to identified departments, custodians, or project sites upon acceptance. Handoff creates direct RIS/ICS/PAR records.
                </p>
            </div>
        </div>
    </div>

    <!-- Disposition Table -->
    <div class="form-card mb-4 p-4 bg-white rounded border">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fs-6 fw-bold mb-0 text-primary"><span class="k-icon k-i-redo"></span> Item-Level Post-Acceptance Disposition</h4>
                <p class="small text-muted mb-0">Configure each item's downstream destination.</p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="setAllDispositions('Inventory')">
                    Set All to Inventory
                </button>
                <button type="button" class="btn btn-sm btn-outline-success" onclick="setAllDispositions('ForDistribution')">
                    Set All For Distribution
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" id="tblDispositions">
                <thead class="table-light small">
                    <tr>
                        <th style="width:70px;">Item No.</th>
                        <th>Description</th>
                        <th style="width:110px;" class="text-end">Accepted Qty</th>
                        <th style="width:180px;">Disposition</th>
                        <th style="width:220px;">Target Department</th>
                        <th style="width:200px;">Designated Custodian / Recipient</th>
                    </tr>
                </thead>
                <tbody class="small" id="dispItemsBody">
                    <!-- Populated via script -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Step Actions -->
    <div class="wizard-summary-bar mt-4">
        <button type="button" class="btn-procurement-secondary" onclick="goToAcceptanceStep(2)">
            <span class="k-icon k-i-arrow-left"></span> Back to Acceptance Details
        </button>
        <button type="button" class="btn-procurement-primary" onclick="goToAcceptanceStep(4)">
            Proceed to Review &amp; Post <span class="k-icon k-i-arrow-right"></span>
        </button>
    </div>

</div>

<script type="text/javascript">
    function renderStep3Dispositions() {
        var tbody = $("#dispItemsBody");
        tbody.empty();

        if (!acceptanceState.Items || acceptanceState.Items.length === 0) {
            tbody.html('<tr><td colspan="6" class="p-4 text-center text-muted">No items available for disposition.</td></tr>');
            return;
        }

        acceptanceState.Items.forEach(function (item, idx) {
            var disp = item.Disposition || "Inventory";
            var isDist = disp === "ForDistribution";

            var tr = "<tr>" +
                     "  <td class='fw-bold'>" + (item.ItemNo || (idx + 1)) + "</td>" +
                     "  <td>" + (item.Description || "Item") + "</td>" +
                     "  <td class='text-end font-monospace fw-bold text-success'>" + Number(item.AcceptedQty != null ? item.AcceptedQty : item.InspectedQty).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "</td>" +
                     "  <td>" +
                     "    <select class='form-control-custom w-100 form-control-sm' id='ddlDisp_" + idx + "' onchange='onDispositionChange(" + idx + ", this.value)'>" +
                     "      <option value='Inventory' " + (disp === 'Inventory' ? 'selected' : '') + ">Inventory (Stock Card)</option>" +
                     "      <option value='ForDistribution' " + (disp === 'ForDistribution' ? 'selected' : '') + ">For Distribution</option>" +
                     "    </select>" +
                     "  </td>" +
                     "  <td>" +
                     "    <input type='text' class='form-control-custom w-100 form-control-sm' id='txtTargetDept_" + idx + "' value='" + (item.DestinationDepartment || acceptanceState.Department || "") + "' placeholder='Target Department / Office...' onchange='onTargetDeptChange(" + idx + ", this.value)' />" +
                     "  </td>" +
                     "  <td>" +
                     "    <input type='text' class='form-control-custom w-100 form-control-sm' id='txtTargetCust_" + idx + "' value='" + (item.DestinationCustodian || "") + "' placeholder='Recipient name...' onchange='onTargetCustChange(" + idx + ", this.value)' />" +
                     "  </td>" +
                     "</tr>";
            tbody.append(tr);
        });
    }

    function onDispositionChange(idx, val) {
        if (acceptanceState.Items[idx]) {
            acceptanceState.Items[idx].Disposition = val;
        }
    }

    function onTargetDeptChange(idx, val) {
        if (acceptanceState.Items[idx]) {
            acceptanceState.Items[idx].DestinationDepartment = val;
        }
    }

    function onTargetCustChange(idx, val) {
        if (acceptanceState.Items[idx]) {
            acceptanceState.Items[idx].DestinationCustodian = val;
        }
    }

    function setAllDispositions(val) {
        if (!acceptanceState.Items) return;
        acceptanceState.Items.forEach(function (item, idx) {
            item.Disposition = val;
            $("#ddlDisp_" + idx).val(val);
        });
    }
</script>

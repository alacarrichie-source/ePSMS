@model iLgs.Ai.Models.AIRAcceptanceWizardViewModel
@using Kendo.Mvc.UI
@using iLgs.Ai.Models

<div class="wizard-card">

    <div class="wizard-card-header">
        <div>
            <h2>Step 1: Review Physical Inspection Records</h2>
            <p class="subtitle">
                Review verified quantities delivered by the supplier as submitted by the Inspection Officer. Inspection quantities are read-only and cannot be altered by the Acceptance Team.
            </p>
        </div>
    </div>

    <!-- Header Information Review -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <span class="small text-muted fw-bold d-block mb-1">Purchase Order &amp; Supplier</span>
                <div class="fs-6 fw-bold text-primary">@Model.PONumber</div>
                <div class="small text-dark">Supplier: <strong>@Model.SupplierName</strong></div>
                <div class="small text-muted">Department: @Model.Department</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-light rounded border h-100">
                <span class="small text-muted fw-bold d-block mb-1">Inspection Officer &amp; Invoices</span>
                <div class="fs-6 fw-bold">Inspector: @(string.IsNullOrWhiteSpace(Model.InspectorName) ? "GSO Inspection Team" : Model.InspectorName)</div>
                <div class="small text-dark">Inspection Date: <strong>@(Model.InspectionDate.HasValue ? Model.InspectionDate.Value.ToString("MMM dd, yyyy") : "--")</strong></div>
                                <div class="small text-muted">
                    @if (Model.Invoices != null && Model.Invoices.Any())
                    {
                        <span>Invoices: <strong>@Model.Invoices.Count</strong> (Combined: <strong class="font-monospace text-primary">PHP @Model.Invoices.Sum(inv => inv.InvoiceTotalAmount).ToString("N2")</strong>)</span>
                    }
                    else
                    {
                        <span>Invoice No: @(Model.InvoiceNo ?? "N/A")</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Inspected Items Table (Read-Only) -->
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th style="width: 80px;">Item No.</th>
                    <th>Description</th>
                    <th style="width: 80px;">Unit</th>
                    <th style="width: 110px;" class="text-end">Ordered Qty</th>
                    <th style="width: 140px;" class="text-end text-primary fw-bold">Physically Inspected</th>
                    <th>Inspector Remarks</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="p-4 text-center text-muted">No items found for this inspection.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold">@item.ItemNo</td>
                            <td>@item.Description</td>
                            <td class="text-muted">@item.Unit</td>
                            <td class="text-end font-monospace">@item.OrderedQty.ToString("n2")</td>
                            <td class="text-end font-monospace fw-bold text-primary fs-6">@item.InspectedQty.ToString("n2")</td>
                            <td class="text-muted">@(string.IsNullOrWhiteSpace(item.Remarks) ? "--" : item.Remarks)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Invoices Table (Read-Only) -->
    @if (Model.Invoices != null && Model.Invoices.Any())
    {
        <div class="mb-4">
            <h4 class="fs-6 fw-bold text-dark mb-2"><span class="k-icon k-i-file-txt"></span> Recorded Sales Invoices</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th>Sales Invoice No.</th>
                            <th style="width: 140px;">Invoice Date</th>
                            <th style="width: 170px;" class="text-end">Total Amount (PHP)</th>
                            <th>Supporting Document</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @{
                            int invIdx = 1;
                            foreach (var inv in Model.Invoices)
                            {
                                <tr>
                                    <td class="text-center text-muted">@invIdx</td>
                                    <td class="fw-bold text-primary font-monospace">@inv.SalesInvoiceNo</td>
                                    <td>@(inv.InvoiceDate.HasValue ? inv.InvoiceDate.Value.ToString("MMM dd, yyyy") : "--")</td>
                                    <td class="text-end font-monospace fw-bold">@inv.InvoiceTotalAmount.ToString("N2")</td>
                                    <td>
                                        @if (inv.SupportingDocument != null && !string.IsNullOrEmpty(inv.SupportingDocument.FileName))
                                        {
                                            <a href="@Url.Content(inv.SupportingDocument.FilePath)" target="_blank" class="text-decoration-none">
                                                <span class="k-icon k-i-file-pdf text-danger"></span> @inv.SupportingDocument.FileName
                                                <span class="text-muted font-monospace">(@inv.SupportingDocument.FileSize)</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-italic">No document</span>
                                        }
                                    </td>
                                </tr>
                                invIdx++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Actions -->
    <div class="wizard-summary-bar mt-4">
        <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index", "AIRs"))" class="btn-procurement-secondary">
            <span class="k-icon k-i-arrow-left"></span> Back to Index
        </a>
        <button type="button" class="btn-procurement-primary" onclick="goToAcceptanceStep(2)">
            Proceed to Acceptance Details <span class="k-icon k-i-arrow-right"></span>
        </button>
    </div>

</div>


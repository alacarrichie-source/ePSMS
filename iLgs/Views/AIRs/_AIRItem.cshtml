
@(Html.Kendo().Grid<iLgs.Models.AIRItemVM>()
    .Name("gridItems_" + @ViewData["airId"])
    .Columns(col =>
    {
        col.Bound(c => c.ItemNo).Width(50);
        col.Bound(c => c.PsNo).Width(100);
        col.Bound(c => c.PsUnit).Width(50);
        col.Bound(c => c.PsItem).Width(100);
        col.Bound(c => c.Description).Width(100).ClientTemplate("<div style='padding-left: #= Padding #px;'>" +
                                                                       "<div>" +
                                                                           "# if (PsUnit == 'set' || PsUnit == 'lot') { #" +
                                                                               "<strong>#= kendo.htmlEncode(Description) #</strong>" +
                                                                           "# } else { #" +
                                                                               "#= kendo.htmlEncode(Description) #" +
                                                                           "# } #" +
                                                                       "</div>" +
                                                                       "<div>#= OtherDesc ? OtherDesc : '' #</div>" +
                                                                   "</div>");
        col.Bound(c => c.Qty).Width(50).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n0}")
            //.ClientFooterTemplate("#=kendo.format('{0:n0}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
            .HeaderHtmlAttributes(new { style = "text-align:right;" });
        col.Bound(c => c.InvDistDesc).Width(70);
        //col.Bound(c => c.SetLotNo).Width(50);
        if (ViewBag.AirGroup != 3) // serial
        {
            col.Command(command =>
            {
                //command.Edit().Visible("IsNotSet");
                //command.Destroy();
                command.Custom("Edit").IconClass("k-icon k-i-edit").SendDataKeys(true).Click("onClickBtnEditItem").Visible("IsNotSet");
                command.Custom("Delete").IconClass("k-icon k-i-close").Click("onClickDeleteGridItem").SendDataKeys(true).Visible("IsNotSetItem");
            }).Width(100);
        }
    })
    .ToolBar(toolbar =>
    {
        toolbar.Template(@<text>
        @(Html.Kendo().Button().Name("btnAddItem_" + ViewData["airId"]).Content("Add AIR Item").Icon("k-icon k-i-add").Events(e => e.Click("onClickBtnAddItem")))        
        </text>);
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    //.ClientDetailTemplateId((string)ViewData["TemplateId"])
    //.ClientDetailTemplateId("#= detailInit(data) #")
    .ClientDetailTemplateId("default-template")
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    //.Scrollable(s => s.Height(180))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AIRItemTemplate").Window(w => w.Width(800).Title("Acceptance and Inspection Item")))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridItemError").RequestEnd("onGridItemsRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        //.Aggregates(a =>
        //{
        //    a.Add(p => p.Qty).Sum();
        //})
        .Sort(s => s.Add(a => a.ItemNoIndex))
        .Read(read => read.Action("_AIRItemRead", "AIRs", new { airId = @ViewData["airId"] }))
        //.Create(create => create.Action("_AIRItemCreate", "AIRs"))
        //.Update(update => update.Action("_AIRItemUpdate", "AIRs"))
        .Destroy(destroy => destroy.Action("_AIRItemDestroy", "AIRs"))
    )
    .Events(events => events
        .Change("onChangeGridItems")
        .Edit("onEditGridItems")
        .DataBound("onDataBoundGridItems")
        .DetailExpand("onDetailExpand")
        .DetailCollapse("onDetailCollapse")
    )
    .AutoBind(true)
)
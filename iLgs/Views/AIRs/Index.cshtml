@{
    ViewBag.Title = "Acceptance & Inspection Report (AIR)";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@(Html.Kendo().Grid<iLgs.Models.AIR_VM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.CtrlNo).Width(50);
        col.Bound(c => c.Fund).Width(40);
        col.Bound(c => c.AIRNo).Width(50);
        col.Bound(c => c.AIRDate).Width(50);
        col.Bound(c => c.PoNo).Width(50);
        col.Bound(c => c.PoDate).Width(50);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.InvoiceNo).Width(50);
        col.Bound(c => c.InvoiceDate).Width(50);
        col.Bound(c => c.Custodian).Width(100);
        col.Bound(c => c.Officer).Width(100);
        col.Bound(c => c.PostedBy).Width(50);
        //if (ViewBag.AirGroup != 3) // serial
        //{
        //    col.Command(command =>
        //    {

        //        command.Custom("Edit").IconClass("k-icon k-i-edit").Click("onGridEditClick").SendDataKeys(true);
        //        command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
        //        command.Custom("Attachments").IconClass("k-icon k-i-upload").Click("onClickUploads").SendDataKeys(true);
        //        command.Custom("Print RIS").IconClass("k-icon k-i-print").Click("onGridPrintRisClick").SendDataKeys(true);
        //    }).Width(200);
        //}
        col.Command(command =>
        {

            command.Custom("Edit").IconClass("k-icon k-i-edit").Click("onGridEditClick").SendDataKeys(true);
            command.Custom("Delete").IconClass("k-icon k-i-close").Click("onGridDeleteClick").SendDataKeys(true);
            command.Custom("AIR").IconClass("k-icon k-i-upload").Click("onClickUploads").SendDataKeys(true);
            //command.Custom("Print RIS").IconClass("k-icon k-i-print").Click("onGridPrintRisClick").SendDataKeys(true);
        }).Width(120);
    })
    .ToolBar(t =>
    {
    //t.Create().Text("Add Record");
    @*@(Html.Kendo().Button().Name("btnAdd").Icon("k-icon k-i-add").Content("Issue Order")
        .Events(e => e.Click("onClickBtnAdd"))*@
        if (ViewBag.AirGroup != 2)
        {
            t.Custom().Text("Add Record").IconClass("k-icon k-i-add").Name("btnAddAir_").HtmlAttributes(new { @class = "k-button", href = "" });
        }

        t.Custom().Text("Print").IconClass("k-icon k-i-print").Name("btnPrint_").HtmlAttributes(new { @class = "k-button", href = "" });

        if (ViewBag.AirGroup == 2 || ViewBag.AirGroup == 4)
        {
            t.Custom().Text("Post").IconClass("k-icon k-i-lock").Name("btnPost_").HtmlAttributes(new { @class = "k-button", href = "" });
            t.Custom().Text("Unpost").IconClass("k-icon k-i-unlock").Name("btnUnpost_").HtmlAttributes(new { @class = "k-button", href = "" });
        }
        t.Search();
    })
    //.Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AIRTemplate").Window(w => w.Width(800).Title("Acceptance and Inspection")))
    .Search(s =>
    {
        s.Field(o => o.AIRNo, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.Department, "contains");
        //s.Field(o => o.InvoiceNo, "contains");
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .ClientDetailTemplateId("Details")
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.NewGuid()).Editable(true);
        })
        .Sort(s => s.Add(a => a.InsertedDt).Descending())
        .Read(read => read.Action("AIRRead", "AIRs", new { airGroup = ViewBag.AirGroup }))
        //.Create(create => create.Action("AIRCreate", "AIRs"))
        //.Update(update => update.Action("AIRUpdate", "AIRs"))
        .Destroy(destroy => destroy.Action("AIRDestroy", "AIRs"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        //.Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
)

<script id="Details" type="text/x-kendo-tmpl">
    @(Html.Kendo().TabStrip()
    .Name("tabStrip_#=Id#")
    //.HtmlAttributes(new { @class = "no-text-tabstrip" })
    .TabPosition(TabStripTabPosition.Top)

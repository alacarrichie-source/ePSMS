    function onRequestEndGridUpload(e) {
        if (e.response && !e.response.Errors) {
            if (e.type === "create" || e.type === "update" || e.type === "destroy") {
                var grid = $("#gridImages_").data("kendoGrid"); //e.sender.element ? e.sender.element.data("kendoGrid") : null;
                if (grid) {
                    setTimeout(function () {
                        grid.dataSource.read();
                    }, 200); // Small delay to ensure data is processed
                }
                else {
                    console.log("grid is null");
                }
            }
        }
    }


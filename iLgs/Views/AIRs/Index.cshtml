    {
        items.Add().Text("Items")
            .Selected(true)
            .LoadContentFrom("_AIRItem", "AIRs", new { airId = "#=Id#", airGroup = ViewBag.AirGroup });
        //items.Add().Text("Groups")
        //            .LoadContentFrom("_UnitGroup", "AIRs", new { orderId = "#=OrderId#", airGroup = ViewBag.AirGroup });
    }).ToClientTemplate())

</script>


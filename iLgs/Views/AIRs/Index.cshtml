<script type="text/javascript">
    function IsNotSet(dataItem)
    {
        return !(dataItem.PsUnit == "set" || dataItem.PsUnit == "lot");
    }

    function onSelectTabStrip(e) {
        var tabStrip = this;
        for (var idx = 0; ; ++idx) {
            var tab = tabStrip.contentElement(idx);
            if (tab == null)
                break;
            if (tab == e.contentElement) {
                //current tab logic - just let it go
            }
            else {
                //all other tabs
                $(tab).html("");
            }
        }
    }

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function error_handler(e, status) {
        if ((e.errors)) {
            var message = "Errors:\n";
            $.each(e.errors, function (key, value) {
                if ('errors' in value) {
                    $.each(value.errors, function () {
                        message += this + "\n";
                    });
                }
            });
            alert(message);
            //var selectedGrid = $("#gridInvoices").data("kendoGrid");
            //selectedGrid.cancelRow();
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
            }
        }
    }

    var selectedGrid = null;
    var selectedId = null;
    var selectedId_OrderId = null;
    var selectedItemId = null;
    var postedBy = null;
    var selectedAirNo = null;
    var selectedCtrlNo = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        selectedId = selectedData.Id;
        selectedId_OrderId = selectedData.OrderId;
        selectedItemId = null;

        postedBy = selectedData.PostedBy;
        selectedAirNo = selectedData.AIRNo;
        selectedCtrlNo = selectedData.CtrlNo

        if ('@ViewBag.AirGroup' == 2 || '@ViewBag.AirGroup' == 4) {
            if (postedBy) {
                $(".k-grid-btnUnpost_", grid).show();
                $(".k-grid-btnPost_", grid).hide();
            } else {
                $(".k-grid-btnUnpost_", grid).hide();
                $(".k-grid-btnPost_", grid).show();
            }
        }
    }

    function onDataBoundGrid(e) {
        if (selectedId) {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);

            //var firstRow = this.tbody.find("tr.k-master-row").first();
            //this.expandRow(firstRow);

            // Attach a handler to the "detailExpand" event
            this.bind("detailExpand", function (e) {
                // Select the expanded master row
                this.select(e.masterRow);
            });
        }

        var grid = this;
        if (this.dataSource.data().length == 0) {
            $(".k-grid-btnPrint_", grid).hide();
            if ('@ViewBag.AirGroup' == 2 || '@ViewBag.AirGroup' == 4) {
                $(".k-grid-btnPost_", grid).hide();
                $(".k-grid-btnUnpost_", grid).hide();
            }
        }
        else {
            $(".k-grid-btnPrint_", grid).show();
        }
    }

    function onEditGrid(e) {
        e.preventDefault();
        selectedGrid = e.sender;
        if (e.model.isNew()) {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
            selectedId = null;
        } else {
            selectedId = e.model.get("Id");
            var rowitem = selectedGrid.dataSource.get(selectedId);
            selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));

            // refresh PO Nos
            $("#OrderId").data("kendoMultiColumnComboBox").dataSource.read(DataOrderId());
        }
    }

    function onGridDeleteClick(e) {
        e.preventDefault();
        //selectedGrid = this;
        //selectedGrid = $(e.currentTarget).closest(".k-grid").data("kendoGrid");
        //const tr = $(e.currentTarget).closest("tr");
        //const dataItem = selectedGrid.dataItem(tr);
        //const rowitem = selectedGrid.dataSource.get(dataItem.Id);
        //selectedGrid.select($('[data-uid=' + rowitem.uid + ']'));
        //selectedId = selectedGrid.dataItem(selectedGrid.select()).Id;
        //setTimeout(selectedGrid.removeRow(tr), 500);
        // Get the grid instance explicitly
        const grid = $(e.currentTarget).closest(".k-grid").data("kendoGrid");
        selectedGrid = grid;

        const tr = $(e.currentTarget).closest("tr");
        const dataItem = grid.dataItem(tr);

        // Confirm deletion
        if (confirm(`Are you sure you want to delete this record?`)) {
            grid.select(tr);
            grid.dataSource.remove(dataItem); // Triggers the Destroy action
            grid.dataSource.sync(); // Send the delete request to the server
        }
    }

    function onGridPrintRisClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var dataItem = selectedGrid.dataItem($(e.currentTarget).closest("tr"));
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        var row = selectedGrid.tbody.find("tr[data-uid='" + rowitem.uid + "']");
        selectedGrid.select(row);
        selectedAirNo = selectedGrid.dataItem(selectedGrid.select()).AIRNo;
        selectedCtrlNo = selectedGrid.dataItem(selectedGrid.select()).CtrlNo;

        var url = '@Url.Action("RisByAirRpt", "AIRs")?ctrlNo=' + selectedCtrlNo;

        $("#windowcontainer").append("<div id='windowPrint'></div>");
        var mywindow = $("#windowPrint")
                .kendoWindow({
                    actions: ["Maximize", "Minimize", "Close"],
                    resizable: true,
                    draggable: true,
                    modal: true,
                    visible: false,
                    iframe: true,
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: "Preview",
            width: 1200,
            height: 700
        });
        mywindow.refresh({
            url: url
        });
        mywindow.center();
        mywindow.open();
    }

    $(".k-grid-btnAddAir_").click(function (e) {
        e.preventDefault();
        Entry("A", null);
    });

    function onGridEditClick(e) {
        e.preventDefault();
        selectedGrid = this;
        var dataItem = selectedGrid.dataItem($(e.currentTarget).closest("tr"));
        var rowitem = selectedGrid.dataSource.get(dataItem.Id);
        var row = selectedGrid.tbody.find("tr[data-uid='" + rowitem.uid + "']");
        selectedGrid.select(row);
        selectedId = selectedGrid.dataItem(selectedGrid.select()).Id;
        Entry("E", selectedId);
    }

    function Entry(mode, airId) {
        var myTitle = (mode == "A") ? "Acceptance & Inspection - ADD" : "Acceptance & Inspection - EDIT";
        var width = "1000";
        $("#windowcontainer").append("<div id='window'></div>");
        var mywindow = $("#window")
                .kendoWindow({
                    actions: ["Minimize", "Close"],
                    draggable: true,
                    modal: true,
                    visible: false,
                    close: function () {
                        $("#grid").data("kendoGrid").dataSource.read();
                        if (selectedId) {

                            var grid = $("#grid").data("kendoGrid");

                            // Trigger a read operation on the data source.
                            grid.dataSource.read().then(function () {
                                // Additional actions to be performed after the read operation.

                                // Find the row with the specified Id.
                                var dataItem = grid.dataSource.get(selectedId);

                                // If the row is found, expand it.
                                if (dataItem) {
                                    var row = grid.tbody.find("tr[data-uid='" + dataItem.uid + "']");
                                    grid.expandRow(row);
                                }
                            });
                        }
                    },
                    deactivate: function () {
                        this.destroy();
                    }
                }).data("kendoWindow");
        mywindow.setOptions({
            title: myTitle,
            width: width
        });

        mywindow.refresh({
            url: '@Url.Action("_AIRAddEdit", "AIRs")',
            data: {
                airId: airId,
                airGroup: '@ViewBag.AirGroup'
            },
            // Specify a callback function to execute after content is loaded
            complete: function () {
                // Resize the window to fit its content
                mywindow.resize();
                mywindow.center();
            }
        });
        mywindow.open();
    }

    // Grid Item
    function GridItemError(args) {
        if (args.errors) {
            var validationError = true;
            var selectedGrid = $("#gridItems_" + selectedId).data("kendoGrid");
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onDetailCollapse(e) {
        // Find the corresponding row in the main grid and select it
        var mainGridRow = $(e.sender.wrapper).closest("tr").prev();
        var mainGrid = mainGridRow.closest("[data-role=grid]").data("kendoGrid");
        mainGrid.select(mainGridRow);

        var grid = e.sender; // Get the grid instance dynamically
        var row = $(e.masterRow);
        grid.select(row);
    }


    function onDetailExpand(e) {
        // Find the corresponding row in the main grid and select it
        var mainGridRow = $(e.sender.wrapper).closest("tr").prev();
        var mainGrid = mainGridRow.closest("[data-role=grid]").data("kendoGrid");
        mainGrid.select(mainGridRow);

        // Find the current row in the grid and select it
        var grid = e.sender;
        var row = $(e.masterRow);
        grid.select(row);


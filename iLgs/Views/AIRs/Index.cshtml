@{
    ViewBag.Title = "Acceptance & Inspection";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.AIR_VM>()
    .Name("grid")
    .Columns(col =>
    {
        col.Bound(c => c.AIRNo).Width(100);
        col.Bound(c => c.AIRDate).Width(100);
        col.Bound(c => c.PoNo).Width(100);
        col.Bound(c => c.PoDate).Width(100);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.InvoiceNo).Width(100);
        col.Bound(c => c.InvoiceDate).Width(100);        
        col.Command(command =>
        {
            command.Edit();
            command.Destroy();
        }).Width(120);
    })
    .ToolBar(t =>
    {
        t.Create().Text("Add Record");
        t.Search();
    })
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AIRTemplate").Window(w => w.Width(800).Title("Acceptance and Inspection")))
    .Search(s =>
    {
        s.Field(o => o.AIRNo, "contains");
        s.Field(o => o.PoNo, "contains");
        s.Field(o => o.Department, "contains");
        s.Field(o => o.InvoiceNo, "contains");        
    })
    .Pageable(pager => pager
        .Input(false)
        .Numeric(true)
        .Info(true)
        .PreviousNext(true)
        .Refresh(true)
        .PageSizes(true)
        .ButtonCount(5)
    )
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(200))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("AIRRead", "AIRs"))
        .Create(create => create.Action("AIRCreate", "AIRs"))
        .Update(update => update.Action("AIRUpdate", "AIRs"))
        .Destroy(destroy => destroy.Action("AIRDestroy", "AIRs"))
    )
    .Events(events => events
        .Change("onChangeGrid")
        .Edit("onEditGrid")
        .DataBound("onDataBoundGrid")
        )
    )
</div>

<div class="col-md-12">
    @(Html.Kendo().Grid<iLgs.Models.AIRItemVM>()
        .Name("gridItems")
        .Columns(col =>
        {
            col.Bound(c => c.PsNo).Width(70);
            col.Bound(c => c.PsUnit).Width(50);
            col.Bound(c => c.PsItem).Width(150);
            col.Bound(c => c.OrderDescription).Width(150);
            col.Bound(c => c.Qty).Width(70).HtmlAttributes(new { style = "text-align:right;" }).Format("{0:n2}")
                .ClientFooterTemplate("#=kendo.format('{0:n2}', sum)#").FooterHtmlAttributes(new { Style = "text-align:right;" })
                .HeaderHtmlAttributes(new { style = "text-align:right;" });            
            col.Command(command =>
            {
                command.Edit();
                command.Destroy();
            }).Width(172);
        })
        .ToolBar(t =>
        {
            t.Create().Text("Add Item");
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Scrollable(s => s.Height(180))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Sortable()
        .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_AIRItemTemplate").Window(w => w.Width(500).Title("Acceptance and Inspection Item")))
        .DataSource(dataSource => dataSource
            .Ajax()
            .Events(events => events.Error("GridError").RequestEnd("onGridItemsRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })
            .Aggregates(a =>
            {
                a.Add(p => p.Qty).Sum();                
            })
            .Sort(s =>
            {
                s.Add(a => a.InsertedDt);
            })
            .Read(read => read.Action("_AIRItemRead", "AIRs").Data("ItemData"))
            .Create(create => create.Action("_AIRItemCreate", "AIRs"))
            .Update(update => update.Action("_AIRItemUpdate", "AIRs"))
            .Destroy(destroy => destroy.Action("_AIRItemDestroy", "AIRs"))
        )
        .Events(events => events
            .Change("onChangeGridItems")
            .Edit("onEditGridItems")
            .DataBound("onDataBoundGridItems")
        )
        .AutoBind(true)
    )
</div>

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    .card-body {
        flex: 1 1 auto;
        padding: 1rem 1rem;
        min-height: 100px;
    }

    .card-header {
        padding: 0.5rem 1rem;
        margin-bottom: 0;
        background-color: rgba(0,0,0,.03);
        border-bottom: 1px solid rgba(0,0,0,.125);
    }

    /*.k-black body,
    .k-black .card,
    .k-black .card-header,
    .k-black .buttons-wrap {
        border-color: #444;

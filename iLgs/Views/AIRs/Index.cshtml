@*Index.cshtml*@
@using Kendo.Mvc.UI
@using iLgs.Ai.Models

@{
    ViewBag.Title = "Acceptance & Inspection Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var resumeDraftUrl = Url.Action("Wizard", "AIRs");
    var acceptanceWizardUrl = Url.Action("AcceptanceWizard", "AIRs");
    var printUrl = Url.Action("AIRRpt", "AIRs");
}

<div class="epsms-procurement po-wizard">
    @Html.AntiForgeryToken()

    <!-- Breadcrumbs -->
    <div class="breadcrumbs">
        <a href="@Url.Action("Index", "Home")">Home</a> &gt;
        <a href="@Url.Action("Index", "Procurement")">Procurement</a> &gt;
        <span>Acceptance &amp; Inspection Reports (AIR)</span>
    </div>

    <!-- Header Bar -->
    <div class="header-bar">
        <div>
            <h1>Acceptance &amp; Inspection Reports</h1>
            <p class="subtitle">LGU property and supply physical inspection verification, official acceptance, and GAM Appendix 62 generation.</p>
        </div>
        <div class="action-toolbar">
            <a href="@Url.Action("Wizard", "AIRs")" class="k-button k-button-solid-primary k-rounded-md">
                <span class="k-icon k-i-check-outline"></span> Inspect Orders
            </a>
        </div>
    </div>

    <!-- My Drafts Card -->
    <section class="wizard-drafts-card" aria-labelledby="wizardDraftsHeading">
        <div class="wizard-drafts-header">
            <div>
                <h2 id="wizardDraftsHeading">My Inspection Drafts</h2>
                <p>Continue an unfinished inspection wizard from where you stopped.</p>
            </div>
            <span class="k-icon k-i-save wizard-drafts-icon" aria-hidden="true"></span>
        </div>

        @(Html.Kendo().Grid<AIRWizardDraftListItemViewModel>()
            .Name("MyAIRDraftsGrid")
            .Columns(columns =>
            {
                columns.Bound(d => d.DraftNo).Title("Draft No.").Width(140);
                columns.Bound(d => d.PONumber).Title("PO Reference").Width(150);
                columns.Bound(d => d.SupplierName).Title("Supplier");
                columns.Bound(d => d.CurrentStep).Title("Progress").Width(160)
                    .ClientTemplate(
                        "<span class='wizard-draft-step'>Step #=CurrentStep# of 4</span>" +
                        "<span class='wizard-draft-step-name'>#=airDraftStepName(CurrentStep)#</span>");
                columns.Bound(d => d.LastUpdatedAt).Title("Last Saved")
                    .Format("{0:MMM dd, yyyy h:mm tt}").Width(180);
                columns.Bound(d => d.Id).Title("Actions").Width(180)
                    .Sortable(false).Filterable(false)
                    .ClientTemplate(
                        "<div class='wizard-draft-actions'>" +
                            "<a class='btn-procurement-primary' href='" + resumeDraftUrl + "?id=#=Id#'>" +
                                "<span class='k-icon k-i-arrow-right'></span> Resume" +
                            "</a>" +
                            "<button type='button' class='btn-procurement-secondary' onclick=\"discardAirDraft('#=Id#')\">Discard</button>" +
                        "</div>");
            })
            .NoRecords(n => n.Template("<div class='p-3 text-muted text-center'>No active inspection drafts. Click <strong>Inspect Orders</strong> to begin.</div>"))
            .Sortable()
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(5)
                .Read(read => read.Action("MyDrafts_Read", "AIRs"))
                .Sort(sort => sort.Add(d => d.LastUpdatedAt).Descending())
            )
        )
    </section>

    <!-- Filter Panel -->
    <div class="filter-panel">
        <div class="filter-row">
            <div class="search">
                <label for="searchAIR">Search Inspection Transactions</label>
                <input id="searchAIR" type="text" class="form-control-custom" placeholder="Search by AIR No, PO Number, Supplier name, Invoice..." onkeyup="onSearchFilter(this.value)" />
            </div>
            <div>
                <label for="statusFilter">Workflow Status</label>
                <select id="statusFilter" class="form-control-custom" onchange="onStatusFilter(this.value)">
                    <option value="All">All Transactions</option>
                    <option value="Draft">Draft</option>
                    <option value="Submitted for Acceptance">Submitted for Acceptance</option>
                    <option value="Acceptance In Progress">Acceptance In Progress</option>
                    <option value="Returned for Revision">Returned for Revision</option>
                    <option value="Accepted">Accepted</option>
                    <option value="Posted">Posted</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Data Card: Kendo Grid -->
    <div class="data-card">
        @(Html.Kendo().Grid<AIRGridItemViewModel>()
            .Name("AIRsGrid")
            .Columns(columns =>
            {
                columns.Bound(p => p.AirNo).Title("AIR No.").Width(140).ClientTemplate(
                    "<a href='javascript:void(0);' class='fw-bold text-primary' onclick='openAirDetails(\"#=Id#\")'>#=AirNo#</a>"
                );
                columns.Bound(p => p.AirDate).Title("AIR Date").Format("{0:MMM dd, yyyy}").Width(120);
                columns.Bound(p => p.PONumber).Title("PO No.").Width(140);
                columns.Bound(p => p.SupplierName).Title("Supplier").Width(200);
                columns.Bound(p => p.Department).Title("Department").Width(180);
                columns.Bound(p => p.InvoiceNo).Title("Invoice / DR").Width(140);
                columns.Bound(p => p.TotalInspectedQty).Title("Inspected Qty").Format("{0:n2}").Width(130)
                    .HtmlAttributes(new { style = "text-align:right;", @class = "numeric-cell font-weight-bold" })
                    .HeaderHtmlAttributes(new { style = "text-align:right;", @class = "numeric-header" });
                columns.Bound(p => p.OverallStatus).Title("Status").Width(170).ClientTemplate(
                    "# if (OverallStatus == 'Posted') { #" +
                        "<span class='status-badge status-posted'><span class='k-icon k-i-check'></span> Posted</span>" +
                    "# } else if (OverallStatus == 'Submitted for Acceptance') { #" +
                        "<span class='status-badge status-submitted'><span class='k-icon k-i-clock'></span> Submitted</span>" +
                    "# } else if (OverallStatus == 'Acceptance In Progress') { #" +
                        "<span class='status-badge status-submitted' style='background:\\#eff6ff;color:\\#1d4ed8;'><span class='k-icon k-i-gears'></span> Acceptance In Progress</span>" +
                    "# } else if (OverallStatus == 'Returned for Revision') { #" +
                        "<span class='status-badge status-returned'><span class='k-icon k-i-warning'></span> Returned</span>" +
                    "# } else if (OverallStatus == 'Accepted') { #" +
                        "<span class='status-badge status-posted' style='background:\\#f0fdf4;color:\\#166534;'><span class='k-icon k-i-check-circle'></span> Accepted</span>" +
                    "# } else if (OverallStatus == 'Draft') { #" +
                        "<span class='status-badge status-draft'><span class='k-icon k-i-edit'></span> Draft</span>" +
                    "# } else { #" +
                        "<span class='status-badge'>#=OverallStatus#</span>" +
                    "# } #"
                );
                // ACTIONS
                columns.Bound(p => p.Id)
                    .Title("Actions")
                    .Width(220)
                    .Sortable(false)
                    .Filterable(false)
                    .ClientTemplate(
                        "<div class='grid-action-buttons'>" +
                            "# if (CanContinue) { #" +
                                "<a class='btn-procurement-primary btn-sm' href='" + resumeDraftUrl + "?id=#=Id#' title='Continue Inspection'><span class='k-icon k-i-edit'></span> Continue</a>" +
                            "# } #" +
                            "# if (CanWithdraw) { #" +
                                "<button type='button' class='btn-procurement-secondary btn-sm' onclick='openWithdrawModal(\"#=Id#\", false)' title='Withdraw Submission'><span class='k-icon k-i-undo'></span> Withdraw</button>" +
                            "# } #" +
                            "# if (CanRequestWithdrawal) { #" +
                                "<button type='button' class='btn-procurement-secondary btn-sm' onclick='openWithdrawModal(\"#=Id#\", true)' title='Request Withdrawal from Acceptance'><span class='k-icon k-i-undo'></span> Req. Recall</button>" +
                            "# } #" +
                            "# if (CanRevise) { #" +
                                "<a class='btn-procurement-primary btn-sm' href='" + resumeDraftUrl + "?id=#=Id#' title='Revise Inspection'><span class='k-icon k-i-refresh'></span> Revise AIR</a>" +
                            "# } #" +
                            "# if (CanStartAcceptance) { #" +
                                "<button type='button' class='btn-procurement-primary btn-sm' onclick='startAcceptance(\"#=Id#\")' title='Start Official Acceptance'><span class='k-icon k-i-play'></span> Start Acceptance</button>" +
                            "# } #" +
                            "# if (CanContinueAcceptance) { #" +
                                "<a class='btn-procurement-primary btn-sm' href='" + acceptanceWizardUrl + "?id=#=Id#' title='Open Acceptance Wizard'><span class='k-icon k-i-check-circle'></span> Accept</a>" +
                            "# } #" +
                            "# if (CanPost) { #" +
                                "<a class='btn-procurement-primary btn-sm' href='" + acceptanceWizardUrl + "?id=#=Id#' title='Post Acceptance'><span class='k-icon k-i-check-circle'></span> Post</a>" +
                            "# } #" +
                            "# if (CanPrint) { #" +
                                "<a class='btn-procurement-secondary btn-sm' href='" + printUrl + "?ctrlNo=#=CtrlNo#' target='_blank' title='Print AIR Report'><span class='k-icon k-i-print'></span> Print</a>" +
                            "# } #" +
                            "<button type='button' class='btn-procurement-secondary btn-sm' onclick='openAirDetails(\"#=Id#\")' title='View Details'><span class='k-icon k-i-eye'></span></button>" +
                        "</div>"
                    );
            })
            .Pageable(pager => pager
                .Refresh(true)
                .PageSizes(new[] { 10, 20, 50 })
                .ButtonCount(5)
            )
            .Sortable()
            .Filterable()
            .NoRecords(n => n.Template("<div class='p-4 text-center text-muted'>No Acceptance and Inspection Reports found matching criteria.</div>"))
            .DataSource(dataSource => dataSource
                .Ajax()
                .PageSize(10)
                .Read(read => read.Action("AIRs_Read", "AIRs").Data("getGridFilterData"))
                .Sort(sort => sort.Add(p => p.AirDate).Descending())
            )
        )
    </div>
</div>

<!-- WITHDRAW / REQUEST WITHDRAWAL MODAL -->
@(Html.Kendo().Window()
    .Name("withdrawActionWindow")
    .Title("AIR Submission Withdrawal")
    .Width(500)
    .Modal(true)
    .Visible(false)
    .Actions(actions => actions.Close())
    .Content(@<text>
        <div class="p-3">
            <p id="withdrawModalSubtitle" class="mb-3 text-muted">Provide a reason for recalling this inspection submission.</p>
            <input type="hidden" id="withdrawAirId" />
            <input type="hidden" id="withdrawIsRequest" />
            <div class="form-group mb-3">
                <label for="withdrawReason" class="font-weight-bold mb-1">Reason / Explanation <span class="text-danger">*</span></label>
                <textarea id="withdrawReason" class="form-control-custom w-100" rows="4" placeholder="Enter detailed reason..."></textarea>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn-procurement-secondary" onclick="$('#withdrawActionWindow').data('kendoWindow').close()">Cancel</button>
                <button type="button" id="btnConfirmWithdraw" class="btn-procurement-primary" onclick="submitWithdrawAction()">Confirm Recall</button>
            </div>
        </div>
    </text>)
)

@section scripts {
    <script type="text/javascript">
        function airDraftStepName(step) {
            switch (step) {
                case 1: return "Select Purchase Orders";
                case 2: return "Inspect Items";
                case 3: return "Invoice Entry";
                case 4: return "Review & Submit";
                default: return "In Progress";
            }
        }

        function getGridFilterData() {
            return {
                statusFilter: $("#statusFilter").val() || "All"
            };
        }

        function onStatusFilter() {
            $("#AIRsGrid").data("kendoGrid").dataSource.read();
        }

        function onSearchFilter(term) {
            var grid = $("#AIRsGrid").data("kendoGrid");
            if (!term) {
                grid.dataSource.filter({});
                return;
            }
            grid.dataSource.filter({
                logic: "or",
                filters: [
                    { field: "AirNo", operator: "contains", value: term },
                    { field: "PONumber", operator: "contains", value: term },
                    { field: "SupplierName", operator: "contains", value: term },
                    { field: "Department", operator: "contains", value: term },
                    { field: "InvoiceNo", operator: "contains", value: term }
                ]
            });
        }

        function discardAirDraft(id) {
            if (!confirm("Are you sure you want to discard this inspection draft?")) return;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.post('@Url.Action("DiscardDraft", "AIRs")', { __RequestVerificationToken: token, id: id }, function (res) {
                if (res.success) {
                    $("#MyAIRDraftsGrid").data("kendoGrid").dataSource.read();
                    $("#AIRsGrid").data("kendoGrid").dataSource.read();
                } else {
                    alert(res.message || "Unable to discard draft.");
                }
            });
        }

        function openWithdrawModal(airId, isRequest) {
            $("#withdrawAirId").val(airId);
            $("#withdrawIsRequest").val(isRequest ? "true" : "false");
            $("#withdrawReason").val("");
            var title = isRequest ? "Request Recall from Acceptance" : "Withdraw Inspection Submission";
            var subtitle = isRequest ? "Acceptance is currently in progress. Your request will be forwarded to the Acceptance Officer." : "This will cancel the submission and return the AIR to Draft status.";
            var win = $("#withdrawActionWindow").data("kendoWindow");
            win.title(title);
            $("#withdrawModalSubtitle").text(subtitle);
            win.center().open();
        }

        function submitWithdrawAction() {
            var airId = $("#withdrawAirId").val();
            var isRequest = $("#withdrawIsRequest").val() === "true";
            var reason = $("#withdrawReason").val();

            if (!reason || !reason.trim()) {
                alert("Please provide a reason.");
                return;
            }

            var url = isRequest ? '@Url.Action("RequestWithdrawal", "AIRs")' : '@Url.Action("WithdrawSubmission", "AIRs")';
            var token = $('input[name="__RequestVerificationToken"]').val();

            $("#btnConfirmWithdraw").prop("disabled", true).text("Processing...");

            $.ajax({
                url: url,
                type: "POST",
                data: {
                    __RequestVerificationToken: token,
                    AirId: airId,
                    Reason: reason
                },
                success: function (res) {
                    if (res.success) {
                        $("#withdrawActionWindow").data("kendoWindow").close();
                        $("#AIRsGrid").data("kendoGrid").dataSource.read();
                        $("#MyAIRDraftsGrid").data("kendoGrid").dataSource.read();
                        alert(res.message || "Action completed successfully.");
                    } else {
                        alert(res.message || "Failed to process withdrawal.");
                    }
                },
                error: function () {
                    alert("A network error occurred. Please try again.");
                },
                complete: function () {
                    $("#btnConfirmWithdraw").prop("disabled", false).text("Confirm Recall");
                }
            });
        }

        function startAcceptance(airId) {
            if (!confirm("Start official acceptance for this inspection report? Direct withdrawal will no longer be allowed.")) return;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '@Url.Action("StartAcceptance", "AIRs")',
                type: "POST",
                data: { __RequestVerificationToken: token, id: airId },
                success: function (res) {
                    if (res.success) {
                        window.location.href = '@Url.Action("AcceptanceWizard", "AIRs")?id=' + airId;
                    } else {
                        alert(res.message || "Unable to start acceptance.");
                    }
                },
                error: function () {
                    alert("A network error occurred. Please try again.");
                }
            });
        }

        function openAirDetails(airId) {
            window.location.href = '@Url.Action("Wizard", "AIRs")?id=' + airId;
        }
    </script>
}

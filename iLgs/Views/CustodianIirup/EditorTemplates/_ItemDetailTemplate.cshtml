                </div>
                <div class="col-md-9">
                    @(Html.Kendo().NumericTextBoxFor(m => m.Answer).Min(1).Max(4).Format("{0:n2}").Decimals(2).Spinners(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))

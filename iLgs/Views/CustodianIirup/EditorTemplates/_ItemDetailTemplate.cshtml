                </div>
                <div class="col-md-9">
                    @(Html.Kendo().TextBoxFor(m => m.CustodianReportItem.Account).Enable(false).HtmlAttributes(new { style = "width:100%; max-width:100%;" }))                    
                </div>
            </div>
        </div>

        <div class="row k-mb-2">
            <div class="col-md-12">

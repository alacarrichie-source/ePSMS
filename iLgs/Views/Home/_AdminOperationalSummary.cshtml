@model iLgs.Models.DashboardViewModel
@{
    var s = Model != null && Model.AdminDashboard != null ? Model.AdminDashboard.OperationalSummary : null;
    if (s == null) { s = new iLgs.Models.AdminOperationalSummaryVM(); }
}

<div class="dash-section-header">
    <h2 class="dash-section-title">
        <span class="k-icon k-i-chart-column-stacked section-title-icon"></span>
        <span>Operational Summary &amp; Volume</span>
    </h2>
</div>

<div class="admin-ops-grid">
    <!-- 1. Purchase Request -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-file-add card-title-icon"></span>
                <span>Purchase Requests</span>
            </h3>
            <a href="@Url.Action("Index", "Requests")" class="admin-op-link">Open PR &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Processing / Submitted:</span>
                <span class="admin-op-metric-val val-highlight">@s.PrSubmitted.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Returned for Revision:</span>
                <span class="admin-op-metric-val @(s.PrReturned > 0 ? "val-alert" : "")">@s.PrReturned.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Drafts in Preparation:</span>
                <span class="admin-op-metric-val">@s.PrDraft.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Approved &amp; Posted:</span>
                <span class="admin-op-metric-val val-success">@s.PrPosted.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- 2. Purchase Order -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-cart card-title-icon"></span>
                <span>Purchase Orders</span>
            </h3>
            <a href="@Url.Action("Index", "Orders")" class="admin-op-link">Open PO &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Active / Posted POs:</span>
                <span class="admin-op-metric-val val-highlight">@s.PoPosted.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Draft Orders:</span>
                <span class="admin-op-metric-val">@s.PoDraft.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Total Committed:</span>
                <span class="admin-op-metric-val val-currency">&#8369; @s.PoCommittedAmount.ToString("N2")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Total Volume:</span>
                <span class="admin-op-metric-val">@s.PoTotal.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- 3. AIR -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-check card-title-icon"></span>
                <span>Inspection &amp; AIR</span>
            </h3>
            <a href="@Url.Action("Index", "AIRs")" class="admin-op-link">Open AIR &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Awaiting Inspection:</span>
                <span class="admin-op-metric-val @(s.AirPendingInspection > 0 ? "val-alert" : "")">@s.AirPendingInspection.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Inspected &amp; Accepted:</span>
                <span class="admin-op-metric-val val-highlight">@s.AirInspected.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Total AIRs Logged:</span>
                <span class="admin-op-metric-val">@s.AirTotal.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- 4. RIS -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-note card-title-icon"></span>
                <span>Requisitions (RIS)</span>
            </h3>
            <a href="@Url.Action("Index", "RIS")" class="admin-op-link">Open RIS &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Pending Approval:</span>
                <span class="admin-op-metric-val @(s.RisPendingApproval > 0 ? "val-highlight" : "")">@s.RisPendingApproval.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Pending Issuance:</span>
                <span class="admin-op-metric-val">@s.RisPendingIssuance.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Completed / Posted:</span>
                <span class="admin-op-metric-val val-success">@s.RisPosted.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- 5. Cards -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-grid card-title-icon"></span>
                <span>Ledger Cards</span>
            </h3>
            <a href="@Url.Action("Index", "PropertyCard")" class="admin-op-link">Open Cards &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Property Cards (PPE):</span>
                <span class="admin-op-metric-val val-highlight">@s.PropertyCardCount.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Stock Cards (Supplies):</span>
                <span class="admin-op-metric-val">@s.StockCardCount.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Registry Health:</span>
                <span class="admin-op-metric-val val-success">Active</span>
            </div>
        </div>
    </div>

    <!-- 6. Accountability -->
    <div class="admin-op-card">
        <div class="admin-op-header">
            <h3 class="admin-op-title">
                <span class="k-icon k-i-folder card-title-icon"></span>
                <span>Accountability (PAR/ICS)</span>
            </h3>
            <a href="@Url.Action("Index", "ParSet")" class="admin-op-link">Manage &rarr;</a>
        </div>
        <div class="admin-op-metrics">
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">PAR Records:</span>
                <span class="admin-op-metric-val val-highlight">@s.ParCount.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">ICS Records:</span>
                <span class="admin-op-metric-val">@s.IcsCount.ToString("N0")</span>
            </div>
            <div class="admin-op-metric-row">
                <span class="admin-op-metric-label">Transfers Logged:</span>
                <span class="admin-op-metric-val"><a href="@Url.Action("Index", "PoTransfer")" class="admin-op-sublink">View Transfers</a></span>
            </div>
        </div>
    </div>
</div>

@using Kendo.Mvc.UI.Fluent
    @model IQueryable<iLgs.Models.Menubase>
    @{
        ViewBag.Title = "Home Page";
        Layout = "~/Views/Shared/_AppLayout.cshtml";
    }

        <div class="jumbotron">
            <div class="logo-container">
                <div class="logo-row">
                    <img src='@Url.Content("~/Assets/Logo.png")' alt="ePSMS logo" class="logo" />
                    <div class="text-block">
                        <div class="description">
                            eProperty and Supplies Management System<br />
                            Las Pinas City
                        </div>
                    </div>
                </div>
            </div>
        </div>


    <style>
        body {
            background-image: url('@Url.Content("~/Assets/city-hall.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .body-opaque {
            opacity: 0.85;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start; /* aligns logo and text to the left */
        }

        .logo {
            height: 300px; /* adjust as needed */
        }

        .text-block {
            margin-top: -180px; /* adjust as needed to reduce space between logo and text */
            padding-left: 300px; /* slight indent so it aligns under the "e" of the logo */
        }

        .description {
            font-family: Arial, sans-serif;
            font-size: 16px;
            line-height: 1.4;
        }
    </style>


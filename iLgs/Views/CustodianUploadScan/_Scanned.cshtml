@{
    var gridName = "gridScan";
}

@(Html.Kendo().Grid<iLgs.Models.Upload>()
    .Name("gridScan")
    .Columns(col =>
    {
        col.Bound(p => p.Description).Title("")
                .ClientTemplate(
                @"<div class='upload-photo'
                   style='background-image: url(" + @Url.Content("~/CustodianUploadScan/ScannedPreviewUpload?id=#:Id#") + ");'></div></div>")
                    .Width(30);
        col.Bound(p => p.Description).Width(100);
        col.Bound(p => p.FileName).Width(100);
        col.Command(command =>
        {
            if (ViewBag.IsAdmin == true)
            {
                command.Edit();
                command.Destroy();
            }
            command.Custom("Preview").IconClass("k-icon k-i-eye").Click("onClickPreviewScan");
            command.Custom("Download").IconClass("k-icon k-i-download").Click("onClickDownloadScan");
        }).Width(100);

    })
    .ToolBar(t =>
    {
        // custom upload not working 
    //t.Custom().Text("Upload").IconClass("k-icon k-i-upload").Name("btnUploadScan").HtmlAttributes(new { @class = "k-button", href = "", data_gridname = gridName, id = "btnUploadScan" });    
    //t.Search();
        t.Template(@<text>    
            @if (@ViewBag.IsAdmin == true) {
                @(Html.Kendo().Button().Name("btnUpload_" + @ViewData["deptCode"]).Content("Upload")
                        .HtmlAttributes(new { data_gridname = gridName })  // Add a data attribute
                        .Events(e => e.Click("onClickUploadScan"))
                )
            }
        </text>);
        //t.Search();
    })
    //.Search(s =>
    //{
    //    s.Field(o => o.Description, "contains");
    //    s.Field(o => o.FileName, "contains");
    //})
    .Editable(editable => editable.Mode(GridEditMode.PopUp).TemplateName("_ScannedTemplate").Window(w => w.Width(500).Title("Edit")))
    .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
    .Sortable(sortable => sortable
        .AllowUnsort(true)
        .SortMode(GridSortMode.MultipleColumn))
    .Filterable()
    .Scrollable(s => s.Height(400))
    .NoRecords()
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(20)
        .Events(events => events.Error("GridUploadScanError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(false);
        })
        .Read(read => read.Action("_ScannedRead", "CustodianUploadScan", new { deptCode = ViewData["deptCode"], accountGroup = ViewBag.AccountGroup }))
        .Update(update => update.Action("_ScannedUpdate", "CustodianUploadScan").Data("DataGridScan"))
        .Destroy(destroy => destroy.Action("_ScannedDestroy", "CustodianUploadScan").Data("DataGridScan"))
    )
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    .AutoBind(true)
    .Events(events => events.Edit("onEditGridScan")
    .DataBound("onDataBoundGridScan")
    )
)

<style>
    .upload-photo {
        display: inline-block;
        width: 70px;
        height: 70px;
        border-radius: 1%;
        background-size: 70px 70px;
        background-position: center center;
        vertical-align: middle;
        line-height: 80px;
        box-shadow: inset 0 0 1px #999, inset 0 0 10px rgba(0,0,0,.2);
        margin-left: 5px;
    }

    .file-name {
        display: inline-block;
        width: 150px;
        background-position: center center;
        vertical-align: middle;
        line-height: 32px;
        padding-left: 3px;
    }
</style>

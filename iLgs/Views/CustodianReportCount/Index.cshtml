@{
    ViewBag.Title = "Custodian Request for Count";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Reporting Year-end", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().NumericTextBox()
                .Name("forYear")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.CustodianReportSubmitForCountVM>()
        .HtmlAttributes(new { @class = "custom-max-grid" })
        .Name("grid")
        .Columns(col =>
        {
            col.Bound(c => c.Department).Width(70);
            col.Bound(c => c.LocationCode).Width(50);
            col.Bound(c => c.Location).Width(70);
            col.Bound(c => c.Status).Width(50);
            col.Bound(c => c.InsertedBy).Width(50);
            col.Bound(c => c.InsertedDt).Width(50);
            col.Bound(c => c.UpdatedBy).Width(50);
            col.Bound(c => c.UpdatedDt).Width(50);                        
        })
        .ToolBar(t =>
        {            
            t.Search();
        })
        .Search(s =>
        {
            s.Field(o => o.Department, "contains");
            s.Field(o => o.LocationCode, "contains");
            s.Field(o => o.Location, "contains");
            s.Field(o => o.Status, "contains");
            s.Field(o => o.InsertedBy, "contains");
            s.Field(o => o.UpdatedDt, "contains");            
        })
        .Pageable(pager => pager
            .Input(false)
            .Numeric(true)
            .Info(true)
            .PreviousNext(true)
            .Refresh(true)
            .PageSizes(true)
            .ButtonCount(5)
        )
        .Filterable()
        .NoRecords()
        .Resizable(r => r.Columns(true))
        .Selectable(s => s.Mode(GridSelectionMode.Single))
        .Scrollable()
        .Sortable()
        .DataSource(dataSource => dataSource
            .Ajax()
            .PageSize(20)
            .Events(events => events.Error("GridError").RequestEnd("onGridRequestEnd"))
            .Model(model =>
            {
                model.Id(p => p.Id);
                model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
            })            
            .Read(read => read.Action("Read", "CustodianReportCount").Data("DataGrid"))            
        )
        .Events(events => events
            .Change("onChangeGrid")
            //.Edit("onEditGrid")
            .DataBound("onDataBoundGrid")
            //.Save("onSaveGrid")
        )
        .AutoBind(true)
)


@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<div id="windowcontainer"></div>


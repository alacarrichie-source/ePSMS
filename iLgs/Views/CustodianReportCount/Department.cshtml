</style>


<script type="text/x-kendo-template" id="validationMessageTemplate">
    # if (messages.length) { #
    <li>
        #=field#
        <ul>
            # for (var i = 0; i < messages.length; ++i) { #
            <li>#= messages[i] #</li>
            # } #
        </ul>
    </li>
    # } #
</script>

<script type="text/javascript">
    var trackingId = null;

    function onShowNotification(e) {
        if (e.sender.getNotifications().length == 1) {
            e.element.parent().css({ zIndex: 22222 });
        }
    }

    function GridError(args) {
        if (args.errors) {
            var validationError = true;
            $.each(args.errors, function (propertyName) {
                if (propertyName == "DeleteError" || propertyName == "AddError" || propertyName == "UpdateError") {
                    alert(this.errors);
                    validationError = false;
                    selectedGrid.dataSource.read();
                }
            });
            if (validationError) {
                var validationTemplate = kendo.template($("#validationMessageTemplate").html());
                $('#ErrorContent').removeClass('hidden');
                selectedGrid.one("dataBinding", function (e) {
                    e.preventDefault();

                    var errors = selectedGrid.editable.element.find(".errors");
                    errors.empty();
                    $.each(args.errors, function (propertyName) {
                        var renderedTemplate = validationTemplate({ field: propertyName, messages: this.errors });
                        errors.append(renderedTemplate);
                    });
                });
            }
        }
    }

    function onChangeForYear(e) {
        reportId = null;
        selectedId = null;
        $("#grid").data("kendoGrid").dataSource.read();
    }

    function columnTemplate(data) {
        return '<div style="white-space: normal; word-wrap: break-word;">' + data + '</div>';
    }

    function DataGrid() {
        return {
            forYear: $("#forYear").val()
        };
    }

    var selectedGrid = null;
    var selectedId = null;

    function onChangeGrid(e) {
        var selectedData = this.dataItem(this.select());
        var grid = $("#grid");

        trackingId = selectedData.Id;
        selectedId = selectedData.Id;
    }

    var reportId = null;
    function onDataBoundGrid(e) {
        if (selectedId && selectedId != "00000000-0000-0000-0000-000000000000") {
            var dataItem = this.dataSource.get(selectedId);
            if (dataItem) {
                this.select($('[data-uid=' + dataItem.uid + ']'));
            }
        } else {
            var row = e.sender.tbody.find("tr:first");
            this.select(row);
        }


        if (this.dataSource.data().length == 0) {
            reportId = null;
        }
        else {
            var firstDataItem = this.dataSource.view()[0]; // the first item in the current view
            reportId = firstDataItem.ReportId;
        }

        var grid = this;
        var rows = grid.tbody.find("tr");

        // Make sure the grid has rows before proceeding
        if (rows.length === 0) return;

        // Get the index of the target column ("SomeField")
        var columnAccountIndex = grid.element.find("th[data-field='Department']").index();
        var columnSubAccount1Index = grid.element.find("th[data-field='Location']").index();

        rows.each(function (index, row) {
            // Get current and previous rows
            var currentRow = $(row);
            var previousRow = rows.eq(index - 1);

            // Check if the previous row exists
            if (previousRow.length) {
                // Get data from current and previous rows
                var currentDataItem = grid.dataItem(currentRow);
                var previousDataItem = grid.dataItem(previousRow);

                // Compare the values of the specific column (e.g., "SomeField")
                if (currentDataItem.Department === previousDataItem.Department) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnAccountIndex);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }

                if (currentDataItem.Department === previousDataItem.Department && currentDataItem.Location === previousDataItem.Location) {
                    // Find the specific column cell in the current row
                    var currentCell = currentRow.find("td").eq(columnSubAccount1Index);

                    // Apply opacity to the cell if the value matches the previous row
                    currentCell.css("opacity", "0.5"); // Adjust opacity as needed
                }
            }
        });
    }

    function onGridRequestEnd(e) {
        e.preventDefault();
        if (!e.response.Errors) {
            if (e.type == "destroy" || e.type == "create" || e.type == "update") {
                $("#grid").data("kendoGrid").dataSource.read();
            }
            if (e.type == "create") {
                var responseData = e.response;
                var newRecord = responseData.Data[0];
                selectedId = newRecord.Id;
                trackingId = selectedId;
            }
        }
    }

    function resizeWindow() {
        var mywindow = $("#window").data("kendoWindow");
        if (mywindow) {
            mywindow.setOptions({
                width: "1000",
                height: "auto"
            });
            mywindow.center(); // Optional: Center the window after resizing
        }
    }
</script>



@{
    ViewBag.Title = "Custodian Request for Count";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<br />
<div class="row k-mb-2">
    <div class="col-md-6">
        @Html.Label("Reporting Year-end", htmlAttributes: new { @class = "col-md-3" })
        <div class="col-md-9">
            @(Html.Kendo().NumericTextBox()
                .Name("forYear")
                .HtmlAttributes(new { style = "width:100%; max-width:100%;" })
                .Decimals(0)
                .Spinners(false)
                .Events(e => e.Change("onChangeForYear"))
                .Format("0")
                .Value(@ViewBag.ForYear)
            )
        </div>
    </div>
</div>

<br />

@(Html.Kendo().Grid<iLgs.Models.CustodianReportSubmitForCountDepartmentVM>()
    .Name("grid")
    .HtmlAttributes(new { @class = "custom-max-grid" })
    .Columns(col =>
    {
        col.Bound(c => c.Code).Width(50);
        col.Bound(c => c.Department).Width(100);
        col.Bound(c => c.Location).Width(100);
        col.Bound(c => c.Vehicle).Width(50);
        col.Bound(c => c.Equipment).Width(50);
        col.Bound(c => c.Supplies).Width(50);
    })
    .ToolBar(t =>
    {
        t.Search();
    })
    .Search(s =>
    {
        s.Field(o => o.Code, "contains");
        s.Field(o => o.Location, "contains");
        s.Field(o => o.Department, "contains");
    })
    .Filterable()
    .NoRecords()
    .Resizable(r => r.Columns(true))
    .Scrollable(s => s.Height(430))
    .Selectable(s => s.Mode(GridSelectionMode.Single))
    //.Sortable()
    .DataSource(dataSource => dataSource
        .Ajax()
        .Events(events => events.Error("GridError"))
        .Model(model =>
        {
            model.Id(p => p.Id);
            model.Field(p => p.Id).DefaultValue(Guid.Empty).Editable(true);
        })
        .Read(read => read.Action("DepartmentRead", "CustodianReportCount").Data("DataGrid"))
    )
.Events(events => events
    .DataBound("onDataBoundGrid")
    ).AutoBind(true)
)




@(Html.Kendo().Notification()
        .Name("popupNotification")
        .Events(e => e.Show("onShowNotification"))
)

<div id="windowcontainer"></div>

<style>
    .k-edit-form-container, .k-widget.k-window, .k-popup-edit-form.k-window-content.k-content {
        width: auto;
    }

    .k-window-content {
        overflow-x: hidden;
    }

    .k-grid .k-grid-search {
        display: flex;
        margin-left: auto;
        margin-right: 0;
    }

    .k-floating-label-container {
        width: 100%;
    }

    #span_ {
        display: flex;
        margin-left: auto;
        margin-right: 0;
        width: fit-content;
    }

    .no-text-tabstrip .k-item .k-link {
        padding: 0; /* Remove padding */
        text-indent: -9999px; /* Move the text outside the visible area */
        overflow: hidden; /* Hide any overflow */
    }

    .card-body {
        flex: 1 1 auto;
        padding: 1rem 1rem;
        /*min-height: 100px;*/
    }

    .card-header {
        padding: 0.5rem 1rem;
        margin-bottom: 0;
        background-color: rgba(0,0,0,.03);
        /*border-bottom: 1px solid rgba(0,0,0,.125);*/
        border-bottom: 1px solid black;
    }

    .card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        word-wrap: break-word;
        background-color: #fff;
        background-clip: border-box;
        /*border: 1px solid rgba(0,0,0,.125);*/

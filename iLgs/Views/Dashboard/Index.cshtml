@model iLgs.Models.DashboardViewModel
@{
    ViewBag.Title = Model != null && Model.IsAdmin ? "Operational Command Center" : "Personal Workbench";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

<link href="@Url.Content("~/Content/dashboard.css?v=20260916_3")" rel="stylesheet" />

<div class="epsms-dashboard @(Model != null && Model.IsAdmin ? "admin-command-mode" : "user-workbench-mode")">
    @Html.Partial("_DashboardHeader", Model)

    @if (Model != null && Model.IsAdmin)
    {
        @Html.Partial("_AdminDashboard", Model)
    }
    else
    {
        @Html.Partial("_UserDashboard", Model)
    }
</div>

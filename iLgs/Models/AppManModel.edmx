          <EntitySet Name="AspNetUserRoles_View" EntityType="Self.AspNetUserRoles_View" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [AspNetUserRoles_View].[UserId] AS [UserId], 
    [AspNetUserRoles_View].[RoleId] AS [RoleId], 
    [AspNetUserRoles_View].[RoleName] AS [RoleName], 
    [AspNetUserRoles_View].[NameFull] AS [NameFull], 
    [AspNetUserRoles_View].[UserName] AS [UserName]
    FROM [dbo].[AspNetUserRoles_View] AS [AspNetUserRoles_View]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="AspNetUsers_View" EntityType="Self.AspNetUsers_View" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [AspNetUsers_View].[Id] AS [Id], 
    [AspNetUsers_View].[Email] AS [Email], 
    [AspNetUsers_View].[UserId] AS [UserId], 
    [AspNetUsers_View].[NameLast] AS [NameLast], 
    [AspNetUsers_View].[NameFirst] AS [NameFirst], 
    [AspNetUsers_View].[NameMid] AS [NameMid], 
    [AspNetUsers_View].[NameFull] AS [NameFull], 
    [AspNetUsers_View].[Birthday] AS [Birthday], 
    [AspNetUsers_View].[Sex] AS [Sex], 
    [AspNetUsers_View].[TelNo] AS [TelNo], 
    [AspNetUsers_View].[MobileNo] AS [MobileNo], 
    [AspNetUsers_View].[AddressHouseNo] AS [AddressHouseNo], 
    [AspNetUsers_View].[AddressStreet] AS [AddressStreet], 
    [AspNetUsers_View].[AddressSubdivision] AS [AddressSubdivision], 
    [AspNetUsers_View].[AddressBarangay] AS [AddressBarangay], 
    [AspNetUsers_View].[AddressCity] AS [AddressCity], 
    [AspNetUsers_View].[AddressProvince] AS [AddressProvince], 
    [AspNetUsers_View].[AddressZipCode] AS [AddressZipCode], 
    [AspNetUsers_View].[InsertedBy] AS [InsertedBy], 
    [AspNetUsers_View].[InsertedDt] AS [InsertedDt], 
    [AspNetUsers_View].[UpdatedBy] AS [UpdatedBy], 

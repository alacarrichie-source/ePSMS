<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>Package</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <DesktopBuildPackageLocation>C:\Deploy\ePSMS\Live\Web2015_Staging\ePsms.zip</DesktopBuildPackageLocation>
    <PackageAsSingleFile>true</PackageAsSingleFile>
    <DeployIisAppPath>Default Web Site/ePsmsStaging</DeployIisAppPath>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="DefaultConnection" Order="3" Enabled="False">
          <Destination Path="Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;Application Name=EntityFramework" Name="Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;MultipleActiveResultSets=True;Application Name=EntityFramework" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="iLgs.Models.ApplicationDbContext, iLgs" MigrationConfiguration="iLgs.Migrations.Configuration, iLgs" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="APPMAN_API_URL" Order="4" Enabled="False">
          <Destination Path="Data Source=http://192.168.28.251/ePsmsStaging/api/" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=http://localhost:15483/api/" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\APPMAN_API_URL_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Data Source=http://localhost:15483/api/" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
        <ObjectGroup Name="AppManEntities" Order="5" Enabled="False">
          <Destination Path="Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;Application Name=EntityFramework" Name="Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;MultipleActiveResultSets=True;Application Name=EntityFramework" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="iLgs.Models.AppManEntities, iLgs" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="UPLOAD_URL" Order="6" Enabled="False">
          <Destination Path="Data Source=//192.168.28.251/UPLOADS_Staging/" />
          <Object Type="DbDacFx">
            <PreSource Path="Data Source=C:/UPLOADS/" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\UPLOAD_URL_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="Data Source=C:/UPLOADS/" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="UPLOAD_URL-Web.config Connection String">
      <ParameterValue>Data Source=//192.168.28.251/UPLOADS_Staging/</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="AppManEntities-Web.config Connection String">
      <ParameterValue>metadata=res://*/Models.AppManModel.csdl|res://*/Models.AppManModel.ssdl|res://*/Models.AppManModel.msl;provider=System.Data.SqlClient;provider connection string="Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;MultipleActiveResultSets=True;Application Name=EntityFramework"</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="DefaultConnection-Web.config Connection String">
      <ParameterValue>Data Source=DATASERVER3;Initial Catalog=ePSMS_Staging;User ID=sa_psms_lpc;Password=grace2023@lpc;MultipleActiveResultSets=True;Application Name=EntityFramework</ParameterValue>
    </MSDeployParameterValue>
    <MSDeployParameterValue Include="APPMAN_API_URL-Web.config Connection String">
      <ParameterValue>Data Source=http://192.168.28.251/ePsmsStaging/api/</ParameterValue>
    </MSDeployParameterValue>
  </ItemGroup>
</Project>